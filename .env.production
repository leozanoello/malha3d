# Zanoello 3D - Production Environment Configuration

# Server Configuration
# A hospedagem geralmente injeta a variável PORT, mas definimos uma padrão
PORT=3000
NODE_ENV=production
APP_URL=https://malha3d.com

# Database Configuration
# Se mantivermos o Supabase, a string será essa:
SUPABASE_DB_URL="postgresql://postgres.jndjarkqjhsayiuneakk:LrZan0235%21%40%23%21%40%23%21%40%23@aws-0-us-west-2.pooler.supabase.com:6543/postgres"

# Session & Security
# IMPORTANTE: Você pode gerar senhas novas para produção
SESSION_SECRET=zanoello-3d-production-secret-key-2026-secure
JWT_SECRET=zanoello-jwt-production-secret-key-2026-secure
JWT_EXPIRES_IN=24h

# Email Configuration (Altere para o e-mail real do domínio malha3d.com)
EMAIL_HOST=smtp.hostinger.com # (Exemplo, altere para o do seu provedor)
EMAIL_PORT=465
EMAIL_USER=contato@malha3d.com
EMAIL_PASSWORD=sua-senha-de-email
EMAIL_FROM=contato@malha3d.com

# Uploads e Segurança
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./public/uploads
ALLOWED_FILE_TYPES=jpeg,jpg,png,gif,webp,pdf,obj,stl
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Cache
CACHE_TTL=3600
CACHE_MAX_SIZE=100
DEBUG=false
LOG_LEVEL=error
