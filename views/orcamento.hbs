{{!-- Standard budget query checks script --}}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Query status form
        const statusForm = document.getElementById('statusForm');
        statusForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const submitBtn = statusForm.querySelector('button[type="submit"]');
            const statusResult = document.getElementById('statusResult');
            const budgetId = document.getElementById('budgetId').value.trim();

            submitBtn.disabled = true;
            submitBtn.textContent = 'Buscando...';
            statusResult.style.display = 'none';

            try {
                const response = await fetch(`/orcamento/status/${budgetId}`);
                const result = await response.json();
                if (result.success) {
                    const b = result.budget;
                    const dateFormatted = new Date(b.createdAt).toLocaleDateString('pt-BR');
                    
                    let statusLabel = 'Pendente';
                    if (b.status === 'aprovado' || b.status === 'ganho') statusLabel = 'Aprovado 🚀';
                    else if (b.status === 'perdido') statusLabel = 'Perdido';
                    else if (b.status === 'analise' || b.status === 'respondido') statusLabel = 'Em Análise';

                    statusResult.innerHTML = `Orçamento encontrado para <strong>${b.name}</strong>.<br>Status atual: <strong>${statusLabel}</strong><br>Criado em: ${dateFormatted}`;
                    statusResult.className = 'status-mini-result success';
                    statusResult.style.display = 'block';
                } else {
                    statusResult.textContent = result.message || 'Código não encontrado.';
                    statusResult.className = 'status-mini-result error';
                    statusResult.style.display = 'block';
                }
            } catch (err) {
                statusResult.textContent = 'Erro ao conectar. Tente novamente.';
                statusResult.className = 'status-mini-result error';
                statusResult.style.display = 'block';
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Consultar Status';
            }
        });
    });
</script>
