<script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

{{!-- React Component: React Multi-Step Wizard --}}
<script type="text/babel">
    const { useState, useEffect } = React;

    function ArchVizWizard() {
        const [step, setStep] = useState(1);
        const [calibratedM2Price, setCalibratedM2Price] = useState(50.00);
        const [showAdminPanel, setShowAdminPanel] = useState(false);
        const [adminPassword, setAdminPassword] = useState('');
        const [isAdminVerified, setIsAdminVerified] = useState(false);

        // Form fields state
        const [metragemTotal, setMetragemTotal] = useState('');
        const [tipoEmpreendimento, setTipoEmpreendimento] = useState('');
        const [ambientes, setAmbientes] = useState([]);
        const [formatoBase, setFormatoBase] = useState('');
        const [estiloArquitetonico, setEstiloArquitetonico] = useState('');
        const [detalhamentoExigido, setDetalhamentoExigido] = useState('');
        const [briefingTextual, setBriefingTextual] = useState('');
        const [imagensEstaticas, setImagensEstaticas] = useState(0);
        const [segundosAnimacao, setSegundosAnimacao] = useState(0);
        const [tourVirtual360, setTourVirtual360] = useState(false);
        const [prazoSLA, setPrazoSLA] = useState('Normal');

        // Contact details
        const [contatoNome, setContatoNome] = useState('');
        const [contatoEmail, setContatoEmail] = useState('');
        const [contatoPhone, setContatoPhone] = useState('');

        // Calculation result state
        const [loading, setLoading] = useState(false);
        const [result, setResult] = useState(null);
        const [error, setError] = useState(null);

        // Env categories definition
        const envCategories = {
            'Áreas Secas': ['Living', 'Quarto Suíte', 'Quarto Solteiro', 'Home Office', 'Sala de Jantar', 'Hall', 'Closet'],
            'Áreas Molhadas': ['Cozinha', 'Banheiro Master', 'Lavabo', 'Área de Serviço'],
            'Áreas Externas': ['Fachada Frontal', 'Fachada Fundos', 'Espaço Gourmet', 'Piscina', 'Deck', 'Paisagismo/Jardim', 'Rooftop'],
            'Áreas Comuns': ['Pilotis', 'Salão de Festas', 'Academia', 'Brinquedoteca', 'Guarita']
        };

        // Fetch calibrated prices on mount
        useEffect(() => {
            fetch('/api/calculator-settings')
                .then(r => r.json())
                .then(data => {
                    if (data.calculator_base_price_m2) {
                        setCalibratedM2Price(parseFloat(data.calculator_base_price_m2));
                    }
                })
                .catch(err => console.error('Erro ao ler calibração inicial:', err));
        }, []);

        // Dynamic environment tag toggle
        const toggleAmbiente = (name) => {
            if (ambientes.includes(name)) {
                setAmbientes(ambientes.filter(a => a !== name));
            } else {
                setAmbientes([...ambientes, name]);
            }
        };

        // Standard validation check to enable advancement
        const isStepValid = () => {
            if (step === 1) {
                return tipoEmpreendimento !== '' && metragemTotal !== '' && parseFloat(metragemTotal) > 0;
            }
            if (step === 2) {
                return ambientes.length > 0;
            }
            if (step === 3) {
                return formatoBase !== '' && estiloArquitetonico !== '' && detalhamentoExigido !== '';
            }
            if (step === 4) {
                // Ensure at least one deliverable is selected
                return (imagensEstaticas > 0 || segundosAnimacao > 0 || tourVirtual360) && prazoSLA !== '';
            }
            if (step === 5) {
                return contatoNome.trim().length >= 3 && contatoEmail.includes('@') && contatoPhone.trim().length >= 8;
            }
            return true;
        };

        // Submit to API
        const handleCalculate = async (e) => {
            if (e) e.preventDefault();
            setLoading(true);
            setError(null);

            const payload = {
                metragemTotal: parseFloat(metragemTotal),
                tipoEmpreendimento,
                ambientes,
                formatoBase,
                estiloArquitetonico,
                detalhamentoExigido,
                briefingTextual,
                imagensEstaticas: parseInt(imagensEstaticas) || 0,
                segundosAnimacao: parseInt(segundosAnimacao) || 0,
                tourVirtual360,
                prazoSLA,
                contatoNome,
                contatoEmail,
                contatoPhone
            };

            // Inject base price override if changed locally by admin
            if (isAdminVerified) {
                payload.overrideBaseM2Price = calibratedM2Price;
            }

            try {
                const response = await fetch('/api/calculadora/calcular', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const resData = await response.json();
                if (resData.success) {
                    setResult(resData);
                    setStep(6);
                } else {
                    setError(resData.error || 'Erro ao processar precificação.');
                }
            } catch (err) {
                setError('Erro na rede. Não foi possível conectar ao servidor.');
            } finally {
                setLoading(false);
            }
        };

        const handleVerifyAdmin = () => {
            if (adminPassword === 'zanoello123' || adminPassword === 'admin') {
                setIsAdminVerified(true);
                setShowAdminPanel(false);
            } else {
                alert('Senha administrativa incorreta.');
            }
        };

        const handleRestart = () => {
            setStep(1);
            setMetragemTotal('');
            setTipoEmpreendimento('');
            setAmbientes([]);
            setFormatoBase('');
            setEstiloArquitetonico('');
            setDetalhamentoExigido('');
            setBriefingTextual('');
            setImagensEstaticas(0);
            setSegundosAnimacao(0);
            setTourVirtual360(false);
            setPrazoSLA('Normal');
            setContatoNome('');
            setContatoEmail('');
            setContatoPhone('');
            setResult(null);
            setError(null);
        };

        return (
            <div style={{ display: 'flex', flexDirection: 'column', height: '100%', justifyContent: 'space-between' }}>
                
                {/* Header and Step Indicators */}
                {step < 6 && (
                    <div style={{ marginBottom: '2rem' }}>
                        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '1rem' }}>
                            <span style={{ fontSize: '0.7rem', textTransform: 'uppercase', letterSpacing: '0.1em', color: 'var(--accent)', fontWeight: 'bold' }}>
                                Etapa {step} de 5
                            </span>
                            <span style={{ fontSize: '0.8rem', color: 'var(--muted)', fontWeight: '500' }}>
                                {step === 1 && 'Dimensões & Tipo'}
                                {step === 2 && 'Mapeamento de Ambientes'}
                                {step === 3 && 'Complexidade Técnica'}
                                {step === 4 && 'Entregáveis & SLA'}
                                {step === 5 && 'Dados de Contato'}
                            </span>
                        </div>
                        {/* Progress Bar */}
                        <div style={{ width: '100%', height: '4px', background: 'rgba(255,255,255,0.05)', borderRadius: '10px', overflow: 'hidden' }}>
                            <div style={{ 
                                width: `${(step / 5) * 100}%`, 
                                height: '100%', 
                                background: 'linear-gradient(90deg, #ff6b35, #f7b05b)', 
                                transition: 'width 0.4s cubic-bezier(0.4, 0, 0.2, 1)' 
                            }}></div>
                        </div>
                    </div>
                )}

                {/* Form Body wrapper */}
                <div style={{ flex: 1, minHeight: '380px' }}>
                    {error && (
                        <div style={{ background: 'rgba(239, 68, 68, 0.1)', color: '#EF4444', padding: '1rem', borderRadius: '1rem', marginBottom: '1.5rem', border: '1px solid rgba(239, 68, 68, 0.2)', fontSize: '0.85rem' }}>
                            <i className="fas fa-exclamation-circle me-2"></i> {error}
                        </div>
                    )}

                    {/* Step 1: Enterprise type & scale */}
                    {step === 1 && (
                        <div>
                            <div className="form-section-title">Empreendimento e Escala</div>
                            <div style={{ display: 'grid', gap: '1.5rem' }}>
                                <div style={{ display: 'flex', flexDirection: 'column', gap: '0.5rem' }}>
                                    <label style={{ fontSize: '0.85rem', color: 'var(--muted)', fontWeight: '600' }}>Tipo de Empreendimento</label>
                                    <select 
                                        value={tipoEmpreendimento} 
                                        onChange={(e) => setTipoEmpreendimento(e.target.value)}
                                        style={{ width: '100%', background: 'rgba(255,255,255,0.03)', border: '1px solid var(--border)', borderRadius: '1rem', padding: '1rem', color: 'white' }}
                                    >
                                        <option value="" disabled>Selecione...</option>
                                        <option value="Residencial Unifamiliar (Casa)">Residencial Unifamiliar (Casa)</option>
                                        <option value="Edifício Residencial (Vertical)">Edifício Residencial (Vertical)</option>
                                        <option value="Comercial/Varejo">Comercial/Varejo</option>
                                        <option value="Corporativo (Escritórios)">Corporativo (Escritórios)</option>
                                        <option value="Loteamento/Urbanístico">Loteamento/Urbanístico</option>
                                        <option value="Design de Interiores (Apartamento)">Design de Interiores (Apartamento)</option>
                                        <option value="Estande de Vendas/Cenografia">Estande de Vendas/Cenografia</option>
                                    </select>
                                </div>

                                <div style={{ display: 'flex', flexDirection: 'column', gap: '0.5rem' }}>
                                    <label style={{ fontSize: '0.85rem', color: 'var(--muted)', fontWeight: '600' }}>Metragem Total a ser Modelada/Renderizada (m²)</label>
                                    <div style={{ position: 'relative' }}>
                                        <input 
                                            type="number" 
                                            value={metragemTotal} 
                                            onChange={(e) => setMetragemTotal(e.target.value)}
                                            placeholder="Ex: 250"
                                            style={{ width: '100%', background: 'rgba(255,255,255,0.03)', border: '1px solid var(--border)', borderRadius: '1rem', padding: '1rem', color: 'white' }}
                                        />
                                        <span style={{ position: 'absolute', right: '1.5rem', top: '50%', transform: 'translateY(-50%)', color: 'var(--muted)', fontSize: '0.85rem', fontWeight: 'bold' }}>m²</span>
                                    </div>
                                </div>

                                {/* Admin Calibration override */}
                                <div style={{ marginTop: '2rem', borderTop: '1px dashed var(--border)', paddingTop: '1.5rem' }}>
                                    {isAdminVerified ? (
                                        <div style={{ background: 'rgba(249, 115, 22, 0.05)', padding: '1rem', borderRadius: '1rem', border: '1px solid rgba(249, 115, 22, 0.15)', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                                            <div>
                                                <p style={{ fontSize: '0.75rem', fontWeight: 'bold', color: 'var(--accent)' }}>ADMIN: CALIBRAÇÃO ATIVA</p>
                                                <p style={{ fontSize: '0.85rem', color: 'white', marginTop: '0.2rem' }}>Valor Base por m²:</p>
                                            </div>
                                            <input 
                                                type="number" 
                                                value={calibratedM2Price} 
                                                onChange={(e) => setCalibratedM2Price(parseFloat(e.target.value) || 0)}
                                                style={{ width: '100px', background: 'rgba(0,0,0,0.4)', border: '1px solid var(--accent)', borderRadius: '0.5rem', padding: '0.4rem', color: 'white', textAlign: 'right', fontWeight: 'bold' }}
                                            />
                                        </div>
                                    ) : (
                                        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                                            <span style={{ fontSize: '0.8rem', color: 'var(--muted)' }}>Valor Base atual: R$ {calibratedM2Price.toFixed(2)}/m²</span>
                                            <button 
                                                onClick={() => setShowAdminPanel(!showAdminPanel)}
                                                style={{ background: 'none', border: 'none', color: 'var(--muted)', cursor: 'pointer', fontSize: '0.9rem' }}
                                                title="Calibrar como Admin"
                                            >
                                                <i className="fas fa-cog"></i>
                                            </button>
                                        </div>
                                    )}

                                    {showAdminPanel && (
                                        <div style={{ marginTop: '1rem', display: 'flex', gap: '0.5rem' }}>
                                            <input 
                                                type="password" 
                                                placeholder="Senha Master"
                                                value={adminPassword}
                                                onChange={(e) => setAdminPassword(e.target.value)}
                                                style={{ flex: 1, background: 'rgba(255,255,255,0.03)', border: '1px solid var(--border)', borderRadius: '0.8rem', padding: '0.6rem 1rem', color: 'white', fontSize: '0.85rem' }}
                                            />
                                            <button 
                                                onClick={handleVerifyAdmin}
                                                style={{ background: 'var(--accent)', border: 'none', color: 'white', borderRadius: '0.8rem', padding: '0.6rem 1.2rem', cursor: 'pointer', fontSize: '0.85rem', fontWeight: 'bold' }}
                                            >
                                                Verificar
                                            </button>
                                        </div>
                                    )}
                                </div>
                            </div>
                        </div>
                    )}

                    {/* Step 2: Environments */}
                    {step === 2 && (
                        <div>
                            <div className="form-section-title">Ambientes a serem Modelados/Renderizados</div>
                            <p style={{ fontSize: '0.8rem', color: 'var(--muted)', marginBottom: '1.5rem', marginTop: '-1rem' }}>Selecione todos os ambientes que farão parte do escopo técnico do orçamento.</p>
                            
                            <div style={{ display: 'flex', flexDirection: 'column', gap: '1.5rem', maxHeight: '350px', overflowY: 'auto', paddingRight: '0.5rem' }}>
                                {Object.keys(envCategories).map(category => (
                                    <div key={category}>
                                        <h4 style={{ fontSize: '0.75rem', textTransform: 'uppercase', letterSpacing: '0.05em', color: 'var(--accent)', fontWeight: 'bold', marginBottom: '0.75rem' }}>
                                            {category}
                                        </h4>
                                        <div style={{ display: 'flex', flexWrap: 'wrap', gap: '0.5rem' }}>
                                            {envCategories[category].map(envName => {
                                                const selected = ambientes.includes(envName);
                                                return (
                                                    <button
                                                        key={envName}
                                                        onClick={() => toggleAmbiente(envName)}
                                                        style={{
                                                            background: selected ? 'rgba(255, 107, 53, 0.12)' : 'rgba(255,255,255,0.02)',
                                                            border: selected ? '1px solid #ff6b35' : '1px solid var(--border)',
                                                            color: selected ? '#ff6b35' : 'var(--muted)',
                                                            padding: '0.5rem 1rem',
                                                            borderRadius: '100px',
                                                            fontSize: '0.8rem',
                                                            fontWeight: '600',
                                                            cursor: 'pointer',
                                                            transition: 'all 0.2s ease',
                                                            display: 'flex',
                                                            alignItems: 'center',
                                                            gap: '0.4rem'
                                                        }}
                                                    >
                                                        {selected && <i className="fas fa-check" style={{ fontSize: '0.7rem' }}></i>}
                                                        {envName}
                                                    </button>
                                                );
                                            })}
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {/* Step 3: Complexity & Heuristics */}
                    {step === 3 && (
                        <div>
                            <div className="form-section-title">Formato da Base e Estilo</div>
                            <div style={{ display: 'grid', gap: '1.2rem' }}>
                                
                                <div style={{ display: 'flex', flexDirection: 'column', gap: '0.5rem' }}>
                                    <label style={{ fontSize: '0.85rem', color: 'var(--muted)', fontWeight: '600' }}>Formato da Base Recebida</label>
                                    <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '0.5rem' }}>
                                        {['BIM Limpo (Revit/Archicad)', 'Modelo Sujo (Sketchup)', 'Desenho 2D (AutoCAD/PDF)', 'Modelagem do Zero'].map(option => {
                                            const selected = formatoBase === option;
                                            return (
                                                <button
                                                    key={option}
                                                    type="button"
                                                    onClick={() => setFormatoBase(option)}
                                                    style={{
                                                        background: selected ? 'rgba(255, 107, 53, 0.08)' : 'rgba(255,255,255,0.02)',
                                                        border: selected ? '1px solid #ff6b35' : '1px solid var(--border)',
                                                        color: selected ? '#ff6b35' : 'white',
                                                        padding: '0.8rem',
                                                        borderRadius: '0.8rem',
                                                        fontSize: '0.8rem',
                                                        fontWeight: 'bold',
                                                        cursor: 'pointer',
                                                        transition: 'all 0.2s ease',
                                                        textAlign: 'center'
                                                    }}
                                                >
                                                    {option}
                                                </button>
                                            );
                                        })}
                                    </div>
                                </div>

                                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '1rem' }}>
                                    <div style={{ display: 'flex', flexDirection: 'column', gap: '0.5rem' }}>
                                        <label style={{ fontSize: '0.85rem', color: 'var(--muted)', fontWeight: '600' }}>Estilo Arquitetônico</label>
                                        <select 
                                            value={estiloArquitetonico} 
                                            onChange={(e) => setEstiloArquitetonico(e.target.value)}
                                            style={{ width: '100%', background: 'rgba(255,255,255,0.03)', border: '1px solid var(--border)', borderRadius: '1rem', padding: '0.8rem 1rem', color: 'white' }}
                                        >
                                            <option value="" disabled>Selecione...</option>
                                            <option value="Minimalista">Minimalista</option>
                                            <option value="Moderno">Moderno</option>
                                            <option value="Industrial">Industrial</option>
                                            <option value="Clássico/Neoclássico">Clássico/Neoclássico</option>
                                            <option value="Rústico">Rústico</option>
                                        </select>
                                    </div>

                                    <div style={{ display: 'flex', flexDirection: 'column', gap: '0.5rem' }}>
                                        <label style={{ fontSize: '0.85rem', color: 'var(--muted)', fontWeight: '600' }}>Detalhamento Exigido</label>
                                        <select 
                                            value={detalhamentoExigido} 
                                            onChange={(e) => setDetalhamentoExigido(e.target.value)}
                                            style={{ width: '100%', background: 'rgba(255,255,255,0.03)', border: '1px solid var(--border)', borderRadius: '1rem', padding: '0.8rem 1rem', color: 'white' }}
                                        >
                                            <option value="" disabled>Selecione...</option>
