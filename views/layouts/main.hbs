                            <i class="fas fa-layer-group"></i>
                        </div>
                        <span style="color: white;">MALHA<span class="text-accent">3D</span></span>
                    </div>
                    <p class="footer-description">
                        Líder em visualização 3D e integração ERP para indústrias modernas. Transformando complexidade em clareza visual.
                    </p>
                    <div class="social-links">
                        <a href="https://instagram.com/zanoello.3d" class="social-link"><i class="fab fa-instagram"></i></a>
                        <a href="https://wa.me/554920181541" class="social-link"><i class="fab fa-whatsapp"></i></a>
                    </div>
                </div>
                <div class="footer-nav">
                    <h4 class="footer-title">Plataforma</h4>
                    <ul class="footer-list">
                        <li><a href="/" class="footer-link">Início</a></li>
                        <li><a href="/galeria" class="footer-link">Galeria</a></li>
                        <li><a href="/admin/register" class="footer-link">Cadastro</a></li>
                    </ul>
                </div>
                <div class="footer-nav">
                    <h4 class="footer-title">Serviços</h4>
                    <ul class="footer-list">
                        <li><a href="#" class="footer-link">Ctx7 ERP</a></li>
                        <li><a href="#" class="footer-link">Modelagem 3D</a></li>
                        <li><a href="#" class="footer-link">Renderização</a></li>
                    </ul>
                </div>
                <div class="footer-nav">
                    <h4 class="footer-title">Contato</h4>
                    <ul class="footer-list">
                        <li><a href="/contato" class="footer-link">Suporte</a></li>
                        <li><a href="mailto:contato@Malha3D.com.br" class="footer-link">E-mail</a></li>
                        <li><a href="tel:+554920181541" class="footer-link">+55 (49) 2018-1541</a></li>
                    </ul>
                </div>
