    // === SISTEMA DE AMBIENTES DINÂMICO (Entregáveis por Ambiente) ===
    (function(){
      var envItems = [];

      window.addEnvItem = function() {
        var sel = document.getElementById('envSelectNew');
        if (!sel || !sel.value) return;
        var name = sel.value;
        // Evitar duplicatas
        if (envItems.find(function(e){ return e.name === name; })) { sel.value = ''; return; }
        envItems.push({ name: name, images: 1, animation: 0, panorama: 0, obs: '' });
        sel.value = '';
        window.renderEnvItems();
      };

      window.removeEnvItem = function(idx) {
        envItems.splice(idx, 1);
        window.renderEnvItems();
      };

      window.updateEnvItem = function(idx, field, value) {
        envItems[idx][field] = field === 'obs' ? value : parseInt(value) || 0;
        window.renderEnvItems();
      };

      window.renderEnvItems = function() {
        var container = document.getElementById('envItemsList');
        var summary = document.getElementById('envSummary');
        var summaryText = document.getElementById('envSummaryText');
        var hidden = document.getElementById('envDataHidden');
        if (!container) return;

        if (envItems.length === 0) {
          container.innerHTML = '<p class="text-[9px] text-gray-500 text-center py-3">Nenhum ambiente adicionado. Selecione acima e clique + Add.</p>';
          if (summary) summary.classList.add('hidden');
          if (hidden) hidden.value = '[]';
          return;
        }

        container.innerHTML = envItems.map(function(item, i) {
          return '<div class="flex items-center gap-2 p-2 rounded-lg bg-white/[0.02] border border-white/5">' +
            '<span class="text-[9px] font-bold text-white flex-1 min-w-0 truncate">' + item.name + '</span>' +
            '<div class="flex items-center gap-1 shrink-0">' +
              '<label class="text-[7px] text-gray-500">Img</label>' +
              '<input type="number" min="0" value="' + item.images + '" onchange="window.updateEnvItem(' + i + ',\'images\',this.value)" class="w-8 h-6 text-[9px] text-center text-white bg-white/5 border border-white/10 rounded focus:border-orange-500 focus:outline-none">' +
            '</div>' +
            '<div class="flex items-center gap-1 shrink-0">' +
              '<label class="text-[7px] text-gray-500">Anim</label>' +
              '<input type="number" min="0" value="' + item.animation + '" onchange="window.updateEnvItem(' + i + ',\'animation\',this.value)" class="w-8 h-6 text-[9px] text-center text-white bg-white/5 border border-white/10 rounded focus:border-orange-500 focus:outline-none">' +
            '</div>' +
            '<div class="flex items-center gap-1 shrink-0">' +
              '<label class="text-[7px] text-gray-500">360°</label>' +
              '<input type="number" min="0" value="' + item.panorama + '" onchange="window.updateEnvItem(' + i + ',\'panorama\',this.value)" class="w-8 h-6 text-[9px] text-center text-white bg-white/5 border border-white/10 rounded focus:border-orange-500 focus:outline-none">' +
            '</div>' +
            '<button type="button" onclick="window.removeEnvItem(' + i + ')" class="w-6 h-6 rounded flex items-center justify-center text-gray-500 hover:text-red-400 hover:bg-red-500/10 transition-colors shrink-0"><span class="material-symbols-outlined text-[11px]">close</span></button>' +
          '</div>';
        }).join('');

        // Totais
        var totalImg = envItems.reduce(function(s, e){ return s + e.images; }, 0);
        var totalAnim = envItems.reduce(function(s, e){ return s + e.animation; }, 0);
        var totalPano = envItems.reduce(function(s, e){ return s + e.panorama; }, 0);

        if (summary) { summary.classList.remove('hidden'); }
        if (summaryText) { summaryText.textContent = totalImg + ' img | ' + totalAnim + 's anim | ' + totalPano + ' pano | ' + envItems.length + ' ambientes'; }
        if (hidden) { hidden.value = JSON.stringify(envItems); }

        // Atualizar hidden inputs de totais
        var ti = document.getElementById('envTotalImages'); if(ti) ti.value = totalImg;
        var ta = document.getElementById('envTotalAnimation'); if(ta) ta.value = totalAnim;
        var tp = document.getElementById('envTotalPanoramas'); if(tp) tp.value = totalPano;
      };
    })();

    // === FORMATAÇÃO DE DATA COM MÁSCARA ===
    window.formatDateInput = function(input) {
      let value = input.value.replace(/\D/g, '');
      if (value.length > 0) {
        if (value.length <= 2) {
          input.value = value;
        } else if (value.length <= 4) {
          input.value = value.slice(0, 2) + '/' + value.slice(2);
        } else {
          input.value = value.slice(0, 2) + '/' + value.slice(2, 4) + '/' + value.slice(4, 8);
        }
      }
      // Validação: ao desfocar, garantir formato DD/MM/YYYY
      input.addEventListener('blur', function() {
        const regex = /^(\d{2})\/(\d{2})\/(\d{4})$/;
        if (this.value && !regex.test(this.value)) {
          this.value = '';
          this.placeholder = 'DD/MM/YYYY (inválido)';
          setTimeout(() => { this.placeholder = 'DD/MM/YYYY'; }, 2000);
        }
      }, { once: true });
    };

    // === GERADOR DE DADOS DE TESTE (Beta) ===
    window.generateTestData = async function(module) {
      var qty = document.getElementById('testDataQty') ? document.getElementById('testDataQty').value : 10;
      var ok = await window.m3dConfirm('Criar ' + qty + ' registros de teste em "' + module + '"?<br><br><span class="text-[9px] text-gray-500">Dados serão marcados como teste e podem ser deletados depois.</span>', { title: 'Criar Dados de Teste', type: 'info', confirmText: 'Criar ' + qty });
      if (!ok) return;
      try {
        var res = await fetch('/admin/api/test-data/generate', {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ module: module, quantity: parseInt(qty) })
        });
        var data = await res.json();
        if (data.success) {
          var msg = Object.entries(data.created).map(function(e) { return e[1] + ' ' + e[0]; }).join(', ');
          if (window.showToast) window.showToast('Criados: ' + msg, 'success');
          setTimeout(function() { location.reload(); }, 1000);
        } else {
          window.m3dAlert(data.message || 'Falha ao gerar dados', { type: 'danger', title: 'Erro' });
        }
      } catch(e) { window.m3dAlert('Erro de conexão: ' + e.message, { type: 'danger' }); }
    };

    window.clearTestData = async function(module) {
      var ok = await window.m3dConfirm('Deletar todos os dados de teste em "' + module + '"?<br><br><span class="text-[9px] text-gray-500">Apenas dados marcados como teste serão removidos.<br>Dados reais NÃO serão afetados.</span>', { title: 'Limpar Dados de Teste', type: 'danger', confirmText: 'Deletar Tudo' });
      if (!ok) return;
      try {
        var res = await fetch('/admin/api/test-data/clear', {
          method: 'DELETE',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ module: module })
        });
        var data = await res.json();
        if (data.success) {
          var msg = Object.entries(data.deleted).map(function(e) { return e[1] + ' ' + e[0]; }).join(', ');
          if (window.showToast) window.showToast('Deletados: ' + msg, 'info');
          setTimeout(function() { location.reload(); }, 1000);
        } else {
          window.m3dAlert(data.message || 'Falha ao deletar', { type: 'danger' });
        }
      } catch(e) { window.m3dAlert('Erro de conexão: ' + e.message, { type: 'danger' }); }
    };
    </script>

    <!-- NOTAS: Janela flutuante com drag/resize e toolbar -->
    <script>
    (function(){
      var K='malha3d_notes_v2';
      function getNotes(){try{return JSON.parse(localStorage.getItem(K))||[];}catch(e){return[];}}
      function saveNotes(n){localStorage.setItem(K,JSON.stringify(n));}
      function genId(){return 'n_'+Date.now()+'_'+Math.random().toString(36).slice(2,7);}

      window.openFloatingNote = function(){
        var existing = document.getElementById('floatingNoteWin');
        if(existing){ existing.style.display='flex'; var fc=document.getElementById('fnContent'); if(fc)fc.focus(); return; }

        var notes=getNotes();
        var n={id:genId(),title:'',content:'',cat:'Geral',color:'yellow',tags:[],fav:false,created:new Date().toISOString(),updated:new Date().toISOString()};
        notes.unshift(n); saveNotes(notes);

        var win=document.createElement('div');
        win.id='floatingNoteWin';
        win.dataset.noteId=n.id;
        win.style.cssText='position:fixed;top:80px;right:40px;width:420px;height:480px;min-width:300px;min-height:280px;z-index:99999;display:flex;flex-direction:column;border-radius:8px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.7),0 0 0 1px rgba(255,255,255,0.1);resize:both;';

        win.innerHTML=''
          +'<div id="fnDragHandle" style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#1a1a1a;border-bottom:1px solid rgba(255,255,255,0.06);cursor:move;user-select:none;flex-shrink:0;">'
          +'<div style="display:flex;align-items:center;gap:6px;"><span class="material-symbols-outlined" style="font-size:14px;color:#f59e0b;">edit_note</span><input type="text" id="fnTitle" placeholder="T\u00edtulo da nota..." style="background:transparent;border:none;color:white;font-size:12px;font-weight:700;outline:none;width:200px;"></div>'
          +'<div style="display:flex;align-items:center;gap:2px;">'
          +'<button onclick="window.minimizeFloatingNote()" style="width:24px;height:24px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#6b7280;cursor:pointer;" title="Minimizar"><span class="material-symbols-outlined" style="font-size:14px;">remove</span></button>'
          +'<button onclick="window.maximizeFloatingNote()" style="width:24px;height:24px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#6b7280;cursor:pointer;" title="Maximizar"><span class="material-symbols-outlined" style="font-size:14px;">open_in_full</span></button>'
          +'<button onclick="window.closeFloatingNote()" style="width:24px;height:24px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#6b7280;cursor:pointer;" title="Fechar e Salvar"><span class="material-symbols-outlined" style="font-size:14px;">close</span></button>'
          +'</div></div>'
          +'<div id="fnToolbar" style="display:flex;align-items:center;gap:1px;padding:4px 8px;background:#141414;border-bottom:1px solid rgba(255,255,255,0.04);flex-wrap:wrap;flex-shrink:0;">'
          +'<button onclick="document.execCommand(\'bold\')" style="width:26px;height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#9ca3af;cursor:pointer;font-weight:bold;font-size:12px;" title="Negrito (Ctrl+B)">B</button>'
          +'<button onclick="document.execCommand(\'italic\')" style="width:26px;height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#9ca3af;cursor:pointer;font-style:italic;font-size:12px;" title="It\u00e1lico (Ctrl+I)">I</button>'
          +'<button onclick="document.execCommand(\'underline\')" style="width:26px;height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#9ca3af;cursor:pointer;text-decoration:underline;font-size:12px;" title="Sublinhado (Ctrl+U)">U</button>'
          +'<button onclick="document.execCommand(\'strikeThrough\')" style="width:26px;height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#9ca3af;cursor:pointer;text-decoration:line-through;font-size:12px;" title="Tachado">S</button>'
          +'<span style="width:1px;height:16px;background:rgba(255,255,255,0.08);margin:0 3px;"></span>'
          +'<button onclick="document.execCommand(\'formatBlock\',false,\'h2\')" style="width:26px;height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#9ca3af;cursor:pointer;font-size:10px;font-weight:900;" title="T\u00edtulo">H2</button>'
          +'<button onclick="document.execCommand(\'formatBlock\',false,\'h3\')" style="width:26px;height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#9ca3af;cursor:pointer;font-size:9px;font-weight:900;" title="Subt\u00edtulo">H3</button>'
          +'<button onclick="document.execCommand(\'formatBlock\',false,\'blockquote\')" style="width:26px;height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#9ca3af;cursor:pointer;" title="Cita\u00e7\u00e3o"><span class="material-symbols-outlined" style="font-size:13px;">format_quote</span></button>'
          +'<span style="width:1px;height:16px;background:rgba(255,255,255,0.08);margin:0 3px;"></span>'
          +'<button onclick="document.execCommand(\'insertUnorderedList\')" style="width:26px;height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#9ca3af;cursor:pointer;" title="Lista"><span class="material-symbols-outlined" style="font-size:13px;">format_list_bulleted</span></button>'
          +'<button onclick="document.execCommand(\'insertOrderedList\')" style="width:26px;height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#9ca3af;cursor:pointer;" title="Lista Numerada"><span class="material-symbols-outlined" style="font-size:13px;">format_list_numbered</span></button>'
          +'<button onclick="window.fnInsertCheck()" style="width:26px;height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#9ca3af;cursor:pointer;" title="Checklist"><span class="material-symbols-outlined" style="font-size:13px;">check_box</span></button>'
          +'<span style="width:1px;height:16px;background:rgba(255,255,255,0.08);margin:0 3px;"></span>'
          +'<button onclick="document.execCommand(\'insertHorizontalRule\')" style="width:26px;height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#9ca3af;cursor:pointer;" title="Linha"><span class="material-symbols-outlined" style="font-size:13px;">horizontal_rule</span></button>'
          +'<button onclick="window.fnInsertLink()" style="width:26px;height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#9ca3af;cursor:pointer;" title="Link"><span class="material-symbols-outlined" style="font-size:13px;">link</span></button>'
          +'<button onclick="document.execCommand(\'removeFormat\')" style="width:26px;height:26px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:#9ca3af;cursor:pointer;" title="Limpar"><span class="material-symbols-outlined" style="font-size:13px;">format_clear</span></button>'
          +'<span style="flex:1;"></span>'
          +'<span id="fnSaveStatus" style="font-size:8px;color:#4b5563;">\u25cf</span>'
          +'</div>'
          +'<div id="fnContent" contenteditable="true" style="flex:1;padding:16px;font-size:13px;color:#e5e5e5;line-height:1.7;overflow-y:auto;outline:none;background:#0f0f0f;"></div>'
          +'<div style="display:flex;align-items:center;justify-content:space-between;padding:6px 12px;background:#1a1a1a;border-top:1px solid rgba(255,255,255,0.04);flex-shrink:0;">'
          +'<a href="/admin/notas" style="font-size:8px;font-weight:700;color:#6b7280;text-decoration:none;text-transform:uppercase;letter-spacing:0.05em;">Ir para Notas \u2197</a>'
          +'<span style="font-size:8px;color:#4b5563;">Auto-salva ao digitar</span>'
          +'</div>';

        document.body.appendChild(win);

        // DRAG
        var handle=document.getElementById('fnDragHandle');
        var isDragging=false,dragX=0,dragY=0;
        handle.addEventListener('mousedown',function(e){
          if(e.target.closest('button')||e.target.closest('input'))return;
          isDragging=true;dragX=e.clientX-win.offsetLeft;dragY=e.clientY-win.offsetTop;
          document.body.style.userSelect='none';
        });
        document.addEventListener('mousemove',function(e){
          if(!isDragging)return;
          var x=e.clientX-dragX,y=e.clientY-dragY;
          x=Math.max(0,Math.min(x,window.innerWidth-100));
          y=Math.max(0,Math.min(y,window.innerHeight-50));
          win.style.left=x+'px';win.style.top=y+'px';win.style.right='auto';
        });
        document.addEventListener('mouseup',function(){isDragging=false;document.body.style.userSelect='';});

        // AUTO-SAVE
        var saveTimer=null;
        function autoSave(){
          clearTimeout(saveTimer);
          saveTimer=setTimeout(function(){
            var notes=getNotes(),nid=win.dataset.noteId;
            notes=notes.map(function(x){
              if(x.id!==nid)return x;
              x.title=document.getElementById('fnTitle').value;
              x.content=document.getElementById('fnContent').innerHTML;
              x.updated=new Date().toISOString();
              return x;
            });
            saveNotes(notes);
            var st=document.getElementById('fnSaveStatus');
            if(st){st.textContent='\u2713';st.style.color='#10b981';setTimeout(function(){st.textContent='\u25cf';st.style.color='#4b5563';},1200);}
          },800);
        }
        document.getElementById('fnContent').addEventListener('input',autoSave);
        document.getElementById('fnTitle').addEventListener('input',autoSave);
        setTimeout(function(){document.getElementById('fnTitle').focus();},50);
      };

      window.minimizeFloatingNote=function(){
        var win=document.getElementById('floatingNoteWin');if(!win)return;
        var c=document.getElementById('fnContent'),t=document.getElementById('fnToolbar');
        if(c.style.display==='none'){c.style.display='';t.style.display='';win.style.height='480px';win.style.resize='both';}
        else{c.style.display='none';t.style.display='none';win.style.height='auto';win.style.resize='none';}
      };

      window.maximizeFloatingNote=function(){
        var win=document.getElementById('floatingNoteWin');if(!win)return;
        if(win.dataset.maximized==='1'){
          win.style.top=win.dataset.prevTop;win.style.left=win.dataset.prevLeft;win.style.right=win.dataset.prevRight;
          win.style.width=win.dataset.prevW;win.style.height=win.dataset.prevH;win.dataset.maximized='0';
        }else{
          win.dataset.prevTop=win.style.top;win.dataset.prevLeft=win.style.left;win.dataset.prevRight=win.style.right;
          win.dataset.prevW=win.style.width;win.dataset.prevH=win.style.height;
          win.style.top='10px';win.style.left='270px';win.style.right='10px';
          win.style.width='calc(100vw - 280px)';win.style.height='calc(100vh - 20px)';win.dataset.maximized='1';
        }
      };

      window.closeFloatingNote=function(){
        var win=document.getElementById('floatingNoteWin');if(!win)return;
        var notes=getNotes(),nid=win.dataset.noteId;
        var title=document.getElementById('fnTitle').value||'';
        var content=document.getElementById('fnContent').innerHTML||'';
        notes=notes.map(function(x){if(x.id!==nid)return x;x.title=title;x.content=content;x.updated=new Date().toISOString();return x;});
        if(!title&&(!content||content==='<br>'||content===''))notes=notes.filter(function(x){return x.id!==nid;});
        saveNotes(notes);win.remove();
        if(window.showToast&&title)window.showToast('Nota salva!','success');
      };

      window.fnInsertCheck=function(){
        document.execCommand('insertHTML',false,'<div style="display:flex;align-items:center;gap:8px;padding:3px 0;"><input type="checkbox" style="accent-color:#f59e0b;width:15px;height:15px;cursor:pointer;"><span>Item</span></div><br>');
      };
      window.fnInsertLink=function(){var u=prompt('URL:');if(u)document.execCommand('createLink',false,u);};

      if(!window.m3dNotes)window.m3dNotes={};
      if(!window.m3dNotes.fromTemplate)window.m3dNotes.fromTemplate=function(){window.openFloatingNote();};
      if(!window.m3dNotes.saveQuickNote)window.m3dNotes.saveQuickNote=function(){};
      if(!window.m3dNotes.addTagQuick)window.m3dNotes.addTagQuick=function(){};
    })();
    </script>

</body>
