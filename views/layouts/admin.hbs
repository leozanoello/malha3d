    <style type="text/css">
        @charset "utf-8";
        
        :root {
            --background: #003559;
            --accent: #F2A71B;
            --accent-glow: rgba(242, 167, 27, 0.4);
            --glass: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.1);
            --glass-blur: blur(20px);
            --text-main: #F2F2F2;
            --text-muted: rgba(242, 242, 242, 0.6);
        }

        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: var(--background);
            color: var(--text-main);
            overflow-x: hidden;
        }

        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background-color: transparent; }
        ::-webkit-scrollbar-thumb { background-color: rgba(255, 255, 255, 0.1); border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background-color: rgba(249, 115, 22, 0.3); }

        /* Glassmorphism Core */
        .glass-card {
            background: var(--glass);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border: 1px solid var(--glass-border);
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 2rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            position: relative;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .glass-card:hover {
            box-shadow: 0 25px 50px rgba(249, 115, 22, 0.1);
            border-top: 1px solid rgba(255, 255, 255, 0.25);
            transform: translateY(-4px);
        }

        /* Modal Enhancements */
        .modal-content.glass-card {
            background: rgba(10, 12, 16, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 50px 100px rgba(0,0,0,0.8);
        }

        .modal-backdrop {
            background-color: #030712;
            opacity: 0.9 !important;
            backdrop-filter: blur(12px);
        }

        .text-gradient {
            background: linear-gradient(135deg, #fff 0%, #f97316 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Glow Orbs */
        .glow-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(100px);
            z-index: -1;
            pointer-events: none;
            opacity: 0.1;
        }
        .orb-1 { width: 500px; height: 500px; top: -100px; left: -100px; background: var(--accent); }
        .orb-2 { width: 600px; height: 600px; bottom: -200px; right: -100px; background: #3b82f6; }

        .input-premium {
            width: 100%;
            background-color: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 1.25rem;
            padding: 1.1rem 1.5rem;
            font-size: 0.85rem;
            color: white;
            transition: all 0.3s;
        }
        .input-premium:focus {
            outline: none;
            border-color: rgba(249, 115, 22, 0.4);
            background-color: rgba(255, 255, 255, 0.04);
            box-shadow: 0 0 0 10px rgba(249, 115, 22, 0.05);
        }

        /* Global Compacting (Padding/Gap only, fonts preserved as per user request) */
        .compact-mode .glass-card { padding: 1.25rem !important; border-radius: 1.25rem !important; }
        .compact-mode .p-10 { padding: 1.5rem !important; }
        .compact-mode .p-8 { padding: 1.25rem !important; }
        .compact-mode .p-6 { padding: 1rem !important; }
        .compact-mode .space-y-8 > :not([hidden]) ~ :not([hidden]) { margin-top: 1rem !important; }
        .compact-mode .space-y-6 > :not([hidden]) ~ :not([hidden]) { margin-top: 0.75rem !important; }
        .compact-mode .gap-8 { gap: 1.25rem !important; }
        .compact-mode .gap-6 { gap: 1rem !important; }
        .compact-mode input, .compact-mode select, .compact-mode textarea { padding: 0.6rem 1rem !important; border-radius: 0.75rem !important; }
        .compact-mode .btn, .compact-mode button { padding: 0.5rem 1rem !important; border-radius: 0.75rem !important; }
        
        /* Liquid Glass Effect */
        .liquid-glass {
            background: rgba(255, 255, 255, 0.03) !important;
            backdrop-filter: blur(15px) saturate(180%) !important;
            -webkit-backdrop-filter: blur(15px) saturate(180%) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37) !important;
            position: relative;
            overflow: hidden;
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1) !important;
        }

        .liquid-glass::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            transform: rotate(30deg);
            transition: all 0.8s ease;
            opacity: 0;
            pointer-events: none;
        }

        .liquid-glass:hover::before {
            opacity: 1;
            transform: rotate(30deg) translate(10%, 10%);
        }

        .liquid-glass:hover {
            border-color: rgba(255, 255, 255, 0.3) !important;
            transform: scale(1.02) !important;
            background: rgba(255, 255, 255, 0.07) !important;
        }

        .liquid-glass.active-orange {
            background: rgba(249, 115, 22, 0.1) !important;
            border-color: rgba(249, 115, 22, 0.3) !important;
        }

        /* Fix overlapping */
        nav.fixed { z-index: 50; }
        .sm\:ml-64 { padding-top: 0 !important; }

        /* Dropdown UI Fix globally for Premium Dark Mode */
        .dropdown-menu, .dropdown-menu-dark {
            background: rgba(10, 12, 16, 0.95) !important;
            backdrop-filter: blur(20px) !important;
            -webkit-backdrop-filter: blur(20px) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            border-radius: 1.5rem !important;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5) !important;
            padding: 0.75rem !important;
            z-index: 9999 !important;
        }
        .dropdown-item {
            color: rgba(255, 255, 255, 0.6) !important;
            font-size: 10px !important;
            font-weight: 800 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.1em !important;
            padding: 0.75rem 1rem !important;
            border-radius: 1rem !important;
            transition: all 0.2s !important;
            display: flex !important;
            align-items: center !important;
            gap: 0.5rem !important;
        }
        .dropdown-item:hover {
            background: rgba(255, 255, 255, 0.05) !important;
            color: #00f2ff !important;
            transform: translateX(4px) !important;
        }
        .dropdown-item.text-red-500 {
            color: #ef4444 !important;
        }
        .dropdown-item.text-red-500:hover {
            background: rgba(239, 68, 68, 0.1) !important;
            color: #ef4444 !important;
        }

        /* Premium Select Dropdown & Options Style Fix (to prevent white-on-white text collision) */
        select, .form-select, .input-premium {
            background-color: rgba(10, 12, 16, 0.95) !important;
            color: #ffffff !important;
        }
        
        select option, .form-select option, .input-premium option {
            background-color: #0a0c10 !important;
            color: #ffffff !important;
            font-family: 'Plus Jakarta Sans', sans-serif !important;
            font-size: 12px !important;
            font-weight: 600 !important;
            padding: 10px !important;
        }

        /* Focus & interactive states for selects */
        select:focus, .form-select:focus, .input-premium:focus {
            border-color: rgba(249, 115, 22, 0.4) !important;
            background-color: rgba(10, 12, 16, 0.98) !important;
            box-shadow: 0 0 0 10px rgba(249, 115, 22, 0.05) !important;
            outline: none !important;
        }
    </style>
</head>
