    <script>
        // Notification Drawer
        const notifBtn = document.getElementById('btn-notifications');
        const notifDrawer = document.getElementById('notification-drawer');
        const closeNotif = document.getElementById('close-notifications');

        notifBtn?.addEventListener('click', (e) => { e.stopPropagation(); notifDrawer.classList.toggle('right-0'); notifDrawer.classList.toggle('right-[-400px]'); });
        closeNotif?.addEventListener('click', () => { notifDrawer.classList.add('right-[-400px]'); notifDrawer.classList.remove('right-0'); });

        document.addEventListener('click', (e) => {
            if (!searchInput?.contains(e.target) && !searchResults?.contains(e.target)) searchResults?.classList.add('hidden');
            if (!notifDrawer?.contains(e.target) && !notifBtn?.contains(e.target)) { notifDrawer?.classList.add('right-[-400px]'); notifDrawer?.classList.remove('right-0'); }
        });

        window.showNotification = showNotification;

        // === DEEP LINKING ENGINE ===
        function checkUrlParams() {
            const urlParams = new URLSearchParams(window.location.search);
            const id = urlParams.get('id');
            if (!id) return;

            // Se estivermos no CRM (Negociações)
            if (window.location.pathname.includes('/negociacoes')) {
