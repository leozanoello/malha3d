    <!-- Main Content -->
    <div class="sm:ml-64 h-screen flex flex-col overflow-hidden">
        <div class="flex-1 flex flex-col min-h-0 p-6 overflow-y-auto">
            {{#if error}}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle"></i> {{error}}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {{/if}}
            
            {{#if success}}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle"></i> {{success}}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {{/if}}

            {{#if info}}
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="fas fa-info-circle"></i> {{info}}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {{/if}}
            
            {{{body}}}
        </div>
    </div>
    

    
    <!-- Global Modals Integration -->
    {{> globalModals}}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Handle form submissions with loading states
            document.addEventListener('submit', function(e) {
                if (e.defaultPrevented) return; // Ignore if handled by AJAX/fetch
                
                const form = e.target;
                const submitBtn = form.querySelector('button[type="submit"]');
                
                if (submitBtn && !submitBtn.disabled) {
                    const originalText = submitBtn.innerHTML;
                    submitBtn.setAttribute('data-original-text', originalText);
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="flex items-center gap-2 justify-center"><i class="fas fa-spinner fa-spin"></i> Sincronizando...</span>';
                    
                    // Re-enable button after 10 seconds in case of hang
                    setTimeout(function() {
                        if(submitBtn.disabled) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalText;
                        }
                    }, 10000);
                }
            });
            
            // Auto-hide alerts after 5 seconds
            const alerts = document.querySelectorAll('.alert:not(.alert-permanent)');
            alerts.forEach(function(alert) {
                setTimeout(function() {
                    try {
                        const bsAlert = new bootstrap.Alert(alert);
                        bsAlert.close();
                    } catch(e) { alert.remove(); }
                }, 5000);
            });
            
            // Add confirmation to delete buttons
            document.addEventListener('click', function(e) {
                if (e.target.matches('[data-confirm-delete]') || e.target.closest('[data-confirm-delete]')) {
                    const el = e.target.closest('[data-confirm-delete]') || e.target;
                    const message = el.getAttribute('data-confirm-message') || 'Deseja realmente eliminar este registro permanentemente?';
                    if (!confirm(message)) {
                        e.preventDefault();
                        return false;
                    }
                }
            });
        });
        
        // Notification system
        function showNotification(message, type = 'success') {
            const container = document.getElementById('notification-container');
            if (!container) return;
            const notification = document.createElement('div');
            notification.className = `alert alert-${type} alert-dismissible fade show border-0 bg-dark-900 text-white shadow-2xl rounded-2xl mb-3 flex items-center gap-3 p-4`;
            notification.innerHTML = `
                <span class="material-symbols-outlined ${type === 'success' ? 'text-emerald-500' : 'text-blue-500'}">${type === 'success' ? 'check_circle' : 'info'}</span>
                <div class="text-[11px] font-black uppercase tracking-widest flex-1">${message}</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            `;
            container.appendChild(notification);
            setTimeout(() => { 
                try { 
                    const bsAlert = new bootstrap.Alert(notification);
                    bsAlert.close(); 
                } catch(e) { notification.remove(); } 
            }, 5000);
        }
        
        // Global Search
        const searchBtn = document.getElementById('btn-global-search');
        const searchInput = document.getElementById('global-search-input');
        const searchResults = document.getElementById('global-search-results');

        searchBtn?.addEventListener('click', () => {
            const container = document.getElementById('global-search-container');
            container.classList.toggle('hidden');
            if (!container.classList.contains('hidden')) searchInput.focus();
        });

        let searchTimeout;
        searchInput?.addEventListener('input', (e) => {
            clearTimeout(searchTimeout);
            const query = e.target.value.trim();
            if (query.length < 2) { searchResults.classList.add('hidden'); return; }
            searchTimeout = setTimeout(() => {
                fetch(`/api/global-search?q=${encodeURIComponent(query)}`)
                    .then(res => res.json())
                    .then(data => { renderGlobalSearchResults(data); searchResults.classList.remove('hidden'); });
            }, 500); // Debounce de 500ms para poupar o servidor
        });

        function renderGlobalSearchResults(data) {
            const sections = {
                budgets: { list: document.querySelector('#search-section-deals .results-list'), data: data.budgets, icon: 'payments', url: '/admin/negociacoes' },
                projects: { list: document.querySelector('#search-section-projects .results-list'), data: data.projects, icon: 'folder_special', url: '/admin/projetos/kanban' },
                clients: { list: document.querySelector('#search-section-contacts .results-list'), data: data.clients, icon: 'person', url: '/admin/contatos' }
            };
            Object.keys(sections).forEach(key => {
                const section = sections[key];
                if (section.data && section.data.length > 0) {
                    section.list.parentElement.classList.remove('hidden');
                    section.list.innerHTML = ''; // Limpar antes de anexar
                    section.data.forEach(item => {
                        const a = document.createElement('a');
                        a.href = `${section.url}?id=${item.id}`;
                        a.className = 'flex items-center gap-3 p-2 rounded-xl hover:bg-white/5 transition-all group';
                        
                        const icon = document.createElement('span');
                        icon.className = 'material-symbols-outlined text-sm text-gray-500 group-hover:text-cyber-500';
                        icon.textContent = section.icon;
                        
                        const name = document.createElement('span');
                        name.className = 'text-[10px] font-bold text-gray-300 group-hover:text-white';
                        name.textContent = item.name || item.title; // Sanitização automática via textContent
                        
                        a.appendChild(icon);
                        a.appendChild(name);
                        section.list.appendChild(a);
                    });
                } else { section.list.parentElement.classList.add('hidden'); }
            });
        }
    </script>

    <!-- Notification Drawer -->
    <div id="notification-drawer" class="fixed top-0 right-[-400px] w-[400px] h-full bg-dark-950/98 backdrop-blur-3xl border-l border-white/5 z-[1100] transition-all duration-500 shadow-[-20px_0_50px_rgba(0,0,0,0.5)]">
        <div class="p-8 h-full flex flex-col">
            <div class="flex items-center justify-between mb-8">
                <h3 class="text-xl font-black text-white tracking-tighter flex items-center gap-3">
                    <span class="material-symbols-outlined text-cyber-500">notifications_active</span>
                    Central de <span class="text-cyber-500">Alertas</span>
                </h3>
                <button id="close-notifications" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-gray-500 hover:text-white transition-all">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto space-y-4 no-scrollbar">
                <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/5 hover:border-cyber-500/20 transition-all cursor-pointer group">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[8px] font-black text-cyber-500 uppercase tracking-widest">Novo Lead</span>
                        <span class="text-[8px] font-bold text-gray-600">Agora</span>
                    </div>
                    <h4 class="text-[11px] font-black text-white group-hover:text-cyber-500 transition-colors">Nova negociação: Residência Alpha</h4>
                    <p class="text-[9px] text-gray-500 font-medium mt-1">Briefing técnico recebido via portal.</p>
                </div>
            </div>

            <button class="w-full py-4 rounded-2xl border border-white/5 text-[9px] font-black text-gray-500 uppercase tracking-widest hover:bg-white/5 transition-all mt-6">
                Limpar Notificações
            </button>
        </div>
    </div>

    <script>
        // Notification Drawer
        const notifBtn = document.getElementById('btn-notifications');
        const notifDrawer = document.getElementById('notification-drawer');
        const closeNotif = document.getElementById('close-notifications');

        notifBtn?.addEventListener('click', (e) => { e.stopPropagation(); notifDrawer.classList.toggle('right-0'); notifDrawer.classList.toggle('right-[-400px]'); });
        closeNotif?.addEventListener('click', () => { notifDrawer.classList.add('right-[-400px]'); notifDrawer.classList.remove('right-0'); });

        document.addEventListener('click', (e) => {
            if (!searchInput?.contains(e.target) && !searchResults?.contains(e.target)) searchResults?.classList.add('hidden');
            if (!notifDrawer?.contains(e.target) && !notifBtn?.contains(e.target)) { notifDrawer?.classList.add('right-[-400px]'); notifDrawer?.classList.remove('right-0'); }
        });

        window.showNotification = showNotification;

        // === DEEP LINKING ENGINE ===
        function checkUrlParams() {
            const urlParams = new URLSearchParams(window.location.search);
            const id = urlParams.get('id');
            if (!id) return;

            // Se estivermos no CRM (Negociações)
            if (window.location.pathname.includes('/negociacoes')) {
                if (typeof openDealDetails === 'function') {
                    openDealDetails(id);
                } else {
                    setTimeout(() => { if (typeof openDealDetails === 'function') openDealDetails(id); }, 800);
                }
            }
            // Se estivermos em Projetos (Kanban)
            else if (window.location.pathname.includes('/projetos/kanban')) {
                setTimeout(() => {
                    const card = document.querySelector(`.kanban-card[data-id="${id}"]`);
                    if (card) card.click();
                }, 800);
            }
        }

        window.addEventListener('load', checkUrlParams);
    </script>

    <!-- AOS Initializer -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true,
            offset: 50
        });
    </script>

</body>
</html>
