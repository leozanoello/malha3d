    <script>
        // === SISTEMA DE AUTO-SAVE PARA FORMULÁRIOS ===
        // Salva o estado de qualquer form no sessionStorage enquanto o usuário digita.
        // Quando reabrir o modal, os dados voltam automaticamente.
        (function() {
            const STORAGE_PREFIX = 'malha3d_form_draft_';

            function getFormKey(form) {
                if (form.id) return STORAGE_PREFIX + form.id;
                // Fallback: hash simples baseado na estrutura
                return STORAGE_PREFIX + 'auto_' + Array.from(form.querySelectorAll('input,select,textarea')).slice(0,3).map(e => e.name || e.id || '').join('_').replace(/\s+/g, '_');
            }

            function serializeForm(form) {
                const data = {};
                const elements = form.querySelectorAll('input, select, textarea');
                elements.forEach(el => {
                    if (!el.name && !el.id) return;
                    const key = el.name || el.id;
                    if (el.type === 'checkbox') data[key] = el.checked;
                    else if (el.type === 'radio') {
                        if (el.checked) data[key] = el.value;
                    } else if (el.tagName === 'SELECT' && el.multiple) {
                        data[key] = Array.from(el.selectedOptions).map(o => o.value);
                    } else {
                        data[key] = el.value;
                    }
                });
                return data;
            }

            function restoreForm(form) {
                const key = getFormKey(form);
                try {
                    const raw = localStorage.getItem(key);
                    if (!raw) return;
                    const data = JSON.parse(raw);
                    const elements = form.querySelectorAll('input, select, textarea');
                    elements.forEach(el => {
                        if (!el.name && !el.id) return;
                        const k = el.name || el.id;
                        if (!(k in data)) return;
                        if (el.type === 'checkbox') el.checked = !!data[k];
                        else if (el.type === 'radio') el.checked = (el.value === data[k]);
                        else el.value = data[k];
                    });
                } catch (e) { console.warn('restoreForm failed', e); }
            }

            function attachAutosave(form) {
                if (!form || form.dataset.autosave === '1') return;
                form.dataset.autosave = '1';
                const key = getFormKey(form);
                // Restaurar dados existentes
                restoreForm(form);
                // Expõe método manual de restore
                form.restoreFromStorage = function() { restoreForm(form); };
                // Salvar ao digitar/mudar
                form.addEventListener('input', function() {
                    try {
                        localStorage.setItem(key, JSON.stringify(serializeForm(form)));
                    } catch (e) { /* localStorage cheio, ignorar */ }
                });
                form.addEventListener('change', function() {
                    try {
                        localStorage.setItem(key, JSON.stringify(serializeForm(form)));
                    } catch (e) {}
                });
                // Limpar ao enviar com sucesso
                form.addEventListener('submit', function() {
                    try { localStorage.removeItem(key); } catch (e) {}
                }, true);
            }

            // Expõe API global
            window.attachAutosave = attachAutosave;
            window.clearFormDraft = function(formId) {
                try { localStorage.removeItem(STORAGE_PREFIX + formId); } catch (e) {}
            };

            // Auto-aplicar a todos os forms de modal
            document.addEventListener('DOMContentLoaded', function() {
                const modalForms = document.querySelectorAll('.modal form, [id$="Modal"] form, [id$="modal"] form, #editLeadForm, #newLeadForm, #globalRegistryForm, #newTransactionForm, #editUserForm');
                modalForms.forEach(attachAutosave);
                // Re-aplicar sempre que um modal for aberto (forms dinâmicos)
                const observer = new MutationObserver(function(mutations) {
                    mutations.forEach(function(m) {
                        m.addedNodes.forEach(function(node) {
                            if (node.nodeType === 1) {
                                if (node.tagName === 'FORM') attachAutosave(node);
                                if (node.querySelectorAll) {
                                    node.querySelectorAll('form').forEach(attachAutosave);
                                }
                            }
                        });
                    });
                });
                observer.observe(document.body, { childList: true, subtree: true });
            });
        })();
    </script>

