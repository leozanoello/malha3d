            background: rgba(0,0,0,0.04);
            border-color: rgba(0,0,0,0.10);
        }
        body.theme-light .kcard-badge-orange { color: #c2410c; background: rgba(249,115,22,0.08); border-color: rgba(249,115,22,0.2); }
        body.theme-light .kcard-badge-red { color: #b91c1c; background: rgba(239,68,68,0.08); border-color: rgba(239,68,68,0.2); }
