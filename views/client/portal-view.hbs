<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            500: '#ff8c00', // Neon Orange
                            600: '#e67e00',
                            800: '#003559',
                            900: '#002540',
                        },
                        cyber: {
                            500: '#00f2ff', // Cyber Cyan
                        },
                        dark: {
                            900: '#0f172a',
                            950: '#05070a', // Deep Space
                        }
                    },
                    fontFamily: {
                        sans: ['Space Grotesk', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <!-- Google Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Space Grotesk', sans-serif;
            background-color: #05070a;
            color: #f3f4f6;
            background-image: 
                radial-gradient(at 0% 0%, rgba(255, 140, 0, 0.05) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(0, 242, 255, 0.05) 0px, transparent 50%);
            background-attachment: fixed;
        }
        
        .glass-panel {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .text-gradient {
            background: linear-gradient(135deg, #ffffff 0%, #ff8c00 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .tab-btn.active {
            background: rgba(255, 140, 0, 0.1);
            border-color: rgba(255, 140, 0, 0.3);
            color: #ff8c00;
        }
    </style>

    {{#if cpSettings}}
    <style>
        body {
            background-color: {{cpSettings.cp_color_bg}} !important;
            background-image: 
                radial-gradient(at 0% 0%, {{cpSettings.cp_color_accent}}0d 0px, transparent 50%),
                radial-gradient(at 100% 100%, {{cpSettings.cp_color_accent}}0d 0px, transparent 50%) !important;
        }
        .text-orange-500, .text-primary-500 {
            color: {{cpSettings.cp_color_accent}} !important;
        }
        .bg-orange-500, .bg-primary-500 {
            background-color: {{cpSettings.cp_color_accent}} !important;
        }
        .bg-orange-500\/10 {
            background-color: {{cpSettings.cp_color_accent}}1a !important;
        }
        .border-orange-500\/20 {
            border-color: {{cpSettings.cp_color_accent}}33 !important;
        }
        .border-orange-500\/10 {
            border-color: {{cpSettings.cp_color_accent}}1a !important;
        }
        .tab-btn.active {
            background: {{cpSettings.cp_color_accent}}1a !important;
            border-color: {{cpSettings.cp_color_accent}}4d !important;
            color: {{cpSettings.cp_color_accent}} !important;
        }
        .hover\:bg-orange-600:hover {
            background-color: {{cpSettings.cp_color_accent}}cc !important;
        }
        .hover\:border-orange-500\/20:hover {
            border-color: {{cpSettings.cp_color_accent}}33 !important;
        }
        .text-gradient {
            background: linear-gradient(135deg, #ffffff 0%, {{cpSettings.cp_color_accent}} 100%) !important;
            -webkit-background-clip: text !important;
            -webkit-text-fill-color: transparent !important;
        }
        .bg-gradient-to-tr {
            background-image: linear-gradient(to top right, {{cpSettings.cp_color_accent}}, #f59e0b) !important;
        }
        .bg-gradient-to-br {
            background-image: linear-gradient(to bottom right, {{cpSettings.cp_color_accent}}1a, transparent) !important;
        }
    </style>
    {{/if}}
</head>
<body class="min-h-screen py-10 px-4 md:px-8">

    <!-- Top Branding Header -->
    <div class="max-w-7xl mx-auto mb-10">
        <div class="flex items-center justify-between p-6 glass-panel rounded-3xl">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-orange-500 to-amber-500 flex items-center justify-center text-white shadow-lg shadow-orange-500/20">
                    <span class="material-symbols-outlined font-black">layers</span>
                </div>
                <div>
                    <span class="text-lg font-black tracking-wider text-white uppercase">Malha<span class="text-orange-500">3D</span></span>
                    <span class="text-[9px] block text-gray-500 uppercase tracking-[0.2em] -mt-1 font-bold">archviz</span>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-xs font-bold text-gray-400 uppercase tracking-widest hidden sm:inline">Conexão Segura Ativa</span>
            </div>
        </div>
    </div>

    <!-- Main Workspace -->
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Left Side: Profile Bento & Navigation -->
        <div class="lg:col-span-4 space-y-6">
            <!-- Profile Card -->
            <div class="glass-panel p-8 rounded-[2rem] relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-orange-500/5 blur-[50px] -mr-16 -mt-16"></div>
                <div class="relative z-10">
                    <div class="w-20 h-20 rounded-2xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-500 font-bold text-3xl mb-6">
                        {{firstLetter client.name}}
                    </div>
                    <span class="text-[10px] text-orange-500 font-black uppercase tracking-[0.2em]">Área Exclusiva</span>
                    <h2 class="text-2xl font-black text-white mt-1 mb-2 tracking-tight">{{client.name}}</h2>
                    <p class="text-xs text-gray-400 font-medium mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm text-gray-500">business</span>
                        {{client.company}}
                    </p>
                    
                    <div class="pt-6 border-t border-white/5 space-y-4">
                        <div class="flex justify-between items-center text-xs">
                            <span class="text-gray-500 font-bold uppercase tracking-wider">E-mail</span>
                            <span class="text-white font-mono">{{client.email}}</span>
                        </div>
                        <div class="flex justify-between items-center text-xs">
                            <span class="text-gray-500 font-bold uppercase tracking-wider">Telefone</span>
                            <span class="text-white font-mono">{{client.phone}}</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab Switcher -->
            <div class="glass-panel p-4 rounded-3xl space-y-2">
                <button onclick="switchTab('projects')" id="tab-btn-projects" class="tab-btn active w-full flex items-center justify-between p-4 rounded-2xl border border-transparent hover:bg-white/[0.02] transition-all text-left text-sm font-bold text-gray-400">
                    <span class="flex items-center gap-3">
                        <span class="material-symbols-outlined">architecture</span>
                        Projetos & Produção
                    </span>
                    <span class="px-2 py-0.5 rounded-lg bg-white/5 text-[10px] text-white">{{activeProjects.length}}</span>
                </button>
                <button onclick="switchTab('budgets')" id="tab-btn-budgets" class="tab-btn w-full flex items-center justify-between p-4 rounded-2xl border border-transparent hover:bg-white/[0.02] transition-all text-left text-sm font-bold text-gray-400">
                    <span class="flex items-center gap-3">
                        <span class="material-symbols-outlined">receipt_long</span>
                        Propostas & Orçamentos
                    </span>
                    <span class="px-2 py-0.5 rounded-lg bg-white/5 text-[10px] text-white">{{activeBudgets.length}}</span>
                </button>
            </div>
            
            <!-- Standard FAQ/Support Card -->
            <div class="glass-panel p-8 rounded-[2rem] bg-gradient-to-br from-orange-500/[0.02] to-transparent border-orange-500/10">
                <h4 class="text-sm font-black text-white uppercase tracking-wider mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-orange-500 text-lg">support_agent</span>
                    Precisa de Ajustes?
                </h4>
                <p class="text-xs text-gray-400 leading-relaxed mb-6">Cada renderização conta com nossa garantia de fidelidade. Caso necessite revisar materiais, iluminação ou layout, entre em contato diretamente pelo WhatsApp do estúdio.</p>
                <a href="https://wa.me/554920181541" target="_blank" class="w-full py-4 rounded-2xl bg-orange-500 hover:bg-orange-600 text-white font-black text-xs uppercase tracking-widest transition-all flex items-center justify-center gap-2 shadow-lg shadow-orange-500/10">
                    <i class="fab fa-whatsapp"></i> Solicitar Revisão
                </a>
            </div>
        </div>
        
        <!-- Right Side: Content Dynamic Panels -->
        <div class="lg:col-span-8">
            
            <!-- PROJECTS TAB -->
            <div id="panel-projects" class="tab-panel space-y-8">
                <!-- In Progress Projects -->
                <div class="glass-panel p-8 rounded-[2rem]">
                    <div class="flex items-center justify-between mb-8">
                        <div>
                            <h3 class="text-xl font-black text-white tracking-tight flex items-center gap-2">
                                <span class="material-symbols-outlined text-orange-500">progress_activity</span>
                                Projetos em Andamento
                            </h3>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wider mt-1">Acompanhamento de produção em tempo real</p>
                        </div>
                    </div>

                    <div class="space-y-6">
                        {{#each activeProjects}}
                        <div class="p-6 rounded-2xl bg-black/20 border border-white/5 hover:border-orange-500/20 transition-all">
                            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-xl bg-orange-500/10 flex items-center justify-center text-orange-500">
                                        <span class="material-symbols-outlined">view_in_ar</span>
                                    </div>
                                    <div>
                                        <h4 class="text-sm font-black text-white">{{this.title}}</h4>
                                        <div class="flex items-center gap-2 mt-1">
                                            <span class="text-[9px] text-gray-500 font-bold uppercase tracking-wider">{{this.category}}</span>
                                            <span class="w-1 h-1 rounded-full bg-gray-700"></span>
                                            <span class="text-[9px] text-orange-500 font-bold uppercase tracking-wider">{{this.renderEngine}}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-6">
                                    <div class="text-right">
                                        <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-1">Status da Etapa</p>
                                        <span class="px-3 py-1 rounded-full bg-orange-500/10 text-orange-500 border border-orange-500/20 text-[9px] font-black uppercase tracking-wider">
                                            {{this.status}}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{else}}
                        <div class="p-16 text-center border border-dashed border-white/5 rounded-2xl">
                            <span class="material-symbols-outlined text-4xl text-gray-700 mb-4">architecture</span>
                            <h5 class="text-sm font-bold text-gray-400">Nenhum projeto ativo no momento</h5>
                            <p class="text-xs text-gray-600 mt-1">Quando iniciarmos a produção do seu modelo 3D, ele aparecerá aqui.</p>
                        </div>
                        {{/each}}
                    </div>
                </div>

                <!-- Completed / Executed Projects -->
                <div class="glass-panel p-8 rounded-[2rem]">
                    <div class="flex items-center justify-between mb-8">
                        <div>
                            <h3 class="text-xl font-black text-white tracking-tight flex items-center gap-2">
                                <span class="material-symbols-outlined text-orange-500">cloud_done</span>
                                Entregas Concluídas & Downloads
                            </h3>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wider mt-1">Acesse e faça o download dos seus renders finais</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {{#each completedProjects}}
                        <div class="glass-panel rounded-2xl overflow-hidden hover:border-orange-500/20 transition-all flex flex-col justify-between">
                            <div class="relative h-48 bg-gray-900 overflow-hidden">
                                {{#if this.image}}
                                <img src="{{this.image}}" alt="{{this.title}}" class="w-full h-full object-cover">
                                {{else}}
                                <div class="w-full h-full flex items-center justify-center bg-black/40">
                                    <span class="material-symbols-outlined text-4xl text-gray-700">image</span>
                                </div>
                                {{/if}}
                                
                                <!-- Dynamic Watermark Overlay -->
                                {{#if (eq ../cpSettings.cp_watermark "true")}}
                                <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none z-10 overflow-hidden" style="opacity: calc({{../cpSettings.cp_wm_opacity}} / 100);">
                                    {{#if (eq ../cpSettings.cp_wm_pos "diagonal")}}
                                    <span class="text-xs font-black uppercase tracking-[0.25em] text-white/50 transform -rotate-45 whitespace-nowrap">{{../cpSettings.cp_wm_text}}</span>
                                    {{/if}}
                                    {{#if (eq ../cpSettings.cp_wm_pos "center")}}
                                    <span class="text-xs font-black uppercase tracking-[0.25em] text-white/50 whitespace-nowrap">{{../cpSettings.cp_wm_text}}</span>
                                    {{/if}}
                                    {{#if (eq ../cpSettings.cp_wm_pos "bottom")}}
                                    <span class="absolute bottom-2 left-1/2 transform -translate-x-1/2 text-[9px] font-black uppercase tracking-[0.2em] text-white/50 whitespace-nowrap">{{../cpSettings.cp_wm_text}}</span>
                                    {{/if}}
                                    {{#if (eq ../cpSettings.cp_wm_pos "tile")}}
                                    <div class="w-full h-full flex flex-wrap gap-4 items-center justify-center p-2">
                                        <span class="text-[8px] font-black uppercase tracking-wider text-white/40 rotate-12">{{../cpSettings.cp_wm_text}}</span>
                                        <span class="text-[8px] font-black uppercase tracking-wider text-white/40 rotate-12">{{../cpSettings.cp_wm_text}}</span>
                                        <span class="text-[8px] font-black uppercase tracking-wider text-white/40 rotate-12">{{../cpSettings.cp_wm_text}}</span>
                                        <span class="text-[8px] font-black uppercase tracking-wider text-white/40 rotate-12">{{../cpSettings.cp_wm_text}}</span>
                                    </div>
                                    {{/if}}
                                </div>
                                {{/if}}

                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                                <div class="absolute bottom-4 left-4 right-4">
                                    <span class="text-[8px] bg-emerald-500 text-white font-black px-2 py-0.5 rounded-md uppercase tracking-wider">Finalizado</span>
                                    <h4 class="text-sm font-black text-white mt-1">{{this.title}}</h4>
                                </div>
                            </div>
                            <div class="p-6 bg-black/20 space-y-4">
                                <p class="text-xs text-gray-400 line-clamp-2">{{this.description}}</p>
                                <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                                    <span class="text-[9px] text-gray-500 font-bold uppercase tracking-wider">{{this.renderEngine}}</span>
                                    <a href="{{this.image}}" download class="btn-download-uhd flex items-center gap-2 text-xs font-black text-orange-500 hover:text-orange-400 transition-all uppercase tracking-wider" data-title="{{this.title}}">
                                        <span class="material-symbols-outlined text-sm">download</span> Download Ultra-HD
                                    </a>
                                </div>
                            </div>
                        </div>
                        {{else}}
                        <div class="col-span-2 p-16 text-center border border-dashed border-white/5 rounded-2xl">
                            <span class="material-symbols-outlined text-4xl text-gray-700 mb-4">folder_zip</span>
                            <h5 class="text-sm font-bold text-gray-400">Nenhum render finalizado disponível para download</h5>
                            <p class="text-xs text-gray-600 mt-1">Após a conclusão e aprovação digital do projeto, os arquivos UHD serão disponibilizados aqui.</p>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>

            <!-- BUDGETS TAB -->
            <div id="panel-budgets" class="tab-panel space-y-8 hidden">
                <!-- Active Proposals -->
                <div class="glass-panel p-8 rounded-[2rem]">
                    <div class="flex items-center justify-between mb-8">
                        <div>
                            <h3 class="text-xl font-black text-white tracking-tight flex items-center gap-2">
                                <span class="material-symbols-outlined text-orange-500">pending_actions</span>
                                Orçamentos em Análise
                            </h3>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wider mt-1">Acompanhe as propostas e custos em aberto</p>
                        </div>
                    </div>

                    <div class="space-y-6">
                        {{#each activeBudgets}}
                        <div class="p-6 rounded-2xl bg-black/20 border border-white/5 hover:border-orange-500/20 transition-all">
                            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-xl bg-orange-500/10 flex items-center justify-center text-orange-500">
                                        <span class="material-symbols-outlined">request_quote</span>
                                    </div>
                                    <div>
                                        <h4 class="text-sm font-black text-white">{{this.name}}</h4>
                                        <div class="flex items-center gap-2 mt-1">
                                            <span class="text-[9px] text-gray-500 font-bold uppercase tracking-wider">{{this.projectType}}</span>
                                            <span class="w-1 h-1 rounded-full bg-gray-700"></span>
                                            <span class="text-[9px] text-orange-500 font-bold uppercase tracking-wider">{{this.complexity}}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-6">
                                    <div class="text-right">
                                        <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-1">Valor Estimado</p>
                                        <span class="text-sm font-black text-white font-mono">
                                            R$ {{this.estimatedValue}}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{else}}
                        <div class="p-16 text-center border border-dashed border-white/5 rounded-2xl">
                            <span class="material-symbols-outlined text-4xl text-gray-700 mb-4">drafts</span>
                            <h5 class="text-sm font-bold text-gray-400">Nenhum orçamento ativo no momento</h5>
                            <p class="text-xs text-gray-600 mt-1">Seus novos briefings de projeto e propostas comerciais em negociação serão exibidos aqui.</p>
                        </div>
                        {{/each}}
                    </div>
                </div>

                <!-- Executed Proposals / Contracts -->
                <div class="glass-panel p-8 rounded-[2rem]">
                    <div class="flex items-center justify-between mb-8">
                        <div>
                            <h3 class="text-xl font-black text-white tracking-tight flex items-center gap-2">
                                <span class="material-symbols-outlined text-orange-500">verified</span>
                                Propostas Executadas & Contratos
                            </h3>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wider mt-1">Histórico de orçamentos aprovados e fechados</p>
                        </div>
                    </div>

                    <div class="space-y-6">
                        {{#each executedBudgets}}
                        <div class="p-6 rounded-2xl bg-black/20 border border-white/5 hover:border-emerald-500/20 transition-all flex items-center justify-between">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-500">
                                    <span class="material-symbols-outlined">receipt_long</span>
                                </div>
                                <div>
                                    <h4 class="text-sm font-black text-white">{{this.name}}</h4>
                                    <p class="text-[9px] text-gray-500 font-bold uppercase tracking-wider mt-1">{{this.projectType}}</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="text-[9px] font-black text-emerald-500 uppercase tracking-widest mb-1 flex items-center gap-1 justify-end">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Aprovado
                                </p>
                                <span class="text-sm font-black text-white font-mono">R$ {{this.estimatedValue}}</span>
                            </div>
                        </div>
                        {{else}}
                        <div class="p-16 text-center border border-dashed border-white/5 rounded-2xl">
                            <span class="material-symbols-outlined text-4xl text-gray-700 mb-4">history</span>
                            <h5 class="text-sm font-bold text-gray-400">Nenhum contrato fechado listado</h5>
                            <p class="text-xs text-gray-600 mt-1">Aqui ficará o histórico financeiro e de orçamentos aprovados pelo seu estúdio.</p>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>

        </div>

    </div>

    <!-- Modal de Assinatura Digital do Cliente -->
    <div id="sigModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md hidden transition-all duration-300">
        <div class="glass-panel p-8 rounded-[2rem] max-w-lg w-full mx-4 shadow-2xl relative">
            <button onclick="closeSigModal()" class="absolute top-6 right-6 text-gray-500 hover:text-white transition-all">
                <span class="material-symbols-outlined">close</span>
            </button>
            <div class="flex items-center gap-3 mb-6">
                <div class="w-12 h-12 rounded-2xl bg-orange-500/10 flex items-center justify-center text-orange-500 border border-orange-500/20">
                    <span class="material-symbols-outlined">draw</span>
                </div>
                <div>
                    <h3 class="text-lg font-black text-white uppercase tracking-wider">Aceite Digital de Entrega</h3>
                    <p class="text-[9px] font-bold text-gray-500 uppercase tracking-widest mt-0.5">Assine para liberar o download UHD</p>
                </div>
            </div>
            
            <p class="text-xs text-gray-400 leading-relaxed mb-6">
                Ao prosseguir com o download da imagem em resolução máxima original UHD, você confirma o recebimento formal desta entrega e expressa seu aceite de conformidade quanto aos materiais, texturas e detalhamento 3D desenvolvidos.
            </p>

            <form id="sig-form" class="space-y-6" onsubmit="handleSigSubmit(event)">
                <input type="hidden" id="sig-download-url">
                
                <div class="flex items-start gap-3 p-4 rounded-xl bg-black/20 border border-white/5">
                    <input type="checkbox" id="sig-agree" class="mt-1 cursor-pointer accent-orange-500" required>
                    <label for="sig-agree" class="text-[10px] text-gray-400 font-bold uppercase tracking-wide leading-relaxed cursor-pointer select-none">
                        Confirmo que revisei o render e dou meu aceite formal de conformidade com o projeto contratado.
                    </label>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Assinatura Eletrônica (Nome Completo)</label>
                    <input type="text" id="sig-name" class="w-full px-4 py-3 bg-black/40 border border-white/5 rounded-2xl text-xs font-semibold text-white focus:outline-none focus:border-orange-500 transition-all font-mono" placeholder="Digite seu nome completo" required>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4">
                    <button type="button" onclick="closeSigModal()" class="px-6 py-3 rounded-2xl border border-white/5 text-[10px] font-black text-gray-400 uppercase tracking-widest hover:text-white transition-all">
                        Cancelar
                    </button>
                    <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white px-8 py-3 rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-lg shadow-orange-500/20 transition-all">
                        Assinar & Baixar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Script to toggle active tabs & handle signature downloads -->
    <script>
        function switchTab(tabId) {
            // Hide all tab panels
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
            
            // Remove active style from all tab buttons
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            
            // Show target panel
            document.getElementById('panel-' + tabId).classList.remove('hidden');
            
            // Active current tab button
            document.getElementById('tab-btn-' + tabId).classList.add('active');
        }

        // Digital Signature System
        const requireSig = "{{cpSettings.cp_require_sig}}" === 'true';

        document.querySelectorAll('.btn-download-uhd').forEach(btn => {
            btn.addEventListener('click', function(e) {
                if (requireSig) {
                    e.preventDefault();
                    openSigModal(this.href);
                }
            });
        });

        function openSigModal(downloadUrl) {
            document.getElementById('sig-download-url').value = downloadUrl;
            document.getElementById('sigModal').classList.remove('hidden');
            document.getElementById('sig-agree').checked = false;
            document.getElementById('sig-name').value = '';
        }

        function closeSigModal() {
            document.getElementById('sigModal').classList.add('hidden');
        }

        function handleSigSubmit(e) {
            e.preventDefault();
            const agree = document.getElementById('sig-agree').checked;
            const name = document.getElementById('sig-name').value.trim();
            const downloadUrl = document.getElementById('sig-download-url').value;

            if (!agree || !name) {
                alert('Por favor, aceite os termos e preencha sua assinatura.');
                return;
            }

            console.log('Digital signature received:', { name, date: new Date(), url: downloadUrl });

            // Create temporary link to perform actual download
            const link = document.createElement('a');
            link.href = downloadUrl;
            link.download = '';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            closeSigModal();
        }
    </script>
</body>
</html>
