<div class="container-fluid py-4 h-screen flex flex-col overflow-hidden">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8 flex-shrink-0">
        <div class="flex flex-col gap-1">
            <h1 class="text-3xl font-black text-white tracking-tight">CRM <span class="text-cyber-500">Inteligência Comercial</span></h1>
            <div class="flex items-center gap-6 mt-4 border-b border-white/5 pb-2">
                <button class="crm-page-tab active text-[10px] font-black uppercase tracking-[0.2em] text-cyber-500 relative pb-2 group" data-tab="kanban">
                    Quadro Kanban
                    <div class="absolute bottom-0 left-0 w-full h-0.5 bg-cyber-500"></div>
                </button>
                <button class="crm-page-tab text-[10px] font-black uppercase tracking-[0.2em] text-gray-500 hover:text-white transition-all pb-2 group relative" data-tab="analytics">
                    Análise & Previsão
                    <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyber-500 group-hover:w-full transition-all"></div>
                </button>
            </div>
        </div>
        <div class="flex items-center gap-4">
            <div class="glass-card px-4 py-2 border-white/5 flex items-center gap-3">
                <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Pipeline Total:</span>
                <span class="text-lg font-black text-white">{{formatCurrency totalNegotiationValue}}</span>
            </div>
            <button id="btn-new-deal" class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-3 rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-lg shadow-orange-500/20 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">add_circle</span> Novo Negócio
            </button>
        </div>
    </div>

    <!-- View Containers -->
    <div id="kanban-board-container" class="flex-1 flex flex-col min-h-0">
        <!-- Kanban Board -->
        <div id="kanban-board" class="flex-1 flex gap-6 overflow-x-auto pb-6 scrollbar-hide select-none">
            {{#each columns}}
            <div class="kanban-column w-80 flex-shrink-0 flex flex-col h-full" data-status="{{this.statusKey}}" data-id="{{this.id}}">
                <!-- Column Header -->
                <div class="glass-card mb-4 border-white/10 relative overflow-hidden flex-shrink-0 min-h-[90px] flex flex-col justify-center" style="border-top: 4px solid {{this.color}}">
                    <div class="p-4 flex items-center justify-between">
                        <div class="overflow-hidden">
                            <h3 class="text-xs font-black text-white uppercase tracking-widest flex items-center gap-2 truncate pr-2">
                                {{this.title}}
                                <span class="bg-white/5 text-gray-500 px-2 py-0.5 rounded-full text-[8px]">{{length (lookup ../kanban this.statusKey)}}</span>
                            </h3>
                            <p class="text-[9px] font-bold text-gray-500 mt-1 uppercase tracking-tighter">
                                Total: <span class="text-cyber-400">{{formatCurrency (lookup ../pipelineTotals this.statusKey)}}</span>
                            </p>
                        </div>
                        <div class="dropdown">
                            <button class="text-gray-600 hover:text-white transition-all" data-bs-toggle="dropdown">
                                <span class="material-symbols-outlined">more_vert</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark glass-card border-white/10 bg-dark-950 p-2">
                                <li><a class="dropdown-item rounded-xl text-[10px] font-bold uppercase py-2 btn-edit-column" href="#" data-id="{{this.id}}" data-title="{{this.title}}" data-color="{{this.color}}">Editar Coluna</a></li>
                                <li><hr class="dropdown-divider border-white/5"></li>
                                <li><a class="dropdown-item rounded-xl text-[10px] font-bold uppercase py-2 text-red-500 btn-delete-column" href="#" data-id="{{this.id}}">Excluir Coluna</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Cards Container -->
                <div class="cards-list flex-1 overflow-y-auto space-y-4 pr-2 scrollbar-hide" data-status="{{this.statusKey}}">
                    {{#each (lookup ../kanban this.statusKey)}}
                    <div class="kanban-card glass-card p-5 border-white/5 hover:border-white/20 transition-all cursor-grab active:cursor-grabbing group relative overflow-hidden" data-id="{{this.id}}">
                        <!-- Progress Bar -->
                        <div class="absolute top-0 left-0 w-full h-1 bg-white/5">
                            <div class="bg-cyber-500 h-full shadow-[0_0_8px_#00f2ff]" style="width: {{this.probability}}%"></div>
                        </div>
                        
                        <div class="flex justify-between items-start mb-4 mt-1">
                            <h4 class="text-xs font-black text-white leading-tight pr-4 line-clamp-2 min-h-[32px]">{{this.name}}</h4>
                            <div class="flex flex-col items-end gap-2">
                                <span class="text-[9px] font-bold text-cyber-500 bg-cyber-500/5 px-2 py-0.5 rounded-full">{{this.probability}}%</span>
                                {{#if this.client.phone}}
                                <a href="{{formatWhatsappLink this.client.phone this.client.name 'lead'}}" target="_blank" class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500/20 transition-all flex items-center justify-center stop-propagation">
                                    <i class="fab fa-whatsapp text-[10px]"></i>
                                </a>
                                {{/if}}
                            </div>
                        </div>

                        <div class="flex flex-col gap-2 mb-4">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-gray-600 text-[14px]">payments</span>
                                <span class="text-[11px] font-black text-white">{{formatCurrency this.estimatedValue}}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-gray-600 text-[14px]">calendar_today</span>
                                <span class="text-[10px] font-bold text-gray-500">{{formatDateShort this.expectedRevenueDate}}</span>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-4 border-t border-white/5">
                            <button class="bg-cyber-500 hover:bg-cyber-400 text-dark-950 px-3 py-1.5 rounded-lg font-black text-[8px] uppercase tracking-widest transition-all btn-confirm-project" data-id="{{this.id}}">
                                Confirmar Projeto
                            </button>
                            <div class="flex items-center gap-2">
                                {{#if this.nextActionDate}}
                                <div class="flex items-center gap-1 text-orange-500">
                                    <span class="material-symbols-outlined text-xs">notifications_active</span>
                                </div>
                                {{/if}}
                                <span class="text-[9px] font-black text-gray-600 uppercase tracking-widest">{{formatDateShort this.createdAt}}</span>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                    
                    {{#unless (lookup ../kanban this.statusKey)}}
                    <div class="border-2 border-dashed border-white/5 rounded-3xl p-10 flex flex-col items-center justify-center text-center opacity-30">
                        <span class="material-symbols-outlined text-3xl mb-2">move_to_inbox</span>
                        <p class="text-[10px] font-black uppercase tracking-widest">Sem Negócios</p>
                    </div>
                    {{/unless}}
                </div>
            </div>
            {{/each}}

            <!-- Add Column Button -->
            <div class="w-80 flex-shrink-0">
                <button id="btn-add-column" class="w-full h-20 border-2 border-dashed border-white/10 rounded-[2rem] flex items-center justify-center gap-3 text-gray-500 hover:text-white hover:border-white/20 transition-all group">
                    <span class="material-symbols-outlined group-hover:scale-125 transition-all">add_circle</span>
                    <span class="text-[10px] font-black uppercase tracking-[0.2em]">Adicionar Etapa</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Analytics View (Hidden by default) -->
    <div id="analytics-container" class="flex-1 overflow-y-auto hidden pb-20 scrollbar-hide">
        <!-- KPI Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
            <div class="glass-card p-6 border-white/10 relative overflow-hidden group">
                <div class="absolute -right-4 -top-4 w-24 h-24 bg-green-500/10 rounded-full blur-2xl group-hover:bg-green-500/20 transition-all"></div>
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-2xl bg-green-500/10 flex items-center justify-center border border-green-500/20">
                        <span class="material-symbols-outlined text-green-500">payments</span>
                    </div>
                    <div>
                        <h4 class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Faturamento Ganhos</h4>
                        <p class="text-2xl font-black text-white">{{formatCurrency stats.billingWon}}</p>
                    </div>
                </div>
            </div>

            <div class="glass-card p-6 border-white/10 relative overflow-hidden group">
                <div class="absolute -right-4 -top-4 w-24 h-24 bg-cyber-500/10 rounded-full blur-2xl group-hover:bg-cyber-500/20 transition-all"></div>
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-2xl bg-cyber-500/10 flex items-center justify-center border border-cyber-500/20">
                        <span class="material-symbols-outlined text-cyber-500">account_tree</span>
                    </div>
                    <div>
                        <h4 class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Pipeline Aberto</h4>
                        <p class="text-2xl font-black text-white">{{formatCurrency stats.totalInNegotiation}}</p>
                    </div>
                </div>
            </div>

            <div class="glass-card p-6 border-white/10 relative overflow-hidden group">
                <div class="absolute -right-4 -top-4 w-24 h-24 bg-orange-500/10 rounded-full blur-2xl group-hover:bg-orange-500/20 transition-all"></div>
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-2xl bg-orange-500/10 flex items-center justify-center border border-orange-500/20">
                        <span class="material-symbols-outlined text-orange-500">avg_time</span>
                    </div>
                    <div>
                        <h4 class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Ticket Médio</h4>
                        <p class="text-2xl font-black text-white">{{formatCurrency stats.ticketMedio}}</p>
                    </div>
                </div>
            </div>

            <div class="glass-card p-6 border-white/10 relative overflow-hidden group">
                <div class="absolute -right-4 -top-4 w-24 h-24 bg-purple-500/10 rounded-full blur-2xl group-hover:bg-purple-500/20 transition-all"></div>
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-2xl bg-purple-500/10 flex items-center justify-center border border-purple-500/20">
                        <span class="material-symbols-outlined text-purple-500">ads_click</span>
                    </div>
                    <div>
                        <h4 class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Taxa Conversão</h4>
                        <p class="text-2xl font-black text-white">{{round stats.conversionRate}}%</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
            <div class="glass-card p-8 border-white/10">
                <h3 class="text-lg font-black text-white mb-8 tracking-tight uppercase tracking-widest">Funil Ponderado</h3>
                <div class="h-[300px]">
                    <canvas id="weightedFunnelChart"></canvas>
                </div>
            </div>
            <div class="glass-card p-8 border-white/10">
                <h3 class="text-lg font-black text-white mb-8 tracking-tight uppercase tracking-widest">Motivos de Perda</h3>
                <div class="h-[300px]">
                    <canvas id="lossReasonsChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     MODAL: DETALHES DA NEGOCIAÇÃO (SIDE DRAWER)
     ========================================== -->
<div class="offcanvas offcanvas-end bg-dark-950 border-l border-white/10 w-full md:w-[750px] glass-blur" tabindex="-1" id="dealDetailDrawer">
    <div class="offcanvas-header p-6 border-b border-white/5 flex flex-col items-start gap-4">
        <div class="flex items-center justify-between w-full">
            <div class="flex flex-col">
                <div class="flex items-center gap-3 mb-1">
                    <span class="bg-cyber-500/10 text-cyber-500 px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest" id="drawer-id-label">#DEAL-0000</span>
                    <span class="bg-white/5 text-gray-500 px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest" id="drawer-status-label">STAGE</span>
                </div>
                <h2 class="offcanvas-title text-xl font-black text-white tracking-tight" id="drawer-name">Nome da Negociação</h2>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>

        <!-- Tab Navigation -->
        <ul class="nav nav-tabs border-0 flex gap-6 w-full mt-2" id="dealTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-gray-500 py-2 px-0 hover:text-white transition-all relative group" id="project-tab" data-bs-toggle="tab" data-bs-target="#project-content" type="button" role="tab">
                    Detalhes do Projeto
                    <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyber-500 group-hover:w-full transition-all"></div>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-gray-500 py-2 px-0 hover:text-white transition-all relative group" id="contacts-tab" data-bs-toggle="tab" data-bs-target="#contacts-content" type="button" role="tab">
                    Contatos
                    <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyber-500 group-hover:w-full transition-all"></div>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-gray-500 py-2 px-0 hover:text-white transition-all relative group" id="tasks-tab" data-bs-toggle="tab" data-bs-target="#tasks-content" type="button" role="tab">
                    Tarefas
                    <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyber-500 group-hover:w-full transition-all"></div>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-gray-500 py-2 px-0 hover:text-white transition-all relative group" id="log-tab" data-bs-toggle="tab" data-bs-target="#log-content" type="button" role="tab">
                    Chat & Histórico
                    <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyber-500 group-hover:w-full transition-all"></div>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-orange-500/50 py-2 px-0 hover:text-orange-500 transition-all relative group" id="ai-tab" data-bs-toggle="tab" data-bs-target="#ai-content" type="button" role="tab">
                    <span class="flex items-center gap-2"><span class="material-symbols-outlined text-xs">auto_awesome</span> Estratégia AI</span>
                    <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-orange-500 group-hover:w-full transition-all"></div>
                </button>
            </li>
        </ul>
    </div>
    
    <div class="offcanvas-body p-6 scrollbar-hide">
        <div class="tab-content h-full" id="dealTabsContent">
            <!-- TAB 1: DETALHES DO PROJETO -->
            <div class="tab-pane fade show active h-full" id="project-content" role="tabpanel">
                <form id="dealForm" class="space-y-8">
                    <input type="hidden" name="id" id="deal-id-input">
                    
                    <!-- Dados Comerciais -->
                    <section class="glass-card p-6 border-white/5">
                        <div class="grid grid-cols-2 gap-6">
                            <div class="col-span-2">
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Nome do Projeto</label>
                                <input type="text" name="name" class="input-premium" required>
                            </div>
                            <div>
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Valor Total (R$)</label>
                                <input type="number" step="0.01" name="estimatedValue" class="input-premium">
                            </div>
                            <div>
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Probabilidade (%)</label>
                                <input type="number" name="probability" min="0" max="100" class="input-premium">
                            </div>
                            <div>
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Data de Entrega</label>
                                <input type="date" name="deadline" class="input-premium">
                            </div>
                            <div>
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Fechamento Previsto</label>
                                <input type="date" name="expectedRevenueDate" class="input-premium">
                            </div>
                        </div>
                    </section>

                    <!-- Archviz Specs -->
                    <section class="glass-card p-6 border-white/5">
                        <h3 class="text-[10px] font-black text-white uppercase tracking-widest mb-6 flex items-center gap-2">
                            <span class="material-symbols-outlined text-orange-500 text-sm">architecture</span> Especificações Archviz
                        </h3>
                        <div class="grid grid-cols-2 gap-6">
                            <div>
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Tipo de Projeto</label>
                                <select name="projectType" class="input-premium">
                                    <option value="Interiores">Interiores</option>
                                    <option value="Arquitetônico">Arquitetônico</option>
                                    <option value="Masterplan">Masterplan</option>
                                    <option value="Produto">Produto</option>
                                </select>
                            </div>
                            <div>
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Metragem Total (m²)</label>
                                <input type="number" name="totalArea" class="input-premium">
                            </div>
                            <div>
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Software Base</label>
                                <input type="text" name="targetSoftware" class="input-premium" placeholder="Revit, SketchUp...">
                            </div>
                            <div>
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Origem do Lead</label>
                                <select name="origin" class="input-premium">
                                    <option value="Instagram">Instagram</option>
                                    <option value="Indicação">Indicação</option>
                                    <option value="Site/Google">Site/Google</option>
                                    <option value="Prospecção Ativa">Prospecção Ativa</option>
                                </select>
                            </div>
                        </div>
                    </section>

                    <!-- Deliverables -->
                    <section class="grid grid-cols-3 gap-4">
                        <div class="glass-card p-4 border-white/5 text-center">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-[0.2em] mb-2 block">Imagens</label>
                            <input type="number" name="imagesCount" class="bg-transparent text-white font-black text-center w-full focus:outline-none">
                        </div>
                        <div class="glass-card p-4 border-white/5 text-center">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-[0.2em] mb-2 block">Seg. Anim</label>
                            <input type="number" name="animationSeconds" class="bg-transparent text-white font-black text-center w-full focus:outline-none">
                        </div>
                        <div class="glass-card p-4 border-white/5 text-center">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-[0.2em] mb-2 block">Panos 360</label>
                            <input type="number" name="panoramasCount" class="bg-transparent text-white font-black text-center w-full focus:outline-none">
                        </div>
                    </section>

                    <div class="pt-6 flex gap-4">
                        <button type="submit" class="flex-1 bg-cyber-500 hover:bg-cyber-600 text-dark-950 py-4 rounded-2xl font-black text-[10px] uppercase tracking-[0.3em] transition-all">Salvar Negociação</button>
                        <button type="button" id="btn-mark-lost" class="px-6 border border-red-500/20 text-red-500 hover:bg-red-500/10 rounded-2xl font-black text-[9px] uppercase tracking-widest transition-all">Perdeu</button>
                        <button type="button" id="btn-mark-won" class="px-6 bg-green-500 hover:bg-green-600 text-white rounded-2xl font-black text-[9px] uppercase tracking-widest transition-all">Ganhou</button>
                    </div>
                </form>
            </div>

            <!-- TAB 2: CONTATOS -->
            <div class="tab-pane fade h-full" id="contacts-content" role="tabpanel">
                <div class="space-y-6">
                    <div class="flex items-center justify-between">
                        <h3 class="text-xs font-black text-white uppercase tracking-widest">Contatos Vinculados</h3>
                        <button class="bg-white/5 hover:bg-white/10 text-white px-4 py-2 rounded-xl text-[9px] font-black uppercase tracking-widest transition-all flex items-center gap-2" id="btn-add-contact-deal">
                            <span class="material-symbols-outlined text-xs">person_add</span> Vincular Contato
                        </button>
                    </div>

                    <div id="deal-contacts-list" class="space-y-3">
                        <!-- Listagem Dinâmica de Contatos -->
                        <div class="flex items-center justify-center py-20 text-center opacity-20">
                            <div class="flex flex-col items-center">
                                <span class="material-symbols-outlined text-4xl mb-2">group_off</span>
                                <p class="text-[10px] font-black uppercase tracking-widest">Nenhum contato vinculado</p>
                            </div>
                        </div>
                    </div>

                    <!-- Search Input (Hidden initially) -->
                    <div id="contact-search-container" class="hidden glass-card p-6 border-white/10 bg-dark-900 absolute bottom-6 left-6 right-6 z-50">
                        <div class="flex items-center justify-between mb-4">
                            <h4 class="text-[10px] font-black text-white uppercase tracking-widest">Buscar Contato</h4>
                            <button class="text-gray-500 hover:text-white" id="btn-close-contact-search"><span class="material-symbols-outlined text-sm">close</span></button>
                        </div>
                        <input type="text" id="contact-search-input" class="input-premium mb-4" placeholder="Nome, e-mail ou empresa...">
                        <div id="contact-search-results" class="max-h-60 overflow-y-auto space-y-2"></div>
                    </div>
                </div>
            </div>

            <!-- TAB 3: TAREFAS -->
            <div class="tab-pane fade h-full" id="tasks-content" role="tabpanel">
                <div class="flex flex-col h-full">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-xs font-black text-white uppercase tracking-widest">To-Do List Archviz</h3>
                        <button class="bg-cyber-500/10 text-cyber-500 px-4 py-2 rounded-xl text-[9px] font-black uppercase tracking-widest transition-all" id="btn-add-task-deal">Nova Tarefa</button>
                    </div>
                    <div id="deal-tasks-list" class="flex-1 space-y-3 overflow-y-auto pr-2 scrollbar-hide">
                        <!-- Tarefas Dinâmicas -->
                    </div>
                </div>
            </div>

            <!-- TAB 4: LOG & CHAT -->
            <div class="tab-pane fade h-full" id="log-content" role="tabpanel">
                <div class="flex flex-col h-full">
                    <div id="deal-notes-timeline" class="flex-1 space-y-6 overflow-y-auto pr-2 scrollbar-hide mb-6">
                        <!-- Notas Dinâmicas -->
                    </div>
                    <div class="glass-card p-4 border-white/10 bg-white/5">
                        <textarea id="deal-note-input" class="bg-transparent border-0 w-full text-xs text-white focus:outline-none resize-none" rows="3" placeholder="Escreva um comentário ou log de interação..."></textarea>
                        <div class="flex items-center justify-between mt-2 pt-2 border-t border-white/5">
                            <div class="flex gap-2">
                                <button class="p-2 text-gray-500 hover:text-white"><span class="material-symbols-outlined text-sm">attach_file</span></button>
                                <button class="p-2 text-gray-500 hover:text-white"><span class="material-symbols-outlined text-sm">alternate_email</span></button>
                            </div>
                            <button id="btn-save-note" class="bg-cyber-500 text-dark-950 px-4 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-widest">Enviar</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 5: AI STRATEGY -->
            <div class="tab-pane fade h-full" id="ai-content" role="tabpanel">
                <div class="glass-card p-8 border-orange-500/20 bg-orange-500/5 h-full flex flex-col items-center justify-center text-center">
                    <div class="w-20 h-20 rounded-full bg-orange-500/10 flex items-center justify-center mb-6 animate-pulse">
                        <span class="material-symbols-outlined text-4xl text-orange-500">auto_awesome</span>
                    </div>
                    <h3 class="text-xl font-black text-white mb-2 tracking-tight">Consultoria <span class="text-orange-500">AI Ativa</span></h3>
                    <p class="text-xs text-gray-500 max-w-xs mb-8">Nossa inteligência está analisando o histórico deste cliente e o tipo de projeto para sugerir a melhor abordagem de fechamento.</p>
                    
                    <div class="w-full space-y-4">
                        <button class="w-full glass-card p-4 border-white/10 text-left hover:bg-white/5 transition-all">
                            <p class="text-[9px] font-black text-orange-500 uppercase tracking-widest mb-1">Sugestão de E-mail</p>
                            <p class="text-[11px] text-white">Gerar e-mail de follow-up baseado em urgência de cronograma.</p>
                        </button>
                        <button class="w-full glass-card p-4 border-white/10 text-left hover:bg-white/5 transition-all">
                            <p class="text-[9px] font-black text-orange-500 uppercase tracking-widest mb-1">Argumento de Venda</p>
                            <p class="text-[11px] text-white">Destacar portfólio de Interiores Neoclássicos para este decisor.</p>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     MODAL: NOVA NEGOCIAÇÃO
     ========================================== -->
<div class="modal fade" id="newDealModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-card border-white/10 bg-dark-950 p-0 overflow-hidden">
            <div class="p-8 border-b border-white/5 bg-gradient-to-r from-cyber-500/10 to-transparent">
                <h3 class="text-2xl font-black text-white tracking-tight">Nova <span class="text-cyber-500">Negociação Archviz</span></h3>
                <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-1">Configure os parâmetros básicos do projeto</p>
            </div>
            
            <form id="newDealForm" class="p-8 space-y-8">
                <div class="grid grid-cols-2 gap-8">
                    <div class="col-span-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Nome do Projeto</label>
                        <input type="text" name="name" class="input-premium" required placeholder="Ex: Edifício Infinity - Apartamento 402">
                    </div>
                    <div>
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Valor Estimado (R$)</label>
                        <input type="number" step="0.01" name="estimatedValue" class="input-premium" placeholder="0,00">
                    </div>
                    <div>
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Etapa Inicial</label>
                        <select name="status" class="input-premium">
                            {{#each columns}}
                            <option value="{{this.statusKey}}">{{this.title}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <div>
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Tipo de Projeto</label>
                        <select name="projectType" class="input-premium">
                            <option value="Interiores">Interiores</option>
                            <option value="Arquitetônico">Arquitetônico</option>
                            <option value="Masterplan">Masterplan</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Origem</label>
                        <select name="origin" class="input-premium">
                            <option value="Instagram">Instagram</option>
                            <option value="Indicação">Indicação</option>
                            <option value="Site">Site</option>
                        </select>
                    </div>
                </div>

                <div class="pt-8 border-t border-white/5 flex gap-4">
                    <button type="submit" class="flex-1 bg-cyber-500 text-dark-950 py-4 rounded-2xl font-black text-[11px] uppercase tracking-[0.3em] transition-all shadow-lg shadow-cyber-500/20">Criar Negociação</button>
                    <button type="button" class="px-8 bg-white/5 text-white py-4 rounded-2xl font-black text-[11px] uppercase tracking-widest border border-white/10 transition-all" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

