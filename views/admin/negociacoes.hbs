<style>
    .btn-outline-cyber {
        border: 1px solid rgba(0, 242, 255, 0.2);
        color: rgba(255, 255, 255, 0.5);
    }
    .btn-check:checked + .btn-outline-cyber {
        background: rgba(0, 242, 255, 0.1);
        border-color: #00f2ff;
        color: #00f2ff;
        box-shadow: 0 0 15px rgba(0, 242, 255, 0.2);
    }
    .kanban-card:hover {
        transform: scale(1.03) translateY(-4px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.6), 0 0 25px rgba(0,242,255,0.1);
        z-index: 10;
    }
    .cards-list {
        padding: 0.5rem;
        margin: -0.5rem;
        overflow: visible;
    }
    .kanban-column {
        overflow: visible;
    }
    .sortable-ghost {
        opacity: 0.2;
        transform: scale(0.9);
    }
    /* Dynamic Empty State Logic */
    .kanban-empty-state {
        display: none;
    }
    .cards-list:not(:has(.kanban-card)) .kanban-empty-state {
        display: flex !important;
    }

    /* Dropdown clipping fix */
    .kanban-card .dropdown-menu.show {
        z-index: 9999 !important;
        position: fixed !important;
    }
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log('CRM Negociacoes Initialized');
    
    // === INITIALIZE MODALS ===
    const dealModalElement = document.getElementById('dealDetailModal');
    const newDealModalElement = document.getElementById('newDealModal');
    const columnModalElement = document.getElementById('columnSettingsModal');
    const lossModalElement = document.getElementById('lossReasonModal');
    const quickContactModalElement = document.getElementById('quickContactModal');

    window.dealDetailModal = dealModalElement ? new bootstrap.Modal(dealModalElement) : null;
    window.newDealModal = newDealModalElement ? new bootstrap.Modal(newDealModalElement) : null;
    window.columnModal = columnModalElement ? new bootstrap.Modal(columnModalElement) : null;
    window.lossModal = lossModalElement ? new bootstrap.Modal(lossModalElement) : null;
    window.quickContactModal = quickContactModalElement ? new bootstrap.Modal(quickContactModalElement) : null;

    // === GLOBAL SCOPE DEFINITIONS ===
    window.showNotification = function(msg, type) {
        const toast = document.createElement('div');
        toast.className = `fixed bottom-8 right-8 px-6 py-3 rounded-2xl font-black text-[10px] uppercase tracking-widest z-[9999] animate-bounce shadow-2xl ${type === 'success' ? 'bg-emerald-500 text-white' : 'bg-red-500 text-white'}`;
        toast.innerText = msg;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    };

    window.toggleEditMode = function(enabled) {
        const form = document.getElementById('dealForm');
        if (!form) return;
        form.querySelectorAll('input:not([type="hidden"]), select, textarea').forEach(i => {
            i.disabled = !enabled;
        });
        document.getElementById('edit-actions')?.classList.toggle('hidden', !enabled);
        document.getElementById('header-edit-actions')?.classList.toggle('hidden', !enabled);
        document.getElementById('btn-edit-toggle')?.classList.toggle('hidden', enabled);
        document.getElementById('btn-mark-won-header')?.classList.toggle('hidden', enabled);
    };

    window.openDealDetails = function(id) {
        console.log('Opening deal details for:', id);
        if (!id || id === 'undefined') return;
        
        const card = document.querySelector(`.kanban-card[data-id="${id}"]`);
        if (card) card.classList.add('opacity-50', 'pointer-events-none');

        fetch(`/api/budgets/${id}`)
            .then(res => res.json())
            .then(({ budget }) => {
                const form = document.getElementById('dealForm');
                window.toggleEditMode(false);
                
                const setVal = (name, val) => {
                    const el = form.querySelector(`[name="${name}"]`);
                    if (el) el.value = val || '';
                };

                setVal('id', budget.id);
                setVal('name', budget.name);
                setVal('estimatedValue', budget.estimatedValue);
                setVal('probability', budget.probability);
                setVal('status', budget.status);
                setVal('assignedUserId', budget.assignedUserId);
                setVal('installments', budget.installments);
                setVal('firstPreviewDate', budget.firstPreviewDate ? budget.firstPreviewDate.split('T')[0] : '');
                setVal('profileType', budget.profileType);
                setVal('projectCategory', budget.projectCategory);
                setVal('receivedFormat', budget.receivedFormat);
                setVal('fileQuality', budget.fileQuality);
                setVal('imagesCount', budget.imagesCount);
                setVal('animationSeconds', budget.animationSeconds);
                setVal('panoramasCount', budget.panoramasCount);
                setVal('desiredAtmosphere', budget.desiredAtmosphere);
                setVal('environments', budget.environments);
                setVal('humanizationLevel', budget.humanizationLevel);
                setVal('moodboardUrl', budget.moodboardUrl);
                setVal('urgencyFee', budget.urgencyFee);

                ['softwareStack', 'imageResolution', 'extraDeliverables', 'lightingMood'].forEach(key => {
                    const values = budget[key] || [];
                    form.querySelectorAll(`[name="${key}"]`).forEach(cb => {
                        cb.checked = values.includes(cb.value);
                    });
                });

                const urgCheck = form.querySelector('[name="hasUrgency"]');
                if (urgCheck) {
                    urgCheck.checked = budget.hasUrgency || false;
                    document.getElementById('urgency-percentage-edit')?.classList.toggle('hidden', !budget.hasUrgency);
                }

                document.getElementById('drawer-id-label').innerText = `#DEAL-${String(budget.id).substring(0,4)}`;
                document.getElementById('drawer-status-label').innerText = (budget.status || '').toUpperCase();
                document.getElementById('drawer-name').innerText = budget.name || '';

                loadLinkedContacts(id);
                loadTasks(id);
                loadNotes(id);
                
                window.dealDetailModal?.show();
            })
            .catch(err => {
                console.error('Error loading deal details:', err);
                window.showNotification('Erro ao carregar detalhes', 'error');
            })
            .finally(() => {
                if (card) card.classList.remove('opacity-50', 'pointer-events-none');
            });
    };

    // === CHART LOGIC ===
    const chartsData = {{{json charts}}};
    let funnelChart, lossChart;

    function initCharts() {
        if (funnelChart) funnelChart.destroy();
        if (lossChart) lossChart.destroy();

        const ctxFunnel = document.getElementById('weightedFunnelChart')?.getContext('2d');
        const ctxLoss = document.getElementById('lossReasonsChart')?.getContext('2d');

        if (ctxFunnel) {
            funnelChart = new Chart(ctxFunnel, {
                type: 'bar',
                data: {
                    labels: chartsData.funnel.labels,
                    datasets: [{
                        label: 'Valor Ponderado',
                        data: chartsData.funnel.data,
                        backgroundColor: 'rgba(0, 242, 255, 0.1)',
                        borderColor: '#00f2ff',
                        borderWidth: 2,
                        borderRadius: 12
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
            });
        }

        if (ctxLoss) {
            lossChart = new Chart(ctxLoss, {
                type: 'doughnut',
                data: {
                    labels: chartsData.lossReasons.labels,
                    datasets: [{
                        data: chartsData.lossReasons.data,
                        backgroundColor: ['#ef4444', '#f97316', '#3b82f6', '#8b5cf6'],
                        borderWidth: 0
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });
        }
    }

    // === GLOBAL EVENT DELEGATION ===
    document.addEventListener('click', function(e) {
        if (e.target.closest('.stop-propagation') || e.target.closest('[data-bs-toggle="dropdown"]')) {
            return;
        }

        const card = e.target.closest('.kanban-card');
        if (card) {
            const dealId = card.getAttribute('data-id');
            if (dealId) window.openDealDetails(dealId);
            return;
        }

        const btnEditCol = e.target.closest('.btn-edit-column');
        if (btnEditCol) {
            e.preventDefault();
            const { id, title, color } = btnEditCol.dataset;
            document.getElementById('col-id-input').value = id;
            document.getElementById('col-title-input').value = title;
            document.getElementById('col-color-input').value = color;
            document.getElementById('color-code').innerText = color.toUpperCase();
            window.columnModal?.show();
            return;
        }

        const btnDeleteCol = e.target.closest('.btn-delete-column');
        if (btnDeleteCol) {
            e.preventDefault();
            const { id } = btnDeleteCol.dataset;
            if (confirm('Deseja realmente excluir esta etapa?')) {
                fetch(`/admin/kanban/columns/${id}`, { method: 'DELETE' })
                    .then(() => window.location.reload());
            }
            return;
        }

        const btnRemContact = e.target.closest('.btn-remove-contact');
        if (btnRemContact) {
            const { dealId, clientId } = btnRemContact.dataset;
            if (confirm('Remover este contato desta negociação?')) {
                fetch(`/api/budgets/${dealId}/contacts/${clientId}`, { method: 'DELETE' })
                    .then(() => loadLinkedContacts(dealId));
            }
            return;
        }

        const btnConfirm = e.target.closest('.btn-confirm-project');
        if (btnConfirm) {
            const id = btnConfirm.dataset.id;
            if (confirm('Deseja converter esta negociação em um PROJETO ativo?')) {
                fetch(`/admin/negociacoes/${id}/confirm-project`, { method: 'POST' })
                    .then(res => res.json())
                    .then(result => {
                        if (result.success) {
                            window.showNotification('Projeto confirmado!', 'success');
                            setTimeout(() => window.location.reload(), 1000);
                        } else {
                            window.showNotification(result.error || 'Erro ao converter', 'error');
                        }
                    });
            }
            return;
        }
    });

    // === VIEW SWITCHING LOGIC ===
    const crmTabs = document.querySelectorAll('.crm-page-tab');
    crmTabs.forEach(tab => {
        tab.addEventListener('click', () => {
            crmTabs.forEach(t => {
                t.classList.remove('active', 'text-cyber-500');
                t.classList.add('text-gray-500');
                const line = t.querySelector('div');
                if (line) {
                    line.classList.remove('w-full');
                    line.classList.add('w-0');
                }
            });
            tab.classList.add('active', 'text-cyber-500');
            tab.classList.remove('text-gray-500');
            const line = tab.querySelector('div');
            if (line) {
                line.classList.remove('w-0');
                line.classList.add('w-full');
            }

            const target = tab.dataset.tab;
            if (target === 'kanban') {
                document.getElementById('kanban-board-container')?.classList.remove('hidden');
                document.getElementById('analytics-container')?.classList.add('hidden');
            } else {
                document.getElementById('kanban-board-container')?.classList.add('hidden');
                document.getElementById('analytics-container')?.classList.remove('hidden');
                if (typeof initCharts === 'function') initCharts();
            }
        });
    });

    // === KANBAN DRAG & DROP ===
    const kanbanLists = document.querySelectorAll('.cards-list');
    kanbanLists.forEach(list => {
        if (typeof Sortable !== 'undefined') {
            new Sortable(list, {
                group: 'kanban',
                animation: 250,
                ghostClass: 'sortable-ghost',
                dragClass: 'sortable-drag',
                onEnd: function(evt) {
                    const dealId = evt.item.getAttribute('data-id');
                    const newStatus = evt.to.getAttribute('data-status');
                    
                    fetch(`/admin/negociacoes/${dealId}/update-status`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ status: newStatus })
                    }).then(res => {
                        if (res.ok) window.showNotification('Status atualizado!', 'success');
                        else window.showNotification('Erro ao atualizar status', 'error');
                    });
                }
            });
        }
    });

    if (document.getElementById('kanban-board') && typeof Sortable !== 'undefined') {
        new Sortable(document.getElementById('kanban-board'), {
            draggable: '.kanban-column',
            handle: '.glass-card',
            animation: 250,
            onEnd: function() {
                const columns = [...document.querySelectorAll('.kanban-column')].map((col, index) => ({
                    id: col.dataset.id,
                    order: index
                }));
                fetch('/admin/kanban/columns/reorder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ columns })
                });
            }
        });
    }

    document.getElementById('btn-edit-toggle')?.addEventListener('click', () => window.toggleEditMode(true));
    document.getElementById('btn-cancel-header')?.addEventListener('click', () => window.toggleEditMode(false));
    document.getElementById('btn-cancel-edit')?.addEventListener('click', () => window.toggleEditMode(false));
    document.getElementById('btn-save-header')?.addEventListener('click', () => {
        document.getElementById('dealForm')?.requestSubmit();
    });

    document.getElementById('btn-new-deal')?.addEventListener('click', () => {
        document.getElementById('newDealForm')?.reset();
        document.getElementById('selected-client-display')?.classList.add('hidden');
        window.newDealModal?.show();
    });

    document.getElementById('check-urgency')?.addEventListener('change', (e) => {
        document.getElementById('urgency-percentage').classList.toggle('hidden', !e.target.checked);
    });

    document.getElementById('btn-add-column')?.addEventListener('click', () => {
        document.getElementById('col-id-input').value = '';
        document.getElementById('col-title-input').value = '';
        document.getElementById('col-color-input').value = '#f97316';
        document.getElementById('color-code').innerText = '#F97316';
        window.columnModal?.show();
    });

    document.getElementById('btn-save-note')?.addEventListener('click', saveNote);
    document.getElementById('btn-mark-won')?.addEventListener('click', markAsWon);
    document.getElementById('btn-mark-lost')?.addEventListener('click', markAsLost);
    document.getElementById('btn-mark-won-header')?.addEventListener('click', markAsWon);
    document.getElementById('btn-mark-lost-header')?.addEventListener('click', markAsLost);
    document.getElementById('btn-cancel-edit')?.addEventListener('click', () => window.toggleEditMode(false));
    document.getElementById('btn-cancel-header')?.addEventListener('click', () => window.toggleEditMode(false));
    document.getElementById('btn-edit-toggle')?.addEventListener('click', () => window.toggleEditMode(true));
    
    document.getElementById('btn-save-header')?.addEventListener('click', () => {
        document.getElementById('dealForm')?.requestSubmit();
    });

    document.getElementById('btn-close-contact-search')?.addEventListener('click', () => {
        document.getElementById('contact-search-container').classList.add('hidden');
    });

    document.getElementById('contact-search-input')?.addEventListener('input', debounce(function(e) {
        const query = e.target.value;
        if (query.length < 2) return;
        fetch(`/api/clients/search?q=${query}`)
            .then(res => res.json())
            .then(renderSearchResults);
    }, 300));

    document.getElementById('col-color-input')?.addEventListener('input', e => {
        document.getElementById('color-code').innerText = e.target.value.toUpperCase();
    });

    document.getElementById('columnForm')?.addEventListener('submit', function(e) {
        e.preventDefault();
        const id = document.getElementById('col-id-input').value;
        const data = Object.fromEntries(new FormData(this).entries());
        const method = id ? 'PUT' : 'POST';
        const url = id ? `/admin/kanban/columns/${id}` : '/admin/kanban/columns';
        
        fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...data, type: 'vendas' })
        }).then(() => window.location.reload());
    });

    document.getElementById('newDealForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const btn = this.querySelector('button[type="submit"]');
        const originalText = btn.innerText;
        btn.innerText = 'CRIANDO...';
        btn.disabled = true;

        try {
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());
            
            ['softwareStack', 'imageResolution', 'extraDeliverables', 'lightingMood'].forEach(key => {
                data[key] = Array.from(this.querySelectorAll(`[name="${key}"]:checked`)).map(cb => cb.value);
            });

            const response = await fetch('/api/budgets', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            
            if (response.ok) {
                window.showNotification('Lead criado com sucesso!', 'success');
                setTimeout(() => window.location.reload(), 800);
            } else {
                const res = await response.json();
                throw new Error(res.error || 'Erro ao criar lead');
            }
        } catch (error) {
            window.showNotification(error.message, 'error');
            btn.innerText = originalText;
            btn.disabled = false;
        }
    });

    document.getElementById('dealForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const btn = document.getElementById('btn-save-header') || this.querySelector('button[type="submit"]');
        const originalText = btn?.innerText || 'Salvar';
        if (btn) {
            btn.innerText = 'SALVANDO...';
            btn.disabled = true;
        }

        try {
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            ['softwareStack', 'imageResolution', 'extraDeliverables', 'lightingMood'].forEach(key => {
                data[key] = Array.from(this.querySelectorAll(`[name="${key}"]:checked`)).map(cb => cb.value);
            });

            const response = await fetch(`/api/budgets/${data.id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                window.showNotification('Negociação salva!', 'success');
                setTimeout(() => window.location.reload(), 500);
            } else {
                const res = await response.json();
                throw new Error(res.error || 'Erro ao salvar');
            }
        } catch (error) {
            window.showNotification(error.message, 'error');
            if (btn) {
                btn.innerText = originalText;
                btn.disabled = false;
            }
        }
    });

    // === NEW LEAD CLIENT SEARCH ===
    const clientSearchInput = document.getElementById('client-search-new-lead');
    const searchResults = document.getElementById('search-results-new-lead');

    clientSearchInput?.addEventListener('input', debounce(async (e) => {
        const query = e.target.value;
        if (query.length < 2) {
            searchResults.classList.add('hidden');
            return;
        }

        const res = await fetch(`/api/clients/search?q=${query}`);
        const clients = await res.json();

        if (clients.length > 0) {
            searchResults.innerHTML = clients.map(c => `
                <div class="p-3 hover:bg-white/5 cursor-pointer flex items-center justify-between group transition-all" onclick="selectClientForNewLead('${c.id}', '${c.name}')">
                    <div>
                        <p class="text-[10px] font-black text-white group-hover:text-cyber-500">${c.name}</p>
                        <p class="text-[8px] text-gray-500 font-bold uppercase">${c.company || 'Sem Empresa'}</p>
                    </div>
                    <span class="material-symbols-outlined text-xs text-cyber-500 opacity-0 group-hover:opacity-100">check_circle</span>
                </div>
            `).join('');
            searchResults.classList.remove('hidden');
        } else {
            searchResults.innerHTML = `<p class="p-3 text-[9px] text-gray-500 font-black uppercase text-center">Nenhum cliente encontrado</p>`;
            searchResults.classList.remove('hidden');
        }
    }, 300));

    window.selectClientForNewLead = function(id, name) {
        document.getElementById('new-lead-client-id').value = id;
        document.getElementById('client-name-display').innerText = name;
        document.getElementById('client-initial').innerText = name[0];
        document.getElementById('selected-client-display').classList.remove('hidden');
        searchResults.classList.add('hidden');
        clientSearchInput.value = '';
    };

    window.clearSelectedClient = function() {
        document.getElementById('new-lead-client-id').value = '';
        document.getElementById('selected-client-display').classList.add('hidden');
    };

    window.openQuickContact = function() {
        window.quickContactModal?.show();
    };

    document.getElementById('quickContactForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = e.target.querySelector('button[type="submit"]');
        const originalText = btn.innerText;
        btn.innerText = 'CRIANDO...';
        btn.disabled = true;
        
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());
        
        try {
            const res = await fetch('/api/clients', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.id) {
                selectClientForNewLead(result.id, result.name);
                window.quickContactModal?.hide();
                window.showNotification('Contato criado!', 'success');
            } else {
                throw new Error(result.error || 'Erro ao criar');
            }
        } catch (err) {
            window.showNotification(err.message, 'error');
        } finally {
            btn.innerText = originalText;
            btn.disabled = false;
        }
    });

    // Helper functions
    function loadLinkedContacts(dealId) {
        fetch(`/api/budgets/${dealId}/contacts`)
            .then(res => res.json())
            .then(contacts => {
                const list = document.getElementById('deal-contacts-list');
                if (!list) return;
                if (contacts.length === 0) {
                    list.innerHTML = `<div class="py-10 text-center opacity-20"><p class="text-[9px] font-black uppercase tracking-widest">Nenhum contato</p></div>`;
                    return;
                }
                list.innerHTML = contacts.map(c => `
                    <div class="glass-card p-4 border-white/5 flex items-center justify-between group">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-cyber-500/10 flex items-center justify-center text-cyber-500 font-black text-xs">${c.name[0]}</div>
                            <div>
                                <p class="text-[11px] font-black text-white">${c.name}</p>
                                <p class="text-[9px] text-gray-500 uppercase font-bold">${c.company || 'Pessoa Física'}</p>
                            </div>
                        </div>
                        <button class="p-2 text-red-500 opacity-0 group-hover:opacity-100 transition-all btn-remove-contact" data-deal-id="${dealId}" data-client-id="${c.id}"><span class="material-symbols-outlined text-sm">link_off</span></button>
                    </div>
                `).join('');
            });
    }

    function renderSearchResults(results) {
        const container = document.getElementById('contact-search-results');
        if (!container) return;
        container.innerHTML = results.map(c => `
            <button type="button" class="w-full text-left p-3 rounded-xl hover:bg-white/5 border border-transparent hover:border-white/10 transition-all flex items-center justify-between group" onclick="linkContact('${c.id}')">
                <div>
                    <p class="text-[11px] font-black text-white group-hover:text-cyber-500">${c.name}</p>
                    <p class="text-[9px] text-gray-500 font-bold uppercase">${c.email}</p>
                </div>
                <span class="material-symbols-outlined text-xs text-cyber-500 opacity-0 group-hover:opacity-100">add_circle</span>
            </button>
        `).join('') || '<p class="text-center py-4 text-[9px] text-gray-500 font-black uppercase">Nenhum resultado</p>';
    }

    window.linkContact = function(clientId) {
        const dealId = document.getElementById('deal-id-input').value;
        fetch(`/api/budgets/${dealId}/contacts`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clientId, responsibilityLevel: 'Decisor', isPrimary: true })
        }).then(() => {
            loadLinkedContacts(dealId);
            document.getElementById('contact-search-container').classList.add('hidden');
        });
    }

    function loadTasks(dealId) {
        const list = document.getElementById('deal-tasks-list');
        if (list) list.innerHTML = `<div class="py-10 text-center opacity-10"><p class="text-[9px] font-black uppercase tracking-widest">Em breve...</p></div>`;
    }

    function loadNotes(dealId) {
        fetch(`/api/budgets/${dealId}`)
            .then(res => res.json())
            .then(({ budget }) => {
                const list = document.getElementById('deal-notes-timeline');
                if (!list) return;
                const notes = budget.crmNotes || [];
                if (notes.length === 0) {
                    list.innerHTML = `<div class="py-10 text-center opacity-10"><p class="text-[9px] font-black uppercase tracking-widest">Sem histórico</p></div>`;
                    return;
                }
                list.innerHTML = notes.map(n => `
                    <div class="glass-card p-4 border-white/5 mb-3">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[8px] font-black text-cyber-500 uppercase tracking-widest">${n.type || 'LOG'}</span>
                            <span class="text-[8px] text-gray-500 font-bold">${new Date(n.createdAt).toLocaleString()}</span>
                        </div>
                        <p class="text-[11px] text-gray-300 leading-relaxed">${n.content}</p>
                    </div>
                `).join('');
            });
    }

    function saveNote() {
        const dealId = document.getElementById('deal-id-input').value;
        const content = document.getElementById('deal-note-input').value;
        if (!content) return;
        fetch(`/api/budgets/${dealId}/notes`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content, type: 'note' })
        }).then(() => {
            document.getElementById('deal-note-input').value = '';
            loadNotes(dealId);
        });
    }

    function markAsWon() {
        const id = document.querySelector('#dealForm [name="id"]').value;
        if(confirm('Confirmar proposta e converter em PROJETO ativo?')) {
            fetch(`/admin/negociacoes/${id}/confirm-project`, { method: 'POST' })
                .then(res => res.json())
                .then(result => {
                    if (result.success) {
                        window.showNotification('Projeto confirmado!', 'success');
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        window.showNotification(result.error || 'Erro ao confirmar', 'error');
                    }
                });
        }
    }

    function markAsLost() { window.lossModal?.show(); }

    window.confirmLoss = function(reason) {
        const id = document.querySelector('#dealForm [name="id"]').value;
        fetch(`/admin/negociacoes/${id}/loss`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reason })
        }).then(() => window.location.reload());
    };

    function debounce(func, wait) {
        let timeout;
        return function(...args) {
            clearTimeout(timeout);
            timeout = setTimeout(() => func.apply(this, args), wait);
        };
    }

    // Fix for Empty State
    const observer = new MutationObserver(() => {
        document.querySelectorAll('.cards-list').forEach(list => {
            const hasCards = list.querySelector('.kanban-card');
            const emptyState = list.querySelector('.kanban-empty-state');
            if (emptyState) emptyState.style.display = hasCards ? 'none' : 'flex';
        });
    });

    document.querySelectorAll('.cards-list').forEach(list => {
        observer.observe(list, { childList: true });
    });
});
</script>
