<script>
// === Update Total Images Counter (Fachada + Interiores + Planta 3D) ===
window.updateTotalImages = function(el) {
 const form = el ? el.closest('form') : null;
 const forms = form ? [form] : [document.getElementById('newDealForm'), document.getElementById('dealForm')].filter(Boolean);
 forms.forEach(f => {
 const fachada = parseInt(f.querySelector('[name="imagesFachadaCount"]')?.value) || 0;
 const interior = parseInt(f.querySelector('[name="imagesInterioresCount"]')?.value) || 0;
 const planta = parseInt(f.querySelector('[name="imagesPlantaCount"]')?.value) || 0;
 const total = fachada + interior + planta;
 const countEl = f.querySelector('[name="imagesCount"]');
 if (countEl) countEl.value = total;
 f.querySelectorAll('.total-images-display').forEach(d => d.textContent = total);
 });
};

// === PAYMENT PLANS LOGIC ===
window.paymentPlans = { new: [], edit: [] };

window.setPaymentMode = function(prefix, mode) {
 const btnAuto = document.getElementById(`btn-pay-auto-${prefix}`);
 const btnManual = document.getElementById(`btn-pay-manual-${prefix}`);
 const ctrlAuto = document.getElementById(`pay-auto-controls-${prefix}`);
 const ctrlManual = document.getElementById(`pay-manual-controls-${prefix}`);

 if (!btnAuto) return;

 if (mode === 'auto') {
 btnAuto.className = 'px-2 py-1 text-[8px] font-black uppercase rounded bg-green-500/20 text-green-500';
 btnManual.className = 'px-2 py-1 text-[8px] font-black uppercase rounded text-gray-500 hover:text-white';
 ctrlAuto.classList.remove('hidden');
 ctrlManual.classList.add('hidden');
 } else {
 btnManual.className = 'px-2 py-1 text-[8px] font-black uppercase rounded bg-green-500/20 text-green-500';
 btnAuto.className = 'px-2 py-1 text-[8px] font-black uppercase rounded text-gray-500 hover:text-white';
 ctrlManual.classList.remove('hidden');
 ctrlAuto.classList.add('hidden');
 }
};

window.generateInstallments = function(prefix) {
 const totalValueEl = prefix === 'new' ? document.getElementById('new-lead-estimated-value') : document.getElementById('deal-estimated-value');
 const totalValue = parseFloat(totalValueEl?.value || 0);
 
 const form = prefix === 'new' ? document.getElementById('newDealForm') : document.getElementById('dealForm');
 const countEl = form.querySelector('[name="installments"]');
 const count = parseInt(countEl?.value || 1);
 
 const initialDateEl = document.getElementById(`pay-initial-date-${prefix}`);
 const initialDateStr = initialDateEl.value;
 if (!initialDateStr) {
 window.showNotification('Defina a data inicial', 'error');
 return;
 }
 
 const intervalEl = document.getElementById(`pay-interval-${prefix}`);
 const intervalDays = parseInt(intervalEl.value || 30);
 
 const valPerInstallment = totalValue / count;
 
 window.paymentPlans[prefix] = [];
 
 let currentDate = new Date(initialDateStr);
 currentDate.setMinutes(currentDate.getMinutes() + currentDate.getTimezoneOffset());
 
 for (let i = 0; i < count; i++) {
 window.paymentPlans[prefix].push({
 id: Date.now() + i,
 date: currentDate.toISOString().split('T')[0],
 value: valPerInstallment,
 status: 'pendente'
 });
 currentDate.setDate(currentDate.getDate() + intervalDays);
 }
 
 window.renderInstallments(prefix);
};

window.addManualInstallment = function(prefix) {
 window.paymentPlans[prefix].push({
 id: Date.now(),
 date: new Date().toISOString().split('T')[0],
 value: 0,
 status: 'pendente'
 });
 window.renderInstallments(prefix);
};

window.removeInstallment = function(prefix, id) {
 window.paymentPlans[prefix] = window.paymentPlans[prefix].filter(p => p.id !== id);
 window.renderInstallments(prefix);
};

window.updateInstallment = function(prefix, id, field, value) {
 const item = window.paymentPlans[prefix].find(p => p.id === id);
 if (item) {
 if (field === 'value') item.value = parseFloat(value) || 0;
 else item[field] = value;
 window.renderInstallments(prefix, false);
 }
};

window.renderInstallments = function(prefix, reRenderDOM = true) {
 const list = document.getElementById(`installments-list-${prefix}`);
 const dataInput = document.getElementById(`installments-data-${prefix}`);
 const sumEl = document.getElementById(`installments-sum-${prefix}`);
 
 if (!list) return;

 const plans = window.paymentPlans[prefix] || [];
 
 if (reRenderDOM) {
 const isEditDisabled = prefix === 'edit' && !document.getElementById('dealForm').classList.contains('editing');
 const disAttr = isEditDisabled ? 'disabled' : '';
 
 list.innerHTML = plans.map((p, index) => `
 <div class="flex items-center gap-2 bg-dark-900/50 p-2 rounded-lg border border-white/5">
 <span class="text-[8px] font-black text-gray-500 w-4">${index + 1}</span>
 <input type="date" class="input-premium text-[8px] !p-1.5 flex-1" value="${p.date}" onchange="updateInstallment('${prefix}', ${p.id}, 'date', this.value)" ${disAttr}>
 <input type="number" step="0.01" class="input-premium text-[8px] !p-1.5 w-20 text-right" value="${p.value.toFixed(2)}" onchange="updateInstallment('${prefix}', ${p.id}, 'value', this.value)" ${disAttr}>
 <select class="input-premium text-[8px] !p-1.5 w-24" onchange="updateInstallment('${prefix}', ${p.id}, 'status', this.value)" ${disAttr}>
 <option value="pendente" ${p.status === 'pendente' ? 'selected' : ''}>Pendente</option>
 <option value="pago" ${p.status === 'pago' ? 'selected' : ''}>Pago</option>
 <option value="parcial" ${p.status === 'parcial' ? 'selected' : ''}>Parcial</option>
 <option value="atrasado" ${p.status === 'atrasado' ? 'selected' : ''}>Atrasado</option>
 <option value="cancelado" ${p.status === 'cancelado' ? 'selected' : ''}>Cancelado</option>
 </select>
 <button type="button" class="text-red-500 hover:bg-red-500/10 p-1 rounded" onclick="removeInstallment('${prefix}', ${p.id})" ${disAttr}>
 <span class="material-symbols-outlined text-[14px]">delete</span>
 </button>
 </div>
 `).join('');
 }
 
 const sum = plans.reduce((acc, curr) => acc + curr.value, 0);
 sumEl.textContent = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(sum);
 
 const totalValueEl = prefix === 'new' ? document.getElementById('new-lead-estimated-value') : document.getElementById('deal-estimated-value');
 const totalValue = parseFloat(totalValueEl?.value || 0);
 
 if (Math.abs(sum - totalValue) > 0.1) {
 sumEl.classList.add('text-red-400');
 sumEl.classList.remove('text-white');
 } else {
 sumEl.classList.remove('text-red-400');
 sumEl.classList.add('text-white');
 }
 
 dataInput.value = JSON.stringify(plans);
};

