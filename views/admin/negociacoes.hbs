<style>
    .cards-list:has(.kanban-card) .kanban-empty-state { display: none !important; }
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
<div class="container-fluid py-4 h-screen flex flex-col overflow-hidden">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8 flex-shrink-0">
        <div class="flex flex-col gap-1">
            <h1 class="text-3xl font-black text-white tracking-tight">CRM <span class="text-cyber-500">Inteligência Comercial</span></h1>
            <div class="flex items-center gap-6 mt-4 border-b border-white/5 pb-2">
                <button class="crm-page-tab active text-[10px] font-black uppercase tracking-[0.2em] text-cyber-500 relative pb-2 group" data-tab="kanban">
                    Quadro Kanban
                    <div class="absolute bottom-0 left-0 w-full h-0.5 bg-cyber-500"></div>
                </button>
                <button class="crm-page-tab text-[10px] font-black uppercase tracking-[0.2em] text-gray-500 hover:text-white transition-all pb-2 group relative" data-tab="analytics">
                    Análise & Previsão
                    <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyber-500 group-hover:w-full transition-all"></div>
                </button>
            </div>
        </div>
        <div class="flex items-center gap-4">
            <div class="glass-card px-4 py-2 border-white/5 flex items-center gap-3">
                <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Pipeline Total:</span>
                <span class="text-lg font-black text-white">{{formatCurrency totalNegotiationValue}}</span>
            </div>
            <button id="btn-new-deal" class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-3 rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-lg shadow-orange-500/20 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">add_circle</span> Novo Lead
            </button>
        </div>
    </div>

    <!-- View Containers -->
    <div id="kanban-board-container" class="flex-1 flex flex-col min-h-0">
        <!-- Kanban Board -->
        <div id="kanban-board" class="flex-1 flex gap-6 overflow-x-auto pb-6 scrollbar-hide select-none">
            {{#each columns}}
            <div class="kanban-column w-80 flex-shrink-0 flex flex-col h-full" data-status="{{this.statusKey}}" data-id="{{this.id}}">
                <!-- Column Header -->
        <div class="glass-card mb-4 border-white/10 relative flex-shrink-0 min-h-[90px] flex flex-col justify-center" style="border-top: 4px solid {{this.color}}">
                    <div class="p-4 flex items-center justify-between">
                        <div class="overflow-hidden flex-1">
                            <h3 class="text-xs font-black text-white uppercase tracking-widest flex items-center justify-between gap-2 pr-2 whitespace-normal line-clamp-2 break-words">
                                {{this.title}}
                                <span class="bg-white/5 text-gray-500 px-2 py-0.5 rounded-full text-[8px] flex-shrink-0">{{length (lookup ../kanban this.statusKey)}}</span>
                            </h3>
                            <p class="text-[9px] font-bold text-gray-500 mt-1 uppercase tracking-tighter">
                                Total: <span class="text-cyber-400">{{formatCurrency (lookup ../pipelineTotals this.statusKey)}}</span>
                            </p>
                        </div>
                        <div class="dropdown">
                            <button class="text-gray-600 hover:text-white transition-all" data-bs-toggle="dropdown">
                                <span class="material-symbols-outlined">more_vert</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark glass-card border-white/10 bg-dark-950 p-2">
                                <li><a class="dropdown-item rounded-xl text-[10px] font-bold uppercase py-2 btn-edit-column" href="#" data-id="{{this.id}}" data-title="{{this.title}}" data-color="{{this.color}}">Editar Coluna</a></li>
                                <li><hr class="dropdown-divider border-white/5"></li>
                                <li><a class="dropdown-item rounded-xl text-[10px] font-bold uppercase py-2 text-red-500 btn-delete-column" href="#" data-id="{{this.id}}">Excluir Coluna</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Cards Container -->
                <div class="cards-list flex-1 overflow-y-auto space-y-3 px-3 mx-[-0.75rem] scrollbar-hide pb-10" data-status="{{this.statusKey}}">
                    {{#each (lookup ../kanban this.statusKey)}}
                    <div class="kanban-card glass-card p-3 border-white/5 hover:border-white/20 transition-all cursor-pointer group relative hover:z-[999] overflow-visible" 
                         data-id="{{this.id}}" 
                         data-lead='{{json this}}'
                         style="{{#if this.color}}border-left: 3px solid {{this.color}}{{/if}}">
                        <!-- Progress Bar -->
                        <div class="absolute top-0 left-0 w-full h-1 bg-white/5">
                            <div class="h-full probability-bar" style="width: {{this.probability}}%; background-color: {{#if this.color}}{{this.color}}{{else}}#00f2ff{{/if}}; box-shadow: 0 0 8px {{#if this.color}}{{this.color}}{{else}}#00f2ff{{/if}};"></div>
                        </div>
                        
                        <div class="flex justify-between items-start mb-2 mt-0">
                            <h4 class="text-xs font-black text-white leading-tight pr-2 line-clamp-2 min-h-[28px] card-name">{{this.name}}</h4>
                            <div class="flex items-center gap-1">
                                {{#if this.client.phone}}
                                <a href="{{formatWhatsappLink this.client.phone this.client.name 'lead'}}" target="_blank" class="w-6 h-6 rounded-lg bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500/20 transition-all flex items-center justify-center stop-propagation">
                                    <i class="fab fa-whatsapp text-[9px]"></i>
                                </a>
                                {{/if}}
                                <div class="dropdown stop-propagation">
                                    <button class="text-gray-600 hover:text-white transition-all p-1 flex items-center justify-center" data-bs-toggle="dropdown" data-bs-boundary="viewport" data-bs-popper-config='{"strategy":"fixed"}'>
                                        <span class="material-symbols-outlined text-[16px]">more_vert</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-dark glass-card border-white/10 bg-dark-950 p-2 shadow-2xl">
                                        <li><a class="dropdown-item rounded-xl text-[10px] font-black uppercase py-2 flex items-center gap-2" href="#" onclick="window.openDealDetails('{{this.id}}')"><span class="material-symbols-outlined text-sm">edit</span> Editar Detalhes</a></li>
                                        <li><a class="dropdown-item rounded-xl text-[10px] font-black uppercase py-2 flex items-center gap-2" href="#"><span class="material-symbols-outlined text-sm">task</span> Nova Tarefa</a></li>
                                        <li><hr class="dropdown-divider border-white/5"></li>
                                        <li><a class="dropdown-item rounded-xl text-[10px] font-black uppercase py-2 flex items-center gap-2 text-red-500" href="#"><span class="material-symbols-outlined text-sm">archive</span> Arquivar Lead</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col gap-1 mb-2">
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-gray-600 text-[12px]">payments</span>
                                <span class="text-[10px] font-black text-white card-value">{{formatCurrency this.estimatedValue}}</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-gray-600 text-[12px]">calendar_today</span>
                                <span class="text-[9px] font-bold text-gray-500">{{formatDateShort this.expectedRevenueDate}}</span>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-2 border-t border-white/5 mt-2">
                            <button class="bg-cyber-500 hover:bg-cyber-400 text-dark-950 px-2 py-1 rounded-lg font-black text-[7px] uppercase tracking-widest transition-all btn-confirm-project" data-id="{{this.id}}">
                                Confirmar Proposta
                            </button>
                            <div class="flex items-center gap-1">
                                {{#if this.nextActionDate}}
                                <div class="flex items-center gap-1 text-orange-500">
                                    <span class="material-symbols-outlined text-[10px]">notifications_active</span>
                                </div>
                                {{/if}}
                                <span class="text-[8px] font-black text-gray-600 uppercase tracking-widest">{{formatDateShort this.createdAt}}</span>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                    
                    <div class="kanban-empty-state border-2 border-dashed border-white/5 rounded-3xl p-6 flex flex-col items-center justify-center text-center opacity-30 mt-2">
                        <span class="material-symbols-outlined text-2xl mb-1">move_to_inbox</span>
                        <p class="text-[9px] font-black uppercase tracking-widest">Sem Negócios</p>
                    </div>
                </div>
            </div>
            {{/each}}

            <!-- Add Column Button -->
            <div class="w-80 flex-shrink-0">
                <button id="btn-add-column" class="w-full h-20 border-2 border-dashed border-white/10 rounded-[2rem] flex items-center justify-center gap-3 text-gray-500 hover:text-white hover:border-white/20 transition-all group">
                    <span class="material-symbols-outlined group-hover:scale-125 transition-all">add_circle</span>
                    <span class="text-[10px] font-black uppercase tracking-[0.2em]">Adicionar Etapa</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Analytics View (Hidden by default) -->
    <div id="analytics-container" class="flex-1 overflow-y-auto hidden pb-20 scrollbar-hide">
        <!-- KPI Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
            <div class="glass-card p-6 border-white/10 relative overflow-hidden group">
                <div class="absolute -right-4 -top-4 w-24 h-24 bg-green-500/10 rounded-full blur-2xl group-hover:bg-green-500/20 transition-all"></div>
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-2xl bg-green-500/10 flex items-center justify-center border border-green-500/20">
                        <span class="material-symbols-outlined text-green-500">payments</span>
                    </div>
                    <div>
                        <h4 class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Faturamento Ganhos</h4>
                        <p class="text-2xl font-black text-white">{{formatCurrency stats.billingWon}}</p>
                    </div>
                </div>
            </div>

            <div class="glass-card p-6 border-white/10 relative overflow-hidden group">
                <div class="absolute -right-4 -top-4 w-24 h-24 bg-cyber-500/10 rounded-full blur-2xl group-hover:bg-cyber-500/20 transition-all"></div>
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-2xl bg-cyber-500/10 flex items-center justify-center border border-cyber-500/20">
                        <span class="material-symbols-outlined text-cyber-500">account_tree</span>
                    </div>
                    <div>
                        <h4 class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Pipeline Aberto</h4>
                        <p class="text-2xl font-black text-white">{{formatCurrency stats.totalInNegotiation}}</p>
                    </div>
                </div>
            </div>

            <div class="glass-card p-6 border-white/10 relative overflow-hidden group">
                <div class="absolute -right-4 -top-4 w-24 h-24 bg-orange-500/10 rounded-full blur-2xl group-hover:bg-orange-500/20 transition-all"></div>
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-2xl bg-orange-500/10 flex items-center justify-center border border-orange-500/20">
                        <span class="material-symbols-outlined text-orange-500">avg_time</span>
                    </div>
                    <div>
                        <h4 class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Ticket Médio</h4>
                        <p class="text-2xl font-black text-white">{{formatCurrency stats.ticketMedio}}</p>
                    </div>
                </div>
            </div>

            <div class="glass-card p-6 border-white/10 relative overflow-hidden group">
                <div class="absolute -right-4 -top-4 w-24 h-24 bg-purple-500/10 rounded-full blur-2xl group-hover:bg-purple-500/20 transition-all"></div>
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-2xl bg-purple-500/10 flex items-center justify-center border border-purple-500/20">
                        <span class="material-symbols-outlined text-purple-500">ads_click</span>
                    </div>
                    <div>
                        <h4 class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Taxa Conversão</h4>
                        <p class="text-2xl font-black text-white">{{round stats.conversionRate}}%</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
            <div class="glass-card p-8 border-white/10">
                <h3 class="text-lg font-black text-white mb-8 tracking-tight uppercase tracking-widest">Funil Ponderado</h3>
                <div class="h-[300px]">
                    <canvas id="weightedFunnelChart"></canvas>
                </div>
            </div>
            <div class="glass-card p-8 border-white/10">
                <h3 class="text-lg font-black text-white mb-8 tracking-tight uppercase tracking-widest">Motivos de Perda</h3>
                <div class="h-[300px]">
                    <canvas id="lossReasonsChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     MODAL: DETALHES DA NEGOCIAÇÃO (Centralized Pop-up)
     ========================================== -->
<div class="modal fade" id="dealDetailModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content bg-dark-950 border border-white/10 glass-blur rounded-[2.5rem] overflow-hidden shadow-2xl">
            <div class="modal-header p-8 border-b border-white/5 flex flex-col items-start gap-4">
                <div class="flex items-center justify-between w-full">
                    <div class="flex flex-col">
                        <div class="flex items-center gap-3 mb-1">
                            <span class="bg-cyber-500/10 text-cyber-500 px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest" id="drawer-id-label">#DEAL-0000</span>
                            <span class="bg-white/5 text-gray-500 px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest" id="drawer-status-label">STAGE</span>
                        </div>
                        <h2 class="modal-title text-2xl font-black text-white tracking-tight" id="drawer-name">Nome da Negociação</h2>
                    </div>
                    <div class="flex items-center gap-4">
                        <button type="button" id="btn-edit-toggle" class="px-5 py-2.5 bg-white/5 hover:bg-white/10 border border-white/10 text-white rounded-xl font-black text-[9px] uppercase tracking-widest transition-all flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm">edit</span> Editar Campos
                        </button>
                        
                        <!-- Botões de Ação em Edição (Phase 1) -->
                        <div id="header-edit-actions" class="hidden flex items-center gap-4">
                            <button type="button" id="btn-save-header" class="px-6 py-2.5 bg-cyber-500 text-dark-950 rounded-xl font-black text-[9px] uppercase tracking-widest transition-all shadow-lg shadow-cyber-500/20 flex items-center gap-2">
                                <span class="material-symbols-outlined text-sm">save</span> Salvar Alterações
                            </button>
                            <button type="button" id="btn-cancel-header" class="px-5 py-2.5 bg-white/5 hover:bg-white/10 border border-white/10 text-white rounded-xl font-black text-[9px] uppercase tracking-widest transition-all flex items-center gap-2">
                                <span class="material-symbols-outlined text-sm">close</span> Cancelar
                            </button>
                        </div>

                        <button type="button" id="btn-mark-won-header" onclick="markAsWon()" class="px-6 py-2.5 bg-green-500 hover:bg-green-600 text-white rounded-xl font-black text-[9px] uppercase tracking-widest transition-all shadow-lg shadow-green-500/20 flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm">check_circle</span> Confirmar Proposta
                        </button>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                </div>

                <!-- Tab Navigation -->
                <ul class="nav nav-tabs border-0 flex gap-8 w-full mt-2" id="dealTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-gray-500 py-2 px-0 hover:text-white transition-all relative group" id="project-tab" data-bs-toggle="tab" data-bs-target="#project-content" type="button" role="tab">
                            Detalhes da Proposta
                            <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyber-500 group-hover:w-full transition-all"></div>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-gray-500 py-2 px-0 hover:text-white transition-all relative group" id="contacts-tab" data-bs-toggle="tab" data-bs-target="#contacts-content" type="button" role="tab">
                            Contatos
                            <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyber-500 group-hover:w-full transition-all"></div>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-gray-500 py-2 px-0 hover:text-white transition-all relative group" id="tasks-tab" data-bs-toggle="tab" data-bs-target="#tasks-content" type="button" role="tab">
                            Tarefas
                            <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyber-500 group-hover:w-full transition-all"></div>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-gray-500 py-2 px-0 hover:text-white transition-all relative group" id="log-tab" data-bs-toggle="tab" data-bs-target="#log-content" type="button" role="tab">
                            Chat & Histórico
                            <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyber-500 group-hover:w-full transition-all"></div>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-orange-500/50 py-2 px-0 hover:text-orange-500 transition-all relative group" id="ai-tab" data-bs-toggle="tab" data-bs-target="#ai-content" type="button" role="tab">
                            <span class="flex items-center gap-2"><span class="material-symbols-outlined text-xs">auto_awesome</span> Estratégia AI</span>
                            <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-orange-500 group-hover:w-full transition-all"></div>
                        </button>
                    </li>
                </ul>
            </div>
            
            <div class="modal-body p-8 scrollbar-hide">
                <div class="tab-content h-full" id="dealTabsContent">
                    <!-- TAB 1: DETALHES DO PROJETO -->
                    <div class="tab-pane fade show active h-full" id="project-content" role="tabpanel">
                        <form id="dealForm" class="space-y-8 pb-10">
                            <input type="hidden" name="id" id="deal-id-input">
                            
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                                <!-- Dados Comerciais -->
                                <section class="glass-card p-8 border-white/5 space-y-6">
                                    <h3 class="text-[10px] font-black text-cyber-500 uppercase tracking-widest flex items-center gap-2">
                                        <span class="material-symbols-outlined text-sm">payments</span> Dados da Proposta
                                    </h3>
                                    <div class="grid grid-cols-2 gap-6">
                                        <div class="col-span-2">
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Nome da Proposta / Lead</label>
                                            <input type="text" name="name" class="input-premium" required disabled>
                                        </div>
                                        <div>
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Valor Total (R$)</label>
                                            <input type="number" step="0.01" name="estimatedValue" class="input-premium" disabled>
                                        </div>
                                        <div>
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Probabilidade (%)</label>
                                            <input type="number" name="probability" min="0" max="100" class="input-premium" disabled>
                                        </div>
                                        <div>
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Etapa do Funil</label>
                                            <select name="status" class="input-premium" disabled>
                                                {{#each columns}}
                                                <option value="{{this.statusKey}}">{{this.title}}</option>
                                                {{/each}}
                                            </select>
                                        </div>
                                        <div>
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Responsável</label>
                                            <select name="assignedUserId" class="input-premium" disabled>
                                                <option value="">Não atribuído</option>
                                                {{#each teamMembers}}
                                                <option value="{{this.id}}">{{this.name}}</option>
                                                {{/each}}
                                            </select>
                                        </div>
                                    </div>

                                    <div class="pt-6 border-t border-white/5 space-y-4">
                                        <h4 class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Financeiro & Prazos</h4>
                                        <div class="grid grid-cols-2 gap-4">
                                            <div>
                                                <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-1 block">Parcelamento</label>
                                                <input type="number" name="installments" class="input-premium" disabled>
                                            </div>
                                            <div>
                                                <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-1 block">Data 1ª Prévia</label>
                                                <input type="date" name="firstPreviewDate" class="input-premium" disabled>
                                            </div>
                                        </div>
                                        <div class="glass-card p-4 border-white/5 flex items-center justify-between">
                                            <div class="flex items-center gap-3">
                                                <label class="relative inline-flex items-center cursor-pointer">
                                                    <input type="checkbox" name="hasUrgency" class="sr-only peer" disabled id="check-urgency-edit">
                                                    <div class="w-9 h-5 bg-white/10 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-orange-500"></div>
                                                </label>
                                                <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Taxa de Urgência</span>
                                            </div>
                                            <div id="urgency-percentage-edit" class="hidden">
                                                <input type="number" name="urgencyFee" class="bg-transparent text-white font-black text-right w-12 focus:outline-none text-[10px]" disabled>
                                                <span class="text-[10px] text-gray-500">%</span>
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <!-- Archviz Technical Specs -->
                                <section class="glass-card p-8 border-white/5 space-y-6">
                                    <h3 class="text-[10px] font-black text-orange-500 uppercase tracking-widest flex items-center gap-2">
                                        <span class="material-symbols-outlined text-sm">architecture</span> Especificações Archviz
                                    </h3>
                                    
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-1 block">Perfil Cliente</label>
                                            <select name="profileType" class="input-premium" disabled>
                                                <option value="Arquiteto">Arquiteto</option>
                                                <option value="Design de Interiores">Design de Interiores</option>
                                                <option value="Construtora">Construtora</option>
                                                <option value="Imobiliária">Imobiliária</option>
                                                <option value="Cliente Final">Cliente Final</option>
                                            </select>
                                        </div>
                                        <div>
