 return `
 <div class="glass-card p-4 border-white/5 flex items-center justify-between mb-3 hover:bg-white/[0.01] transition-all">
 <div class="flex items-center gap-2">
 <button onclick="toggleTaskStatus('${t.id}', '${isDone ? 'ativa' : 'concluida'}')" class="w-5 h-5 rounded-full border ${isDone ? 'bg-cyber-500 border-cyber-500 text-dark-950' : 'border-white/20 hover:border-cyber-500 text-transparent'} flex items-center justify-center transition-all">
 <span class="material-symbols-outlined text-[10px] font-black">${isDone ? 'check' : ''}</span>
 </button>
 <div>
 <p class="text-xs font-black uppercase ${isDone ? 'line-through text-gray-500' : 'text-white'}">${t.title}</p>
 ${t.description ? `<p class="text-[9px] text-gray-400 mt-1">${t.description}</p>` : ''}
 ${t.dueDate ? `<p class="text-[8px] text-orange-400 font-bold mt-1 uppercase tracking-wider"><span class="material-symbols-outlined text-[10px] align-middle mr-1">calendar_today</span>Prazo: ${new Date(t.dueDate).toLocaleDateString('pt-BR', {timeZone: 'UTC'})}</p>` : ''}
 </div>
 </div>
 <div class="flex items-center gap-2">
 <span class="px-2 py-0.5 rounded text-[7px] font-black uppercase tracking-widest ${t.priority === 'alta' ? 'bg-red-500/10 text-red-500 border border-red-500/20' : t.priority === 'media' ? 'bg-orange-500/10 text-orange-500 border border-orange-500/20' : 'bg-blue-500/10 text-blue-500 border border-blue-500/20'}">${t.priority}</span>
 <button onclick="deleteTask('${t.id}')" class="p-1 text-gray-500 hover:text-red-500 transition-colors"><span class="material-symbols-outlined text-sm">delete</span></button>
 </div>
 </div>
 `;
 }).join('');
 })
 .catch(err => {
