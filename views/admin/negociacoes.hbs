 // Increment/Decrement controls for specifications
 document.addEventListener('click', function(e) {
 const incBtn = e.target.closest('.btn-qty-inc');
 const decBtn = e.target.closest('.btn-qty-dec');
 
 if (incBtn) {
 e.preventDefault();
 const targetName = incBtn.getAttribute('data-target');
 const form = incBtn.closest('#dealForm') || document;
 const input = form.querySelector(`input[name="${targetName}"]`);
 if (input && !input.disabled) {
 let val = parseInt(input.value, 10) || 0;
 input.value = val + 1;
 input.dispatchEvent(new Event('change', { bubbles: true }));
 }
 }
 
 if (decBtn) {
 e.preventDefault();
 const targetName = decBtn.getAttribute('data-target');
 const form = decBtn.closest('#dealForm') || document;
 const input = form.querySelector(`input[name="${targetName}"]`);
 if (input && !input.disabled) {
 let val = parseInt(input.value, 10) || 0;
 if (val > 0) {
 input.value = val - 1;
 input.dispatchEvent(new Event('change', { bubbles: true }));
 }
 }
 }
 });
 
 let savedMode = localStorage.getItem('crm_view_mode') || 'kanban';
 if (!['kanban', 'list', 'spreadsheet'].includes(savedMode)) savedMode = 'kanban';
 changeView(savedMode);
 
 // Live Search filtering
