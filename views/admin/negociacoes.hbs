 window.handleCalcularOrcamento = async function(isNew) {
 const formId = isNew ? 'newDealForm' : 'dealForm';
 const form = document.getElementById(formId);
 if (!form) return;
 
 // Get fields
 const totalAreaVal = form.querySelector('[name="totalArea"]')?.value;
 const profileTypeVal = form.querySelector('[name="profileType"]')?.value;
 const predominantStyleVal = form.querySelector('[name="predominantStyle"]')?.value;
 const receivedFormatVal = form.querySelector('[name="receivedFormat"]')?.value;
 const imagesCountVal = form.querySelector('[name="imagesCount"]')?.value;
 const animationSecondsVal = form.querySelector('[name="animationSeconds"]')?.value;
 const renderEngineVal = form.querySelector('[name="renderEngine"]')?.value;
 const revisionsIncludedVal = form.querySelector('[name="revisionsIncluded"]')?.value;
 const productionDaysVal = form.querySelector('[name="productionDays"]')?.value;
 
 // Validation
 const metragem = parseFloat(totalAreaVal);
 if (isNaN(metragem) || metragem <= 0) {
 window.showNotification('Erro: Metragem total (m²) inválida ou não preenchida!', 'error');
 return;
 }
 
 // Spinner loading state
 const btnId = isNew ? 'btn-calc-orcamento-new' : 'btn-calc-orcamento-detail';
 const btn = document.getElementById(btnId);
 if (!btn) return;
 const originalHtml = btn.innerHTML;
 btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>`;
 btn.disabled = true;
 
 // Parse values
 const payload = {
 metragemTotal: metragem,
 tipoCliente: profileTypeVal || 'Arquiteto',
 estiloPredominante: predominantStyleVal || 'Moderno',
 formatoBase: receivedFormatVal || 'BIM/Revit Limpo',
 qtdImagens: parseInt(imagesCountVal) || 0,
 segundosAnimacao: parseInt(animationSecondsVal) || 0,
 softwareRender: renderEngineVal || 'D5 Render',
 rodadasAlteracao: parseInt(revisionsIncludedVal) || 1,
 prazoDias: parseInt(productionDaysVal) || 30
 };
 
 try {
 const response = await fetch('/api/calcularOrcamentoAvancado', {
 method: 'POST',
 headers: {
 'Content-Type': 'application/json'
 },
 body: JSON.stringify(payload)
 });
 
 const result = await response.json();
 if (result.success) {
 // Update estimatedValue input
 const inputVal = form.querySelector('[name="estimatedValue"]');
 if (inputVal) {
 inputVal.value = result.valorTotalSugerido;
 }
 
 // Render breakdown
 const containerId = isNew ? 'new-lead-breakdown-container' : 'deal-breakdown-container';
 const container = document.getElementById(containerId);
 if (container) {
 container.innerHTML = generateBreakdownHtml(result);
 container.classList.remove('hidden');
 }
 
 window.showNotification('Orçamento calculado com sucesso!', 'success');
 } else {
 window.showNotification(result.error || 'Erro ao calcular orçamento', 'error');
 }
 } catch (err) {
 console.error('Calculation Error:', err);
 window.showNotification('Erro de rede ou servidor ao calcular orçamento', 'error');
 } finally {
 btn.innerHTML = originalHtml;
 btn.disabled = false;
 }
 };

 // Bind event listeners for calculate button in details modal
 document.getElementById('btn-calc-orcamento-detail')?.addEventListener('click', function() {
 window.handleCalcularOrcamento(false);
 });

 // Reset breakdown containers and forms on modal hide
 dealModalElement?.addEventListener('hidden.bs.modal', function () {
 const container = document.getElementById('deal-breakdown-container');
 if (container) {
 container.innerHTML = '';
 container.classList.add('hidden');
 }
 });

 newDealModalElement?.addEventListener('hidden.bs.modal', function () {
 const container = document.getElementById('new-lead-breakdown-container');
 if (container) {
 container.innerHTML = '';
 container.classList.add('hidden');
 }
 document.getElementById('newDealForm')?.reset();
 });

