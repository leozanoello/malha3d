 // Helper para recalcular os totais no frontend sem recarregar a página
 function recalculateColumnTotals() {
 let pipelineTotal = 0;
 document.querySelectorAll('.kanban-column').forEach(column => {
 const cards = column.querySelectorAll('.kanban-card');
 const countBadge = column.querySelector('.column-card-count');
 if (countBadge) countBadge.innerText = cards.length;
 
 let colTotal = 0;
 cards.forEach(card => {
 let val = 0;
 try {
 const leadData = JSON.parse(card.getAttribute('data-lead') || '{}');
 val = parseFloat(leadData.estimatedValue) || 0;
 } catch(e) {
 const valText = card.querySelector('.card-value')?.innerText || '';
 val = parseFloat(valText.replace(/[^0-9,-]/g, '').replace(',', '.')) || 0;
 }
 colTotal += val;
 });
 pipelineTotal += colTotal;
 
 const totalValEl = column.querySelector('.column-total-value');
 if (totalValEl) {
 totalValEl.innerText = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(colTotal).replace(/\s/, ' ');
 }
 });
 
 const pipelineTotalEl = document.getElementById('pipeline-total-display');
 if (pipelineTotalEl) {
 pipelineTotalEl.innerText = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(pipelineTotal).replace(/\s/, ' ');
 }
 }

 // === KANBAN DRAG & DROP ===
 const kanbanLists = document.querySelectorAll('.cards-list');
 kanbanLists.forEach(list => {
 if (typeof Sortable !== 'undefined') {
 new Sortable(list, {
 group: 'kanban',
 animation: 250,
 draggable: '.kanban-card',
 ghostClass: 'sortable-ghost',
 dragClass: 'sortable-drag',
 onEnd: function(evt) {
 const dealId = evt.item.getAttribute('data-id');
 const newStatus = evt.to.getAttribute('data-status');
 
 fetch(`/admin/negociacoes/${dealId}/update-status`, {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ status: newStatus })
 })
 .then(res => {
 if (!res.ok) throw new Error('Erro na requisição');
 return res.json();
 })
 .then(res => {
 if (res.success && res.budget) {
 window.showNotification('Etapa atualizada com automação!', 'success');
 
 const card = evt.item;
 const budget = res.budget;
 
 // Mesclar dados novos no data-lead do card
 let leadData = {};
 try {
 leadData = JSON.parse(card.getAttribute('data-lead') || '{}');
 } catch(e) {}
 Object.assign(leadData, budget);
 card.setAttribute('data-lead', JSON.stringify(leadData));
 
 // 1. Atualizar Barra de Probabilidade
 const probBar = card.querySelector('.probability-bar');
 if (probBar) {
 probBar.style.width = `${budget.probability}%`;
 }
 
 // 2. Atualizar Badge de Probabilidade no Topo
 const probLabel = card.querySelector('.probability-label');
 if (probLabel) {
 probLabel.innerText = `${budget.probability}%`;
 }
 
 // 3. Atualizar Badge de Prioridade
 const prioBadge = card.querySelector('.priority-badge');
 if (prioBadge) {
 prioBadge.setAttribute('data-priority', budget.priority);
 prioBadge.className = "priority-badge text-[8px] font-black uppercase px-1 py-0.2 rounded border transition-all duration-300";
 if (budget.priority === 'alta') {
 prioBadge.classList.add('bg-red-500/10', 'text-red-400', 'border-red-500/20');
 prioBadge.innerText = 'Alta';
 } else if (budget.priority === 'media') {
 prioBadge.classList.add('bg-orange-500/10', 'text-orange-400', 'border-orange-500/20');
 prioBadge.innerText = 'Média';
 } else {
 prioBadge.classList.add('bg-blue-500/10', 'text-blue-400', 'border-blue-500/20');
 prioBadge.innerText = 'Baixa';
 }
 }
 
 // 4. Atualizar o widget Glassmorphic de Próxima Ação
 let nextStepContainer = card.querySelector('.next-step-container');
 if (nextStepContainer) {
 if (budget.nextActionNote) {
 nextStepContainer.classList.remove('hidden');
 
 const noteEl = nextStepContainer.querySelector('.card-next-action-note');
 if (noteEl) noteEl.innerText = budget.nextActionNote;
 
 const dateEl = nextStepContainer.querySelector('.card-next-action-date');
 if (dateEl) {
 if (budget.nextActionDate) {
 const d = new Date(budget.nextActionDate);
 const formattedDate = String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0');
 const formattedTime = String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
 dateEl.innerText = `Prazo: ${formattedDate} ${formattedTime}`;
 dateEl.style.display = 'block';
 } else {
 dateEl.style.display = 'none';
 }
 }
 } else {
 nextStepContainer.classList.add('hidden');
 }
 }
 
 // 5. Atualizar o sino indicador
 const dateBell = card.querySelector('.text-date-bell');
 if (dateBell) {
 if (budget.nextActionDate) dateBell.classList.remove('hidden');
 else dateBell.classList.add('hidden');
 }
 
 // Recalcular os totais das colunas e pipeline total geral
 recalculateColumnTotals();
 
 } else {
 window.showNotification(res.error || 'Erro ao atualizar status', 'error');
 }
 })
 .catch(err => {
 console.error('Drag & Drop Update Error:', err);
 window.showNotification('Erro ao sincronizar status do card', 'error');
 });
 },
 
 // Helper para recalcular os totais no frontend sem recarregar a página
 onStart: function() {
 // Opcional: pode adicionar feedback visual ao iniciar o drag
 }
 });
 }
 });

 if (document.getElementById('kanban-board') && typeof Sortable !== 'undefined') {
 new Sortable(document.getElementById('kanban-board'), {
 draggable: '.kanban-column',
 handle: '.column-header',
 animation: 250,
 onEnd: function() {
 const columns = [...document.querySelectorAll('.kanban-column')].map((col, index) => ({
 id: col.dataset.id,
 order: index
 }));
 fetch('/admin/kanban/columns/reorder', {
 method: 'POST',
