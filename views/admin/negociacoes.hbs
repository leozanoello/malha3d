<style>
 .cards-list:has(.kanban-card) .kanban-empty-state { display: none !important; }
 
 /* Scrollbar Premium & Visível para o CRM */
 .scrollbar-premium::-webkit-scrollbar {
 height: 10px;
 width: 8px;
 }
 .scrollbar-premium::-webkit-scrollbar-track {
 background: rgba(255, 255, 255, 0.04);
 border-radius: 10px;
 }
 .scrollbar-premium::-webkit-scrollbar-thumb {
 background: rgba(249, 115, 22, 0.6);
 border-radius: 10px;
 border: 2px solid rgba(12, 13, 16, 0.9);
 }
 .scrollbar-premium::-webkit-scrollbar-thumb:hover {
 background: rgba(249, 115, 22, 0.9);
 }
 .scrollbar-premium {
 scrollbar-width: thin;
 scrollbar-color: rgba(249, 115, 22, 0.6) rgba(255, 255, 255, 0.04);
 }
 
 /* Force Kanban columns and lists to grow vertically without internal scrolls */
 .kanban-column,
 .cards-list {
 height: auto !important;
 max-height: none !important;
 overflow-y: visible !important;
 }

 /* Micro-movimento no hover de no máximo 2px em todo o sistema */
 button,
 .interactive-hover,
 .kanban-card-main,
 .kanban-card,
 .glass-card,
 .crm-page-tab,
 input:hover,
 select:hover {
 transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, border-color 0.2s ease !important;
 }

 /* Removido o movimento no hover conforme solicitado */
 button:hover,
 .interactive-hover:hover,
 .kanban-card-main:hover,
 .kanban-card:hover,
 .crm-page-tab:hover {
 transform: none !important;
 }

 .kanban-card-main:hover,
 .kanban-card:hover {
 transform: none !important;
 background: linear-gradient(135deg, rgba(255, 255, 255, 0.14) 0%, rgba(249, 115, 22, 0.06) 50%, rgba(18, 20, 30, 0.9) 100%), rgba(14, 16, 24, 0.9) !important;
 border-color: rgba(249, 115, 22, 0.45) !important;
 border-top-color: rgba(255, 255, 255, 0.45) !important;
 box-shadow: 0 14px 35px 0 rgba(0, 0, 0, 0.6), 0 0 25px 0 rgba(249, 115, 22, 0.22), inset 0 1px 1px 0 rgba(255, 255, 255, 0.35) !important;
 }
</style>
<div class="container-fluid py-4 flex flex-col h-auto">
 <!-- Header -->
 <div class="flex items-center justify-between mb-8 flex-shrink-0">
 <div class="flex flex-col gap-1">
 <h1 class="text-3xl font-black text-white tracking-tight">CRM <span class="text-cyber-500">Inteligência Comercial</span></h1>
 <div class="flex items-center gap-6 mt-3 border-b border-white/5 pb-2">
 <button class="crm-page-tab active text-[10px] font-black uppercase tracking-[0.2em] text-cyber-500 relative pb-2 group" data-tab="kanban">
 Quadro Kanban
 <div class="absolute bottom-0 left-0 w-full h-0.5 bg-cyber-500"></div>
 </button>
 <button class="crm-page-tab text-[10px] font-black uppercase tracking-[0.2em] text-gray-500 hover:text-white transition-all pb-2 group relative" data-tab="analise">
 Análise & Previsão
 <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyber-500 group-hover:w-full transition-all"></div>
 </button>
 </div>
 </div>
 <div class="flex items-center gap-4">
 <div class="glass-card px-4 py-2 border-white/5 flex items-center gap-2">
 <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Pipeline Total:</span>
 <span id="pipeline-total-display" class="text-lg font-black text-white">{{formatCurrency totalNegotiationValue}}</span>
 </div>
 <button id="btn-new-deal" class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-3 rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-lg shadow-orange-500/20 transition-all flex items-center gap-2">
 <span class="material-symbols-outlined text-sm">add_circle</span> Novo Lead
 </button>
 </div>
 </div>

 <!-- Control Bar (Busca + Alternador de Visualizações) -->
 <div id="crm-control-bar" class="mb-6 flex flex-col md:flex-row gap-4 items-center justify-between p-4 glass-card bg-black/20 border-white/5 relative z-10">
 <!-- Search -->
 <div class="relative w-full md:w-96">
 <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-500">
 <span class="material-symbols-outlined text-sm">search</span>
 </span>
 <input type="text" id="unified-search" class="w-full pl-10 pr-4 py-2.5 bg-black/40 border border-white/5 rounded-xl text-xs font-medium text-white focus:outline-none focus:border-cyber-500/50 transition-all placeholder-gray-500" placeholder="Buscar por lead, cliente ou tipo...">
 </div>
 <!-- View Toggle -->
 <div class="flex items-center gap-1.5 bg-black/40 p-1 rounded-xl border border-white/5">
 <button onclick="changeView('kanban')" id="btn-view-kanban" class="view-toggle-btn px-4 py-2 rounded-lg text-[9px] font-black uppercase tracking-widest text-cyber-500 bg-cyber-500/10 transition-all flex items-center gap-2">
 <span class="material-symbols-outlined text-sm">grid_view</span> Quadro
 </button>
 <button onclick="changeView('list')" id="btn-view-list" class="view-toggle-btn px-4 py-2 rounded-lg text-[9px] font-black uppercase tracking-widest text-gray-400 hover:text-white transition-all flex items-center gap-2">
 <span class="material-symbols-outlined text-sm">list</span> Lista
 </button>
 <button onclick="changeView('spreadsheet')" id="btn-view-spreadsheet" class="view-toggle-btn px-4 py-2 rounded-lg text-[9px] font-black uppercase tracking-widest text-gray-400 hover:text-white transition-all flex items-center gap-2">
 <span class="material-symbols-outlined text-sm">table_chart</span> Planilha
 </button>
 </div>
 </div>

 <!-- View Containers -->
 <div id="kanban-board-container" class="h-auto">
 <!-- Kanban Board -->
 <div id="kanban-board" class="flex gap-6 overflow-x-auto pb-6 scrollbar-hide select-none h-auto">
 {{#each columns}}
 <div class="kanban-column w-80 flex-shrink-0 flex flex-col h-auto" data-status="{{this.statusKey}}" data-id="{{this.id}}">
 <!-- Column Header -->
 <div class="column-header glass-card mb-4 border-white/10 relative flex-shrink-0 min-h-[100px] flex flex-col justify-center overflow-hidden pt-5" style="border-top: 4px solid {{this.color}}">
 <!-- Column top banner -->
 <div class="absolute top-0 left-0 w-full h-[18px] flex items-center justify-between px-3" style="background: linear-gradient(90deg, {{this.color}}18 0%, {{this.color}}03 100%); border-bottom: 1px solid {{this.color}}12;">
 <span class="text-[6.5px] font-black uppercase tracking-[0.25em]" style="color: {{this.color}}">Etapa do Funil</span>
 <span class="w-1.5 h-1.5 rounded-full" style="background-color: {{this.color}}; box-shadow: 0 0 6px {{this.color}}"></span>
 </div>
 <div class="p-4 flex items-center justify-between">
 <div class="overflow-hidden flex-1">
 <h3 class="text-xs font-black text-white uppercase tracking-widest flex items-center justify-between gap-2 pr-2 whitespace-normal line-clamp-2 break-words">
 {{this.title}}
 <span class="bg-white/5 text-gray-500 px-2 py-0.5 rounded-full text-[8px] flex-shrink-0 column-card-count">{{length (lookup ../kanban this.statusKey)}}</span>
 </h3>
 <p class="text-[10px] font-bold text-gray-500 mt-1 uppercase tracking-tighter">
 Total: <span class="text-cyber-400 column-total-value">{{formatCurrency (lookup ../pipelineTotals this.statusKey)}}</span>
 </p>
 </div>
 <div class="dropdown">
 <button class="text-gray-600 hover:text-white transition-all" data-bs-toggle="dropdown">
 <span class="material-symbols-outlined">more_vert</span>
 </button>
 <ul class="dropdown-menu dropdown-menu-dark glass-card border-white/10 bg-dark-950 p-2">
 <li><a class="dropdown-item rounded-xl text-[10px] font-bold uppercase py-2 btn-edit-column" href="#" data-id="{{this.id}}" data-title="{{this.title}}" data-color="{{this.color}}">Editar Coluna</a></li>
 <li><hr class="dropdown-divider border-white/5"></li>
 <li><a class="dropdown-item rounded-xl text-[10px] font-bold uppercase py-2 text-red-500 btn-delete-column" href="#" data-id="{{this.id}}">Excluir Coluna</a></li>
 </ul>
 </div>
 </div>
 </div>
 <!-- Cards Container -->
 <div class="cards-list flex-1 space-y-2 px-2 mx-[-0.75rem] scrollbar-hide pb-10" data-status="{{this.statusKey}}">
 {{#each (lookup ../kanban this.statusKey)}}
 <div class="kanban-card glass-card p-2 border-white/5 hover:border-white/20 transition-all cursor-pointer group hover:z-[999] overflow-visible" 
 data-id="{{this.id}}" 
 style="{{#if this.color}}border-left: 3px solid {{this.color}}{{/if}}">
 <!-- Progress Bar -->
 <div class="absolute top-0 left-0 w-full h-1 bg-white/5">
 <div class="h-full probability-bar" style="width: {{this.probability}}%; background-color: {{#if this.color}}{{this.color}}{{else}}#00f2ff{{/if}}; box-shadow: 0 0 8px {{#if this.color}}{{this.color}}{{else}}#00f2ff{{/if}};"></div>
 </div>
 
 <!-- Discrete Small Card Banner -->
 <div class="mb-1 mt-0 px-2 py-0.5 rounded bg-white/5 border border-white/5 flex items-center justify-between text-[9px] font-black uppercase tracking-wider text-gray-400">
 <span class="flex items-center gap-1">
 <span class="w-1.5 h-1.5 rounded-full" style="background-color: {{#if this.color}}{{this.color}}{{else}}#00f2ff{{/if}}; box-shadow: 0 0 4px {{#if this.color}}{{this.color}}{{else}}#00f2ff{{/if}};"></span>
 {{#if this.projectType}}{{this.projectType}}{{else}}Imagens 3D{{/if}}
 </span>
 <div class="flex items-center gap-1.5">
 <span class="priority-badge text-[8px] font-black uppercase px-1 py-0.2 rounded border transition-all duration-300
 {{#if (eq this.priority 'alta')}}bg-red-500/10 text-red-400 border-red-500/20{{/if}}
 {{#if (eq this.priority 'media')}}bg-orange-500/10 text-orange-400 border-orange-500/20{{/if}}
 {{#if (eq this.priority 'baixa')}}bg-blue-500/10 text-blue-400 border-blue-500/20{{/if}}
 {{#unless this.priority}}bg-orange-500/10 text-orange-400 border-orange-500/20{{/unless}}"
 data-priority="{{#if this.priority}}{{this.priority}}{{else}}media{{/if}}">
 {{#if (eq this.priority 'alta')}}Alta{{/if}}
 {{#if (eq this.priority 'media')}}Média{{/if}}
 {{#if (eq this.priority 'baixa')}}Baixa{{/if}}
 {{#unless this.priority}}Média{{/unless}}
 </span>
 <span class="text-[10px] font-black probability-label" style="color: {{#if this.color}}{{this.color}}{{else}}#00f2ff{{/if}}">{{this.probability}}%</span>
 </div>
 </div>

 <div class="flex justify-between items-start mb-1 mt-0">
 <div>
 <h4 class="text-base font-black text-white leading-tight pr-2 card-name">{{this.name}}</h4>
 <p class="text-[9px] text-gray-500 font-bold uppercase tracking-wider mt-0.5">
 {{#if this.client}}{{#if this.client.company}}{{this.client.company}}{{else}}{{#if this.clientName}}{{this.clientName}}{{else}}Sem Empresa{{/if}}{{/if}}{{else}}{{#if this.clientName}}{{this.clientName}}{{else}}Sem Empresa{{/if}}{{/if}} • 
 <span class="font-mono opacity-20 hover:opacity-100 transition-opacity duration-300 text-[9px] cursor-help tracking-tighter select-all">#ORC-{{this.id}}</span>
 </p>
 </div>
 <div class="flex items-center gap-1">
 {{#if this.client}}{{#if this.client.phone}}
 <a href="{{formatWhatsappLink this.client.phone this.client.name 'lead'}}" target="_blank" class="w-6 h-6 rounded-lg bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500/20 transition-all flex items-center justify-center stop-propagation" onclick="event.stopPropagation();">
 <i class="fab fa-whatsapp text-[9px]"></i>
 </a>
 {{/if}}{{/if}}
 <div class="dropdown stop-propagation" onclick="event.stopPropagation();">
 <button class="text-gray-600 hover:text-white transition-all p-1 flex items-center justify-center" data-bs-toggle="dropdown" data-bs-boundary="viewport" data-bs-popper-config='{"strategy":"fixed"}' onclick="event.stopPropagation();">
 <span class="material-symbols-outlined text-[16px]">more_vert</span>
 </button>
 <ul class="dropdown-menu dropdown-menu-dark glass-card border-white/10 bg-dark-950 p-2 shadow-2xl">
 <li><a class="dropdown-item rounded-xl text-[10px] font-black uppercase py-2 flex items-center gap-2 stop-propagation" href="#" onclick="event.stopPropagation(); window.openDealDetails('{{this.id}}')"><span class="material-symbols-outlined text-sm">edit</span> Editar Detalhes</a></li>
 <li><a class="dropdown-item rounded-xl text-[10px] font-black uppercase py-2 flex items-center gap-2 stop-propagation" href="#" onclick="event.stopPropagation();"><span class="material-symbols-outlined text-sm">task</span> Nova Tarefa</a></li>
 <li><hr class="dropdown-divider border-white/5"></li>
 <li><a class="dropdown-item rounded-xl text-[10px] font-black uppercase py-2 flex items-center gap-2 text-red-500 stop-propagation" href="#" onclick="event.stopPropagation();"><span class="material-symbols-outlined text-sm">archive</span> Arquivar Lead</a></li>
 </ul>
 </div>
 </div>
 </div>

 <div class="flex flex-col gap-1 mb-1">
 <div class="flex items-center gap-1.5">
 <span class="material-symbols-outlined text-gray-600 text-[14px]">payments</span>
 <span class="text-[11px] font-black text-white card-value">{{formatCurrency this.estimatedValue}}</span>
 </div>
 <div class="flex items-center gap-1.5">
 <span class="material-symbols-outlined text-gray-600 text-[14px]">calendar_today</span>
 <span class="text-[10px] font-bold text-gray-500">{{formatDateShort this.expectedRevenueDate}}</span>
 </div>
 </div>

 <!-- Briefing Metadata Tags -->
 <div class="flex flex-wrap gap-1 mb-1 mt-1 tech-tags-container">
 {{#if this.totalArea}}
 <span class="text-[8px] font-black uppercase px-1.5 py-0.5 rounded bg-white/5 border border-white/5 text-gray-400">{{this.totalArea}}m²</span>
 {{/if}}
 {{#if this.renderEngine}}
 <span class="text-[8px] font-black uppercase px-1.5 py-0.5 rounded bg-white/5 border border-white/5 text-gray-400">{{this.renderEngine}}</span>
 {{/if}}
 {{#if this.receivedFormat}}
 <span class="text-[8px] font-black uppercase px-1.5 py-0.5 rounded bg-white/5 border border-white/5 text-gray-400">{{this.receivedFormat}}</span>
 {{/if}}
 {{#if this.imagesCount}}
 <span class="text-[8px] font-black uppercase px-1.5 py-0.5 rounded bg-white/5 border border-white/5 text-gray-400">{{this.imagesCount}} Imgs</span>
 {{/if}}
 </div>

 <!-- Next Step Glassmorphic Alert Widget -->
 <div class="mt-1 mb-1 p-2 rounded-xl bg-orange-500/5 border border-orange-500/10 text-[9px] text-orange-200 flex flex-col gap-1 next-step-container {{#unless this.nextActionNote}}hidden{{/unless}}">
 <div class="flex items-center gap-1 font-black uppercase tracking-wider text-orange-400">
 <span class="material-symbols-outlined text-[12px]">notifications_active</span>
 PRÓXIMA AÇÃO
 </div>
 <p class="font-bold leading-normal text-gray-300 break-words card-next-action-note">{{this.nextActionNote}}</p>
 {{#if this.nextActionDate}}
 <span class="text-[8px] text-orange-300/80 font-black mt-0.5 uppercase tracking-wide card-next-action-date">Prazo: {{formatDate this.nextActionDate 'short'}} {{formatDate this.nextActionDate 'time'}}</span>
 {{/if}}
 </div>

 <div class="flex items-center justify-between pt-2 border-t border-white/5 mt-2">
 <button class="bg-cyber-500 hover:bg-cyber-400 text-dark-950 px-2 py-1 rounded-lg font-black text-[8px] uppercase tracking-widest transition-all btn-confirm-project stop-propagation" data-id="{{this.id}}" onclick="event.stopPropagation(); window.confirmDealProject('{{this.id}}');">
 Converter em Projeto
 </button>
 <div class="flex items-center gap-1">
 <div class="flex items-center gap-1 text-orange-500 text-date-bell {{#unless this.nextActionDate}}hidden{{/unless}}">
 <span class="material-symbols-outlined text-[12px]">notifications_active</span>
 </div>
 <span class="text-[9px] font-black text-gray-600 uppercase tracking-widest">{{formatDateShort this.createdAt}}</span>
 </div>
 </div>
 </div>
 {{/each}}
 
 <div class="kanban-empty-state border-2 border-dashed border-white/5 rounded-3xl p-6 flex flex-col items-center justify-center text-center opacity-30 mt-2">
 <span class="material-symbols-outlined text-2xl mb-1">move_to_inbox</span>
 <p class="text-[9px] font-black uppercase tracking-widest">Sem Negócios</p>
 </div>
 </div>
 </div>
 {{/each}}

 <!-- Add Column Button -->
 <div class="w-80 flex-shrink-0">
 <button id="btn-add-column" class="w-full h-20 border-2 border-dashed border-white/10 rounded-[2rem] flex items-center justify-center gap-2 text-gray-500 hover:text-white hover:border-white/20 transition-all group">
 <span class="material-symbols-outlined group- transition-all">add_circle</span>
 <span class="text-[10px] font-black uppercase tracking-[0.2em]">Adicionar Etapa</span>
 </button>
 </div>
 </div> <!-- Fechar #kanban-board -->

 <!-- List Layout for CRM -->
 <div id="view-list" class="space-y-4 hidden flex-1 overflow-y-auto pb-20 scrollbar-hide">
 {{#each columns}}
 {{#each (lookup ../kanban this.statusKey)}}
 <div class="glass-card p-4 border-white/5 bg-white/2 hover:border-cyber-500/30 transition-all cursor-pointer flex flex-col md:flex-row md:items-center justify-between gap-4 crm-item-row" onclick="window.openDealDetails('{{this.id}}')" data-search="{{this.name}} {{#if this.client}}{{#if this.client.name}}{{this.client.name}}{{/if}} {{#if this.client.company}}{{this.client.company}}{{/if}}{{/if}} {{this.projectType}} {{this.status}}">
 <div class="flex items-center gap-4">
 <div class="w-10 h-10 rounded-xl bg-cyber-500/10 flex items-center justify-center text-cyber-500">
 <span class="material-symbols-outlined">payments</span>
 </div>
 <div>
 <h4 class="text-xs font-black text-white card-name">{{this.name}}</h4>
 <p class="text-[9px] text-gray-500 font-bold uppercase tracking-wider mt-0.5">
 {{#if this.client}}{{#if this.client.company}}{{this.client.company}}{{else}}{{#if this.clientName}}{{this.clientName}}{{else}}Sem Empresa{{/if}}{{/if}}{{else}}{{#if this.clientName}}{{this.clientName}}{{else}}Sem Empresa{{/if}}{{/if}} • 
 <span class="font-mono opacity-20 hover:opacity-100 transition-opacity duration-300 text-[9px] cursor-help tracking-tighter select-all">#ORC-{{this.id}}</span>
 </p>
 </div>
 </div>
 <div class="flex items-center gap-6">
 <div class="text-right">
 <span class="px-2 py-0.5 rounded bg-white/5 border border-white/5 text-[8px] font-black text-gray-400 uppercase tracking-wide">
 {{#if this.projectType}}{{this.projectType}}{{else}}Imagens 3D{{/if}}
 </span>
 </div>
 <div class="text-right">
 <span class="px-2.5 py-0.5 rounded-full bg-cyber-500/10 text-cyber-500 border border-cyber-500/20 text-[8px] font-black uppercase tracking-wider">
 {{../title}}
 </span>
 </div>
 <div class="text-right w-24">
 <p class="text-[9px] font-black text-emerald-500 font-mono">{{formatCurrency this.estimatedValue}}</p>
 </div>
 <div onclick="event.stopPropagation();">
 <button onclick="window.openDealDetails('{{this.id}}')" class="w-8 h-8 rounded-xl bg-white/5 text-gray-400 hover:text-white flex items-center justify-center">
 <span class="material-symbols-outlined text-[14px]">visibility</span>
 </button>
 </div>
 </div>
 </div>
 {{/each}}
 {{/each}}
 </div>

 <!-- Spreadsheet Layout for CRM -->
 <div id="view-spreadsheet" class="glass-card border-white/5 bg-white/2 overflow-hidden hidden flex-1 flex flex-col min-h-0">
 <div class="overflow-x-auto overflow-y-auto flex-1 scrollbar-hide">
 <table class="w-full text-left border-collapse">
 <thead>
 <tr class="border-b border-white/5 bg-black/40 text-[9px] font-black text-gray-500 uppercase tracking-widest sticky top-0 z-10">
 <th class="p-4">Negociação</th>
 <th class="p-4">Cliente / Empresa</th>
 <th class="p-4">Tipo</th>
 <th class="p-4">Etapa</th>
 <th class="p-4">Probabilidade</th>
 <th class="p-4">Valor Estimado</th>
 <th class="p-4">Previsão Fechamento</th>
 <th class="p-4 text-right">Ações</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-white/5">
 {{#each columns}}
 {{#each (lookup ../kanban this.statusKey)}}
 <tr class="hover:bg-white/[0.02] transition-all cursor-pointer crm-item-row" onclick="window.openDealDetails('{{this.id}}')" data-search="{{this.name}} {{#if this.client}}{{#if this.client.name}}{{this.client.name}}{{/if}} {{#if this.client.company}}{{this.client.company}}{{/if}}{{/if}} {{this.projectType}} {{this.status}}">
 <td class="p-4">
 <span class="text-xs font-black text-white block card-name">{{this.name}}</span>
 <span class="font-mono opacity-20 hover:opacity-100 transition-opacity duration-300 text-[9px] cursor-help tracking-tighter select-all">#ORC-{{this.id}}</span>
 </td>
 <td class="p-4 text-xs font-medium text-gray-400">
 {{#if this.client}}{{#if this.client.company}}{{this.client.company}}{{else}}{{#if this.clientName}}{{this.clientName}}{{else}}Sem Empresa{{/if}}{{/if}}{{else}}{{#if this.clientName}}{{this.clientName}}{{else}}Sem Empresa{{/if}}{{/if}}
 </td>
 <td class="p-4 text-xs font-bold text-gray-400">
 {{#if this.projectType}}{{this.projectType}}{{else}}Imagens 3D{{/if}}
 </td>
 <td class="p-4">
 <span class="px-2 py-0.5 rounded-full bg-cyber-500/10 text-cyber-500 border border-cyber-500/20 text-[8px] font-black uppercase tracking-wider">
 {{../title}}
 </span>
 </td>
 <td class="p-4 text-xs font-mono font-bold text-cyber-400">
 {{this.probability}}%
 </td>
 <td class="p-4 text-xs font-mono font-black text-emerald-500">
 {{formatCurrency this.estimatedValue}}
 </td>
 <td class="p-4 text-xs font-medium text-gray-400">
 {{formatDateShort this.expectedRevenueDate}}
 </td>
 <td class="p-4 text-right" onclick="event.stopPropagation();">
 <button onclick="window.openDealDetails('{{this.id}}')" class="inline-flex w-8 h-8 rounded-xl bg-white/5 text-gray-400 hover:text-white items-center justify-center">
 <span class="material-symbols-outlined text-[14px]">visibility</span>
 </button>
 </td>
 </tr>
 {{/each}}
 {{/each}}
 </tbody>
 </table>
 </div>
 </div>
 </div>

 <!-- Analytics View (Hidden by default) -->
 <div id="analise-container" class="flex-1 overflow-y-auto hidden pb-20 scrollbar-hide">
 <!-- Analytics Header & Month Filter -->
 <div class="glass-card p-4 border-white/5 mb-6 flex flex-col sm:flex-row items-center justify-between gap-4">
 <div class="flex flex-col gap-0.5">
 <h3 class="text-xs font-black text-white uppercase tracking-[0.2em] flex items-center gap-2">
 <span class="w-2 h-2 rounded-full bg-cyber-500 animate-pulse"></span>
 Mês de Referência: <span class="text-cyber-400 font-black">{{selectedMonthFormatted}}</span>
 </h3>
 <p class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Métricas baseadas na Previsão de Fechamento dos Cards</p>
 </div>
 <div class="flex items-center gap-2">
 <label for="analytics-month-filter" class="text-[8px] font-black uppercase tracking-widest text-gray-500">Filtrar por Mês:</label>
