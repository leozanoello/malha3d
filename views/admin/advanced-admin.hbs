function openEditPlanModal(id, name, price, revisions, sla, discount) {
    const modal = document.getElementById('newPlanModal');
    modal.querySelector('h3').innerText = 'Editar Plano B2B';
    const form = modal.querySelector('form');
    form.action = `/admin/api/plans/${id}`;
    form.setAttribute('data-method', 'PATCH');
    form.name.value = name;
    form.price.value = price;
    form.revisionsLimit.value = revisions;
    form.slaDays.value = sla;
    form.extraDiscount.value = discount;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closePlanModal() {
    const modal = document.getElementById('newPlanModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    const form = modal.querySelector('form');
    form.reset();
    form.removeAttribute('data-method');
    modal.querySelector('h3').innerText = 'Criar Novo Nível de Plano';
}

async function submitPlan(e) {
    e.preventDefault();
    const form = e.target;
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerText;
    
    submitBtn.disabled = true;
    submitBtn.innerText = 'Salvando...';

    const isEdit = form.hasAttribute('data-method');
    const url = form.action || '/admin/api/plans';
    const method = isEdit ? 'PATCH' : 'POST';
    
    const data = {
        name: form.name.value,
        price: parseFloat(form.price.value),
        revisionsLimit: parseInt(form.revisionsLimit.value),
        slaDays: parseInt(form.slaDays.value),
        extraDiscount: parseInt(form.extraDiscount.value),
        usersLimit: parseInt(form.usersLimit.value),
        hasProjects: form.hasProjects.checked,
        hasFinance: form.hasFinance.checked,
        hasDashboard: form.hasDashboard.checked
    };

    try {
        const res = await fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const json = await res.json();
        if (json.success) {
            showToast('Plano salvo com sucesso');
            setTimeout(() => window.location.reload(), 1000);
        } else {
            showToast(json.message, 'error');
            submitBtn.disabled = false;
            submitBtn.innerText = originalText;
        }
    } catch (err) {
        showToast('Erro de rede.', 'error');
        submitBtn.disabled = false;
        submitBtn.innerText = originalText;
    }
}

async function deletePlan(id) {
    if (!confirm('Tem certeza que deseja excluir este plano?')) return;
    try {
        const res = await fetch(`/admin/api/plans/${id}`, { method: 'DELETE' });
        const json = await res.json();
        if (json.success) {
            showToast('Plano excluído');
            setTimeout(() => window.location.reload(), 1000);
        } else { showToast('Erro ao excluir plano.', 'error'); }
    } catch (err) { showToast('Erro de rede.', 'error'); }
}

async function updateSystemSetting(el) {
    const key = el.getAttribute('data-setting');
    const value = el.type === 'checkbox' ? el.checked : el.value;
    
    try {
        const res = await fetch('/admin/api/settings/bulk', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ settings: { [key]: value } })
        });
        const json = await res.json();
        if (json.success) {
            showToast('Configuração salva.');
        } else { showToast('Erro ao salvar', 'error'); }
    } catch (err) { showToast('Erro de conexão', 'error'); }
}

async function terminateAllSessions() {
    if (!confirm('ATENÇÃO: Isso irá forçar o logout de TODOS os usuários exceto você. Continuar?')) return;
    try {
        const res = await fetch('/admin/api/security/terminate-sessions', { method: 'POST' });
        const json = await res.json();
        if (json.success) {
            showToast(json.message);
        } else { showToast('Erro ao invalidar sessões', 'error'); }
    } catch (err) { showToast('Erro de conexão', 'error'); }
}

async function addIpWhitelist() {
    const ip = document.getElementById('newIpAddress').value;
    if (!ip) return showToast('Insira um IP válido.', 'error');
    
    try {
        const res = await fetch('/admin/api/settings/bulk', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ settings: { [`security_ip_whitelist_${Date.now()}`]: ip } })
        });
        const json = await res.json();
        if (json.success) {
            showToast('IP adicionado à whitelist!');
            document.getElementById('newIpAddress').value = '';
        }
    } catch (err) { showToast('Erro ao salvar IP.', 'error'); }
}

function closePlanModal() {
    const modal = document.getElementById('newPlanModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    const form = modal.querySelector('form');
    form.reset();
    form.removeAttribute('data-method');
    modal.querySelector('h3').innerText = 'Criar Novo Nível de Plano';
}

function toggleAccordion(id) {
    const el = document.getElementById(id);
    const icon = document.getElementById('icon-' + id);
    if (!el) return;
    
    if (el.classList.contains('hidden')) {
        el.classList.remove('hidden');
        if (icon) icon.style.transform = 'rotate(180deg)';
    } else {
        el.classList.add('hidden');
        if (icon) icon.style.transform = 'rotate(0deg)';
    }
}
