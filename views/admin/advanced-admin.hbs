 <div class="flex justify-between items-start">
 <div class="flex items-center gap-4">
 <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-orange-500 to-red-600 flex items-center justify-center text-white font-black text-xl shadow-lg shadow-orange-500/20">
 ${u.name ? u.name.charAt(0).toUpperCase() : 'U'}
 </div>
 <div>
 <h4 class="text-white font-black uppercase tracking-tighter">${u.name || 'Sem Nome'}</h4>
 <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">${u.email}</p>
 </div>
 </div>
 <div class="flex flex-col items-end gap-1">
 <span class="badge ${u.role === 'admin' ? 'bg-red-500/20 text-red-500' : 'bg-orange-500/20 text-orange-500'} border-none uppercase text-[9px] font-black tracking-widest px-3 py-1 rounded-full">
 ${u.role}
 </span>
 ${u.parentId ? `<span class="text-[8px] text-gray-600 font-bold uppercase tracking-widest">Sub-conta</span>` : ''}
 </div>
 </div>
 
 <div class="grid grid-cols-2 gap-3 py-4 border-y border-white/5 my-2">
 <div>
 <p class="text-[8px] text-gray-600 font-bold uppercase tracking-widest mb-1">Status</p>
 <div class="flex items-center gap-2">
 <div class="w-1.5 h-1.5 rounded-full ${u.isActive ? 'bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.5)]' : 'bg-red-500'}"></div>
 <span class="text-[10px] text-white font-bold uppercase tracking-tight">${u.isActive ? 'Ativo' : 'Inativo'}</span>
 </div>
 </div>
 <div>
 <p class="text-[8px] text-gray-600 font-bold uppercase tracking-widest mb-1">Ãšltimo Acesso</p>
 <span class="text-[10px] text-gray-400 font-bold uppercase tracking-tight">${u.lastLogin ? new Date(u.lastLogin).toLocaleDateString() : 'Nunca'}</span>
 </div>
 </div>

 <div class="flex gap-2">
 <button onclick="openEditUserModal('${u.id}', '${u.name}', '${u.email}', '${u.role}', '${u.parentId || ''}', '${u.tenantName || ''}', '${u.permissions?.allowed_menus ? u.permissions.allowed_menus.join(',') : ''}')" 
 class="flex-1 btn-premium text-[9px] py-2 bg-white/5 hover:bg-orange-500 hover:text-white transition-all text-center">
 Editar Perfil
