    const modal = document.getElementById('editUserModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

async function submitEditUser(e) {
    e.preventDefault();
    const form = e.target;
    const userId = form.userId.value;
    const btn = form.querySelector('button[type="submit"]');
    const originalText = btn.innerText;
    
    btn.disabled = true;
    btn.innerText = 'Salvando...';

    const data = {
        name: form.name.value,
        email: form.email.value,
        role: form.role.value,
        parentId: form.parentId.value || null
    };

    try {
        const res = await fetch(`/admin/api/users/${userId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const json = await res.json();
        if (json.success) {
            showToast('Usuário atualizado!');
            closeEditUserModal();
            loadUsers();
        } else {
            showToast(json.message || 'Erro ao atualizar', 'error');
            btn.disabled = false;
            btn.innerText = originalText;
        }
    } catch (err) {
        showToast('Erro de conexão', 'error');
        btn.disabled = false;
        btn.innerText = originalText;
    }
}

async function deleteUser(id) {
    if (!confirm('Tem certeza que deseja excluir este usuário permanentemente?')) return;
    try {
        const res = await fetch(`/admin/api/users/${id}`, { method: 'DELETE' });
        const json = await res.json();
        if (json.success) {
            showToast('Usuário removido!');
            loadUsers();
        } else {
            showToast(json.message, 'error');
        }
    } catch (err) {
        showToast('Erro ao excluir usuário', 'error');
    }
}

