                                    <td class="px-8 py-6">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-lg bg-orange-500/10 flex items-center justify-center text-orange-500 text-[10px] font-black uppercase">{{firstLetter this.userName}}</div>
                                            <span class="text-[11px] font-black text-white uppercase">{{this.userName}}</span>
                                        </div>
                                    </td>
                                    <td class="px-8 py-6 text-[11px] font-bold text-gray-400">{{this.action}}</td>
                                    <td class="px-8 py-6">
                                        <span class="px-2.5 py-1 rounded-lg bg-white/5 border border-white/10 text-[8px] font-black text-gray-500 uppercase tracking-widest">{{this.module}}</span>
