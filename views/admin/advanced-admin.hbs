                                    <th class="px-8 py-5 text-[9px] font-black text-gray-400 uppercase tracking-widest">Ação Realizada</th>
                                    <th class="px-8 py-5 text-[9px] font-black text-gray-400 uppercase tracking-widest">Módulo</th>
