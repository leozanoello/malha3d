<script>
/**
 * MALHA 3D - ADVANCED ADMIN STABILIZATION
 * Specialized Toast System & Persistent Navigation
 */

function showToast(message, type = 'success') {
 const container = document.getElementById('toast-container');
 if (!container) return;
 
 const toast = document.createElement('div');
 toast.className = `flex items-center gap-3 px-6 py-4 rounded-2xl border shadow-2xl animate-in slide-in-from-right duration-300 pointer-events-auto ${
 type === 'success' 
 ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-500' 
 : 'bg-red-500/10 border-red-500/20 text-red-500'
 }`;
 
 toast.innerHTML = `
 <span class="material-symbols-outlined text-lg">${type === 'success' ? 'check_circle' : 'error'}</span>
 <span class="text-[11px] font-black uppercase tracking-widest">${message}</span>
 `;
 
 container.appendChild(toast);
 setTimeout(() => {
 toast.classList.add('fade-out');
 setTimeout(() => toast.remove(), 300);
 }, 4000);
}

document.addEventListener('DOMContentLoaded', function() {
 console.log('Advanced Admin Stabilization Active');
 
 // Aba inicial pelo Hash
 const hash = window.location.hash.substring(1);
 if (hash) {
 const activeBtn = document.querySelector(`.advanced-tab-btn[data-tab="${hash}"]`);
 if (activeBtn) switchAdvTab(hash, activeBtn);
 } else {
 // Default: UsuÃ¡rios
 switchAdvTab('usuarios', document.querySelector('.advanced-tab-btn[data-tab="usuarios"]'));
 }

 const tabButtons = document.querySelectorAll('.advanced-tab-btn');
 tabButtons.forEach(btn => {
 btn.addEventListener('click', function() {
 const tabId = this.getAttribute('data-tab');
 switchAdvTab(tabId, this);
 window.location.hash = tabId;
 });
 });
 
 // Event Delegation for User Management Pane (moved out of switchAdvTab)
 const paneUsuarios = document.getElementById('pane-usuarios');
 if (paneUsuarios) {
 paneUsuarios.addEventListener('click', function(e) {
 // Handle Edit User
 const editBtn = e.target.closest('.btn-edit-user');
 if (editBtn) {
 e.stopPropagation();
 const d = editBtn.dataset;
 openEditUserModal(d.id, d.name, d.email, d.role, d.parent, d.tenant, d.menus);
 return;
 }
 
 // Handle Reset Password
 const resetBtn = e.target.closest('.btn-reset-pass');
 if (resetBtn) {
 e.stopPropagation();
 const d = resetBtn.dataset;
 openResetPasswordModal(d.id, d.name);
 return;
 }

 // Handle Accordion Toggle
 const header = e.target.closest('.accordion-header');
 if (header) {
 const item = header.closest('.subscriber-item');
 const content = item.querySelector('.accordion-content');
 const icon = header.querySelector('.accordion-icon');
 
 if (content) {
 content.classList.toggle('hidden');
 if (icon) icon.classList.toggle('rotate-180');
 }
 return;
 }
 });
 }
 
 const btnOpenNewUser = document.getElementById('btnOpenNewUser');
 if (btnOpenNewUser) {
 btnOpenNewUser.addEventListener('click', openNewUserModal);
 }
 });

function switchAdvTab(tabId, btn) {
 // Esconder todos os painÃ©is e remover classe active
 document.querySelectorAll('.adv-pane').forEach(p => {
 p.classList.add('hidden');
 p.classList.remove('active');
 });

 const target = document.getElementById(`pane-${tabId}`);
 if (target) {
 target.classList.remove('hidden');
 target.classList.add('active');
 }

 // Atualizar botÃµes de navegaÃ§Ã£o
 document.querySelectorAll('.advanced-tab-btn').forEach(b => b.classList.remove('active'));
 if (btn) btn.classList.add('active');

 // Carregar dados especÃ­ficos se necessÃ¡rio
 if (tabId === 'usuarios') {
 const auditView = document.getElementById('users-audit-view');
 if (auditView) auditView.classList.remove('hidden');
 loadUsers();
 } else {
 const auditView = document.getElementById('users-audit-view');
 if (auditView) auditView.classList.add('hidden');
 }
}

function toggleCollapseCard(cardId, iconId) {
 const card = document.getElementById(cardId);
 const icon = document.getElementById(iconId || `icon-${cardId}`);
 if (card) {
 card.classList.toggle('hidden');
 if (icon) {
 icon.classList.toggle('rotate-180');
 }
 }
}

// --- USER MANAGEMENT ---
function openNewUserModal() {
 const modal = document.getElementById('newUserModal');
 modal.classList.remove('hidden');
 modal.classList.add('flex');
}

function closeNewUserModal() {
 const modal = document.getElementById('newUserModal');
 modal.classList.add('hidden');
 modal.classList.remove('flex');
}

async function submitNewUser(e) {
 e.preventDefault();
 const form = e.target;
 const btn = form.querySelector('button[type="submit"]');
 const originalText = btn.innerText;
 
 btn.disabled = true;
 btn.innerText = 'Processando...';
 
 const data = {
 name: form.name.value,
 email: form.email.value,
 password: form.password.value,
 role: form.role.value,
 tenantName: form.tenantName.value || null,
 parentId: form.parentId.value || null,
 specialty: form.specialty.value || null,
 mainTool: form.mainTool.value || null,
 allowed_menus: Array.from(form.querySelectorAll('input[name="allowed_menus"]:checked')).map(cb => cb.value)
 };

 try {
 const res = await fetch('/admin/api/users', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify(data)
 });
 const json = await res.json();
 
 if (json.success) {
 showToast('UsuÃ¡rio criado com sucesso!');
 setTimeout(() => window.location.reload(), 1000);
 } else {
 showToast(json.error || 'Erro ao criar usuÃ¡rio', 'error');
 btn.disabled = false;
 btn.innerText = originalText;
 }
 } catch (err) {
 showToast('Erro de conexÃ£o', 'error');
 btn.disabled = false;
 btn.innerText = originalText;
 }
}

async function loadUsers() {
 const container = document.querySelector('.users-grid');
 if (!container) return;
 
 container.innerHTML = '<div class="col-span-full text-center py-10 text-gray-500 font-bold uppercase tracking-widest animate-pulse">Carregando usuÃ¡rios do sistema...</div>';
 
 try {
 const response = await fetch('/admin/api/users');
 const data = await response.json();
 
 if (!data.success) throw new Error(data.message || 'Erro ao carregar usuÃ¡rios');
 if (!Array.isArray(data.users)) throw new Error('Dados de usuÃ¡rios invÃ¡lidos');
 
 if (data.users.length === 0) {
 container.innerHTML = '<div class="col-span-full text-center py-20 text-gray-500 font-bold uppercase tracking-widest">Nenhum usuÃ¡rio encontrado no sistema.</div>';
 return;
