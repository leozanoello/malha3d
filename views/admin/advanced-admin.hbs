<!-- 
    ZANOELLO 3D - ADVANCED ADMIN PANEL
    Design: Senior ArchViz SaaS / Liquid Glass / High Density
-->

<div class="advanced-admin-wrapper animate-in fade-in duration-700">
    <div class="flex flex-col xl:flex-row gap-8">
        <!-- Vertical Tab Navigation -->
        <div class="xl:w-72 flex-shrink-0">
            <div class="glass-card p-4 border-white/5 sticky top-10">
                <div class="flex flex-col gap-2">
                    <button class="advanced-tab-btn active" data-tab="instances">
                        <span class="material-symbols-outlined text-lg">memory</span>
                        <span>Instâncias</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="plans">
                        <span class="material-symbols-outlined text-lg">workspace_premium</span>
                        <span>Planos B2B</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="banking">
                        <span class="material-symbols-outlined text-lg">account_balance</span>
                        <span>Bancário</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="security">
                        <span class="material-symbols-outlined text-lg">admin_panel_settings</span>
                        <span>Segurança</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="api">
                        <span class="material-symbols-outlined text-lg">api</span>
                        <span>Integrações & API</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="notifications">
                        <span class="material-symbols-outlined text-lg">notifications_active</span>
                        <span>Notificações</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="backup">
                        <span class="material-symbols-outlined text-lg">cloud_sync</span>
                        <span>Backup & Dados</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="logs">
                        <span class="material-symbols-outlined text-lg">terminal</span>
                        <span>Logs & Auditoria</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="flex-1 min-w-0">
            <!-- Tab: Instâncias -->
            <div id="adv-tab-instances" class="adv-pane active">
                <div class="space-y-8">
                    <header class="flex justify-between items-end">
                        <div>
                            <h2 class="text-3xl font-black text-white tracking-tighter">Infraestrutura & <span class="text-orange-500">Automação</span></h2>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-2">Gestão de contêineres e render nodes</p>
                        </div>
                        <button class="px-6 py-3 bg-orange-500/10 border border-orange-500/20 text-orange-500 text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-orange-500 hover:text-white transition-all">Sincronizar Cluster</button>
                    </header>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                        <div class="glass-card p-6 border-white/5 bg-white/[0.01]">
                            <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Total Instâncias</p>
                            <h4 class="text-2xl font-black text-white">{{instances.length}}</h4>
                            <div class="mt-4 flex items-center gap-2">
                                <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
                                <span class="text-[9px] font-bold text-emerald-500 uppercase">Todo o Cluster Online</span>
                            </div>
                        </div>
                        <!-- More summary cards can go here -->
                    </div>

                    <div class="glass-card border-white/5 overflow-hidden">
                        <table class="w-full text-left">
                            <thead class="bg-white/5 border-b border-white/5">
                                <tr>
                                    <th class="px-8 py-5 text-[9px] font-black text-gray-400 uppercase tracking-widest">Instância</th>
                                    <th class="px-8 py-5 text-[9px] font-black text-gray-400 uppercase tracking-widest">Status</th>
                                    <th class="px-8 py-5 text-[9px] font-black text-gray-400 uppercase tracking-widest">Uptime</th>
                                    <th class="px-8 py-5 text-[9px] font-black text-gray-400 uppercase tracking-widest">Carga</th>
                                    <th class="px-8 py-5 text-[9px] font-black text-gray-400 uppercase tracking-widest">Ações</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/[0.03]">
                                {{#each instances}}
                                <tr class="hover:bg-white/[0.02] transition-colors">
                                    <td class="px-8 py-6">
                                        <div class="flex items-center gap-4">
                                            <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-orange-500">
                                                <span class="material-symbols-outlined text-lg">{{#if (eq this.type 'docker')}}terminal{{else if (eq this.type 'ia')}}psychology{{else}}dns{{/if}}</span>
                                            </div>
                                            <div>
                                                <p class="text-[11px] font-black text-white uppercase">{{this.name}}</p>
                                                <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest mt-1">{{this.ipAddress}}</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-8 py-6">
                                        <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[8px] font-black text-emerald-500 uppercase tracking-widest">{{this.status}}</span>
                                    </td>
                                    <td class="px-8 py-6 text-[10px] font-bold text-gray-400">{{this.uptime}}</td>
                                    <td class="px-8 py-6">
                                        <div class="flex flex-col gap-2 w-32">
                                            <div class="flex justify-between text-[8px] font-black uppercase tracking-widest">
                                                <span class="text-gray-500">Load</span>
                                                <span class="text-white">{{this.cpuUsage}}%</span>
                                            </div>
                                            <div class="h-1 bg-white/5 rounded-full overflow-hidden">
                                                <div class="h-full bg-orange-500 shadow-[0_0_10px_rgba(249,115,22,0.4)]" style="width: {{this.cpuUsage}}%"></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-8 py-6">
                                        <div class="flex items-center gap-2">
                                            <button class="p-2 rounded-lg bg-white/5 text-gray-400 hover:text-white transition-all"><span class="material-symbols-outlined text-sm">history</span></button>
                                            <button class="p-2 rounded-lg bg-white/5 text-gray-400 hover:text-orange-500 transition-all"><span class="material-symbols-outlined text-sm">restart_alt</span></button>
                                        </div>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Tab: Planos B2B -->
            <div id="adv-tab-plans" class="adv-pane hidden">
                <div class="space-y-8">
                    <header class="flex justify-between items-end">
                        <div>
                            <h2 class="text-3xl font-black text-white tracking-tighter">Planos & <span class="text-orange-500">Recorrência</span></h2>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-2">Gestão de assinaturas corporativas e SLAs</p>
                        </div>
                        <button class="px-6 py-3 bg-orange-500 text-white text-[10px] font-black uppercase tracking-widest rounded-xl shadow-lg shadow-orange-500/20" data-bs-toggle="modal" data-bs-target="#newPlanModal">Criar Novo Nível</button>
                    </header>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {{#each plans}}
                        <div class="glass-card p-10 border-white/5 bg-gradient-to-br from-white/[0.02] to-transparent relative overflow-hidden group">
                            <div class="absolute top-0 right-0 w-32 h-32 bg-orange-500/10 blur-[60px] -mr-16 -mt-16 group-hover:bg-orange-500/20 transition-all"></div>
                            
                            <div class="relative z-10">
                                <h3 class="text-2xl font-black text-white tracking-tighter mb-2 uppercase">{{this.name}}</h3>
                                <div class="flex items-baseline gap-2 mb-8">
                                    <span class="text-4xl font-black text-white tracking-tighter">R$ {{numberFormat this.price 0 ',' '.'}}</span>
                                    <span class="text-[10px] font-black text-gray-500 uppercase tracking-widest">/mês</span>
                                </div>

                                <div class="space-y-4 mb-10">
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-orange-500 text-sm">verified</span>
                                        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">{{this.revisionsLimit}} Revisões Inclusas</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-orange-500 text-sm">schedule</span>
                                        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">SLA de {{this.slaDays}} Dias Úteis</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-orange-500 text-sm">percent</span>
                                        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">{{this.extraDiscount}}% Off em Imagens Extras</span>
                                    </div>
                                </div>

                                <div class="flex items-center gap-3">
                                    <button class="flex-1 py-4 rounded-xl bg-white/5 text-white font-black text-[10px] uppercase tracking-widest hover:bg-white/10 transition-all">Editar</button>
                                    <button class="p-4 rounded-xl bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white transition-all"><span class="material-symbols-outlined text-sm">delete</span></button>
                                </div>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>

            <!-- Tab: Bancário -->
            <div id="adv-tab-banking" class="adv-pane hidden">
                <div class="space-y-10">
                    <header>
                        <h2 class="text-3xl font-black text-white tracking-tighter">Inteligência <span class="text-orange-500">Financeira</span></h2>
                        <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-2">Gateways de pagamento e regras de faturamento</p>
                    </header>

                    <div class="grid grid-cols-1 xl:grid-cols-2 gap-10">
                        <div class="glass-card p-10 border-white/5 bg-white/[0.01] space-y-8">
                            <h4 class="text-sm font-black text-white uppercase tracking-[0.2em] mb-6 flex items-center gap-3">
                                <span class="material-symbols-outlined text-orange-500">point_of_sale</span> Gateway Principal
                            </h4>
                            <div class="space-y-6">
                                <div class="p-6 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-between group hover:border-orange-500/40 transition-all cursor-pointer">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-xl bg-white flex items-center justify-center p-2">
                                            <img src="https://stripe.com/favicon.ico" class="w-full grayscale group-hover:grayscale-0 transition-all">
                                        </div>
                                        <div>
                                            <p class="text-[11px] font-black text-white uppercase">Stripe Connect</p>
                                            <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest">Global Payments & Split</p>
                                        </div>
                                    </div>
                                    <span class="material-symbols-outlined text-emerald-500">check_circle</span>
                                </div>
                                <div class="p-6 rounded-2xl bg-white/2 border border-white/5 flex items-center justify-between group hover:border-blue-500/40 transition-all cursor-pointer opacity-50">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-xl bg-white flex items-center justify-center p-2 text-blue-600 font-black italic">asaas</div>
                                        <div>
                                            <p class="text-[11px] font-black text-white uppercase">Asaas</p>
                                            <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest">Boletos & Pix Nativo</p>
                                        </div>
                                    </div>
                                    <span class="text-[9px] font-black text-gray-600 uppercase tracking-widest">Desconectado</span>
                                </div>
                            </div>
                        </div>

                        <div class="glass-card p-10 border-white/5 bg-white/[0.01] space-y-8">
                            <h4 class="text-sm font-black text-white uppercase tracking-[0.2em] mb-6 flex items-center gap-3">
                                <span class="material-symbols-outlined text-orange-500">settings_b_roll</span> Regras de Gatilho
                            </h4>
                            <div class="space-y-6">
                                <div class="flex items-center justify-between p-4 bg-white/5 rounded-2xl border border-white/10">
                                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Sinal Obrigatório (50%)</span>
                                    <label class="switch">
                                        <input type="checkbox" checked>
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                                <div class="flex items-center justify-between p-4 bg-white/5 rounded-2xl border border-white/10">
                                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Bloquear Download sem Pagamento</span>
                                    <label class="switch">
                                        <input type="checkbox" checked>
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab: Segurança -->
            <div id="adv-tab-security" class="adv-pane hidden">
                <div class="space-y-10">
                    <header class="flex justify-between items-end">
                        <div>
                            <h2 class="text-3xl font-black text-white tracking-tighter">Cibersegurança & <span class="text-orange-500">RBAC</span></h2>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-2">Proteção de IP e controle de acesso granular</p>
                        </div>
                        <button class="px-6 py-3 bg-red-500 text-white text-[10px] font-black uppercase tracking-widest rounded-xl shadow-lg shadow-red-500/20">Terminar Todas as Sessões</button>
                    </header>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                        <div class="lg:col-span-2 glass-card border-white/5 overflow-hidden">
                            <div class="p-8 border-b border-white/5 bg-white/5">
                                <h4 class="text-[11px] font-black text-white uppercase tracking-[0.2em]">Matriz de Permissões (Roles)</h4>
                            </div>
                            <table class="w-full text-left">
                                <thead class="bg-black/20">
                                    <tr>
                                        <th class="px-8 py-4 text-[9px] font-black text-gray-500 uppercase">Módulo</th>
                                        <th class="px-8 py-4 text-[9px] font-black text-gray-500 uppercase text-center">Admin</th>
                                        <th class="px-8 py-4 text-[9px] font-black text-gray-500 uppercase text-center">Artista</th>
                                        <th class="px-8 py-4 text-[9px] font-black text-gray-500 uppercase text-center">Cliente</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-white/[0.03] text-[10px] font-bold text-gray-400 uppercase">
                                    <tr>
                                        <td class="px-8 py-4 text-white">Financeiro</td>
                                        <td class="px-8 py-4 text-center text-emerald-500"><span class="material-symbols-outlined text-sm">check</span></td>
                                        <td class="px-8 py-4 text-center text-red-500"><span class="material-symbols-outlined text-sm">close</span></td>
                                        <td class="px-8 py-4 text-center text-red-500"><span class="material-symbols-outlined text-sm">close</span></td>
                                    </tr>
                                    <tr>
                                        <td class="px-8 py-4 text-white">Projetos (Full)</td>
                                        <td class="px-8 py-4 text-center text-emerald-500"><span class="material-symbols-outlined text-sm">check</span></td>
                                        <td class="px-8 py-4 text-center text-emerald-500"><span class="material-symbols-outlined text-sm">check</span></td>
                                        <td class="px-8 py-4 text-center text-emerald-500 opacity-30"><span class="material-symbols-outlined text-sm">visibility</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="space-y-8">
                            <div class="glass-card p-8 border-white/5 bg-white/[0.01]">
                                <h5 class="text-[11px] font-black text-white uppercase tracking-widest mb-6">IP Whitelisting</h5>
                                <div class="space-y-4">
                                    <div class="flex gap-2">
                                        <input type="text" class="input-premium py-3" placeholder="192.168.1.1">
                                        <button class="px-4 bg-orange-500 rounded-xl text-white"><span class="material-symbols-outlined">add</span></button>
                                    </div>
                                    <div class="p-3 rounded-xl bg-white/5 border border-white/5 flex justify-between items-center">
                                        <span class="text-[9px] font-black text-gray-500 tracking-widest uppercase">Escritório Central</span>
                                        <button class="text-red-500"><span class="material-symbols-outlined text-sm">delete</span></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab: Integrações -->
            <div id="adv-tab-api" class="adv-pane hidden">
                <div class="space-y-10">
                    <header>
                        <h2 class="text-3xl font-black text-white tracking-tighter">Ecosistema de <span class="text-orange-500">APIs</span></h2>
                        <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-2">Conectividade n8n, Webhooks e Storage</p>
                    </header>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <div class="glass-card p-8 border-white/5 bg-white/[0.01] flex flex-col items-center text-center">
                            <div class="w-16 h-16 rounded-2xl bg-[#FF4B2B]/10 flex items-center justify-center text-[#FF4B2B] mb-6">
                                <span class="material-symbols-outlined text-4xl">webhook</span>
                            </div>
                            <h4 class="text-xs font-black text-white uppercase tracking-widest mb-2">Webhooks</h4>
                            <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest mb-6">Dispare ações para n8n/Zapier</p>
                            <button class="w-full py-4 rounded-xl bg-white/5 text-[10px] font-black uppercase tracking-widest hover:bg-white/10 transition-all">Configurar</button>
                        </div>
                        <div class="glass-card p-8 border-white/5 bg-white/[0.01] flex flex-col items-center text-center">
                            <div class="w-16 h-16 rounded-2xl bg-blue-500/10 flex items-center justify-center text-blue-500 mb-6">
                                <span class="material-symbols-outlined text-4xl">database</span>
                            </div>
                            <h4 class="text-xs font-black text-white uppercase tracking-widest mb-2">Supabase DB</h4>
                            <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest mb-6">Conexão direta ao banco neural</p>
                            <button class="w-full py-4 rounded-xl bg-white/5 text-[10px] font-black uppercase tracking-widest hover:bg-white/10 transition-all">Ver Credentials</button>
                        </div>
                        <div class="glass-card p-8 border-white/5 bg-white/[0.01] flex flex-col items-center text-center">
                            <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 flex items-center justify-center text-emerald-500 mb-6">
                                <span class="material-symbols-outlined text-4xl">cloud</span>
                            </div>
                            <h4 class="text-xs font-black text-white uppercase tracking-widest mb-2">Cloud Storage</h4>
                            <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest mb-6">Google Drive & Dropbox Auth</p>
                            <button class="w-full py-4 rounded-xl bg-white/5 text-[10px] font-black uppercase tracking-widest hover:bg-white/10 transition-all">Autorizar</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab: Notificações -->
            <div id="adv-tab-notifications" class="adv-pane hidden">
                <div class="space-y-10">
                    <header>
                        <h2 class="text-3xl font-black text-white tracking-tighter">Central de <span class="text-orange-500">Mensageria</span></h2>
                        <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-2">Personalização de templates e fluxos de alerta</p>
                    </header>

                    <div class="glass-card border-white/5 overflow-hidden">
                        {{#each notifications}}
                        <div class="p-8 border-b border-white/5 flex items-center justify-between hover:bg-white/[0.02] transition-all">
                            <div class="flex items-center gap-6">
                                <div class="w-12 h-12 rounded-2xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-500">
                                    <span class="material-symbols-outlined">mail</span>
                                </div>
                                <div>
                                    <h4 class="text-[12px] font-black text-white uppercase tracking-tighter">{{this.name}}</h4>
                                    <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest mt-1">Disparado em: <span class="text-orange-500/80">{{this.triggerEvent}}</span></p>
                                </div>
                            </div>
                            <div class="flex items-center gap-4">
                                <button class="px-6 py-2 rounded-xl bg-white/5 text-[9px] font-black uppercase tracking-widest hover:bg-white/10">Editar Template</button>
                                <label class="switch">
                                    <input type="checkbox" {{#if this.isActive}}checked{{/if}}>
                                    <span class="slider round"></span>
                                </label>
                            </div>
                        </div>
                        {{/each}}
                        {{#unless notifications.length}}
                        <div class="p-20 text-center text-gray-600 uppercase font-black text-[10px] tracking-[0.3em]">Nenhum template cadastrado</div>
                        {{/unless}}
                    </div>
                </div>
            </div>

            <!-- Tab: Backup -->
            <div id="adv-tab-backup" class="adv-pane hidden">
                <div class="space-y-10">
                    <header class="flex justify-between items-end">
                        <div>
                            <h2 class="text-3xl font-black text-white tracking-tighter">Gestão de <span class="text-orange-500">Storage 3D</span></h2>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-2">Backups, snapshots e cold storage inteligente</p>
                        </div>
                        <button class="px-6 py-3 bg-white/5 border border-white/10 text-white text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-white/10 transition-all flex items-center gap-3">
                            <span class="material-symbols-outlined text-sm">download</span> Gerar Snapshot SQL
                        </button>
                    </header>

                    <div class="grid grid-cols-1 xl:grid-cols-3 gap-10">
                        <div class="xl:col-span-2 glass-card p-10 border-white/5 bg-white/[0.01]">
                            <h4 class="text-sm font-black text-white uppercase tracking-[0.2em] mb-8">Cold Storage Automático</h4>
                            <div class="space-y-8">
                                <div class="p-8 rounded-[2rem] bg-orange-500/5 border border-orange-500/10">
                                    <div class="flex justify-between items-center mb-6">
                                        <p class="text-[11px] font-black text-white uppercase tracking-widest">Regra de Arquivamento</p>
                                        <span class="px-3 py-1 bg-orange-500 text-white text-[8px] font-black uppercase tracking-widest rounded-lg">Ativo</span>
                                    </div>
                                    <p class="text-xs text-gray-500 font-bold uppercase leading-relaxed tracking-wider mb-8">
                                        Projetos finalizados há mais de <span class="text-orange-500">12 meses</span> serão automaticamente compactados e movidos para a camada de armazenamento de longo prazo (S3 Glacier).
                                    </p>
                                    <div class="flex gap-4">
                                        <button class="flex-1 py-4 rounded-xl bg-orange-500/10 text-orange-500 text-[10px] font-black uppercase tracking-widest">Alterar Limite</button>
                                        <button class="flex-1 py-4 rounded-xl bg-white/5 text-gray-400 text-[10px] font-black uppercase tracking-widest">Ver Projetos na Fila</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="glass-card p-8 border-white/5 bg-white/[0.01] space-y-8">
                            <h5 class="text-[11px] font-black text-white uppercase tracking-widest mb-6">Histórico de Snapshots</h5>
                            <div class="space-y-4">
                                <div class="p-4 rounded-xl bg-white/5 border border-white/5 flex justify-between items-center">
                                    <div>
                                        <p class="text-[10px] font-black text-white uppercase">2026-05-06_12:00.sql</p>
                                        <p class="text-[8px] text-gray-500 font-bold uppercase tracking-widest mt-1">128 MB • Hoje</p>
                                    </div>
                                    <button class="text-orange-500"><span class="material-symbols-outlined text-sm">cloud_download</span></button>
                                </div>
                                <div class="p-4 rounded-xl bg-white/5 border border-white/5 flex justify-between items-center opacity-50">
                                    <div>
                                        <p class="text-[10px] font-black text-white uppercase">2026-05-05_12:00.sql</p>
                                        <p class="text-[8px] text-gray-500 font-bold uppercase tracking-widest mt-1">126 MB • Ontem</p>
                                    </div>
                                    <button class="text-gray-600"><span class="material-symbols-outlined text-sm">cloud_download</span></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab: Logs -->
            <div id="adv-tab-logs" class="adv-pane hidden">
                <div class="space-y-10">
                    <header class="flex justify-between items-end">
                        <div>
                            <h2 class="text-3xl font-black text-white tracking-tighter">Auditoria de <span class="text-orange-500">Eventos</span></h2>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-2">Rastreabilidade inalterável de todas as ações no sistema</p>
                        </div>
                        <div class="flex gap-4">
                            <div class="relative">
                                <input type="text" class="input-premium py-3 pr-10 min-w-[250px]" placeholder="Filtrar por Usuário ou Ação...">
                                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-gray-600 text-lg">search</span>
                            </div>
                            <button class="p-3 bg-white/5 rounded-xl text-gray-400 hover:text-white transition-all"><span class="material-symbols-outlined">filter_list</span></button>
