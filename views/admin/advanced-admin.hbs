        <h3 class="text-xl font-black text-white uppercase tracking-tighter mb-6">Criar Novo Nível de Plano</h3>
        
        <form onsubmit="submitPlan(event)" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Nome do Tier</label>
                    <input type="text" name="name" required class="input-premium w-full" placeholder="Ex: Enterprise">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Valor Mensal (R$)</label>
                    <input type="number" name="price" step="0.01" required class="input-premium w-full" placeholder="199.90">
                </div>
            </div>
            <div class="grid grid-cols-3 gap-4">
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Limite Usuários</label>
                    <input type="number" name="usersLimit" required class="input-premium w-full" value="5">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Revisões</label>
                    <input type="number" name="revisionsLimit" required class="input-premium w-full" value="3">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">SLA (Dias)</label>
                    <input type="number" name="slaDays" required class="input-premium w-full" value="5">
                </div>
            </div>
            <div>
                <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Desconto Imagens Extras (%)</label>
                <input type="number" name="extraDiscount" required class="input-premium w-full" value="10">
            </div>
            
            <div class="space-y-3 pt-2">
                <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Features Ativas</label>
                <div class="flex items-center justify-between p-3 bg-white/5 rounded-xl border border-white/5">
                    <span class="text-[9px] font-bold text-gray-400 uppercase tracking-widest">Acesso a Projetos</span>
                    <label class="switch scale-75">
                        <input type="checkbox" name="hasProjects" checked>
                        <span class="slider round"></span>
                    </label>
                </div>
                <div class="flex items-center justify-between p-3 bg-white/5 rounded-xl border border-white/5">
                    <span class="text-[9px] font-bold text-gray-400 uppercase tracking-widest">Módulo Financeiro</span>
                    <label class="switch scale-75">
                        <input type="checkbox" name="hasFinance">
                        <span class="slider round"></span>
                    </label>
                </div>
                <div class="flex items-center justify-between p-3 bg-white/5 rounded-xl border border-white/5">
                    <span class="text-[9px] font-bold text-gray-400 uppercase tracking-widest">Dashboard Avançado</span>
                    <label class="switch scale-75">
                        <input type="checkbox" name="hasDashboard">
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>

            <div class="pt-4 flex justify-end gap-3">
                <button type="button" class="btn bg-white/5 text-white" onclick="closePlanModal()">Cancelar</button>
                <button type="submit" class="btn bg-orange-500 text-white shadow-lg shadow-orange-500/20">Salvar Plano</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Editar Usuário -->
<div id="editUserModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-sm">
    <div class="bg-slate-900 border border-white/10 w-full max-w-lg rounded-3xl p-8 shadow-2xl">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h3 class="text-xl font-black text-white uppercase tracking-tight">Editar Usuário</h3>
                <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-1">Modificar permissões e dados</p>
            </div>
            <button onclick="closeEditUserModal()" class="text-gray-500 hover:text-white transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form id="editUserForm" onsubmit="submitEditUser(event)" class="space-y-6">
            <input type="hidden" name="userId">
            <div class="grid grid-cols-2 gap-4">
                <div class="col-span-2">
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Nome Completo</label>
                    <input type="text" name="name" required class="input-premium w-full" placeholder="Ex: João Silva">
                </div>
                <div class="col-span-2">
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">E-mail de Acesso</label>
                    <input type="email" name="email" required class="input-premium w-full" placeholder="joao@estudio.com">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Cargo / Função</label>
                    <select name="role" required class="input-premium w-full">
                        <option value="subscriber">Assinante (Dono)</option>
                        <option value="staff">Staff (Equipe Master)</option>
                        <option value="collaborator">Colaborador (Sub-conta)</option>
                        <option value="admin">Super Admin</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Vincular a Assinante</label>
                    <select name="parentId" class="input-premium w-full">
                        <option value="">Nenhum (Orfão/Staff)</option>
                        {{#each users}}
                            {{#if (eq this.role 'subscriber')}}
                            <option value="{{this.id}}">{{this.name}}</option>
                            {{/if}}
                        {{/each}}
                    </select>
                </div>
            </div>

            <div class="pt-4 flex justify-end gap-3">
                <button type="button" class="btn bg-white/5 text-white" onclick="closeEditUserModal()">Cancelar</button>
                <button type="submit" class="btn bg-orange-500 text-white shadow-lg shadow-orange-500/20">Salvar Alterações</button>
            </div>
        </form>
    </div>
</div>
