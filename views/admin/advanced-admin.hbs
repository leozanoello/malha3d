<!-- 
    ZANOELLO 3D - ADVANCED ADMIN PANEL
    Design: Senior ArchViz SaaS / Liquid Glass / High Density
-->

<div class="advanced-admin-wrapper animate-in fade-in duration-700">
    <div class="flex flex-col xl:flex-row gap-8">
        <!-- Vertical Tab Navigation -->
        <div class="xl:w-72 flex-shrink-0">
            <div class="glass-card p-4 border-white/5 sticky top-10">
                <div class="flex flex-col gap-2">
                    <button class="advanced-tab-btn active" data-tab="usuarios">
                        <span class="material-symbols-outlined text-lg">group</span>
                        <span>Gestão Multi-Tenant</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="instancias">
                        <span class="material-symbols-outlined text-lg">memory</span>
                        <span>Instâncias</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="planos">
                        <span class="material-symbols-outlined text-lg">workspace_premium</span>
                        <span>Planos B2B</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="bancario">
                        <span class="material-symbols-outlined text-lg">account_balance</span>
                        <span>Bancário</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="seguranca">
                        <span class="material-symbols-outlined text-lg">admin_panel_settings</span>
                        <span>Segurança</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="integracoes">
                        <span class="material-symbols-outlined text-lg">api</span>
                        <span>Integrações & API</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="notificacoes">
                        <span class="material-symbols-outlined text-lg">notifications_active</span>
                        <span>Notificações</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="backup">
                        <span class="material-symbols-outlined text-lg">cloud_sync</span>
                        <span>Backup & Dados</span>
                    </button>
                    <button class="advanced-tab-btn" data-tab="logs">
                        <span class="material-symbols-outlined text-lg">terminal</span>
                        <span>Logs & Auditoria</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="flex-1 min-w-0">
            <!-- Tab: Gestão de Usuários (Multi-Tenant) -->
            <div id="pane-usuarios" class="adv-pane hidden">
                <div class="space-y-8">
                    <header class="flex justify-between items-end">
                        <div>
                            <h2 class="text-3xl font-black text-white tracking-tighter">Painel Master de <span class="text-orange-500">Acessos</span></h2>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-2">Gerenciamento de assinantes, staff e sub-contas (RBAC)</p>
                        </div>
                        <button id="btnOpenNewUser" class="px-6 py-3 bg-orange-500 text-white text-[10px] font-black uppercase tracking-widest rounded-xl shadow-lg shadow-orange-500/20 hover:bg-orange-400 transition-all">Criar Usuário Manual</button>
                    </header>

                    <!-- Bloco de Assinantes -->
                    <div class="glass-card border-white/5 overflow-hidden mb-8">
                        <div class="p-6 border-b border-white/5 bg-white/5 flex justify-between items-center">
                            <h4 class="text-[11px] font-black text-white uppercase tracking-[0.2em]">Hierarquia de Assinantes</h4>
                        </div>
                        <div class="divide-y divide-white/[0.03]">
                            {{#if subscriberUsers.length}}
                                {{#each subscriberUsers}}
                                <div class="group">
                                    <div class="px-8 py-5 flex items-center justify-between hover:bg-white/[0.02] transition-colors cursor-pointer" onclick="toggleAccordion('subusers-{{this.id}}')">
                                        <div class="flex items-center gap-4">
                                            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-500 font-black">
                                                {{firstLetter this.name}}
                                            </div>
                                            <div>
                                                <p class="text-[13px] font-black text-white uppercase">{{this.name}}</p>
                                                <p class="text-[10px] text-gray-400 font-bold tracking-widest">{{this.email}}</p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-6">
                                            <span class="px-3 py-1 rounded-full border text-[9px] font-black uppercase tracking-widest bg-emerald-500/10 border-emerald-500/20 text-emerald-500">
                                                {{this.role}}
                                            </span>
                                            {{#if this.tenantName}}
                                            <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"><span class="material-symbols-outlined text-[12px] align-middle mr-1">domain</span>{{this.tenantName}}</span>
                                            {{/if}}
                                            <div class="flex items-center gap-2">
                                                <button class="p-2 rounded-lg bg-white/5 text-gray-400 hover:text-white transition-all" onclick="event.stopPropagation(); openResetPasswordModal('{{this.id}}', '{{this.name}}')" title="Redefinir Senha"><span class="material-symbols-outlined text-sm">lock_reset</span></button>
                                                {{#if this.subUsers.length}}
                                                <span class="material-symbols-outlined text-gray-500 transition-transform duration-300" id="icon-subusers-{{this.id}}">expand_more</span>
                                                {{/if}}
                                            </div>
                                        </div>
                                    </div>
                                    
                                    {{#if this.subUsers.length}}
                                    <div id="subusers-{{this.id}}" class="hidden bg-black/20 border-t border-white/5 pl-16">
                                        <div class="divide-y divide-white/[0.03]">
                                            {{#each this.subUsers}}
                                            <div class="px-8 py-4 flex items-center justify-between hover:bg-white/[0.02] transition-colors">
                                                <div class="flex items-center gap-4">
                                                    <div class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 font-black text-xs">
                                                        {{firstLetter this.name}}
                                                    </div>
                                                    <div>
                                                        <p class="text-[11px] font-black text-gray-300 uppercase">{{this.name}}</p>
                                                        <p class="text-[9px] text-gray-500 font-bold tracking-widest">{{this.email}}</p>
                                                    </div>
                                                </div>
                                                <div class="flex items-center gap-6">
                                                    {{#if this.specialty}}
                                                    <span class="text-[9px] font-bold text-orange-500 uppercase tracking-widest"><span class="material-symbols-outlined text-[10px] align-middle mr-1">palette</span>{{this.specialty}}</span>
                                                    {{/if}}
                                                    {{#if this.mainTool}}
                                                    <span class="text-[9px] font-bold text-blue-500 uppercase tracking-widest"><span class="material-symbols-outlined text-[10px] align-middle mr-1">computer</span>{{this.mainTool}}</span>
                                                    {{/if}}
                                                    <span class="px-2 py-1 rounded bg-white/5 text-[8px] font-black text-gray-500 uppercase tracking-widest">{{this.role}}</span>
                                                    <button class="p-2 rounded-lg bg-white/5 text-gray-400 hover:text-white transition-all" onclick="openResetPasswordModal('{{this.id}}', '{{this.name}}')" title="Redefinir Senha"><span class="material-symbols-outlined text-sm">lock_reset</span></button>
                                                </div>
                                            </div>
                                            {{/each}}
                                        </div>
                                    </div>
                                    {{/if}}
                                </div>
                                {{/each}}
                            {{else}}
                                <div class="p-8 text-center text-gray-500 text-[10px] font-bold uppercase tracking-widest">Nenhum assinante encontrado.</div>
                            {{/if}}
                        </div>
                    </div>

                    <!-- Bloco de Outros Usuários (Staff/Admins/Avulsos) -->
                    <div class="glass-card border-white/5 overflow-hidden">
                        <div class="p-6 border-b border-white/5 bg-white/5 flex justify-between items-center">
                            <h4 class="text-[11px] font-black text-white uppercase tracking-[0.2em]">Equipe Zanoello e Colaboradores Avulsos</h4>
                        </div>
                        <div class="divide-y divide-white/[0.03]">
                            {{#if otherUsers.length}}
                                {{#each otherUsers}}
                                <div class="px-8 py-5 flex items-center justify-between hover:bg-white/[0.02] transition-colors">
                                    <div class="flex items-center gap-4">
                                        <div class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-500 font-black">
                                            {{firstLetter this.name}}
                                        </div>
                                        <div>
                                            <p class="text-[13px] font-black text-white uppercase">{{this.name}}</p>
                                            <p class="text-[10px] text-gray-400 font-bold tracking-widest">{{this.email}}</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-6">
                                        {{#if this.specialty}}
                                        <span class="text-[9px] font-bold text-orange-500 uppercase tracking-widest"><span class="material-symbols-outlined text-[10px] align-middle mr-1">palette</span>{{this.specialty}}</span>
                                        {{/if}}
                                        {{#if this.mainTool}}
                                        <span class="text-[9px] font-bold text-blue-500 uppercase tracking-widest"><span class="material-symbols-outlined text-[10px] align-middle mr-1">computer</span>{{this.mainTool}}</span>
                                        {{/if}}
                                        <span class="px-3 py-1 rounded-full border text-[9px] font-black uppercase tracking-widest
                                            {{#if (eq this.role 'admin')}}bg-red-500/10 border-red-500/20 text-red-500
                                            {{else if (eq this.role 'staff')}}bg-orange-500/10 border-orange-500/20 text-orange-500
                                            {{else}}bg-blue-500/10 border-blue-500/20 text-blue-500{{/if}}">
                                            {{this.role}}
                                        </span>
                                        <button class="p-2 rounded-lg bg-white/5 text-gray-400 hover:text-white transition-all" onclick="openResetPasswordModal('{{this.id}}', '{{this.name}}')" title="Redefinir Senha"><span class="material-symbols-outlined text-sm">lock_reset</span></button>
                                    </div>
                                </div>
                                {{/each}}
                            {{else}}
                                <div class="p-8 text-center text-gray-500 text-[10px] font-bold uppercase tracking-widest">Nenhum colaborador encontrado.</div>
                            {{/if}}
                        </div>
                    </div>
                </div>

                <!-- Dynamic Users View (Audit Mode) -->
                <div id="users-audit-view" class="hidden pt-10">
                    <div class="p-6 border-b border-white/5 bg-white/5 flex justify-between items-center mb-6 rounded-xl">
                        <h4 class="text-[11px] font-black text-white uppercase tracking-[0.2em]">Visualização de Auditoria Flat</h4>
                    </div>
                    <div class="users-grid grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6"></div>
                </div>
            </div>

            <!-- Tab: Instâncias -->
            <div id="pane-instancias" class="adv-pane hidden">
                <div class="space-y-8">
                    <header class="flex justify-between items-end">
                        <div>
                            <h2 class="text-3xl font-black text-white tracking-tighter">Infraestrutura & <span class="text-orange-500">Automação</span></h2>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-2">Gestão de contêineres e render nodes</p>
                        </div>
                        <div class="flex gap-4">
                            <button class="px-6 py-3 bg-orange-500 text-white text-[10px] font-black uppercase tracking-widest rounded-xl shadow-lg shadow-orange-500/20" onclick="openNewInstanceModal()">Nova Instância</button>
                            <button class="px-6 py-3 bg-orange-500/10 border border-orange-500/20 text-orange-500 text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-orange-500 hover:text-white transition-all" onclick="syncCluster()">Sincronizar Cluster</button>
                        </div>
                    </header>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                        <div class="glass-card p-6 border-white/5 bg-white/[0.01]">
                            <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Total Instâncias</p>
                            <h4 class="text-2xl font-black text-white">{{instances.length}}</h4>
                            <div class="mt-4 flex items-center gap-2">
                                <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
                                <span class="text-[9px] font-bold text-emerald-500 uppercase">Todo o Cluster Online</span>
                            </div>
                        </div>
                        <!-- More summary cards can go here -->
                    </div>

                    <div class="glass-card border-white/5 overflow-hidden">
                        <table class="w-full text-left">
                            <thead class="bg-white/5 border-b border-white/5">
                                <tr>
                                    <th class="px-8 py-5 text-[9px] font-black text-gray-400 uppercase tracking-widest">Instância</th>
                                    <th class="px-8 py-5 text-[9px] font-black text-gray-400 uppercase tracking-widest">Status</th>
                                    <th class="px-8 py-5 text-[9px] font-black text-gray-400 uppercase tracking-widest">Uptime</th>
                                    <th class="px-8 py-5 text-[9px] font-black text-gray-400 uppercase tracking-widest">Carga</th>
                                    <th class="px-8 py-5 text-[9px] font-black text-gray-400 uppercase tracking-widest">Ações</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/[0.03]">
                                {{#each instances}}
                                <tr class="hover:bg-white/[0.02] transition-colors">
                                    <td class="px-8 py-6">
                                        <div class="flex items-center gap-4">
                                            <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-orange-500">
                                                <span class="material-symbols-outlined text-lg">{{#if (eq this.type 'docker')}}terminal{{else if (eq this.type 'ia')}}psychology{{else}}dns{{/if}}</span>
                                            </div>
                                            <div>
                                                <p class="text-[11px] font-black text-white uppercase">{{this.name}}</p>
                                                <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest mt-1">{{this.ipAddress}}</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-8 py-6">
                                        <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[8px] font-black text-emerald-500 uppercase tracking-widest">{{this.status}}</span>
                                    </td>
                                    <td class="px-8 py-6 text-[10px] font-bold text-gray-400">{{this.uptime}}</td>
                                    <td class="px-8 py-6">
                                        <div class="flex flex-col gap-2 w-32">
                                            <div class="flex justify-between text-[8px] font-black uppercase tracking-widest">
                                                <span class="text-gray-500">Load</span>
                                                <span class="text-white">{{this.cpuUsage}}%</span>
                                            </div>
                                            <div class="h-1 bg-white/5 rounded-full overflow-hidden">
                                                <div class="h-full bg-orange-500 shadow-[0_0_10px_rgba(249,115,22,0.4)]" style="width: {{this.cpuUsage}}%"></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-8 py-6">
                                        <div class="flex items-center gap-2">
                                            <button onclick="viewInstanceLogs('{{this.id}}')" class="p-2 rounded-lg bg-white/5 text-gray-400 hover:text-white transition-all"><span class="material-symbols-outlined text-sm">history</span></button>
                                            <button onclick="instanceAction('{{this.id}}', 'restart')" class="p-2 rounded-lg bg-white/5 text-gray-400 hover:text-orange-500 transition-all"><span class="material-symbols-outlined text-sm">restart_alt</span></button>
                                        </div>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Tab: Planos B2B -->
            <div id="pane-planos" class="adv-pane hidden">
                <div class="space-y-8">
                    <header class="flex justify-between items-end">
                        <div>
                            <h2 class="text-3xl font-black text-white tracking-tighter">Planos & <span class="text-orange-500">Recorrência</span></h2>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-2">Gestão de assinaturas corporativas e SLAs</p>
                        </div>
                        <button class="px-6 py-3 bg-orange-500 text-white text-[10px] font-black uppercase tracking-widest rounded-xl shadow-lg shadow-orange-500/20" onclick="document.getElementById('newPlanModal').classList.remove('hidden')">Criar Novo Nível</button>
                    </header>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {{#each plans}}
                        <div class="glass-card p-10 border-white/5 bg-gradient-to-br from-white/[0.02] to-transparent relative overflow-hidden group">
                            <div class="absolute top-0 right-0 w-32 h-32 bg-orange-500/10 blur-[60px] -mr-16 -mt-16 group-hover:bg-orange-500/20 transition-all"></div>
                            
                            <div class="relative z-10">
                                <h3 class="text-2xl font-black text-white tracking-tighter mb-2 uppercase">{{this.name}}</h3>
                                <div class="flex items-baseline gap-2 mb-8">
                                    <span class="text-4xl font-black text-white tracking-tighter">R$ {{numberFormat this.price 0 ',' '.'}}</span>
                                    <span class="text-[10px] font-black text-gray-500 uppercase tracking-widest">/mês</span>
                                </div>

                                <div class="space-y-4 mb-10">
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-orange-500 text-sm">verified</span>
                                        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">{{this.revisionsLimit}} Revisões Inclusas</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-orange-500 text-sm">schedule</span>
                                        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">SLA de {{this.slaDays}} Dias Úteis</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-orange-500 text-sm">percent</span>
                                        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">{{this.extraDiscount}}% Off em Imagens Extras</span>
                                    </div>
                                </div>

                                <div class="flex items-center gap-3">
                                    <button class="flex-1 py-4 rounded-xl bg-white/5 text-white font-black text-[10px] uppercase tracking-widest hover:bg-white/10 transition-all" onclick="openEditPlanModal('{{this.id}}', '{{this.name}}', '{{this.price}}', '{{this.revisionsLimit}}', '{{this.slaDays}}', '{{this.extraDiscount}}')">Editar</button>
                                    <button class="p-4 rounded-xl bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white transition-all" onclick="deletePlan('{{this.id}}')"><span class="material-symbols-outlined text-sm">delete</span></button>
                                </div>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>

            <!-- Tab: Bancário -->
            <div id="pane-bancario" class="adv-pane hidden">
                <div class="space-y-10">
                    <header>
                        <h2 class="text-3xl font-black text-white tracking-tighter">Inteligência <span class="text-orange-500">Financeira</span></h2>
                        <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-2">Gateways de pagamento e regras de faturamento</p>
                    </header>

                    <div class="grid grid-cols-1 xl:grid-cols-2 gap-10">
                        <div class="glass-card p-10 border-white/5 bg-white/[0.01] space-y-8">
                            <h4 class="text-sm font-black text-white uppercase tracking-[0.2em] mb-6 flex items-center gap-3">
                                <span class="material-symbols-outlined text-orange-500">point_of_sale</span> Gateway Principal
                            </h4>
                            <div class="space-y-6">
                                <div class="p-6 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-between group hover:border-orange-500/40 transition-all cursor-pointer">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-xl bg-white flex items-center justify-center p-2">
                                            <img src="https://stripe.com/favicon.ico" class="w-full grayscale group-hover:grayscale-0 transition-all">
                                        </div>
                                        <div>
                                            <p class="text-[11px] font-black text-white uppercase">Stripe Connect</p>
                                            <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest">Global Payments & Split</p>
                                        </div>
                                    </div>
                                    <span class="material-symbols-outlined text-emerald-500">check_circle</span>
                                </div>
                                <div class="p-6 rounded-2xl bg-white/2 border border-white/5 flex items-center justify-between group hover:border-blue-500/40 transition-all cursor-pointer opacity-50">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-xl bg-white flex items-center justify-center p-2 text-blue-600 font-black italic">asaas</div>
                                        <div>
                                            <p class="text-[11px] font-black text-white uppercase">Asaas</p>
                                            <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest">Boletos & Pix Nativo</p>
                                        </div>
                                    </div>
                                    <span class="text-[9px] font-black text-gray-600 uppercase tracking-widest">Desconectado</span>
                                </div>
                            </div>
                        </div>

                        <div class="glass-card p-10 border-white/5 bg-white/[0.01] space-y-8">
                            <h4 class="text-sm font-black text-white uppercase tracking-[0.2em] mb-6 flex items-center gap-3">
                                <span class="material-symbols-outlined text-orange-500">settings_b_roll</span> Regras de Gatilho
                            </h4>
                            <div class="space-y-6">
                                <div class="flex items-center justify-between p-4 bg-white/5 rounded-2xl border border-white/10">
                                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Sinal Obrigatório (50%)</span>
                                    <label class="switch">
                                        <input type="checkbox" data-setting="banking_require_signal" onchange="updateSystemSetting(this)" {{#if (eq settings.banking_require_signal 'true')}}checked{{/if}}>
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                                <div class="flex items-center justify-between p-4 bg-white/5 rounded-2xl border border-white/10">
                                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Bloquear Download sem Pagamento</span>
                                    <label class="switch">
                                        <input type="checkbox" data-setting="banking_block_download" onchange="updateSystemSetting(this)" {{#if (eq settings.banking_block_download 'true')}}checked{{/if}}>
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab: Segurança -->
            <div id="pane-seguranca" class="adv-pane hidden">
                <div class="space-y-10">
                    <header class="flex justify-between items-end">
                        <div>
                            <h2 class="text-3xl font-black text-white tracking-tighter">Cibersegurança & <span class="text-orange-500">RBAC</span></h2>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-2">Proteção de IP e controle de acesso granular</p>
                        </div>
                        <button class="px-6 py-3 bg-red-500 text-white text-[10px] font-black uppercase tracking-widest rounded-xl shadow-lg shadow-red-500/20" onclick="terminateAllSessions()">Terminar Todas as Sessões</button>
                    </header>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                        <div class="lg:col-span-2 glass-card border-white/5 overflow-hidden">
                            <div class="p-8 border-b border-white/5 bg-white/5">
                                <h4 class="text-[11px] font-black text-white uppercase tracking-[0.2em]">Matriz de Permissões (Roles)</h4>
                            </div>
                            <table class="w-full text-left">
                                <thead class="bg-black/20">
                                    <tr>
                                        <th class="px-8 py-4 text-[9px] font-black text-gray-500 uppercase">Módulo</th>
                                        <th class="px-8 py-4 text-[9px] font-black text-gray-500 uppercase text-center">Admin</th>
                                        <th class="px-8 py-4 text-[9px] font-black text-gray-500 uppercase text-center">Artista</th>
