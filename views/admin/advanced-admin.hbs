<script>
/**
 * ZANOELLO 3D - ADVANCED ADMIN STABILIZATION
 * Specialized Toast System & Persistent Navigation
 */

function showToast(message, type = 'success') {
    const container = document.getElementById('toast-container');
    if (!container) return;
    
    const toast = document.createElement('div');
    toast.className = `flex items-center gap-3 px-6 py-4 rounded-2xl border shadow-2xl animate-in slide-in-from-right duration-300 pointer-events-auto ${
        type === 'success' 
        ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-500' 
        : 'bg-red-500/10 border-red-500/20 text-red-500'
    }`;
    
    toast.innerHTML = `
        <span class="material-symbols-outlined text-lg">${type === 'success' ? 'check_circle' : 'error'}</span>
        <span class="text-[11px] font-black uppercase tracking-widest">${message}</span>
    `;
    
    container.appendChild(toast);
    setTimeout(() => {
        toast.classList.add('fade-out');
        setTimeout(() => toast.remove(), 300);
    }, 4000);
}

document.addEventListener('DOMContentLoaded', function() {
    console.log('Advanced Admin Stabilization Active');
    
    // Aba inicial pelo Hash
    const hash = window.location.hash.substring(1);
    if (hash) {
        const activeBtn = document.querySelector(`.advanced-tab-btn[data-tab="${hash}"]`);
        if (activeBtn) switchAdvTab(hash, activeBtn);
    } else {
        // Default: Usuários
        switchAdvTab('usuarios', document.querySelector('.advanced-tab-btn[data-tab="usuarios"]'));
    }

    const tabButtons = document.querySelectorAll('.advanced-tab-btn');
    tabButtons.forEach(btn => {
        btn.addEventListener('click', function() {
            const tabId = this.getAttribute('data-tab');
            switchAdvTab(tabId, this);
            window.location.hash = tabId;
        });
    });

    const btnOpenNewUser = document.getElementById('btnOpenNewUser');
    if (btnOpenNewUser) {
        btnOpenNewUser.addEventListener('click', openNewUserModal);
    }

    // Bind New User Form
    const newUserForm = document.getElementById('newUserForm');
    if (newUserForm) {
        newUserForm.addEventListener('submit', submitNewUser);
    }

    // Bind New User Cancel Button
    const btnCancelNewUser = document.getElementById('btnCancelNewUser');
    if (btnCancelNewUser) {
        btnCancelNewUser.addEventListener('click', closeNewUserModal);
    }

    // Bind Edit User Form
    const editUserForm = document.getElementById('editUserForm');
    if (editUserForm) {
        editUserForm.addEventListener('submit', submitEditUser);
    }

    // Bind Edit User Cancel Button
    const btnCancelEditUser = document.getElementById('btnCancelEditUser');
    if (btnCancelEditUser) {
        btnCancelEditUser.addEventListener('click', closeEditUserModal);
    }
});

function switchAdvTab(tabId, btn) {
    // Esconder todos os painéis e remover classe active
    document.querySelectorAll('.adv-pane').forEach(p => {
        p.classList.add('hidden');
        p.classList.remove('active');
    });
    
    // Mostrar o alvo e adicionar classe active
    const target = document.getElementById(`pane-${tabId}`);
    if (target) {
        target.classList.remove('hidden');
        target.classList.add('active');
    }

    // Atualizar botões
    document.querySelectorAll('.advanced-tab-btn').forEach(b => {
        b.classList.remove('bg-white/10', 'text-white', 'border-orange-500');
        b.classList.add('text-gray-500', 'border-transparent');
    });
    
    if (btn) {
        btn.classList.add('bg-white/10', 'text-white', 'border-orange-500');
        btn.classList.remove('text-gray-500', 'border-transparent');
    }

    // Carregar dados específicos se necessário
    if (tabId === 'usuarios') {
        const auditView = document.getElementById('users-audit-view');
        if (auditView) auditView.classList.remove('hidden');
        loadUsers();
    } else {
        const auditView = document.getElementById('users-audit-view');
        if (auditView) auditView.classList.add('hidden');
    }
}

// --- USER MANAGEMENT ---
function openNewUserModal() {
    const modal = document.getElementById('newUserModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeNewUserModal() {
    const modal = document.getElementById('newUserModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

async function submitNewUser(e) {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');
    const originalText = btn.innerText;
    
    btn.disabled = true;
    btn.innerText = 'Processando...';
    
    const data = {
        name: form.name.value,
        email: form.email.value,
        password: form.password.value,
        role: form.role.value,
        tenantName: form.tenantName.value || null,
        parentId: form.parentId.value || null,
        specialty: form.specialty.value || null,
        mainTool: form.mainTool.value || null
    };

    try {
        const res = await fetch('/admin/api/users', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const json = await res.json();
        
        if (json.success) {
            showToast('Usuário criado com sucesso!');
            setTimeout(() => window.location.reload(), 1000);
        } else {
            showToast(json.error || 'Erro ao criar usuário', 'error');
            btn.disabled = false;
            btn.innerText = originalText;
        }
    } catch (err) {
        showToast('Erro de conexão', 'error');
        btn.disabled = false;
        btn.innerText = originalText;
    }
}

async function loadUsers() {
    const container = document.querySelector('.users-grid');
    if (!container) return;
    
    container.innerHTML = '<div class="col-span-full text-center py-10 text-gray-500 font-bold uppercase tracking-widest animate-pulse">Carregando usuários do sistema...</div>';
    
    try {
        const response = await fetch('/admin/api/users');
        const data = await response.json();
        
        if (!data.success) throw new Error(data.message || 'Erro ao carregar usuários');
        if (!Array.isArray(data.users)) throw new Error('Dados de usuários inválidos');
        
        if (data.users.length === 0) {
            container.innerHTML = '<div class="col-span-full text-center py-20 text-gray-500 font-bold uppercase tracking-widest">Nenhum usuário encontrado no sistema.</div>';
            return;
        }

        container.innerHTML = data.users.map(u => `
            <div class="glass-card p-6 flex flex-col gap-4 border border-white/5 hover:border-orange-500/30 transition-all group">
                <div class="flex justify-between items-start">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-orange-500 to-red-600 flex items-center justify-center text-white font-black text-xl shadow-lg shadow-orange-500/20">
                            ${u.name ? u.name.charAt(0).toUpperCase() : 'U'}
                        </div>
                        <div>
                            <h4 class="text-white font-black uppercase tracking-tighter">${u.name || 'Sem Nome'}</h4>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">${u.email}</p>
                        </div>
                    </div>
                    <div class="flex flex-col items-end gap-1">
                        <span class="badge ${u.role === 'admin' ? 'bg-red-500/20 text-red-500' : 'bg-orange-500/20 text-orange-500'} border-none uppercase text-[9px] font-black tracking-widest px-3 py-1 rounded-full">
                            ${u.role}
                        </span>
                        ${u.parentId ? `<span class="text-[8px] text-gray-600 font-bold uppercase tracking-widest">Sub-conta</span>` : ''}
                    </div>
                </div>
                
                <div class="grid grid-cols-2 gap-3 py-4 border-y border-white/5 my-2">
                    <div>
