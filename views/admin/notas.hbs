<!-- MODAL DE NOTA — Estilo Obsidian (título topo, toolbar, categorias) -->
<!-- ══════════════════════════════════════════════════════════════════ -->
<div id="quickNoteModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/70 backdrop-blur-sm" style="display:none;">
 <div class="w-full max-w-2xl mx-4 rounded-[8px] shadow-2xl overflow-hidden flex flex-col" style="background:#1a1a1a; border:1px solid rgba(255,255,255,0.08); max-height:85vh;">

  <!-- Título + Favorito + Fechar -->
  <div class="flex items-center gap-3 p-4 pb-2">
   <input type="hidden" id="noteEditId" value="">
   <input type="text" id="noteTitle" placeholder="Título da Nota" class="flex-1 bg-transparent text-lg font-black text-white placeholder-gray-600 focus:outline-none border-b border-white/10 pb-2">
   <button onclick="window.toggleNoteFavorite()" id="noteFavoriteBtn" class="w-8 h-8 rounded flex items-center justify-center text-gray-500 hover:text-amber-400 transition-colors" title="Favoritar">
    <span class="material-symbols-outlined text-lg" id="noteFavIcon">star_border</span>
   </button>
   <button onclick="window.closeQuickNoteModal()" class="w-8 h-8 rounded flex items-center justify-center text-gray-500 hover:text-red-400 transition-colors" title="Fechar">
    <span class="material-symbols-outlined text-lg">close</span>
   </button>
  </div>

  <!-- Toolbar (Obsidian-style) -->
  <div class="flex items-center gap-0.5 px-4 py-2 flex-wrap" style="border-bottom:1px solid rgba(255,255,255,0.06);">
   <button onclick="document.execCommand('bold')" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors" title="Negrito"><b class="text-sm">B</b></button>
   <button onclick="document.execCommand('italic')" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors" title="Itálico"><i class="text-sm">I</i></button>
   <button onclick="document.execCommand('underline')" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors" title="Sublinhado"><u class="text-sm">U</u></button>
   <button onclick="document.execCommand('strikeThrough')" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors" title="Tachado"><s class="text-sm">S</s></button>
   <div class="w-px h-5 bg-white/10 mx-1"></div>
   <button onclick="document.execCommand('insertUnorderedList')" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors" title="Lista"><span class="material-symbols-outlined text-sm">format_list_bulleted</span></button>
   <button onclick="document.execCommand('insertOrderedList')" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors" title="Lista numerada"><span class="material-symbols-outlined text-sm">format_list_numbered</span></button>
   <button onclick="window.insertChecklist()" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors" title="Checklist"><span class="material-symbols-outlined text-sm">checklist</span></button>
   <div class="w-px h-5 bg-white/10 mx-1"></div>
   <button onclick="document.execCommand('formatBlock','','blockquote')" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors" title="Citação"><span class="material-symbols-outlined text-sm">format_quote</span></button>
   <button onclick="document.execCommand('formatBlock','','h1')" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors text-[10px] font-black" title="H1">H1</button>
   <button onclick="document.execCommand('formatBlock','','h2')" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors text-[10px] font-black" title="H2">H2</button>
   <button onclick="document.execCommand('formatBlock','','h3')" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors text-[10px] font-black" title="H3">H3</button>
   <div class="w-px h-5 bg-white/10 mx-1"></div>
   <button onclick="window.insertLink()" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors" title="Link"><span class="material-symbols-outlined text-sm">link</span></button>
   <button onclick="document.execCommand('insertHorizontalRule')" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors" title="Divisor"><span class="material-symbols-outlined text-sm">horizontal_rule</span></button>
   <div class="w-px h-5 bg-white/10 mx-1"></div>
   <button onclick="document.execCommand('undo')" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors" title="Desfazer"><span class="material-symbols-outlined text-sm">undo</span></button>
   <button onclick="document.execCommand('redo')" class="w-8 h-8 rounded hover:bg-white/10 flex items-center justify-center text-gray-300 hover:text-white transition-colors" title="Refazer"><span class="material-symbols-outlined text-sm">redo</span></button>
  </div>

  <!-- Editor (contentEditable) -->
  <div id="noteContent" contenteditable="true" class="flex-1 min-h-[200px] max-h-[40vh] overflow-y-auto px-4 py-3 text-sm text-white focus:outline-none custom-scrollbar leading-relaxed" style="background:rgba(255,255,255,0.01);">
  </div>

  <!-- Categoria + Cor (inline, como no Obsidian) -->
  <div class="px-4 py-3 space-y-3" style="border-top:1px solid rgba(255,255,255,0.06);">
   <div class="flex flex-col sm:flex-row sm:items-start gap-4">
    <!-- Categorias (chips) -->
    <div class="flex-1">
     <label class="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-2">Categoria</label>
     <div class="flex flex-wrap gap-1.5" id="noteCategoryChips">
      <button onclick="window.setNoteCategory('Geral')" class="note-cat-chip px-2.5 py-1 rounded-full text-[9px] font-bold transition-all border border-white/20 text-white bg-white/10" data-cat="Geral">Geral</button>
      <button onclick="window.setNoteCategory('Trabalho')" class="note-cat-chip px-2.5 py-1 rounded-full text-[9px] font-bold transition-all border border-transparent text-gray-400 hover:border-white/20" data-cat="Trabalho">Trabalho</button>
      <button onclick="window.setNoteCategory('Pessoal')" class="note-cat-chip px-2.5 py-1 rounded-full text-[9px] font-bold transition-all border border-transparent text-gray-400 hover:border-white/20" data-cat="Pessoal">Pessoal</button>
      <button onclick="window.setNoteCategory('Ideias')" class="note-cat-chip px-2.5 py-1 rounded-full text-[9px] font-bold transition-all border border-transparent text-gray-400 hover:border-white/20" data-cat="Ideias">Ideias</button>
      <button onclick="window.setNoteCategory('Lembretes')" class="note-cat-chip px-2.5 py-1 rounded-full text-[9px] font-bold transition-all border border-transparent text-gray-400 hover:border-white/20" data-cat="Lembretes">Lembretes</button>
      <button onclick="window.setNoteCategory('Reuniões')" class="note-cat-chip px-2.5 py-1 rounded-full text-[9px] font-bold transition-all border border-transparent text-gray-400 hover:border-white/20" data-cat="Reuniões">Reuniões</button>
     </div>
    </div>
    <!-- Cores (circles) -->
    <div>
     <label class="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-2">Cor</label>
     <div class="flex items-center gap-2" id="noteColorPicker">
      <button onclick="window.setNoteColor('yellow')" class="note-color-btn w-7 h-7 rounded-full border-2 border-white/40 transition-all hover:scale-110" style="background:#fef9c3;" data-color="yellow"></button>
      <button onclick="window.setNoteColor('blue')" class="note-color-btn w-7 h-7 rounded-full border-2 border-transparent transition-all hover:scale-110" style="background:#bfdbfe;" data-color="blue"></button>
      <button onclick="window.setNoteColor('green')" class="note-color-btn w-7 h-7 rounded-full border-2 border-transparent transition-all hover:scale-110" style="background:#bbf7d0;" data-color="green"></button>
      <button onclick="window.setNoteColor('pink')" class="note-color-btn w-7 h-7 rounded-full border-2 border-transparent transition-all hover:scale-110" style="background:#fbcfe8;" data-color="pink"></button>
      <button onclick="window.setNoteColor('purple')" class="note-color-btn w-7 h-7 rounded-full border-2 border-transparent transition-all hover:scale-110" style="background:#e9d5ff;" data-color="purple"></button>
      <button onclick="window.setNoteColor('gray')" class="note-color-btn w-7 h-7 rounded-full border-2 border-transparent transition-all hover:scale-110" style="background:#e5e7eb;" data-color="gray"></button>
     </div>
    </div>
   </div>

   <!-- Tags -->
   <div>
    <label class="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1.5">Tags</label>
    <div class="flex items-center gap-2">
     <span class="text-gray-500 text-sm font-bold">#</span>
     <input type="text" id="noteTagInput" placeholder="Tag + Enter" onkeydown="if(event.key==='Enter'){event.preventDefault();window.addNoteTag();}" class="flex-1 px-3 py-1.5 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
    </div>
    <div class="flex flex-wrap gap-1.5 mt-2" id="noteTagsList"></div>
   </div>
  </div>

  <!-- Footer -->
  <div class="flex items-center justify-end gap-2 px-4 py-3" style="border-top:1px solid rgba(255,255,255,0.06);">
   <button onclick="window.closeQuickNoteModal()" class="px-4 py-2 text-xs font-bold text-gray-400 rounded-[4px] hover:bg-white/5 transition-colors">Cancelar</button>
   <button onclick="window.saveQuickNote()" class="flex items-center gap-1.5 px-4 py-2 text-xs font-black text-white bg-amber-500 hover:bg-amber-600 rounded-[4px] transition-colors">
    <span class="material-symbols-outlined text-sm">save</span> Salvar
   </button>
  </div>
 </div>
</div>

<!-- ══════════════════ JAVASCRIPT ══════════════════ -->
<script>
(function() {
  var STORAGE_KEY = 'malha3d_quick_notes';
  var currentFilter = 'all';
  var currentColor = 'yellow';
  var currentCategory = 'Geral';
  var currentTags = [];
  var currentFavorite = false;

  var DARK_BG = { yellow:'rgba(234,179,8,0.08)', blue:'rgba(59,130,246,0.08)', green:'rgba(34,197,94,0.08)', pink:'rgba(236,72,153,0.08)', purple:'rgba(168,85,247,0.08)', gray:'rgba(148,163,184,0.08)' };
  var TEMPLATES = {
    checklist: { title: 'Checklist', category: 'Trabalho', content: '<h3>✅ Checklist</h3><ul><li>☐ Item 1</li><li>☐ Item 2</li><li>☐ Item 3</li><li>☐ Item 4</li><li>☐ Item 5</li></ul>' },
    reuniao: { title: 'Reunião — ', category: 'Reuniões', content: '<h3>📋 Pauta</h3><ul><li>Ponto 1</li><li>Ponto 2</li></ul><h3>📝 Anotações</h3><p></p><h3>✅ Ações</h3><ul><li>☐ Responsável — Tarefa</li></ul>' },
    followup: { title: 'Follow-up — ', category: 'Trabalho', content: '<h3>👤 Cliente/Lead</h3><p>Nome:</p><h3>📞 Último Contato</h3><p>Data: | Meio: </p><h3>📋 Próximos Passos</h3><ul><li>☐ </li></ul><h3>⏰ Lembrete</h3><p>Retornar em: </p>' },
    producao: { title: 'Produção — ', category: 'Trabalho', content: '<h3>🎯 Projeto</h3><p>Nome: | Cliente: </p><h3>📐 Etapas</h3><ul><li>☐ Modelagem</li><li>☐ Texturização</li><li>☐ Iluminação</li><li>☐ Render</li><li>☐ Pós-produção</li></ul><h3>📝 Observações</h3><p></p>' }
  };

  function getNotes() { try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; } catch(e) { return []; } }
  function saveNotes(notes) { localStorage.setItem(STORAGE_KEY, JSON.stringify(notes)); }
  function genId() { return 'note_' + Date.now() + '_' + Math.random().toString(36).slice(2,8); }
  function stripHtml(html) { var d = document.createElement('div'); d.innerHTML = html; return d.textContent || ''; }
  function timeAgo(dateStr) {
    var d = new Date(dateStr), diff = Date.now() - d.getTime();
    var mins = Math.floor(diff/60000), hrs = Math.floor(diff/3600000), days = Math.floor(diff/86400000);
    if (mins < 1) return 'Agora'; if (mins < 60) return mins+'min'; if (hrs < 24) return hrs+'h'; if (days < 7) return days+'d';
    return d.toLocaleDateString('pt-BR', { day:'2-digit', month:'short' });
  }

  window.renderNotes = function() {
    var notes = getNotes();
    var query = (document.getElementById('notesSearchInput')?.value || '').toLowerCase();
    var filtered = notes;
    if (currentFilter === 'favoritos') filtered = filtered.filter(function(n) { return n.isFavorite; });
    else if (currentFilter !== 'all') filtered = filtered.filter(function(n) { return n.category === currentFilter; });
    if (query) filtered = filtered.filter(function(n) { return n.title.toLowerCase().includes(query) || stripHtml(n.content).toLowerCase().includes(query) || (n.tags||[]).some(function(t){return t.includes(query);}); });

    var grid = document.getElementById('notesGrid');
    var empty = document.getElementById('notesEmptyState');
    if (!grid) return;
    if (filtered.length === 0) { grid.innerHTML=''; if(empty){empty.classList.remove('hidden'); empty.style.display='flex';} return; }
    if (empty) { empty.classList.add('hidden'); empty.style.display='none'; }

    grid.innerHTML = filtered.map(function(n) {
      var bg = DARK_BG[n.color] || DARK_BG.yellow;
      var tagsHtml = (n.tags||[]).slice(0,3).map(function(t){return '<span class="text-[8px] font-bold text-gray-500 bg-white/5 px-1.5 py-0.5 rounded-full">#'+t+'</span>';}).join('');
      var preview = stripHtml(n.content).slice(0,100);
      return '<div class="group rounded-[5px] p-4 cursor-pointer transition-all hover:translate-y-[-2px] hover:shadow-lg" style="background:'+bg+'; border:1px solid rgba(255,255,255,0.06);" onclick="window.openNoteEdit(\''+n.id+'\')">' +
        '<div class="flex items-center justify-between mb-2"><span class="text-[8px] font-black uppercase tracking-widest text-gray-500 bg-black/10 px-1.5 py-0.5 rounded">'+n.category+'</span><button onclick="event.stopPropagation();window.toggleNoteFav(\''+n.id+'\')" class="'+(n.isFavorite?'text-amber-400':'text-gray-600 hover:text-amber-400')+' transition-colors"><span class="material-symbols-outlined text-sm">'+(n.isFavorite?'star':'star_border')+'</span></button></div>' +
        '<h4 class="text-xs font-bold text-white mb-1 truncate">'+n.title+'</h4>' +
        '<p class="text-[10px] text-gray-400 line-clamp-3 mb-2 leading-relaxed">'+preview+'</p>' +
        (tagsHtml?'<div class="flex flex-wrap gap-1 mb-2">'+tagsHtml+'</div>':'') +
        '<div class="flex items-center justify-between pt-2" style="border-top:1px solid rgba(255,255,255,0.04);"><span class="text-[9px] text-gray-500">'+timeAgo(n.updatedAt)+'</span><button onclick="event.stopPropagation();window.deleteQuickNote(\''+n.id+'\')" class="opacity-0 group-hover:opacity-100 w-6 h-6 rounded flex items-center justify-center text-gray-500 hover:text-red-400 transition-all"><span class="material-symbols-outlined text-sm">delete</span></button></div></div>';
    }).join('');
  };

  window.setNoteFilter = function(filter) {
    currentFilter = filter;
    document.querySelectorAll('.note-filter-btn').forEach(function(btn) {
      if (btn.getAttribute('data-filter') === filter) { btn.className = 'note-filter-btn px-3 py-1.5 rounded-[4px] text-[9px] font-black uppercase tracking-wider whitespace-nowrap transition-all bg-amber-500 text-white'; btn.removeAttribute('style'); }
      else { btn.className = 'note-filter-btn px-3 py-1.5 rounded-[4px] text-[9px] font-black uppercase tracking-wider whitespace-nowrap transition-all text-gray-400'; btn.setAttribute('style','background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);'); }
    });
    window.renderNotes();
  };

  window.openQuickNoteCreate = function() {
    document.getElementById('noteEditId').value = '';
    document.getElementById('noteTitle').value = '';
    document.getElementById('noteContent').innerHTML = '';
    currentColor='yellow'; currentCategory='Geral'; currentTags=[]; currentFavorite=false;
    window.setNoteColor('yellow'); window.setNoteCategory('Geral'); window.renderNoteTags(); window.updateFavBtn();
    var m = document.getElementById('quickNoteModal'); m.classList.remove('hidden'); m.style.display='flex';
    setTimeout(function(){document.getElementById('noteTitle').focus();},100);
  };

  window.openNoteFromTemplate = function(type) {
    var tpl = TEMPLATES[type]; if(!tpl) return;
    document.getElementById('templateDropdown').classList.add('hidden');
    document.getElementById('noteEditId').value = '';
    document.getElementById('noteTitle').value = tpl.title;
    document.getElementById('noteContent').innerHTML = tpl.content;
    currentColor='yellow'; currentCategory=tpl.category; currentTags=[]; currentFavorite=false;
    window.setNoteColor('yellow'); window.setNoteCategory(tpl.category); window.renderNoteTags(); window.updateFavBtn();
    var m = document.getElementById('quickNoteModal'); m.classList.remove('hidden'); m.style.display='flex';
    setTimeout(function(){document.getElementById('noteTitle').focus(); document.getElementById('noteTitle').select();},100);
  };

  window.openNoteEdit = function(id) {
    var notes = getNotes(); var note = notes.find(function(n){return n.id===id;});
    if(!note) return;
    document.getElementById('noteEditId').value = note.id;
    document.getElementById('noteTitle').value = note.title;
    document.getElementById('noteContent').innerHTML = note.content||'';
    currentColor=note.color||'yellow'; currentCategory=note.category||'Geral'; currentTags=note.tags?[...note.tags]:[]; currentFavorite=note.isFavorite||false;
    window.setNoteColor(currentColor); window.setNoteCategory(currentCategory); window.renderNoteTags(); window.updateFavBtn();
    var m = document.getElementById('quickNoteModal'); m.classList.remove('hidden'); m.style.display='flex';
  };

  window.closeQuickNoteModal = function() { var m = document.getElementById('quickNoteModal'); m.classList.add('hidden'); m.style.display='none'; };

  window.saveQuickNote = function() {
    var title = document.getElementById('noteTitle').value.trim();
    if(!title){document.getElementById('noteTitle').style.borderColor='rgba(239,68,68,0.5)';return;}
    document.getElementById('noteTitle').style.borderColor='';
    var content = document.getElementById('noteContent').innerHTML||'';
    var editId = document.getElementById('noteEditId').value;
    var notes = getNotes();
    if(editId) { notes=notes.map(function(n){return n.id===editId?Object.assign({},n,{title:title,content:content,category:currentCategory,color:currentColor,tags:currentTags,isFavorite:currentFavorite,updatedAt:new Date().toISOString()}):n;}); }
    else { notes.unshift({id:genId(),title:title,content:content,category:currentCategory,color:currentColor,tags:currentTags,isFavorite:currentFavorite,createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()}); }
    saveNotes(notes); window.closeQuickNoteModal(); window.renderNotes();
    if(window.showToast) window.showToast(editId?'Nota atualizada':'Nota criada','success');
  };

  window.deleteQuickNote = function(id) { if(!confirm('Excluir nota?'))return; saveNotes(getNotes().filter(function(n){return n.id!==id;})); window.renderNotes(); };
  window.toggleNoteFav = function(id) { var notes=getNotes().map(function(n){return n.id===id?Object.assign({},n,{isFavorite:!n.isFavorite,updatedAt:new Date().toISOString()}):n;}); saveNotes(notes); window.renderNotes(); };

  window.setNoteColor = function(color) { currentColor=color; document.querySelectorAll('.note-color-btn').forEach(function(btn){btn.style.borderColor=btn.getAttribute('data-color')===color?'rgba(255,255,255,0.5)':'transparent';}); };
  window.setNoteCategory = function(cat) { currentCategory=cat; document.querySelectorAll('.note-cat-chip').forEach(function(btn){ if(btn.getAttribute('data-cat')===cat){btn.className='note-cat-chip px-2.5 py-1 rounded-full text-[9px] font-bold transition-all border border-white/20 text-white bg-white/10';} else{btn.className='note-cat-chip px-2.5 py-1 rounded-full text-[9px] font-bold transition-all border border-transparent text-gray-400 hover:border-white/20';} }); };

  window.addNoteTag = function() { var input=document.getElementById('noteTagInput'); var tag=input.value.trim().toLowerCase(); if(tag&&!currentTags.includes(tag)){currentTags.push(tag);window.renderNoteTags();} input.value=''; };
  window.removeNoteTag = function(tag) { currentTags=currentTags.filter(function(t){return t!==tag;}); window.renderNoteTags(); };
  window.renderNoteTags = function() { var el=document.getElementById('noteTagsList'); if(!el)return; el.innerHTML=currentTags.map(function(t){return '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold text-amber-400" style="background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.2);">#'+t+' <button onclick="window.removeNoteTag(\''+t+'\')" class="hover:text-red-400 ml-0.5"><span class="material-symbols-outlined text-[9px]">close</span></button></span>';}).join(''); };

  window.toggleNoteFavorite = function() { currentFavorite=!currentFavorite; window.updateFavBtn(); };
  window.updateFavBtn = function() { var icon=document.getElementById('noteFavIcon'); if(currentFavorite){icon.textContent='star';icon.parentElement.className='w-8 h-8 rounded flex items-center justify-center text-amber-400 transition-colors';}else{icon.textContent='star_border';icon.parentElement.className='w-8 h-8 rounded flex items-center justify-center text-gray-500 hover:text-amber-400 transition-colors';} };

  window.insertChecklist = function() { document.execCommand('insertHTML', false, '<div class="checklist-item"><input type="checkbox" onclick="this.parentElement.classList.toggle(\'line-through\')"> <span contenteditable="true">Item</span></div>'); };
  window.insertLink = function() { var url = prompt('URL:'); if(url) document.execCommand('createLink', false, url); };

  // Close dropdown when clicking outside
  document.addEventListener('click', function(e) { if(!document.getElementById('templateDropdownWrapper')?.contains(e.target)) document.getElementById('templateDropdown')?.classList.add('hidden'); });
  document.addEventListener('keydown', function(e) { if(e.key==='Escape'){var m=document.getElementById('quickNoteModal'); if(m&&m.style.display==='flex') window.closeQuickNoteModal();} });

  // Initial render
  if(document.getElementById('notesGrid')) window.renderNotes();
})();
</script>

<style>
#noteContent h1 { font-size: 1.5rem; font-weight: 900; margin: 8px 0; }
#noteContent h2 { font-size: 1.2rem; font-weight: 800; margin: 6px 0; }
#noteContent h3 { font-size: 1rem; font-weight: 700; margin: 4px 0; color: #f59e0b; }
#noteContent blockquote { border-left: 3px solid #f59e0b; padding-left: 12px; margin: 8px 0; color: #9ca3af; font-style: italic; }
#noteContent ul, #noteContent ol { padding-left: 20px; margin: 4px 0; }
#noteContent li { margin: 2px 0; }
#noteContent a { color: #60a5fa; text-decoration: underline; }
#noteContent hr { border: none; border-top: 1px solid rgba(255,255,255,0.1); margin: 12px 0; }
.checklist-item { display: flex; align-items: center; gap: 8px; padding: 2px 0; }
.checklist-item input[type="checkbox"] { accent-color: #f59e0b; width: 16px; height: 16px; }
.line-through span { text-decoration: line-through; color: #6b7280; }
</style>
