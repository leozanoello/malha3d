<!-- Notas — Inspirado no Obsidian + Templates -->
<div class="space-y-4">

 <!-- Header com Templates + Nova Nota -->
 <div class="kcard p-4">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
   <div class="flex items-center gap-2.5">
    <div class="w-9 h-9 rounded-[5px] bg-amber-500/15 border border-amber-500/20 flex items-center justify-center">
     <span class="material-symbols-outlined text-amber-400 text-lg">sticky_note_2</span>
    </div>
    <div>
     <h1 class="text-sm font-black text-white tracking-tight">Notas <span class="text-amber-400">Rápidas</span></h1>
     <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest">Organize ideias, lembretes e anotações</p>
    </div>
   </div>
   <div class="flex items-center gap-2">
    <!-- Templates Dropdown -->
    <div class="relative" id="templateDropdownWrapper">
     <button onclick="document.getElementById('templateDropdown').classList.toggle('hidden')" class="flex items-center gap-1.5 px-3 py-2 rounded-[4px] text-[8px] font-black uppercase tracking-wider text-white transition-all" style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1);">
      <span class="material-symbols-outlined text-[12px]">dashboard_customize</span> Templates
     </button>
     <div id="templateDropdown" class="hidden absolute right-0 top-full mt-1 z-50 w-48 rounded-[5px] shadow-2xl overflow-hidden" style="background:#1a1a1a; border:1px solid rgba(255,255,255,0.1);">
      <button onclick="window.openNoteFromTemplate('checklist')" class="w-full flex items-center gap-2.5 px-4 py-2.5 text-xs font-bold text-white hover:bg-white/5 transition-colors text-left">
       <span class="material-symbols-outlined text-amber-400 text-sm">checklist</span> Checklist
      </button>
      <button onclick="window.openNoteFromTemplate('reuniao')" class="w-full flex items-center gap-2.5 px-4 py-2.5 text-xs font-bold text-white hover:bg-white/5 transition-colors text-left">
       <span class="material-symbols-outlined text-purple-400 text-sm">groups</span> Reunião
      </button>
      <button onclick="window.openNoteFromTemplate('followup')" class="w-full flex items-center gap-2.5 px-4 py-2.5 text-xs font-bold text-white hover:bg-white/5 transition-colors text-left">
       <span class="material-symbols-outlined text-emerald-400 text-sm">follow_the_signs</span> Follow-up
      </button>
      <button onclick="window.openNoteFromTemplate('producao')" class="w-full flex items-center gap-2.5 px-4 py-2.5 text-xs font-bold text-white hover:bg-white/5 transition-colors text-left">
       <span class="material-symbols-outlined text-sky-400 text-sm">precision_manufacturing</span> Produção
      </button>
     </div>
    </div>
    <!-- Nova Nota -->
    <button onclick="window.openQuickNoteCreate()" class="flex items-center gap-1.5 px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white text-[8px] font-black uppercase tracking-wider rounded-[4px] shadow-sm transition-all">
     <span class="material-symbols-outlined text-[11px]">add</span> Nova Nota
    </button>
   </div>
  </div>
 </div>

 <!-- Filtros (chips) -->
 <div class="flex items-center gap-1.5 overflow-x-auto pb-1" id="notesFilterBar">
  <button onclick="window.setNoteFilter('all')" class="note-filter-btn px-3 py-1.5 rounded-[4px] text-[9px] font-black uppercase tracking-wider whitespace-nowrap transition-all bg-amber-500 text-white" data-filter="all">Todas</button>
  <button onclick="window.setNoteFilter('Geral')" class="note-filter-btn px-3 py-1.5 rounded-[4px] text-[9px] font-black uppercase tracking-wider whitespace-nowrap transition-all text-gray-400" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" data-filter="Geral">Geral</button>
  <button onclick="window.setNoteFilter('Trabalho')" class="note-filter-btn px-3 py-1.5 rounded-[4px] text-[9px] font-black uppercase tracking-wider whitespace-nowrap transition-all text-gray-400" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" data-filter="Trabalho">Trabalho</button>
  <button onclick="window.setNoteFilter('Pessoal')" class="note-filter-btn px-3 py-1.5 rounded-[4px] text-[9px] font-black uppercase tracking-wider whitespace-nowrap transition-all text-gray-400" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" data-filter="Pessoal">Pessoal</button>
  <button onclick="window.setNoteFilter('Ideias')" class="note-filter-btn px-3 py-1.5 rounded-[4px] text-[9px] font-black uppercase tracking-wider whitespace-nowrap transition-all text-gray-400" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" data-filter="Ideias">Ideias</button>
  <button onclick="window.setNoteFilter('Lembretes')" class="note-filter-btn px-3 py-1.5 rounded-[4px] text-[9px] font-black uppercase tracking-wider whitespace-nowrap transition-all text-gray-400" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" data-filter="Lembretes">Lembretes</button>
  <button onclick="window.setNoteFilter('Reuniões')" class="note-filter-btn px-3 py-1.5 rounded-[4px] text-[9px] font-black uppercase tracking-wider whitespace-nowrap transition-all text-gray-400" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" data-filter="Reuniões">Reuniões</button>
  <button onclick="window.setNoteFilter('favoritos')" class="note-filter-btn px-3 py-1.5 rounded-[4px] text-[9px] font-black uppercase tracking-wider whitespace-nowrap transition-all text-gray-400" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" data-filter="favoritos">⭐ Favoritos</button>
 </div>

 <!-- Busca -->
 <div class="relative">
  <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-[13px] pointer-events-none">search</span>
  <input type="text" id="notesSearchInput" placeholder="Buscar notas..." oninput="window.renderNotes()" class="w-full pl-9 pr-4 py-2 text-xs font-bold text-white placeholder-gray-500 rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
 </div>

 <!-- Grid de Notas -->
 <div id="notesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3"></div>

 <!-- Empty State -->
 <div id="notesEmptyState" class="hidden flex-col items-center justify-center py-16 text-center">
  <div class="w-16 h-16 rounded-full flex items-center justify-center mb-4" style="background:rgba(255,255,255,0.03);">
   <span class="material-symbols-outlined text-3xl text-gray-600">note_stack</span>
  </div>
  <h3 class="text-sm font-bold text-gray-400 mb-1">Nenhuma nota criada</h3>
  <p class="text-xs text-gray-500 max-w-xs">Use "Nova Nota" ou "Templates" para começar.</p>
 </div>
</div>

