<script>
(function() {
  const STORAGE_KEY = 'malha3d_learning_progress';
  const MODULE = 'crm';
  const TOTAL = 7;

  function getProgress() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch(e) { return {}; }
  }

  function saveProgress(data) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); } catch(e) {}
  }

  window.goStep = function(n) {
    if (n < 1 || n > TOTAL) {
      if (n > TOTAL) window.location.href = '/admin/aprendizado/projetos';
      return;
    }
    document.querySelectorAll('.lesson-step').forEach(function(s) { s.classList.add('hidden'); });
    var target = document.querySelector('.lesson-step[data-step="' + n + '"]');
    if (target) target.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  window.markComplete = function(module, step) {
    var data = getProgress();
    if (!data[module]) data[module] = [];
    if (data[module].indexOf(step) === -1) data[module].push(step);
    saveProgress(data);
    updateHeader();
  };

  window.loadProgress = function() {
    var data = getProgress();
    var completed = data[MODULE] || [];
    document.querySelectorAll('.crm-completion').forEach(function(cb) {
      var step = parseInt(cb.dataset.step, 10);
      if (completed.indexOf(step) !== -1) cb.checked = true;
    });
    updateHeader();
  };

  function updateHeader() {
    var data = getProgress();
    var done = (data[MODULE] || []).length;
    var pct = Math.round((Math.min(done, TOTAL) / TOTAL) * 100);
    var bar = document.getElementById('crmProgressBar');
    var label = document.getElementById('crmProgressLabel');
    if (bar) bar.style.width = pct + '%';
    if (label) label.textContent = Math.min(done, TOTAL) + ' de ' + TOTAL + ' concluídas';
  }

  // Init: show step 1 or last visited
  var savedStep = parseInt(sessionStorage.getItem('crm_current_step') || '1', 10);
  if (isNaN(savedStep) || savedStep < 1) savedStep = 1;
  if (savedStep > TOTAL) savedStep = TOTAL;

  document.querySelectorAll('.lesson-step').forEach(function(s) { s.classList.add('hidden'); });
  var initial = document.querySelector('.lesson-step[data-step="' + savedStep + '"]');
  if (initial) initial.classList.remove('hidden');

  loadProgress();

  // Save current step when navigating
  document.querySelectorAll('[onclick^="goStep"]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var match = btn.getAttribute('onclick').match(/goStep\((\d+)\)/);
      if (match) sessionStorage.setItem('crm_current_step', match[1]);
    });
  });
})();
</script>