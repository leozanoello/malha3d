</div>

<style>
/* === UIVERSE CARD (Glow Border Animation — Template Oficial) === */
.uv-card {
 position: relative;
 overflow: hidden;
 border-radius: 5px;
 box-shadow: 0px 0px 10px 1px #000000ee;
 padding: 2px;
 background: #151515;
}
.uv-card .uv-glow {
 position: absolute;
 inset: 0;
 display: flex;
 align-items: center;
 justify-content: center;
 overflow: hidden;
 border-radius: 5px;
}
.uv-card .uv-glow::before {
 content: '';
 position: absolute;
 width: 120px;
 height: 200%;
 background: linear-gradient(90deg, transparent, #ff9966, #ff9966, transparent);
 animation: uv-rotation 5000ms infinite linear;
 opacity: 0.35;
}
.uv-card:hover .uv-glow::before {
 opacity: 0.8;
}
@keyframes uv-rotation {
 0% { transform: rotateZ(0deg); }
 100% { transform: rotateZ(360deg); }
}
.uv-card .uv-inner {
 position: relative;
 width: 100%;
 background: #151515;
 border-radius: 4px;
 padding: 14px 16px;
 display: flex;
 flex-direction: column;
 gap: 4px;
 z-index: 1;
}
.uv-card-highlight .uv-glow::before {
 opacity: 0.7;
 width: 180px;
}
.uv-label {
 font-size: 8px;
 font-weight: 700;
 text-transform: uppercase;
 letter-spacing: 0.1em;
}
.uv-value {
 font-size: 16px;
 font-weight: 900;
 color: #fff;
 letter-spacing: -0.02em;
}

/* Light mode */
body.theme-light .uv-card { background: #fff; box-shadow: 0 1px 6px rgba(15,23,42,0.1); }
body.theme-light .uv-card .uv-inner { background: #fff; }
body.theme-light .uv-card .uv-glow::before { background: linear-gradient(90deg, transparent, #f97316, #f97316, transparent); opacity: 0.15; }
body.theme-light .uv-value { color: #0f172a; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
 var chartsData = {{{json charts}}};

 // Forecast Chart (3 barras por mês: mínima, média, máxima)
 var ctxForecast = document.getElementById('forecastChart');
 if (ctxForecast && chartsData.funnel) {
  new Chart(ctxForecast.getContext('2d'), {
   type: 'bar',
   data: {
    labels: chartsData.funnel.labels,
    datasets: [
     { label: 'Mínima (Pessimista)', data: chartsData.funnel.weighted.map(function(v) { return v * 0.5; }), backgroundColor: 'rgba(244,114,182,0.7)', borderRadius: 4 },
     { label: 'Média (Realista)', data: chartsData.funnel.weighted, backgroundColor: 'rgba(249,115,22,0.8)', borderRadius: 4 },
     { label: 'Máxima (Otimista)', data: chartsData.funnel.raw, backgroundColor: 'rgba(16,185,129,0.7)', borderRadius: 4 }
    ]
   },
   options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
     legend: { position: 'top', align: 'center', labels: { color: '#9ca3af', font: { size: 9, weight: 'bold' }, usePointStyle: true, pointStyle: 'rect', padding: 16 } }
    },
    scales: {
     y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#6b7280', font: { size: 9 }, callback: function(v) { return 'R$ ' + (v/1000).toFixed(0) + 'k'; } } },
     x: { grid: { display: false }, ticks: { color: '#9ca3af', font: { size: 10, weight: 'bold' } } }
    }
   }
  });
 }

 // Win Rate
 var ctxWin = document.getElementById('winRateChart');
 if (ctxWin && chartsData.winRate) {
  new Chart(ctxWin.getContext('2d'), {
   type: 'doughnut',
   data: { labels: chartsData.winRate.labels, datasets: [{ data: chartsData.winRate.data, backgroundColor: ['#10b981', '#ef4444'], borderWidth: 0 }] },
   options: { responsive: true, maintainAspectRatio: false, cutout: '70%', plugins: { legend: { position: 'bottom', labels: { color: '#9ca3af', font: { size: 9 } } } } }
  });
 }

 // Loss Reasons
 var ctxLoss = document.getElementById('lossReasonsChart');
 if (ctxLoss && chartsData.lossReasons && chartsData.lossReasons.labels.length > 0) {
  new Chart(ctxLoss.getContext('2d'), {
   type: 'bar',
   data: { labels: chartsData.lossReasons.labels, datasets: [{ data: chartsData.lossReasons.data, backgroundColor: 'rgba(239,68,68,0.3)', borderColor: '#ef4444', borderWidth: 1, borderRadius: 4 }] },
   options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#6b7280', font: { size: 9 } } }, y: { grid: { display: false }, ticks: { color: '#9ca3af', font: { size: 9, weight: 'bold' } } } } }
  });
 }
});
</script>

</div>