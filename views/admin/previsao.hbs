 <div class="uv-inner" style="padding:20px;">
 <h4 class="text-[10px] font-black text-white uppercase tracking-[0.15em] mb-3">Win Rate — Mês Atual</h4>
 <canvas id="winRateChart" height="140"></canvas>
 </div>
 </div>
 <div class="uv-card">
