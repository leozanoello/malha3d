 </button>
 <div id="dd-{{this.id}}" class="hidden absolute right-0 top-full mt-1 w-52 border-white/10 rounded-[5px] shadow-2xl z-[9999] py-2">
 <button class="w-full px-4 py-2.5 text-left text-xs text-gray-300 hover:bg-white/5 hover:text-white flex items-center gap-3 transition-colors user-action" data-action="analytics" data-user-id="{{this.id}}" data-user-name="{{this.name}}">
 <span class="material-symbols-outlined text-sm text-indigo-400">analytics</span> Ver Relatório
 </button>
 <button class="w-full px-4 py-2.5 text-left text-xs text-gray-300 hover:bg-white/5 hover:text-white flex items-center gap-3 transition-colors user-action" data-action="reset-password" data-user-id="{{this.id}}" data-user-name="{{this.name}}">
 <span class="material-symbols-outlined text-sm text-orange-400">lock_reset</span> Alterar Senha
 </button>
