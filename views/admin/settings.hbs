 <div class="flex items-center gap-4 cursor-pointer" data-user-id="{{this.id}}" data-user-name="{{this.name}}">
 <div class="w-10 h-10 rounded-[5px] bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-500 font-black">
 {{firstLetter this.name}}
 </div>
 <div>
 <p class="text-[13px] font-black text-white uppercase">{{this.name}}</p>
 <p class="text-[10px] text-gray-500 font-bold tracking-widest">{{this.email}}</p>
 {{#if this.jobTitle}}<p class="text-[9px] text-indigo-400 font-bold mt-0.5">{{this.jobTitle}}</p>{{/if}}
 </div>
