 <span class="text-sm font-bold text-gray-500">R$</span>
 <input type="number" step="0.01" name="calculator_base_price_tour" id="calculator_base_price_tour" class="w-full bg-black/20 border border-white/10 rounded-[5px] px-4 py-3 text-sm text-gray-300 focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500/50 transition-all" placeholder="800.00">
