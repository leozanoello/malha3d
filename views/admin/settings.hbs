<!--
 MALHA 3D — CONFIGURAÇÕES DO SISTEMA
 Design: Template Padrão (.kcard, #151515, 5px radius)
-->

<!-- HEADER -->
<div class="flex items-center justify-between mb-6">
 <div class="flex items-center gap-3">
  <div class="w-9 h-9 rounded-md bg-orange-500/10 border border-orange-500/20 flex items-center justify-center">
   <span class="material-symbols-outlined text-orange-400 text-lg">settings</span>
  </div>
  <div>
   <h1 class="text-xl font-black text-white tracking-tight">Configurações do Sistema</h1>
   <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest">Preferências, APIs, Segurança & Equipe</p>
  </div>
 </div>
</div>

<!-- LAYOUT 2 COLUNAS: SIDEBAR TABS + CONTEÚDO -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-5">

 <!-- SIDEBAR DE TABS -->
 <div class="lg:col-span-3">
  <div class="kcard">
   <div class="kcard-body" style="padding:12px;">
    <nav class="flex flex-col gap-1">
     <button data-tab="general" class="tab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-[9px] font-black uppercase tracking-wider text-gray-400 hover:text-white hover:bg-white/5 transition-all text-left">
      <span class="material-symbols-outlined text-sm">tune</span> Geral
     </button>
     <button data-tab="api" class="tab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-[9px] font-black uppercase tracking-wider text-gray-400 hover:text-white hover:bg-white/5 transition-all text-left">
      <span class="material-symbols-outlined text-sm">key</span> Integrações & API
     </button>
     <button data-tab="security" class="tab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-[9px] font-black uppercase tracking-wider text-gray-400 hover:text-white hover:bg-white/5 transition-all text-left">
      <span class="material-symbols-outlined text-sm">security</span> Segurança
     </button>
     <button data-tab="notifications" class="tab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-[9px] font-black uppercase tracking-wider text-gray-400 hover:text-white hover:bg-white/5 transition-all text-left">
      <span class="material-symbols-outlined text-sm">notifications</span> Notificações
     </button>
     <button data-tab="backup" class="tab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-[9px] font-black uppercase tracking-wider text-gray-400 hover:text-white hover:bg-white/5 transition-all text-left">
      <span class="material-symbols-outlined text-sm">database</span> Backup & Dados
     </button>
     <button data-tab="calculator" class="tab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-[9px] font-black uppercase tracking-wider text-gray-400 hover:text-white hover:bg-white/5 transition-all text-left">
      <span class="material-symbols-outlined text-sm">calculate</span> Calculadora
     </button>
     <button data-tab="team" class="tab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-[9px] font-black uppercase tracking-wider text-gray-400 hover:text-white hover:bg-white/5 transition-all text-left">
      <span class="material-symbols-outlined text-sm">group</span> Equipe
     </button>
     <button data-tab="cicd" class="tab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-[9px] font-black uppercase tracking-wider text-gray-400 hover:text-white hover:bg-white/5 transition-all text-left">
      <span class="material-symbols-outlined text-sm">admin_panel_settings</span> Master
     </button>
    </nav>
   </div>
  </div>
 </div>

 <!-- CONTEÚDO DAS TABS -->
 <div class="lg:col-span-9 space-y-5">

  <!-- ═══════ TAB: GERAL ═══════ -->
  <div id="tab-general" class="settings-pane space-y-4">
   <div class="kcard">
    <div class="kcard-body" style="padding:24px;">
     <h3 class="text-sm font-black text-white mb-5 flex items-center gap-2">
      <span class="material-symbols-outlined text-orange-500 text-base">tune</span> Preferências Globais
     </h3>
     <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-[5px]" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <label class="block text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Idioma Padrão</label>
       <select class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
        <option>Português (Brasil)</option>
        <option>English (US)</option>
        <option>Español</option>
       </select>
      </div>
      <div class="p-4 rounded-[5px]" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <label class="block text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Moeda</label>
       <select class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
        <option>BRL (R$)</option>
        <option>USD ($)</option>
        <option>EUR (€)</option>
       </select>
      </div>
      <div class="p-4 rounded-[5px]" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <label class="block text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Fuso Horário</label>
       <select class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
        <option>America/Sao_Paulo (UTC-3)</option>
        <option>America/New_York (UTC-5)</option>
       </select>
      </div>
      <div class="p-4 rounded-[5px]" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <label class="block text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Nome da Empresa</label>
       <input type="text" value="Malha 3D" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
      </div>
     </div>
     <div class="mt-5 flex justify-end">
      <button class="flex items-center gap-1.5 px-4 py-2 rounded-md bg-orange-500 text-[8px] font-black uppercase tracking-wider text-white hover:bg-orange-600 transition-colors">
       <span class="material-symbols-outlined text-[11px]">save</span> Salvar
      </button>
     </div>
    </div>
   </div>
  </div>

  <!-- ═══════ TAB: API ═══════ -->
  <div id="tab-api" class="settings-pane hidden space-y-4">
   <div class="kcard">
    <div class="kcard-body" style="padding:24px;">
     <div class="flex items-center justify-between mb-5">
      <h3 class="text-sm font-black text-white flex items-center gap-2">
       <span class="material-symbols-outlined text-orange-500 text-base">key</span> Chaves de API & Integrações
      </h3>
      <button id="btn-gerar-chave" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-orange-500 text-[8px] font-black uppercase tracking-wider text-white hover:bg-orange-600 transition-colors">
       <span class="material-symbols-outlined text-[11px]">add</span> Gerar Chave
      </button>
     </div>

     <!-- Tabela de Chaves -->
     <div class="mb-5">
      <h5 class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-3">Chaves Ativas</h5>
      <div id="api-keys-table" class="space-y-2">
       <p class="text-[10px] text-gray-500 text-center py-4">Carregando chaves...</p>
      </div>
     </div>

     <!-- Integrações -->
     <h5 class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-3">Conexões Externas</h5>
     <div class="space-y-3">
      <div class="p-4 rounded-[5px] flex items-center justify-between" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-md bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center">
         <span class="material-symbols-outlined text-emerald-400 text-sm">storage</span>
        </div>
        <div>
         <p class="text-xs font-bold text-white">Supabase</p>
         <p class="text-[8px] text-gray-500">Banco de dados e autenticação</p>
        </div>
       </div>
       <span class="text-[7px] font-black uppercase tracking-widest px-2 py-1 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Ativo</span>
      </div>
      <div class="p-4 rounded-[5px] flex items-center justify-between" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-md bg-purple-500/10 border border-purple-500/20 flex items-center justify-center">
         <span class="material-symbols-outlined text-purple-400 text-sm">smart_toy</span>
        </div>
        <div>
         <p class="text-xs font-bold text-white">OpenAI / Gemini</p>
         <p class="text-[8px] text-gray-500">IA para relatórios e insights</p>
        </div>
       </div>
       <span class="text-[7px] font-black uppercase tracking-widest px-2 py-1 rounded-md bg-gray-500/10 text-gray-400 border border-gray-500/20">Não Config.</span>
      </div>
     </div>
    </div>
   </div>
  </div>

  <!-- ═══════ TAB: SEGURANÇA ═══════ -->
  <div id="tab-security" class="settings-pane hidden space-y-4">
   <div class="kcard">
    <div class="kcard-body" style="padding:24px;">
     <h3 class="text-sm font-black text-white mb-5 flex items-center gap-2">
      <span class="material-symbols-outlined text-orange-500 text-base">security</span> Segurança e Acesso
     </h3>
     <div class="space-y-3">
      <div class="p-4 rounded-[5px] flex items-center justify-between" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <div>
        <p class="text-xs font-bold text-white">Autenticação 2FA</p>
        <p class="text-[8px] text-gray-500">Camada extra de segurança</p>
       </div>
       <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" class="sr-only peer" checked>
        <div class="w-9 h-5 bg-gray-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-orange-500"></div>
       </label>
      </div>
      <div class="p-4 rounded-[5px] flex items-center justify-between" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <div>
        <p class="text-xs font-bold text-white">Timeout de Sessão</p>
        <p class="text-[8px] text-gray-500">Tempo máximo sem atividade</p>
       </div>
       <select class="px-3 py-1.5 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
        <option>24 horas</option>
        <option>12 horas</option>
        <option>8 horas</option>
        <option>1 hora</option>
       </select>
      </div>
      <div class="p-4 rounded-[5px] flex items-center justify-between" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <div>
        <p class="text-xs font-bold text-white">Sessões Ativas</p>
        <p class="text-[8px] text-gray-500">Gerencie dispositivos conectados</p>
       </div>
       <button class="text-[8px] font-black text-orange-400 uppercase tracking-wider hover:text-orange-300">Ver Todos →</button>
      </div>
     </div>
    </div>
   </div>
  </div>

  <!-- ═══════ TAB: NOTIFICAÇÕES ═══════ -->
  <div id="tab-notifications" class="settings-pane hidden space-y-4">
   <div class="kcard">
    <div class="kcard-body" style="padding:24px;">
     <h3 class="text-sm font-black text-white mb-5 flex items-center gap-2">
      <span class="material-symbols-outlined text-orange-500 text-base">notifications</span> Preferências de Notificação
     </h3>
     <div class="space-y-3">
      <div class="p-4 rounded-[5px] flex items-center justify-between" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <div>
        <p class="text-xs font-bold text-white">Novo Lead</p>
        <p class="text-[8px] text-gray-500">Notificar quando entrar lead no CRM</p>
       </div>
       <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" class="sr-only peer" checked>
        <div class="w-9 h-5 bg-gray-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-orange-500"></div>
       </label>
      </div>
      <div class="p-4 rounded-[5px] flex items-center justify-between" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <div>
        <p class="text-xs font-bold text-white">Pagamento Recebido</p>
        <p class="text-[8px] text-gray-500">Aviso de recebimento financeiro</p>
       </div>
       <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" class="sr-only peer" checked>
        <div class="w-9 h-5 bg-gray-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-orange-500"></div>
       </label>
      </div>
      <div class="p-4 rounded-[5px] flex items-center justify-between" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <div>
        <p class="text-xs font-bold text-white">Projeto Atrasado</p>
        <p class="text-[8px] text-gray-500">Alertar sobre prazos vencidos</p>
       </div>
       <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" class="sr-only peer" checked>
        <div class="w-9 h-5 bg-gray-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-orange-500"></div>
       </label>
      </div>
      <div class="p-4 rounded-[5px] flex items-center justify-between" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <div>
        <p class="text-xs font-bold text-white">Chat da Equipe</p>
        <p class="text-[8px] text-gray-500">Mensagens no chat interno</p>
       </div>
       <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" class="sr-only peer">
        <div class="w-9 h-5 bg-gray-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-orange-500"></div>
       </label>
      </div>
     </div>
    </div>
   </div>
  </div>

  <!-- ═══════ TAB: BACKUP ═══════ -->
  <div id="tab-backup" class="settings-pane hidden space-y-4">
   <div class="kcard">
    <div class="kcard-body" style="padding:24px;">
     <h3 class="text-sm font-black text-white mb-5 flex items-center gap-2">
      <span class="material-symbols-outlined text-orange-500 text-base">database</span> Backup & Dados
     </h3>
     <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-[5px]" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <p class="text-[7px] font-black text-gray-500 uppercase tracking-widest mb-1">Último Backup</p>
       <p class="text-sm font-black text-white">Hoje, 03:00</p>
       <p class="text-[8px] text-gray-500 mt-1">Automático (diário)</p>
      </div>
      <div class="p-4 rounded-[5px]" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <p class="text-[7px] font-black text-gray-500 uppercase tracking-widest mb-1">Tamanho do Banco</p>
       <p class="text-sm font-black text-white">42 MB</p>
       <p class="text-[8px] text-gray-500 mt-1">PostgreSQL (Supabase)</p>
      </div>
     </div>
     <div class="mt-4 flex gap-2">
      <button class="flex items-center gap-1.5 px-4 py-2 rounded-md bg-orange-500 text-[8px] font-black uppercase tracking-wider text-white hover:bg-orange-600 transition-colors">
       <span class="material-symbols-outlined text-[11px]">download</span> Exportar Backup
      </button>
      <button class="flex items-center gap-1.5 px-4 py-2 rounded-md text-[8px] font-black uppercase tracking-wider text-gray-400 hover:text-white transition-colors" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
       <span class="material-symbols-outlined text-[11px]">upload</span> Importar
      </button>
     </div>
    </div>
   </div>
  </div>

  <!-- ═══════ TAB: CALCULADORA ═══════ -->
  <div id="tab-calculator" class="settings-pane hidden space-y-4">
   <div class="kcard">
    <div class="kcard-body" style="padding:24px;">
     <h3 class="text-sm font-black text-white mb-5 flex items-center gap-2">
      <span class="material-symbols-outlined text-orange-500 text-base">calculate</span> Calibração da Calculadora
     </h3>
     <form id="calculatorSettingsForm" class="space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
       <div class="p-4 rounded-[5px]" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
        <label class="block text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Preço Base /m²</label>
        <input type="number" step="0.01" name="calculator_base_price_m2" id="calculator_base_price_m2" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" placeholder="80.00">
       </div>
       <div class="p-4 rounded-[5px]" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
        <label class="block text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Preço Base /Imagem</label>
        <input type="number" step="0.01" name="calculator_base_price_image" id="calculator_base_price_image" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" placeholder="350.00">
       </div>
       <div class="p-4 rounded-[5px]" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
        <label class="block text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Preço Animação /seg</label>
        <input type="number" step="0.01" name="calculator_base_price_animation" id="calculator_base_price_animation" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" placeholder="250.00">
       </div>
       <div class="p-4 rounded-[5px]" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
        <label class="block text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Preço Tour Virtual</label>
        <input type="number" step="0.01" name="calculator_base_price_tour" id="calculator_base_price_tour" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" placeholder="500.00">
       </div>
       <div class="p-4 rounded-[5px]" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
        <label class="block text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Preço /Ambiente</label>
        <input type="number" step="0.01" name="calculator_base_price_environment" id="calculator_base_price_environment" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" placeholder="120.00">
       </div>
       <div class="p-4 rounded-[5px]" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
        <label class="block text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Gemini API Key</label>
        <input type="password" name="gemini_api_key" id="gemini_api_key" class="w-full px-3 py-2 text-xs text-white rounded-[4px] font-mono" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" placeholder="AIza...">
       </div>
      </div>
      <div class="flex justify-end">
       <button type="submit" id="btnSaveCalculatorSettings" class="flex items-center gap-1.5 px-4 py-2 rounded-md bg-orange-500 text-[8px] font-black uppercase tracking-wider text-white hover:bg-orange-600 transition-colors">
        <span class="material-symbols-outlined text-[11px]">save</span> Salvar Calibração
       </button>
      </div>
     </form>
    </div>
   </div>
  </div>

  <!-- ═══════ TAB: EQUIPE ═══════ -->
  <div id="tab-team" class="settings-pane hidden space-y-4">
   <div class="kcard">
    <div class="kcard-body" style="padding:24px;">
     <div class="flex items-center justify-between mb-5">
      <h3 class="text-sm font-black text-white flex items-center gap-2">
       <span class="material-symbols-outlined text-orange-500 text-base">group</span> Equipe
      </h3>
      <button onclick="window.location.href='/admin/register'" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-orange-500 text-[8px] font-black uppercase tracking-wider text-white hover:bg-orange-600 transition-colors">
       <span class="material-symbols-outlined text-[11px]">person_add</span> Novo Membro
      </button>
     </div>
     <div id="team-list" class="space-y-2">
      {{#each teamMembers}}
      <div class="p-3 rounded-[5px] flex items-center justify-between" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-md bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-[9px] font-black text-orange-400">
         {{firstLetter this.name}}
        </div>
        <div>
         <p class="text-xs font-bold text-white">{{this.name}}</p>
         <p class="text-[8px] text-gray-500">{{this.email}} — {{this.role}}</p>
        </div>
       </div>
       <div class="flex items-center gap-2">
        <span class="text-[7px] font-black uppercase tracking-widest px-2 py-1 rounded-md {{#if (eq this.role 'admin')}}bg-orange-500/10 text-orange-400 border border-orange-500/20{{else}}bg-white/5 text-gray-400 border border-white/10{{/if}}">{{this.role}}</span>
        <button class="dropdown-trigger w-6 h-6 rounded-md bg-white/5 border border-white/10 flex items-center justify-center hover:bg-white/10 transition-colors" data-user-id="{{this.id}}">
         <span class="material-symbols-outlined text-[10px] text-gray-400">more_vert</span>
        </button>
        <div id="dd-{{this.id}}" class="hidden absolute right-0 mt-24 w-40 rounded-md shadow-lg z-50" style="background:#151515; border:1px solid rgba(255,255,255,0.1);">
         <button class="user-action w-full text-left px-3 py-2 text-[9px] text-gray-300 hover:bg-white/5" data-action="analytics" data-user-id="{{this.id}}" data-user-name="{{this.name}}">📊 Relatório</button>
         <button class="user-action w-full text-left px-3 py-2 text-[9px] text-gray-300 hover:bg-white/5" data-action="reset-password" data-user-id="{{this.id}}" data-user-name="{{this.name}}">🔑 Resetar Senha</button>
         <button class="user-action w-full text-left px-3 py-2 text-[9px] text-red-400 hover:bg-red-500/10" data-action="suspend" data-user-id="{{this.id}}" data-user-name="{{this.name}}">⛔ Suspender</button>
        </div>
       </div>
      </div>
      {{/each}}
     </div>
    </div>
   </div>
  </div>

  <!-- ═══════ TAB: MASTER CI/CD ═══════ -->
  <div id="tab-cicd" class="settings-pane hidden space-y-4">
   <div class="kcard">
    <div class="kcard-body" style="padding:24px;">
     <h3 class="text-sm font-black text-white mb-5 flex items-center gap-2">
      <span class="material-symbols-outlined text-orange-500 text-base">admin_panel_settings</span> Master — Acessos & Deploy
     </h3>
     <div class="p-4 rounded-[5px] mb-4" style="border:1px solid rgba(239,68,68,0.2); background:rgba(239,68,68,0.05);">
      <p class="text-[8px] font-black text-red-400 uppercase tracking-widest mb-1 flex items-center gap-1">
       <span class="material-symbols-outlined text-[10px]">warning</span> Área Restrita
      </p>
      <p class="text-[9px] text-gray-400">Funções avançadas de administração. Alterações aqui afetam o sistema inteiro.</p>
     </div>
     <div class="space-y-3">
      <div class="p-4 rounded-[5px] flex items-center justify-between" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <div>
        <p class="text-xs font-bold text-white">Limpar Cache</p>
        <p class="text-[8px] text-gray-500">Remove cache de sessões e templates</p>
       </div>
       <button onclick="fetch('/admin/api/cache/clear',{method:'POST'}).then(()=>alert('Cache limpo!'))" class="px-3 py-1.5 rounded-md text-[8px] font-black uppercase tracking-wider text-amber-400 hover:text-white transition-colors" style="background:rgba(255,255,255,0.03); border:1px solid rgba(245,158,11,0.3);">Executar</button>
      </div>
      <div class="p-4 rounded-[5px] flex items-center justify-between" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <div>
        <p class="text-xs font-bold text-white">Versão do Sistema</p>
        <p class="text-[8px] text-gray-500">Malha3D ERP v2.0</p>
       </div>
       <span class="text-[9px] font-black text-emerald-400">v2.0.0</span>
      </div>
      <div class="p-4 rounded-[5px] flex items-center justify-between" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
       <div>
        <p class="text-xs font-bold text-white">Dados de Teste</p>
        <p class="text-[8px] text-gray-500">Gerar dados fictícios para teste do sistema</p>
       </div>
       <button onclick="if(confirm('Gerar dados de teste?')) fetch('/admin/api/test-data/generate',{method:'POST'}).then(r=>r.json()).then(d=>alert(d.message||'Gerado!'))" class="px-3 py-1.5 rounded-md text-[8px] font-black uppercase tracking-wider text-purple-400 hover:text-white transition-colors" style="background:rgba(255,255,255,0.03); border:1px solid rgba(168,85,247,0.3);">Gerar</button>
      </div>
     </div>
    </div>
   </div>
  </div>

 </div><!-- /col-span-9 -->
</div><!-- /grid -->

<script>
document.addEventListener('DOMContentLoaded', function() {
 // Tab switching
 const tabBtns = document.querySelectorAll('.tab-btn');
 const panes = document.querySelectorAll('.settings-pane');

 tabBtns.forEach(btn => {
  btn.addEventListener('click', () => {
   const tab = btn.dataset.tab;
   panes.forEach(p => p.classList.add('hidden'));
   tabBtns.forEach(b => {
    b.classList.remove('bg-orange-500/10', 'text-orange-400', 'border-orange-500/20');
    b.classList.add('text-gray-400');
   });
   const target = document.getElementById('tab-' + tab);
   if (target) target.classList.remove('hidden');
   btn.classList.add('bg-orange-500/10', 'text-orange-400', 'border-orange-500/20');
   btn.classList.remove('text-gray-400');
  });
 });

 // Activate first tab
 if (tabBtns[0]) tabBtns[0].click();

 // Toast helper
 function showToast(msg, type) {
  if (window.showToast) { window.showToast(msg, type); return; }
  alert(msg);
 }

 // Load API keys
 fetch('/admin/api/settings/lists').then(r => r.json()).then(data => {
  const container = document.getElementById('api-keys-table');
  if (!data.apiKeys || data.apiKeys.length === 0) {
   container.innerHTML = '<p class="text-[10px] text-gray-500 text-center py-3">Nenhuma chave gerada.</p>';
   return;
  }
  container.innerHTML = data.apiKeys.map(k => `
   <div class="p-3 rounded-[5px] flex items-center justify-between" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
    <div>
     <p class="text-[9px] font-bold text-white font-mono">${k.key ? k.key.substring(0, 16) + '...' : k.name}</p>
     <p class="text-[7px] text-gray-500">Criada em: ${new Date(k.createdAt).toLocaleDateString('pt-BR')}</p>
    </div>
    <button onclick="fetch('/admin/api/api-keys/${k.id}',{method:'DELETE'}).then(()=>location.reload())" class="text-[8px] text-red-400 hover:text-red-300">Revogar</button>
   </div>
  `).join('');
 }).catch(() => {});

 // Generate key
 document.getElementById('btn-gerar-chave')?.addEventListener('click', async () => {
  const name = prompt('Nome da chave (ex: "App Mobile"):');
  if (!name) return;
  const r = await fetch('/admin/api/api-keys', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name }) });
  const data = await r.json();
  if (data.success) { showToast('Chave gerada: ' + data.key, 'success'); location.reload(); }
  else showToast(data.error || 'Erro', 'error');
 });

 // Dropdown triggers
 document.addEventListener('click', function(e) {
  const trigger = e.target.closest('.dropdown-trigger');
  if (trigger) {
   e.stopPropagation();
   const userId = trigger.dataset.userId;
   const dd = document.getElementById('dd-' + userId);
   document.querySelectorAll('[id^="dd-"]').forEach(d => { if (d !== dd) d.classList.add('hidden'); });
   dd?.classList.toggle('hidden');
   return;
  }
  document.querySelectorAll('[id^="dd-"]').forEach(d => d.classList.add('hidden'));
 });

 // User actions
 document.addEventListener('click', async function(e) {
  const actionBtn = e.target.closest('.user-action');
  if (!actionBtn) return;
  const { action, userId, userName } = actionBtn.dataset;
  document.querySelectorAll('[id^="dd-"]').forEach(d => d.classList.add('hidden'));

  if (action === 'analytics') {
   window.open('/admin/api/users/' + userId + '/analytics', '_blank');
  } else if (action === 'reset-password') {
   const pw = prompt('Nova senha para ' + userName + ':');
   if (!pw) return;
   const r = await fetch('/admin/api/users/' + userId + '/reset-password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ newPassword: pw }) });
   const d = await r.json();
   showToast(d.success ? 'Senha atualizada!' : (d.error || 'Erro'), d.success ? 'success' : 'error');
  } else if (action === 'suspend') {
   if (!confirm('Suspender ' + userName + '?')) return;
   const r = await fetch('/admin/api/users/' + userId + '/action', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'suspend' }) });
   const d = await r.json();
   showToast(d.success ? d.message : d.error, d.success ? 'warn' : 'error');
  }
 });

 // Calculator settings save
 document.getElementById('calculatorSettingsForm')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('btnSaveCalculatorSettings');
  btn.disabled = true;
  const formData = new FormData(e.target);
  const settings = {};
  for (const [key, value] of formData.entries()) settings[key] = value.trim();
  try {
   const r = await fetch('/admin/api/settings/bulk', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ settings }) });
   const data = await r.json();
   showToast(data.success ? 'Calibração salva!' : (data.error || 'Erro'), data.success ? 'success' : 'error');
  } catch (err) { showToast('Erro de conexão', 'error'); }
  finally { btn.disabled = false; }
 });

 // Load calculator settings
 fetch('/api/calculator-settings').then(r => r.ok ? r.json() : {}).then(settings => {
  ['calculator_base_price_m2','calculator_base_price_image','calculator_base_price_animation','calculator_base_price_tour','calculator_base_price_environment','gemini_api_key','openai_api_key'].forEach(f => {
   const input = document.getElementById(f);
   if (input && settings[f] !== undefined) input.value = settings[f];
  });
 }).catch(() => {});
});
</script>
