<script>
// ============================================================
// SETTINGS ENGINE — Conselho de Engenharia v2.0
// CSP-compliant: zero inline handlers, 100% addEventListener
// ============================================================

// ── Toast Notification System ─────────────────────────────
function showToast(message, type = 'success') {
 const existing = document.getElementById('erp-toast');
 if (existing) existing.remove();
 const colors = { success: 'bg-emerald-500', error: 'bg-red-500', info: 'bg-indigo-500', warn: 'bg-yellow-500' };
 const icons = { success: 'check_circle', error: 'error', info: 'info', warn: 'warning' };
 const t = document.createElement('div');
 t.id = 'erp-toast';
 t.className = `fixed bottom-6 right-6 z-[9999] flex items-center gap-3 px-5 py-4 rounded-[5px] ${colors[type]} text-white text-sm font-bold shadow-2xl transition-all`;
 t.innerHTML = `<span class="material-symbols-outlined text-lg">${icons[type]}</span><span>${message}</span>`;
 document.body.appendChild(t);
 setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 400); }, 4000);
}

// ── Tab Switch Engine ─────────────────────────────────────
function switchSettingsTab(tabId, el) {
 document.querySelectorAll('.settings-pane').forEach(p => p.classList.add('hidden'));
 const pane = document.getElementById('tab-' + tabId);
 if (pane) { 
 pane.classList.remove('hidden');
 pane.classList.add('animate-in', 'fade-in', 'duration-300');
 }
 document.querySelectorAll('.tab-btn').forEach(btn => {
 btn.style.background = ''; btn.style.color = ''; btn.style.borderColor = ''; btn.style.boxShadow = '';
 btn.setAttribute('data-active', 'false');
 });
 el.setAttribute('data-active', 'true');
 
 // Visual indicators for active state
 if (tabId === 'cicd') {
 el.style.background = 'rgba(99,102,241,0.15)'; el.style.color = '#818cf8';
 el.style.borderColor = 'rgba(99,102,241,0.3)';
 } else {
 el.style.background = 'rgba(249,115,22,0.12)'; el.style.color = '#f97316';
 el.style.borderColor = 'rgba(249,115,22,0.25)';
 }
 
 if (tabId === 'api') loadApiKeys();
}

// ── Accordion Toggle ──────────────────────────────────────
function toggleAccordion(id) {
 const el = document.getElementById(id);
 const icon = document.getElementById('icon-' + id);
 if (!el) return;
 if (el.classList.contains('hidden')) { el.classList.remove('hidden'); icon?.classList.add('rotate-180'); }
 else { el.classList.add('hidden'); icon?.classList.remove('rotate-180'); }
}

// ── API Keys — Stripe-style ───────────────────────────────
async function loadApiKeys() {
 const container = document.getElementById('api-keys-table');
 if (!container) return;
 try {
 const r = await fetch('/admin/api/keys');
 const data = await r.json();
 if (!data.success || !data.keys.length) {
 container.innerHTML = '<p class="text-center text-gray-600 text-xs py-6">Nenhuma chave cadastrada. Clique em "Gerar Chave" para criar.</p>';
 return;
 }
 container.innerHTML = data.keys.map(k => `
 <div class="flex items-center justify-between p-4 rounded-[5px] bg-white/[0.02] border border-white/5">
 <div class="flex items-center gap-4">
 <div class="w-8 h-8 rounded-lg bg-orange-500/10 border border-orange-500/20 flex items-center justify-center">
 <span class="material-symbols-outlined text-sm text-orange-400">key</span>
 </div>
 <div>
 <p class="text-sm font-bold text-white">${k.name}</p>
 <p class="text-xs text-gray-500 font-mono">${k.keyMasked}</p>
 </div>
 </div>
 <div class="flex items-center gap-3">
 <span class="px-2 py-1 rounded-md text-[9px] font-black ${k.isActive ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-red-500/10 text-red-400 border border-red-500/20'}">${k.isActive ? 'ATIVA' : 'REVOGADA'}</span>
 ${k.isActive ? `<button class="revoke-key text-xs text-gray-500 hover:text-red-400 transition-colors" data-key-id="${k.id}">Revogar</button>` : ''}
 </div>
 </div>`).join('');
 // Revogar listeners
 container.querySelectorAll('.revoke-key').forEach(btn => {
 btn.addEventListener('click', async function() {
 if (!confirm('Revogar esta chave? Esta ação é irreversível.')) return;
 const r = await fetch(`/admin/api/keys/${this.dataset.keyId}`, { method: 'DELETE' });
 const d = await r.json();
 showToast(d.success ? 'Chave revogada com sucesso.' : d.error, d.success ? 'warn' : 'error');
 if (d.success) loadApiKeys();
 });
 });
 } catch (e) {
 container.innerHTML = '<p class="text-center text-red-500 text-xs py-6">Erro ao carregar chaves.</p>';
 }
}

function showGeneratedKey(fullKey, name) {
 const modal = document.createElement('div');
 modal.className = 'fixed inset-0 bg-black/90 z-[3000] flex items-center justify-center p-4';
 modal.innerHTML = `
 <div class="kcard w-full max-w-lg border-orange-500/20 p-8">
 <div class="flex items-center gap-3 mb-6">
 <div class="w-12 h-12 rounded-[5px] bg-orange-500/10 border border-orange-500/20 flex items-center justify-center">
 <span class="material-symbols-outlined text-orange-400">key</span>
 </div>
 <div>
 <h3 class="text-lg font-black text-white">Chave Gerada: ${name}</h3>
 <p class="text-xs text-red-400 font-bold">⚠ Copie agora — não será exibida novamente!</p>
 </div>
 </div>
 <div class="bg-black/40 border border-orange-500/20 rounded-[5px] p-4 flex items-center gap-3 mb-6">
 <code class="flex-1 text-orange-300 text-xs font-mono break-all" id="generated-key-display">${fullKey}</code>
 <button id="copy-gen-key" class="p-2 bg-orange-500/10 rounded-lg text-orange-400 hover:bg-orange-500/20 transition-colors">
 <span class="material-symbols-outlined text-sm">content_copy</span>
 </button>
 </div>
 <button id="close-gen-modal" class="w-full py-3 bg-orange-500 text-white text-xs font-black rounded-[5px] hover:bg-orange-400 transition-all">Confirmei — fechar</button>
 </div>`;
 document.body.appendChild(modal);
 modal.querySelector('#copy-gen-key').addEventListener('click', () => {
 navigator.clipboard.writeText(fullKey).then(() => showToast('Chave copiada!', 'success'));
 });
 modal.querySelector('#close-gen-modal').addEventListener('click', () => { modal.remove(); loadApiKeys(); });
}

// ── Deploy CI/CD ──────────────────────────────────────────
async function triggerDeploy() {
 const btn = document.getElementById('btnDeploy');
 const txt = document.getElementById('btnDeployText');
 const info = document.getElementById('deploy-last');
 if (!btn || btn.disabled) return;
 if (!confirm('Confirmar deploy em produção?')) return;
 btn.disabled = true;
 txt.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> Construindo...';
 showToast('Pipeline iniciada. Aguardando resposta do servidor...', 'info');
 try {
 const r = await fetch('/admin/api/deploy', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
 const data = await r.json();
 if (data.success) {
 showToast(data.message, 'success');
 if (info) info.textContent = 'Último deploy: ' + new Date().toLocaleString('pt-BR');
 } else {
 showToast(data.message || 'Falha no deploy.', 'error');
 }
 } catch (e) {
 showToast('Erro de conexão com o servidor de deploy.', 'error');
 } finally {
 btn.disabled = false;
 txt.innerHTML = 'Publicar Agora';
 }
}

// ── DOMContentLoaded: Wire everything up ─────────────────
document.addEventListener('DOMContentLoaded', function() {

 // Tab buttons
 document.querySelectorAll('.tab-btn[data-tab]').forEach(btn => {
 btn.addEventListener('click', function() { switchSettingsTab(this.dataset.tab, this); });
 });
 const firstBtn = document.querySelector('.tab-btn[data-tab="general"]');
 if (firstBtn) switchSettingsTab('general', firstBtn);

 // Nova Chave (header button) → go to API tab and open generator
 const btnNovaChave = document.getElementById('btn-nova-chave');
 if (btnNovaChave) {
 btnNovaChave.addEventListener('click', () => {
 const apiBtn = document.querySelector('.tab-btn[data-tab="api"]');
 if (apiBtn) switchSettingsTab('api', apiBtn);
 setTimeout(() => document.getElementById('btn-gerar-chave')?.click(), 300);
 });
 }

 // Gerar Chave button (inside API tab)
 const btnGerarChave = document.getElementById('btn-gerar-chave');
 if (btnGerarChave) {
 btnGerarChave.addEventListener('click', () => {
 const name = prompt('Nome para a chave (ex: Zapier, N8N, Supabase):');
 if (!name) return;
 fetch('/admin/api/keys', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ name })
 }).then(r => r.json()).then(data => {
 if (data.success) { showGeneratedKey(data.key.fullKey, data.key.name); }
 else { showToast(data.error || 'Erro ao gerar chave.', 'error'); }
 }).catch(() => showToast('Erro de conexão.', 'error'));
 });
 }

 // Deploy button
 const btnDeploy = document.getElementById('btnDeploy');
 if (btnDeploy) btnDeploy.addEventListener('click', triggerDeploy);

 // Criar Usuário Manual button (header + CI/CD tab)
 const setupUserModalTriggers = () => {
 const btnOpenModal = document.getElementById('btn-open-new-user-modal');
 if (btnOpenModal) {
 btnOpenModal.addEventListener('click', () => {
 document.getElementById('newUserModal').classList.remove('hidden');
 });
 }
 };
 setupUserModalTriggers();

 // Close new user modal
 document.getElementById('closeNewUserModal')?.addEventListener('click', () => {
 document.getElementById('newUserModal').classList.add('hidden');
 });

 // Password visibility toggle
 document.getElementById('btn-toggle-password-visibility')?.addEventListener('click', function() {
 const p = document.getElementById('newUserPassword');
 if (p) p.type = p.type === 'password' ? 'text' : 'password';
 });

 // New user form submit
 document.getElementById('newUserForm')?.addEventListener('submit', async (e) => {
 e.preventDefault();
 const submitBtn = document.getElementById('submitNewUser');
 // Serialize tech stack checkboxes
 const checked = [...document.querySelectorAll('input[name="techStackItems"]:checked')].map(c => c.value);
 document.getElementById('techStackJson').value = JSON.stringify(checked);

 const formData = new FormData(e.target);
 const data = Object.fromEntries(formData.entries());
 // Map permission checkboxes
 data.permissions = JSON.stringify({
 canSeeFinance: !!formData.get('perm_canSeeFinance'),
 canApproveBudgets: !!formData.get('perm_canApproveBudgets'),
 ownProjectsOnly: !!formData.get('perm_ownProjectsOnly')
 });

 submitBtn.disabled = true;
 submitBtn.textContent = 'Criando...';
 try {
 const r = await fetch('/admin/api/users', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify(data)
 });
 const res = await r.json();
 if (res.success) {
 showToast(`Usuário "${res.user.name}" criado com sucesso!`, 'success');
 document.getElementById('newUserModal').classList.add('hidden');
 setTimeout(() => window.location.reload(), 1500);
 } else {
 showToast('Erro: ' + (res.error || 'Falha'), 'error');
 }
 } catch (err) {
 showToast('Erro de conexão.', 'error');
 } finally {
 submitBtn.disabled = false;
 submitBtn.textContent = 'Criar Membro da Equipe';
 }
 });

 // Dropdown triggers (more_vert buttons on team members)
 document.addEventListener('click', function(e) {
 const trigger = e.target.closest('.dropdown-trigger');
 if (trigger) {
 e.stopPropagation();
 const userId = trigger.dataset.userId;
 const dd = document.getElementById('dd-' + userId);
 // Close all others
 document.querySelectorAll('[id^="dd-"]').forEach(d => { if (d !== dd) d.classList.add('hidden'); });
 dd?.classList.toggle('hidden');
 return;
 }
 // Close all dropdowns on outside click
 document.querySelectorAll('[id^="dd-"]').forEach(d => d.classList.add('hidden'));
 });

 // User action buttons inside dropdown
 document.addEventListener('click', async function(e) {
 const actionBtn = e.target.closest('.user-action');
 if (!actionBtn) return;
 const { action, userId, userName } = actionBtn.dataset;
 document.querySelectorAll('[id^="dd-"]').forEach(d => d.classList.add('hidden'));

 if (action === 'analytics') {
 openAnalyticsDrawer(userId, userName);
 } else if (action === 'reset-password') {
 const pw = prompt(`Nova senha para ${userName}:`);
 if (!pw) return;
 const r = await fetch(`/admin/api/users/${userId}/reset-password`, {
 method: 'POST', headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ newPassword: pw })
 });
 const d = await r.json();
 showToast(d.success ? 'Senha atualizada!' : (d.error || 'Erro'), d.success ? 'success' : 'error');
 } else if (action === 'force-logout') {
 if (!confirm(`Forçar logout de ${userName}?`)) return;
 const r = await fetch(`/admin/api/users/${userId}/action`, {
 method: 'POST', headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ action: 'force-logout' })
 });
 const d = await r.json();
 showToast(d.success ? d.message : d.error, d.success ? 'warn' : 'error');
 } else if (action === 'suspend') {
 const reason = prompt(`Motivo da suspensão de ${userName}:`);
 if (reason === null) return;
 const r = await fetch(`/admin/api/users/${userId}/action`, {
 method: 'POST', headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ action: 'suspend', reason })
 });
 const d = await r.json();
 showToast(d.success ? d.message : d.error, d.success ? 'warn' : 'error');
 }
 });

 // ── Load Calculator settings from database ─────────────────
 const loadCalculatorSettings = async () => {
 try {
 const r = await fetch('/api/calculator-settings');
 if (r.ok) {
 const settings = await r.json();
 const fields = [
 'calculator_base_price_m2',
 'calculator_base_price_image',
 'calculator_base_price_animation',
 'calculator_base_price_tour',
 'calculator_base_price_environment',
 'gemini_api_key',
 'openai_api_key'
 ];
 fields.forEach(f => {
 const input = document.getElementById(f);
 if (input && settings[f] !== undefined) {
 input.value = settings[f];
 }
 });
 }
 } catch (err) {
 console.error('Erro ao carregar calibração da calculadora:', err);
 }
 };
 loadCalculatorSettings();

 // ── Save Calculator settings to database ─────────────────
 document.getElementById('calculatorSettingsForm')?.addEventListener('submit', async (e) => {
 e.preventDefault();
 const btnSave = document.getElementById('btnSaveCalculatorSettings');
 btnSave.disabled = true;
 btnSave.textContent = 'Salvando calibração...';

 const formData = new FormData(e.target);
 const settings = {};
 for (const [key, value] of formData.entries()) {
 settings[key] = value.trim();
 }

 try {
 const r = await fetch('/admin/api/settings/bulk', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ settings })
 });
 const data = await r.json();
 if (data.success) {
 showToast('Calibração da Calculadora salva com sucesso!', 'success');
 } else {
 showToast(data.error || 'Erro ao salvar calibração.', 'error');
 }
 } catch (err) {
 showToast('Erro de conexão ao salvar calibração.', 'error');
 } finally {
 btnSave.disabled = false;
 btnSave.textContent = 'Salvar Calibração';
 }
 });
});

// ── Analytics Drawer ──────────────────────────────────────
async function openAnalyticsDrawer(userId, userName) {
 const existing = document.getElementById('analytics-drawer');
 if (existing) existing.remove();

 const drawer = document.createElement('div');
 drawer.id = 'analytics-drawer';
 drawer.className = 'fixed inset-y-0 right-0 w-full max-w-lg bg-[#0f0f0f] border-l border-white/10 z-[2500] shadow-2xl flex flex-col';
 drawer.innerHTML = `
 <div class="p-6 border-b border-white/10 flex justify-between items-center">
 <div>
 <h3 class="text-lg font-black text-white">Relatório: ${userName}</h3>
 <p class="text-xs text-gray-500">Análise de desempenho e carga de trabalho</p>
 </div>
 <button id="close-drawer" class="text-gray-500 hover:text-white"><span class="material-symbols-outlined">close</span></button>
 </div>
 <div id="drawer-content" class="flex-1 overflow-y-auto p-6 space-y-6">
 <div class="flex items-center justify-center py-16"><span class="material-symbols-outlined animate-spin text-4xl text-indigo-400">progress_activity</span></div>
 </div>`;
 document.body.appendChild(drawer);
 document.getElementById('close-drawer').addEventListener('click', () => drawer.remove());

 try {
 const r = await fetch(`/admin/api/users/${userId}/analytics`);
 const data = await r.json();
 const a = data.analytics;
 document.getElementById('drawer-content').innerHTML = `
 <div class="grid grid-cols-3 gap-4">
 <div class="p-4 rounded-[5px] bg-indigo-500/10 border border-indigo-500/20 text-center">
 <p class="text-2xl font-black text-indigo-400">${a.activeProjectsCount}</p>
 <p class="text-[9px] text-gray-500 uppercase font-black tracking-widest mt-1">Projetos Ativos</p>
 </div>
 <div class="p-4 rounded-[5px] bg-orange-500/10 border border-orange-500/20 text-center">
 <p class="text-2xl font-black text-orange-400">${a.totalHoursLogged}h</p>
 <p class="text-[9px] text-gray-500 uppercase font-black tracking-widest mt-1">Horas Logadas</p>
 </div>
 <div class="p-4 rounded-[5px] bg-red-500/10 border border-red-500/20 text-center">
 <p class="text-2xl font-black text-red-400">${a.avgRevisionsPerProject}</p>
 <p class="text-[9px] text-gray-500 uppercase font-black tracking-widest mt-1">Revisões/Proj.</p>
 </div>
 </div>
 <div>
 <h4 class="text-xs font-black text-gray-500 uppercase tracking-widest mb-3">Projetos em Andamento</h4>
 ${a.projects.length ? a.projects.map(p => `
 <div class="flex items-center justify-between p-3 rounded-[5px] bg-white/[0.02] border border-white/5 mb-2">
 <p class="text-xs font-bold text-white">${p.title}</p>
 <span class="px-2 py-1 rounded text-[8px] font-black uppercase text-indigo-400 bg-indigo-500/10">${p.status}</span>
 </div>`).join('') : '<p class="text-xs text-gray-600 py-4 text-center">Sem projetos ativos.</p>'}
 </div>`;
 } catch (e) {
 document.getElementById('drawer-content').innerHTML = '<p class="text-center text-red-400 text-xs py-8">Erro ao carregar analytics.</p>';
 }
}

function toggleCollapseCard(cardId, iconId) {
 const card = document.getElementById(cardId);
 const icon = document.getElementById(iconId || `icon-${cardId}`);
 if (card) {
 card.classList.toggle('hidden');
 if (icon) {
 icon.classList.toggle('rotate-180');
 }
 }
}
</script>

