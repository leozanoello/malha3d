 <!-- MASTER ADMIN & CI/CD TAB — RBAC Guard wraps the entire panel -->
 <div id="tab-cicd" class="settings-pane hidden space-y-8 duration-500">
 {{#if (eq user.role 'admin')}}
 <!-- HEADER MASTER -->
 <header class="flex justify-between items-end">
 <div>
 <h2 class="text-3xl font-black text-white tracking-tighter">Painel Master de <span class="text-indigo-500">Acessos</span></h2>
 <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-2">Gerenciamento de assinantes, staff e sub-contas (RBAC)</p>
 </div>
 <button class="px-6 py-3 bg-indigo-500 text-white text-[10px] font-black uppercase tracking-widest rounded-[5px] shadow-indigo-500/20 hover:bg-indigo-400 transition-all" id="btn-open-new-user-modal">Criar Usuário Manual</button>
 </header>

 <!-- GESTÃO DE USUÁRIOS (MULTI-TENANT) -->
 <div class="kcard border-white/5 overflow-hidden mb-8">
 <div class="p-6 border-b border-white/5 bg-white/5 flex justify-between items-center cursor-pointer" onclick="toggleCollapseCard('card-subscribers')">
 <h4 class="text-[11px] font-black text-white uppercase tracking-[0.2em]">Assinantes</h4>
 <span class="material-symbols-outlined text-gray-500 transition-transform duration-300" id="icon-card-subscribers">expand_more</span>
 </div>
 <div id="card-subscribers" class="divide-y divide-white/[0.03]">
 {{#if subscriberUsers.length}}
 {{#each subscriberUsers}}
 <div class="group">
 <div class="px-8 py-5 flex items-center justify-between hover:bg-white/[0.02] transition-colors cursor-pointer" onclick="toggleAccordion('subusers-{{this.id}}')">
 <div class="flex items-center gap-4">
 <div class="w-10 h-10 rounded-[5px] bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-500 font-black">
 {{firstLetter this.name}}
 </div>
 <div>
 <p class="text-[13px] font-black text-white uppercase">{{this.name}}</p>
 <p class="text-[10px] text-gray-400 font-bold tracking-widest">{{this.email}}</p>
 </div>
 </div>
 <div class="flex items-center gap-6">
 <span class="px-3 py-1 rounded-full border text-[9px] font-black uppercase tracking-widest bg-emerald-500/10 border-emerald-500/20 text-emerald-500">
 {{this.role}}
 </span>
 {{#if this.tenantName}}
 <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"><span class="material-symbols-outlined text-[12px] align-middle mr-1">domain</span>{{this.tenantName}}</span>
 {{/if}}
 <div class="flex items-center gap-2">
 <button class="p-2 rounded-lg bg-white/5 text-gray-400 hover:text-white transition-all" onclick="event.stopPropagation(); openResetPasswordModal('{{this.id}}', '{{this.name}}')" title="Redefinir Senha"><span class="material-symbols-outlined text-sm">lock_reset</span></button>
 {{#if this.subUsers.length}}
 <span class="material-symbols-outlined text-gray-500 transition-transform duration-300" id="icon-subusers-{{this.id}}">expand_more</span>
 {{/if}}
 </div>
 </div>
 </div>
 
 {{#if this.subUsers.length}}
 <div id="subusers-{{this.id}}" class="hidden bg-black/20 border-y border-white/5">
 <div class="px-12 py-4 space-y-3">
 {{#each this.subUsers}}
 <div class="flex items-center justify-between p-3 rounded-[5px] hover:bg-white/5 transition-all">
 <div class="flex items-center gap-3">
 <div class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 text-[10px] font-black">
 {{firstLetter this.name}}
 </div>
 <div>
 <p class="text-[11px] font-bold text-white">{{this.name}}</p>
 <p class="text-[9px] text-gray-500 font-medium">{{this.email}}</p>
 </div>
 </div>
 <div class="flex items-center gap-4">
 <span class="text-[8px] font-black uppercase tracking-widest text-indigo-400 bg-indigo-500/5 px-2 py-1 rounded-md">{{this.role}}</span>
 <button class="p-1.5 rounded-lg text-gray-600 hover:text-white transition-all" onclick="openResetPasswordModal('{{this.id}}', '{{this.name}}')">
 <span class="material-symbols-outlined text-sm">lock_reset</span>
 </button>
 </div>
 </div>
 {{/each}}
 </div>
 </div>
 {{/if}}
 </div>
 {{/each}}
 {{else}}
 <div class="p-20 text-center">
 <span class="material-symbols-outlined text-4xl text-gray-700 mb-4">group_off</span>
 <p class="text-gray-500 font-bold text-sm">Nenhum assinante cadastrado no sistema.</p>
 </div>
 {{/if}}
 </div>
 </div>

 <!-- OUTROS USUÁRIOS (STAFF/ADMIN) -->
 <div class="kcard border-white/5 overflow-visible">
 <div class="p-6 border-b border-white/5 bg-white/5 flex justify-between items-center cursor-pointer" onclick="toggleCollapseCard('card-other-users')">
