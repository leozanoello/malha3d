<!-- Versão 2.0 — Preview Bloqueado -->
<div class="flex items-center justify-center min-h-[70vh] relative">

 <!-- Overlay bloqueador -->
 <div class="absolute inset-0 z-10 flex items-center justify-center" style="background:rgba(0,0,0,0.3); backdrop-filter:blur(2px);">
  <div class="text-center p-8 max-w-md">
   <div class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center" style="background:rgba(245,158,11,0.1); border:2px solid rgba(245,158,11,0.3);">
    <span class="material-symbols-outlined text-3xl text-amber-400">rocket_launch</span>
   </div>
   <h2 class="text-xl font-black text-white mb-2">Versão 2.0</h2>
   <p class="text-sm text-gray-300 mb-4">
    <span class="text-amber-400 font-bold">{{moduleName}}</span> está em desenvolvimento e será lançado em breve.
   </p>
   <div class="flex flex-wrap justify-center gap-2 mb-6">
    {{#each features}}
    <span class="px-2 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase tracking-wider" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
     {{this}}
    </span>
    {{/each}}
   </div>
   <div class="flex items-center justify-center gap-3">
    <span class="px-4 py-2 rounded-[4px] text-[9px] font-black text-amber-400 uppercase tracking-widest" style="background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.3);">
     <span class="material-symbols-outlined text-[11px] align-middle mr-1">schedule</span> Em Breve
    </span>
   </div>
  </div>
 </div>

 <!-- Conteúdo de fundo (opaco, não interativo — amostra visual) -->
 <div class="w-full opacity-30 pointer-events-none select-none" style="filter:grayscale(0.5);">
  <div class="p-4 mb-4" style="background:#151515; border-radius:5px; box-shadow:0 2px 8px rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.06);">
   <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
     <div class="w-10 h-10 rounded-[5px] flex items-center justify-center" style="background:rgba({{#if (eq moduleColor 'indigo')}}99,102,241{{else if (eq moduleColor 'amber')}}245,158,11{{else}}249,115,22{{/if}},0.15);">
      <span class="material-symbols-outlined text-{{moduleColor}}-400 text-xl">{{moduleIcon}}</span>
     </div>
     <div>
      <h1 class="text-lg font-black text-white">{{moduleName}}</h1>
      <p class="text-[9px] text-gray-500 uppercase tracking-widest">Malha3D — Versão 2.0</p>
     </div>
    </div>
    <div class="flex gap-2">
     <div class="w-24 h-8 rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);"></div>
     <div class="w-24 h-8 rounded-[4px] bg-orange-500/50"></div>
    </div>
   </div>
  </div>

  <!-- Cards de exemplo -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
   <div class="p-4 rounded-[5px]" style="background:#151515; border:1px solid rgba(255,255,255,0.06);">
    <div class="w-full h-32 rounded-[4px] mb-3" style="background:rgba(255,255,255,0.02);"></div>
    <div class="h-3 w-3/4 rounded mb-2" style="background:rgba(255,255,255,0.05);"></div>
    <div class="h-2 w-1/2 rounded" style="background:rgba(255,255,255,0.03);"></div>
   </div>
   <div class="p-4 rounded-[5px]" style="background:#151515; border:1px solid rgba(255,255,255,0.06);">
    <div class="w-full h-32 rounded-[4px] mb-3" style="background:rgba(255,255,255,0.02);"></div>
    <div class="h-3 w-3/4 rounded mb-2" style="background:rgba(255,255,255,0.05);"></div>
    <div class="h-2 w-1/2 rounded" style="background:rgba(255,255,255,0.03);"></div>
   </div>
   <div class="p-4 rounded-[5px]" style="background:#151515; border:1px solid rgba(255,255,255,0.06);">
    <div class="w-full h-32 rounded-[4px] mb-3" style="background:rgba(255,255,255,0.02);"></div>
    <div class="h-3 w-3/4 rounded mb-2" style="background:rgba(255,255,255,0.05);"></div>
    <div class="h-2 w-1/2 rounded" style="background:rgba(255,255,255,0.03);"></div>
   </div>
  </div>
 </div>

</div>
