            Configuracao segura & criptografada
        </div>
    </div>

    <script>
        (function () {
            const TOTAL_STEPS = 10;
            let currentStep = 1;
            const stepTitles = {
                1: 'Boas-vindas',
                2: 'Dados da Empresa',
                3: 'Perfil do Usuario',
                4: 'Primeiro Cliente',
                5: 'Primeiro Projeto',
                6: 'Configuracao Financeira',
                7: 'Produtos & Servicos',
                8: 'Integracoes',
                9: 'Personalizacao',
                10: 'Concluido'
            };

            const root = document.getElementById('onboardingRoot');
            const stepIndicator = document.getElementById('stepIndicator');
            const btnBack = document.getElementById('btnBack');
            const btnNext = document.getElementById('btnNext');
            const btnNextLabel = document.getElementById('btnNextLabel');
            const btnNextIcon = document.getElementById('btnNextIcon');
            const progressBar = document.getElementById('progressBar');
            const confettiContainer = document.getElementById('confettiContainer');

            // Build confetti particles
            const confettiColors = ['#f97316', '#fb923c', '#fbbf24', '#10b981', '#3b82f6', '#a855f7', '#ef4444'];
            for (let i = 0; i < 40; i++) {
                const c = document.createElement('div');
                c.className = 'confetti';
                c.style.left = (Math.random() * 100) + '%';
                c.style.background = confettiColors[Math.floor(Math.random() * confettiColors.length)];
                c.style.animationDelay = (Math.random() * 2) + 's';
                c.style.animationDuration = (3 + Math.random() * 2) + 's';
                c.style.transform = 'rotate(' + (Math.random() * 360) + 'deg)';
                confettiContainer.appendChild(c);
            }

            function showStep(n) {
                document.querySelectorAll('.onboarding-step').forEach(function (el) {
                    el.classList.add('hidden');
                });
                const target = document.querySelector('.onboarding-step[data-step="' + n + '"]');
                if (target) target.classList.remove('hidden');

                stepIndicator.textContent = 'Passo ' + n + ' de ' + TOTAL_STEPS;
                document.querySelectorAll('.progress-segment').forEach(function (seg) {
                    const segStep = parseInt(seg.getAttribute('data-step'), 10);
                    if (segStep <= n) seg.classList.add('active');
                    else seg.classList.remove('active');
                });

                btnBack.classList.toggle('hidden', n === 1);
                if (n === TOTAL_STEPS) {
                    btnNextLabel.textContent = 'Finalizar';
                    btnNextIcon.textContent = 'celebration';
                    confettiContainer.style.display = 'block';
                    fillSummary();
                } else {
                    btnNextLabel.textContent = n === 1 ? 'Comecar' : 'Proximo';
                    btnNextIcon.textContent = 'arrow_forward';
                    confettiContainer.style.display = 'none';
                }

                currentStep = n;
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            function validateCurrentStep() {
                const stepEl = document.querySelector('.onboarding-step[data-step="' + currentStep + '"]');
                if (!stepEl) return true;
                const requiredFields = stepEl.querySelectorAll('input[required], select[required], textarea[required]');
                let valid = true;
                let firstInvalid = null;
                requiredFields.forEach(function (field) {
                    if (!field.value || (field.type === 'checkbox' && !field.checked)) {
                        valid = false;
                        field.style.borderColor = '#ef4444';
                        if (!firstInvalid) firstInvalid = field;
                    } else {
                        field.style.borderColor = '';
                    }
                });
                if (!valid && firstInvalid) {
                    firstInvalid.focus();
                    firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                return valid;
            }

            function collectData() {
                const data = {
                    empresa: {},
                    usuario: {},
                    cliente: {},
                    projeto: {},
                    financeiro: {},
                    servicos: [],
                    integracoes: {},
                    personalizacao: {}
                };

                // Empresa
                data.empresa.nome = document.getElementById('emp_nome').value;
                data.empresa.cnpj = document.getElementById('emp_cnpj').value;
                data.empresa.telefone = document.getElementById('emp_telefone').value;
                data.empresa.endereco = document.getElementById('emp_endereco').value;
                data.empresa.email = document.getElementById('emp_email').value;
                data.empresa.site = document.getElementById('emp_site').value;

                // Usuario
                data.usuario.nome = document.getElementById('usr_nome').value;
                data.usuario.cargo = document.getElementById('usr_cargo').value;
                data.usuario.celular = document.getElementById('usr_celular').value;

                // Cliente
                data.cliente.nome = document.getElementById('cli_nome').value;
                data.cliente.empresa = document.getElementById('cli_empresa').value;
                data.cliente.email = document.getElementById('cli_email').value;
                data.cliente.telefone = document.getElementById('cli_telefone').value;
                data.cliente.tipo = document.getElementById('cli_tipo').value;
                data.cliente.categoria = document.getElementById('cli_categoria').value;

                // Projeto
                data.projeto.nome = document.getElementById('proj_nome').value;
                data.projeto.tipo = document.getElementById('proj_tipo').value;
                data.projeto.metragem = document.getElementById('proj_metragem').value;
                data.projeto.complexidade = document.getElementById('proj_complexidade').value;
                data.projeto.valor = document.getElementById('proj_valor').value;

                // Financeiro
                data.financeiro.titular = document.getElementById('fin_titular').value;
                data.financeiro.banco = document.getElementById('fin_banco').value;
                data.financeiro.agencia = document.getElementById('fin_agencia').value;
                data.financeiro.conta = document.getElementById('fin_conta').value;
                data.financeiro.meta = document.getElementById('fin_meta').value;
                data.financeiro.moeda = document.getElementById('fin_moeda').value;

                // Servicos
                document.querySelectorAll('#servicesList .service-item').forEach(function (item) {
                    const cb = item.querySelector('input[type="checkbox"]');
                    const priceInput = item.querySelector('input[data-price-for]');
                    if (cb && cb.checked) {
                        data.servicos.push({
                            nome: cb.getAttribute('data-name'),
                            preco_base: priceInput ? priceInput.value : 0
                        });
                    }
                });

                // Integracoes
                data.integracoes.whatsapp = {
                    ativo: document.getElementById('int_whatsapp_toggle').checked,
                    numero: document.getElementById('int_whatsapp_numero').value
                };
                data.integracoes.smtp = {
                    ativo: document.getElementById('int_smtp_toggle').checked,
                    host: document.getElementById('int_smtp_host').value,
                    port: document.getElementById('int_smtp_port').value,
                    user: document.getElementById('int_smtp_user').value
                };

                // Personalizacao
                const temaEl = document.querySelector('input[name="tema"]:checked');
                data.personalizacao.tema = temaEl ? temaEl.value : 'dark';
                data.personalizacao.cor_destaque = document.getElementById('cor_picker').value;

                return data;
            }

            function fillSummary() {
                const d = collectData();
                document.getElementById('sum_empresa').textContent = d.empresa.nome || '-';
                document.getElementById('sum_usuario').textContent = d.usuario.nome || '-';
                document.getElementById('sum_cliente').textContent = d.cliente.nome || '-';
                document.getElementById('sum_projeto').textContent = d.projeto.nome || '-';
                document.getElementById('sum_moeda').textContent = d.financeiro.moeda || 'BRL';
                document.getElementById('sum_servicos').textContent = d.servicos.length;
                let integTotal = 0;
                if (d.integracoes.whatsapp.ativo) integTotal++;
                if (d.integracoes.smtp.ativo) integTotal++;
                document.getElementById('sum_integracoes').textContent = integTotal;
                document.getElementById('sum_tema').textContent = d.personalizacao.tema === 'dark' ? 'Dark' : 'Light';
                document.getElementById('sum_cor').textContent = d.personalizacao.cor_destaque;
                document.getElementById('sum_cor_swatch').style.background = d.personalizacao.cor_destaque;
            }

            btnNext.addEventListener('click', function () {
                if (currentStep < TOTAL_STEPS) {
                    if (!validateCurrentStep()) return;
                    showStep(currentStep + 1);
                } else {
                    // Final step - POST to API
                    btnNext.disabled = true;
                    btnNextLabel.textContent = 'Salvando...';
                    btnNextIcon.textContent = 'hourglass_empty';
                    const payload = collectData();
                    fetch('/admin/api/onboarding', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    })
                    .then(function (res) {
                        if (res.ok) {
                            window.location.href = '/admin/dashboard';
                        } else {
                            throw new Error('Erro ao salvar');
                        }
                    })
                    .catch(function (err) {
                        btnNext.disabled = false;
                        btnNextLabel.textContent = 'Finalizar';
                        btnNextIcon.textContent = 'celebration';
                        alert('Erro ao salvar configuracao. Tente novamente.');
                        console.error(err);
                    });
                }
            });

            btnBack.addEventListener('click', function () {
                if (currentStep > 1) showStep(currentStep - 1);
            });

            // Toggle integration fields visibility
            document.getElementById('int_whatsapp_toggle').addEventListener('change', function (e) {
                document.getElementById('whatsappFields').classList.toggle('hidden', !e.target.checked);
            });
            document.getElementById('int_smtp_toggle').addEventListener('change', function (e) {
                document.getElementById('smtpFields').classList.toggle('hidden', !e.target.checked);
            });

            // Service checkboxes enable price inputs
            document.querySelectorAll('#servicesList .service-item').forEach(function (item) {
                const cb = item.querySelector('input[type="checkbox"]');
                const priceInput = item.querySelector('input[data-price-for]');
                if (cb && priceInput) {
                    cb.addEventListener('change', function (e) {
                        priceInput.disabled = !e.target.checked;
                        if (e.target.checked) {
                            item.classList.add('checked');
                            priceInput.focus();
                        } else {
                            item.classList.remove('checked');
                            priceInput.value = '';
                        }
                    });
                }
            });

            // Color presets
            const corPicker = document.getElementById('cor_picker');
            const corSelected = document.getElementById('corSelected');
            document.querySelectorAll('.color-preset').forEach(function (preset) {
                preset.addEventListener('click', function () {
                    document.querySelectorAll('.color-preset').forEach(function (p) { p.classList.remove('selected'); });
                    preset.classList.add('selected');
                    const c = preset.getAttribute('data-color');
                    corPicker.value = c;
                    corSelected.innerHTML = 'Cor selecionada: <span class="text-white font-mono">' + c + '</span>';
                });
            });
            corPicker.addEventListener('input', function (e) {
                document.querySelectorAll('.color-preset').forEach(function (p) { p.classList.remove('selected'); });
                corSelected.innerHTML = 'Cor selecionada: <span class="text-white font-mono">' + e.target.value + '</span>';
            });

            // Avatar upload
            window.handleAvatarUpload = function (event) {
                const file = event.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = function (e) {
                    const preview = document.getElementById('avatarPreview');
                    const icon = document.getElementById('avatarIcon');
                    preview.innerHTML = '<img src="' + e.target.result + '" alt="avatar">';
                };
                reader.readAsDataURL(file);
            };

            // Logo upload
            window.handleLogoUpload = function (event) {
                const file = event.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = function (e) {
                    const preview = document.getElementById('logoPreview');
                    preview.innerHTML = '<img src="' + e.target.result + '" alt="logo" class="w-full h-full object-contain">';
                };
                reader.readAsDataURL(file);
            };

            // Initial step
            showStep(1);
        })();
    </script>
</body>
</html>