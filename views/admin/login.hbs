<div class="min-h-screen w-full flex items-center justify-center p-4 lg:p-8 font-['Plus_Jakarta_Sans'] relative overflow-hidden bg-[#050505]">
 <!-- Dynamic Background Orbs -->
 <div class="absolute -top-24 -left-24 w-96 h-96 bg-orange-500/20 rounded-full blur-[120px] animate-pulse"></div>
 <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-white/10 rounded-full blur-[120px] animate-pulse"></div>
 <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gray-400/5 rounded-full blur-[150px]"></div>

 <!-- Main Container -->
 <div class="w-full max-w-5xl flex flex-col lg:flex-row gap-4 relative z-10">
 
 <!-- Left Card: Branding & Impact -->
 <div class="hidden lg:flex lg:flex-[1.1] liquid-glass rounded-[2rem] p-6 lg:p-12 flex-col justify-between overflow-hidden group">
 <!-- Glass Reflection Overlay -->
 <div class="absolute inset-0 bg-gradient-to-br from-white/10 via-transparent to-transparent opacity-30 pointer-events-none"></div>
 
 <div class="relative z-10">
 <div class="flex items-center gap-4 mb-12">
 <div class="w-16 h-16 liquid-glass-btn rounded-2xl flex items-center justify-center shadow-2xl">
 <img src="/images/logo.svg" alt="Logo" class="w-10 h-10 drop-shadow-[0_0_8px_rgba(255,255,255,0.5)]">
 </div>
 <div class="flex flex-col">
 <span class="text-3xl font-black tracking-tighter text-white uppercase">Malha<span class="text-orange-500">3D</span></span>
 <span class="text-[10px] font-black text-gray-500 uppercase tracking-[0.4em] -mt-1">archviz</span>
 </div>
 </div>

 <div class="space-y-6">
 <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight">
 Transformando <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600">Visões</span> em Realidade <span class="text-orange-500">Imersiva</span>.
 </h1>
 <p class="text-lg text-gray-400 font-medium leading-relaxed max-w-lg">
 O futuro da arquitetura passa pela renderização neural e design de alta fidelidade. Bem-vindo ao seu novo centro de comando.
 </p>
 </div>
 </div>

 <div class="mt-12 relative z-10">
 <div class="flex items-center gap-6">
 <div class="flex -space-x-3">
 <div class="w-10 h-10 rounded-full border-2 border-[#030712] bg-gray-800 flex items-center justify-center overflow-hidden">
 <img src="https://ui-avatars.com/api/?name=User+1&background=random" alt="User">
 </div>
 <div class="w-10 h-10 rounded-full border-2 border-[#030712] bg-gray-800 flex items-center justify-center overflow-hidden">
 <img src="https://ui-avatars.com/api/?name=User+2&background=random" alt="User">
 </div>
 <div class="w-10 h-10 rounded-full border-2 border-[#030712] bg-gray-800 flex items-center justify-center overflow-hidden">
 <img src="https://ui-avatars.com/api/?name=User+3&background=random" alt="User">
 </div>
 </div>
 <p class="text-xs font-bold text-gray-500 uppercase tracking-widest">
 +500 arquitetos já utilizam nosso ecossistema
 </p>
 </div>
 </div>
 </div>

 <!-- Right Card: Login Form -->
 <div class="w-full max-w-md mx-auto lg:max-w-none lg:flex-1 liquid-glass rounded-[2rem] p-6 lg:p-10 flex flex-col justify-center">
 <!-- Mobile Branding Header (Show only on mobile since Left Card is hidden) -->
 <div class="flex items-center gap-3 mb-6 lg:hidden">
 <div class="w-10 h-10 liquid-glass-btn rounded-xl flex items-center justify-center shadow-lg">
 <img src="/images/logo.svg" alt="Logo" class="w-6 h-6">
 </div>
 <div class="flex flex-col">
 <span class="text-xl font-black tracking-tighter text-white uppercase">Malha<span class="text-orange-500">3D</span></span>
 </div>
 </div>

 <div class="mb-6 lg:mb-8">
 <h2 class="text-2xl font-black text-white tracking-tight">Identificação</h2>
 <p class="text-sm text-gray-500 font-medium mt-1">Acesse sua conta para gerenciar seus projetos.</p>
 </div>

 {{#if success}}
 <div class="mb-4 p-4 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl flex items-center gap-4">
 <div class="w-10 h-10 rounded-xl bg-emerald-500/20 flex items-center justify-center flex-shrink-0 text-emerald-500">
 <span class="material-symbols-outlined">check_circle</span>
 </div>
 <p class="text-xs font-bold text-emerald-400">{{success}}</p>
 </div>
 {{/if}}

 {{#if error}}
 <div class="mb-4 p-4 bg-red-500/10 border border-red-500/20 rounded-2xl flex items-center gap-4 animate-shake">
 <div class="w-10 h-10 rounded-xl bg-red-500/20 flex items-center justify-center flex-shrink-0 text-red-500">
 <span class="material-symbols-outlined">security</span>
 </div>
 <p class="text-xs font-bold text-red-400">{{error}}</p>
 </div>
 {{/if}}

 <form action="/admin/login" method="POST" class="space-y-4">
 <div class="space-y-2">
 <label class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] ml-1">E-mail de Acesso</label>
 <div class="relative group">
 <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 group-focus-within:text-orange-500 transition-colors">alternate_email</span>
 <input type="email" name="email" required 
 class="w-full pl-11 pr-4 py-3 liquid-glass-input rounded-xl text-white text-sm font-bold outline-none border border-white/5 focus:border-orange-500/50 transition-all"
 placeholder="exemplo@malha3d.com">
 </div>
 </div>

 <div class="space-y-2">
 <div class="flex justify-between items-center px-1">
 <label class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Senha Secreta</label>
 <a href="/admin/forgot-password" class="text-[10px] font-black text-orange-500/60 hover:text-orange-500 uppercase tracking-widest">Esqueceu?</a>
 </div>
 <div class="relative group">
 <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 group-focus-within:text-orange-500 transition-colors">lock</span>
 <input type="password" name="password" id="password" required 
 class="w-full pl-11 pr-11 py-3 liquid-glass-input rounded-xl text-white text-sm font-bold outline-none border border-white/5 focus:border-orange-500/50 transition-all"
 placeholder="••••••••">
 <button type="button" id="togglePassword" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-orange-500 transition-colors">
 <span class="material-symbols-outlined text-lg" id="eyeIcon">visibility</span>
 </button>
 </div>
 </div>

 <div class="flex items-center gap-3">
 <input type="checkbox" id="remember-me" name="remember-me" class="w-5 h-5 liquid-glass-checkbox rounded-lg cursor-pointer accent-orange-500">
 <label for="remember-me" class="text-[10px] font-black text-gray-500 uppercase tracking-widest cursor-pointer select-none">Manter sessão ativa</label>
 </div>

 <button type="submit" class="w-full py-4 liquid-glass-btn rounded-xl text-white font-black uppercase tracking-[0.2em] text-xs shadow-xl shadow-orange-500/20 ] ] transition-all bg-gradient-to-r from-orange-500 to-orange-600 flex items-center justify-center gap-3">
 Entrar no Sistema
 <span class="material-symbols-outlined text-base">arrow_forward</span>
 </button>
 </form>

 <div class="mt-6 space-y-4">
 <div class="text-center pt-2">
 <p class="text-[10px] font-black text-gray-600 uppercase tracking-widest">Ainda não tem acesso?</p>
 <button type="button" data-bs-toggle="modal" data-bs-target="#registerModal" class="mt-2 text-xs font-black text-white hover:text-orange-500 transition-colors uppercase tracking-[0.2em] flex items-center justify-center gap-2 group w-full">
 Criar cadastro
 <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform text-orange-500">person_add</span>
 </button>
 </div>
 </div>
 </div>
 </div>

 <!-- Registration Modal -->
 <div class="modal fade" id="registerModal" tabindex="-1" aria-hidden="true">
 <div class="modal-dialog modal-dialog-centered modal-lg">
 <div class="modal-content liquid-glass border-white/10 rounded-[2.5rem] overflow-hidden bg-[#050505]/95">
 <div class="modal-header border-white/5 p-8">
 <h5 class="modal-title text-2xl font-black text-white tracking-tight flex items-center gap-3">
 <span class="material-symbols-outlined text-orange-500">rocket_launch</span>
 Nova Identidade
 </h5>
 <button type="button" class="btn-close btn-close-white opacity-30 hover:opacity-100" data-bs-dismiss="modal"></button>
 </div>
 <div class="modal-body p-10">
 <form action="/admin/register" method="POST" class="space-y-6">
 <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
 <div class="space-y-2">
 <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Primeiro Nome</label>
 <input name="firstName" type="text" required class="w-full px-5 py-4 liquid-glass-input rounded-2xl text-white text-sm font-bold outline-none border border-white/5 focus:border-orange-500/50">
 </div>
 <div class="space-y-2">
 <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Sobrenome</label>
 <input name="lastName" type="text" required class="w-full px-5 py-4 liquid-glass-input rounded-2xl text-white text-sm font-bold outline-none border border-white/5 focus:border-orange-500/50">
 </div>
 </div>
 <div class="space-y-2">
 <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">E-mail Corporativo</label>
 <input name="email" type="email" required class="w-full px-5 py-4 liquid-glass-input rounded-2xl text-white text-sm font-bold outline-none border border-white/5 focus:border-orange-500/50">
 </div>
 <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
 <div class="space-y-2">
 <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Senha</label>
 <input name="password" type="password" required class="w-full px-5 py-4 liquid-glass-input rounded-2xl text-white text-sm font-bold outline-none border border-white/5 focus:border-orange-500/50">
 </div>
 <div class="space-y-2">
 <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Confirmar Senha</label>
 <input name="confirmPassword" type="password" required class="w-full px-5 py-4 liquid-glass-input rounded-2xl text-white text-sm font-bold outline-none border border-white/5 focus:border-orange-500/50">
 </div>
 </div>
 <button type="submit" class="w-full py-5 liquid-glass-btn rounded-2xl text-white font-black uppercase tracking-[0.2em] text-xs bg-orange-500 shadow-xl shadow-orange-500/20">
 Criar Conta Agora
 </button>
 </form>
 </div>
 </div>
 </div>
 </div>
</div>

<style>
 .liquid-glass {
 background: rgba(255, 255, 255, 0.04);
 backdrop-filter: blur(24px) saturate(140%);
 -webkit-backdrop-filter: blur(24px) saturate(140%);
 border: 1px solid rgba(255, 255, 255, 0.10);
 box-shadow:
 0 10px 35px 0 rgba(0, 0, 0, 0.65),
 inset 0 0 70px rgba(255, 255, 255, 0.02);
 position: relative;
 z-index: 1;
 }

 .liquid-glass::after {
 content: '';
 position: absolute;
 top: 0;
 left: -100%;
 width: 50%;
 height: 100%;
 background: linear-gradient(
 to right,
 transparent,
 rgba(249, 115, 22, 0.15),
 transparent
 );
 transform: skewX(-25deg);
 animation: glass-shimmer 8s infinite linear;
 pointer-events: none;
 }

 @keyframes glass-shimmer {
 0% { left: -100%; }
 20% { left: 200%; }
 100% { left: 200%; }
 }

 .liquid-glass-input {
 background: rgba(255, 255, 255, 0.06);
 border: 1px solid rgba(255, 255, 255, 0.12);
 backdrop-filter: blur(5px);
 box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.2);
 }

 .liquid-glass-btn {
 background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
 backdrop-filter: blur(10px);
 border: 1px solid rgba(249, 115, 22, 0.28);
 box-shadow: 0 10px 25px rgba(249, 115, 22, 0.18);
 transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
 }

 .liquid-glass-btn:hover {
 background: linear-gradient(135deg, #ea580c 0%, #f97316 100%);
 border-color: rgba(255, 255, 255, 0.2);
 box-shadow: 0 12px 30px rgba(249, 115, 22, 0.24);
 }

 .liquid-glass-checkbox {
 background: rgba(255, 255, 255, 0.06);
 border: 1px solid rgba(255, 255, 255, 0.12);
 }

 @keyframes shake {
 0%, 100% { transform: translateX(0); }
 25% { transform: translateX(-8px); }
 75% { transform: translateX(8px); }
 }
 .animate-shake { animation: shake 0.4s ease-in-out 0s 2; }
</style>

<script>
 document.addEventListener('DOMContentLoaded', () => {
 const passwordInput = document.getElementById('password');
 const toggleBtn = document.getElementById('togglePassword');
 const eyeIcon = document.getElementById('eyeIcon');

 toggleBtn?.addEventListener('click', () => {
 const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
 passwordInput.setAttribute('type', type);
 eyeIcon.textContent = type === 'password' ? 'visibility' : 'visibility_off';
 });
 });
</script>
