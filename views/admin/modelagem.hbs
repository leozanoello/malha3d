 <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
 <script>
 // Calculate and populate forecast on load
 document.addEventListener('DOMContentLoaded', () => {
 const rawBudgets = {{{json budgets}}};
 let minVal = 0;
 let avgVal = 0;
 let maxVal = 0;
 let mornosCount = 0;
 
 rawBudgets.forEach(b => {
 const val = parseFloat(b.estimatedValue) || 0;
 const prob = parseFloat(b.probability) || 0;
 
 maxVal += val;
 avgVal += (val * (prob / 100));
 if (prob >= 80) {
 minVal += val;
 }
 if (prob >= 30 && prob <= 70) {
 mornosCount++;
 }
 });
 
 const formatBRL = (num) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(num);
 
 const elMin = document.getElementById('val-min');
 const elAvg = document.getElementById('val-avg');
 const elMax = document.getElementById('val-max');
 if (elMin) elMin.textContent = formatBRL(minVal);
 if (elAvg) elAvg.textContent = formatBRL(avgVal);
 if (elMax) elMax.textContent = formatBRL(maxVal);

 const elInsightMornos = document.getElementById('ai-insight-mornos');
 const elInsightMax = document.getElementById('ai-insight-max');
 if (elInsightMornos) elInsightMornos.textContent = mornosCount;
 if (elInsightMax) elInsightMax.textContent = formatBRL(maxVal);

 // Gráfico de Previsão
 const ctx = document.getElementById('forecastChart');
 if (ctx) {
 // Nomes dos meses (2 passados, 1 atual, 2 futuros)
 const now = new Date();
 const months = [];
 for(let i = -2; i <= 2; i++) {
 const d = new Date(now.getFullYear(), now.getMonth() + i, 1);
 let m = d.toLocaleDateString('pt-BR', { month: 'short' }).toUpperCase();
 if (i === 0) m += ' (ATUAL)';
 months.push(m);
 }

 // Dados mockados para os meses passados e futuros com base no atual (Apenas visual ilustrativo)
 const dataMin = [minVal*0.7, minVal*0.9, minVal, minVal*1.1, minVal*1.3];
 const dataAvg = [avgVal*0.75, avgVal*0.85, avgVal, avgVal*1.2, avgVal*1.4];
 const dataMax = [maxVal*0.8, maxVal*0.9, maxVal, maxVal*1.15, maxVal*1.35];

 new Chart(ctx, {
 type: 'bar',
 data: {
 labels: months,
 datasets: [
 {
 label: 'Mínima (Pessimista)',
 data: dataMin,
 backgroundColor: 'rgba(248, 113, 113, 0.8)', // red-400
 borderRadius: 4
 },
 {
 label: 'Média (Realista)',
 data: dataAvg,
 backgroundColor: 'rgba(251, 146, 60, 0.8)', // orange-400
 borderRadius: 4
 },
 {
 label: 'Máxima (Otimista)',
 data: dataMax,
 backgroundColor: 'rgba(52, 211, 153, 0.8)', // emerald-400
 borderRadius: 4
 }
 ]
 },
 options: {
 responsive: true,
 maintainAspectRatio: false,
 plugins: {
 legend: { labels: { color: '#9ca3af', font: { family: 'Inter', weight: 'bold' } } },
 tooltip: {
 callbacks: {
 label: function(context) { return formatBRL(context.raw); }
 }
 }
 },
 scales: {
 y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#9ca3af', callback: (val) => 'R$ ' + (val/1000) + 'k' } },
 x: { grid: { display: false }, ticks: { color: '#9ca3af', font: { weight: 'bold' } } }
 }
 }
 });
 }
 });
 </script>
 </div>
 {{/if}}

