};

// === CHECKLIST ENTREGÁVEIS - Progresso ===
window.updateChecklistProgress = function() {
  const checkboxes = document.querySelectorAll('#modal-tab-checklist input[type="checkbox"][id^="chk"]');
  let total = checkboxes.length;
  let checked = 0;
  checkboxes.forEach(cb => { if (cb.checked) checked++; });
  const pct = total > 0 ? Math.round((checked / total) * 100) : 0;
  const pctEl = document.getElementById('checklistProgress');
  const barEl = document.getElementById('checklistProgressBar');
  if (pctEl) pctEl.textContent = pct + '%';
  if (barEl) barEl.style.width = pct + '%';
};

document.addEventListener('DOMContentLoaded', function() {
  // Auto-atualizar cronograma ao mudar valores
  const tv = document.getElementById('editTotalValue');
  const ic = document.getElementById('editInstallmentsCount');
  const fd = document.getElementById('editFirstDueDate');
  [tv, ic, fd].forEach(el => {
    if (el) el.addEventListener('change', window.regeneratePaymentSchedule);
    if (el) el.addEventListener('input', window.regeneratePaymentSchedule);
  });
  // Auto-atualizar checklist
  document.querySelectorAll('#modal-tab-checklist input[type="checkbox"][id^="chk"]').forEach(cb => {
    cb.addEventListener('change', window.updateChecklistProgress);
  });
  // Mostrar campo custom quando "Outros" for selecionado (Modelagem)
  const mtEdit = document.getElementById('editModelagemType');
  if (mtEdit) {
    mtEdit.addEventListener('change', function() {
      const wrap = document.getElementById('editModelagemTypeCustomWrap');
      if (wrap) wrap.classList.toggle('hidden', this.value !== 'Outros');
    });
  }
});
</script>
