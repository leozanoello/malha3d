 const projectId = window._currentLeadId;
 if (!projectId) return;
 const key = getPlanKey(projectId);
 let data;
 try { data = JSON.parse(localStorage.getItem(key) || '{}'); } catch (e) { data = { columns: [] }; }
 data.columns = (data.columns || []).filter(c => c.id !== colId);
 try { localStorage.setItem(key, JSON.stringify(data)); } catch (e) {}
 renderPlanejamento(data, projectId);
};

