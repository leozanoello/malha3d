window.savePlanejamentoColumn = function(projectId) {
 const title = document.getElementById('planColTitle')?.value?.trim();
 if (!title) {
  if (window.showToast) window.showToast('Digite o nome da coluna', 'error');
  document.getElementById('planColTitle')?.focus();
  return;
 }

 const key = getPlanKey(projectId);
 let data;
 try { data = JSON.parse(localStorage.getItem(key) || '{}'); } catch (e) { data = { columns: [] }; }
 if (!data.columns) data.columns = [];
 data.columns.push({
  id: 'c' + Date.now(),
  title: title,
  color: '#' + Math.floor(Math.random() * 16777215).toString(16).padStart(6, '0'),
  cards: []
 });
 try { localStorage.setItem(key, JSON.stringify(data)); } catch (e) {}

 if (window.showToast) window.showToast('✓ Coluna criada!', 'success');
 document.getElementById('planejamentoColModal')?.remove();
 renderPlanejamento(data, projectId);
};

window.removePlanejamentoColumn = function(colId) {
