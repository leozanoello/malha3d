  bannerEl.dataset.bannerIndex = idx;
  bannerEl.style.backgroundImage = "url('" + banners[idx] + "')";
  bannerEl.dataset.pendingBanner = banners[idx];
};

// === SALVAR BANNER NO CARD (persiste no banco) ===
window.saveLeadBanner = async function() {
  const leadId = window._currentLeadId;
  if (!leadId) { if (window.showToast) window.showToast('Abra um card primeiro', 'error'); return; }
  const bannerEl = document.getElementById('modalLeadBanner');
  if (!bannerEl) return;
  const imageUrl = bannerEl.dataset.pendingBanner || bannerEl.style.backgroundImage.replace(/^url\(['"]?/, '').replace(/['"]?\)$/, '');
  if (!imageUrl) { if (window.showToast) window.showToast('Nenhum banner selecionado', 'error'); return; }
  try {
    const res = await fetch('/admin/api/negociacoes/' + leadId + '/save-banner', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ imageUrl })
    });
    const data = await res.json();
    if (data.success) {
      if (window.showToast) window.showToast('Banner salvo!', 'success');
      const cardEl = document.querySelector('[data-id="' + leadId + '"]');
      if (cardEl) { const imgEl = cardEl.querySelector('img'); if (imgEl) imgEl.src = imageUrl; }
      delete bannerEl.dataset.pendingBanner;
    } else { if (window.showToast) window.showToast(data.error || 'Erro', 'error'); }
  } catch (e) { if (window.showToast) window.showToast('Erro de rede', 'error'); }
};

// === UPLOAD DE BANNER PERSONALIZADO ===
window.uploadLeadBanner = function() {
  const leadId = window._currentLeadId;
  if (!leadId) { if (window.showToast) window.showToast('Abra um card primeiro', 'error'); return; }
  const input = document.createElement('input');
  input.type = 'file'; input.accept = 'image/*';
  input.onchange = async function() {
    const file = this.files[0]; if (!file) return;
    const formData = new FormData(); formData.append('banner', file);
    try {
      const res = await fetch('/admin/api/negociacoes/' + leadId + '/upload-banner', { method: 'POST', body: formData });
      const data = await res.json();
      if (data.success) {
        const bannerEl = document.getElementById('modalLeadBanner');
        if (bannerEl) { bannerEl.style.backgroundImage = "url('" + data.imageUrl + "')"; }
        if (window.showToast) window.showToast('Banner enviado e salvo!', 'success');
        const cardEl = document.querySelector('[data-id="' + leadId + '"]');
        if (cardEl) { const imgEl = cardEl.querySelector('img'); if (imgEl) imgEl.src = data.imageUrl; }
      } else { if (window.showToast) window.showToast(data.error || 'Erro', 'error'); }
    } catch (e) { if (window.showToast) window.showToast('Erro de rede', 'error'); }
  };
  input.click();
};

