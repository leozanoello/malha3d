// === VIACEP: Auto-preenchimento de endereço ===
window.autoFillCep = async function(cep, prefix) {
  const clean = (cep || '').replace(/\D/g, '');
  prefix = prefix || 'newProject';
  const rua = document.getElementById(prefix + 'Rua');
  const bairro = document.getElementById(prefix + 'Bairro');
  const estado = document.getElementById(prefix + 'Estado');
  const cidade = document.getElementById(prefix + 'Cidade');
  const numero = document.getElementById(prefix + 'Numero');
  const cepInput = document.getElementById(prefix + 'Cep');

  if (clean.length !== 8) return;

  // ETAPA 1: Feedback visual — mostrar "Buscando..."
  if (rua) rua.placeholder = 'Buscando endereço...';
  if (bairro) bairro.placeholder = 'Buscando...';
  if (estado) estado.placeholder = '...';
  if (cidade) cidade.placeholder = 'Buscando...';

  try {
    // ETAPA 2: Consumo da API ViaCEP
    const res = await fetch(`https://viacep.com.br/ws/${clean}/json/`);
    const data = await res.json();

    if (data.erro) {
      // CEP não encontrado — limpar campos e avisar
      if (rua) { rua.value = ''; rua.placeholder = 'CEP não encontrado'; }
      if (bairro) { bairro.value = ''; bairro.placeholder = 'Não encontrado'; }
      if (estado) { estado.value = ''; estado.placeholder = '--'; }
      if (cidade) { cidade.value = ''; cidade.placeholder = 'Não encontrado'; }
      if (window.showToast) window.showToast('CEP não encontrado. Verifique o número.', 'error');
      return;
    }

    // ETAPA 3: Injeção de dados nos campos
    if (rua) { rua.value = data.logradouro || ''; rua.placeholder = 'Rua'; }
    if (bairro) { bairro.value = data.bairro || ''; bairro.placeholder = 'Bairro'; }
    if (estado) { estado.value = data.uf || ''; estado.placeholder = 'UF'; }
    if (cidade) { cidade.value = data.localidade || ''; cidade.placeholder = 'Cidade'; }

    // UX: Mover foco automaticamente para o campo NÚMERO
    if (numero) {
      setTimeout(function() { numero.focus(); }, 100);
    }
  } catch (e) {
    // Erro de rede
    if (rua) rua.placeholder = 'Erro de rede';
    if (window.showToast) window.showToast('Erro ao buscar CEP. Verifique sua conexão.', 'error');
  }
};

