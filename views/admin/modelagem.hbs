// === BULK EDIT MODE ===
window.bulkModeActive = false;
let selectedLeads = new Set();

window.toggleBulkMode = function() {
  window.bulkModeActive = !window.bulkModeActive;
  const btn = document.getElementById('btn-bulk-edit');
  const checkboxes = document.querySelectorAll('.kanban-card-checkbox');
  const bulkToolbar = document.getElementById('bulk-toolbar');

  if (window.bulkModeActive) {
    btn.classList.add('bg-orange-500', 'border-orange-500');
    checkboxes.forEach(cb => cb.classList.remove('hidden'));
    if (bulkToolbar) bulkToolbar.classList.remove('hidden');
    selectedLeads.clear();
  } else {
    btn.classList.remove('bg-orange-500', 'border-orange-500');
    checkboxes.forEach(cb => {
      cb.classList.add('hidden');
      cb.checked = false;
    });
    if (bulkToolbar) bulkToolbar.classList.add('hidden');
    selectedLeads.clear();
  }
};

window.toggleLeadSelection = function(leadId, checkbox) {
  if (checkbox.checked) {
    selectedLeads.add(leadId);
  } else {
    selectedLeads.delete(leadId);
  }
  updateBulkToolbar();
};

function updateBulkToolbar() {
  const toolbar = document.getElementById('bulk-toolbar');
  const count = document.getElementById('bulk-count');
  if (toolbar) {
    if (selectedLeads.size > 0) {
      toolbar.classList.remove('hidden');
      if (count) count.innerText = selectedLeads.size;
    } else {
      toolbar.classList.add('hidden');
    }
  }
}

window.bulkTrashLeads = async function() {
  if (selectedLeads.size === 0) return;
  if (!confirm(`Mover ${selectedLeads.size} lead(s) para lixeira?`)) return;

  try {
    for (const leadId of selectedLeads) {
      await fetch(`/admin/negociacoes/${leadId}/update-status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: 'trash' })
      });
    }
    location.reload();
  } catch (err) {
    console.error(err);
    alert('Erro ao mover para lixeira');
  }
};

window.bulkDeleteLeads = async function() {
  if (selectedLeads.size === 0) return;
  if (!confirm(`Apagar permanentemente ${selectedLeads.size} lead(s)? Isto não pode ser desfeito.`)) return;

  try {
    for (const leadId of selectedLeads) {
      await fetch(`/admin/api/negociacoes/${leadId}`, { method: 'DELETE' });
    }
    location.reload();
  } catch (err) {
    console.error(err);
    alert('Erro ao apagar leads');
  }
};

