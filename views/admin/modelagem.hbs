window.formatCurrencyInput = function(input) {
 let v = input.value.replace(/\D/g, '');
 if (!v) { input.value = ''; return; }
 v = (parseInt(v) / 100).toFixed(2);
 v = v.replace('.', ',');
 v = v.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
 input.value = v;
};

