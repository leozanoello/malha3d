 briefingRow('Prazo (Dias)', data.productionDays),
 briefingRow('Valor Estimado', data.estimatedValue ? `R$ ${parseFloat(data.estimatedValue).toLocaleString('pt-BR', { minimumFractionDigits: 2 })}` : ''),
