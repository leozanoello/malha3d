 // LOG DEBUG
 console.log('[SAVE PROJECT] submitNewLead disparado!');

 if (submitBtn) {
  submitBtn.disabled = true;
  submitBtn.innerHTML = '<span class="material-symbols-outlined text-sm">sync</span> Salvando...';
 }

 const formData = new FormData(form);
 const data = Object.fromEntries(formData.entries());
 // Converter datas BR (DD/MM/AAAA) para ISO (YYYY-MM-DD)
 if (data.dataGanhoOportunidade) data.dataGanhoOportunidade = convertBrDateToIso(data.dataGanhoOportunidade);
 if (data.expectativaInicio) data.expectativaInicio = convertBrDateToIso(data.expectativaInicio);

 console.log('[SAVE PROJECT] Payload:', JSON.stringify(data).substring(0, 200));
 try {
 const res = await fetch('/admin/negociacoes/novo', {
 method: 'POST',
 headers: {
 'Content-Type': 'application/json',
 'Accept': 'application/json'
 },
 body: JSON.stringify(data)
 });
 console.log('[SAVE PROJECT] Response status:', res.status);
 const json = await res.json();
 console.log('[SAVE PROJECT] Response:', JSON.stringify(json).substring(0, 200));
 if (json.success) {
 // Limpar draft do autosave
 if (window.clearFormDraft) window.clearFormDraft('newLeadForm');
 // Fechar modal
 document.getElementById('newLeadModal').classList.add('hidden');
 document.getElementById('newLeadModal').style.display = 'none';
 // Toast de sucesso (com feedback financeiro)
 var successMsg = 'Projeto criado com sucesso!';
 if (json.financeCreated) successMsg += ' Receita lançada no Financeiro.';
 if (window.showToast) window.showToast(successMsg, 'success');
 else alert(successMsg);
 // Inserir card no kanban sem reload
 setTimeout(() => window.location.reload(), 800);
 } else if (json.errors) {
 // Erro de validação do backend
 json.errors.forEach(err => {
 const el = form.querySelector(`[name="${err.field}"]`);
 if (el) {
 el.classList.remove('border-white/10');
 el.classList.add('border-red-500');
 const errorSpan = document.createElement('span');
 errorSpan.className = 'field-error text-[8px] text-red-400 font-bold mt-0.5 block';
 errorSpan.textContent = '⚠ ' + err.message;
 el.parentElement.appendChild(errorSpan);
 }
 });
 submitBtn.disabled = false;
 submitBtn.innerHTML = originalText;
 } else {
 if (window.showToast) window.showToast('Erro: ' + (json.error || 'Falha ao criar'), 'error');
 else alert('Erro ao criar projeto: ' + (json.error || 'Erro desconhecido'));
 submitBtn.disabled = false;
 submitBtn.innerHTML = originalText;
 }
 } catch (err) {
 if (window.showToast) window.showToast('Erro de rede ao salvar projeto', 'error');
 else alert('Erro de rede.');
 submitBtn.disabled = false;
 submitBtn.innerHTML = originalText;
 }
 };

