<script>
document.addEventListener('DOMContentLoaded', function() {
 window._currentUserId = '{{user.id}}';

 // === TAB SWITCHING ===
 function switchTab(tabId, el) {
 document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
 const targetTab = document.getElementById(`tab-${tabId}`);
 if (targetTab) targetTab.classList.remove('hidden');
 
 document.querySelectorAll('.tab-btn-nav').forEach(btn => {
 btn.classList.remove('bg-orange-500', 'text-white', 'shadow-xl', 'shadow-orange-500/20');
 btn.classList.add('text-gray-500');
 });
 
 el.classList.add('bg-orange-500', 'text-white', 'shadow-xl', 'shadow-orange-500/20');
 el.classList.remove('text-gray-500');

 if (tabId === 'forecast') initForecastChart();
 if (tabId === 'templates') loadTemplates();
 }

 document.querySelectorAll('.tab-btn-nav').forEach(btn => {
 btn.addEventListener('click', function() {
 switchTab(this.dataset.tab, this);
 });
 });

 // === MODAL TAB SWITCHING ===
 function switchModalTab(tabId, el) {
 document.querySelectorAll('.modal-pane').forEach(p => p.classList.add('hidden'));
 // Primeiro tenta ID padrão, depois tenta data-pane-id
 let target = document.getElementById(`modal-tab-${tabId}`);
 if (!target) {
 target = document.querySelector(`[data-pane-id="modal-tab-${tabId}"]`);
 }
 if (target) target.classList.remove('hidden');
 
 document.querySelectorAll('.modal-tab-btn').forEach(btn => btn.classList.remove('active'));
 el.classList.add('active');
 }

 document.querySelectorAll('.modal-tab-btn').forEach(btn => {
 btn.addEventListener('click', function() {
 switchModalTab(this.dataset.tab, this);
 });
 });

 // === EDIT MODE LOGIC ===
 const editLeadForm = document.getElementById('editLeadForm');
 const btnEditToggle = document.getElementById('btn-edit-toggle');
 const btnCancelEdit = document.getElementById('btn-cancel-edit');
 const editActions = document.getElementById('edit-actions');

 function toggleEditMode(enabled) {
 if (!editLeadForm) return;
 const inputs = editLeadForm.querySelectorAll('input, select, textarea');
 inputs.forEach(input => {
 if (input.name !== 'id') {
 input.disabled = !enabled;
 }
 });
 
 if (enabled) {
 editActions?.classList.remove('hidden');
 btnEditToggle?.classList.add('hidden');
 } else {
 editActions?.classList.add('hidden');
 btnEditToggle?.classList.remove('hidden');
 }
 }

 btnEditToggle?.addEventListener('click', () => toggleEditMode(true));
 btnCancelEdit?.addEventListener('click', () => toggleEditMode(false));

 // === AI BANNER BACKFILL ===
 window.generateMissingLeadImages = function() {
 const btn = document.getElementById('btn-generate-ai-banners');
 if (!btn) return;
 const originalHtml = btn.innerHTML;
 btn.disabled = true;
 btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> Gerando...';

 fetch('/admin/api/negociacoes/generate-missing-images', { method: 'POST' })
 .then(res => res.json())
 .then(data => {
 if (data.success) {
 if (window.showNotification) window.showNotification(`Imagens geradas: ${data.generated}/${data.total}`, 'success');
 if (data.generated > 0) window.location.reload();
 } else {
 if (window.showNotification) window.showNotification(data.error || 'Erro ao gerar imagens', 'error');
 }
 })
 .catch(err => {
 console.error('Generate images error:', err);
 if (window.showNotification) window.showNotification('Erro de conexão ao gerar imagens', 'error');
 })
 .finally(() => {
 btn.disabled = false;
 btn.innerHTML = originalHtml;
 });
 };

 // === LEAD TRASH & DELETE ===
 window.trashLead = async function(leadId) {
 if (!confirm('Mover este lead para a lixeira?')) return;
 try {
 const res = await fetch(`/admin/negociacoes/${leadId}/update-status`, {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ status: 'lixeira' })
 });
 if (res.ok) {
 const card = document.querySelector(`[data-id="${leadId}"]`);
 if (card) card.remove();
 } else {
 alert('Erro ao mover para lixeira');
 }
 } catch (err) {
 alert('Erro de rede');
 }
 };

 window.deleteLead = async function(leadId) {
 if (!confirm('ATENÇÃO: Apagar permanentemente este lead? Esta ação não pode ser desfeita.')) return;
 try {
 const res = await fetch(`/admin/api/negociacoes/${leadId}`, {
 method: 'DELETE',
 headers: { 'Accept': 'application/json' }
 });
 if (res.ok) {
 const card = document.querySelector(`[data-id="${leadId}"]`);
 if (card) card.remove();
 } else {
 alert('Erro ao apagar lead');
 }
 } catch (err) {
 alert('Erro de rede');
 }
 };

