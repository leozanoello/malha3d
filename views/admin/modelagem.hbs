window.selectPriority = function(btn, priority) {
 document.querySelectorAll('.priority-btn').forEach(b => {
  b.style.borderColor = 'rgba(255, 255, 255, 0.1)';
  b.style.background = 'transparent';
 });
 btn.style.borderColor = priority === 'baixa' ? 'rgba(59, 130, 246, 0.5)' : priority === 'alta' ? 'rgba(239, 68, 68, 0.5)' : 'rgba(234, 179, 8, 0.5)';
 btn.style.background = priority === 'baixa' ? 'rgba(59, 130, 246, 0.1)' : priority === 'alta' ? 'rgba(239, 68, 68, 0.1)' : 'rgba(234, 179, 8, 0.1)';
 document.getElementById('planCardPriority').value = priority;
};

window.savePlanejamentoCard = function(projectId) {
 const title = document.getElementById('planCardTitle')?.value?.trim();
 const dueDate = document.getElementById('planCardDate')?.value;
 const priority = document.getElementById('planCardPriority')?.value || 'media';

 if (!title) {
  if (window.showToast) window.showToast('Digite um título para a tarefa', 'error');
  else alert('Digite um título para a tarefa');
  document.getElementById('planCardTitle')?.focus();
  return;
 }

 if (!dueDate) {
  if (window.showToast) window.showToast('A data de entrega é obrigatória', 'error');
  else alert('A data de entrega é obrigatória');
  document.getElementById('planCardDate')?.focus();
  return;
 }

 const key = getPlanKey(projectId);
 let data;
 try { data = JSON.parse(localStorage.getItem(key) || '{}'); } catch (e) { data = { columns: [] }; }
 if (!data.columns) data.columns = [];

 data.columns[0].cards.push({
  id: 'card' + Date.now(),
  title: title,
  dueDate: dueDate,
  priority: priority
 });

 try { localStorage.setItem(key, JSON.stringify(data)); } catch (e) {}

 if (window.showToast) window.showToast('✓ Tarefa criada com sucesso!', 'success');
 document.getElementById('planejamentoCardModal')?.remove();
 renderPlanejamento(data, projectId);
};

window.convertPlanCardToTask = async function(projectId, colId, cardId) {
 if (!projectId || !cardId) return;
 const key = getPlanKey(projectId);
 let data;
 try { data = JSON.parse(localStorage.getItem(key) || '{}'); } catch (e) { data = { columns: [] }; }
 const col = data.columns.find(c => c.id === colId);
 if (!col) return;
 const card = col.cards.find(c => c.id === cardId);
 if (!card) return;
 if (!card.dueDate) {
  if (window.showToast) window.showToast('Adicione uma data ao card primeiro.', 'info');
  else alert('Adicione uma data ao card primeiro.');
  return;
 }
 try {
  const res = await fetch('/admin/api/tasks', {
   method: 'POST',
   headers: { 'Content-Type': 'application/json' },
   body: JSON.stringify({
    title: card.title,
    dueDate: card.dueDate,
    priority: card.priority || 'media',
    status: 'a_fazer'
   })
  });
  const json = await res.json();
  if (json.success) {
   if (window.showToast) window.showToast('✓ Tarefa criada! Aparecerá em Dashboard → Próximas Tarefas.', 'success');
   else alert('Tarefa criada no sistema!');
  } else {
   if (window.showToast) window.showToast('Erro: ' + (json.error || 'Desconhecido'), 'error');
   else alert('Erro: ' + (json.error || 'Desconhecido'));
  }
 } catch (err) {
  if (window.showToast) window.showToast('Erro de rede ao criar tarefa.', 'error');
  else alert('Erro de rede ao criar tarefa.');
 }
};

// Carrega planejamento automaticamente quando o modal abrir
