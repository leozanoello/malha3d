window.savePlanejamento = function() {
 const projectId = window._currentLeadId;
 if (!projectId) return;
 const container = document.getElementById('planejamentoColumns');
 if (!container) return;
 const cols = Array.from(container.querySelectorAll('[data-col-id]'));
 // Filtrar colunas-coluna (que têm data-col-id igual ao título)
 const columns = [];
 let lastCol = null;
 const seenCols = new Set();
 cols.forEach(el => {
  const colId = el.dataset.colId;
  if (!seenCols.has(colId) && el.classList.contains('flex-shrink-0')) {
   seenCols.add(colId);
   const title = el.querySelector('h5')?.textContent || 'Coluna';
   const color = el.querySelector('div[style*="background"]')?.style.background || '#f97316';
   const cards = Array.from(el.querySelectorAll('.plan-card')).map(c => ({
    id: c.dataset.cardId,
    title: c.querySelector('p')?.textContent || '',
    dueDate: c.querySelector('p.text-orange-400')?.textContent.replace(/[^\d/]/g, '') || null,
    priority: c.querySelector('span.text-gray-500')?.textContent || 'media'
   }));
   columns.push({ id: colId, title, color, cards });
  }
 });
 // Salvar colunas reais (apenas containers que são colunas)
 const data = { columns: columns.filter(c => c.id && c.id.length < 10) };
 try {
  localStorage.setItem(getPlanKey(projectId), JSON.stringify(data));
 } catch (e) {}
};

