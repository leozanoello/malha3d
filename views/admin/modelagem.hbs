window.populateResponsavelOptions = function(index) {
  const teamListEl = document.getElementById(`respTeamList_${index}`);
  const freelancerListEl = document.getElementById(`respFreelancerList_${index}`);

  if (!teamListEl || !freelancerListEl) return;

  // Tentar buscar dados dos usuários do JSON oculto no modal
  let usersData = [];
  const usersJsonEl = document.getElementById('usersDataJson');
  if (usersJsonEl && usersJsonEl.textContent) {
    try {
      usersData = JSON.parse('[' + usersJsonEl.textContent + ']');
    } catch (e) {
      // Se falhar, tentar extrair do primeiro select
      const firstSelect = document.querySelector('select[name="assignedUserId[]"]');
      if (firstSelect) {
        Array.from(firstSelect.options).forEach(opt => {
          if (opt.value) {
            usersData.push({ id: opt.value, name: opt.text, role: opt.text.includes('(Freelancer)') ? 'freelancer' : 'user' });
          }
        });
      }
    }
  }

  let teamHtml = '', freelancerHtml = '';
  usersData.forEach(user => {
    const isFreelancer = user.role === 'freelancer';
    const html = `<button type="button" onclick="window.selectResponsavel(${index}, '${user.id}', '${user.name}')" class="w-full text-left px-2 py-1.5 rounded text-[9px] text-gray-300 hover:bg-white/10 hover:text-white transition-all">
     <span class="material-symbols-outlined text-[10px] align-middle">${isFreelancer ? 'engineering' : 'person'}</span> ${user.name}
