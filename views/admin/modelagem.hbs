// === SISTEMA FINANCEIRO (Cronograma de Pagamento) ===
window.regeneratePaymentSchedule = function() {
  const total = parseFloat(document.getElementById('editTotalValue')?.value || 0);
  const count = parseInt(document.getElementById('editInstallmentsCount')?.value || 1);
  const firstDate = document.getElementById('editFirstDueDate')?.value;
  const scheduleEl = document.getElementById('editPaymentSchedule');
  const installmentValueEl = document.getElementById('editInstallmentValue');
  const totalEl = document.getElementById('editFinanceTotal');

  if (!scheduleEl) return;
  if (total > 0 && count > 0) {
    const perInstallment = (total / count).toFixed(2);
    if (installmentValueEl) installmentValueEl.value = 'R$ ' + parseFloat(perInstallment).toLocaleString('pt-BR', {minimumFractionDigits: 2});
    if (totalEl) totalEl.textContent = 'R$ ' + total.toLocaleString('pt-BR', {minimumFractionDigits: 2});

    let html = '';
    const startDate = firstDate ? new Date(firstDate) : new Date();
    for (let i = 0; i < count; i++) {
      const dueDate = new Date(startDate);
      dueDate.setMonth(dueDate.getMonth() + i);
      const dueStr = dueDate.toISOString().split('T')[0];
      html += `<div class="flex items-center gap-2 p-2 rounded-lg bg-black/30 border border-white/5">
        <span class="w-6 h-6 rounded-md bg-orange-500/20 border border-orange-500/30 flex items-center justify-center text-[10px] font-black text-orange-400 shrink-0">${i + 1}</span>
        <input type="text" readonly value="R$ ${parseFloat(perInstallment).toLocaleString('pt-BR', {minimumFractionDigits: 2})}" class="w-24 bg-transparent text-xs text-white font-bold border-none">
        <input type="date" name="paymentSchedule[]" value="${dueStr}" class="flex-1 bg-white/5 border border-white/10 rounded-lg px-2 py-1.5 text-xs text-white focus:border-orange-500 focus:outline-none">
        <select name="paymentStatus[]" class="bg-white/5 border border-white/10 rounded-lg px-2 py-1.5 text-xs text-white focus:border-orange-500 focus:outline-none">
          <option value="pendente">Pendente</option>
          <option value="pago">Pago</option>
        </select>
      </div>`;
    }
    scheduleEl.innerHTML = html;
    updateFinanceReceived();
  } else {
    scheduleEl.innerHTML = '<p class="text-[10px] text-gray-500 text-center py-2">Preencha valor e parcelas para gerar cronograma</p>';
    if (installmentValueEl) installmentValueEl.value = '';
    if (totalEl) totalEl.textContent = 'R$ 0,00';
  }
};

window.updateFinanceReceived = function() {
  const selects = document.querySelectorAll('#editPaymentSchedule select[name="paymentStatus[]"]');
  const inputs = document.querySelectorAll('#editPaymentSchedule input[readonly]');
  let received = 0;
  let total = parseFloat(document.getElementById('editTotalValue')?.value || 0);
  selects.forEach((sel, idx) => {
    if (sel.value === 'pago' && inputs[idx]) {
      const v = parseFloat(inputs[idx].value.replace(/[^\d,]/g, '').replace(',', '.'));
      if (!isNaN(v)) received += v;
    }
  });
  const receivedEl = document.getElementById('editFinanceReceived');
  const pendingEl = document.getElementById('editFinancePending');
  if (receivedEl) receivedEl.textContent = 'R$ ' + received.toLocaleString('pt-BR', {minimumFractionDigits: 2});
  if (pendingEl) pendingEl.textContent = 'R$ ' + (total - received).toLocaleString('pt-BR', {minimumFractionDigits: 2});
};

