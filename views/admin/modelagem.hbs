 // === LEAD TASK CHECKLIST (Pane: Tarefas) ===
 const PRIORITY_STYLE = {
 alta: 'bg-red-500/10 text-red-400 border-red-500/20',
 media: 'bg-orange-500/10 text-orange-400 border-orange-500/20',
 baixa: 'bg-blue-500/10 text-blue-400 border-blue-500/20'
 };

 function renderTaskList(tasks, suggestions) {
 const listEl = document.getElementById('taskList');
 const counterEl = document.getElementById('tasksCounter');
 const suggestionsEl = document.getElementById('taskSuggestions');
 if (!listEl) return;

 const pending = tasks.filter(t => t.status !== 'concluida');
 if (counterEl) counterEl.textContent = `${pending.length} pendente(s) / ${tasks.length} total`;

 if (tasks.length === 0) {
 listEl.innerHTML = '<p class="text-[10px] text-gray-500 text-center py-4">Nenhuma tarefa ainda. Adicione uma acima.</p>';
 } else {
 const now = new Date();
 listEl.innerHTML = tasks.map(t => {
 const isDone = t.status === 'concluida';
 const isOverdue = !isDone && t.dueDate && new Date(t.dueDate) < now;
 const dueLabel = t.dueDate ? new Date(t.dueDate).toLocaleDateString('pt-BR') : '';
 const prioClass = PRIORITY_STYLE[t.priority] || PRIORITY_STYLE.media;
 return `
 <div class="flex items-center gap-2 p-2 rounded-lg border ${isOverdue ? 'border-red-500/30 bg-red-500/5' : 'border-white/5 bg-white/[0.02]'}">
 <button type="button" onclick="window.toggleTaskStatus('${t.id}', '${isDone ? 'ativa' : 'concluida'}')" class="w-5 h-5 rounded-md border ${isDone ? 'bg-emerald-500 border-emerald-500' : 'border-white/20'} flex items-center justify-center shrink-0 transition-all">
 ${isDone ? '<span class="material-symbols-outlined text-[12px] text-white">check</span>' : ''}
 </button>
 <span class="flex-1 text-[11px] font-bold ${isDone ? 'text-gray-500 line-through' : 'text-white'} truncate">${t.title}</span>
 ${dueLabel ? `<span class="text-[8px] font-black uppercase tracking-wider ${isOverdue ? 'text-red-400' : 'text-gray-500'} shrink-0">${dueLabel}</span>` : ''}
 <span class="text-[7px] font-black uppercase px-1.5 py-0.5 rounded border ${prioClass} shrink-0">${t.priority}</span>
 <button type="button" onclick="window.deleteTask('${t.id}')" class="w-6 h-6 rounded-md text-gray-500 hover:text-red-400 hover:bg-red-500/10 flex items-center justify-center shrink-0 transition-all">
 <span class="material-symbols-outlined text-xs">close</span>
 </button>
 </div>
 `;
 }).join('');
 }

 if (suggestionsEl) {
 suggestionsEl.innerHTML = (suggestions || []).map(s => `
 <button type="button" onclick="window.addSuggestedTask('${s.title.replace(/'/g, "\\'")}', '${s.priority}', '${s.category}')" class="text-[8px] font-black uppercase tracking-wider px-2 py-1 rounded-lg bg-white/5 text-gray-400 border border-white/10 hover:bg-orange-500 hover:text-white hover:border-orange-500 transition-all flex items-center gap-1">
 <span class="material-symbols-outlined text-[10px]">auto_awesome</span> ${s.title}
 </button>
 `).join('');
 }
 }

 window.loadLeadTasks = function(leadId) {
 const listEl = document.getElementById('taskList');
 if (listEl) listEl.innerHTML = '<p class="text-[10px] text-gray-500 text-center py-4">Carregando tarefas...</p>';
 fetch(`/admin/api/negociacoes/${leadId}/tasks`)
 .then(res => res.json())
 .then(result => {
 if (result.success) renderTaskList(result.tasks, result.suggestions);
 })
 .catch(err => console.error('Load tasks error:', err));
 };

 window.toggleTaskStatus = function(taskId, newStatus) {
 fetch(`/admin/api/modelagem-tasks/${taskId}`, {
 method: 'PUT',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ status: newStatus })
 })
 .then(res => res.json())
 .then(() => { if (window._currentLeadId) window.loadLeadTasks(window._currentLeadId); })
 .catch(err => console.error('Toggle task error:', err));
 };

 window.deleteTask = function(taskId) {
 fetch(`/admin/api/modelagem-tasks/${taskId}`, { method: 'DELETE' })
 .then(res => res.json())
 .then(() => { if (window._currentLeadId) window.loadLeadTasks(window._currentLeadId); })
 .catch(err => console.error('Delete task error:', err));
 };

 window.addSuggestedTask = function(title, priority, category) {
 if (!window._currentLeadId) return;
 fetch(`/admin/api/negociacoes/${window._currentLeadId}/tasks`, {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ title, priority, category })
 })
 .then(res => res.json())
 .then(() => window.loadLeadTasks(window._currentLeadId))
 .catch(err => console.error('Add suggested task error:', err));
 };

 document.getElementById('newTaskForm')?.addEventListener('submit', function(e) {
 e.preventDefault();
 if (!window._currentLeadId) return;
 const title = document.getElementById('newTaskTitle').value.trim();
 const dueDate = document.getElementById('newTaskDueDate').value;
 const priority = document.getElementById('newTaskPriority').value;
 if (!title) return;

 fetch(`/admin/api/negociacoes/${window._currentLeadId}/tasks`, {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ title, dueDate: dueDate || null, priority, category: 'geral' })
 })
 .then(res => res.json())
 .then(result => {
 if (result.success) {
 document.getElementById('newTaskTitle').value = '';
 document.getElementById('newTaskDueDate').value = '';
 window.loadLeadTasks(window._currentLeadId);
 }
 })
 .catch(err => console.error('Add task error:', err));
 });

 // === HISTÓRICO (immutable audit trail) ===
 const HISTORY_ACTION_LABEL = {
 lead_updated: 'Lead atualizado',
 status_changed: 'Etapa alterada',
 contact_linked: 'Contato vinculado'
 };

 window.loadLeadHistory = function(leadId) {
 const listEl = document.getElementById('historyList');
 if (!listEl) return;
 listEl.innerHTML = '<p class="text-[10px] text-gray-500 text-center py-4">Carregando histórico...</p>';
 fetch(`/admin/api/negociacoes/${leadId}/logs`)
 .then(res => res.json())
 .then(result => {
 if (!result.success) return;
 if (result.logs.length === 0) {
 listEl.innerHTML = '<p class="text-[10px] text-gray-500 text-center py-4">Nenhuma alteração registrada ainda.</p>';
 return;
 }
 listEl.innerHTML = result.logs.map(log => `
 <div class="p-2.5 rounded-lg border border-white/5 bg-white/[0.02]">
 <div class="flex items-center justify-between mb-1">
 <span class="text-[9px] font-black text-orange-400 uppercase tracking-wide">${HISTORY_ACTION_LABEL[log.action] || log.action}</span>
 <span class="text-[8px] text-gray-500">${new Date(log.createdAt).toLocaleString('pt-BR')}</span>
 </div>
 <p class="text-[10px] text-gray-300">${log.details || ''}</p>
 <p class="text-[8px] text-gray-500 mt-1">por ${log.userName || 'Sistema'}</p>
 </div>
 `).join('');
 })
 .catch(err => console.error('Load history error:', err));
 };

 // === CHAT (exclusive per-lead conversation with one teammate) ===
 window.loadLeadChat = function() {
 const recipientId = document.getElementById('chatRecipientSelect').value;
 const messagesEl = document.getElementById('chatMessages');
 if (!recipientId) {
 messagesEl.innerHTML = '<p class="text-[10px] text-gray-500 text-center py-4">Selecione um colega para ver a conversa exclusiva sobre este lead.</p>';
 return;
 }
 if (!window._currentLeadId) return;
 messagesEl.innerHTML = '<p class="text-[10px] text-gray-500 text-center py-4">Carregando conversa...</p>';
 fetch(`/admin/api/negociacoes/${window._currentLeadId}/messages?withUserId=${recipientId}`)
 .then(res => res.json())
 .then(result => {
 if (!result.success) {
 messagesEl.innerHTML = `<p class="text-[10px] text-red-400 text-center py-4">${result.error || 'Erro ao carregar conversa.'}</p>`;
 return;
 }
 if (result.messages.length === 0) {
 messagesEl.innerHTML = '<p class="text-[10px] text-gray-500 text-center py-4">Nenhuma mensagem ainda. Diga olá!</p>';
 return;
 }
 messagesEl.innerHTML = result.messages.map(m => {
 const isMine = m.senderId === window._currentUserId;
 return `
 <div class="flex ${isMine ? 'justify-end' : 'justify-start'}">
 <div class="max-w-[75%] px-3 py-2 rounded-xl text-[11px] ${isMine ? 'bg-orange-500/20 text-white' : 'bg-white/10 text-gray-200'}">
 <p class="font-bold text-[9px] mb-0.5 ${isMine ? 'text-orange-300' : 'text-gray-400'}">${m.senderName || ''}</p>
 <p>${m.content}</p>
 </div>
 </div>
 `;
 }).join('');
 messagesEl.scrollTop = messagesEl.scrollHeight;
 })
 .catch(err => console.error('Load chat error:', err));
 };

 document.getElementById('chatSendForm')?.addEventListener('submit', function(e) {
 e.preventDefault();
 const recipientId = document.getElementById('chatRecipientSelect').value;
 const input = document.getElementById('chatMessageInput');
 const content = input.value.trim();
 if (!recipientId) { alert('Selecione um colega antes de enviar.'); return; }
 if (!content || !window._currentLeadId) return;

 fetch(`/admin/api/negociacoes/${window._currentLeadId}/messages`, {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ recipientId, content })
 })
 .then(res => res.json())
 .then(result => {
 if (result.success) {
 input.value = '';
 window.loadLeadChat();
 }
 })
 .catch(err => console.error('Send message error:', err));
 });

 // === SAVE LEAD CONTACT TO CONTATOS LIST ===
 window.saveLeadContact = function() {
 if (!window._currentLeadId) return;
 const btn = document.getElementById('btn-save-contact');
 const originalHtml = btn.innerHTML;
 btn.disabled = true;
 btn.innerHTML = 'Salvando...';

 fetch(`/admin/api/negociacoes/${window._currentLeadId}/save-contact`, { method: 'POST' })
 .then(res => res.json())
 .then(result => {
 if (result.success) {
 if (window.showNotification) window.showNotification('Contato adicionado à lista de Contatos!', 'success');
 } else {
 if (window.showNotification) window.showNotification(result.error || 'Erro ao salvar contato', 'error');
 else alert(result.error || 'Erro ao salvar contato');
 }
 })
 .catch(err => console.error('Save contact error:', err))
 .finally(() => {
 btn.disabled = false;
 btn.innerHTML = originalHtml;
 });
 };

 // === NATIVE DRAG & DROP ENGINE (Zero-delay, 60fps) ===
 (function() {
 const _inflight = new Map();
 let _draggedCard = null;
 let _sourceZone = null;
 let _sourceIndex = 0;

 document.addEventListener('dragstart', function(e) {
  const card = e.target.closest('.kanban-card-main');
  if (!card) return;
  _draggedCard = card;
  _sourceZone = card.closest('.kanban-drop-zone');
  _sourceIndex = Array.from(_sourceZone.children).indexOf(card);
  card.classList.add('dragging');
  e.dataTransfer.effectAllowed = 'move';
  e.dataTransfer.setData('text/plain', card.dataset.id);
  const ghost = document.createElement('div');
  ghost.textContent = card.querySelector('.kcard-title')?.textContent || 'Card';
  ghost.style.cssText = 'position:absolute;top:-9999px;left:-9999px;padding:8px 16px;background:#151515;color:#fff;border-radius:4px;font-size:11px;font-weight:900;border:1px solid rgba(249,115,22,0.4);';
  document.body.appendChild(ghost);
  e.dataTransfer.setDragImage(ghost, 60, 15);
  setTimeout(function() { ghost.remove(); }, 0);
  document.querySelectorAll('.kanban-drop-zone').forEach(function(z) { z.classList.add('drag-over'); });
 });

 document.addEventListener('dragend', function(e) {
  if (_draggedCard) _draggedCard.classList.remove('dragging');
  document.querySelectorAll('.kanban-drop-zone').forEach(function(z) { z.classList.remove('drag-over', 'drag-hover'); });
  _draggedCard = null; _sourceZone = null;
 });

 document.querySelectorAll('.kanban-drop-zone').forEach(function(zone) {
  zone.addEventListener('dragover', function(e) { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; this.classList.add('drag-hover'); });
  zone.addEventListener('dragleave', function(e) { this.classList.remove('drag-hover'); });
  zone.addEventListener('drop', function(e) {
   e.preventDefault();
   this.classList.remove('drag-hover');
   if (!_draggedCard) return;
   const newStatus = this.dataset.status;
   const leadId = _draggedCard.dataset.id;
   if (!leadId || !newStatus) return;

   this.appendChild(_draggedCard);

   if (_inflight.has(leadId)) _inflight.get(leadId).abort();
   const ctrl = new AbortController();
   _inflight.set(leadId, ctrl);
   const fromZone = _sourceZone;
   const fromIdx = _sourceIndex;
   const movedCard = _draggedCard;

   fetch('/admin/negociacoes/' + leadId + '/update-status', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ status: newStatus }), signal: ctrl.signal
   })
   .then(function(r) { return r.json(); })
   .then(function(d) {
    _inflight.delete(leadId);
    if (!d.success) {
     if (fromZone && fromZone.children[fromIdx]) fromZone.insertBefore(movedCard, fromZone.children[fromIdx]);
     else if (fromZone) fromZone.appendChild(movedCard);
     if (window.showToast) window.showToast(d.error || 'Erro', 'error');
    }
   })
   .catch(function(err) {
    _inflight.delete(leadId);
    if (err.name === 'AbortError') return;
    if (fromZone && fromZone.children[fromIdx]) fromZone.insertBefore(movedCard, fromZone.children[fromIdx]);
    else if (fromZone) fromZone.appendChild(movedCard);
   });
  });
 });
 })();

 // Auto-open lead if leadId is in URL
 const urlParams = new URLSearchParams(window.location.search);
 const leadId = urlParams.get('leadId');
 if (leadId) {
 const leadCard = document.querySelector(`.kanban-card-main[data-id="${leadId}"]`);
 if (leadCard && leadCard.dataset.lead) {
 window.manageLead(leadCard.dataset.lead);
 }
 }

