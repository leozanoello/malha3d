<div class="p-8 space-y-8 animate-in fade-in duration-500">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-4xl font-black text-white tracking-tighter flex items-center gap-4">
                <span class="material-symbols-outlined text-orange-500 text-4xl">rocket_launch</span>
                Criar Projeto
            </h1>
            <p class="text-gray-500 font-bold uppercase tracking-[0.2em] text-[10px] mt-2">Configuração técnica e lançamento oficial do projeto</p>
        </div>
        <a href="/admin/projetos/kanban" class="bg-white/5 hover:bg-white/10 text-white px-6 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest border border-white/10 transition-all flex items-center gap-2">
            <span class="material-symbols-outlined text-base">arrow_back</span> Voltar
        </a>
    </div>

    <form id="createProjectForm" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Coluna Principal -->
        <div class="lg:col-span-2 space-y-8">
            <div class="glass-card p-10 rounded-[2.5rem] border-white/5 space-y-8 relative overflow-hidden">
                <div class="absolute top-0 right-0 p-8 opacity-5">
                    <span class="material-symbols-outlined text-8xl">architecture</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 relative z-10">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Nome do Projeto</label>
                        <input type="text" name="title" value="{{budgetData.name}}" required class="input-premium py-4 rounded-2xl text-base" placeholder="Ex: Residencial Alvorada">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Categoria</label>
                        <select name="category" required class="input-premium py-4 rounded-2xl">
                            <option value="3d" {{#eq budgetData.projectType 'Modelagem 3D'}}selected{{/eq}}>Modelagem 3D</option>
                            <option value="render" {{#eq budgetData.projectType 'Renderização'}}selected{{/eq}}>Renderização</option>
                            <option value="animation" {{#eq budgetData.projectType 'Animação'}}selected{{/eq}}>Animação</option>
                            <option value="product" {{#eq budgetData.projectType 'Visualização de Produtos'}}selected{{/eq}}>Produto</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Descrição do Escopo</label>
                    <textarea name="description" rows="5" class="input-premium rounded-3xl" placeholder="Descreva os entregáveis e detalhes técnicos...">{{budgetData.description}}</textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Cliente</label>
                        <input type="text" name="client" value="{{budgetData.name}}" class="input-premium" placeholder="Nome do Cliente">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Valor (R$)</label>
                        <input type="number" name="price" value="{{budgetData.estimatedValue}}" class="input-premium" placeholder="0,00">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Ano</label>
                        <input type="number" name="year" value="2024" class="input-premium">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Prazo</label>
                        <input type="date" name="deadline" value="{{formatDate budgetData.deadline 'yyyy-MM-dd'}}" class="input-premium">
                    </div>
                </div>

                <!-- 3D SPECIFIC FIELDS -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 pt-4 border-t border-white/5">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Software</label>
                        <select name="software" class="input-premium">
                            <option value="3ds Max">3ds Max</option>
                            <option value="Blender">Blender</option>
                            <option value="Unreal Engine">Unreal Engine</option>
                            <option value="Sketchup">Sketchup</option>
                            <option value="Rhino">Rhino</option>
                        </select>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Render Engine</label>
                        <select name="renderEngine" class="input-premium">
                            <option value="V-Ray">V-Ray</option>
                            <option value="Corona">Corona</option>
                            <option value="Lumion">Lumion</option>
                            <option value="Enscape">Enscape</option>
                            <option value="Twinmotion">Twinmotion</option>
                        </select>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Complexidade</label>
                        <select name="complexity" class="input-premium">
                            <option value="Baixa">Baixa Poly</option>
                            <option value="Média">Média (Arquitetura)</option>
                            <option value="Alta">Alta (Realismo)</option>
                            <option value="Extrema">Extrema (Simulação)</option>
                        </select>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Prioridade</label>
                        <select name="priority" class="input-premium">
                            <option value="Normal">Normal</option>
                            <option value="Alta">Alta</option>
                            <option value="Urgente">Urgente</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Link de Referência (Pinterest/Drive)</label>
                        <input type="url" name="refLink" class="input-premium" placeholder="https://...">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Tags (separadas por vírgula)</label>
                        <input type="text" name="tags" class="input-premium" placeholder="Ex: interior, iluminação, luxo">
                    </div>
                </div>
            </div>

            <!-- Equipe e Alocação -->
            <div class="glass-card p-10 rounded-[2.5rem] border-white/5">
                <h3 class="text-xs font-black text-white uppercase tracking-widest mb-8 flex items-center gap-3">
                    <span class="material-symbols-outlined text-orange-500">groups</span> Alocação de Equipe
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="p-6 rounded-3xl bg-white/[0.02] border border-white/5 flex items-center justify-between group hover:border-orange-500/30 transition-all cursor-pointer">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-orange-500/10 flex items-center justify-center text-orange-500 font-black text-xs">LZ</div>
                            <div>
                                <p class="text-[11px] font-black text-white">Leo Zanoello</p>
                                <p class="text-[8px] text-gray-500 font-bold uppercase tracking-widest">Diretor de Arte</p>
                            </div>
                        </div>
                        <input type="checkbox" checked class="w-5 h-5 rounded-lg border-white/10 bg-white/5 text-orange-500 focus:ring-orange-500/50">
                    </div>
                    <!-- Mais membros poderiam ser carregados aqui -->
                </div>
            </div>
        </div>

        <!-- Sidebar de Configurações -->
        <div class="space-y-8">
            <div class="glass-card p-8 rounded-[2.5rem] border-white/5 space-y-6">
                <h3 class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Status Inicial</h3>
                <div class="space-y-3">
                    <label class="flex items-center gap-4 p-4 rounded-2xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all">
                        <input type="radio" name="status" value="planning" checked class="w-5 h-5 text-orange-500 bg-black/40 border-white/10">
                        <div>
                            <p class="text-[11px] font-black text-white">Planejamento</p>
                            <p class="text-[8px] text-gray-500 font-bold uppercase">Setup inicial e briefing</p>
                        </div>
                    </label>
                    <label class="flex items-center gap-4 p-4 rounded-2xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-all">
                        <input type="radio" name="status" value="execution" class="w-5 h-5 text-orange-500 bg-black/40 border-white/10">
                        <div>
                            <p class="text-[11px] font-black text-white">Execução</p>
                            <p class="text-[8px] text-gray-500 font-bold uppercase">Início imediato da produção</p>
                        </div>
                    </label>
                </div>

                <div class="pt-6 border-t border-white/5 space-y-4">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Notificar Cliente</span>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" checked>
                        </div>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Destaque Portfólio</span>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isFeatured" value="true">
                        </div>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Criar Pasta Cloud</span>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" checked>
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-black py-6 rounded-[2rem] shadow-2xl shadow-orange-500/20 transition-all flex items-center justify-center gap-3 group">
                <span class="material-symbols-outlined text-2xl group-hover:rotate-12 transition-transform">rocket_launch</span>
                CRIAR PROJETO
            </button>
        </div>
    </form>
</div>

<style>
    .input-premium {
        width: 100%;
        background-color: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1.25rem;
        padding: 0.85rem 1.25rem;
        font-size: 0.75rem;
        color: white;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-weight: 600;
    }
    .input-premium:focus {
        outline: none;
        background-color: rgba(255, 255, 255, 0.05);
        border-color: rgba(249, 115, 22, 0.5);
        box-shadow: 0 0 20px rgba(249, 115, 22, 0.1);
    }
</style>

<script>
document.getElementById('createProjectForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const data = Object.fromEntries(formData.entries());

    try {
        const response = await fetch('/admin/api/projects', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        if (result.success) {
            window.location.href = '/admin/projetos/kanban';
        } else {
            alert('Erro: ' + result.message);
        }
    } catch (err) {
        console.error(err);
        alert('Erro ao processar criação de projeto');
    }
});
</script>
