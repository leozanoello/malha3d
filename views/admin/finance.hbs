</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // === FINANCE TYPE SELECTION & VIEW TOGGLING ===
    window.toggleTransactionType = function(type) {
        document.getElementById('finance-type').value = type;
        
        // Toggle active classes on modal buttons
        document.querySelectorAll('.finance-type-btn').forEach(btn => {
            if (btn.dataset.type === type) {
                btn.classList.add('active');
            } else {
                btn.classList.remove('active');
            }
        });

        // Show/hide relevant fields
        const fieldsReceita = document.getElementById('fields-receita');
        const fieldsDespesa = document.getElementById('fields-despesa');
        const fieldsTransferir = document.getElementById('fields-transferir');
        const fieldsCommon = document.getElementById('fields-common');

        const inputDesc = document.getElementById('finance-description');
        const selectPayer = document.getElementById('receita-payer-select');
        const inputPayer = document.getElementById('despesa-payer-input');
        const selectOrigin = document.getElementById('transferir-origin');
        const selectDest = document.getElementById('transferir-destination');
        const lblDueDate = document.getElementById('lbl-due-date');

        if (type === 'receita') {
            fieldsReceita.classList.remove('hidden');
            fieldsDespesa.classList.add('hidden');
            fieldsTransferir.classList.add('hidden');
            fieldsCommon.classList.remove('hidden');

            inputDesc.placeholder = 'Ex: Parcela 1 - Projeto Casa Cor';
            lblDueDate.textContent = 'Vencimento';

            selectPayer.setAttribute('required', 'required');
            inputPayer.removeAttribute('required');
            selectOrigin.removeAttribute('required');
            selectDest.removeAttribute('required');
        } else if (type === 'despesa') {
            fieldsReceita.classList.add('hidden');
            fieldsDespesa.classList.remove('hidden');
            fieldsTransferir.classList.add('hidden');
            fieldsCommon.classList.remove('hidden');

            inputDesc.placeholder = 'Ex: Licença D5 Render Annual';
            lblDueDate.textContent = 'Vencimento';

            selectPayer.removeAttribute('required');
            inputPayer.setAttribute('required', 'required');
            selectOrigin.removeAttribute('required');
            selectDest.removeAttribute('required');
        } else if (type === 'transferir') {
            fieldsReceita.classList.add('hidden');
            fieldsDespesa.classList.add('hidden');
            fieldsTransferir.classList.remove('hidden');
            fieldsCommon.classList.add('hidden');

            inputDesc.placeholder = 'Ex: Transferência Interna';
            lblDueDate.textContent = 'Data da Transferência';

            selectPayer.removeAttribute('required');
            inputPayer.removeAttribute('required');
            selectOrigin.setAttribute('required', 'required');
            selectDest.setAttribute('required', 'required');
        }
    };

    window.setModalType = function(type) {
        setTimeout(() => {
            toggleTransactionType(type);
        }, 50);
    };

    // Add click handler to modal type buttons directly
    document.addEventListener('click', function(e) {
        const typeBtn = e.target.closest('.btn-set-type');
        if (typeBtn) {
            const type = typeBtn.dataset.type;
            toggleTransactionType(type);
        }
    });

    // === FORM SUBMISSION ===
    document.getElementById('financeForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(this).entries());
        
        try {
            const response = await fetch('/admin/api/financeiro', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            if (result.success) window.location.reload();
            else alert('Erro: ' + result.message);
        } catch (err) { console.error(err); }
    });

    // === FIXED vs VARIABLE PROGRESS BAR ===
    const fixedVal = parseFloat('{{bi.fixedExpenses}}') || 0;
    const varVal = parseFloat('{{bi.variableExpenses}}') || 0;
    const totalVal = fixedVal + varVal;
    
    if (totalVal > 0) {
        const fixedPct = Math.round((fixedVal / totalVal) * 100);
        const varPct = 100 - fixedPct;
        document.getElementById('fixed-cost-bar').style.width = fixedPct + '%';
        document.getElementById('var-cost-bar').style.width = varPct + '%';
        document.getElementById('fixed-cost-percent').textContent = 'Fixos: ' + fixedPct + '% (' + fixedVal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) + ')';
        document.getElementById('var-cost-percent').textContent = 'Variáveis: ' + varPct + '% (' + varVal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) + ')';
    } else {
        document.getElementById('fixed-cost-bar').style.width = '50%';
        document.getElementById('var-cost-bar').style.width = '50%';
        document.getElementById('fixed-cost-percent').textContent = 'Fixos: 0%';
        document.getElementById('var-cost-percent').textContent = 'Variáveis: 0%';
    }

    // === RENDER COST CENTERS LIST ===
    const costCenterData = {{{json bi.costCenters}}};
    const costCenterStructure = {
        operacional: [
            { code: 'render_farm', name: 'Render Farms Externas' },
            { code: 'plugins', name: 'Plugins e Scripts 3D' },
            { code: 'assets_3d', name: 'Biblioteca de Modelos/Assets' },
            { code: 'texturas_materiais', name: 'Texturas e Materiais PBR' },
            { code: 'freelancers_modelagem', name: 'Freelancers: Modelagem 3D' },
            { code: 'freelancers_render', name: 'Freelancers: Renderização' },
            { code: 'freelancers_animacao', name: 'Freelancers: Animação' },
            { code: 'softwares_licencas', name: 'Licenças de Softwares' },
            { code: 'ia_ferramentas', name: 'Ferramentas de IA' },
            { code: 'storage_cloud', name: 'Armazenamento Cloud' },
            { code: 'hardware_rent', name: 'Aluguel de Workstations' },
            { code: 'sound_music', name: 'Trilhas Sonoras e Efeitos' },
            { code: 'render_local', name: 'Energia: Render Farm Local' },
            { code: 'vr_equipments', name: 'Equipamentos VR & Suporte' },
            { code: 'post_production', name: 'Softwares de Edição' }
        ],
        administrativo: [
            { code: 'aluguel_studio', name: 'Aluguel do Espaço / Estúdio' },
            { code: 'condominio', name: 'Taxa Condominial' },
            { code: 'energia_eletrica', name: 'Energia Elétrica' },
            { code: 'internet_fibra', name: 'Internet Fibra Óptica' },
            { code: 'pro_labore', name: 'Pró-Labore dos Sócios' },
            { code: 'salarios_clt', name: 'Salários Equipe CLT/PJ' },
            { code: 'contabilidade', name: 'Assessoria Contábil' },
            { code: 'limpeza_conservacao', name: 'Limpeza e Insumos' },
            { code: 'seguros', name: 'Seguros Gerais' },
            { code: 'assessoria_juridica', name: 'Consultoria Jurídica' },
            { code: 'tarifas_bancarias', name: 'Tarifas & Taxas Bancárias' },
            { code: 'infra_geral', name: 'Manutenção e Reparos' },
            { code: 'coffee_pantry', name: 'Insumos de Copa e Café' },
            { code: 'office_supplies', name: 'Materiais de Escritório' },
            { code: 'telefonia', name: 'Serviços de Telefonia' }
        ],
        comercial: [
            { code: 'google_ads', name: 'Anúncios: Google Ads' },
            { code: 'meta_ads', name: 'Anúncios: Meta Ads' },
            { code: 'branding_design', name: 'Design de Marca & Identidade' },
            { code: 'website_seo', name: 'Site e Otimização SEO' },
            { code: 'comissoes_vendas', name: 'Comissões de Vendas' },
            { code: 'crm_plataformas', name: 'CRM & Plataformas Vendas' },
            { code: 'eventos_feiras', name: 'Eventos e Feiras do Setor' },
            { code: 'viagens_comerciais', name: 'Viagens & Reuniões' },
            { code: 'brindes_clientes', name: 'Brindes & Mimos Clientes' },
            { code: 'portfolio_behance', name: 'Impulsionamento Portfólio' },
            { code: 'impostos_nf', name: 'Impostos sobre Notas (NF)' },
            { code: 'afiliacoes_clubes', name: 'Clubes de Arq & Networking' },
            { code: 'treinamentos_vendas', name: 'Treinamento Negócios/Vendas' },
            { code: 'marketing_conteudo', name: 'Criação Conteúdo/Social' },
            { code: 'ferramentas_prospeccao', name: 'Ferramentas de Prospecção' }
        ]
    };

    function renderAreaList(areaKey, targetId, colorClass) {
        const container = document.getElementById(targetId);
        if (!container) return;
        
        let html = '';
        costCenterStructure[areaKey].forEach(item => {
            const amount = costCenterData[item.code] || 0;
            const formattedAmount = amount.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            
            html += `
                <div class="p-3 rounded-xl bg-white/[0.01] border border-white/5 flex items-center justify-between hover:bg-white/[0.03] transition-all">
                    <div>
                        <p class="text-[10px] font-black text-white">${item.name}</p>
                        <p class="text-[7px] text-gray-500 uppercase tracking-widest font-bold mt-0.5">${item.code}</p>
                    </div>
                    <span class="text-xs font-black ${amount > 0 ? colorClass : 'text-gray-600'}">${formattedAmount}</span>
                </div>
            `;
        });
        container.innerHTML = html;
    }

    renderAreaList('operacional', 'cc-operacional-list', 'text-emerald-400');
    renderAreaList('administrativo', 'cc-administrativo-list', 'text-purple-400');
    renderAreaList('comercial', 'cc-comercial-list', 'text-pink-400');

    // === BI CHARTS ===
    const ctxExpense = document.getElementById('expenseChart')?.getContext('2d');
    const ctxProfit = document.getElementById('profitChart')?.getContext('2d');
    const ctxCashFlow = document.getElementById('cashFlowChart')?.getContext('2d');

    if (ctxExpense) {
        const expenseData = {{{json bi.expenseCategories}}};
        new Chart(ctxExpense, {
            type: 'doughnut',
            data: {
                labels: Object.keys(expenseData).map(k => k.toUpperCase()),
                datasets: [{
                    data: Object.values(expenseData),
                    backgroundColor: ['#10b981', '#ef4444', '#f59e0b', '#6366f1', '#a855f7', '#ec4899', '#06b6d4'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right', labels: { color: '#9ca3af', font: { family: 'Inter', weight: 'bold', size: 10 } } }
                },
                cutout: '70%'
            }
        });
    }

    if (ctxProfit) {
        const profitData = {{{json projectProfits}}};
        new Chart(ctxProfit, {
            type: 'bar',
            data: {
                labels: profitData.map(p => p.name),
                datasets: [
                    {
                        label: 'Receita',
                        data: profitData.map(p => p.income),
                        backgroundColor: 'rgba(16, 185, 129, 0.2)',
                        borderColor: '#10b981',
                        borderWidth: 1,
                        borderRadius: 8
                    },
                    {
                        label: 'Despesa',
                        data: profitData.map(p => p.expenses),
                        backgroundColor: 'rgba(239, 68, 68, 0.2)',
                        borderColor: '#ef4444',
                        borderWidth: 1,
                        borderRadius: 8
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#6b7280', font: { size: 9 } } },
                    x: { grid: { display: false }, ticks: { color: '#6b7280', font: { size: 9 } } }
                },
                plugins: {
                    legend: { labels: { color: '#9ca3af', font: { family: 'Inter', weight: 'bold', size: 10 } } }
                }
            }
        });
    }

    // === CASH FLOW CHART (FRENTE 3) ===
    if (ctxCashFlow) {
        const cashFlowData = {{{json cashFlow}}};
        new Chart(ctxCashFlow, {
            type: 'line',
            data: {
                labels: cashFlowData.labels,
                datasets: [
                    {
                        label: 'Realizado',
                        data: cashFlowData.realized,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2,
                        pointRadius: 4,
                        pointBackgroundColor: '#10b981'
                    },
                    {
                        label: 'Projetado',
                        data: cashFlowData.projected,
                        borderColor: '#f97316',
                        backgroundColor: 'rgba(249, 115, 22, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2,
                        borderDash: [5, 5],
                        pointRadius: 4,
                        pointBackgroundColor: '#f97316'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { 
                        beginAtZero: true, 
                        grid: { color: 'rgba(255,255,255,0.05)' }, 
                        ticks: { 
                            color: '#6b7280', 
                            font: { size: 9 },
                            callback: function(value) {
                                return 'R$ ' + value.toLocaleString('pt-BR');
                            }
                        } 
                    },
                    x: { grid: { display: false }, ticks: { color: '#6b7280', font: { size: 9 } } }
                },
                plugins: {
                    legend: { labels: { color: '#9ca3af', font: { family: 'Inter', weight: 'bold', size: 10 } } },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': R$ ' + context.parsed.y.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
                            }
                        }
                    }
                }
            }
        });
    }

    // === TABS SYSTEM ===
    const tabButtons = document.querySelectorAll('.finance-tab-btn');
    const panes = document.querySelectorAll('.finance-pane');
    
    function switchTab(tabId) {
        panes.forEach(pane => {
            if (pane.id === `tab-pane-${tabId}`) {
                pane.classList.remove('hidden');
                pane.classList.add('active');
            } else {
                pane.classList.add('hidden');
                pane.classList.remove('active');
            }
        });
        
        tabButtons.forEach(btn => {
            if (btn.dataset.tab === tabId) {
                btn.classList.add('active');
            } else {
                btn.classList.remove('active');
            }
        });
        
        localStorage.setItem('selectedFinanceTab', tabId);
    }
    
    tabButtons.forEach(btn => {
        btn.addEventListener('click', function() {
            switchTab(this.dataset.tab);
        });
    });
    
    // Restore persisted tab or default to 'painel'
    const savedTab = localStorage.getItem('selectedFinanceTab') || 'painel';
    switchTab(savedTab);

    // === TRANSACTIONS SEARCH ===
    const searchInput = document.getElementById('search-transactions');
    searchInput?.addEventListener('input', function() {
        const query = this.value.toLowerCase().trim();
        const rows = document.querySelectorAll('#tab-pane-extrato tbody tr');
        
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            if (text.includes(query)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

    // === QUERY PARAMETERS AUTOLOAD (VIA DE MÃO DUPLA) ===
    const urlParams = new URLSearchParams(window.location.search);
    const paramProjectId = urlParams.get('projectId');
    const paramType = urlParams.get('type');

    if (paramProjectId) {
        const selectProj = document.querySelector('select[name="projectId"]');
        if (selectProj) {
            selectProj.value = paramProjectId;
        }
        
        if (paramType) {
            toggleTransactionType(paramType);
        }
        
        const modalEl = document.getElementById('newTransactionModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }
});
</script>
