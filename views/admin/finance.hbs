<div class="mb-10 p-8 glass-card border-none bg-gradient-to-br from-white/10 to-white/[0.02] relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/10 blur-[100px] -mr-32 -mt-32"></div>
    
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
        <div>
            <h1 class="text-4xl font-black text-white tracking-tight mb-2">
                Fluxo <span class="text-gradient">Financeiro</span>
            </h1>
            <p class="text-gray-400 font-medium max-w-xl">
                Controle rigoroso de receitas e despesas. Visão clara da saúde financeira do estúdio <span class="text-orange-500 font-bold">Malha3D</span>.
            </p>
        </div>
        <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-10 rounded-2xl shadow-2xl shadow-orange-500/40 transition-all flex items-center gap-3 text-[10px] uppercase tracking-widest" data-bs-toggle="modal" data-bs-target="#newTransactionModal">
            <span class="material-symbols-outlined">payments</span>
            Nova Transação Financeira
        </button>
    </div>
</div>

<!-- Financial Stats -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
    <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-emerald-500/10 to-transparent">
        <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Total Receitas</p>
        <h3 class="text-3xl font-black text-emerald-500">{{formatCurrency stats.income}}</h3>
    </div>
    <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-red-500/10 to-transparent">
        <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Total Despesas</p>
        <h3 class="text-3xl font-black text-red-500">{{formatCurrency stats.expense}}</h3>
    </div>
    <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-orange-500/10 to-transparent">
        <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Saldo Projetado</p>
        <h3 class="text-3xl font-black text-white">{{formatCurrency stats.balance}}</h3>
    </div>
    <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-cyber-500/10 to-transparent">
        <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Margem Média Global</p>
        <h3 class="text-3xl font-black text-cyber-500">{{bi.avgMargin}}%</h3>
    </div>
</div>

<!-- FRENTE 3: Receita Futura de Parcelas + Cash Flow Chart -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
    <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-purple-500/10 to-transparent">
        <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Receita Futura (Parcelas)</p>
        <h3 class="text-3xl font-black text-purple-400">{{formatCurrency futureInstallments}}</h3>
        <p class="text-[8px] text-gray-600 mt-2 uppercase tracking-wider">Parcelas pendentes de propostas fechadas</p>
    </div>
    <div class="col-span-3 glass-card p-8 border-white/5">
        <h3 class="text-xs font-black text-white uppercase tracking-widest mb-6">
            Fluxo de Caixa: <span class="text-emerald-500">Realizado</span> vs. <span class="text-orange-500">Projetado</span>
        </h3>
        <div class="h-[300px]">
            <canvas id="cashFlowChart"></canvas>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-10">
    <div class="glass-card p-8 border-white/5">
        <h3 class="text-xs font-black text-white uppercase tracking-widest mb-6">Distribuição de Despesas</h3>
        <div class="h-[300px]">
            <canvas id="expenseChart"></canvas>
        </div>
    </div>
    <div class="glass-card p-8 border-white/5">
        <h3 class="text-xs font-black text-white uppercase tracking-widest mb-6">Performance de Lucratividade</h3>
        <div class="h-[300px]">
            <canvas id="profitChart"></canvas>
        </div>
    </div>
</div>

<!-- FRENTE 3: Centro de Custos -->
<div class="glass-card p-8 border-white/5 mb-10">
    <h3 class="text-xs font-black text-white uppercase tracking-widest mb-6">
        Centro de <span class="text-gradient">Custos</span>
    </h3>
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
        {{#each bi.costCenters}}
        <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/5 hover:bg-white/[0.04] transition-all">
            <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 truncate">{{@key}}</p>
            <p class="text-lg font-black text-red-400">{{formatCurrency this}}</p>
        </div>
        {{/each}}
    </div>
</div>

<!-- Transactions Table -->
<div class="glass-card border-white/5 overflow-hidden rounded-[2rem] shadow-2xl">
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="bg-white/[0.02]">
                    <th class="px-8 py-6 text-[10px] font-black text-gray-500 uppercase tracking-widest">Descrição</th>
                    <th class="px-8 py-6 text-[10px] font-black text-gray-500 uppercase tracking-widest">Categoria</th>
                    <th class="px-8 py-6 text-[10px] font-black text-gray-500 uppercase tracking-widest">Vencimento</th>
                    <th class="px-8 py-6 text-[10px] font-black text-gray-500 uppercase tracking-widest">Valor</th>
                    <th class="px-8 py-6 text-[10px] font-black text-gray-500 uppercase tracking-widest text-right">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                {{#each transactions}}
                <tr class="hover:bg-white/[0.03] transition-colors group">
                    <td class="px-8 py-6">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl flex items-center justify-center {{#if (eq this.type 'receita')}}bg-emerald-500/20 text-emerald-500{{else}}bg-red-500/20 text-red-500{{/if}}">
                                <span class="material-symbols-outlined text-xl">{{#if (eq this.type 'receita')}}trending_up{{else}}trending_down{{/if}}</span>
                            </div>
                            <div>
                                <p class="text-xs font-black text-white">{{this.description}}</p>
                                <p class="text-[9px] text-gray-500 uppercase font-bold">{{this.payer}}</p>
                            </div>
                        </div>
                    </td>
                    <td class="px-8 py-6">
                        <span class="text-[10px] font-black text-gray-400 bg-white/5 px-3 py-1 rounded-lg border border-white/5 uppercase">{{this.category}}</span>
                    </td>
                    <td class="px-8 py-6 text-[11px] font-bold text-gray-400">{{formatDate this.dueDate}}</td>
                    <td class="px-8 py-6">
                        <span class="text-xs font-black {{#if (eq this.type 'receita')}}text-emerald-500{{else}}text-red-500{{/if}}">
                            {{#if (eq this.type 'receita')}}+{{else}}-{{/if}} {{formatCurrency this.amount}}
                        </span>
                    </td>
                    <td class="px-8 py-6 text-right">
                        <span class="text-[9px] font-black px-3 py-1.5 rounded-lg border {{#if (eq this.status 'pago')}}bg-emerald-500/10 border-emerald-500/20 text-emerald-500{{else}}bg-orange-500/10 border-orange-500/20 text-orange-500{{/if}} uppercase tracking-widest">
                            {{this.status}}
                        </span>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>

<!-- Project Profitability Analysis -->
<div class="mt-10 mb-10">
    <h2 class="text-2xl font-black text-white tracking-tight mb-6">
        Análise de <span class="text-gradient">Lucratividade</span> por Projeto
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {{#each projectProfits}}
        <div class="glass-card p-8 border-white/5 bg-white/[0.01] hover:bg-white/[0.03] transition-all group">
            <div class="flex items-center justify-between mb-6">
                <h4 class="text-sm font-black text-white group-hover:text-cyber-500 transition-colors truncate pr-4">{{this.name}}</h4>
                <span class="text-[10px] font-black px-2 py-1 rounded bg-cyber-500/10 text-cyber-500 border border-cyber-500/20">
                    {{this.margin}}% Margem
                </span>
            </div>
            
            <div class="space-y-4">
                <div class="flex justify-between items-center">
                    <span class="text-[9px] font-bold text-gray-500 uppercase tracking-widest">Valor do Contrato</span>
                    <span class="text-xs font-black text-white">{{formatCurrency this.price}}</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-[9px] font-bold text-gray-500 uppercase tracking-widest">Recebido (Realizado)</span>
                    <span class="text-xs font-black text-emerald-500">{{formatCurrency this.income}}</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-[9px] font-bold text-gray-500 uppercase tracking-widest">Custos (Freelancers/Outros)</span>
                    <span class="text-xs font-black text-red-500">{{formatCurrency this.expenses}}</span>
                </div>
                
                <div class="pt-4 border-t border-white/5 flex justify-between items-center">
                    <span class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">Resultado Líquido</span>
                    <span class="text-lg font-black {{#if (gt this.profit 0)}}text-cyber-500{{else}}text-red-500{{/if}}">
                        {{formatCurrency this.profit}}
                    </span>
                </div>
            </div>

            <!-- Progress Bar: Income vs Price -->
            <div class="mt-6 w-full h-1.5 bg-white/5 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-emerald-500 to-cyber-500" style="width: {{#if (gt this.price 0)}}{{multiply (divide this.income this.price) 100}}{{else}}0{{/if}}%"></div>
            </div>
            <p class="text-[8px] font-bold text-gray-600 uppercase mt-2 text-right tracking-widest">Faturamento Realizado</p>
        </div>
        {{/each}}
    </div>
</div>

<!-- Modal: Nova Transação (Following Screenshot) -->
<div class="modal fade" id="newTransactionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content glass-card border-white/10 shadow-2xl rounded-[3rem] overflow-hidden bg-[#0a0c10] backdrop-blur-3xl">
            <div class="modal-header border-none p-10 pb-0">
                <h2 class="text-2xl font-black text-white tracking-tight">Nova Transação</h2>
                <button type="button" class="btn-close btn-close-white opacity-30" data-bs-dismiss="modal"></button>
            </div>
            
            <form id="financeForm">
                <div class="modal-body p-10 space-y-10">
                    <!-- Type Selection (As seen in screenshot) -->
                    <div class="grid grid-cols-3 gap-6">
                        <button type="button" data-type="receita" class="finance-type-btn btn-set-type p-8 rounded-3xl bg-white/[0.03] border border-white/5 flex flex-col items-center gap-4 transition-all hover:bg-white/5 active">
                            <span class="material-symbols-outlined text-3xl text-emerald-500">add_circle</span>
                            <span class="text-[10px] font-black text-white uppercase tracking-[0.2em]">Receita</span>
                        </button>
                        <button type="button" data-type="despesa" class="finance-type-btn btn-set-type p-8 rounded-3xl bg-white/[0.03] border border-white/5 flex flex-col items-center gap-4 transition-all hover:bg-white/5">
                            <span class="material-symbols-outlined text-3xl text-red-500">remove_circle</span>
                            <span class="text-[10px] font-black text-white uppercase tracking-[0.2em]">Despesa</span>
                        </button>
                        <button type="button" data-type="transferir" class="finance-type-btn btn-set-type p-8 rounded-3xl bg-white/[0.03] border border-white/5 flex flex-col items-center gap-4 transition-all hover:bg-white/5">
                            <span class="material-symbols-outlined text-3xl text-indigo-500">sync_alt</span>
                            <span class="text-[10px] font-black text-white uppercase tracking-[0.2em]">Transferir</span>
                        </button>
                    </div>

                    <input type="hidden" name="type" id="finance-type" value="receita">

                    <div class="grid grid-cols-2 gap-8">
                        <div class="space-y-3">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Descrição</label>
                            <input type="text" name="description" required class="input-premium" placeholder="Ex: Licença V-Ray Annual">
                        </div>
                        <div class="space-y-3">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Favorecido / Pagador</label>
                            <input type="text" name="payer" required class="input-premium" placeholder="Chaos Group / Cliente X">
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-8">
                        <div class="space-y-3">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Valor (R$)</label>
                            <input type="number" step="0.01" name="amount" required class="input-premium" placeholder="0.00">
                        </div>
                        <div class="space-y-3">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Vencimento</label>
                            <input type="date" name="dueDate" required class="input-premium">
                        </div>
                        <div class="space-y-3">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Status</label>
                            <select name="status" class="input-premium">
                                <option value="pendente">Pendente</option>
                                <option value="pago">Pago / Recebido</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-8">
                        <div class="space-y-3">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Categoria de Custo / Receita</label>
                            <select name="category" class="input-premium">
                                <optgroup label="Despesas Fixas" class="bg-[#0f0f0f]">
                                    <option value="aluguel">Aluguel / Infra</option>
                                    <option value="internet">Internet / Cloud</option>
                                    <option value="energia">Energia Elétrica</option>
                                    <option value="salarios">Salários / Pró-labore</option>
                                </optgroup>
                                <optgroup label="Operacional 3D" class="bg-[#0f0f0f]">
                                    <option value="render_farm">Render Farm</option>
                                    <option value="software">Software & Assets</option>
                                    <option value="hardware">Hardware & Upgrades</option>
                                    <option value="freelancers">Freelancers / Terceiros</option>
                                </optgroup>
                                <optgroup label="Crescimento" class="bg-[#0f0f0f]">
                                    <option value="marketing">Marketing & Tráfego</option>
                                    <option value="vendas">Comissões de Vendas</option>
                                    <option value="cursos">Cursos & Treinamentos</option>
                                </optgroup>
                                <optgroup label="Receitas" class="bg-[#0f0f0f]">
                                    <option value="projeto_render">Projeto: Renderização</option>
                                    <option value="projeto_3d">Projeto: Modelagem</option>
                                    <option value="projeto_anim">Projeto: Animação</option>
                                    <option value="consultoria">Consultoria Técnica</option>
                                </optgroup>
                            </select>
                        </div>
                        <div class="space-y-3">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Meio de Movimentação</label>
                            <select name="paymentMethod" class="input-premium">
                                <option value="pix">PIX (Instantâneo)</option>
                                <option value="boleto">Boleto Bancário</option>
                                <option value="cartao">Cartão de Crédito</option>
                                <option value="ted">Transferência / TED</option>
                                <option value="dinheiro">Espécie / Dinheiro</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-8">
                        <div class="space-y-3">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Centro de Custo</label>
                            <select name="costCenter" class="input-premium">
                                <option value="">Selecionar Centro de Custo</option>
                                <option value="infraestrutura">Infraestrutura (Aluguel, Energia, Internet)</option>
                                <option value="pessoal">Pessoal (Salários, Pró-labore)</option>
                                <option value="marketing">Marketing & Tráfego Pago</option>
                                <option value="software">Software & Licenças (D5, Revit, V-Ray)</option>
                                <option value="producao_3d">Produção 3D (Render Farm, Freelancers)</option>
                                <option value="administrativo">Administrativo & Contabilidade</option>
                            </select>
                        </div>
                        <div class="space-y-3">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Recorrência</label>
                            <select name="recurrence" class="input-premium">
                                <option value="unica">Única</option>
                                <option value="mensal">Mensal</option>
                                <option value="trimestral">Trimestral</option>
                                <option value="anual">Anual</option>
                            </select>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Projeto Vinculado (Opcional)</label>
                        <select name="projectId" class="input-premium">
                            <option value="">Nenhum / Despesa Geral do Studio</option>
                            {{#each activeProjects}}
                            <option value="{{this.id}}">{{this.name}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                
                <div class="p-10 border-t border-white/5 flex justify-end gap-6">
                    <button type="button" class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-500 hover:text-white transition-all" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white font-black py-5 px-14 rounded-[1.5rem] text-[10px] uppercase tracking-[0.2em] shadow-2xl shadow-orange-500/40 transition-all">
                        Salvar Registro
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .input-premium {
        width: 100%;
        background-color: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 1.25rem;
        padding: 1.2rem 1.5rem;
        font-size: 0.85rem;
        color: white;
        transition: all 0.3s;
    }
    .input-premium:focus {
        outline: none;
        border-color: rgba(249, 115, 22, 0.4);
        background-color: rgba(255, 255, 255, 0.04);
        box-shadow: 0 0 0 10px rgba(249, 115, 22, 0.05);
    }
    .finance-type-btn.active {
        background-color: rgba(255, 255, 255, 0.05);
        border-color: rgba(249, 115, 22, 0.3);
        box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        transform: translateY(-5px);
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // === FINANCE TYPE SELECTION ===
    document.addEventListener('click', function(e) {
        const typeBtn = e.target.closest('.btn-set-type');
        if (typeBtn) {
            const type = typeBtn.dataset.type;
            document.getElementById('finance-type').value = type;
            document.querySelectorAll('.finance-type-btn').forEach(btn => btn.classList.remove('active'));
            typeBtn.classList.add('active');
        }
    });

    // === FORM SUBMISSION ===
    document.getElementById('financeForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(this).entries());
        
        try {
            const response = await fetch('/admin/api/financeiro', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            if (result.success) window.location.reload();
            else alert('Erro: ' + result.message);
        } catch (err) { console.error(err); }
    });

    // === BI CHARTS ===
    const ctxExpense = document.getElementById('expenseChart')?.getContext('2d');
    const ctxProfit = document.getElementById('profitChart')?.getContext('2d');
    const ctxCashFlow = document.getElementById('cashFlowChart')?.getContext('2d');

    if (ctxExpense) {
        const expenseData = {{{json bi.expenseCategories}}};
        new Chart(ctxExpense, {
            type: 'doughnut',
            data: {
                labels: Object.keys(expenseData).map(k => k.toUpperCase()),
                datasets: [{
                    data: Object.values(expenseData),
                    backgroundColor: ['#10b981', '#ef4444', '#f59e0b', '#6366f1', '#a855f7', '#ec4899', '#06b6d4'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right', labels: { color: '#9ca3af', font: { family: 'Inter', weight: 'bold', size: 10 } } }
                },
                cutout: '70%'
            }
        });
    }

    if (ctxProfit) {
        const profitData = {{{json projectProfits}}};
        new Chart(ctxProfit, {
            type: 'bar',
            data: {
                labels: profitData.map(p => p.name),
                datasets: [
                    {
                        label: 'Receita',
                        data: profitData.map(p => p.income),
                        backgroundColor: 'rgba(16, 185, 129, 0.2)',
                        borderColor: '#10b981',
                        borderWidth: 1,
                        borderRadius: 8
                    },
                    {
                        label: 'Despesa',
                        data: profitData.map(p => p.expenses),
                        backgroundColor: 'rgba(239, 68, 68, 0.2)',
                        borderColor: '#ef4444',
                        borderWidth: 1,
                        borderRadius: 8
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#6b7280', font: { size: 9 } } },
                    x: { grid: { display: false }, ticks: { color: '#6b7280', font: { size: 9 } } }
                },
                plugins: {
                    legend: { labels: { color: '#9ca3af', font: { family: 'Inter', weight: 'bold', size: 10 } } }
                }
            }
        });
    }

    // === CASH FLOW CHART (FRENTE 3) ===
    if (ctxCashFlow) {
        const cashFlowData = {{{json cashFlow}}};
        new Chart(ctxCashFlow, {
            type: 'line',
            data: {
                labels: cashFlowData.labels,
                datasets: [
                    {
                        label: 'Realizado',
                        data: cashFlowData.realized,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2,
                        pointRadius: 4,
                        pointBackgroundColor: '#10b981'
                    },
                    {
                        label: 'Projetado',
                        data: cashFlowData.projected,
                        borderColor: '#f97316',
                        backgroundColor: 'rgba(249, 115, 22, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2,
                        borderDash: [5, 5],
                        pointRadius: 4,
                        pointBackgroundColor: '#f97316'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { 
                        beginAtZero: true, 
                        grid: { color: 'rgba(255,255,255,0.05)' }, 
                        ticks: { 
                            color: '#6b7280', 
                            font: { size: 9 },
                            callback: function(value) {
                                return 'R$ ' + value.toLocaleString('pt-BR');
                            }
                        } 
                    },
                    x: { grid: { display: false }, ticks: { color: '#6b7280', font: { size: 9 } } }
                },
                plugins: {
                    legend: { labels: { color: '#9ca3af', font: { family: 'Inter', weight: 'bold', size: 10 } } },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': R$ ' + context.parsed.y.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
                            }
                        }
                    }
                }
            }
        });
    }
});
</script>
