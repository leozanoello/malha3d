<div class="mb-10 p-8 glass-card border-none bg-gradient-to-br from-white/10 to-white/[0.02] relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/10 blur-[100px] -mr-32 -mt-32"></div>
    
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
        <div>
            <h1 class="text-4xl font-black text-white tracking-tight mb-2">
                Fluxo <span class="text-gradient">Financeiro</span>
            </h1>
            <p class="text-gray-400 font-medium max-w-xl">
                Controle rigoroso de receitas e despesas. Visão clara da saúde financeira do estúdio <span class="text-orange-500 font-bold">Malha3D</span>.
            </p>
        </div>
        <div class="flex items-center gap-3 flex-wrap md:flex-nowrap">
            <button class="w-[90px] h-[90px] rounded-2xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/20 hover:border-emerald-500/50 text-emerald-400 font-bold transition-all duration-300 flex flex-col items-center justify-center gap-1.5 hover:-translate-y-1 shadow-lg hover:shadow-emerald-500/10 cursor-pointer" data-bs-toggle="modal" data-bs-target="#newTransactionModal" onclick="setModalType('receita')">
                <span class="material-symbols-outlined text-xl">add_circle</span>
                <span class="text-[8px] uppercase tracking-widest font-black text-center">Receita</span>
            </button>
            <button class="w-[90px] h-[90px] rounded-2xl bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 hover:border-red-500/50 text-red-400 font-bold transition-all duration-300 flex flex-col items-center justify-center gap-1.5 hover:-translate-y-1 shadow-lg hover:shadow-red-500/10 cursor-pointer" data-bs-toggle="modal" data-bs-target="#newTransactionModal" onclick="setModalType('despesa')">
                <span class="material-symbols-outlined text-xl">remove_circle</span>
                <span class="text-[8px] uppercase tracking-widest font-black text-center">Despesa</span>
            </button>
            <button class="w-[90px] h-[90px] rounded-2xl bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/20 hover:border-indigo-500/50 text-indigo-400 font-bold transition-all duration-300 flex flex-col items-center justify-center gap-1.5 hover:-translate-y-1 shadow-lg hover:shadow-indigo-500/10 cursor-pointer" data-bs-toggle="modal" data-bs-target="#newTransactionModal" onclick="setModalType('transferir')">
                <span class="material-symbols-outlined text-xl">sync_alt</span>
                <span class="text-[8px] uppercase tracking-widest font-black text-center">Transferir</span>
            </button>
        </div>
    </div>
</div>

<!-- Tabs Navigation -->
<div class="flex items-center gap-2 mb-8 p-1.5 bg-white/[0.02] border border-white/5 rounded-2xl backdrop-blur-md max-w-2xl">
    <button class="finance-tab-btn flex items-center gap-2 px-6 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all duration-300 active" data-tab="painel">
        <span class="material-symbols-outlined text-sm">dashboard</span>
        Painel Geral
    </button>
    <button class="finance-tab-btn flex items-center gap-2 px-6 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all duration-300" data-tab="extrato">
        <span class="material-symbols-outlined text-sm">receipt_long</span>
        Extrato
    </button>
    <button class="finance-tab-btn flex items-center gap-2 px-6 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all duration-300" data-tab="lucro">
        <span class="material-symbols-outlined text-sm">analytics</span>
        Lucratividade
    </button>
</div>

<!-- Tab Pane 1: Painel Geral -->
<div id="tab-pane-painel" class="finance-pane active space-y-10">
    <!-- Financial Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-emerald-500/10 to-transparent">
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Total Receitas</p>
            <h3 class="text-3xl font-black text-emerald-500">{{formatCurrency stats.income}}</h3>
        </div>
        <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-red-500/10 to-transparent">
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Total Despesas</p>
            <h3 class="text-3xl font-black text-red-500">{{formatCurrency stats.expense}}</h3>
        </div>
        <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-orange-500/10 to-transparent">
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Saldo Projetado</p>
            <h3 class="text-3xl font-black text-white">{{formatCurrency stats.balance}}</h3>
        </div>
        <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-cyber-500/10 to-transparent">
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Margem Média Global</p>
            <h3 class="text-3xl font-black text-cyber-500">{{bi.avgMargin}}%</h3>
        </div>
    </div>
    
    <!-- Custos Fixos vs Variáveis Card (Painel Geral) -->
    <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-purple-500/5 to-transparent relative overflow-hidden">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div>
                <h4 class="text-sm font-black text-white uppercase tracking-widest mb-1">
                    Fluxo de Custos: <span class="text-purple-400">Fixo</span> vs <span class="text-pink-400">Variável</span>
                </h4>
                <p class="text-[9px] text-gray-500 uppercase font-bold tracking-wider">
                    Visão integrada dos custos recorrentes de estrutura vs custos associados a projetos e vendas.
                </p>
            </div>
            <div class="flex items-center gap-8">
                <div class="text-right">
                    <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-1">Custos Fixos</p>
                    <p class="text-lg font-black text-purple-400" id="val-custos-fixos">{{formatCurrency bi.fixedExpenses}}</p>
                </div>
                <div class="h-8 w-px bg-white/10"></div>
                <div class="text-right">
                    <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-1">Custos Variáveis</p>
                    <p class="text-lg font-black text-pink-400" id="val-custos-variaveis">{{formatCurrency bi.variableExpenses}}</p>
                </div>
            </div>
        </div>
        <!-- Progress Bar -->
        <div class="mt-6 w-full h-3 bg-white/5 rounded-full overflow-hidden flex">
            <div class="h-full bg-gradient-to-r from-purple-600 to-purple-400 transition-all duration-500" id="fixed-cost-bar" style="width: 0%" title="Custos Fixos"></div>
            <div class="h-full bg-gradient-to-r from-pink-600 to-pink-400 transition-all duration-500" id="var-cost-bar" style="width: 0%" title="Custos Variáveis"></div>
        </div>
        <div class="flex justify-between text-[8px] font-black text-gray-600 uppercase mt-2 tracking-widest">
            <span id="fixed-cost-percent">Fixos: 0%</span>
            <span id="var-cost-percent">Variáveis: 0%</span>
        </div>

    <!-- Receita Futura de Parcelas + Cash Flow Chart -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-purple-500/10 to-transparent">
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Receita Futura (Parcelas)</p>
            <h3 class="text-3xl font-black text-purple-400">{{formatCurrency futureInstallments}}</h3>
            <p class="text-[8px] text-gray-600 mt-2 uppercase tracking-wider">Parcelas pendentes de propostas fechadas</p>
        </div>
        <div class="col-span-3 glass-card p-8 border-white/5">
            <h3 class="text-xs font-black text-white uppercase tracking-widest mb-6">
                Fluxo de Caixa: <span class="text-emerald-500">Realizado</span> vs. <span class="text-orange-500">Projetado</span>
            </h3>
            <div class="h-[300px]">
                <canvas id="cashFlowChart"></canvas>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="glass-card p-8 border-white/5">
            <h3 class="text-xs font-black text-white uppercase tracking-widest mb-6">Distribuição de Despesas</h3>
            <div class="h-[300px]">
                <canvas id="expenseChart"></canvas>
            </div>
        </div>
        <div class="glass-card p-8 border-white/5">
            <h3 class="text-xs font-black text-white uppercase tracking-widest mb-6">Performance de Lucratividade</h3>
            <div class="h-[300px]">
                <canvas id="profitChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Centro de Custos Evoluído -->
    <div class="glass-card p-8 border-white/5">
        <h3 class="text-xs font-black text-white uppercase tracking-widest mb-6">
            Centro de <span class="text-gradient">Custos</span> Organizado
        </h3>
        <p class="text-[9px] text-gray-500 uppercase font-bold tracking-wider mb-6">
            45 itens estruturados de custo divididos igualmente entre as 3 principais áreas de negócio do estúdio.
        </p>
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Operacional / Produção 3D -->
            <div class="space-y-4">
                <div class="flex items-center gap-3 pb-3 border-b border-emerald-500/20">
                    <span class="material-symbols-outlined text-emerald-400">biotech</span>
                    <div>
                        <h4 class="text-xs font-black text-white uppercase tracking-wider">1. Operacional & Produção 3D</h4>
                        <p class="text-[8px] font-bold text-emerald-500/60 uppercase tracking-widest">Variáveis / Diretos</p>
                    </div>
                </div>
                <div class="space-y-2 max-h-[350px] overflow-y-auto pr-2 custom-scrollbar">
                    <div class="space-y-2" id="cc-operacional-list"></div>
                </div>
            </div>
            
            <!-- Administrativo / Fixos -->
            <div class="space-y-4">
                <div class="flex items-center gap-3 pb-3 border-b border-purple-500/20">
                    <span class="material-symbols-outlined text-purple-400">corporate_fare</span>
                    <div>
                        <h4 class="text-xs font-black text-white uppercase tracking-wider">2. Administrativo & Fixos</h4>
                        <p class="text-[8px] font-bold text-purple-500/60 uppercase tracking-widest">Estrutura / Operação</p>
                    </div>
                </div>
                <div class="space-y-2 max-h-[350px] overflow-y-auto pr-2 custom-scrollbar">
                    <div class="space-y-2" id="cc-administrativo-list"></div>
                </div>
            </div>
            
            <!-- Comercial / Crescimento -->
            <div class="space-y-4">
                <div class="flex items-center gap-3 pb-3 border-b border-pink-500/20">
                    <span class="material-symbols-outlined text-pink-400">trending_up</span>
                    <div>
                        <h4 class="text-xs font-black text-white uppercase tracking-wider">3. Comercial & Crescimento</h4>
                        <p class="text-[8px] font-bold text-pink-500/60 uppercase tracking-widest">Prospecção / Marketing</p>
                    </div>
                </div>
                <div class="space-y-2 max-h-[350px] overflow-y-auto pr-2 custom-scrollbar">
                    <div class="space-y-2" id="cc-comercial-list"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tab Pane 2: Extrato de Transações -->
<div id="tab-pane-extrato" class="finance-pane hidden space-y-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-2">
        <div>
            <h3 class="text-sm font-black text-white uppercase tracking-widest">
                Extrato de <span class="text-gradient">Transações</span>
            </h3>
            <p class="text-[9px] text-gray-500 font-bold uppercase tracking-wider mt-1">Navegue pelas receitas, despesas e transferências lançadas</p>
        </div>
        <div class="relative w-full md:w-80">
            <input type="text" id="search-transactions" class="w-full bg-white/[0.02] border border-white/5 rounded-xl pl-10 pr-4 py-3 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-orange-500/50 transition-colors" placeholder="Buscar por descrição ou favorecido...">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm">search</span>
        </div>
    </div>

    <div class="glass-card border-white/5 overflow-hidden rounded-[2rem] shadow-2xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-white/[0.02]">
                        <th class="px-8 py-6 text-[10px] font-black text-gray-500 uppercase tracking-widest">Descrição</th>
                        <th class="px-8 py-6 text-[10px] font-black text-gray-500 uppercase tracking-widest">Categoria</th>
                        <th class="px-8 py-6 text-[10px] font-black text-gray-500 uppercase tracking-widest">Vencimento</th>
                        <th class="px-8 py-6 text-[10px] font-black text-gray-500 uppercase tracking-widest">Valor</th>
                        <th class="px-8 py-6 text-[10px] font-black text-gray-500 uppercase tracking-widest text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    {{#each transactions}}
                    <tr class="hover:bg-white/[0.03] transition-colors group">
                        <td class="px-8 py-6">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 rounded-xl flex items-center justify-center 
                                    {{#if (eq this.type 'receita')}}bg-emerald-500/20 text-emerald-500
                                    {{else}}{{#if (eq this.type 'transferir')}}bg-indigo-500/20 text-indigo-500
                                    {{else}}bg-red-500/20 text-red-500{{/if}}{{/if}} text-center">
                                    <span class="material-symbols-outlined text-xl flex items-center justify-center">
                                        {{#if (eq this.type 'receita')}}trending_up
                                        {{else}}{{#if (eq this.type 'transferir')}}sync_alt
                                        {{else}}trending_down{{/if}}{{/if}}
                                    </span>
                                </div>
                                <div>
                                    <p class="text-xs font-black text-white">{{this.description}}</p>
                                    <p class="text-[9px] text-gray-500 uppercase font-bold">
                                        {{#if (eq this.type 'transferir')}}
                                            De <span class="text-indigo-400">{{this.originAccount}}</span> para <span class="text-emerald-400">{{this.destinationAccount}}</span>
                                        {{else}}
                                            {{this.payer}}
                                        {{/if}}
                                    </p>
                                </div>
                            </div>
                        </td>
                        <td class="px-8 py-6">
                            {{#if (eq this.type 'transferir')}}
                            <span class="text-[10px] font-black text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-lg border border-indigo-500/20 uppercase">Transferência</span>
                            {{else}}
                            <span class="text-[10px] font-black text-gray-400 bg-white/5 px-3 py-1 rounded-lg border border-white/5 uppercase">{{this.category}}</span>
                            {{#if this.costClassification}}
                            <span class="text-[8px] font-bold px-2 py-0.5 rounded bg-white/5 border border-white/5 ml-1 uppercase {{#if (eq this.costClassification 'fixo')}}text-purple-400 border-purple-500/20{{else}}text-pink-400 border-pink-500/20{{/if}}">
                                {{this.costClassification}}
                            </span>
                            {{/if}}
                            {{/if}}
                        </td>
                        <td class="px-8 py-6 text-[11px] font-bold text-gray-400">{{formatDate this.dueDate}}</td>
                        <td class="px-8 py-6">
                            <span class="text-xs font-black 
                                {{#if (eq this.type 'receita')}}text-emerald-500
                                {{else}}{{#if (eq this.type 'transferir')}}text-indigo-400
                                {{else}}text-red-500{{/if}}{{/if}}">
                                {{#if (eq this.type 'receita')}}+
                                {{else}}{{#if (eq this.type 'transferir')}}⇄
                                {{else}}-{{/if}}{{/if}} {{formatCurrency this.amount}}
                            </span>
                        </td>
                        <td class="px-8 py-6 text-right">
                            <span class="text-[9px] font-black px-3 py-1.5 rounded-lg border 
                                {{#if (eq this.status 'recebido')}}bg-emerald-500/10 border-emerald-500/20 text-emerald-500
                                {{else}}{{#if (eq this.status 'pago')}}bg-emerald-500/10 border-emerald-500/20 text-emerald-500
                                {{else}}bg-orange-500/10 border-orange-500/20 text-orange-500{{/if}}{{/if}} uppercase tracking-widest">
                                {{#if (eq this.status 'recebido')}}Recebido
                                {{else}}{{#if (eq this.status 'pago')}}Pago
                                {{else}}Pendente{{/if}}{{/if}}
                            </span>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Tab Pane 3: Lucratividade por Projeto -->
<div id="tab-pane-lucro" class="finance-pane hidden space-y-6">
    <div>
        <h3 class="text-sm font-black text-white uppercase tracking-widest">
            Análise de <span class="text-gradient">Lucratividade</span> por Projeto
        </h3>
        <p class="text-[9px] text-gray-500 font-bold uppercase tracking-wider mt-1">Visão holística da rentabilidade líquida por contrato fechado</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {{#each projectProfits}}
        <div class="glass-card p-8 border-white/5 bg-white/[0.01] hover:bg-white/[0.03] transition-all group">
            <div class="flex items-center justify-between mb-6">
                <h4 class="text-sm font-black text-white group-hover:text-cyber-500 transition-colors truncate pr-4">{{this.name}}</h4>
                <span class="text-[10px] font-black px-2 py-1 rounded bg-cyber-500/10 text-cyber-500 border border-cyber-500/20">
                    {{this.margin}}% Margem
                </span>
            </div>
            
            <div class="space-y-4">
                <div class="flex justify-between items-center">
                    <span class="text-[9px] font-bold text-gray-500 uppercase tracking-widest">Valor do Contrato</span>
                    <span class="text-xs font-black text-white">{{formatCurrency this.price}}</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-[9px] font-bold text-gray-500 uppercase tracking-widest">Recebido (Realizado)</span>
                    <span class="text-xs font-black text-emerald-500">{{formatCurrency this.income}}</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-[9px] font-bold text-gray-500 uppercase tracking-widest">Custos (Freelancers/Outros)</span>
                    <span class="text-xs font-black text-red-500">{{formatCurrency this.expenses}}</span>
                </div>
                
                <div class="pt-4 border-t border-white/5 flex justify-between items-center">
                    <span class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">Resultado Líquido</span>
                    <span class="text-lg font-black {{#if (gt this.profit 0)}}text-cyber-500{{else}}text-red-500{{/if}}">
                        {{formatCurrency this.profit}}
                    </span>
                </div>
            </div>

            <!-- Progress Bar: Income vs Price -->
            <div class="mt-6 w-full h-1.5 bg-white/5 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-emerald-500 to-cyber-500" style="width: {{#if (gt this.price 0)}}{{multiply (divide this.income this.price) 100}}{{else}}0{{/if}}%"></div>
            </div>
            <p class="text-[8px] font-bold text-gray-600 uppercase mt-2 text-right tracking-widest">Faturamento Realizado</p>
        </div>
        {{/each}}
    </div>
</div>

<!-- Modal: Nova Transação Evoluída -->
<div class="modal fade" id="newTransactionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content glass-card border-white/10 shadow-2xl rounded-[3rem] overflow-hidden bg-[#0a0c10] backdrop-blur-3xl">
            <div class="modal-header border-none p-10 pb-0">
                <h2 class="text-2xl font-black text-white tracking-tight">Lançamento Financeiro</h2>
                <button type="button" class="btn-close btn-close-white opacity-30" data-bs-dismiss="modal"></button>
            </div>
            
            <form id="financeForm">
                <div class="modal-body p-10 space-y-10">
                    <!-- Type Selection -->
                    <div class="grid grid-cols-3 gap-6">
                        <button type="button" data-type="receita" class="finance-type-btn btn-set-type p-8 rounded-3xl bg-white/[0.03] border border-white/5 flex flex-col items-center gap-4 transition-all hover:bg-white/5 active">
                            <span class="material-symbols-outlined text-3xl text-emerald-500">add_circle</span>
                            <span class="text-[10px] font-black text-white uppercase tracking-[0.2em]">Receita</span>
                        </button>
                        <button type="button" data-type="despesa" class="finance-type-btn btn-set-type p-8 rounded-3xl bg-white/[0.03] border border-white/5 flex flex-col items-center gap-4 transition-all hover:bg-white/5">
                            <span class="material-symbols-outlined text-3xl text-red-500">remove_circle</span>
                            <span class="text-[10px] font-black text-white uppercase tracking-[0.2em]">Despesa</span>
                        </button>
                        <button type="button" data-type="transferir" class="finance-type-btn btn-set-type p-8 rounded-3xl bg-white/[0.03] border border-white/5 flex flex-col items-center gap-4 transition-all hover:bg-white/5">
                            <span class="material-symbols-outlined text-3xl text-indigo-500">sync_alt</span>
                            <span class="text-[10px] font-black text-white uppercase tracking-[0.2em]">Transferir</span>
                        </button>
                    </div>

                    <input type="hidden" name="type" id="finance-type" value="receita">

                    <!-- Description, Amount, DueDate -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <div class="space-y-3">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Descrição</label>
                            <input type="text" name="description" id="finance-description" required class="input-premium" placeholder="Ex: Licença D5 / Parcela 1">
                        </div>
                        <div class="space-y-3">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Valor (R$)</label>
                            <input type="number" step="0.01" name="amount" required class="input-premium" placeholder="0.00">
                        </div>
                        <div class="space-y-3">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest" id="lbl-due-date">Vencimento</label>
                            <input type="date" name="dueDate" required class="input-premium">
                        </div>
                    </div>

                    <!-- FIELDS SPECIFIC TO RECEITA -->
                    <div id="fields-receita" class="space-y-8">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="space-y-3">
                                <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Cliente</label>
                                <select name="payer" id="receita-payer-select" class="input-premium" required>
                                    <option value="">Selecionar Cliente</option>
                                    {{#each clients}}
                                    <option value="{{this.name}}">{{this.name}} ({{this.company}})</option>
                                    {{/each}}
                                </select>
                            </div>
                            <div class="space-y-3">
