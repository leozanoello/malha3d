    </div>
   </div>
  `;
  document.body.insertAdjacentHTML('beforeend', modalHtml);
 } catch (e) { alert('Erro ao carregar transação'); }
};

// === APROVAR RECEITA ===
window.aprovarTransacao = async function(id) {
 if (!confirm('Aprovar esta receita?')) return;
 const res = await fetch('/admin/api/financeiro/' + id + '/aprovar', { method: 'POST' });
 const data = await res.json();
 if (data.success) {
  if (window.showToast) window.showToast('Receita aprovada!', 'success');
  document.getElementById('transactionDetailModal')?.remove();
  setTimeout(() => location.reload(), 500);
 } else alert(data.error || 'Erro');
};

// === PAGAR DESPESA ===
window.pagarDespesa = async function(id) {
 if (!confirm('Confirmar pagamento desta despesa?')) return;
 const res = await fetch('/admin/api/financeiro/' + id + '/dar-baixa', { method: 'POST' });
 const data = await res.json();
 if (data.success) {
  if (window.showToast) window.showToast('Despesa paga!', 'success');
  document.getElementById('transactionDetailModal')?.remove();
  setTimeout(() => location.reload(), 500);
 } else alert(data.error || 'Erro');
};

// === SALVAR CATEGORIA ===
window.salvarCategoriaTransacao = async function(id) {
 const cat = document.getElementById('td_category')?.value;
 if (!cat) return;
 const res = await fetch('/admin/api/financeiro/' + id + '/editar-categoria', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({category: cat}) });
 const data = await res.json();
 if (data.success) {
  if (window.showToast) window.showToast('Categoria atualizada!', 'success');
  document.getElementById('transactionDetailModal')?.remove();
  setTimeout(() => location.reload(), 500);
 } else alert(data.error || 'Erro');
};
