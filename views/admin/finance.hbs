<script>
document.addEventListener('DOMContentLoaded', function() {
 // === FINANCE TYPE SELECTION & VIEW TOGGLING ===
 window.toggleTransactionType = function(type) {
 document.getElementById('finance-type').value = type;
 
 // Toggle active classes on modal buttons
 document.querySelectorAll('.finance-type-btn').forEach(btn => {
 if (btn.dataset.type === type) {
 btn.classList.add('active');
 } else {
 btn.classList.remove('active');
 }
 });

 // Show/hide relevant fields
 const fieldsReceita = document.getElementById('fields-receita');
 const fieldsDespesa = document.getElementById('fields-despesa');
 const fieldsTransferir = document.getElementById('fields-transferir');
 const fieldsCommon = document.getElementById('fields-common');
 const fieldsUpload = document.getElementById('fields-upload');

 if (type === 'upload') {
 fieldsReceita.classList.add('hidden');
 fieldsDespesa.classList.add('hidden');
 fieldsTransferir.classList.add('hidden');
 fieldsCommon.classList.add('hidden');
 fieldsUpload.classList.remove('hidden');
 return;
 }
 fieldsUpload.classList.add('hidden');

 const inputDesc = document.getElementById('finance-description');
 const selectPayer = document.getElementById('receita-payer-select');
 const inputPayer = document.getElementById('despesa-payer-input');
 const selectOrigin = document.getElementById('transferir-origin');
 const selectDest = document.getElementById('transferir-destination');
 const lblDueDate = document.getElementById('lbl-due-date');

 if (type === 'receita') {
 fieldsReceita.classList.remove('hidden');
 fieldsDespesa.classList.add('hidden');
 fieldsTransferir.classList.add('hidden');
 fieldsCommon.classList.remove('hidden');

 inputDesc.placeholder = 'Ex: Parcela 1 - Projeto Casa Cor';
 lblDueDate.textContent = 'Vencimento';

 selectPayer.setAttribute('required', 'required');
 inputPayer.removeAttribute('required');
 selectOrigin.removeAttribute('required');
 selectDest.removeAttribute('required');
 } else if (type === 'despesa') {
 fieldsReceita.classList.add('hidden');
 fieldsDespesa.classList.remove('hidden');
 fieldsTransferir.classList.add('hidden');
 fieldsCommon.classList.remove('hidden');

 inputDesc.placeholder = 'Ex: Licença D5 Render Annual';
 lblDueDate.textContent = 'Vencimento';

 selectPayer.removeAttribute('required');
 inputPayer.setAttribute('required', 'required');
 selectOrigin.removeAttribute('required');
 selectDest.removeAttribute('required');
 } else if (type === 'transferir') {
 fieldsReceita.classList.add('hidden');
 fieldsDespesa.classList.add('hidden');
 fieldsTransferir.classList.remove('hidden');
 fieldsCommon.classList.add('hidden');

 inputDesc.placeholder = 'Ex: Transferência Interna';
 lblDueDate.textContent = 'Data da Transferência';

 selectPayer.removeAttribute('required');
 inputPayer.removeAttribute('required');
 selectOrigin.setAttribute('required', 'required');
 selectDest.setAttribute('required', 'required');
 }
 };

 window.setModalType = function(type) {
 setTimeout(() => {
 toggleTransactionType(type);
 
 const titleEl = document.getElementById('newTransactionModalTitle');
 const gridEl = document.getElementById('finance-type-selection-grid');
 
 if (titleEl && gridEl) {
 // Título dinâmico em português
 if (type === 'receita') {
 titleEl.textContent = 'Lançamento de Receita';
 } else if (type === 'despesa') {
 titleEl.textContent = 'Lançamento de Despesa';
 } else if (type === 'transferir') {
 titleEl.textContent = 'Lançamento de Transferência';
 } else {
 titleEl.textContent = 'Lançamento Financeiro';
 }
 
 // Mostrar apenas a opção ativa e esconder as demais
 const buttons = gridEl.querySelectorAll('.finance-type-btn');
 buttons.forEach(btn => {
 if (btn.dataset.type === type) {
 btn.classList.remove('hidden');
 btn.classList.add('active');
 } else {
 btn.classList.add('hidden');
 btn.classList.remove('active');
 }
 });
 
 // Ajustar coluna do grid para ocupar espaço total elegante
 gridEl.classList.remove('grid-cols-3');
 gridEl.classList.add('grid-cols-1');
 }
 }, 50);
 };

 // Add click handler to modal type buttons directly
 document.addEventListener('click', function(e) {
 const typeBtn = e.target.closest('.btn-set-type');
 if (typeBtn) {
 const type = typeBtn.dataset.type;
 toggleTransactionType(type);
 }
 });

 // === FORM SUBMISSION ===
 document.getElementById('financeForm')?.addEventListener('submit', async function(e) {
 e.preventDefault();
 const data = Object.fromEntries(new FormData(this).entries());
 
 try {
 const response = await fetch('/admin/api/financeiro', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify(data)
 });
 const result = await response.json();
 if (result.success) window.location.reload();
 else alert('Erro: ' + result.message);
 } catch (err) { console.error(err); }
 });

 // === AI RECEIPT UPLOAD ANALYSIS ===
 window.handleReceiptFileSelected = function(input) {
 const file = input.files && input.files[0];
 const btnAnalyze = document.getElementById('btn-analyze-receipt');
 const previewImg = document.getElementById('receipt-preview-img');
 const statusEl = document.getElementById('receipt-analysis-status');
 statusEl.textContent = '';
 if (!file) {
 btnAnalyze.disabled = true;
 previewImg.classList.add('hidden');
 return;
 }
 previewImg.src = URL.createObjectURL(file);
 previewImg.classList.remove('hidden');
 btnAnalyze.disabled = false;
 };

 window.analyzeReceiptUpload = async function() {
 const input = document.getElementById('receipt-file-input');
 const file = input.files && input.files[0];
 const btnAnalyze = document.getElementById('btn-analyze-receipt');
 const statusEl = document.getElementById('receipt-analysis-status');
 if (!file) return;

 btnAnalyze.disabled = true;
 statusEl.className = 'text-[10px] font-bold uppercase tracking-widest text-gray-400';
 statusEl.textContent = 'Analisando imagem com IA...';

 try {
 const formData = new FormData();
 formData.append('receipt', file);
 const res = await fetch('/admin/api/financeiro/extract-receipt', { method: 'POST', body: formData });
 const result = await res.json();

 if (!result.success) {
 statusEl.className = 'text-[10px] font-bold uppercase tracking-widest text-red-400';
 statusEl.textContent = result.message || 'Não foi possível analisar a imagem.';
 btnAnalyze.disabled = false;
 return;
 }

 const data = result.data;
 toggleTransactionType(data.type);
 // Keep the upload panel visible alongside the now-prefilled fields so the
 // user still sees the preview image and the "dados extraídos" status.
 document.getElementById('fields-upload').classList.remove('hidden');
 document.querySelectorAll('.finance-type-btn').forEach(btn => {
 btn.classList.toggle('active', btn.dataset.type === data.type);
 });

 if (data.description) document.getElementById('finance-description').value = data.description;
 const amountInput = document.querySelector('input[name="amount"]');
 if (amountInput && data.amount) amountInput.value = data.amount;
 const dueDateInput = document.querySelector('input[name="dueDate"]');
 if (dueDateInput && data.date) dueDateInput.value = data.date;
 const paymentMethodSelect = document.querySelector('select[name="paymentMethod"]');
 if (paymentMethodSelect && data.paymentMethod) {
 const match = Array.from(paymentMethodSelect.options).find(o => o.value === data.paymentMethod);
 if (match) paymentMethodSelect.value = data.paymentMethod;
 }
 if (data.type === 'despesa') {
 const payerInput = document.getElementById('despesa-payer-input');
 if (payerInput && data.description) payerInput.value = data.description;
 }
 if (result.attachment) document.getElementById('finance-attachment').value = result.attachment;

 statusEl.className = 'text-[10px] font-bold uppercase tracking-widest text-emerald-400';
 statusEl.textContent = 'Dados extraídos! Revise as informações abaixo antes de salvar.';
 } catch (err) {
 console.error('Receipt analysis error:', err);
 statusEl.className = 'text-[10px] font-bold uppercase tracking-widest text-red-400';
 statusEl.textContent = 'Erro de conexão ao analisar a imagem.';
 } finally {
 btnAnalyze.disabled = false;
 }
 };

 // === DYNAMIC SELECT OPTIONS MANAGER (+ / EDIT / DELETE) ===
 // Same mechanism used on the CRM lead form, scoped to Finance fields.
 window.addDynamicOption = function(fieldId) {
 const name = prompt('Digite a nova opção a ser cadastrada:');
 if (!name || name.trim() === '') return;
 const select = document.getElementById('select_' + fieldId) || document.querySelector(`select[name="${fieldId}"]`);
 if (!select) return;

 const opt = document.createElement('option');
 opt.value = name.trim();
 opt.textContent = name.trim();
 opt.className = 'bg-gray-900';
 opt.selected = true;
 select.appendChild(opt);

 const saved = JSON.parse(localStorage.getItem('finance_custom_options_' + fieldId) || '[]');
 saved.push(name.trim());
 localStorage.setItem('finance_custom_options_' + fieldId, JSON.stringify(saved));
 };

 window.openManageOptionsModal = function(fieldId, title) {
 const select = document.getElementById('select_' + fieldId) || document.querySelector(`select[name="${fieldId}"]`);
 if (!select) return;

 const options = Array.from(select.options);
 let listHtml = '';
 options.forEach((opt, idx) => {
 if (!opt.value) return;
 listHtml += `
 <div class="flex items-center justify-between p-3 rounded-[5px] border border-white/10 bg-white/5">
 <span class="text-xs font-bold text-white">${opt.text}</span>
 <div class="flex items-center gap-2">
 <button type="button" onclick="window.renameSelectOption('${fieldId}', ${idx})" class="text-[10px] font-black uppercase text-amber-400 bg-amber-500/10 px-2.5 py-1 rounded-md border border-amber-500/20 hover:bg-amber-500 hover:text-white transition-all">Editar</button>
 <button type="button" onclick="window.removeSelectOption('${fieldId}', ${idx})" class="text-[10px] font-black uppercase text-red-400 bg-red-500/10 px-2.5 py-1 rounded-md border border-red-500/20 hover:bg-red-500 hover:text-white transition-all">Excluir</button>
