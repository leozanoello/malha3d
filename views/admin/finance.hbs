 window.renameSelectOption = function(fieldId, idx) {
 const select = document.getElementById('select_' + fieldId) || document.querySelector(`select[name="${fieldId}"]`);
 if (!select || !select.options[idx]) return;
 const oldName = select.options[idx].text;
 const newName = prompt('Novo nome para a opção:', oldName);
 if (newName && newName.trim() !== '') {
 select.options[idx].text = newName.trim();
 select.options[idx].value = newName.trim();
 window.openManageOptionsModal(fieldId, fieldId);
 }
 };

 window.removeSelectOption = function(fieldId, idx) {
 const select = document.getElementById('select_' + fieldId) || document.querySelector(`select[name="${fieldId}"]`);
 if (!select || !select.options[idx]) return;
 if (confirm(`Deseja remover a opção "${select.options[idx].text}"?`)) {
 select.remove(idx);
 window.openManageOptionsModal(fieldId, fieldId);
 }
 };

