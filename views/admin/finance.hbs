 <div class="min-w-0 p-5 border-white/5 bg-gradient-to-br from-emerald-500/10 to-transparent">
 <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Total Receitas</p>
 <h3 class="fluid-kpi break-words font-black text-emerald-500">{{formatCurrency stats.income}}</h3>
 </div>
 <div class="min-w-0 p-5 border-white/5 bg-gradient-to-br from-red-500/10 to-transparent">
 <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Total Despesas</p>
 <h3 class="fluid-kpi break-words font-black text-red-500">{{formatCurrency stats.expense}}</h3>
 </div>
 <div class="min-w-0 p-5 border-white/5 bg-gradient-to-br from-orange-500/10 to-transparent">
 <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Saldo Projetado</p>
 <h3 class="fluid-kpi break-words font-black text-white">{{formatCurrency stats.balance}}</h3>
 </div>
 <div class="min-w-0 p-5 border-white/5 bg-gradient-to-br from-cyber-500/10 to-transparent">
 <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Margem Média Global</p>
 <h3 class="fluid-kpi break-words font-black text-cyber-500">{{bi.avgMargin}}%</h3>
 </div>
 </div>
 
 <!-- Custos Fixos vs Variáveis Card (Painel Geral) -->
 <div class="kcard-panel p-5 border-white/5 bg-gradient-to-br from-purple-500/5 to-transparent relative overflow-hidden">
 <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
 <div>
 <h4 class="text-sm font-black text-white uppercase tracking-widest mb-1">
 Fluxo de Custos: <span class="text-purple-400">Fixo</span> vs <span class="text-pink-400">Variável</span>
 </h4>
 <p class="text-[9px] text-gray-500 uppercase font-bold tracking-wider">
 Visão integrada dos custos recorrentes de estrutura vs custos associados a projetos e vendas.
 </p>
 </div>
 <div class="flex items-center gap-8">
 <div class="text-right">
 <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-1">Custos Fixos</p>
 <p class="text-lg font-black text-purple-400" id="val-custos-fixos">{{formatCurrency bi.fixedExpenses}}</p>
 </div>
 <div class="h-8 w-px bg-white/10"></div>
 <div class="text-right">
 <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-1">Custos Variáveis</p>
 <p class="text-lg font-black text-pink-400" id="val-custos-variaveis">{{formatCurrency bi.variableExpenses}}</p>
 </div>
 </div>
 </div>
 <!-- Progress Bar -->
 <div class="mt-6 w-full h-3 bg-white/5 rounded-full overflow-hidden flex">
 <div class="h-full bg-gradient-to-r from-purple-600 to-purple-400 transition-all duration-500" id="fixed-cost-bar" style="width: 0%" title="Custos Fixos"></div>
 <div class="h-full bg-gradient-to-r from-pink-600 to-pink-400 transition-all duration-500" id="var-cost-bar" style="width: 0%" title="Custos Variáveis"></div>
 </div>
 <div class="flex justify-between text-[8px] font-black text-gray-600 uppercase mt-2 tracking-widest">
 <span id="fixed-cost-percent">Fixos: 0%</span>
 <span id="var-cost-percent">Variáveis: 0%</span>
 </div>
 </div> <!-- CLOSED MISSING DIV HERE -->

 <!-- Receita Futura de Parcelas + Cash Flow Chart -->
 <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
 <div class="kcard-panel p-5 border-white/5 bg-gradient-to-br from-purple-500/10 to-transparent">
 <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Receita Futura (Parcelas)</p>
 <h3 class="text-2xl font-black text-purple-400">{{formatCurrency futureInstallments}}</h3>
 <p class="text-[8px] text-gray-600 mt-2 uppercase tracking-wider">Parcelas pendentes de propostas fechadas</p>
 </div>
 <div class="col-span-3 p-5 border-white/5">
 <h3 class="text-xs font-black text-white uppercase tracking-widest mb-6">
 Fluxo de Caixa: <span class="text-emerald-500">Realizado</span> vs. <span class="text-orange-500">Projetado</span>
 </h3>
 <div class="h-[300px]">
 <canvas id="cashFlowChart"></canvas>
 </div>
 </div>
 </div>

 <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
 <div class="kcard-panel p-5 border-white/5">
 <h3 class="text-xs font-black text-white uppercase tracking-widest mb-6">Distribuição de Despesas</h3>
 <div class="h-[300px]">
 <canvas id="expenseChart"></canvas>
 </div>
 </div>
 <div class="kcard-panel p-5 border-white/5">
 <h3 class="text-xs font-black text-white uppercase tracking-widest mb-6">Performance de Lucratividade</h3>
 <div class="h-[300px]">
 <canvas id="profitChart"></canvas>
 </div>
 </div>
 </div>

 <!-- Centro de Custos Evoluído -->
 <div class="kcard-panel p-5 border-white/5">
 <h3 class="text-xs font-black text-white uppercase tracking-widest mb-6">
 Centro de <span class="text-gradient">Custos</span> Organizado
 </h3>
 <p class="text-[9px] text-gray-500 uppercase font-bold tracking-wider mb-6">
 45 itens estruturados de custo divididos igualmente entre as 3 principais áreas de negócio do estúdio.
 </p>
 
 <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
 <!-- Operacional / Produção 3D -->
 <div class="space-y-4">
 <div class="flex items-center gap-3 pb-3 border-b border-emerald-500/20">
 <span class="material-symbols-outlined text-emerald-400">biotech</span>
 <div>
 <h4 class="text-xs font-black text-white uppercase tracking-wider">1. Operacional & Produção 3D</h4>
 <p class="text-[8px] font-bold text-emerald-500/60 uppercase tracking-widest">Variáveis / Diretos</p>
 </div>
 </div>
 <div class="space-y-2 max-h-[350px] overflow-y-auto pr-2 custom-scrollbar">
 <div class="space-y-2" id="cc-operacional-list"></div>
 </div>
 </div>
 
 <!-- Administrativo / Fixos -->
 <div class="space-y-4">
 <div class="flex items-center gap-3 pb-3 border-b border-purple-500/20">
 <span class="material-symbols-outlined text-purple-400">corporate_fare</span>
 <div>
 <h4 class="text-xs font-black text-white uppercase tracking-wider">2. Administrativo & Fixos</h4>
 <p class="text-[8px] font-bold text-purple-500/60 uppercase tracking-widest">Estrutura / Operação</p>
 </div>
 </div>
 <div class="space-y-2 max-h-[350px] overflow-y-auto pr-2 custom-scrollbar">
 <div class="space-y-2" id="cc-administrativo-list"></div>
 </div>
 </div>
 
 <!-- Comercial / Crescimento -->
 <div class="space-y-4">
 <div class="flex items-center gap-3 pb-3 border-b border-pink-500/20">
 <span class="material-symbols-outlined text-pink-400">trending_up</span>
 <div>
 <h4 class="text-xs font-black text-white uppercase tracking-wider">3. Comercial & Crescimento</h4>
 <p class="text-[8px] font-bold text-pink-500/60 uppercase tracking-widest">Prospecção / Marketing</p>
 </div>
 </div>
 <div class="space-y-2 max-h-[350px] overflow-y-auto pr-2 custom-scrollbar">
 <div class="space-y-2" id="cc-comercial-list"></div>
 </div>
 </div>
 </div>
 </div>
</div>

<!-- Tab Pane 2: Extrato de Transações -->
<div id="tab-pane-extrato" class="finance-pane hidden space-y-6">
 <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-2">
 <div>
 <h3 class="text-sm font-black text-white uppercase tracking-widest">
 Extrato de <span class="text-gradient">Transações</span>
 </h3>
 <p class="text-[9px] text-gray-500 font-bold uppercase tracking-wider mt-1">Clique em uma transação para abrir detalhes</p>
 </div>
 </div>

 <!-- FILTROS -->
 <div class="flex flex-wrap gap-2 p-3 rounded-[5px] border-white/5">
 <select id="filter-tipo" onchange="window.filterExtrato()" class="bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-[9px] text-white font-bold focus:border-orange-500 focus:outline-none appearance-none">
 <option value="">Todos os Tipos</option>
 <option value="receita">Receitas</option>
 <option value="despesa">Despesas</option>
 <option value="transferir">Transferências</option>
 </select>
 <select id="filter-status" onchange="window.filterExtrato()" class="bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-[9px] text-white font-bold focus:border-orange-500 focus:outline-none appearance-none">
 <option value="">Todos os Status</option>
 <option value="pendente">Pendente</option>
 <option value="pago">Pago</option>
 <option value="recebido">Recebido</option>
 <option value="atrasado">Atrasado</option>
 </select>
 <select id="filter-categoria" onchange="window.filterExtrato()" class="bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-[9px] text-white font-bold focus:border-orange-500 focus:outline-none appearance-none">
 <option value="">Todas Categorias</option>
 <option value="venda_projeto">Venda Projeto</option>
 <option value="recebivel_projeto">Recebível Projeto</option>
 <option value="operacional">Operacional</option>
 <option value="freelancers_modelagem">Freelancers</option>
 <option value="marketing">Marketing</option>
 <option value="infraestrutura">Infraestrutura</option>
 <option value="impostos">Impostos</option>
 </select>
 <input type="date" id="filter-data-de" onchange="window.filterExtrato()" class="bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-[9px] text-white font-bold focus:border-orange-500 focus:outline-none" title="De">
 <input type="date" id="filter-data-ate" onchange="window.filterExtrato()" class="bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-[9px] text-white font-bold focus:border-orange-500 focus:outline-none" title="Até">
 <input type="text" id="search-transactions" oninput="window.filterExtrato()" class="flex-1 min-w-[150px] bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-[9px] text-white font-bold placeholder-gray-500 focus:border-orange-500 focus:outline-none" placeholder="Buscar descrição...">
 <button onclick="window.clearFilters()" class="px-3 py-2 bg-white/5 border border-white/10 rounded-lg text-[9px] font-bold text-gray-400 hover:text-white">Limpar</button>
 </div>

 <div class="kcard-panel border-white/5 overflow-hidden rounded-[5px] shadow-2xl">
 <div class="overflow-x-auto">
 <table class="w-full text-left">
 <thead>
 <tr class="bg-white/[0.02]">
 <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-widest">Descrição</th>
 <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-widest">Categoria</th>
 <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-widest">Vencimento</th>
 <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-widest">Valor</th>
 <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-widest">Status</th>
 <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-widest text-right">Ação</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-white/5" id="extrato-tbody">
 {{#each transactions}}
 <tr class="hover:bg-white/[0.03] cursor-pointer transaction-row" data-id="{{this.id}}" data-type="{{this.type}}" data-status="{{this.status}}" data-category="{{this.category}}" data-date="{{this.dueDate}}" data-desc="{{this.description}}" onclick="window.openTransactionDetail('{{this.id}}')">
 <td class="px-4 py-4">
 <div class="flex items-center gap-3">
 <div class="w-8 h-8 rounded-lg flex items-center justify-center
 {{#if (eq this.type 'receita')}}bg-emerald-500/20 text-emerald-500
 {{else}}{{#if (eq this.type 'transferir')}}bg-indigo-500/20 text-indigo-500
 {{else}}bg-red-500/20 text-red-500{{/if}}{{/if}}">
 <span class="material-symbols-outlined text-sm">
 {{#if (eq this.type 'receita')}}trending_up{{else}}{{#if (eq this.type 'transferir')}}sync_alt{{else}}trending_down{{/if}}{{/if}}
 </span>
 </div>
 <div>
 <p class="text-[10px] font-black text-white truncate max-w-[200px]">{{this.description}}</p>
 <p class="text-[8px] text-gray-500 font-bold">{{this.paymentMethod}}</p>
 </div>
 </div>
 </td>
 <td class="px-4 py-4">
 <span class="text-[9px] font-bold text-gray-400 bg-white/5 px-2 py-0.5 rounded border border-white/5 uppercase">{{this.category}}</span>
 </td>
 <td class="px-4 py-4 text-[10px] font-bold text-gray-400">{{formatDate this.dueDate}}</td>
 <td class="px-4 py-4">
 <span class="text-[11px] font-black
 {{#if (eq this.type 'receita')}}text-emerald-500{{else}}text-red-500{{/if}}">
 {{#if (eq this.type 'receita')}}+{{else}}-{{/if}} {{formatCurrencyAbs this.amount}}
 </span>
 </td>
 <td class="px-4 py-4">
 <span class="text-[8px] font-black px-2 py-1 rounded-lg border uppercase
 {{#if (eq this.status 'pago')}}bg-emerald-500/10 border-emerald-500/20 text-emerald-400
 {{else if (eq this.status 'recebido')}}bg-emerald-500/10 border-emerald-500/20 text-emerald-400
 {{else if (eq this.status 'atrasado')}}bg-red-500/10 border-red-500/20 text-red-400
 {{else}}bg-orange-500/10 border-orange-500/20 text-orange-400{{/if}}">
 {{this.status}}
 </span>
 </td>
 <td class="px-4 py-4 text-right">
 {{#if (eq this.type 'receita')}}
  {{#if (eq this.status 'pendente')}}
  <button onclick="event.stopPropagation(); window.aprovarTransacao('{{this.id}}')" class="px-2 py-1 bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 rounded-lg text-[8px] font-black uppercase hover:bg-emerald-500 hover:text-white">Aprovar</button>
  {{/if}}
 {{else}}
  {{#if (eq this.status 'pendente')}}
  <button onclick="event.stopPropagation(); window.pagarDespesa('{{this.id}}')" class="px-2 py-1 bg-orange-500/10 text-orange-400 border border-orange-500/30 rounded-lg text-[8px] font-black uppercase hover:bg-orange-500 hover:text-white">Pagar</button>
  {{/if}}
 {{/if}}
 </td>
 </tr>
 {{/each}}
 </tbody>
 </table>
 </div>
 </div>
</div>

<!-- Tab Pane 3: Lucratividade por Projeto -->
<div id="tab-pane-lucro" class="finance-pane hidden space-y-6">
 <div>
 <h3 class="text-sm font-black text-white uppercase tracking-widest">
 Análise de <span class="text-gradient">Lucratividade</span> por Projeto
 </h3>
 <p class="text-[9px] text-gray-500 font-bold uppercase tracking-wider mt-1">Visão holística da rentabilidade líquida por contrato fechado</p>
 </div>

 <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
 {{#each projectProfits}}
 <div class="kcard-panel p-5 border-white/5 bg-white/[0.01] hover:bg-white/[0.03] transition-all group">
 <div class="flex items-center justify-between mb-6">
 <h4 class="text-sm font-black text-white group-hover:text-cyber-500 transition-colors truncate pr-4">{{this.name}}</h4>
 <span class="text-[10px] font-black px-2 py-1 rounded bg-cyber-500/10 text-cyber-500 border border-cyber-500/20">
 {{this.margin}}% Margem
 </span>
 </div>
 
 <div class="space-y-4">
 <div class="flex justify-between items-center">
 <span class="text-[9px] font-bold text-gray-500 uppercase tracking-widest">Valor do Contrato</span>
 <span class="text-xs font-black text-white">{{formatCurrency this.price}}</span>
 </div>
 <div class="flex justify-between items-center">
 <span class="text-[9px] font-bold text-gray-500 uppercase tracking-widest">Recebido (Realizado)</span>
 <span class="text-xs font-black text-emerald-500">{{formatCurrency this.income}}</span>
 </div>
 <div class="flex justify-between items-center">
 <span class="text-[9px] font-bold text-gray-500 uppercase tracking-widest">Custos (Freelancers/Outros)</span>
 <span class="text-xs font-black text-red-500">{{formatCurrency this.expenses}}</span>
 </div>
 
 <div class="pt-4 border-t border-white/5 flex justify-between items-center">
 <span class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">Resultado Líquido</span>
 <span class="text-lg font-black {{#if (gt this.profit 0)}}text-cyber-500{{else}}text-red-500{{/if}}">
 {{formatCurrency this.profit}}
 </span>
 </div>
 </div>

 <!-- Progress Bar: Income vs Price -->
 <div class="mt-6 w-full h-1.5 bg-white/5 rounded-full overflow-hidden">
 <div class="h-full bg-gradient-to-r from-emerald-500 to-cyber-500" style="width: {{#if (gt this.price 0)}}{{multiply (divide this.income this.price) 100}}{{else}}0{{/if}}%"></div>
 </div>
 <p class="text-[8px] font-bold text-gray-600 uppercase mt-2 text-right tracking-widest">Faturamento Realizado</p>
 </div>
 {{/each}}
 </div>
</div>

<!-- Modal: Nova Transação Evoluída -->
<div class="modal fade" id="newTransactionModal" tabindex="-1" aria-hidden="true">
 <div class="modal-dialog modal-dialog-centered modal-xl">
 <div class="modal-content border-white/10 shadow-2xl rounded-[3rem] overflow-hidden bg-[#0a0c10]">
 <div class="modal-header border-none p-10 pb-0">
 <h2 id="newTransactionModalTitle" class="text-2xl font-black text-white tracking-tight">Lançamento Financeiro</h2>
 <button type="button" class="btn-close btn-close-white opacity-30" data-bs-dismiss="modal"></button>
 </div>
 
 <form id="financeForm">
 <div class="modal-body p-10 space-y-10">
 <!-- Type Selection -->
 <div id="finance-type-selection-grid" class="grid grid-cols-2 md:grid-cols-4 gap-6">
 <button type="button" data-type="receita" class="finance-type-btn btn-set-type p-8 rounded-[5px] bg-white/[0.03] border border-white/5 flex flex-col items-center gap-4 transition-all hover:bg-white/5 active">
 <span class="material-symbols-outlined text-3xl text-emerald-500">add_circle</span>
 <span class="text-[10px] font-black text-white uppercase tracking-[0.2em]">Receita</span>
 </button>
 <button type="button" data-type="despesa" class="finance-type-btn btn-set-type p-8 rounded-[5px] bg-white/[0.03] border border-white/5 flex flex-col items-center gap-4 transition-all hover:bg-white/5">
 <span class="material-symbols-outlined text-3xl text-red-500">remove_circle</span>
 <span class="text-[10px] font-black text-white uppercase tracking-[0.2em]">Despesa</span>
 </button>
 <button type="button" data-type="transferir" class="finance-type-btn btn-set-type p-8 rounded-[5px] bg-white/[0.03] border border-white/5 flex flex-col items-center gap-4 transition-all hover:bg-white/5">
 <span class="material-symbols-outlined text-3xl text-indigo-500">sync_alt</span>
 <span class="text-[10px] font-black text-white uppercase tracking-[0.2em]">Transferir</span>
 </button>
