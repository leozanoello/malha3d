<!-- Header -->
<div class="mb-4 p-4 glass-card border-none bg-gradient-to-br from-white/5 to-white/[0.02]">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div>
            <h1 class="text-xl font-black text-white tracking-tight mb-0.5">
                Fluxo de <span class="text-gradient">Caixa</span>
            </h1>
            <p class="text-gray-400 font-medium text-[10px]">
                Gestão financeira estratégica e controle de <span class="text-orange-500">Lucratividade</span>.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <button class="bg-emerald-500 hover:bg-emerald-600 text-white font-black py-2 px-4 rounded-xl shadow-lg shadow-emerald-500/40 transition-all flex items-center gap-1.5 text-[10px]" data-bs-toggle="modal" data-bs-target="#newTransactionModal" data-type="receita">
                <span class="material-symbols-outlined text-sm">add_circle</span>
                Nova Receita
            </button>
            <button class="bg-red-500 hover:bg-red-600 text-white font-black py-2 px-4 rounded-xl shadow-lg shadow-red-500/40 transition-all flex items-center gap-1.5 text-[10px]" data-bs-toggle="modal" data-bs-target="#newTransactionModal" data-type="despesa">
                <span class="material-symbols-outlined text-sm">do_not_disturb_on</span>
                Nova Despesa
            </button>
        </div>
    </div>
</div>

<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-6">
    <div class="glass-card p-4 border-white/5 relative group overflow-hidden rounded-xl">
        <div class="absolute top-0 right-0 w-20 h-20 bg-orange-500/5 rounded-full blur-2xl -mr-10 -mt-10 group-hover:bg-orange-500/10 transition-all"></div>
        <div class="relative z-10">
            <p class="text-[8px] font-black text-gray-500 uppercase tracking-[0.2em] mb-1">Resultado Líquido</p>
            <h2 class="text-lg font-black text-white tracking-tight">{{formatCurrency stats.netResult}}</h2>
            <div class="mt-2 flex items-center gap-1">
                <span class="text-[7px] font-black text-orange-500 bg-orange-500/10 px-1.5 py-0.5 rounded-full uppercase tracking-wider ring-1 ring-orange-500/30">Saldo Consolidado</span>
            </div>
        </div>
    </div>

    <div class="glass-card p-4 border-white/5 relative group overflow-hidden rounded-xl">
        <div class="absolute top-0 right-0 w-20 h-20 bg-emerald-500/5 rounded-full blur-2xl -mr-10 -mt-10 group-hover:bg-emerald-500/10 transition-all"></div>
        <div class="relative z-10">
            <p class="text-[8px] font-black text-gray-500 uppercase tracking-[0.2em] mb-1">Total Recebido</p>
            <h2 class="text-lg font-black text-emerald-500 tracking-tight">{{formatCurrency stats.totalReceived}}</h2>
            <div class="mt-2 flex items-center gap-1 text-[8px] font-bold text-gray-400">
                <span class="material-symbols-outlined text-[10px] text-emerald-500">trending_up</span>
                {{stats.revenueCount}} liquidadas
            </div>
        </div>
    </div>

    <div class="glass-card p-4 border-white/5 relative group overflow-hidden rounded-xl">
        <div class="absolute top-0 right-0 w-20 h-20 bg-red-500/5 rounded-full blur-2xl -mr-10 -mt-10 group-hover:bg-red-500/10 transition-all"></div>
        <div class="relative z-10">
            <p class="text-[8px] font-black text-gray-500 uppercase tracking-[0.2em] mb-1">Total Pago</p>
            <h2 class="text-lg font-black text-red-500 tracking-tight">{{formatCurrency stats.totalPaid}}</h2>
            <div class="mt-2 flex items-center gap-1 text-[8px] font-bold text-gray-400">
                <span class="material-symbols-outlined text-[10px] text-red-500">payments</span>
                {{stats.expenseCount}} pagas
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <!-- Próximas Receitas -->
    <div class="glass-card border-white/5 overflow-hidden rounded-xl">
        <div class="p-4 border-b border-white/5 flex items-center justify-between bg-white/[0.01]">
            <h3 class="text-sm font-black text-white tracking-tight flex items-center gap-1.5">
                <span class="material-symbols-outlined text-emerald-500 text-sm">arrow_upward</span>
                Próximas Receitas
            </h3>
            <button class="text-[8px] font-black text-gray-500 hover:text-orange-500 transition-all uppercase tracking-[0.2em]">Ver Todas</button>
        </div>
        <div class="p-4 space-y-3">
            {{#each recentIncomes}}
            <div class="flex items-center justify-between group cursor-pointer hover:translate-x-1 transition-transform">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center group-hover:bg-emerald-500 group-hover:text-white transition-all border border-emerald-500/20">
                        <span class="material-symbols-outlined text-sm">payments</span>
                    </div>
                    <div>
                        <p class="text-[10px] font-black text-white mb-0.5">{{this.description}}</p>
                        <p class="text-[8px] text-gray-500 font-bold uppercase tracking-widest">{{formatDate this.dueDate}}</p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-[10px] font-black text-emerald-500">+ {{formatCurrency this.amount}}</p>
                    <p class="text-[7px] font-black text-gray-600 uppercase tracking-tighter">{{this.status}}</p>
                </div>
            </div>
            {{else}}
            <p class="text-center text-gray-600 text-[9px] font-bold py-4">Nenhuma receita pendente.</p>
            {{/each}}
        </div>
    </div>

    <!-- Próximas Despesas -->
    <div class="glass-card border-white/5 overflow-hidden rounded-xl">
        <div class="p-4 border-b border-white/5 flex items-center justify-between bg-white/[0.01]">
            <h3 class="text-sm font-black text-white tracking-tight flex items-center gap-1.5">
                <span class="material-symbols-outlined text-red-500 text-sm">arrow_downward</span>
                Próximas Despesas
            </h3>
            <button class="text-[8px] font-black text-gray-500 hover:text-orange-500 transition-all uppercase tracking-[0.2em]">Ver Todas</button>
        </div>
        <div class="p-4 space-y-3">
            {{#each recentExpenses}}
            <div class="flex items-center justify-between group cursor-pointer hover:translate-x-1 transition-transform">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-red-500/10 text-red-500 flex items-center justify-center group-hover:bg-red-500 group-hover:text-white transition-all border border-red-500/20">
                        <span class="material-symbols-outlined text-sm">receipt_long</span>
                    </div>
                    <div>
                        <p class="text-[10px] font-black text-white mb-0.5">{{this.description}}</p>
                        <p class="text-[8px] text-gray-500 font-bold uppercase tracking-widest">{{formatDate this.dueDate}}</p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-[10px] font-black text-red-500">- {{formatCurrency this.amount}}</p>
                    <p class="text-[7px] font-black text-gray-600 uppercase tracking-tighter">{{this.status}}</p>
                </div>
            </div>
            {{else}}
            <p class="text-center text-gray-600 text-[9px] font-bold py-4">Nenhuma despesa pendente.</p>
            {{/each}}
        </div>
    </div>
</div>

<!-- Transaction Modal com informações detalhadas -->
<div class="modal fade" id="newTransactionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-white/10 bg-[#0f0f0f]/95 backdrop-blur-2xl">
            <div class="modal-header border-white/5 p-4">
                <h5 class="text-sm font-black text-white tracking-tight flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-base" id="modalIcon">account_balance_wallet</span>
                    <span id="modalTitle">Nova Transação</span>
                </h5>
                <button type="button" class="btn-close btn-close-white opacity-50 hover:opacity-100 transition-opacity" data-bs-dismiss="modal"></button>
            </div>
            <form id="transactionForm">
                <input type="hidden" name="type" id="transactionType">
                <div class="modal-body p-5 space-y-3">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div class="space-y-1">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest px-1">Descrição</label>
                            <input type="text" name="description" required class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-1.5 px-3 text-[10px] text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="Ex: Pagamento Projeto Alpha">
                        </div>
                        <div class="space-y-1">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest px-1">Favorecido / Pagador</label>
                            <input type="text" name="favorecido" class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-1.5 px-3 text-[10px] text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="Nome do Cliente ou Fornecedor">
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                        <div class="space-y-1 md:col-span-2">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest px-1">Valor (R$)</label>
                            <input type="number" name="amount" step="0.01" required class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-1.5 px-3 text-[10px] text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="0.00">
                        </div>
                        <div class="space-y-1">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest px-1">Vencimento</label>
                            <input type="date" name="dueDate" required class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-1.5 px-3 text-[10px] text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
                        </div>
                        <div class="space-y-1">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest px-1">Competência</label>
                            <input type="month" name="competencia" class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-1.5 px-3 text-[10px] text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                        <div class="space-y-1 md:col-span-2">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest px-1">Categoria / C. de Custo</label>
                            <select name="category" class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-1.5 px-3 text-[10px] text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
                                <option value="Serviços">Serviços / Projetos</option>
                                <option value="Software">Software / Ferramentas</option>
                                <option value="Marketing">Marketing / Anúncios</option>
                                <option value="Hardware">Hardware / Equipamentos</option>
                                <option value="Impostos">Impostos / Taxas</option>
                                <option value="Outros">Outros</option>
                            </select>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest px-1">Método</label>
                            <select name="paymentMethod" class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-1.5 px-3 text-[10px] text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
                                <option value="pix">PIX</option>
                                <option value="boleto">Boleto Bancário</option>
                                <option value="cartao_credito">Cartão de Crédito</option>
                                <option value="transferencia">Transferência</option>
                            </select>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest px-1">Conta Bancária</label>
                            <select name="contaBancaria" class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-1.5 px-3 text-[10px] text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
                                <option value="itau">Itaú (Principal)</option>
                                <option value="nubank">Nubank PJ</option>
                                <option value="inter">Inter Empresas</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                        <div class="space-y-1">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest px-1">Status</label>
                            <select name="status" class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-1.5 px-3 text-[10px] text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
                                <option value="pendente">Pendente</option>
                                <option value="pago">Pago / Recebido</option>
                                <option value="atrasado">Atrasado</option>
                            </select>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest px-1">Recorrência</label>
                            <select name="recurrence" class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-1.5 px-3 text-[10px] text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
                                <option value="unica">Única</option>
                                <option value="mensal">Mensal</option>
                                <option value="anual">Anual</option>
                            </select>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest px-1">Projeto Relacionado</label>
                            <select name="projectId" class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-1.5 px-3 text-[10px] text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
                                <option value="">Nenhum</option>
                                <option value="1">Residência Alpha</option>
                                <option value="2">Condomínio Beta</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div class="space-y-1">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest px-1">Observações</label>
                            <textarea name="observacoes" class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-1.5 px-3 text-[10px] text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all h-16" placeholder="Anotações internas..."></textarea>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[8px] font-black text-gray-500 uppercase tracking-widest px-1">Comprovante / Anexo</label>
                            <div class="w-full bg-[#1a1c23] border border-white/10 border-dashed rounded-xl py-4 px-3 text-center cursor-pointer hover:bg-white/5 transition-colors">
                                <span class="material-symbols-outlined text-gray-500 text-lg">upload_file</span>
                                <p class="text-[8px] text-gray-400 font-medium mt-1">Clique ou arraste o arquivo aqui</p>
                                <input type="file" class="hidden" name="anexo">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-white/5 p-4 flex justify-end gap-2">
                    <button type="button" class="px-3 py-1.5 text-[9px] font-black text-gray-500 uppercase tracking-widest hover:text-white transition-all rounded-xl" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white font-black py-1.5 px-4 rounded-xl shadow-lg shadow-orange-500/20 transition-all flex items-center gap-1.5 text-[10px]">
                        <span class="material-symbols-outlined text-xs">save</span>
                        Salvar Transação
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const transModal = document.getElementById('newTransactionModal');
transModal.addEventListener('show.bs.modal', function (event) {
    const button = event.relatedTarget;
    const type = button.getAttribute('data-type');
    const title = type === 'receita' ? 'Lançar Receita' : 'Lançar Despesa';
    const icon = type === 'receita' ? 'add_circle' : 'do_not_disturb_on';
    const color = type === 'receita' ? '#10b981' : '#ef4444';
    
    document.getElementById('modalTitle').textContent = title;
    document.getElementById('modalIcon').textContent = icon;
    document.getElementById('modalIcon').style.color = color;
    document.getElementById('transactionType').value = type;
});

document.getElementById('transactionForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    
    try {
        const response = await fetch('/admin/api/financeiro', {
            method: 'POST',
            body: formData
        });
        
        const result = await response.json();
        if (result.success) {
            window.location.reload();
        } else {
            alert('Erro: ' + result.message);
        }
    } catch (error) {
        console.error('Error creating transaction:', error);
        alert('Erro ao processar solicitação');
    }
});
</script>
