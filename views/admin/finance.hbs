 </button>
 <button class="w-14 h-14 sm:w-16 sm:h-16 shrink-0 rounded-[5px] bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/20 hover:border-indigo-500/50 text-indigo-400 font-bold transition-all duration-300 flex flex-col items-center justify-center gap-1.5 hover:shadow-indigo-500/10 cursor-pointer" data-bs-toggle="modal" data-bs-target="#newTransactionModal" onclick="setModalType('transferir')">
 <span class="material-symbols-outlined text-xl">sync_alt</span>
 <span class="text-[8px] uppercase tracking-widest font-black text-center mt-1">Transferir</span>
 </button>
 </div>
 </div>
</div>

<!-- Tabs Navigation -->
<div class="flex items-center gap-2 mb-8 p-1.5 bg-white/[0.02] border border-white/5 rounded-[5px] max-w-2xl">
 <button class="finance-tab-btn flex items-center gap-2 px-6 py-3 rounded-[5px] text-[10px] font-black uppercase tracking-widest transition-all duration-300 active" data-tab="painel">
 <span class="material-symbols-outlined text-sm">dashboard</span>
 Painel Geral
 </button>
 <button class="finance-tab-btn flex items-center gap-2 px-6 py-3 rounded-[5px] text-[10px] font-black uppercase tracking-widest transition-all duration-300" data-tab="extrato">
 <span class="material-symbols-outlined text-sm">receipt_long</span>
 Extrato
 </button>
 <button class="finance-tab-btn flex items-center gap-2 px-6 py-3 rounded-[5px] text-[10px] font-black uppercase tracking-widest transition-all duration-300" data-tab="lucro">
