<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- JS — agregação dos endpoints e renderização da timeline                    -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<script>
(function () {
  'use strict';

  // ─── Configuração dos tipos de evento ────────────────────────────────────
  const TYPE_CONFIG = {
    ar_created:      { icon: 'receipt_long',  cat: 'finance',  color: 'orange', label: 'Conta a Receber' },
    ar_paid:         { icon: 'check_circle',  cat: 'finance',  color: 'green',  label: 'Recebimento' },
    project_deadline:{ icon: 'event_busy',    cat: 'projects', color: 'yellow', label: 'Prazo de Projeto' },
    task_overdue:    { icon: 'pending_actions', cat: 'alerts', color: 'red',    label: 'Tarefa Atrasada' },
    anomaly:         { icon: 'psychology',    cat: 'alerts',   color: 'pink',   label: 'Anomalia IA' }
  };

  // ─── Estado ──────────────────────────────────────────────────────────────
  let allEvents = [];
  let activeFilter = 'all';
  let refreshTimer = null;

  // ─── Elementos DOM ───────────────────────────────────────────────────────
  const els = {
    loading:  document.getElementById('timeline-loading'),
    empty:    document.getElementById('timeline-empty'),
    list:     document.getElementById('timeline-events'),
    tpl:      document.getElementById('timeline-event-template'),
    counter:  document.getElementById('timeline-counter'),
    status:   document.getElementById('timeline-status'),
    pulse:    document.getElementById('timeline-pulse'),
    lastUpd:  document.getElementById('timeline-last-update'),
    refreshBtn: document.getElementById('timeline-refresh-btn'),
    kpiTotal:    document.getElementById('kpi-total'),
    kpiFinance:  document.getElementById('kpi-finance'),
    kpiProjects: document.getElementById('kpi-projects'),
    kpiAlerts:   document.getElementById('kpi-alerts'),
    chips: document.querySelectorAll('.timeline-chip')
  };

  // ─── Utilitários ─────────────────────────────────────────────────────────
  function safeText(v) {
    if (v === null || v === undefined) return '';
    return String(v);
  }

  function formatCurrency(v) {
    var n = Number(v);
    if (isNaN(n)) return '';
    try {
      return n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 0 });
    } catch (e) {
      return 'R$ ' + n.toFixed(0);
    }
  }

  function formatDate(iso) {
    if (!iso) return '';
    var d = new Date(iso);
    if (isNaN(d.getTime())) return safeText(iso);
    var now = new Date();
    var diffMs = now - d;
    var diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    var dateStr = d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
    var timeStr = d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
    if (diffDays === 0) return 'Hoje, ' + timeStr;
    if (diffDays === 1) return 'Ontem, ' + timeStr;
    if (diffDays > 1 && diffDays < 7) return diffDays + ' dias atrás, ' + dateStr;
    return dateStr + ' · ' + timeStr;
  }

  function formatTimestamp(iso) {
    if (!iso) return '';
    var d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    return d.toISOString();
  }

  function setStatus(text, color) {
    if (!els.status) return;
    els.status.textContent = text;
    if (els.pulse) {
      els.pulse.classList.remove('bg-emerald-400', 'bg-orange-400', 'bg-red-400');
      els.pulse.classList.add(color || 'bg-emerald-400');
    }
  }

  // ─── Fetch com fallback silencioso ───────────────────────────────────────
  async function safeFetch(url) {
    try {
      var r = await fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
      if (!r.ok) return null;
      return await r.json();
    } catch (e) {
      return null;
    }
  }

  // ─── Normalização dos dados de cada endpoint ──────────────────────────────
  function normalizeAging(data) {
    if (!data || !Array.isArray(data.ar)) return [];
    return data.ar.map(function (item) {
      var paid = safeText(item.status).toLowerCase() === 'paid' || safeText(item.status).toLowerCase() === 'pago';
      return {
        id: 'ar-' + safeText(item.id),
        type: paid ? 'ar_paid' : 'ar_created',
        title: paid ? 'Recebimento confirmado' : 'Conta a receber criada',
        subtitle: safeText(item.description) + (item.client ? ' · ' + safeText(item.client) : '') + (item.amount ? ' · ' + formatCurrency(item.amount) : ''),
        date: safeText(item.dueDate) || new Date().toISOString(),
        link: '/admin/financeiro',
        raw: item
      };
    });
  }

  function normalizeAlerts(data) {
    if (!data || !Array.isArray(data.alerts)) return [];
    return data.alerts.map(function (a) {
      var t = safeText(a.type).toLowerCase();
      var type = 'task_overdue';
      if (t.indexOf('deadline') !== -1 || t.indexOf('prazo') !== -1) type = 'project_deadline';
      var daysLeft = (typeof a.daysLeft === 'number') ? a.daysLeft : null;
      var dateRef = new Date();
      if (daysLeft !== null) dateRef.setDate(dateRef.getDate() + daysLeft);
      return {
        id: 'alert-' + safeText(a.id),
        type: type,
        title: safeText(a.title) || 'Alerta de Prazo',
        subtitle: safeText(a.severity).toUpperCase() + (daysLeft !== null ? ' · ' + (daysLeft < 0 ? Math.abs(daysLeft) + 'd atrasado' : daysLeft + 'd restantes') : ''),
        date: dateRef.toISOString(),
        link: '/admin/projetos',
        raw: a
      };
    });
  }

  function normalizeAnomalies(data) {
    if (!data || !Array.isArray(data.anomalies)) return [];
    return data.anomalies.map(function (a) {
      return {
        id: 'anomaly-' + safeText(a.id),
        type: 'anomaly',
        title: safeText(a.description) || 'Anomalia detectada',
        subtitle: safeText(a.type).toUpperCase() + ' · Severidade ' + safeText(a.severity),
        date: safeText(a.createdAt) || new Date().toISOString(),
        link: '/admin/financeiro',
        raw: a
      };
    });
  }

  // ─── Carregar tudo ───────────────────────────────────────────────────────
  async function loadAll() {
    setStatus('Sincronizando', 'bg-orange-400');
    if (els.loading) els.loading.classList.remove('hidden');

    var results = await Promise.all([
      safeFetch('/admin/api/erp/aging'),
      safeFetch('/admin/api/deadline-alerts'),
      safeFetch('/admin/api/ai/anomalies')
    ]);

    allEvents = []
      .concat(normalizeAging(results[0]))
      .concat(normalizeAlerts(results[1]))
      .concat(normalizeAnomalies(results[2]));

    allEvents.sort(function (a, b) {
      return new Date(b.date) - new Date(a.date);
    });

    updateKpis();
    updateChips();
    render();

    if (els.loading) els.loading.classList.add('hidden');
    setStatus('Sincronizado', 'bg-emerald-400');
    if (els.lastUpd) els.lastUpd.textContent = formatDate(new Date().toISOString());
  }

  // ─── Atualizar KPIs ──────────────────────────────────────────────────────
  function updateKpis() {
    var cats = { finance: 0, projects: 0, alerts: 0 };
    allEvents.forEach(function (e) {
      var cfg = TYPE_CONFIG[e.type] || {};
      if (cfg.cat && cats.hasOwnProperty(cfg.cat)) cats[cfg.cat]++;
    });
    if (els.kpiTotal)    els.kpiTotal.textContent = allEvents.length;
    if (els.kpiFinance)  els.kpiFinance.textContent = cats.finance;
    if (els.kpiProjects) els.kpiProjects.textContent = cats.projects;
    if (els.kpiAlerts)   els.kpiAlerts.textContent = cats.alerts;
  }

  function updateChips() {
    var counts = { all: allEvents.length, finance: 0, projects: 0, alerts: 0 };
    allEvents.forEach(function (e) {
      var cfg = TYPE_CONFIG[e.type] || {};
      if (cfg.cat && counts.hasOwnProperty(cfg.cat)) counts[cfg.cat]++;
    });
    var ids = { all: 'chip-count-all', finance: 'chip-count-finance', projects: 'chip-count-projects', alerts: 'chip-count-alerts' };
    Object.keys(ids).forEach(function (k) {
      var el = document.getElementById(ids[k]);
      if (el) el.textContent = counts[k];
    });
  }

  // ─── Renderização ────────────────────────────────────────────────────────
  function render() {
    if (!els.list || !els.tpl) return;
    els.list.innerHTML = '';

    if (allEvents.length === 0) {
      if (els.empty) els.empty.classList.remove('hidden');
      els.empty.style.display = 'flex';
      if (els.counter) els.counter.textContent = '0 eventos';
      return;
    }
    if (els.empty) {
      els.empty.classList.add('hidden');
      els.empty.style.display = 'none';
    }

    var visible = 0;
    allEvents.forEach(function (ev, idx) {
      var cfg = TYPE_CONFIG[ev.type] || { icon: 'event', cat: 'alerts', color: 'orange', label: ev.type };
      var matchesFilter = (activeFilter === 'all') || (cfg.cat === activeFilter);
      if (!matchesFilter) return;
      visible++;

      var node = els.tpl.content.cloneNode(true);
      var wrap = node.querySelector('.timeline-event');
      wrap.setAttribute('data-event-type', ev.type);
      wrap.setAttribute('data-event-cat', cfg.cat);
      wrap.style.animationDelay = (idx * 30) + 'ms';

      // Dot
      var dot = node.querySelector('.timeline-dot');
      dot.classList.add('dot-' + cfg.color);
      var dotIcon = dot.querySelector('.material-symbols-outlined');
      dotIcon.textContent = cfg.icon;

      // Icon container
      var iconBox = node.querySelector('.timeline-icon');
      iconBox.classList.add('icon-' + cfg.color);
      var iconEl = iconBox.querySelector('.material-symbols-outlined');
      iconEl.textContent = cfg.icon;

      // Badges
      var catBadge = node.querySelector('.timeline-cat-badge');
      catBadge.textContent = cfg.cat.toUpperCase();
      catBadge.classList.add('cat-' + cfg.cat);

      var typeBadge = node.querySelector('.timeline-type-badge');
      typeBadge.textContent = cfg.label;
      typeBadge.classList.add('t-' + ev.type);

      // Title / subtitle / date
      node.querySelector('.timeline-title').textContent = ev.title;
      node.querySelector('.timeline-subtitle').textContent = ev.subtitle;
      node.querySelector('.timeline-date').textContent = formatDate(ev.date);

      // Link
      var linkEl = node.querySelector('.timeline-link');
      if (ev.link) {
        linkEl.setAttribute('href', ev.link);
      } else {
        linkEl.removeAttribute('href');
        linkEl.style.opacity = '0.3';
        linkEl.style.pointerEvents = 'none';
      }

      els.list.appendChild(node);
    });

    if (els.counter) els.counter.textContent = visible + ' ' + (visible === 1 ? 'evento' : 'eventos');
  }

  // ─── Filtros ─────────────────────────────────────────────────────────────
  function bindFilters() {
    els.chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        els.chips.forEach(function (c) { c.classList.remove('active'); });
        chip.classList.add('active');
        activeFilter = chip.getAttribute('data-filter') || 'all';
        render();
      });
    });
  }

  // ─── Auto-refresh ────────────────────────────────────────────────────────
  function startAutoRefresh() {
    if (refreshTimer) clearInterval(refreshTimer);
    refreshTimer = setInterval(loadAll, 5 * 60 * 1000); // 5 minutos
  }

  function bindRefresh() {
    if (!els.refreshBtn) return;
    els.refreshBtn.addEventListener('click', function () {
      var icon = els.refreshBtn.querySelector('.material-symbols-outlined');
      if (icon) icon.classList.add('animate-spin');
      loadAll().finally(function () {
        setTimeout(function () { if (icon) icon.classList.remove('animate-spin'); }, 600);
      });
    });
  }

  // ─── Init ────────────────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', function () {
    bindFilters();
    bindRefresh();
    loadAll();
    startAutoRefresh();
  });

  // Fallback: se DOMContentLoaded já disparou
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    bindFilters();
    bindRefresh();
    loadAll();
    startAutoRefresh();
  }
})();
</script>