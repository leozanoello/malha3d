<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- TIMELINE — LINHA DO TEMPO (consolidação de eventos de todos os módulos)    -->
<!-- Layout padrão kcard (#151515 / radius 5px / shadow 0 2px 8px rgba 0,0,0,.6) -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->

<div class="mb-4 p-5 relative overflow-hidden" style="background:#151515; border-radius:5px; box-shadow:0 2px 8px rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.06);">
 <div class="absolute top-0 right-0 w-64 h-64 bg-orange-500/10 blur-[100px] -mr-32 -mt-32 pointer-events-none"></div>

 <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
  <div class="min-w-0">
   <div class="flex items-center gap-3 mb-2">
    <span class="material-symbols-outlined text-orange-400 text-3xl">timeline</span>
    <h1 class="text-2xl font-black text-white tracking-tight">
     Linha do <span class="text-orange-400">Tempo</span>
    </h1>
   </div>
   <p class="text-gray-400 font-medium max-w-2xl break-words">
    Eventos consolidados de todos os módulos — financeiro, projetos e alertas inteligentes.
    <span class="text-orange-500 font-bold">Atualização automática a cada 5 minutos.</span>
   </p>
  </div>

  <div class="flex items-center gap-3 flex-wrap shrink-0">
   <div class="flex items-center gap-2 px-3 py-2 rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);">
    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" id="timeline-pulse"></span>
    <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest" id="timeline-status">Sincronizando</span>
   </div>
   <div class="flex items-center gap-2 px-3 py-2 rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);">
    <span class="material-symbols-outlined text-gray-500 text-sm">schedule</span>
    <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest" id="timeline-last-update">—</span>
   </div>
   <button id="timeline-refresh-btn" class="kcard flex items-center justify-center gap-1.5 w-auto h-auto px-4 py-2 cursor-pointer hover:border-orange-500/40" style="border-color:rgba(249,115,22,0.2);">
    <span class="material-symbols-outlined text-orange-400 text-sm">refresh</span>
    <span class="text-[9px] uppercase tracking-widest font-black text-orange-400">Atualizar</span>
   </button>
  </div>
 </div>
</div>

