<!-- Header -->
<div class="mb-10 p-8 glass-card border-none bg-gradient-to-br from-white/5 to-white/[0.02]">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h1 class="text-4xl font-black text-white tracking-tight mb-2">
                Aparência & <span class="text-gradient">Branding</span>
            </h1>
            <p class="text-gray-400 font-medium">
                Personalize a identidade visual do sistema e a experiência digital do portal do cliente.
            </p>
        </div>
        <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-8 rounded-2xl shadow-2xl shadow-orange-500/40 transition-all flex items-center gap-3">
            <span class="material-symbols-outlined">publish</span>
            Publicar Alterações
        </button>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
    <!-- Configuration Panels -->
    <div class="lg:col-span-2 space-y-10">
        <!-- System Theme -->
        <div class="glass-card p-10 border-white/5 bg-white/[0.01]">
            <h3 class="text-xl font-black text-white mb-8 flex items-center gap-4">
                <span class="w-10 h-10 bg-orange-500/10 rounded-xl flex items-center justify-center text-orange-500 border border-orange-500/20">
                    <span class="material-symbols-outlined">palette</span>
                </span>
                Cores & Atmosfera
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-3 ml-1">Cor Primária (Neon)</label>
                    <div class="flex items-center gap-4 p-4 bg-white/5 border border-white/10 rounded-2xl ring-1 ring-white/5">
                        <div class="w-10 h-10 bg-orange-500 rounded-xl shadow-[0_0_20px_rgba(249,115,22,0.4)]"></div>
                        <input type="text" value="#F97316" class="text-sm font-black text-white outline-none w-full bg-transparent tracking-widest">
                    </div>
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-3 ml-1">Fundo (Deep Space)</label>
                    <div class="flex items-center gap-4 p-4 bg-white/5 border border-white/10 rounded-2xl ring-1 ring-white/5">
                        <div class="w-10 h-10 bg-[#0f0f0f] rounded-xl border border-white/10"></div>
                        <input type="text" value="#0F0F0F" class="text-sm font-black text-white outline-none w-full bg-transparent tracking-widest">
                    </div>
                </div>
            </div>

            <div class="mt-10">
                <label class="block text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-6 ml-1">DNA Visual</label>
                <div class="grid grid-cols-3 gap-6">
                    <button class="p-6 rounded-2xl border-2 border-orange-500 bg-orange-500/5 flex flex-col items-center gap-3 transition-all shadow-2xl shadow-orange-500/10">
                        <span class="material-symbols-outlined text-orange-500 text-3xl">rounded_corner</span>
                        <span class="text-[10px] font-black text-white uppercase tracking-widest">Premium</span>
                    </button>
                    <button class="p-6 rounded-2xl border border-white/10 bg-white/5 hover:border-white/20 flex flex-col items-center gap-3 transition-all">
                        <span class="material-symbols-outlined text-gray-500 text-3xl">square</span>
                        <span class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Minimal</span>
                    </button>
                    <button class="p-6 rounded-2xl border border-white/10 bg-white/5 hover:border-white/20 flex flex-col items-center gap-3 transition-all">
                        <span class="material-symbols-outlined text-gray-500 text-3xl">blur_on</span>
                        <span class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Glass</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Typography & Logos -->
        <div class="glass-card p-10 border-white/5 bg-white/[0.01]">
            <h3 class="text-xl font-black text-white mb-8 flex items-center gap-4">
                <span class="w-10 h-10 bg-orange-500/10 rounded-xl flex items-center justify-center text-orange-500 border border-orange-500/20">
                    <span class="material-symbols-outlined">text_fields</span>
                </span>
                Identidade & Logos
            </h3>
            
            <div class="space-y-8">
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-4 ml-1">Asset de Marca (SVG/PNG)</label>
                    <div class="border-2 border-dashed border-white/10 rounded-[2.5rem] p-12 flex flex-col items-center justify-center gap-4 hover:bg-white/5 hover:border-orange-500/50 transition-all cursor-pointer group">
                        <div class="w-16 h-16 bg-white/5 rounded-2xl flex items-center justify-center text-gray-600 group-hover:text-orange-500 transition-all">
                            <span class="material-symbols-outlined text-4xl">cloud_upload</span>
                        </div>
                        <div class="text-center">
                            <p class="text-sm font-black text-white mb-1">Transmitir Identidade</p>
                            <p class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Formato Vetorial Recomendado • Máx 5MB</p>
                        </div>
                    </div>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <label class="block text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-3 ml-1">Tipografia Digital</label>
                        <select class="w-full p-4 bg-white/5 border border-white/10 rounded-2xl text-sm font-black text-white focus:ring-2 focus:ring-orange-500/20 transition-all cursor-pointer">
                            <option class="bg-[#0f0f0f]">Outfit (Modern Default)</option>
                            <option class="bg-[#0f0f0f]">Inter (Technical)</option>
                            <option class="bg-[#0f0f0f]">Plus Jakarta Sans (SaaS)</option>
                            <option class="bg-[#0f0f0f]">Montserrat (Classic Bold)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-3 ml-1">Dark Mode Engine</label>
                        <div class="flex items-center gap-4 p-4 bg-white/5 border border-white/10 rounded-2xl ring-1 ring-white/5">
                            <span class="text-sm font-black text-white flex-1">Atemporal Dark Active</span>
                            <div class="w-12 h-6 bg-orange-500 rounded-full relative cursor-pointer shadow-[0_0_15px_rgba(249,115,22,0.3)]">
                                <div class="absolute right-1.5 top-1.5 w-3 h-3 bg-white rounded-full"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Preview Sidebar -->
    <div class="space-y-8">
        <div class="glass-card p-8 border-white/5 bg-[#0a0a0a] shadow-2xl sticky top-24 overflow-hidden group">
            <div class="absolute top-0 right-0 w-48 h-48 bg-orange-500/5 rounded-full blur-[80px] -mr-24 -mt-24"></div>
            <h4 class="text-[10px] font-black text-gray-600 uppercase tracking-[0.3em] mb-10 relative z-10">Real-Time Core Preview</h4>
            
            <div class="space-y-10 relative z-10">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-orange-500 rounded-xl flex items-center justify-center font-black text-white shadow-2xl shadow-orange-500/40 rotate-3">M</div>
                    <span class="text-2xl font-black text-white tracking-tighter">Malha<span class="text-orange-500">3D</span></span>
                </div>
                
                <div class="space-y-4">
                    <div class="h-12 bg-orange-500/10 border border-orange-500/20 rounded-2xl flex items-center px-5 gap-4 text-orange-500 shadow-xl shadow-orange-500/5">
                        <span class="material-symbols-outlined text-xl">dashboard</span>
                        <span class="text-xs font-black uppercase tracking-widest">Dashboard</span>
                    </div>
                    <div class="h-12 hover:bg-white/5 rounded-2xl flex items-center px-5 gap-4 text-gray-600 transition-all cursor-pointer">
                        <span class="material-symbols-outlined text-xl">groups</span>
                        <span class="text-xs font-black uppercase tracking-widest">CRM Matrix</span>
                    </div>
                </div>
                
                <div class="pt-8 border-t border-white/5">
                    <div class="glass-card p-6 border-white/10 bg-white/[0.02]">
                        <div class="w-10 h-10 bg-orange-500/20 rounded-xl mb-4 border border-orange-500/30"></div>
                        <div class="h-2.5 w-3/4 bg-white/10 rounded-full mb-3"></div>
                        <div class="h-2 w-1/2 bg-white/5 rounded-full"></div>
                    </div>
                </div>
            </div>
        </div>
        
        <p class="text-center text-[10px] font-black text-gray-600 px-6 uppercase tracking-[0.2em] leading-relaxed">
            A visualização dinâmica reflete o <span class="text-orange-500">core design</span> do ecossistema Malha3D.
        </p>
    </div>
</div>

