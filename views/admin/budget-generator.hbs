<div class="h-screen flex flex-col -m-8 overflow-hidden bg-[#0a0c10]">
    <!-- Top Action Bar -->
    <div class="h-20 bg-black/40 backdrop-blur-xl border-b border-white/5 flex items-center justify-between px-8 z-50">
        <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-orange-500 flex items-center justify-center shadow-lg shadow-orange-500/20">
                <span class="material-symbols-outlined text-white">description</span>
            </div>
            <div>
                <h1 class="text-white font-black text-lg tracking-tighter uppercase">Gerador de <span class="text-orange-500">Orçamentos</span></h1>
                <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest">ArchViz Premium Workspace</p>
            </div>
        </div>
        
        <div class="flex items-center gap-4">
            <button id="btn-copy-link" class="px-6 py-3 rounded-xl bg-white/5 text-gray-400 text-[10px] font-black uppercase tracking-widest hover:text-white transition-all flex items-center gap-2 border border-white/5">
                <span class="material-symbols-outlined text-sm">link</span> Copiar Link Público
            </button>
            <button id="btn-export-pdf" class="px-8 py-3 rounded-xl bg-orange-500 text-white text-[10px] font-black uppercase tracking-[0.2em] shadow-xl shadow-orange-500/20 hover:scale-105 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">picture_as_pdf</span> Gerar Proposta PDF
            </button>
        </div>
    </div>

    <div class="flex-1 flex overflow-hidden">
        <!-- Sidebar: Templates -->
        <div class="w-80 bg-black/20 border-r border-white/5 overflow-y-auto p-6 space-y-8 no-scrollbar">
            <div>
                <label class="text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] mb-6 block">Selecione o Estilo</label>
                
                <!-- Category: Residencial -->
                <div class="space-y-4 mb-8">
                    <div class="flex items-center gap-2 px-2">
                        <span class="material-symbols-outlined text-orange-500 text-sm">home</span>
                        <span class="text-[10px] font-black text-white uppercase tracking-widest">Residencial</span>
                    </div>
                    <div class="grid grid-cols-1 gap-3">
                        {{#each (list 1 2 3 4 5)}}
                        <button class="template-card group relative aspect-[16/10] rounded-2xl overflow-hidden border-2 border-transparent hover:border-orange-500/50 transition-all active-template btn-set-template" data-template-id="residencial-{{this}}" data-image="/images/templates/residencial.png">
                            <img src="/images/templates/residencial.png" class="w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-all group-hover:scale-110">
                            <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent"></div>
                            <span class="absolute bottom-3 left-4 text-[8px] font-black text-white uppercase tracking-widest">Alpha {{this}}</span>
                        </button>
                        {{/each}}
                    </div>
                </div>

                <!-- Category: Interiores -->
                <div class="space-y-4 mb-8">
                    <div class="flex items-center gap-2 px-2">
                        <span class="material-symbols-outlined text-emerald-500 text-sm">chair</span>
                        <span class="text-[10px] font-black text-white uppercase tracking-widest">Interiores</span>
                    </div>
                    <div class="grid grid-cols-1 gap-3">
                        {{#each (list 1 2 3 4 5)}}
                        <button class="template-card group relative aspect-[16/10] rounded-2xl overflow-hidden border-2 border-transparent hover:border-orange-500/50 transition-all btn-set-template" data-template-id="interiores-{{this}}" data-image="/images/templates/interiores.png">
                            <img src="/images/templates/interiores.png" class="w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-all group-hover:scale-110">
                            <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent"></div>
                            <span class="absolute bottom-3 left-4 text-[8px] font-black text-white uppercase tracking-widest">Minimal {{this}}</span>
                        </button>
                        {{/each}}
                    </div>
                </div>

                <!-- Category: Empreendimentos -->
                <div class="space-y-4">
                    <div class="flex items-center gap-2 px-2">
                        <span class="material-symbols-outlined text-blue-500 text-sm">apartment</span>
                        <span class="text-[10px] font-black text-white uppercase tracking-widest">Corporativo</span>
                    </div>
                    <div class="grid grid-cols-1 gap-3">
                        {{#each (list 1 2 3 4 5)}}
                        <button class="template-card group relative aspect-[16/10] rounded-2xl overflow-hidden border-2 border-transparent hover:border-orange-500/50 transition-all btn-set-template" data-template-id="commercial-{{this}}" data-image="/images/templates/commercial.png">
                            <img src="/images/templates/commercial.png" class="w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-all group-hover:scale-110">
                            <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent"></div>
                            <span class="absolute bottom-3 left-4 text-[8px] font-black text-white uppercase tracking-widest">Tower {{this}}</span>
                        </button>
                        {{/each}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Workspace -->
        <div class="flex-1 flex overflow-hidden">
            <!-- Left: Form -->
            <div class="w-1/2 overflow-y-auto p-12 space-y-12 no-scrollbar bg-black/40">
                <!-- Section 1: Cliente -->
                <div class="space-y-8 animate-in fade-in slide-in-from-left duration-500">
                    <div class="flex items-center gap-3">
                        <span class="text-orange-500 font-black text-sm">01.</span>
                        <h2 class="text-white font-black text-[10px] uppercase tracking-[0.3em]">Identificação do Projeto</h2>
                    </div>
                    <div class="grid grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Nome do Cliente</label>
                            <input type="text" id="clientName" class="input-premium h-14 preview-trigger" placeholder="Ex: João Silva">
                        </div>
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Empresa / Escritório</label>
                            <input type="text" id="clientCompany" class="input-premium h-14 preview-trigger" placeholder="Studio Arquitetura">
                        </div>
                    </div>
                    <div class="grid grid-cols-3 gap-6">
                        <div class="space-y-2 col-span-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">E-mail</label>
                            <input type="email" id="clientEmail" class="input-premium h-14 preview-trigger" placeholder="contato@cliente.com">
                        </div>
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Validade</label>
                            <input type="date" id="validity" class="input-premium h-14 preview-trigger">
                        </div>
                    </div>
                </div>

                <!-- Section 2: Escopo -->
                <div class="space-y-8 animate-in fade-in slide-in-from-left duration-500 delay-100">
                    <div class="flex items-center gap-3">
                        <span class="text-orange-500 font-black text-sm">02.</span>
                        <h2 class="text-white font-black text-[10px] uppercase tracking-[0.3em]">Definição de Escopo</h2>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Formato de Entrada</label>
                        <select id="inputFormat" class="input-premium h-14 preview-trigger">
                            <option value="Modelo 3D enviado pelo cliente">Modelo 3D enviado pelo cliente</option>
                            <option value="Necessita Modelagem do Zero">Necessita Modelagem do Zero</option>
                            <option value="Arquivo BIM (Revit/Archicad)">Arquivo BIM (Revit/Archicad)</option>
                            <option value="DWG / Sketch 2D">DWG / Sketch 2D</option>
                        </select>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Descrição Detalhada</label>
                        <div id="projectDescEditor" class="bg-white/[0.03] border border-white/10 rounded-xl text-white text-xs min-h-[150px]"></div>
                        <input type="hidden" id="projectDesc">
                    </div>
                </div>

                <!-- Section 3: Entregáveis -->
                <div class="space-y-8 animate-in fade-in slide-in-from-left duration-500 delay-200">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center gap-3">
                            <span class="text-orange-500 font-black text-sm">03.</span>
                            <h2 class="text-white font-black text-[10px] uppercase tracking-[0.3em]">Tabela de Entregáveis</h2>
                        </div>
                        <button id="btn-add-item" class="px-4 py-2 rounded-lg bg-orange-500/10 text-orange-500 text-[9px] font-black uppercase tracking-widest border border-orange-500/20 hover:bg-orange-500 hover:text-white transition-all">+ Add Item</button>
                    </div>
                    
                    <div id="itemsContainer" class="space-y-4">
                        <!-- Items will be injected here -->
                    </div>
                </div>

                <!-- Section 4: Prazos & Pagamento -->
                <div class="space-y-8 animate-in fade-in slide-in-from-left duration-500 delay-300">
                    <div class="flex items-center gap-3">
                        <span class="text-orange-500 font-black text-sm">04.</span>
                        <h2 class="text-white font-black text-[10px] uppercase tracking-[0.3em]">Condições Comerciais</h2>
                    </div>
                    <div class="grid grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Prazo de Entrega (Dias)</label>
                            <input type="number" id="deliveryDays" class="input-premium h-14 preview-trigger" value="15">
                        </div>
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Ciclos de Revisão</label>
                            <input type="number" id="revisionCycles" class="input-premium h-14 preview-trigger" value="2">
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Forma de Pagamento</label>
                        <input type="text" id="paymentTerms" class="input-premium h-14 preview-trigger" value="50% Entrada + 50% Entrega Final">
                    </div>
                </div>
            </div>

            <!-- Right: Live Preview -->
            <div class="flex-1 bg-white/[0.02] p-12 overflow-y-auto scrollbar-premium flex justify-center">
                <div id="previewDocument" class="w-full max-w-[800px] bg-white rounded-none shadow-2xl origin-top transition-all duration-700 min-h-[1131px] text-black p-16 font-sans relative overflow-hidden">
                    <!-- Overlay Style for Templates -->
                    <div id="templateStyle" class="absolute inset-0 pointer-events-none opacity-5 mix-blend-overlay"></div>
                    
                    <!-- Branding Header -->
                    <div class="flex justify-between items-start mb-20 relative z-10 border-b-2 border-black pb-12">
                        <div id="studioBranding">
                            <div class="h-12 flex items-center mb-4">
                                <img src="/images/logo.png" id="previewLogo" class="h-full object-contain filter grayscale" onerror="this.src='https://placehold.co/200x50?text=ZANOELLO+3D'">
                            </div>
                            <p class="text-[10px] font-black uppercase tracking-[0.2em] mb-1">Zanoello 3D Artist</p>
                            <p class="text-[9px] text-gray-500 font-medium">www.zanoello3d.com • (11) 99999-9999</p>
                        </div>
                        <div class="text-right">
                            <h3 class="text-2xl font-black uppercase tracking-tighter mb-2">PROPOSTA <span class="text-orange-500">COMERCIAL</span></h3>
                            <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Ref: <span id="prevRef">#{{now 'YYYYMMDD'}}-001</span></p>
                        </div>
                    </div>

                    <!-- Hero Template Image -->
                    <div class="mb-16 relative aspect-[21/9] rounded-sm overflow-hidden bg-gray-100 shadow-lg">
                        <img id="templateCover" src="/images/templates/residencial.png" class="w-full h-full object-cover">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                    </div>

                    <!-- Client Info Box -->
                    <div class="grid grid-cols-2 gap-20 mb-16 relative z-10">
                        <div>
                            <p class="text-[8px] font-black text-orange-500 uppercase tracking-[0.3em] mb-4">PARA:</p>
                            <h4 id="prevClientName" class="text-xl font-black uppercase tracking-tight mb-1">Nome do Cliente</h4>
                            <p id="prevClientCompany" class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-2">Empresa do Cliente</p>
                            <p id="prevClientEmail" class="text-[10px] font-medium lowercase">email@cliente.com</p>
                        </div>
                        <div class="flex flex-col justify-end text-right">
                            <p class="text-[9px] font-black uppercase mb-1">Data: <span class="font-medium text-gray-500">{{now 'DD/MM/YYYY'}}</span></p>
                            <p class="text-[9px] font-black uppercase">Válido até: <span id="prevValidity" class="font-medium text-gray-500">---</span></p>
                        </div>
                    </div>

                    <!-- Scope Section -->
                    <div class="mb-16 relative z-10 bg-gray-50 p-10 rounded-sm border-l-4 border-black">
                        <p class="text-[8px] font-black text-gray-400 uppercase tracking-[0.3em] mb-4">OBJETIVO & ESCOPO</p>
                        <h5 id="prevInputFormat" class="text-sm font-black uppercase mb-4">Modelo 3D enviado pelo cliente</h5>
                        <p id="prevProjectDesc" class="text-[11px] text-gray-700 leading-relaxed italic">Descreva aqui os detalhes do projeto que serão refletidos no orçamento final.</p>
                    </div>

                    <!-- Deliverables Table -->
                    <div class="mb-16 relative z-10">
                        <table class="w-full border-collapse">
                            <thead>
                                <tr class="border-b-2 border-black">
                                    <th class="py-4 text-left text-[9px] font-black uppercase tracking-widest">Descrição do Item</th>
                                    <th class="py-4 text-center text-[9px] font-black uppercase tracking-widest w-20">Qtd</th>
                                    <th class="py-4 text-right text-[9px] font-black uppercase tracking-widest w-32">Unitário</th>
                                    <th class="py-4 text-right text-[9px] font-black uppercase tracking-widest w-32">Total</th>
                                </tr>
                            </thead>
                            <tbody id="prevTableBody">
                                <!-- Dynamic rows -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Commercial Terms -->
                    <div class="grid grid-cols-2 gap-20 mb-20 relative z-10 pt-10 border-t border-gray-100">
                        <div class="space-y-6">
                            <div>
                                <p class="text-[8px] font-black text-gray-400 uppercase tracking-[0.3em] mb-3">CRONOGRAMA & REVISÕES</p>
                                <div class="flex items-center gap-4">
                                    <div class="text-center bg-gray-50 px-4 py-2">
                                        <p id="prevDays" class="text-lg font-black leading-none">15</p>
                                        <p class="text-[7px] font-bold uppercase">Dias Úteis</p>
                                    </div>
                                    <div class="text-center bg-gray-50 px-4 py-2">
                                        <p id="prevRevisions" class="text-lg font-black leading-none">02</p>
                                        <p class="text-[7px] font-bold uppercase">Rodadas</p>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <p class="text-[8px] font-black text-gray-400 uppercase tracking-[0.3em] mb-3">PAGAMENTO</p>
                                <p id="prevTerms" class="text-[10px] font-black uppercase tracking-tight">50% Entrada + 50% Entrega Final</p>
                            </div>
                        </div>
                        <div class="flex flex-col justify-end text-right bg-black p-8 text-white rounded-sm">
                            <p class="text-[8px] font-black text-gray-400 uppercase tracking-[0.3em] mb-2">VALOR TOTAL DO INVESTIMENTO</p>
                            <p class="text-4xl font-black tracking-tighter" id="prevGrandTotal">R$ 0,00</p>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="absolute bottom-16 left-16 right-16 flex justify-between items-center text-[8px] font-black text-gray-300 uppercase tracking-[0.4em]">
                        <span>Zanoello 3D Artist © 2026</span>
                        <span>ArchViz Proposal Systems</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .input-premium {
        @apply w-full bg-white/[0.03] border border-white/10 rounded-xl px-5 text-white font-medium focus:border-orange-500/50 focus:bg-white/[0.05] transition-all outline-none text-xs;
    }
    .active-template {
        @apply border-orange-500 shadow-2xl shadow-orange-500/20 opacity-100 ring-4 ring-orange-500/10;
    }
    .scrollbar-premium::-webkit-scrollbar { width: 4px; }
    .scrollbar-premium::-webkit-scrollbar-track { background: transparent; }
    .scrollbar-premium::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    .scrollbar-premium::-webkit-scrollbar-thumb:hover { background: rgba(249,115,22,0.4); }

    /* Templates Stylings */
    .theme-residencial { font-family: 'Inter', sans-serif; }
    .theme-interiores { font-family: 'Outfit', sans-serif; }
    .theme-commercial { font-family: 'Roboto', sans-serif; }
</style>

<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<script>
document.addEventListener('DOMContentLoaded', function() {
    let items = [
        { type: 'Imagem Estática (Fotorrealista)', qty: 1, unit: 1500 }
    ];

    // === QUILL INIT ===
    const quill = new Quill('#projectDescEditor', {
        theme: 'snow',
        placeholder: 'Descreva os detalhes técnicos, atmosfera desejada e referências...',
        modules: {
            toolbar: [
                ['bold', 'italic', 'underline'],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                ['clean']
            ]
        }
    });

    quill.on('text-change', function() {
        document.getElementById('projectDesc').value = quill.root.innerHTML;
        updatePreview();
    });

    // === FUNCTIONS ===
    function updatePreview() {
        document.getElementById('prevClientName').innerText = document.getElementById('clientName').value || 'Nome do Cliente';
        document.getElementById('prevClientCompany').innerText = document.getElementById('clientCompany').value || 'Empresa do Cliente';
        document.getElementById('prevClientEmail').innerText = document.getElementById('clientEmail').value || 'email@cliente.com';
        document.getElementById('prevValidity').innerText = document.getElementById('validity').value || '---';
        document.getElementById('prevInputFormat').innerText = document.getElementById('inputFormat').value;
        document.getElementById('prevProjectDesc').innerHTML = document.getElementById('projectDesc').value || 'Descreva aqui os detalhes do projeto...';
        document.getElementById('prevDays').innerText = document.getElementById('deliveryDays').value;
        document.getElementById('prevRevisions').innerText = document.getElementById('revisionCycles').value;
        document.getElementById('prevTerms').innerText = document.getElementById('paymentTerms').value;

        let tableBody = '';
        let grandTotal = 0;
        items.forEach((item) => {
            const total = item.qty * item.unit;
            grandTotal += total;
            tableBody += `
                <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                    <td class="py-4 text-[11px] font-black uppercase text-gray-800">${item.type}</td>
                    <td class="py-4 text-center text-[11px] font-bold text-gray-500">${item.qty}</td>
                    <td class="py-4 text-right text-[11px] font-bold text-gray-500">R$ ${item.unit.toLocaleString('pt-BR', {minimumFractionDigits: 2})}</td>
                    <td class="py-4 text-right text-[11px] font-black text-black">R$ ${total.toLocaleString('pt-BR', {minimumFractionDigits: 2})}</td>
                </tr>
            `;
        });
        document.getElementById('prevTableBody').innerHTML = tableBody;
        document.getElementById('prevGrandTotal').innerText = `R$ ${grandTotal.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
    }

    function renderFormItems() {
        let html = '';
        items.forEach((item, index) => {
            html += `
                <div class="grid grid-cols-12 gap-3 p-4 rounded-2xl bg-white/5 border border-white/5 group relative animate-in zoom-in duration-300">
                    <div class="col-span-5 space-y-2">
                        <label class="text-[7px] font-black text-gray-500 uppercase tracking-widest px-1">Tipo de Serviço</label>
                        <input type="text" value="${item.type}" data-index="${index}" data-field="type" class="input-premium h-10 item-input">
                    </div>
                    <div class="col-span-2 space-y-2">
                        <label class="text-[7px] font-black text-gray-500 uppercase tracking-widest px-1">Qtd</label>
                        <input type="number" value="${item.qty}" data-index="${index}" data-field="qty" class="input-premium h-10 text-center item-input">
                    </div>
                    <div class="col-span-4 space-y-2">
                        <label class="text-[7px] font-black text-gray-500 uppercase tracking-widest px-1">Vlr Unitário</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[9px] text-gray-500 font-bold">R$</span>
                            <input type="number" value="${item.unit}" data-index="${index}" data-field="unit" class="input-premium h-10 pl-8 item-input">
                        </div>
                    </div>
                    <div class="col-span-1 flex items-end pb-1">
                        <button type="button" data-index="${index}" class="w-8 h-8 rounded-lg bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white transition-all btn-remove-item">
                            <span class="material-symbols-outlined text-sm">delete</span>
                        </button>
                    </div>
                </div>
            `;
        });
        document.getElementById('itemsContainer').innerHTML = html;
        updatePreview();
    }

    // === EVENT LISTENERS ===
    document.addEventListener('input', function(e) {
        if (e.target.classList.contains('preview-trigger')) {
            updatePreview();
        }
        if (e.target.classList.contains('item-input')) {
            const index = e.target.dataset.index;
            const field = e.target.dataset.field;
            const value = e.target.value;
            items[index][field] = field === 'type' ? value : parseFloat(value) || 0;
            updatePreview();
        }
    });

    document.addEventListener('change', function(e) {
        if (e.target.classList.contains('preview-trigger')) {
            updatePreview();
        }
    });

    document.addEventListener('click', function(e) {
        // Copy link
        if (e.target.closest('#btn-copy-link')) {
            alert('Link público gerado: https://zanoello3d.com/p/proposal-882193');
        }

        // Export PDF
        if (e.target.closest('#btn-export-pdf')) {
            window.print();
        }

        // Add Item
        if (e.target.closest('#btn-add-item')) {
            items.push({ type: 'Novo Entregável', qty: 1, unit: 1000 });
            renderFormItems();
        }

        // Remove Item
        const removeBtn = e.target.closest('.btn-remove-item');
        if (removeBtn) {
            const index = removeBtn.dataset.index;
            items.splice(index, 1);
            renderFormItems();
        }

        // Set Template
        const templateBtn = e.target.closest('.btn-set-template');
        if (templateBtn) {
            const { templateId, image } = templateBtn.dataset;
            document.querySelectorAll('.template-card').forEach(c => c.classList.remove('active-template', 'border-orange-500'));
            templateBtn.classList.add('active-template', 'border-orange-500');
            
            const previewDoc = document.getElementById('previewDocument');
            const cover = document.getElementById('templateCover');
            previewDoc.classList.add('opacity-0', 'scale-95', 'blur-sm');
            
            setTimeout(() => {
                cover.src = image;
                previewDoc.style.fontFamily = "'Plus Jakarta Sans', sans-serif";
                previewDoc.style.color = '#000';
                
                const totalContainer = document.getElementById('prevGrandTotal').parentElement;
                if (templateId.includes('residencial')) {
                    totalContainer.style.backgroundColor = '#f97316';
                } else if (templateId.includes('interiores')) {
                    previewDoc.style.fontFamily = "'Outfit', sans-serif";
                    totalContainer.style.backgroundColor = '#10b981';
                } else if (templateId.includes('commercial')) {
                    previewDoc.style.fontFamily = "'Roboto', sans-serif";
                    totalContainer.style.backgroundColor = '#3b82f6';
                }
                previewDoc.classList.remove('opacity-0', 'scale-95', 'blur-sm');
            }, 400);
        }
    });

    // === INITIALIZATION ===
    renderFormItems();
});
</script>
