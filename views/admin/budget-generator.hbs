 <!-- Commercial Terms -->
 <div class="bg-gray-50 p-6 border-t-4 border-black space-y-4">
 <p class="text-[8px] font-black text-orange-500 uppercase tracking-[0.3em] mb-4">CRONOGRAMA & PAGAMENTO</p>
 
 <div class="flex justify-between items-center border-b border-gray-200 pb-3">
 <span class="text-[8px] font-bold text-gray-500 uppercase">Prazo (Úteis)</span>
 <span class="text-xs font-black" id="prevDays">15</span>
 </div>
 <div class="flex justify-between items-center border-b border-gray-200 pb-3">
 <span class="text-[8px] font-bold text-gray-500 uppercase">Revisões</span>
 <span class="text-xs font-black" id="prevRevisions">02</span>
 </div>
 <div class="pt-2">
 <span class="text-[8px] font-bold text-gray-500 uppercase block mb-1">Pagamento</span>
 <span id="prevTerms" class="text-[9px] font-black uppercase">50% Entrada + 50% Entrega Final</span>
 </div>
 </div>
 </div>
 </div>

 <!-- Total Section -->
 <div id="prevGrandTotalContainer" class="flex justify-between items-center bg-black text-white p-8 mb-16 relative z-10 rounded-sm shadow-2xl transition-colors duration-500">
 <div>
 <p class="text-[8px] font-black text-white/50 uppercase tracking-[0.3em] mb-1">VALOR TOTAL DO INVESTIMENTO</p>
 <p class="text-[9px] text-white/40 uppercase">Valores em Reais (BRL)</p>
 </div>
 <div class="text-right">
 <p class="text-4xl font-black tracking-tighter text-white" id="prevGrandTotal">R$ 0,00</p>
 </div>
 </div>

 <!-- Portfolio Gallery Section -->
 <div class="mb-20 relative z-10" id="previewPortfolioSection" style="display: none;">
 <div class="flex items-center gap-4 mb-8">
 <h3 class="text-xl font-black uppercase tracking-tighter">Galeria de <span class="text-orange-500">Referências</span></h3>
 <div class="flex-1 h-[2px] bg-gray-100"></div>
 </div>
 <div id="prevPortfolioGrid" class="grid grid-cols-2 gap-6">
 <!-- Portfolio images rendered here -->
 </div>
 </div>

 <!-- Footer -->
 <div class="absolute bottom-16 left-16 right-16 flex justify-between items-center text-[8px] font-black text-gray-300 uppercase tracking-[0.4em]">
 <span>Malha 3D © 2026</span>
 <span>ArchViz Proposal Systems</span>
 </div>
 </div>
 </div>
 </div>
 </div>
</div>

<style>
 .input-premium {
 @apply w-full bg-white/[0.03] border border-white/10 rounded-xl px-5 text-white font-medium focus:border-orange-500/50 focus:bg-white/[0.05] transition-all outline-none text-xs;
 }
 .active-template {
 @apply border-orange-500 shadow-2xl shadow-orange-500/20 opacity-100 ring-4 ring-orange-500/10;
 }
 .scrollbar-premium::-webkit-scrollbar { width: 4px; }
 .scrollbar-premium::-webkit-scrollbar-track { background: transparent; }
 .scrollbar-premium::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
 .scrollbar-premium::-webkit-scrollbar-thumb:hover { background: rgba(249,115,22,0.4); }

 /* Templates Stylings */
 .theme-residencial { font-family: 'Inter', sans-serif; }
 .theme-interiores { font-family: 'Outfit', sans-serif; }
 .theme-commercial { font-family: 'Roboto', sans-serif; }
</style>

<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<script>
document.addEventListener('DOMContentLoaded', function() {
 let items = [
 { type: 'Imagem Estática (Fotorrealista)', qty: 1, unit: 1500 }
 ];
 let portfolioUrls = [];

 // === QUILL INIT ===
 const quill = new Quill('#projectDescEditor', {
 theme: 'snow',
 placeholder: 'Descreva os detalhes técnicos, atmosfera desejada e referências...',
 modules: {
 toolbar: [
 ['bold', 'italic', 'underline'],
 [{ 'list': 'ordered'}, { 'list': 'bullet' }],
 ['clean']
 ]
 }
 });

 quill.on('text-change', function() {
 document.getElementById('projectDesc').value = quill.root.innerHTML;
 updatePreview();
 });

 // === FUNCTIONS ===
 function updatePreview() {
 document.getElementById('prevClientName').innerText = document.getElementById('clientName').value || 'Nome do Cliente';
 document.getElementById('prevClientCompany').innerText = document.getElementById('clientCompany').value || 'Empresa do Cliente';
 document.getElementById('prevClientEmail').innerText = document.getElementById('clientEmail').value || 'email@cliente.com';
 document.getElementById('prevValidity').innerText = document.getElementById('validity').value || '---';
 document.getElementById('prevInputFormat').innerText = document.getElementById('inputFormat').value;
 document.getElementById('prevTechLOD').innerText = document.getElementById('techLOD').value;
 document.getElementById('prevProjectDesc').innerHTML = document.getElementById('projectDesc').value || 'Descreva aqui os detalhes do projeto...';
 document.getElementById('prevDays').innerText = document.getElementById('deliveryDays').value;
 document.getElementById('prevRevisions').innerText = document.getElementById('revisionCycles').value;
 document.getElementById('prevTerms').innerText = document.getElementById('paymentTerms').value;

 // Tech Specs Grid
 const techFields = [
 { label: 'Modelagem', id: 'techModeling' },
 { label: 'Iluminação', id: 'techLighting' },
 { label: 'Formato', id: 'techFormat' },
 { label: 'Resolução', id: 'techResolution' },
 { label: 'Humanização', id: 'techHumanization' },
 { label: 'Vegetação', id: 'techLandscape' },
 { label: 'Pós-Prod', id: 'techPostProd' },
 { label: 'Mobiliário', id: 'techFurniture' },
 { label: 'Contexto', id: 'techContext' },
 { label: 'Materiais', id: 'techMaterials' },
 { label: 'Suporte', id: 'techSupport' },
 { label: 'IA Tools', id: 'techAI' },
 { label: 'Áudio', id: 'techAudio' },
 { label: 'Duração', id: 'techDuration' }
 ];

 let techGridHtml = '';
 techFields.forEach(field => {
 const val = document.getElementById(field.id).value;
 if (val && val !== 'Nenhum' && val !== 'Não Utilizado') {
 techGridHtml += `
 <div>
 <p class="text-[6px] text-gray-400 font-bold uppercase mb-0.5">${field.label}</p>
 <p class="text-[8px] font-black uppercase text-black truncate">${val}</p>
 </div>
 `;
 }
 });
 document.getElementById('prevTechSpecsGrid').innerHTML = techGridHtml;

 let tableBody = '';
 let grandTotal = 0;
 items.forEach((item) => {
 const total = item.qty * item.unit;
 grandTotal += total;
 tableBody += `
 <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
 <td class="py-3 px-4 text-[10px] font-black uppercase text-gray-800">${item.type}</td>
 <td class="py-3 px-4 text-center text-[10px] font-bold text-gray-500">${item.qty}</td>
 <td class="py-3 px-4 text-right text-[10px] font-bold text-gray-500">R$ ${item.unit.toLocaleString('pt-BR', {minimumFractionDigits: 2})}</td>
 <td class="py-3 px-4 text-right text-[10px] font-black text-black">R$ ${total.toLocaleString('pt-BR', {minimumFractionDigits: 2})}</td>
 </tr>
 `;
 });
 document.getElementById('prevTableBody').innerHTML = tableBody;
 document.getElementById('prevGrandTotal').innerText = `R$ ${grandTotal.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;

 // Update Portfolio Preview
 const portfolioSection = document.getElementById('previewPortfolioSection');
 const portfolioGrid = document.getElementById('prevPortfolioGrid');
 const validUrls = portfolioUrls.filter(url => url && url.trim() !== '');
 if (validUrls.length > 0) {
 portfolioSection.style.display = 'block';
 portfolioGrid.innerHTML = validUrls.map(url => `
 <div class="aspect-[4/3] rounded-sm overflow-hidden shadow-md bg-gray-100 group relative border border-gray-200">
 <img src="${url}" class="w-full h-full object-cover transition-transform duration-700 group-" onerror="this.src='https://placehold.co/600x400?text=Invalid+Image'">
 <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
 </div>
 `).join('');
 } else {
 portfolioSection.style.display = 'none';
 portfolioGrid.innerHTML = '';
 }
 }

 function renderFormItems() {
 let html = '';
 items.forEach((item, index) => {
 html += `
 <div class="grid grid-cols-12 gap-3 p-4 rounded-2xl bg-white/5 border border-white/5 group relative animate-in zoom-in duration-300">
 <div class="col-span-5 space-y-2">
 <label class="text-[7px] font-black text-gray-500 uppercase tracking-widest px-1">Tipo de Serviço</label>
 <input type="text" value="${item.type}" data-index="${index}" data-field="type" class="input-premium h-10 item-input">
 </div>
 <div class="col-span-2 space-y-2">
 <label class="text-[7px] font-black text-gray-500 uppercase tracking-widest px-1">Qtd</label>
 <input type="number" value="${item.qty}" data-index="${index}" data-field="qty" class="input-premium h-10 text-center item-input">
 </div>
 <div class="col-span-4 space-y-2">
 <label class="text-[7px] font-black text-gray-500 uppercase tracking-widest px-1">Vlr Unitário</label>
 <div class="relative">
 <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[9px] text-gray-500 font-bold">R$</span>
 <input type="number" value="${item.unit}" data-index="${index}" data-field="unit" class="input-premium h-10 pl-8 item-input">
 </div>
 </div>
 <div class="col-span-1 flex items-end pb-1">
 <button type="button" data-index="${index}" class="w-8 h-8 rounded-lg bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white transition-all btn-remove-item">
 <span class="material-symbols-outlined text-sm">delete</span>
 </button>
 </div>
 </div>
 `;
 });
 document.getElementById('itemsContainer').innerHTML = html;
 updatePreview();
 }

 function renderPortfolioInputs() {
 let html = '';
 portfolioUrls.forEach((url, index) => {
 html += `
 <div class="flex gap-3 animate-in zoom-in duration-300">
 <input type="url" value="${url}" data-index="${index}" class="input-premium h-12 flex-1 portfolio-input" placeholder="https://exemplo.com/imagem.jpg">
 <button type="button" data-index="${index}" class="w-12 h-12 rounded-xl bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white transition-all btn-remove-portfolio flex items-center justify-center shadow-lg">
 <span class="material-symbols-outlined text-sm">delete</span>
 </button>
 </div>
 `;
 });
 document.getElementById('portfolioInputsContainer').innerHTML = html;
 updatePreview();
 }

 // === EVENT LISTENERS ===
 document.addEventListener('input', function(e) {
 if (e.target.classList.contains('preview-trigger')) {
 updatePreview();
 }
 if (e.target.classList.contains('item-input')) {
 const index = e.target.dataset.index;
 const field = e.target.dataset.field;
 const value = e.target.value;
 items[index][field] = field === 'type' ? value : parseFloat(value) || 0;
 updatePreview();
 }
 if (e.target.classList.contains('portfolio-input')) {
 const index = e.target.dataset.index;
 portfolioUrls[index] = e.target.value;
 updatePreview();
 }
 });

 document.addEventListener('change', function(e) {
 if (e.target.classList.contains('preview-trigger')) {
 updatePreview();
 }
 });

 document.addEventListener('click', function(e) {
 // Copy link
 if (e.target.closest('#btn-copy-link')) {
 alert('Link público gerado: https://malha3d.com/p/proposal-882193');
 }

 // Export PDF
 if (e.target.closest('#btn-export-pdf')) {
 window.print();
 }

 // Add Item
 if (e.target.closest('#btn-add-item')) {
 items.push({ type: 'Novo Entregável', qty: 1, unit: 1000 });
 renderFormItems();
 }

 // Remove Item
 const removeBtn = e.target.closest('.btn-remove-item');
 if (removeBtn) {
 const index = removeBtn.dataset.index;
 items.splice(index, 1);
 renderFormItems();
 }

 // Add Portfolio Image
 if (e.target.closest('#btn-add-portfolio')) {
 portfolioUrls.push('');
 renderPortfolioInputs();
 }

 // Remove Portfolio Image
 const removePortBtn = e.target.closest('.btn-remove-portfolio');
 if (removePortBtn) {
 const index = removePortBtn.dataset.index;
 portfolioUrls.splice(index, 1);
 renderPortfolioInputs();
 }

 // Set Template
 const templateBtn = e.target.closest('.btn-set-template');
 if (templateBtn) {
 const { templateId, image } = templateBtn.dataset;
 document.querySelectorAll('.template-card').forEach(c => c.classList.remove('active-template', 'border-orange-500'));
 templateBtn.classList.add('active-template', 'border-orange-500');
 
 const previewDoc = document.getElementById('previewDocument');
 const cover = document.getElementById('templateCover');
 previewDoc.classList.add('opacity-0', 'scale-95', 'blur-sm');
 
 setTimeout(() => {
 cover.src = image;
 previewDoc.style.fontFamily = "'Plus Jakarta Sans', sans-serif";
 previewDoc.style.color = '#000';
 
 const totalContainer = document.getElementById('prevGrandTotalContainer');
 const docRoot = document.getElementById('previewDocument');
 
 // Clear previous theme classes
 docRoot.classList.remove('bg-[#111111]', 'text-white', 'bg-white', 'text-black', 'bg-gray-900');
 
 if (templateId === 'dark-modern') {
 docRoot.classList.add('bg-[#111111]', 'text-white');
 docRoot.style.fontFamily = "'Inter', sans-serif";
 totalContainer.style.backgroundColor = '#f97316'; // orange-500
 } else if (templateId === 'light-minimal') {
 docRoot.classList.add('bg-white', 'text-black');
 docRoot.style.fontFamily = "'Outfit', sans-serif";
 totalContainer.style.backgroundColor = '#10b981'; // emerald-500
 } else if (templateId === 'neon-archviz') {
 docRoot.classList.add('bg-gray-900', 'text-white');
 docRoot.style.fontFamily = "'Roboto', sans-serif";
 totalContainer.style.backgroundColor = '#ec4899'; // pink-500
 }
 previewDoc.classList.remove('opacity-0', 'scale-95', 'blur-sm');
 }, 400);
 }
 });

 // === INITIALIZATION ===
 renderFormItems();
});
</script>

</div>