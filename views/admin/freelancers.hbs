<!-- Freelancers — Template Padrão (.kcard) -->
<div class="p-6 md:p-8 flex flex-col h-screen overflow-hidden gap-5" style="background:#0a0c10;">

 <!-- Banner Header (.kcard com imagem) -->
 <div class="kcard">
 <div class="kcard-img" style="height:80px;">
 <img src="/assets/c8355bfd-b4cf-4e82-a0a9-4899168c6eb8_3840w.webp" alt="Freeelancers ArchViz" class="w-full h-full object-cover">
 <div class="absolute inset-0 bg-gradient-to-t from-[#151515] via-[#151515]/70 to-transparent"></div>
 </div>
 <div class="kcard-body" style="padding:18px 20px;">
 <div class="flex items-center gap-1.5 flex-wrap mb-2">
 <span class="kcard-badge kcard-badge-orange">
 <span class="material-symbols-outlined text-[8px] align-middle mr-0.5">group</span> Banco de Talentos
 </span>
 <span class="kcard-badge">ArchViz</span>
 </div>
 <div class="flex items-center justify-between mt-2">
 <div>
 <h4 class="kcard-title" style="font-size:1.1rem; white-space:normal; margin-bottom:4px;">Time de Freelancers</h4>
 <p class="text-[9px] text-[#777] uppercase tracking-widest">Gestão de Talentos ArchViz & Colaboradores Externos</p>
 </div>
 <div class="flex items-center gap-3">
 <div class="px-3 py-1.5" style="background:#151515; border-radius:5px; border:1px solid rgba(255,255,255,0.06);">
 <span class="text-[8px] font-bold text-gray-400 uppercase tracking-widest">Ativos:&nbsp;</span>
 <span class="text-sm font-black ds-text">{{length freelancers}}</span>
 </div>
 <button class="flex items-center gap-1.5 px-4 py-2 rounded-md bg-orange-500 text-[8px] font-black uppercase tracking-wider text-white hover:bg-orange-600 transition-colors" data-bs-toggle="modal" data-bs-target="#newFreelancerModal">
 <span class="material-symbols-outlined text-[11px]">person_add</span> Novo Artista
 </button>
 </div>
 </div>
 </div>
 </div>

 <!-- Grid de Cards (kcard) -->
 <div class="flex-1 overflow-y-auto pb-6 custom-scrollbar">
 <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6 gap-3">
 {{#each freelancers}}
 <div class="kcard" data-status="{{status}}">
 <!-- Status indicator -->
 <div class="absolute top-3 right-3 flex items-center gap-1.5">
 <span class="w-1.5 h-1.5 rounded-full {{#if (eq status 'active')}}bg-emerald-500{{else if (eq status 'on_project')}}bg-amber-500{{else}}bg-gray-500{{/if}}"></span>
 <span class="text-[7px] font-black text-gray-400 uppercase tracking-widest">{{#if (eq status 'active')}}Ativo{{else if (eq status 'on_project')}}Em Projeto{{else}}Inativo{{/if}}</span>
 </div>

 <!-- Header do card -->
 <div class="kcard-body" style="padding:24px 14px 14px;">
 <div class="flex items-center gap-2.5 mb-3">
 <div class="w-9 h-9 rounded-md bg-orange-500/15 border border-orange-500/30 flex items-center justify-center text-[11px] font-black text-orange-400">
 {{firstLetter name}}
 </div>
 <div class="overflow-hidden flex-1 min-w-0">
 <h3 class="text-[10px] font-black text-white truncate uppercase tracking-tight">{{name}}</h3>
 <p class="text-[7px] text-gray-500 font-bold uppercase tracking-widest truncate">{{expertise}}</p>
 </div>
 </div>

 <!-- Stats grid -->
 <div class="grid grid-cols-2 gap-2 mb-3">
 <div class="p-2 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
 <p class="text-[7px] font-black text-gray-500 uppercase mb-0.5">Avaliação</p>
 <div class="flex text-orange-500 text-[9px]">{{{ratingStars rating}}}</div>
 </div>
 <div class="p-2 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
 <p class="text-[7px] font-black text-gray-500 uppercase mb-0.5">Valor/H</p>
 <p class="text-[9px] font-black text-emerald-400">{{formatCurrency hourlyRate}}</p>
 </div>
 </div>

 {{#if softwares}}
 <div class="mb-3">
 <p class="text-[7px] font-black text-gray-500 uppercase tracking-widest mb-1">Softwares</p>
 <p class="text-[8px] text-cyan-400 font-bold truncate">{{softwares}}</p>
 </div>
 {{/if}}

 <!-- Contato -->
 <div class="space-y-1 mb-3">
 <div class="flex items-center gap-1.5 text-gray-400">
 <span class="material-symbols-outlined text-[10px]">mail</span>
 <span class="text-[7px] font-bold truncate">{{email}}</span>
 </div>
 {{#if phone}}
 <div class="flex items-center gap-1.5 text-gray-400">
 <span class="material-symbols-outlined text-[10px]">call</span>
 <span class="text-[7px] font-bold">{{phone}}</span>
 </div>
 {{/if}}
 {{#if availability}}
 <div class="flex items-center gap-1.5">
 <span class="material-symbols-outlined text-[10px] {{#if (eq availability 'disponivel')}}text-emerald-400{{else if (eq availability 'ocupado')}}text-amber-400{{else}}text-gray-500{{/if}}">schedule</span>
 <span class="text-[7px] font-bold {{#if (eq availability 'disponivel')}}text-emerald-400{{else if (eq availability 'ocupado')}}text-amber-400{{else}}text-gray-500{{/if}}">{{#if (eq availability 'disponivel')}}Disponível{{else if (eq availability 'ocupado')}}Ocupado{{else}}Ausente{{/if}}</span>
 </div>
 {{/if}}
 </div>

 <!-- Ações -->
 <div class="flex gap-1.5">
 <button onclick="window.viewFreelancerProfile('{{id}}')" class="flex-1 py-1.5 rounded-md text-[7px] font-black uppercase tracking-widest text-white" style="background:rgba(249,115,22,0.15); border:1px solid rgba(249,115,22,0.3);">Perfil</button>
 <button onclick="window.editFreelancer('{{id}}')" class="w-6 h-6 rounded-md flex items-center justify-center" style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1);" title="Editar">
 <span class="material-symbols-outlined text-[10px] text-gray-400">edit</span>
 </button>
 <div class="dropup">
 <button class="w-6 h-6 rounded-md flex items-center justify-center" style="background:rgba(249,115,22,0.1); border:1px solid rgba(249,115,22,0.3);" data-bs-toggle="dropdown" aria-expanded="false">
 <span class="material-symbols-outlined text-[10px] text-orange-400">more_vert</span>
 </button>
 <ul class="dropdown-menu dropdown-menu-end border rounded-[5px] p-1.5" style="z-index:9999; background:#0a0c10; border:1px solid rgba(255,255,255,0.1); min-width:160px; position:absolute; bottom:100%; right:0;">
 <li><a class="dropdown-item rounded text-[8px] font-bold uppercase py-1.5 px-2 flex items-center gap-1.5" href="#" onclick="event.preventDefault(); window.viewFreelancerProfile('{{id}}')" style="color:#ffffff;"><span class="material-symbols-outlined text-[10px]">person</span> Ver Perfil</a></li>
 <li><a class="dropdown-item rounded text-[8px] font-bold uppercase py-1.5 px-2 flex items-center gap-1.5" href="#" onclick="event.preventDefault(); window.editFreelancer('{{id}}')" style="color:#ffffff;"><span class="material-symbols-outlined text-[10px]">edit</span> Editar</a></li>
 <li><a class="dropdown-item rounded text-[8px] font-bold uppercase py-1.5 px-2 flex items-center gap-1.5" href="#" onclick="event.preventDefault(); window.toggleHidden('{{id}}')" style="color:#ffffff;"><span class="material-symbols-outlined text-[10px]">visibility_off</span> Ocultar</a></li>
 <li><hr style="border-color:rgba(255,255,255,0.05); margin:4px 0;"></li>
 <li><a class="dropdown-item rounded text-[8px] font-bold uppercase py-1.5 px-2 flex items-center gap-1.5" href="#" onclick="event.preventDefault(); deleteFreelancer('{{id}}')" style="color:#f87171;"><span class="material-symbols-outlined text-[10px]">delete</span> Remover</a></li>
 </ul>
 </div>
 </div>
 </div>
 </div>
 {{else}}
 <div class="col-span-full py-20 text-center opacity-30">
 <span class="material-symbols-outlined text-6xl mb-4">person_search</span>
 <p class="text-xl font-black uppercase tracking-widest">Banco de Talentos Vazio</p>
 <p class="text-[10px] font-bold mt-2 uppercase tracking-widest">Adicione artistas externos para iniciar a escala.</p>
 </div>
 {{/each}}
 </div>
 </div>
</div>

<!-- Modal: Novo Freelancer (.kcard style) -->
<div class="modal fade" id="newFreelancerModal" tabindex="-1" aria-hidden="true">
 <div class="modal-dialog modal-lg modal-dialog-centered">
 <div class="modal-content" style="background:#151515; border-radius:5px; box-shadow:0 2px 8px rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.06);">
 <div class="flex justify-between items-center p-4" style="border-bottom:1px solid rgba(255,255,255,0.06);">
 <h3 class="text-sm font-black text-white uppercase tracking-tight">Novo <span class="text-orange-400">Artista Freelancer</span></h3>
 <button type="button" class="text-gray-500 hover:text-white" data-bs-dismiss="modal" style="background:transparent; border:none;"><span class="material-symbols-outlined">close</span></button>
 </div>
 <form action="/admin/freelancers" method="POST" class="p-4 grid grid-cols-2 gap-3">
 <div>
 <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1 block">Nome Completo</label>
 <input type="text" name="name" placeholder="Ex: Roberto Silva" required class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
 </div>
 <div>
 <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1 block">E-mail</label>
 <input type="email" name="email" placeholder="contato@artista.com" required class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
 </div>
 <div>
 <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1 block">WhatsApp</label>
 <input type="text" name="phone" placeholder="(11) 99999-9999" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
 </div>
 <div>
 <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1 block">Valor Hora (R$)</label>
 <input type="number" name="hourlyRate" placeholder="80.00" step="0.01" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
 </div>
 <div class="col-span-2">
 <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1.5 block">Especialidades</label>
 <div class="flex flex-wrap gap-1.5" id="expertiseToggles">
 <button type="button" class="px-2.5 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase" data-value="Modelagem" onclick="window.toggleExpertise(this)" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">Modelagem</button>
 <button type="button" class="px-2.5 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase" data-value="Renderização" onclick="window.toggleExpertise(this)" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">Renderização</button>
 <button type="button" class="px-2.5 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase" data-value="Animação" onclick="window.toggleExpertise(this)" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">Animação</button>
 <button type="button" class="px-2.5 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase" data-value="Pós-Produção" onclick="window.toggleExpertise(this)" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">Pós-Produção</button>
 <button type="button" class="px-2.5 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase" data-value="Texturização" onclick="window.toggleExpertise(this)" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">Texturização</button>
 <button type="button" class="px-2.5 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase" data-value="Iluminação" onclick="window.toggleExpertise(this)" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">Iluminação</button>
 </div>
 <input type="hidden" name="expertise" id="expertiseHidden" value="">
 </div>
 <div class="col-span-2">
 <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1.5 block">Softwares</label>
 <div class="flex flex-wrap gap-1.5" id="softwareToggles">
 <button type="button" class="px-2.5 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase" data-value="D5 Render" onclick="window.toggleSoftware(this)" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">D5 Render</button>
 <button type="button" class="px-2.5 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase" data-value="3ds Max" onclick="window.toggleSoftware(this)" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">3ds Max</button>
 <button type="button" class="px-2.5 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase" data-value="Revit" onclick="window.toggleSoftware(this)" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">Revit</button>
 <button type="button" class="px-2.5 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase" data-value="SketchUp" onclick="window.toggleSoftware(this)" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">SketchUp</button>
 <button type="button" class="px-2.5 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase" data-value="Blender" onclick="window.toggleSoftware(this)" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">Blender</button>
 <button type="button" class="px-2.5 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase" data-value="Corona" onclick="window.toggleSoftware(this)" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">Corona</button>
 <button type="button" class="px-2.5 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase" data-value="V-Ray" onclick="window.toggleSoftware(this)" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">V-Ray</button>
 <button type="button" class="px-2.5 py-1 rounded-[4px] text-[8px] font-bold text-gray-400 uppercase" data-value="Lumion" onclick="window.toggleSoftware(this)" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">Lumion</button>
 </div>
 <input type="hidden" name="softwares" id="softwaresHidden" value="">
 </div>
 <div class="col-span-2">
 <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1 block">Notas e Observações</label>
 <textarea name="notes" placeholder="Pontos fortes, disponibilidade, histórico..." class="w-full px-3 py-2 text-xs text-white rounded-[4px] resize-none" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); height:80px;"></textarea>
 </div>
 <div class="col-span-2 flex gap-2 pt-2">
 <button type="submit" class="flex-1 py-2.5 rounded-md bg-orange-500 text-white text-[8px] font-black uppercase tracking-wider hover:bg-orange-600 transition-colors">Salvar no Banco</button>
 <button type="button" class="px-4 py-2.5 rounded-md text-[8px] font-bold text-gray-400 hover:text-white" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" data-bs-dismiss="modal">Cancelar</button>
 </div>
 </form>
 </div>
 </div>
</div>

<script>
let _selectedExpertise = [];
let _selectedSoftwares = [];

window.toggleExpertise = function(btn) {
 const val = btn.dataset.value;
 if (_selectedExpertise.includes(val)) {
  _selectedExpertise = _selectedExpertise.filter(v => v !== val);
  btn.style.cssText = 'background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); color:#9ca3af;';
 } else {
  _selectedExpertise.push(val);
  btn.style.cssText = 'background:#f97316; border:1px solid #f97316; color:#ffffff;';
 }
 document.getElementById('expertiseHidden').value = _selectedExpertise.join(', ');
};

window.toggleSoftware = function(btn) {
 const val = btn.dataset.value;
 if (_selectedSoftwares.includes(val)) {
  _selectedSoftwares = _selectedSoftwares.filter(v => v !== val);
  btn.style.cssText = 'background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); color:#9ca3af;';
 } else {
  _selectedSoftwares.push(val);
  btn.style.cssText = 'background:#06b6d4; border:1px solid #06b6d4; color:#ffffff;';
 }
 document.getElementById('softwaresHidden').value = _selectedSoftwares.join(', ');
};

window.viewFreelancerProfile = function(id) {
 const existing = document.getElementById('freelancerProfileModal');
 if (existing) existing.remove();
 fetch('/admin/api/freelancers/' + id + '/profile')
  .then(r => r.json())
  .then(data => {
   if (!data.success) { alert('Erro ao carregar perfil'); return; }
   const f = data.freelancer;
   const modalHtml = `
    <div id="freelancerProfileModal" class="fixed inset-0 z-[200] flex items-center justify-center bg-black/80" style="display:flex;">
     <div class="flex flex-col max-h-[85vh] overflow-hidden mx-4" style="background:#151515; border-radius:5px; box-shadow:0 2px 8px rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.06); width:100%; max-width:600px;">
      <header class="p-4 flex items-center justify-between" style="border-bottom:1px solid rgba(255,255,255,0.06);">
       <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-[4px] flex items-center justify-center text-base font-black text-orange-400" style="background:rgba(249,115,22,0.15); border:1px solid rgba(249,115,22,0.3);">${(f.name||'?')[0]}</div>
        <div>
         <h3 class="text-sm font-black text-white">${f.name}</h3>
         <p class="text-[8px] font-bold text-gray-500 uppercase tracking-widest">${f.expertise || 'Sem especialidade'}</p>
        </div>
       </div>
       <button onclick="document.getElementById('freelancerProfileModal').remove()" class="w-7 h-7 rounded-[4px] flex items-center justify-center text-gray-400 hover:text-white" style="background:rgba(255,255,255,0.05);"><span class="material-symbols-outlined text-sm">close</span></button>
      </header>
      <div class="p-4 overflow-y-auto custom-scrollbar space-y-3 flex-1">
       <div class="grid grid-cols-2 gap-2">
        <div class="p-2.5 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
         <p class="text-[7px] font-black text-gray-500 uppercase">Email</p>
         <p class="text-[10px] text-white font-bold truncate">${f.email || '---'}</p>
        </div>
        <div class="p-2.5 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
         <p class="text-[7px] font-black text-gray-500 uppercase">Telefone</p>
         <p class="text-[10px] text-white font-bold">${f.phone || '---'}</p>
        </div>
        <div class="p-2.5 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
         <p class="text-[7px] font-black text-gray-500 uppercase">Valor/Hora</p>
         <p class="text-[10px] text-emerald-400 font-black">R$ ${parseFloat(f.hourlyRate || 0).toFixed(2)}</p>
        </div>
        <div class="p-2.5 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
         <p class="text-[7px] font-black text-gray-500 uppercase">Horas Mês</p>
         <p class="text-[10px] text-cyan-400 font-black">${parseFloat(f.monthlyHours || 0).toFixed(1)}h</p>
        </div>
       </div>
       <div class="p-2.5 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
        <p class="text-[7px] font-black text-gray-500 uppercase mb-1">Softwares</p>
        <p class="text-[10px] text-white">${f.softwares || f.expertise || '---'}</p>
       </div>
       <div class="p-2.5 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
        <p class="text-[7px] font-black text-gray-500 uppercase mb-1">Notas</p>
        <p class="text-[10px] text-gray-300">${f.notes || 'Sem observações'}</p>
       </div>
       <div class="flex gap-2">
        <button onclick="window.toggleWorking('${f.id}')" class="flex-1 py-2 rounded-[4px] text-[8px] font-black uppercase tracking-widest flex items-center justify-center gap-1 ${f.startTimestamp ? 'bg-red-500 text-white' : 'text-emerald-400'}" style="${f.startTimestamp ? '' : 'background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.3);'}">
         <span class="material-symbols-outlined text-[12px]">${f.startTimestamp ? 'stop' : 'play_arrow'}</span> ${f.startTimestamp ? 'Parar Tracking' : 'Iniciar Trabalho'}
        </button>
        <button onclick="window.toggleHidden('${f.id}')" class="px-4 py-2 rounded-[4px] text-gray-400 text-[8px] font-black uppercase tracking-widest" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
         ${f.isHidden ? 'Mostrar' : 'Ocultar'}
        </button>
       </div>
      </div>
     </div>
    </div>
   `;
   document.body.insertAdjacentHTML('beforeend', modalHtml);
  })
  .catch(err => alert('Erro ao carregar perfil'));
};

window.toggleWorking = async function(id) {
 const res = await fetch('/admin/api/freelancers/' + id + '/toggle-working', { method: 'POST' });
 const data = await res.json();
 if (data.success) {
  if (window.showToast) window.showToast(data.working ? 'Tracking iniciado!' : 'Tracking parado. +' + data.hoursAdded + 'h', 'success');
  document.getElementById('freelancerProfileModal')?.remove();
  window.viewFreelancerProfile(id);
 }
};

window.toggleHidden = async function(id) {
 const res = await fetch('/admin/api/freelancers/' + id + '/toggle-hidden', { method: 'POST' });
 const data = await res.json();
 if (data.success) {
  if (window.showToast) window.showToast(data.isHidden ? 'Freelancer ocultado' : 'Freelancer visível', 'info');
  setTimeout(() => window.location.reload(), 500);
 }
};

window.editFreelancer = async function(id) {
 const existing = document.getElementById('editFreelancerModal');
 if (existing) existing.remove();
 try {
  const [profRes, swRes] = await Promise.all([
   fetch('/admin/api/freelancers/' + id + '/profile').then(r => r.json()),
   fetch('/admin/api/softwares').then(r => r.json())
  ]);
  if (!profRes.success) { alert('Erro ao carregar'); return; }
  const f = profRes.freelancer;
  const allSoftwares = swRes.softwares || [];
  const selectedSoftwares = (f.softwares || '').split(',').map(s => s.trim()).filter(Boolean);

  const softwareBtns = allSoftwares.map(sw => {
   const isActive = selectedSoftwares.includes(sw);
   const style = isActive ? 'background:#06b6d4; border:1px solid #06b6d4; color:#ffffff;' : 'background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); color:#9ca3af;';
   return '<button type="button" class="ef-sw-btn px-2 py-1 rounded-[4px] text-[8px] font-bold uppercase" data-value="' + sw + '" onclick="window.toggleEditSoftware(this)" style="' + style + '">' + sw + '</button>';
  }).join('');

  const modalHtml = `
   <div id="editFreelancerModal" class="fixed inset-0 z-[200] flex items-center justify-center bg-black/80" style="display:flex;">
    <div class="flex flex-col max-h-[85vh] overflow-hidden mx-4" style="background:#151515; border-radius:5px; box-shadow:0 2px 8px rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.06); width:100%; max-width:500px;">
     <header class="p-3 flex items-center justify-between" style="border-bottom:1px solid rgba(255,255,255,0.06);">
      <h3 class="text-xs font-black text-white">Editar: ${f.name}</h3>
      <button onclick="document.getElementById('editFreelancerModal').remove()" class="w-7 h-7 rounded-[4px] flex items-center justify-center text-gray-400 hover:text-white" style="background:rgba(255,255,255,0.05);"><span class="material-symbols-outlined text-sm">close</span></button>
     </header>
     <div class="p-3 overflow-y-auto custom-scrollbar space-y-2 flex-1">
      <div class="grid grid-cols-2 gap-2">
       <div><label class="block text-[8px] text-gray-500 font-bold uppercase mb-1">Nome</label>
       <input type="text" id="ef_name" value="${f.name||''}" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);"></div>
       <div><label class="block text-[8px] text-gray-500 font-bold uppercase mb-1">Email</label>
       <input type="email" id="ef_email" value="${f.email||''}" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);"></div>
      </div>
      <div class="grid grid-cols-2 gap-2">
       <div><label class="block text-[8px] text-gray-500 font-bold uppercase mb-1">Telefone</label>
       <input type="text" id="ef_phone" value="${f.phone||''}" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);"></div>
       <div><label class="block text-[8px] text-gray-500 font-bold uppercase mb-1">Valor/Hora</label>
       <input type="number" step="0.01" id="ef_hourlyRate" value="${f.hourlyRate||0}" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);"></div>
      </div>
      <div><label class="block text-[8px] text-gray-500 font-bold uppercase mb-1">Especialidades</label>
      <input type="text" id="ef_expertise" value="${f.expertise||''}" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" placeholder="Ex: Interiores, Fachadas"></div>
      <div>
       <label class="block text-[8px] text-gray-500 font-bold uppercase mb-1">Softwares</label>
       <div class="flex flex-wrap gap-1" id="ef_softwareToggles">${softwareBtns}</div>
       <input type="hidden" id="ef_softwares" value="${f.softwares||''}">
      </div>
      <div><label class="block text-[8px] text-gray-500 font-bold uppercase mb-1">Hardware</label>
      <input type="text" id="ef_hardware" value="${f.hardwareSpecs||''}" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" placeholder="Ex: RTX 4090, 64GB RAM"></div>
      <div class="grid grid-cols-2 gap-2">
       <div><label class="block text-[8px] text-gray-500 font-bold uppercase mb-1">Portfólio URL</label>
       <input type="text" id="ef_portfolio" value="${f.portfolioUrl||''}" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);"></div>
       <div><label class="block text-[8px] text-gray-500 font-bold uppercase mb-1">Chave PIX</label>
       <input type="text" id="ef_pix" value="${f.pixKey||''}" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);"></div>
      </div>
      <div class="grid grid-cols-2 gap-2">
       <div><label class="block text-[8px] text-gray-500 font-bold uppercase mb-1">Status</label>
       <select id="ef_status" class="w-full px-3 py-2 text-xs text-white rounded-[4px] appearance-none" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
        <option value="active" ${f.status==='active'?'selected':''}>Ativo</option>
        <option value="inactive" ${f.status==='inactive'?'selected':''}>Inativo</option>
        <option value="on_project" ${f.status==='on_project'?'selected':''}>Em Projeto</option>
       </select></div>
       <div><label class="block text-[8px] text-gray-500 font-bold uppercase mb-1">Disponibilidade</label>
       <select id="ef_availability" class="w-full px-3 py-2 text-xs text-white rounded-[4px] appearance-none" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
        <option value="disponivel" ${f.availability==='disponivel'?'selected':''}>Disponível</option>
        <option value="ocupado" ${f.availability==='ocupado'?'selected':''}>Ocupado</option>
        <option value="ausente" ${f.availability==='ausente'?'selected':''}>Ausente</option>
       </select></div>
      </div>
      <div><label class="block text-[8px] text-gray-500 font-bold uppercase mb-1">Notas</label>
      <textarea id="ef_notes" rows="2" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">${f.notes||''}</textarea></div>
     </div>
     <footer class="p-3 flex gap-2" style="border-top:1px solid rgba(255,255,255,0.06);">
      <button onclick="document.getElementById('editFreelancerModal').remove()" class="flex-1 py-2 rounded-[4px] text-[8px] font-black uppercase tracking-widest text-white" style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1);">Cancelar</button>
      <button onclick="window.saveFreelancerEdit('${f.id}')" class="flex-[2] py-2 rounded-[4px] bg-orange-500 text-white text-[8px] font-black uppercase tracking-widest hover:bg-orange-600">Salvar</button>
     </footer>
    </div>
   </div>
  `;
  document.body.insertAdjacentHTML('beforeend', modalHtml);
 } catch (err) { alert('Erro ao carregar freelancer'); }
};

window.toggleEditSoftware = function(btn) {
 const val = btn.dataset.value;
 const isActive = btn.style.background.includes('06b6d4');
 if (isActive) {
  btn.style.cssText = 'background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); color:#9ca3af;';
 } else {
  btn.style.cssText = 'background:#06b6d4; border:1px solid #06b6d4; color:#ffffff;';
 }
 const allBtns = document.querySelectorAll('#ef_softwareToggles .ef-sw-btn');
 const selected = Array.from(allBtns).filter(b => b.style.background.includes('06b6d4')).map(b => b.dataset.value);
 document.getElementById('ef_softwares').value = selected.join(', ');
};

window.saveFreelancerEdit = async function(id) {
 const body = {
  name: document.getElementById('ef_name').value,
  email: document.getElementById('ef_email').value,
  phone: document.getElementById('ef_phone').value,
  hourlyRate: document.getElementById('ef_hourlyRate').value,
  expertise: document.getElementById('ef_expertise').value,
  softwares: document.getElementById('ef_softwares').value,
  hardwareSpecs: document.getElementById('ef_hardware').value,
  portfolioUrl: document.getElementById('ef_portfolio').value,
  pixKey: document.getElementById('ef_pix').value,
  status: document.getElementById('ef_status').value,
  availability: document.getElementById('ef_availability').value,
  notes: document.getElementById('ef_notes').value
 };
 try {
  const res = await fetch('/admin/api/freelancers/' + id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
  const data = await res.json();
  if (data.success) {
   document.getElementById('editFreelancerModal').remove();
   if (window.showToast) window.showToast('Freelancer atualizado!', 'success');
   setTimeout(() => window.location.reload(), 500);
  } else { alert('Erro: ' + (data.message || 'Falha')); }
 } catch (err) { alert('Erro de rede'); }
};

async function deleteFreelancer(id) {
 if (!confirm('Deseja remover este artista do banco de talentos?')) return;
 try {
  const res = await fetch(`/admin/api/freelancers/${id}`, { method: 'DELETE' });
  const json = await res.json();
  if (json.success) window.location.reload();
  else alert('Erro ao remover freelancer.');
 } catch (err) { alert('Erro de rede.'); }
}
</script>
