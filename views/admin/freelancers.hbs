<!-- Header -->
<div class="mb-10 p-8 glass-card border-none bg-gradient-to-br from-white/5 to-white/[0.02]">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h1 class="text-4xl font-black text-white tracking-tight mb-2">
                Rede de <span class="text-gradient">Freelancers</span>
            </h1>
            <p class="text-gray-400 font-medium">
                Gerencie seus parceiros estratégicos e especialistas sob demanda do ecossistema <span class="text-orange-500">Malha3D</span>.
            </p>
        </div>
        <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-8 rounded-2xl shadow-2xl shadow-orange-500/40 transition-all flex items-center gap-3">
            <span class="material-symbols-outlined">person_add</span>
            Convidar Talento
        </button>
    </div>
</div>

<!-- Filters -->
<div class="glass-card p-6 border-white/5 bg-white/[0.01] mb-10 flex flex-wrap gap-6 items-center">
    <div class="flex-1 min-w-[300px] relative group">
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-600 group-focus-within:text-orange-500 transition-colors">search</span>
        <input type="text" placeholder="Filtrar por nome ou habilidade mestre..." class="w-full pl-12 pr-6 py-3.5 bg-white/5 border border-white/10 rounded-2xl text-sm font-black text-white placeholder:text-gray-600 focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500/50 outline-none transition-all">
    </div>
    <select class="px-6 py-3.5 bg-white/5 border border-white/10 rounded-2xl text-xs font-black text-gray-500 uppercase tracking-widest outline-none focus:border-orange-500/50 transition-all cursor-pointer">
        <option>Todas Especialidades</option>
        <option>Modelagem</option>
        <option>Renderização</option>
        <option>Animação</option>
    </select>
    <select class="px-6 py-3.5 bg-white/5 border border-white/10 rounded-2xl text-xs font-black text-gray-500 uppercase tracking-widest outline-none focus:border-orange-500/50 transition-all cursor-pointer">
        <option>Status: Todos</option>
        <option>Disponível</option>
        <option>Em Projeto</option>
        <option>Indisponível</option>
    </select>
</div>

<!-- Freelancer List -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <!-- Freelancer Card 1 -->
    <div class="glass-card p-8 border-white/5 bg-white/[0.01] hover:bg-white/[0.02] hover:border-orange-500/30 transition-all group relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-orange-500/5 rounded-full blur-3xl -mr-16 -mt-16 group-hover:bg-orange-500/10 transition-all"></div>
        
        <div class="flex items-start justify-between mb-8 relative z-10">
            <div class="flex items-center gap-5">
                <div class="w-16 h-16 rounded-2xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-500 font-black text-2xl shadow-2xl">
                    RH
                </div>
                <div>
                    <h3 class="text-lg font-black text-white tracking-tight group-hover:text-orange-500 transition-colors">Ricardo H.</h3>
                    <div class="flex items-center gap-1.5 text-orange-500 mt-1">
                        <span class="material-symbols-outlined text-sm">star</span>
                        <span class="text-[10px] font-black uppercase tracking-widest">4.9 (24 jobs)</span>
                    </div>
                </div>
            </div>
            <span class="text-[9px] font-black text-emerald-500 bg-emerald-500/10 px-3 py-1.5 rounded-lg border border-emerald-500/20 uppercase tracking-[0.2em]">Disponível</span>
        </div>
        
        <div class="flex flex-wrap gap-2 mb-8 relative z-10">
            <span class="text-[9px] font-black text-gray-500 bg-white/5 px-3 py-1.5 rounded-lg border border-white/5 uppercase tracking-widest group-hover:border-white/10 transition-colors">Modelagem Orgânica</span>
            <span class="text-[9px] font-black text-gray-500 bg-white/5 px-3 py-1.5 rounded-lg border border-white/5 uppercase tracking-widest group-hover:border-white/10 transition-colors">ZBrush</span>
            <span class="text-[9px] font-black text-gray-500 bg-white/5 px-3 py-1.5 rounded-lg border border-white/5 uppercase tracking-widest group-hover:border-white/10 transition-colors">Retopologia</span>
        </div>

        <div class="pt-8 border-t border-white/5 flex items-center justify-between relative z-10">
            <div>
                <p class="text-[9px] font-black text-gray-600 uppercase tracking-[0.3em] mb-1">Valor Hora</p>
                <p class="text-xl font-black text-white">R$ <span class="text-gradient">85,00</span></p>
            </div>
            <button class="bg-white/5 hover:bg-orange-500 text-gray-400 hover:text-white w-12 h-12 rounded-2xl border border-white/10 hover:border-orange-500/50 transition-all flex items-center justify-center shadow-2xl">
                <span class="material-symbols-outlined text-xl">forum</span>
            </button>
        </div>
    </div>

    <!-- Freelancer Card 2 -->
    <div class="glass-card p-8 border-white/5 bg-white/[0.01] hover:bg-white/[0.02] hover:border-blue-500/30 transition-all group relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/5 rounded-full blur-3xl -mr-16 -mt-16 group-hover:bg-blue-500/10 transition-all"></div>
        
        <div class="flex items-start justify-between mb-8 relative z-10">
            <div class="flex items-center gap-5">
                <div class="w-16 h-16 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-500 font-black text-2xl shadow-2xl">
                    AM
                </div>
                <div>
                    <h3 class="text-lg font-black text-white tracking-tight group-hover:text-blue-500 transition-colors">Amanda M.</h3>
                    <div class="flex items-center gap-1.5 text-orange-500 mt-1">
                        <span class="material-symbols-outlined text-sm">star</span>
                        <span class="text-[10px] font-black uppercase tracking-widest">5.0 (12 jobs)</span>
                    </div>
                </div>
            </div>
            <span class="text-[9px] font-black text-blue-500 bg-blue-500/10 px-3 py-1.5 rounded-lg border border-blue-500/20 uppercase tracking-[0.2em]">Em Projeto</span>
        </div>
        
        <div class="flex flex-wrap gap-2 mb-8 relative z-10">
            <span class="text-[9px] font-black text-gray-500 bg-white/5 px-3 py-1.5 rounded-lg border border-white/5 uppercase tracking-widest group-hover:border-white/10 transition-colors">ArchViz</span>
            <span class="text-[9px] font-black text-gray-500 bg-white/5 px-3 py-1.5 rounded-lg border border-white/5 uppercase tracking-widest group-hover:border-white/10 transition-colors">Unreal Engine</span>
            <span class="text-[9px] font-black text-gray-500 bg-white/5 px-3 py-1.5 rounded-lg border border-white/5 uppercase tracking-widest group-hover:border-white/10 transition-colors">Lumina</span>
        </div>

        <div class="pt-8 border-t border-white/5 flex items-center justify-between relative z-10">
            <div>
                <p class="text-[9px] font-black text-gray-600 uppercase tracking-[0.3em] mb-1">Valor Hora</p>
                <p class="text-xl font-black text-white">R$ <span class="text-gradient">120,00</span></p>
            </div>
            <button class="bg-white/5 hover:bg-orange-500 text-gray-400 hover:text-white w-12 h-12 rounded-2xl border border-white/10 hover:border-orange-500/50 transition-all flex items-center justify-center shadow-2xl">
                <span class="material-symbols-outlined text-xl">forum</span>
            </button>
        </div>
    </div>
</div>

