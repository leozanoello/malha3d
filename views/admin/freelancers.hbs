<div class="container-fluid py-4 h-screen flex flex-col overflow-hidden">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8 flex-shrink-0 px-4">
        <div class="flex flex-col gap-1">
            <h1 class="text-3xl font-black text-white tracking-tight">Time de <span class="text-orange-500">Freelancers</span></h1>
            <p class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mt-1">Gestão de Talentos ArchViz & Colaboradores Externos</p>
        </div>
        <div class="flex items-center gap-4">
            <div class="glass-card px-4 py-2 border-white/5 flex items-center gap-3">
                <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Ativos no Banco:</span>
                <span class="text-lg font-black text-white">{{length freelancers}}</span>
            </div>
            <button class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-3 rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-lg shadow-orange-500/20 transition-all flex items-center gap-2" data-bs-toggle="modal" data-bs-target="#newFreelancerModal">
                <span class="material-symbols-outlined text-sm">person_add</span> Novo Artista
            </button>
        </div>
    </div>

    <!-- Freelancer Cards Grid -->
    <div class="flex-1 overflow-y-auto px-4 pb-20 scrollbar-hide">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {{#each freelancers}}
            <div class="glass-card p-5 border-white/5 bg-white/2 group hover:border-orange-500/30 transition-all relative overflow-visible h-fit">
                <!-- Status Badge -->
                <div class="absolute top-4 right-4 flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full {{#if (eq status 'Ativo')}}bg-emerald-500 shadow-[0_0_8px_#10b981]{{else}}bg-gray-500{{/if}}"></span>
                    <span class="text-[8px] font-black text-gray-400 uppercase tracking-widest">{{status}}</span>
                </div>

                <div class="flex items-center gap-4 mb-6">
                    <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-orange-400 to-orange-600 flex items-center justify-center text-2xl font-black text-white shadow-lg shadow-orange-500/20 group-hover:scale-105 transition-transform">
                        {{firstLetter name}}
                    </div>
                    <div class="overflow-hidden">
                        <h3 class="text-base font-black text-white truncate group-hover:text-orange-500 transition-colors uppercase tracking-tight">{{name}}</h3>
                        <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest truncate">{{expertise}}</p>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3 mb-6">
                    <div class="p-3 rounded-xl bg-white/5 border border-white/5">
                        <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-1">Avaliação</p>
                        <div class="flex text-orange-500 text-[10px]">
                            {{{ratingStars rating}}}
                        </div>
                    </div>
                    <div class="p-3 rounded-xl bg-white/5 border border-white/5">
                        <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-1">Valor Hora</p>
                        <p class="text-[10px] font-black text-white uppercase">{{formatCurrency hourlyRate}}</p>
                    </div>
                </div>

                <div class="space-y-2 mb-6 px-1">
                    <div class="flex items-center gap-3 text-gray-400">
                        <span class="material-symbols-outlined text-[14px]">mail</span>
                        <span class="text-[9px] font-bold truncate">{{email}}</span>
                    </div>
                    <div class="flex items-center gap-3 text-gray-400">
                        <span class="material-symbols-outlined text-[14px]">call</span>
                        <span class="text-[9px] font-bold">{{phone}}</span>
                    </div>
                </div>

                <div class="flex gap-2 relative">
                    <button class="flex-1 py-3 rounded-xl bg-white/5 text-[9px] font-black uppercase tracking-widest text-white hover:bg-white/10 transition-all">Ver Perfil</button>
                    
                    <div class="dropdown">
                        <button class="px-3 py-3 rounded-xl bg-orange-500/10 text-orange-500 hover:bg-orange-500 hover:text-white transition-all" data-bs-toggle="dropdown">
                            <span class="material-symbols-outlined text-sm">more_vert</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark glass-card border-white/10 bg-dark-950 p-2">
                            <li><a class="dropdown-item rounded-xl text-[10px] font-bold uppercase py-2 flex items-center gap-2" href="#"><span class="material-symbols-outlined text-sm">assignment_ind</span> Atribuir Projeto</a></li>
                            <li><a class="dropdown-item rounded-xl text-[10px] font-bold uppercase py-2 flex items-center gap-2" href="#"><span class="material-symbols-outlined text-sm">edit</span> Editar</a></li>
                            <li><hr class="dropdown-divider border-white/5"></li>
                            <li><a class="dropdown-item rounded-xl text-[10px] font-bold uppercase py-2 text-red-500 flex items-center gap-2" href="#" onclick="deleteFreelancer('{{id}}')"><span class="material-symbols-outlined text-sm">delete</span> Remover</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            {{else}}
            <div class="col-span-full py-20 text-center opacity-30">
                <span class="material-symbols-outlined text-6xl mb-4">person_search</span>
                <p class="text-xl font-black uppercase tracking-widest">Banco de Talentos Vazio</p>
                <p class="text-[10px] font-bold mt-2 uppercase tracking-widest">Adicione artistas externos para iniciar a escala.</p>
            </div>
            {{/each}}
        </div>
    </div>
</div>

<!-- Modal: Novo Freelancer -->
<div class="modal fade" id="newFreelancerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-card p-4 border-white/10 bg-dark-950/95">
            <div class="flex justify-between items-center mb-6 px-4">
                <h3 class="text-xl font-black text-white uppercase tracking-tighter">Novo <span class="text-orange-500">Artista Freelancer</span></h3>
                <button type="button" class="text-gray-500 hover:text-white" data-bs-dismiss="modal"><span class="material-symbols-outlined">close</span></button>
            </div>
            <form action="/admin/freelancers" method="POST" class="p-4 grid grid-cols-2 gap-6">
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Nome Completo</label>
                    <input type="text" name="name" class="input-premium" placeholder="Ex: Roberto Silva" required>
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">E-mail Profissional</label>
                    <input type="email" name="email" class="input-premium" placeholder="contato@artista.com" required>
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">WhatsApp / Telefone</label>
                    <input type="text" name="phone" class="input-premium" placeholder="(11) 99999-9999">
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Valor Hora (R$)</label>
                    <input type="number" name="hourlyRate" class="input-premium" placeholder="80.00" step="0.01">
                </div>
                <div class="col-span-2 space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Especialidades (ArchViz)</label>
                    <div class="flex flex-wrap gap-2">
                        <label class="cursor-pointer">
                            <input type="checkbox" name="expertise" value="Modelagem" class="sr-only peer">
                            <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/5 text-[9px] font-bold text-gray-400 peer-checked:bg-orange-500 peer-checked:text-white transition-all uppercase">Modelagem</span>
                        </label>
                        <label class="cursor-pointer">
                            <input type="checkbox" name="expertise" value="Renderização" class="sr-only peer">
                            <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/5 text-[9px] font-bold text-gray-400 peer-checked:bg-orange-500 peer-checked:text-white transition-all uppercase">Renderização</span>
                        </label>
                        <label class="cursor-pointer">
                            <input type="checkbox" name="expertise" value="Animação" class="sr-only peer">
                            <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/5 text-[9px] font-bold text-gray-400 peer-checked:bg-orange-500 peer-checked:text-white transition-all uppercase">Animação</span>
                        </label>
                        <label class="cursor-pointer">
                            <input type="checkbox" name="expertise" value="Pós-Produção" class="sr-only peer">
                            <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/5 text-[9px] font-bold text-gray-400 peer-checked:bg-orange-500 peer-checked:text-white transition-all uppercase">Pós-Produção</span>
                        </label>
                    </div>
                </div>
                <div class="col-span-2 space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Notas e Observações</label>
                    <textarea name="notes" class="input-premium h-32" placeholder="Descreva pontos fortes, disponibilidade e histórico..."></textarea>
                </div>
                <div class="col-span-2 flex gap-4 pt-4">
                    <button type="submit" class="flex-1 py-4 rounded-2xl bg-orange-500 text-white font-black uppercase tracking-widest shadow-xl shadow-orange-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all">
                        Salvar no Banco de Talentos
                    </button>
                    <button type="button" class="px-8 rounded-2xl bg-white/5 text-white font-black uppercase tracking-widest hover:bg-white/10" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
async function deleteFreelancer(id) {
    if (!confirm('Deseja remover este artista do banco de talentos?')) return;
    try {
        const res = await fetch(`/admin/api/freelancers/${id}`, { method: 'DELETE' });
        const json = await res.json();
        if (json.success) window.location.reload();
        else alert('Erro ao remover freelancer.');
    } catch (err) { alert('Erro de rede.'); }
}
</script>
