<!-- Simulador de Cenarios — Malha3D ArchViz Admin -->
<div class="p-4 md:p-5 space-y-4" style="background:#0a0c10;">

 <!-- ============ HEADER ============ -->
 <div class="kcard">
  <div class="kcard-body" style="padding:20px;">
   <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div class="min-w-0">
     <div class="flex items-center gap-2 mb-2 flex-wrap">
      <span class="kcard-badge kcard-badge-orange">
       <span class="material-symbols-outlined text-[10px] align-middle mr-0.5">calculate</span> What-If
      </span>
      <span class="kcard-badge">Projecao Financeira</span>
     </div>
     <h1 class="text-2xl font-black text-white tracking-tight mb-1">
      Simulador de <span class="text-orange-400">Cenarios</span>
     </h1>
     <p class="text-gray-400 text-[11px] font-medium max-w-2xl">
      Projete o impacto financeiro de decisoes
     </p>
    </div>
    <div class="flex items-center gap-2 flex-wrap shrink-0">
     <div class="kcard flex items-center gap-1.5 px-3 h-[36px]" style="border-color:rgba(59,130,246,0.25);">
      <span class="material-symbols-outlined text-[14px] text-blue-400">history</span>
      <span class="text-[8px] uppercase tracking-widest font-black text-blue-400" id="baselinePeriod">Carregando...</span>
     </div>
     <button id="resetSimBtn" class="kcard flex items-center gap-1.5 px-3 h-[36px] cursor-pointer hover:border-orange-500/40 transition-all" style="border-color:rgba(249,115,22,0.25);" type="button">
      <span class="material-symbols-outlined text-[14px] text-orange-400">restart_alt</span>
      <span class="text-[8px] uppercase tracking-widest font-black text-orange-400">Reset</span>
     </button>
    </div>
   </div>
  </div>
 </div>

 <!-- ============ CONTROL PANEL ============ -->
 <div class="kcard">
  <div class="kcard-body" style="padding:20px;">
   <div class="flex items-center gap-2 mb-4">
    <span class="w-8 h-8 rounded-[4px] flex items-center justify-center" style="background:rgba(59,130,246,0.12); border:1px solid rgba(59,130,246,0.25);">
     <span class="material-symbols-outlined text-blue-400 text-[16px]">tune</span>
    </span>
    <h2 class="kcard-title text-[12px] font-black uppercase tracking-widest">Variaveis do Cenario</h2>
   </div>

   <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">

    <!-- 1. Ajuste de Preco -->
