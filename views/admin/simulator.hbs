<!-- ============ JAVASCRIPT ============ -->
<script>
(function() {
 'use strict';

 function fmtBRL(n) {
  const v = Number(n) || 0;
  return v.toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
 }
 function fmtBRLShort(n) {
  const v = Number(n) || 0;
  return 'R$ ' + v.toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
 }
 function fmtPct(n) {
  const v = Number(n) || 0;
  const sign = v > 0 ? '+' : '';
  return sign + v.toFixed(1) + '%';
 }
 function clamp(n, min, max) { return Math.max(min, Math.min(max, n)); }
 function clampPct(n) { return clamp(n, 0, 100); }

 // State
 const state = {
  baseRevenue: 0,
  baseExpense: 0,
  baseProfit: 0,
  baseMargin: 0,
  avgProjectValue: 0,
  period: 'mes atual',
  loaded: false
 };

 // Elements
 const els = {
  priceAdj: document.getElementById('priceAdj'),
  priceAdjLabel: document.getElementById('priceAdjLabel'),
  lostProjects: document.getElementById('lostProjects'),
  lostLabel: document.getElementById('lostLabel'),
  newProjects: document.getElementById('newProjects'),
  newLabel: document.getElementById('newLabel'),
  costAdj: document.getElementById('costAdj'),
  costAdjLabel: document.getElementById('costAdjLabel'),

  revenueValue: document.getElementById('revenueValue'),
  revenueBase: document.getElementById('revenueBase'),
  revenueBadge: document.getElementById('revenueBadge'),

  profitValue: document.getElementById('profitValue'),
  profitBase: document.getElementById('profitBase'),
  profitBadge: document.getElementById('profitBadge'),

  marginValue: document.getElementById('marginValue'),
  marginBase: document.getElementById('marginBase'),
  marginBadge: document.getElementById('marginBadge'),
  marginGauge: document.getElementById('marginGauge'),
  marginCursor: document.getElementById('marginCursor'),

  scenarioSummary: document.getElementById('scenarioSummary'),
  bestCase: document.getElementById('bestCase'),
  baseCase: document.getElementById('baseCase'),
  worstCase: document.getElementById('worstCase'),
  baselinePeriod: document.getElementById('baselinePeriod'),

  resetBtn: document.getElementById('resetSimBtn'),

  // Chart
  currentBars: document.getElementById('currentBars'),
  projectedBars: document.getElementById('projectedBars'),
  yMax: document.getElementById('yMax'),
  yMid: document.getElementById('yMid'),
  yMin: document.getElementById('yMin'),
  currentRevLabel: document.getElementById('currentRevLabel'),
  currentExpLabel: document.getElementById('currentExpLabel'),
  currentProfLabel: document.getElementById('currentProfLabel'),
  projRevLabel: document.getElementById('projRevLabel'),
  projExpLabel: document.getElementById('projExpLabel'),
  projProfLabel: document.getElementById('projProfLabel')
 };

 function getNumber(v) {
  const n = Number(v);
  return isFinite(n) ? n : 0;
 }

 function badgeClass(change) {
  if (change > 0.5) return 'kcard-badge';
  if (change < -0.5) return 'kcard-badge';
  return 'kcard-badge';
 }

 function colorizeBadge(badge, change) {
  if (!badge) return;
  if (change > 0.5) {
   badge.style.background = 'rgba(16,185,129,0.15)';
   badge.style.borderColor = 'rgba(16,185,129,0.35)';
   badge.style.color = '#10b981';
  } else if (change < -0.5) {
   badge.style.background = 'rgba(239,68,68,0.15)';
   badge.style.borderColor = 'rgba(239,68,68,0.35)';
   badge.style.color = '#ef4444';
  } else {
   badge.style.background = 'rgba(107,114,128,0.15)';
   badge.style.borderColor = 'rgba(107,114,128,0.35)';
   badge.style.color = '#9ca3af';
  }
 }

 function buildSummary(priceAdj, lost, news, costAdj, newRev, newExp, newProf, newMargin) {
  const parts = [];
  parts.push('Se voce <strong class="text-orange-400">' + (priceAdj >= 0 ? 'aumentar' : 'reduzir') + ' precos em ' + priceAdj + '%</strong>,');
  if (lost > 0) parts.push('perder <strong class="text-red-400">' + lost + ' projeto' + (lost > 1 ? 's' : '') + '</strong>,');
  if (news > 0) parts.push('ganhar <strong class="text-emerald-400">' + news + ' novo' + (news > 1 ? 's' : '') + ' projeto' + (news > 1 ? 's' : '') + '</strong>,');
  if (costAdj !== 0) parts.push('os custos <strong class="text-yellow-400">variam ' + (costAdj >= 0 ? '+' : '') + costAdj + '%</strong>,');
  parts.push('seu faturamento seria <strong class="text-white">R$ ' + fmtBRL(newRev) + '</strong> (vs R$ ' + fmtBRL(state.baseRevenue) + ' atual),');
  parts.push('lucro de <strong class="text-emerald-400">R$ ' + fmtBRL(newProf) + '</strong> (margem <strong class="text-orange-400">' + newMargin.toFixed(1) + '%</strong>).');
  return parts.join(' ');
 }

 function updateScenario() {
  const priceAdj = getNumber(els.priceAdj.value);
  const lost = getNumber(els.lostProjects.value);
  const news = getNumber(els.newProjects.value);
  const costAdj = getNumber(els.costAdj.value);

  els.priceAdjLabel.textContent = (priceAdj >= 0 ? '+' : '') + priceAdj + '%';
  els.lostLabel.textContent = lost;
  els.newLabel.textContent = news;
  els.costAdjLabel.textContent = (costAdj >= 0 ? '+' : '') + costAdj + '%';

  // Calculation
  const newRevenue = state.baseRevenue * (1 + priceAdj / 100)
   - (lost * state.avgProjectValue)
   + (news * state.avgProjectValue * (1 + priceAdj / 100));

  const newExpense = state.baseExpense * (1 + costAdj / 100);
  const newProfit = newRevenue - newExpense;
  const newMargin = newRevenue > 0 ? (newProfit / newRevenue) * 100 : 0;

  const revenueChange = state.baseRevenue > 0 ? ((newRevenue - state.baseRevenue) / state.baseRevenue) * 100 : 0;
  const profitChange = state.baseProfit !== 0 ? ((newProfit - state.baseProfit) / Math.abs(state.baseProfit)) * 100 : 0;
  const marginChange = newMargin - state.baseMargin;

  // Revenue card
  els.revenueValue.textContent = fmtBRL(newRevenue);
  els.revenueBase.textContent = fmtBRL(state.baseRevenue);
  els.revenueBadge.textContent = fmtPct(revenueChange);
  colorizeBadge(els.revenueBadge, revenueChange);

  // Profit card
  els.profitValue.textContent = fmtBRL(newProfit);
  els.profitBase.textContent = fmtBRL(state.baseProfit);
  els.profitBadge.textContent = fmtPct(profitChange);
  colorizeBadge(els.profitBadge, profitChange);

  // Margin card
  els.marginValue.textContent = newMargin.toFixed(1) + '%';
  els.marginBase.textContent = state.baseMargin.toFixed(1) + '%';
  els.marginBadge.textContent = (marginChange >= 0 ? '+' : '') + marginChange.toFixed(1) + 'pp';
  colorizeBadge(els.marginBadge, marginChange);

  // Gauge — clamp 0..100
  const gaugePct = clampPct(newMargin);
  els.marginGauge.style.width = gaugePct + '%';
  els.marginCursor.style.left = gaugePct + '%';

  // Summary text
  els.scenarioSummary.innerHTML = '<p>' + buildSummary(priceAdj, lost, news, costAdj, newRevenue, newExpense, newProfit, newMargin) + '</p>';

  // Edge case insights
  // Best case: +price, +new (no lost), -cost
  const bestRev = state.baseRevenue * 1.5 + (5 * state.avgProjectValue * 1.5);
  const bestExp = state.baseExpense * 0.7;
  const bestProf = bestRev - bestExp;
  els.bestCase.textContent = 'Preco +50%, +5 projetos, custo -30%: lucro ' + fmtBRLShort(bestProf);

  // Base case
  els.baseCase.textContent = 'Cenario atual: lucro ' + fmtBRLShort(state.baseProfit) + ' (' + state.baseMargin.toFixed(1) + '% margem)';

  // Worst case: -price, -lost, +cost
  const worstRev = state.baseRevenue * 0.5 - (5 * state.avgProjectValue);
  const worstExp = state.baseExpense * 1.5;
  const worstProf = worstRev - worstExp;
  els.worstCase.textContent = 'Preco -50%, -5 projetos, custo +50%: lucro ' + fmtBRLShort(worstProf);

  // Update chart
  updateChart(newRevenue, newExpense, newProfit);
 }

 function updateChart(newRev, newExp, newProf) {
  const maxVal = Math.max(state.baseRevenue, state.baseExpense, Math.abs(state.baseExpense), newRev, newExp, Math.abs(newExp), 1);
  const yMax = maxVal;
  const yScale = 180 / yMax; // pixels

  const curRevH = state.baseRevenue * yScale;
  const curExpH = state.baseExpense * yScale;
  const curProfH = Math.abs(state.baseProfit) * yScale;
  const projRevH = newRev * yScale;
  const projExpH = newExp * yScale;
  const projProfH = Math.abs(newProf) * yScale;

  // Y axis labels
  if (els.yMax) els.yMax.textContent = 'R$ ' + fmtBRL(yMax);
  if (els.yMid) els.yMid.textContent = 'R$ ' + fmtBRL(yMax / 2);
  if (els.yMin) els.yMin.textContent = 'R$ ' + fmtBRL(0);

  // Bars
  const cb = els.currentBars.children;
  if (cb[0]) { cb[0].setAttribute('height', curRevH); cb[0].setAttribute('y', 200 - curRevH); }
  if (cb[1]) { cb[1].setAttribute('height', curExpH); cb[1].setAttribute('y', 200 - curExpH); }
  if (cb[2]) { cb[2].setAttribute('height', curProfH); cb[2].setAttribute('y', 200 - curProfH); }

  const pb = els.projectedBars.children;
  if (pb[0]) { pb[0].setAttribute('height', projRevH); pb[0].setAttribute('y', 200 - projRevH); }
  if (pb[1]) { pb[1].setAttribute('height', projExpH); pb[1].setAttribute('y', 200 - projExpH); }
  if (pb[2]) { pb[2].setAttribute('height', projProfH); pb[2].setAttribute('y', 200 - projProfH); }

  // Labels
  if (els.currentRevLabel) els.currentRevLabel.textContent = 'R$ ' + fmtBRL(state.baseRevenue);
  if (els.currentExpLabel) els.currentExpLabel.textContent = 'R$ ' + fmtBRL(state.baseExpense);
  if (els.currentProfLabel) els.currentProfLabel.textContent = 'R$ ' + fmtBRL(state.baseProfit);
  if (els.projRevLabel) els.projRevLabel.textContent = 'R$ ' + fmtBRL(newRev);
  if (els.projExpLabel) els.projExpLabel.textContent = 'R$ ' + fmtBRL(newExp);
  if (els.projProfLabel) els.projProfLabel.textContent = 'R$ ' + fmtBRL(newProf);
 }

 function bindSliders() {
  ['priceAdj','lostProjects','newProjects','costAdj'].forEach(function(id) {
   const el = document.getElementById(id);
   if (el) el.addEventListener('input', updateScenario);
  });
  if (els.resetBtn) {
   els.resetBtn.addEventListener('click', function() {
    if (els.priceAdj) els.priceAdj.value = 0;
    if (els.lostProjects) els.lostProjects.value = 0;
    if (els.newProjects) els.newProjects.value = 0;
    if (els.costAdj) els.costAdj.value = 0;
    updateScenario();
   });
  }
 }

 function applyDefaultIfNoData() {
  // Sensible defaults if endpoint is unreachable
  if (!state.loaded) {
   state.baseRevenue = 50000;
   state.baseExpense = 30000;
   state.baseProfit = 20000;
   state.baseMargin = (state.baseProfit / state.baseRevenue) * 100;
   state.avgProjectValue = 5000;
   state.period = 'demo (sem dados)';
   if (els.baselinePeriod) els.baselinePeriod.textContent = 'Cenario Demo';
  }
 }

 async function loadBaseline() {
  try {
   const res = await fetch('/admin/api/erp/monthly-comparison', { headers: { 'Accept':'application/json' } });
   if (!res.ok) throw new Error('HTTP ' + res.status);
   const data = await res.json();
   // Expected shape: { current: { revenue, expense, profit }, previous: {...}, avgProjectValue, period }
   const cur = data.current || data.month || data;
   state.baseRevenue = getNumber(cur.revenue || cur.totalRevenue || cur.total_revenue || cur.receitas);
   state.baseExpense = getNumber(cur.expense || cur.totalExpense || cur.total_expense || cur.despesas);
   state.baseProfit = state.baseRevenue - state.baseExpense;
   if (typeof cur.profit !== 'undefined') state.baseProfit = getNumber(cur.profit);
   state.baseMargin = state.baseRevenue > 0 ? (state.baseProfit / state.baseRevenue) * 100 : 0;
   state.avgProjectValue = getNumber(data.avgProjectValue || data.avg_project_value || (state.baseRevenue > 0 ? state.baseRevenue / 12 : 0));
   if (state.avgProjectValue <= 0) state.avgProjectValue = state.baseRevenue / 10;
   state.period = data.period || cur.period || 'mes atual';
   state.loaded = true;
   if (els.baselinePeriod) els.baselinePeriod.textContent = state.period;
  } catch (err) {
   console.warn('[simulator] fetch failed, using defaults', err);
   applyDefaultIfNoData();
  }
  updateScenario();
 }

 function init() {
  bindSliders();
  loadBaseline();
 }

 if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
 } else {
  init();
 }
})();
</script>
