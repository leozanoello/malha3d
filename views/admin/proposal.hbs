<!-- Gerador de Propostas — Malha3D ArchViz Admin -->
<div class="p-4 md:p-5 space-y-4" style="background:#0a0c10;">

 <!-- ============ HEADER ============ -->
 <div class="kcard">
  <div class="kcard-body" style="padding:20px;">
   <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div class="min-w-0">
     <div class="flex items-center gap-2 mb-2 flex-wrap">
      <span class="kcard-badge kcard-badge-orange">
       <span class="material-symbols-outlined text-[10px] align-middle mr-0.5">description</span> Propostas
      </span>
      <span class="kcard-badge">PDF / Imprimir</span>
     </div>
     <h1 class="text-2xl font-black text-white tracking-tight mb-1">
      Gerador de <span class="text-orange-400">Propostas</span>
     </h1>
     <p class="text-gray-400 text-[11px] font-medium max-w-2xl">
      Crie propostas profissionais em segundos
     </p>
    </div>
    <div class="flex items-center gap-2 flex-wrap shrink-0 no-print">
     <button id="saveProposalBtn" class="kcard flex items-center gap-1.5 px-3 h-[36px] cursor-pointer hover:border-emerald-500/40 transition-all" style="border-color:rgba(16,185,129,0.25);" type="button">
      <span class="material-symbols-outlined text-[14px] text-emerald-400">save</span>
      <span class="text-[8px] uppercase tracking-widest font-black text-emerald-400">Salvar</span>
     </button>
     <button id="printProposalBtn" class="kcard flex items-center gap-1.5 px-3 h-[36px] cursor-pointer hover:border-orange-500/40 transition-all" style="border-color:rgba(249,115,22,0.25);" type="button">
      <span class="material-symbols-outlined text-[14px] text-orange-400">print</span>
      <span class="text-[8px] uppercase tracking-widest font-black text-orange-400">Imprimir / PDF</span>
     </button>
    </div>
   </div>
  </div>
 </div>

 <!-- ============ MAIN GRID ============ -->
 <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">

  <!-- ===== LEFT PANEL: FORM ===== -->
  <div class="lg:col-span-5 no-print">
   <div class="kcard">
    <div class="kcard-body" style="padding:20px;">
     <div class="flex items-center gap-2 mb-4">
      <span class="w-8 h-8 rounded-[4px] flex items-center justify-center" style="background:rgba(249,115,22,0.12); border:1px solid rgba(249,115,22,0.25);">
       <span class="material-symbols-outlined text-orange-400 text-[16px]">edit_note</span>
      </span>
      <h2 class="kcard-title text-[12px] font-black uppercase tracking-widest">Dados da Proposta</h2>
     </div>

     <form id="proposalForm" class="space-y-3">

      <!-- Cliente -->
      <div>
       <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Cliente</label>
       <select id="fClient" class="w-full px-3 py-2 text-[11px] font-bold text-white rounded-[4px] appearance-none" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
        <option value="">— Selecione —</option>
        {{#each clients}}
        <option value="{{this.id}}" data-name="{{this.name}}" data-company="{{this.company}}" data-email="{{this.email}}">{{this.name}}{{#if this.company}} — {{this.company}}{{/if}}</option>
        {{/each}}
       </select>
      </div>

      <!-- Projeto -->
      <div>
       <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Projeto</label>
       <input type="text" id="fProject" placeholder="Ex: Residencial Aurora" class="w-full px-3 py-2 text-[11px] text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" />
      </div>

      <!-- Tipo de Serviço -->
      <div>
       <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Tipo de Serviço</label>
       <select id="fService" class="w-full px-3 py-2 text-[11px] font-bold text-white rounded-[4px] appearance-none" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
        <option>Renderização</option>
        <option>Animação</option>
        <option>Tour Virtual</option>
        <option>Planta Humanizada</option>
       </select>
      </div>

      <!-- Escopo -->
      <div>
       <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Escopo</label>
       <textarea id="fScope" rows="4" placeholder="Descreva o que está incluso no serviço..." class="w-full px-3 py-2 text-[11px] text-white rounded-[4px] resize-y" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);"></textarea>
      </div>

      <!-- Metragem + Imagens -->
      <div class="grid grid-cols-2 gap-2">
       <div>
        <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Metragem (m²)</label>
        <input type="number" id="fArea" min="0" value="0" class="w-full px-3 py-2 text-[11px] text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" />
       </div>
       <div>
        <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Qtd. Imagens</label>
        <input type="number" id="fImages" min="0" value="0" class="w-full px-3 py-2 text-[11px] text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" />
       </div>
      </div>

      <!-- Prazo + Valor -->
      <div class="grid grid-cols-2 gap-2">
       <div>
        <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Prazo (dias)</label>
        <input type="number" id="fDeadline" min="0" value="15" class="w-full px-3 py-2 text-[11px] text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" />
       </div>
       <div>
        <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Valor Total (R$)</label>
        <input type="number" id="fValue" min="0" step="0.01" value="0" class="w-full px-3 py-2 text-[11px] text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" />
       </div>
      </div>

      <!-- Pagamento -->
      <div>
       <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Condições de Pagamento</label>
       <input type="text" id="fPayment" value="50% entrada + 50% entrega" class="w-full px-3 py-2 text-[11px] text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" />
      </div>

      <!-- Validade -->
      <div>
       <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Validade da Proposta (dias)</label>
       <input type="number" id="fValidity" min="1" value="15" class="w-full px-3 py-2 text-[11px] text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" />
      </div>

      <!-- Observações -->
      <div>
       <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest block mb-1">Observações</label>
       <textarea id="fNotes" rows="3" placeholder="Informações adicionais..." class="w-full px-3 py-2 text-[11px] text-white rounded-[4px] resize-y" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);"></textarea>
      </div>

      <button type="button" id="generateBtn" class="w-full flex items-center justify-center gap-2 py-3 rounded-[4px] bg-orange-500 text-white text-[9px] font-black uppercase tracking-widest hover:bg-orange-600 transition-colors">
       <span class="material-symbols-outlined text-[14px]">auto_awesome</span>
       Gerar Proposta
      </button>
     </form>
    </div>
   </div>
  </div>

  <!-- ===== RIGHT PANEL: LIVE PREVIEW ===== -->
  <div class="lg:col-span-7">
   <div class="kcard">
    <div class="kcard-body" style="padding:20px;">
     <div class="flex items-center justify-between mb-3 no-print">
      <div class="flex items-center gap-2">
       <span class="w-8 h-8 rounded-[4px] flex items-center justify-center" style="background:rgba(249,115,22,0.12); border:1px solid rgba(249,115,22,0.25);">
        <span class="material-symbols-outlined text-orange-400 text-[16px]">preview</span>
       </span>
       <h2 class="kcard-title text-[12px] font-black uppercase tracking-widest">Pré-visualização</h2>
      </div>
      <span class="text-[8px] uppercase tracking-widest font-black text-emerald-400 flex items-center gap-1">
       <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
       Atualização ao vivo
      </span>
     </div>

     <!-- ===== PROPOSAL DOCUMENT ===== -->
     <div id="proposalDoc" class="proposal-doc" style="background:#ffffff; color:#1a1a1a; padding:36px 40px; border-radius:5px; box-shadow:0 4px 18px rgba(0,0,0,0.5); font-family:'Helvetica Neue', Arial, sans-serif; min-height:800px;">

      <!-- Company Header -->
      <div style="display:flex; align-items:flex-start; justify-content:space-between; border-bottom:3px solid #f97316; padding-bottom:16px; margin-bottom:24px;">
       <div>
        <div style="font-size:22px; font-weight:900; color:#1a1a1a; letter-spacing:-0.5px;">MALHA3D</div>
        <div style="font-size:10px; color:#6b7280; margin-top:2px; text-transform:uppercase; letter-spacing:2px; font-weight:700;">Visualização Arquitetônica</div>
       </div>
       <div style="text-align:right; font-size:9px; color:#6b7280; line-height:1.5;">
        <div style="font-weight:700; color:#1a1a1a;" id="pDate">—</div>
        <div>Proposta Nº <span id="pNumber">0000</span></div>
       </div>
      </div>

      <!-- Title -->
      <div style="text-align:center; margin-bottom:28px;">
       <div style="font-size:18px; font-weight:900; color:#1a1a1a; letter-spacing:4px; text-transform:uppercase;">Proposta Comercial</div>
       <div style="font-size:10px; color:#f97316; margin-top:4px; text-transform:uppercase; letter-spacing:3px; font-weight:700;" id="pService">—</div>
      </div>

      <!-- Client Block -->
      <div style="margin-bottom:24px;">
       <div style="font-size:9px; font-weight:900; color:#f97316; text-transform:uppercase; letter-spacing:2px; margin-bottom:8px;">Cliente</div>
       <div style="background:#f9fafb; padding:14px 16px; border-left:3px solid #f97316; border-radius:3px;">
        <div style="font-size:13px; font-weight:800; color:#1a1a1a;" id="pClientName">—</div>
        <div style="font-size:10px; color:#4b5563; margin-top:2px;" id="pClientCompany">—</div>
        <div style="font-size:10px; color:#6b7280; margin-top:2px;" id="pClientEmail">—</div>
       </div>
      </div>

      <!-- Project Info -->
      <div style="margin-bottom:24px;">
       <div style="font-size:9px; font-weight:900; color:#f97316; text-transform:uppercase; letter-spacing:2px; margin-bottom:8px;">Projeto</div>
       <div style="font-size:13px; font-weight:800; color:#1a1a1a;" id="pProject">—</div>
      </div>

      <!-- Escopo -->
      <div style="margin-bottom:24px;">
       <div style="font-size:9px; font-weight:900; color:#f97316; text-transform:uppercase; letter-spacing:2px; margin-bottom:8px;">Escopo do Serviço</div>
       <ul id="pScope" style="list-style:none; padding:0; margin:0;">
        <li style="font-size:11px; color:#374151; padding:4px 0; padding-left:14px; position:relative;">
         <span style="position:absolute; left:0; color:#f97316; font-weight:900;">•</span>
         <span class="p-scope-text">—</span>
        </li>
       </ul>
      </div>

      <!-- Tabela de Itens -->
      <div style="margin-bottom:24px;">
       <div style="font-size:9px; font-weight:900; color:#f97316; text-transform:uppercase; letter-spacing:2px; margin-bottom:8px;">Investimento</div>
       <table style="width:100%; border-collapse:collapse; font-size:10px;">
        <thead>
         <tr style="background:#1a1a1a; color:#ffffff;">
          <th style="text-align:left; padding:8px 10px; font-weight:800; text-transform:uppercase; letter-spacing:1px; font-size:9px;">Item</th>
          <th style="text-align:center; padding:8px 10px; font-weight:800; text-transform:uppercase; letter-spacing:1px; font-size:9px;">Qtd</th>
          <th style="text-align:right; padding:8px 10px; font-weight:800; text-transform:uppercase; letter-spacing:1px; font-size:9px;">Valor Unit.</th>
          <th style="text-align:right; padding:8px 10px; font-weight:800; text-transform:uppercase; letter-spacing:1px; font-size:9px;">Total</th>
         </tr>
        </thead>
        <tbody id="pTableBody">
         <tr style="border-bottom:1px solid #e5e7eb;">
          <td style="padding:10px; font-weight:700; color:#1a1a1a;" id="pRowItem">—</td>
          <td style="padding:10px; text-align:center; color:#4b5563;" id="pRowQty">—</td>
          <td style="padding:10px; text-align:right; color:#4b5563;" id="pRowUnit">—</td>
          <td style="padding:10px; text-align:right; font-weight:800; color:#1a1a1a;" id="pRowTotal">—</td>
         </tr>
        </tbody>
        <tfoot>
         <tr style="background:#fff7ed; border-top:2px solid #f97316;">
          <td colspan="3" style="padding:10px; text-align:right; font-weight:900; color:#1a1a1a; text-transform:uppercase; letter-spacing:1px; font-size:10px;">Total Geral</td>
          <td style="padding:10px; text-align:right; font-weight:900; color:#f97316; font-size:14px;" id="pTotal">R$ 0,00</td>
         </tr>
        </tfoot>
       </table>
      </div>

      <!-- Detalhes do Serviço -->
      <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:12px; margin-bottom:24px;">
       <div style="background:#f9fafb; padding:10px 12px; border-radius:3px;">
        <div style="font-size:8px; color:#6b7280; text-transform:uppercase; letter-spacing:1px; font-weight:700;">Metragem</div>
        <div style="font-size:13px; font-weight:900; color:#1a1a1a; margin-top:2px;" id="pArea">— m²</div>
       </div>
       <div style="background:#f9fafb; padding:10px 12px; border-radius:3px;">
        <div style="font-size:8px; color:#6b7280; text-transform:uppercase; letter-spacing:1px; font-weight:700;">Prazo</div>
        <div style="font-size:13px; font-weight:900; color:#1a1a1a; margin-top:2px;" id="pDeadline">— dias</div>
       </div>
       <div style="background:#f9fafb; padding:10px 12px; border-radius:3px;">
        <div style="font-size:8px; color:#6b7280; text-transform:uppercase; letter-spacing:1px; font-weight:700;">Imagens</div>
        <div style="font-size:13px; font-weight:900; color:#1a1a1a; margin-top:2px;" id="pImages">—</div>
       </div>
      </div>

      <!-- Condições de Pagamento -->
      <div style="margin-bottom:18px;">
       <div style="font-size:9px; font-weight:900; color:#f97316; text-transform:uppercase; letter-spacing:2px; margin-bottom:8px;">Condições de Pagamento</div>
       <div style="font-size:11px; color:#374151; padding:10px 12px; background:#f9fafb; border-radius:3px;" id="pPayment">—</div>
      </div>

      <!-- Observações -->
      <div style="margin-bottom:18px;">
       <div style="font-size:9px; font-weight:900; color:#f97316; text-transform:uppercase; letter-spacing:2px; margin-bottom:8px;">Observações</div>
       <div style="font-size:10px; color:#4b5563; padding:10px 12px; background:#f9fafb; border-radius:3px; min-height:30px;" id="pNotes">—</div>
      </div>

      <!-- Validade -->
      <div style="border:1px dashed #f97316; padding:10px 14px; border-radius:3px; margin-bottom:24px; background:#fff7ed;">
       <div style="font-size:10px; color:#9a3412; font-weight:700;">
        <span style="font-weight:900;">Validade:</span> Esta proposta é válida por <span id="pValidity">15</span> dias a partir da data de emissão.
       </div>
      </div>

      <!-- Footer -->
      <div style="border-top:1px solid #e5e7eb; padding-top:14px; text-align:center;">
       <div style="font-size:11px; font-weight:900; color:#1a1a1a;">Malha3D Studio</div>
       <div style="font-size:8px; color:#9ca3af; margin-top:2px; text-transform:uppercase; letter-spacing:2px; font-weight:700;">Proposta gerada automaticamente</div>
      </div>

     </div>
    </div>
   </div>
  </div>

 </div>
</div>

<!-- ============ STYLES ============ -->
<style>
 .proposal-doc {
  font-family: 'Helvetica Neue', Arial, sans-serif;
 }
 .proposal-doc * {
  box-sizing: border-box;
 }

 /* Print rules */
 @media print {
  body { background:#ffffff !important; }
  .no-print { display:none !important; }
  #proposalDoc {
   box-shadow:none !important;
   border-radius:0 !important;
   padding:20mm !important;
   width:100% !important;
   min-height:auto !important;
  }
  /* Hide everything outside the doc */
  body > *:not(.print-wrapper) { display:none !important; }
 }

 body.theme-light .proposal-doc {
  box-shadow: 0 4px 18px rgba(0,0,0,0.15);
 }

 /* Status toast */
 #proposalToast {
  position: fixed;
  bottom: 24px;
  right: 24px;
  background:#151515;
  border:1px solid rgba(249,115,22,0.4);
  color:#fff;
  padding:12px 18px;
  border-radius:5px;
  font-size:11px;
  font-weight:700;
  box-shadow: 0 8px 24px rgba(0,0,0,0.6);
  z-index: 9999;
  display:none;
  align-items:center;
  gap:8px;
 }
 #proposalToast.show { display:flex; }
 #proposalToast .material-symbols-outlined { font-size:16px; }
</style>

<!-- ============ JAVASCRIPT ============ -->
<script>
(function() {
 'use strict';

 function fmtBRL(n) {
  const v = Number(n) || 0;
  return v.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
 }
 function fmtBRLShort(n) {
  const v = Number(n) || 0;
  return 'R$ ' + fmtBRL(v);
 }
 function fmtDate(d) {
  const dt = d instanceof Date ? d : new Date();
  return dt.toLocaleDateString('pt-BR', { day:'2-digit', month:'long', year:'numeric' });
 }
 function escapeHtml(s) {
  if (s == null) return '';
  return String(s).replace(/[&<>"']/g, function(c) {
   return ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' })[c];
  });
 }
 function showToast(msg, color) {
  const t = document.getElementById('proposalToast');
  if (!t) return;
  t.innerHTML = '<span class="material-symbols-outlined" style="color:' + (color || '#f97316') + ';">check_circle</span><span>' + escapeHtml(msg) + '</span>';
  t.classList.add('show');
  clearTimeout(showToast._t);
  showToast._t = setTimeout(function() { t.classList.remove('show'); }, 2600);
 }

 function getClient() {
  const sel = document.getElementById('fClient');
  if (!sel || !sel.value) return { name: '—', company: '—', email: '—' };
  const opt = sel.options[sel.selectedIndex];
  return {
   name: opt.getAttribute('data-name') || '—',
   company: opt.getAttribute('data-company') || '—',
   email: opt.getAttribute('data-email') || '—'
  };
 }

 function updatePreview() {
  const client = getClient();
  const project = (document.getElementById('fProject').value || '—').trim();
  const service = document.getElementById('fService').value || '—';
  const scope = (document.getElementById('fScope').value || '').trim();
  const area = Number(document.getElementById('fArea').value) || 0;
  const images = Number(document.getElementById('fImages').value) || 0;
  const deadline = Number(document.getElementById('fDeadline').value) || 0;
  const totalValue = Number(document.getElementById('fValue').value) || 0;
  const payment = (document.getElementById('fPayment').value || '').trim();
  const validity = Number(document.getElementById('fValidity').value) || 0;
  const notes = (document.getElementById('fNotes').value || '').trim();

  // Header
  document.getElementById('pDate').textContent = fmtDate(new Date());
  document.getElementById('pNumber').textContent = String(Date.now()).slice(-6);
  document.getElementById('pService').textContent = service;

  // Client
  document.getElementById('pClientName').textContent = client.name;
  document.getElementById('pClientCompany').textContent = client.company;
  document.getElementById('pClientEmail').textContent = client.email;

  // Project
  document.getElementById('pProject').textContent = project;

  // Scope (bullet list)
  const ul = document.getElementById('pScope');
  ul.innerHTML = '';
  if (!scope) {
   ul.innerHTML = '<li style="font-size:11px; color:#9ca3af; padding:4px 0; padding-left:14px; position:relative;"><span style="position:absolute; left:0; color:#f97316; font-weight:900;">•</span>Descreva o escopo do serviço no formulário.</li>';
  } else {
   const lines = scope.split(/\r?\n/).map(function(s){ return s.trim(); }).filter(Boolean);
   (lines.length ? lines : [scope]).forEach(function(line) {
    const li = document.createElement('li');
    li.style.cssText = 'font-size:11px; color:#374151; padding:4px 0; padding-left:14px; position:relative;';
    li.innerHTML = '<span style="position:absolute; left:0; color:#f97316; font-weight:900;">•</span>' + escapeHtml(line);
    ul.appendChild(li);
   });
  }

  // Item row
  document.getElementById('pRowItem').textContent = service;
  document.getElementById('pRowQty').textContent = images > 0 ? images : '—';
  // For unit price: total / max(images,1)
  const unitValue = images > 0 ? totalValue / images : totalValue;
  document.getElementById('pRowUnit').textContent = images > 0 ? fmtBRLShort(unitValue) : '—';
  document.getElementById('pRowTotal').textContent = fmtBRLShort(totalValue);

  document.getElementById('pTotal').textContent = fmtBRLShort(totalValue);

  // Detail cards
  document.getElementById('pArea').textContent = area.toLocaleString('pt-BR') + ' m²';
  document.getElementById('pDeadline').textContent = deadline + ' dias';
  document.getElementById('pImages').textContent = images > 0 ? images : '—';

  // Payment / Notes / Validity
  document.getElementById('pPayment').textContent = payment || '—';
  document.getElementById('pNotes').textContent = notes || '—';
  document.getElementById('pValidity').textContent = validity;
 }

 function bindLive() {
  const ids = ['fClient','fProject','fService','fScope','fArea','fImages','fDeadline','fValue','fPayment','fValidity','fNotes'];
  ids.forEach(function(id) {
   const el = document.getElementById(id);
   if (!el) return;
   el.addEventListener('input', updatePreview);
   el.addEventListener('change', updatePreview);
  });
 }

 function printProposal() {
  updatePreview();
  setTimeout(function() { window.print(); }, 80);
 }

 async function saveProposal() {
  updatePreview();
  const payload = {
   client_id: document.getElementById('fClient').value || null,
   project: document.getElementById('fProject').value || '',
   service_type: document.getElementById('fService').value,
   scope: document.getElementById('fScope').value || '',
   area_m2: Number(document.getElementById('fArea').value) || 0,
   image_count: Number(document.getElementById('fImages').value) || 0,
   deadline_days: Number(document.getElementById('fDeadline').value) || 0,
   total_value: Number(document.getElementById('fValue').value) || 0,
   payment_terms: document.getElementById('fPayment').value || '',
   validity_days: Number(document.getElementById('fValidity').value) || 0,
   notes: document.getElementById('fNotes').value || '',
   created_at: new Date().toISOString()
  };
  try {
   const res = await fetch('/admin/api/proposals', {
    method: 'POST',
    headers: { 'Content-Type':'application/json', 'Accept':'application/json' },
    body: JSON.stringify(payload)
   });
   if (!res.ok) throw new Error('HTTP ' + res.status);
   const data = await res.json();
   if (data && data.success) {
    showToast('Proposta salva com sucesso!', '#10b981');
   } else {
    showToast('Resposta inesperada do servidor', '#f97316');
   }
  } catch (err) {
   console.warn('[proposal] save failed', err);
   showToast('Endpoint /admin/api/proposals indisponível (salvo em rascunho)', '#f97316');
  }
 }

 // Toast element injection
 function ensureToast() {
  if (document.getElementById('proposalToast')) return;
  const t = document.createElement('div');
  t.id = 'proposalToast';
  document.body.appendChild(t);
 }

 document.addEventListener('DOMContentLoaded', function() {
  ensureToast();
  bindLive();

  const printBtn = document.getElementById('printProposalBtn');
  if (printBtn) printBtn.addEventListener('click', printProposal);

  const saveBtn = document.getElementById('saveProposalBtn');
  if (saveBtn) saveBtn.addEventListener('click', saveProposal);

  const genBtn = document.getElementById('generateBtn');
  if (genBtn) genBtn.addEventListener('click', function() {
   updatePreview();
   showToast('Proposta atualizada na pré-visualização', '#f97316');
  });

  updatePreview();
 });

 // Also run immediately in case DOMContentLoaded already fired
 if (document.readyState === 'interactive' || document.readyState === 'complete') {
  ensureToast();
  bindLive();
  updatePreview();
 }
})();
</script>
