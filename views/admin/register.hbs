<div class="min-h-screen bg-[#0a0a0a] flex flex-col lg:flex-row relative overflow-hidden font-['Plus_Jakarta_Sans']">
    <!-- Abstract Background Decor -->
    <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-orange-500/5 via-transparent to-transparent -z-10"></div>
    <div class="absolute -top-48 -right-48 w-[600px] h-[600px] bg-orange-500/10 rounded-full blur-[150px] animate-pulse -z-10"></div>
    <div class="absolute -bottom-48 -left-48 w-[600px] h-[600px] bg-blue-500/5 rounded-full blur-[150px] animate-pulse -z-10"></div>

    <!-- Left Side: Visual/Marketing (Desktop Only) -->
    <div class="hidden lg:flex lg:w-1/2 relative flex-col justify-center px-20 overflow-hidden border-r border-white/5">
        <div class="relative z-10">
            <div class="flex items-center gap-4 mb-12" data-aos="fade-right">
                <div class="w-16 h-16 bg-orange-500 rounded-2xl flex items-center justify-center shadow-[0_0_40px_rgba(249,115,22,0.4)] ring-1 ring-white/20">
                    <span class="font-black text-3xl text-white">M</span>
                </div>
                <div class="flex flex-col">
                    <span class="text-4xl font-black tracking-tighter text-white">MALHA<span class="text-orange-500">3D</span></span>
                    <span class="text-[10px] font-black text-gray-500 uppercase tracking-[0.4em] -mt-1">Neural Dashboard</span>
                </div>
            </div>

            <h1 class="text-6xl font-black text-white leading-tight mb-8" data-aos="fade-up" data-aos-delay="200">
                Seu estúdio, <br>
                <span class="text-gradient">sem limites.</span>
            </h1>
            
            <p class="text-xl text-gray-400 font-medium max-w-lg leading-relaxed mb-12" data-aos="fade-up" data-aos-delay="400">
                Junte-se à revolução da arquitetura digital. Gerencie projetos, encante clientes e escale seu negócio com a tecnologia Malha3D.
            </p>

            <div class="grid grid-cols-2 gap-8" data-aos="fade-up" data-aos-delay="600">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-orange-500">speed</span>
                    </div>
                    <div>
                        <p class="text-white font-bold text-sm">Alta Performance</p>
                        <p class="text-gray-500 text-xs">Gestão 300% mais rápida</p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-blue-500">cloud</span>
                    </div>
                    <div>
                        <p class="text-white font-bold text-sm">Nuvem Integrada</p>
                        <p class="text-gray-500 text-xs">Acesse de qualquer lugar</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Decorative Element -->
        <div class="absolute bottom-0 right-0 w-[800px] h-[800px] opacity-20 pointer-events-none grayscale translate-x-1/4 translate-y-1/4">
            <spline-viewer url="https://prod.spline.design/6Wq1Q7nS4Z8dz2S9/scene.splinecode" style="width: 100%; height: 100%;"></spline-viewer>
        </div>
    </div>

    <!-- Right Side: Registration Form -->
    <div class="flex-1 flex flex-col justify-center py-12 px-6 lg:px-24 relative z-10">
        <div class="sm:mx-auto sm:w-full sm:max-w-md lg:mx-0 lg:max-w-xl w-full">
            <!-- Mobile Logo -->
            <div class="flex justify-center mb-10 lg:hidden">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 bg-orange-500 rounded-2xl flex items-center justify-center shadow-[0_0_40px_rgba(249,115,22,0.4)] ring-1 ring-white/20">
                        <span class="font-black text-2xl text-white">M</span>
                    </div>
                </div>
            </div>

            <div class="text-left mb-10">
                <h2 class="text-3xl font-black text-white tracking-tight">Criar Identidade Digital</h2>
                <p class="mt-2 text-sm text-gray-500 font-medium tracking-wide">
                    Preencha os dados abaixo para iniciar sua jornada no ecossistema.
                </p>
            </div>

            <!-- Social Registration -->
            <div class="grid grid-cols-3 gap-4 mb-10">
                <button class="flex items-center justify-center py-4 bg-white/[0.03] border border-white/5 rounded-2xl hover:bg-white/[0.08] hover:border-white/10 transition-all group">
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-6 h-6 group-hover:scale-110 transition-transform" alt="Google">
                </button>
                <button class="flex items-center justify-center py-4 bg-white/[0.03] border border-white/5 rounded-2xl hover:bg-white/[0.08] hover:border-white/10 transition-all group">
                    <img src="https://www.svgrepo.com/show/511330/apple-173.svg" class="w-6 h-6 invert group-hover:scale-110 transition-transform" alt="Apple">
                </button>
                <button class="flex items-center justify-center py-4 bg-white/[0.03] border border-white/5 rounded-2xl hover:bg-white/[0.08] hover:border-white/10 transition-all group">
                    <img src="https://www.svgrepo.com/show/475647/facebook-color.svg" class="w-6 h-6 group-hover:scale-110 transition-transform" alt="Facebook">
                </button>
            </div>

            <div class="relative mb-10">
                <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-white/5"></div></div>
                <div class="relative flex justify-center text-xs uppercase tracking-[0.4em] font-black">
                    <span class="px-4 bg-[#0a0a0a] text-gray-600">Ou use seu e-mail</span>
                </div>
            </div>

            <div class="glass-card p-1 lg:p-0 border-transparent bg-transparent lg:shadow-none backdrop-blur-none relative">
                {{#if error}}
                <div class="mb-6 p-4 bg-red-500/10 border border-red-500/20 rounded-2xl flex items-center gap-4 animate-shake">
                    <div class="w-10 h-10 rounded-xl bg-red-500/20 flex items-center justify-center flex-shrink-0 text-red-500">
                        <span class="material-symbols-outlined">security</span>
                    </div>
                    <p class="text-xs font-bold text-red-400">{{error}}</p>
                </div>
                {{/if}}
                <form class="space-y-6" action="/admin/register" method="POST" id="registerForm">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div class="space-y-3">
                            <label for="firstName" class="text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-1">Primeiro Nome</label>
                            <div class="relative group">
                                <input id="firstName" name="firstName" type="text" required 
                                    class="input-premium block w-full px-5 py-3 bg-white/[0.03] border border-white/5 text-white text-sm font-bold rounded-xl focus:ring-4 focus:ring-orange-500/10 focus:border-orange-500/50 focus:bg-white/[0.05] transition-all outline-none"
                                    placeholder="Ex: Leonardo">
                            </div>
                        </div>
                        <div class="space-y-3">
                            <label for="lastName" class="text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-1">Sobrenome</label>
                            <div class="relative group">
                                <input id="lastName" name="lastName" type="text" required 
                                    class="input-premium block w-full px-5 py-3 bg-white/[0.03] border border-white/5 text-white text-sm font-bold rounded-xl focus:ring-4 focus:ring-orange-500/10 focus:border-orange-500/50 focus:bg-white/[0.05] transition-all outline-none"
                                    placeholder="Ex: Silva">
                            </div>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <label for="email" class="text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-1">E-mail Corporativo</label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                                <span class="material-symbols-outlined text-gray-600 group-focus-within:text-orange-500 transition-colors text-lg">alternate_email</span>
                            </div>
                            <input id="email" name="email" type="email" required 
                                class="input-premium block w-full pl-14 pr-5 py-3 bg-white/[0.03] border border-white/5 text-white text-sm font-bold rounded-xl focus:ring-4 focus:ring-orange-500/10 focus:border-orange-500/50 focus:bg-white/[0.05] transition-all outline-none"
                                placeholder="voce@empresa.com">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div class="space-y-3">
                            <label for="password" class="text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-1">Criar Senha</label>
                            <div class="relative group">
                                <input id="password" name="password" type="password" required 
                                    class="input-premium block w-full px-5 py-3 bg-white/[0.03] border border-white/5 text-white text-sm font-bold rounded-xl focus:ring-4 focus:ring-orange-500/10 focus:border-orange-500/50 focus:bg-white/[0.05] transition-all outline-none"
                                    placeholder="••••••••">
                            </div>
                        </div>
                        <div class="space-y-3">
                            <label for="confirmPassword" class="text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-1">Repetir Senha</label>
                            <div class="relative group">
                                <input id="confirmPassword" name="confirmPassword" type="password" required 
                                    class="input-premium block w-full px-5 py-3 bg-white/[0.03] border border-white/5 text-white text-sm font-bold rounded-xl focus:ring-4 focus:ring-orange-500/10 focus:border-orange-500/50 focus:bg-white/[0.05] transition-all outline-none"
                                    placeholder="••••••••">
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 py-2">
                        <input id="terms" name="terms" type="checkbox" required 
                            class="h-5 w-5 bg-white/5 border-white/10 text-orange-500 focus:ring-orange-500/20 rounded-lg transition-all cursor-pointer">
                        <label for="terms" class="text-[10px] font-black text-gray-500 uppercase tracking-widest cursor-pointer leading-tight">
                            Aceito os <a href="#" class="text-orange-500 hover:underline">termos de uso</a> e política de privacidade.
                        </label>
                    </div>

                    <div class="pt-4">
                        <button type="submit" id="submitBtn" class="w-full flex justify-center items-center py-4 px-6 border border-transparent rounded-xl shadow-2xl shadow-orange-500/40 text-sm font-black text-white bg-orange-500 hover:bg-orange-600 focus:outline-none focus:ring-4 focus:ring-orange-500/20 transition-all transform active:scale-[0.98] group">
                            <span id="btnText" class="flex items-center gap-3 tracking-[0.2em] uppercase">
                                Criar Minha Conta
                                <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">rocket_launch</span>
                            </span>
                            <div id="btnLoader" class="hidden">
                                <svg class="animate-spin h-6 w-6 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            </div>
                        </button>
                    </div>
                </form>

                <div class="mt-10 text-center">
                    <p class="text-[10px] font-black text-gray-600 uppercase tracking-widest">Já possui uma identidade?</p>
                    <a href="/admin/login" class="mt-4 text-xs font-black text-white hover:text-orange-500 transition-colors uppercase tracking-[0.2em] flex items-center justify-center gap-2 group">
                        Acessar Portal Existente
                        <span class="material-symbols-outlined text-sm group-hover:-translate-x-1 transition-transform">login</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gradient {
        background: linear-gradient(to right, #f97316, #fb923c, #f97316);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-size: 200% auto;
        animation: gradient 3s linear infinite;
    }

    @keyframes gradient {
        0% { background-position: 0% center; }
        100% { background-position: 200% center; }
    }

    .input-premium:focus {
        box-shadow: 0 0 20px rgba(249, 115, 22, 0.1);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('registerForm');
        const submitBtn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const btnLoader = document.getElementById('btnLoader');
        const password = document.getElementById('password');
        const confirmPassword = document.getElementById('confirmPassword');

        form.addEventListener('submit', (e) => {
            if (password.value !== confirmPassword.value) {
                e.preventDefault();
                alert('As senhas não coincidem!');
                return;
            }

            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-70');
            btnText.classList.add('hidden');
            btnLoader.classList.remove('hidden');
        });
    });
</script>
