<!-- Header -->
<div class="mb-6 p-6 glass-card border-none bg-gradient-to-br from-white/5 to-white/[0.02]">
 <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
 <div>
 <h1 class="text-2xl font-black text-white tracking-tight mb-1">
 Gestão de <span class="text-gradient">Depoimentos</span>
 </h1>
 <p class="text-xs text-gray-400 font-medium">
 Gerencie avaliações e feedbacks dos clientes <span class="text-orange-500">Malha3D</span>.
 </p>
 </div>
 <button class="bg-orange-500 hover:bg-orange-600 text-white text-xs font-black py-3 px-5 rounded-xl shadow-lg shadow-orange-500/40 transition-all flex items-center gap-2" data-bs-toggle="modal" data-bs-target="#newTestimonialModal">
 <span class="material-symbols-outlined text-lg">add_circle</span>
 Novo Depoimento
 </button>
 </div>
</div>

<!-- Stats -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
 <div class="glass-card p-5 border-white/5 text-center group">
 <div class="w-10 h-10 mx-auto bg-blue-500/10 rounded-xl flex items-center justify-center text-blue-500 mb-2 border border-blue-500/20 group- transition-transform">
 <span class="material-symbols-outlined text-lg">forum</span>
 </div>
 <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-0.5">Total</p>
 <h2 class="text-2xl font-black text-white">{{stats.total}}</h2>
 </div>
 <div class="glass-card p-5 border-white/5 text-center group">
 <div class="w-10 h-10 mx-auto bg-emerald-500/10 rounded-xl flex items-center justify-center text-emerald-500 mb-2 border border-emerald-500/20 group- transition-transform">
 <span class="material-symbols-outlined text-lg">check_circle</span>
 </div>
 <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-0.5">Ativos</p>
 <h2 class="text-2xl font-black text-white">{{stats.active}}</h2>
 </div>
 <div class="glass-card p-5 border-white/5 text-center group">
 <div class="w-10 h-10 mx-auto bg-yellow-500/10 rounded-xl flex items-center justify-center text-yellow-500 mb-2 border border-yellow-500/20 group- transition-transform">
 <span class="material-symbols-outlined text-lg">star</span>
 </div>
 <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-0.5">Média</p>
 <h2 class="text-2xl font-black text-white">{{stats.avgRating}}</h2>
 </div>
 <div class="glass-card p-5 border-white/5 text-center group">
 <div class="w-10 h-10 mx-auto bg-purple-500/10 rounded-xl flex items-center justify-center text-purple-500 mb-2 border border-purple-500/20 group- transition-transform">
 <span class="material-symbols-outlined text-lg">trending_up</span>
 </div>
 <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-0.5">Este Mês</p>
 <h2 class="text-2xl font-black text-white">{{stats.recent}}</h2>
 </div>
</div>

<!-- Table -->
<div class="glass-card border-white/5 overflow-hidden rounded-xl">
 <div class="p-5 border-b border-white/5 flex items-center justify-between bg-white/[0.01]">
 <h3 class="text-base font-black text-white tracking-tight flex items-center gap-2">
 <span class="material-symbols-outlined text-orange-500 text-lg">format_quote</span>
 Lista de Depoimentos
 </h3>
 </div>
 <div class="overflow-x-auto">
 <table class="w-full text-left">
 <thead>
 <tr class="bg-white/[0.02]">
 <th class="px-5 py-4" width="40"><input type="checkbox" id="selectAll" onchange="toggleSelectAll()" class="w-3 h-3 rounded"></th>
 <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-[0.2em]">Cliente</th>
 <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-[0.2em]">Depoimento</th>
 <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-[0.2em]">Avaliação</th>
 <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-[0.2em]">Status</th>
 <th class="px-5 py-4 text-[9px] font-black text-gray-500 uppercase tracking-[0.2em] text-right">Ações</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-white/5">
 {{#each testimonials}}
 <tr class="hover:bg-white/[0.03] transition-colors group">
 <td class="px-5 py-4"><input type="checkbox" class="testimonial-checkbox w-3 h-3 rounded" value="{{this.id}}"></td>
 <td class="px-4 py-4">
 <div class="flex items-center gap-2">
 <div class="w-8 h-8 rounded-lg bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-500 font-black text-[10px]">
 {{firstLetter this.name}}
 </div>
 <div>
 <p class="text-xs font-black text-white">{{this.name}}</p>
 <p class="text-[8px] text-gray-500 font-bold uppercase tracking-widest">{{this.company}}</p>
 </div>
 </div>
 </td>
 <td class="px-4 py-4"><p class="text-[10px] text-gray-400 max-w-[250px] truncate">"{{truncate this.content 80}}"</p></td>
 <td class="px-4 py-4">
 <span class="text-[10px] font-black text-yellow-500">{{this.rating}}/5 ★</span>
 </td>
 <td class="px-4 py-4">
 {{#if this.isActive}}
 <span class="text-[8px] font-black text-emerald-500 bg-emerald-500/10 px-2 py-1 rounded-full uppercase tracking-widest ring-1 ring-emerald-500/30">Ativo</span>
 {{else}}
 <span class="text-[8px] font-black text-gray-500 bg-white/5 px-2 py-1 rounded-full uppercase tracking-widest">Inativo</span>
 {{/if}}
 </td>
 <td class="px-5 py-4 text-right">
 <div class="flex items-center justify-end gap-1 opacity-30 group-hover:opacity-100 transition-opacity">
 <button onclick="viewTestimonial({{this.id}})" class="p-1.5 rounded-lg bg-white/5 text-gray-400 hover:text-white transition-all">
 <span class="material-symbols-outlined text-base">visibility</span>
 </button>
 <a href="/admin/depoimentos/{{this.id}}/editar" class="p-1.5 rounded-lg bg-white/5 text-gray-400 hover:text-orange-500 transition-all">
 <span class="material-symbols-outlined text-base">edit</span>
 </a>
 <button onclick="deleteTestimonial({{this.id}})" class="p-1.5 rounded-lg bg-white/5 text-gray-400 hover:text-red-500 transition-all">
 <span class="material-symbols-outlined text-base">delete</span>
 </button>
 </div>
 </td>
 </tr>
 {{/each}}
 </tbody>
 </table>
 </div>
 {{#if pagination.pages}}
 <div class="p-5 bg-white/[0.01] border-t border-white/5">
 <nav class="flex justify-center">
 <ul class="flex items-center gap-1.5">
 {{#if pagination.hasPrev}}
 <li><a href="?page={{pagination.prevPage}}&{{buildQueryString}}" class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/5 text-gray-400 hover:text-white hover:bg-orange-500 transition-all"><span class="material-symbols-outlined text-sm">chevron_left</span></a></li>
 {{/if}}
 {{#each pagination.pages}}
 <li><a href="?page={{this.number}}&{{buildQueryString}}" class="w-8 h-8 flex items-center justify-center rounded-lg font-black text-[10px] {{#if this.active}}bg-orange-500 text-white shadow-lg shadow-orange-500/30{{else}}bg-white/5 text-gray-500 hover:text-white{{/if}} transition-all">{{this.number}}</a></li>
 {{/each}}
 {{#if pagination.hasNext}}
 <li><a href="?page={{pagination.nextPage}}&{{buildQueryString}}" class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/5 text-gray-400 hover:text-white hover:bg-orange-500 transition-all"><span class="material-symbols-outlined text-sm">chevron_right</span></a></li>
 {{/if}}
 </ul>
 </nav>
 </div>
 {{/if}}
</div>

<!-- View Testimonial Modal -->
<div class="modal fade" id="testimonialModal" tabindex="-1">
 <div class="modal-dialog modal-dialog-centered modal-lg">
 <div class="modal-content glass-card border-white/10 bg-[#0f0f0f]/95 backdrop-blur-2xl">
 <div class="modal-header border-white/5 p-6">
 <h5 class="text-lg font-black text-white flex items-center gap-2"><span class="material-symbols-outlined text-orange-500">format_quote</span> Visualizar Depoimento</h5>
 <button type="button" class="btn-close btn-close-white opacity-50 hover:opacity-100" data-bs-dismiss="modal"></button>
 </div>
 <div class="modal-body p-6" id="testimonialModalBody"></div>
 <div class="modal-footer border-white/5 p-4">
 <button type="button" class="px-4 py-2 text-xs font-black text-gray-500 uppercase tracking-widest hover:text-white transition-all" data-bs-dismiss="modal">Fechar</button>
 <a href="#" class="bg-orange-500 hover:bg-orange-600 text-white font-black py-2 px-6 rounded-xl text-xs transition-all" id="editTestimonialLink">Editar</a>
 </div>
 </div>
 </div>
</div>

<!-- New Testimonial Modal -->
<div class="modal fade" id="newTestimonialModal" tabindex="-1" aria-hidden="true">
 <div class="modal-dialog modal-dialog-centered modal-lg">
 <div class="modal-content glass-card border-white/10 bg-[#0f0f0f]/95 backdrop-blur-2xl">
 <div class="modal-header border-white/5 p-6">
 <h5 class="text-lg font-black text-white tracking-tight flex items-center gap-3">
 <span class="material-symbols-outlined text-orange-500">rate_review</span>
 Novo Depoimento
 </h5>
 <button type="button" class="btn-close btn-close-white opacity-50 hover:opacity-100 transition-opacity" data-bs-dismiss="modal"></button>
 </div>
 <form id="newTestimonialForm">
 <div class="modal-body p-6 space-y-4">
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
 <div class="space-y-1.5">
 <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Nome do Cliente *</label>
 <input type="text" name="name" required class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="Ex: João Silva">
 </div>
 <div class="space-y-1.5">
 <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Empresa</label>
 <input type="text" name="company" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="Nome da empresa">
 </div>
 </div>
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
 <div class="space-y-1.5">
 <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Cargo</label>
 <input type="text" name="role" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="Ex: Arquiteto">
 </div>
 <div class="space-y-1.5">
 <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Avaliação *</label>
 <select name="rating" required class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
 <option value="5" class="bg-[#0f0f0f]">★★★★★ (5)</option>
 <option value="4" class="bg-[#0f0f0f]">★★★★☆ (4)</option>
 <option value="3" class="bg-[#0f0f0f]">★★★☆☆ (3)</option>
 <option value="2" class="bg-[#0f0f0f]">★★☆☆☆ (2)</option>
 <option value="1" class="bg-[#0f0f0f]">★☆☆☆☆ (1)</option>
 </select>
 </div>
 </div>
 <div class="space-y-1.5">
 <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Depoimento *</label>
 <textarea name="content" rows="4" required class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all resize-none" placeholder="O que o cliente disse sobre o trabalho..."></textarea>
 </div>
 <label class="flex items-center gap-2 cursor-pointer group">
 <input type="checkbox" name="isActive" checked class="w-4 h-4 rounded bg-white/5 border-white/20 text-orange-500 focus:ring-orange-500/50">
 <span class="text-xs font-bold text-gray-400 group-hover:text-white transition-colors">Publicar imediatamente</span>
 </label>
 </div>
 <div class="modal-footer border-white/5 p-6">
 <button type="button" class="px-6 py-3 text-xs font-black text-gray-500 uppercase tracking-widest hover:text-white transition-all" data-bs-dismiss="modal">Cancelar</button>
 <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white font-black py-3 px-8 rounded-xl shadow-lg shadow-orange-500/20 transition-all flex items-center gap-2">
 <span class="material-symbols-outlined text-sm">publish</span>
 Publicar
 </button>
 </div>
 </form>
 </div>
 </div>
</div>

<script>
function toggleSelectAll() {
 const s = document.getElementById('selectAll');
 document.querySelectorAll('.testimonial-checkbox').forEach(c => c.checked = s.checked);
}

async function viewTestimonial(id) {
 try {
 const r = await fetch(`/admin/api/depoimentos/${id}`);
 const d = await r.json();
 if (d.success) {
 const t = d.data;
 document.getElementById('testimonialModalBody').innerHTML = `
 <div class="flex gap-6">
 <div class="w-16 h-16 rounded-2xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-500 font-black text-xl shrink-0">${t.name?.charAt(0) || '?'}</div>
 <div class="flex-1">
 <h4 class="text-lg font-black text-white mb-0.5">${t.name}</h4>
 <p class="text-xs text-gray-500 mb-4">${t.role || ''} ${t.company ? '· ' + t.company : ''}</p>
 <p class="text-yellow-500 text-sm mb-4">${'★'.repeat(t.rating)}${'☆'.repeat(5-t.rating)}</p>
 <blockquote class="text-sm text-gray-300 italic border-l-2 border-orange-500/50 pl-4">"${t.content}"</blockquote>
 </div>
 </div>`;
 document.getElementById('editTestimonialLink').href = `/admin/depoimentos/${id}/editar`;
 new bootstrap.Modal(document.getElementById('testimonialModal')).show();
 }
 } catch (e) { console.error(e); alert('Erro ao carregar depoimento'); }
}

async function deleteTestimonial(id) {
 if (!confirm('Excluir este depoimento?')) return;
 try {
 const r = await fetch(`/admin/depoimentos/${id}`, { method: 'DELETE' });
 const d = await r.json();
 if (d.success) location.reload();
 else alert('Erro: ' + d.message);
 } catch (e) { console.error(e); alert('Erro ao excluir'); }
}

document.getElementById('newTestimonialForm')?.addEventListener('submit', async function(e) {
 e.preventDefault();
 const formData = new FormData(this);
 const data = Object.fromEntries(formData.entries());
 data.isActive = formData.has('isActive');
 
 try {
 const r = await fetch('/admin/api/depoimentos', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify(data)
 });
 const result = await r.json();
 if (result.success) window.location.reload();
 else alert('Erro: ' + result.message);
 } catch (e) { console.error(e); alert('Erro ao criar depoimento'); }
});
</script>
