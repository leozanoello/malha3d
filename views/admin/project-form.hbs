<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-images"></i> {{#if isEdit}}Editar Projeto{{else}}Novo Projeto{{/if}}
        </h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/admin/projetos">Projetos</a></li>
                <li class="breadcrumb-item active">{{#if isEdit}}Editar{{else}}Criar{{/if}}</li>
            </ol>
        </nav>
    </div>
    <div class="page-actions">
        <a href="/admin/projetos" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Voltar
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-info-circle"></i> Informações do Projeto
                </h5>
            </div>
            <div class="card-body">
                <form id="projectForm" enctype="multipart/form-data">
                    <input type="hidden" name="id" value="{{project.id}}">
                    
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label for="title" class="form-label">
                                    Título do Projeto <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control" id="title" name="title" 
                                       value="{{project.title}}" required>
                                <div class="invalid-feedback">Por favor, insira o título do projeto</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="order" class="form-label">
                                    Ordem de Exibição <span class="text-danger">*</span>
                                </label>
                                <input type="number" class="form-control" id="order" name="order" 
                                       value="{{#if project.order}}{{project.order}}{{else}}0{{/if}}" required>
                                <div class="invalid-feedback">Por favor, insira a ordem de exibição</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="category" class="form-label">
                                    Categoria <span class="text-danger">*</span>
                                </label>
                                <select class="form-select" id="category" name="category" required>
                                    <option value="">Selecione uma categoria</option>
                                    <option value="3d" {{#eq project.category "3d"}}selected{{/eq}}>Modelagem 3D</option>
                                    <option value="ArchViz" {{#eq project.category "ArchViz"}}selected{{/eq}}>ArchViz</option>
                                    <option value="Modelagem" {{#eq project.category "Modelagem"}}selected{{/eq}}>Modelagem</option>
                                    <option value="Renderização" {{#eq project.category "Renderização"}}selected{{/eq}}>Renderização</option>
                                    <option value="interior" {{#eq project.category "interior"}}selected{{/eq}}>Interior</option>
                                    <option value="exterior" {{#eq project.category "exterior"}}selected{{/eq}}>Exterior</option>
                                    <option value="produto" {{#eq project.category "produto"}}selected{{/eq}}>Produto</option>
                                    <option value="arquitetonico" {{#eq project.category "arquitetonico"}}selected{{/eq}}>Arquitetônico</option>
                                    <option value="animacao" {{#eq project.category "animacao"}}selected{{/eq}}>Animação</option>
                                    <option value="outro" {{#eq project.category "outro"}}selected{{/eq}}>Outro</option>
                                </select>
                                <div class="invalid-feedback">Por favor, selecione uma categoria</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="year" class="form-label">Ano</label>
                                <input type="number" class="form-control" id="year" name="year" 
                                       value="{{project.year}}" min="2000" max="2030">
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="client" class="form-label">Cliente</label>
                                <div class="input-group">
                                    <select class="form-select select2" id="client" name="client">
                                        <option value="">Selecione o cliente...</option>
                                        {{#if project.client}}
                                            <option value="{{project.client}}" selected>{{project.client}}</option>
                                        {{/if}}
                                        <!-- Clientes serão injetados aqui via JS -->
                                    </select>
                                    <button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#newClientModal" title="Adicionar Cliente">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="tags" class="form-label">Tags</label>
                                <input type="text" class="form-control" id="tags" name="tags" 
                                       value="{{project.tags}}" placeholder="Ex: 3D, render, produto, arquitetura">
                                <small class="form-text text-muted">Separe as tags por vírgula</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="description" class="form-label">Descrição Detalhada</label>
                        <textarea class="form-control" id="description" name="description" 
                                  rows="4" placeholder="Descreva o projeto em detalhes...">{{project.description}}</textarea>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="image" class="form-label">
                                    Imagem Principal
                                    {{#if project.image}}
                                    <small class="text-muted">(Deixe em branco para manter atual)</small>
                                    {{/if}}
                                </label>
                                <input type="file" class="form-control" id="image" name="image" 
                                       accept="image/*" onchange="previewImage(this, 'imagePreview')">
                                <small class="form-text text-muted">
                                    Tamanho recomendado: 1200x800px, máximo 5MB
                                </small>
                                <div class="invalid-feedback">Por favor, selecione uma imagem válida</div>
                            </div>
                            <div id="imagePreview" class="preview-container">
                                {{#if project.image}}
                                <img src="{{project.image}}" alt="Imagem atual" class="img-thumbnail">
                                {{/if}}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="thumbnail" class="form-label">
                                    Miniatura
                                    {{#if project.thumbnail}}
                                    <small class="text-muted">(Deixe em branco para manter atual)</small>
                                    {{/if}}
                                </label>
                                <input type="file" class="form-control" id="thumbnail" name="thumbnail" 
                                       accept="image/*" onchange="previewImage(this, 'thumbnailPreview')">
                                <small class="form-text text-muted">
                                    Tamanho recomendado: 400x300px, máximo 2MB
                                </small>
                            </div>
                            <div id="thumbnailPreview" class="preview-container">
                                {{#if project.thumbnail}}
                                <img src="{{project.thumbnail}}" alt="Miniatura atual" class="img-thumbnail">
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        
        <!-- Additional Images -->
        <div class="card mt-3">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-images"></i> Imagens Adicionais
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="additionalImages" class="form-label">Adicionar Imagens</label>
                    <input type="file" class="form-control" id="additionalImages" name="additionalImages[]" 
                           accept="image/*" multiple onchange="previewMultipleImages(this)">
                    <small class="form-text text-muted">
                        Você pode selecionar várias imagens de uma vez. Máximo 10MB por imagem.
                    </small>
                </div>
                
                <div id="additionalImagesPreview" class="row g-2">
                    <!-- Existing additional images will be loaded here -->
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-cog"></i> Configurações
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="isActive" name="isActive" 
                               {{#if project.isActive}}checked{{/if}}>
                        <label class="form-check-label" for="isActive">
                            <i class="fas fa-eye"></i> Projeto Ativo
                        </label>
                    </div>
                    <small class="form-text text-muted">
                        Projetos inativos não aparecem na galeria
                    </small>
                </div>
                
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="isFeatured" name="isFeatured" 
                               {{#if project.isFeatured}}checked{{/if}}>
                        <label class="form-check-label" for="isFeatured">
                            <i class="fas fa-star"></i> Projeto em Destaque
                        </label>
                    </div>
                    <small class="form-text text-muted">
                        Projetos em destaque aparecem primeiro
                    </small>
                </div>
                
                <div class="mb-3">
                    <label for="slug" class="form-label">Slug (URL)</label>
                    <input type="text" class="form-control" id="slug" name="slug" 
                           value="{{project.slug}}" placeholder="gerado-automaticamente">
                    <small class="form-text text-muted">
                        Deixe em branco para gerar automaticamente
                    </small>
                </div>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-palette"></i> Estilo Visual
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="colorScheme" class="form-label">Esquema de Cores</label>
                    <select class="form-select" id="colorScheme" name="colorScheme">
                        <option value="default" {{#eq project.colorScheme "default"}}selected{{/eq}}>Padrão</option>
                        <option value="dark" {{#eq project.colorScheme "dark"}}selected{{/eq}}>Escuro</option>
                        <option value="light" {{#eq project.colorScheme "light"}}selected{{/eq}}>Claro</option>
                        <option value="colorful" {{#eq project.colorScheme "colorful"}}selected{{/eq}}>Colorido</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label for="layout" class="form-label">Layout</label>
                    <select class="form-select" id="layout" name="layout">
                        <option value="standard" {{#eq project.layout "standard"}}selected{{/eq}}>Padrão</option>
                        <option value="wide" {{#eq project.layout "wide"}}selected{{/eq}}>Largo</option>
                        <option value="compact" {{#eq project.layout "compact"}}selected{{/eq}}>Compacto</option>
                    </select>
                </div>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-body">
                <button type="submit" form="projectForm" class="btn btn-primary w-100 mb-2">
                    <i class="fas fa-save"></i> {{#if isEdit}}Atualizar Projeto{{else}}Criar Projeto{{/if}}
                </button>
                
                {{#if isEdit}}
                <div class="d-grid gap-2">
                    <a href="/admin/projetos/{{project.id}}" class="btn btn-outline-primary">
                        <i class="fas fa-eye"></i> Visualizar
                    </a>
                    <button type="button" class="btn btn-outline-danger" onclick="deleteProject({{project.id}})">
                        <i class="fas fa-trash"></i> Excluir
                    </button>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="newClientModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Novo Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="newClientForm">
                    <div class="mb-3">
                        <label class="form-label">Nome *</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">E-mail</label>
                        <input type="email" name="email" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Telefone</label>
                        <input type="text" name="phone" class="form-control">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" form="newClientForm" class="btn btn-primary">Salvar</button>
            </div>
        </div>
    </div>
</div>

<style>
.preview-container {
    margin-top: 1rem;
    text-align: center;
}

.preview-container img {
    max-width: 100%;
    max-height: 200px;
    object-fit: contain;
    border: 1px solid #dee2e6;
    border-radius: 0.25rem;
    padding: 0.25rem;
}

.additional-image-item {
    position: relative;
    display: inline-block;
    margin: 0.25rem;
}

.additional-image-item img {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 0.25rem;
}

.remove-image {
    position: absolute;
    top: -5px;
    right: -5px;
    background: #dc3545;
    color: white;
    border: none;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    font-size: 12px;
    cursor: pointer;
}

.form-check-input:checked {
    background-color: #0d6efd;
    border-color: #0d6efd;
}
</style>

<script>
// Load Clients into Select
async function loadClients() {
    try {
        const res = await fetch('/api/clients');
        if (!res.ok) return;
        const data = await res.json();
        const select = document.getElementById('client');
        const currentValue = select.value;
        
        // Preserve current selection logic (from handlebars render or current select)
        let html = '<option value="">Selecione o cliente...</option>';
        data.data.forEach(client => {
            const isSelected = currentValue === client.name ? 'selected' : '';
            html += `<option value="${client.name}" ${isSelected}>${client.name}</option>`;
        });
        select.innerHTML = html;
        if(currentValue && !data.data.find(c => c.name === currentValue)) {
            // Add custom client if it existed but wasn't in db
            select.innerHTML += `<option value="${currentValue}" selected>${currentValue}</option>`;
        }
    } catch(e) { console.error('Erro ao carregar clientes', e); }
}

// New Client Form Submission
document.getElementById('newClientForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = this.querySelector('button[type="submit"]');
    const originalText = btn.innerHTML;
    btn.innerHTML = 'Salvando...';
    btn.disabled = true;

    try {
        const formData = new FormData(this);
        const data = Object.fromEntries(formData.entries());
        // A rota atual para criar clientes no CRM pode ser /admin/api/clients ou /api/clients
        const res = await fetch('/api/clients', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(data)
        });
        const resData = await res.json();
        if(res.ok) {
            // Adiciona option
            const select = document.getElementById('client');
            const option = document.createElement('option');
            // resData comes directly as object from /api/clients POST
            const clientName = resData.name || data.name; 
            option.value = clientName;
            option.text = clientName;
            option.selected = true;
            select.appendChild(option);
            
            // Fecha modal
            const modalEl = document.getElementById('newClientModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if(modal) modal.hide();
            else { modalEl.classList.remove('show'); modalEl.style.display = 'none'; document.querySelector('.modal-backdrop')?.remove(); }
            
            this.reset();
        } else {
            alert(resData.message || 'Erro ao criar cliente');
        }
    } catch(e) {
        alert('Falha na comunicação');
    } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
});

document.addEventListener('DOMContentLoaded', loadClients);

// Preview image
function previewImage(input, previewId) {
    const preview = document.getElementById(previewId);
    
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        
        reader.onload = function(e) {
            preview.innerHTML = `<img src="${e.target.result}" alt="Preview">`;
        };
        
        reader.readAsDataURL(input.files[0]);
    }
}

// Preview multiple images
function previewMultipleImages(input) {
    const preview = document.getElementById('additionalImagesPreview');
    
    if (input.files) {
        Array.from(input.files).forEach((file, index) => {
            const reader = new FileReader();
            
            reader.onload = function(e) {
                const imageItem = document.createElement('div');
                imageItem.className = 'col-6 col-md-4 col-lg-3';
                imageItem.innerHTML = `
                    <div class="additional-image-item">
                        <img src="${e.target.result}" alt="Preview ${index + 1}">
                        <button type="button" class="remove-image" onclick="this.parentElement.parentElement.remove()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                `;
                preview.appendChild(imageItem);
            };
            
            reader.readAsDataURL(file);
        });
    }
}

// Auto-generate slug from title
document.getElementById('title').addEventListener('input', function() {
    const title = this.value;
    const slugInput = document.getElementById('slug');
    
    if (slugInput.value === '' || slugInput.value === slugInput.defaultValue) {
        const slug = title
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/[^\w\s-]/g, '')
            .replace(/\s+/g, '-')
            .replace(/-+/g, '-')
            .trim();
        
        slugInput.value = slug;
    }
});

// Form validation and submission
document.getElementById('projectForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    // Validate form
    if (!this.checkValidity()) {
        e.stopPropagation();
        this.classList.add('was-validated');
        return;
    }
    
    // Show loading
    const submitButton = e.target.querySelector('button[type="submit"]');
    const originalText = submitButton.innerHTML;
    submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Salvando...';
    submitButton.disabled = true;
    
    try {
        const formData = new FormData(this);
        
        // Add additional images
        const additionalImages = document.getElementById('additionalImages').files;
        if (additionalImages.length > 0) {
            Array.from(additionalImages).forEach((file, index) => {
                formData.append('additionalImages[]', file);
            });
        }
        
        // Add settings
        formData.append('isActive', document.getElementById('isActive').checked);
        formData.append('isFeatured', document.getElementById('isFeatured').checked);
        
        const url = '{{#if isEdit}}/admin/projetos/{{project.id}}/editar{{else}}/admin/projetos/criar{{/if}}';
        const method = '{{#if isEdit}}PUT{{else}}POST{{/if}}';
        
        const response = await fetch(url, {
            method: method,
            body: formData
        });
        
        const data = await response.json();
        
        if (data.success) {
            showNotification(data.message, 'success');
            
            if (!'{{isEdit}}') {
                // Redirect to edit page for new projects
                setTimeout(() => {
                    window.location.href = `/admin/projetos/${data.project.id}/editar`;
                }, 1500);
            } else {
                // Show success message for edits
                setTimeout(() => {
                    location.reload();
                }, 1500);
            }
        } else {
            showNotification(data.message, 'error');
            submitButton.innerHTML = originalText;
            submitButton.disabled = false;
        }
        
    } catch (error) {
        console.error('Error saving project:', error);
        showNotification('Erro ao salvar projeto', 'error');
        submitButton.innerHTML = originalText;
        submitButton.disabled = false;
    }
});

// Delete project
async function deleteProject(projectId) {
    if (!confirm('Tem certeza que deseja excluir este projeto? Esta ação não pode ser desfeita.')) {
        return;
    }
    
    try {
        const response = await fetch(`/admin/projetos/${projectId}`, {
            method: 'DELETE'
        });
        
        const data = await response.json();
        
        if (data.success) {
            showNotification(data.message, 'success');
            setTimeout(() => {
                window.location.href = '/admin/projetos';
            }, 1500);
        } else {
            showNotification(data.message, 'error');
        }
    } catch (error) {
        console.error('Error deleting project:', error);
        showNotification('Erro ao excluir projeto', 'error');
    }
}

// Load existing additional images
window.addEventListener('DOMContentLoaded', function() {
    {{#if project.additionalImages}}
    const additionalImages = {{{json project.additionalImages}}};
    const preview = document.getElementById('additionalImagesPreview');
    
    additionalImages.forEach((image, index) => {
        const imageItem = document.createElement('div');
        imageItem.className = 'col-6 col-md-4 col-lg-3';
        imageItem.innerHTML = `
            <div class="additional-image-item">
                <img src="${image.url}" alt="Imagem adicional ${index + 1}">
                <button type="button" class="remove-image" onclick="removeExistingImage('${image.id}', this)">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        `;
        preview.appendChild(imageItem);
    });
    {{/if}}
});

// Remove existing additional image
async function removeExistingImage(imageId, button) {
    if (!confirm('Deseja remover esta imagem?')) {
        return;
    }
    
    try {
        const response = await fetch(`/admin/projetos/imagem/${imageId}`, {
            method: 'DELETE'
        });
        
        const data = await response.json();
        
        if (data.success) {
            button.parentElement.parentElement.remove();
            showNotification('Imagem removida com sucesso!', 'success');
        } else {
            showNotification(data.message, 'error');
        }
    } catch (error) {
        console.error('Error removing image:', error);
        showNotification('Erro ao remover imagem', 'error');
    }
}
</script>
