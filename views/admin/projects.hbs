<div class="container-fluid py-4 h-screen flex flex-col overflow-hidden">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8 flex-shrink-0 px-4">
        <div class="flex flex-col gap-1">
            <h1 class="text-3xl font-black text-white tracking-tight">Projetos <span class="text-blue-500">Pipeline de Produção</span></h1>
            <div class="flex items-center gap-6 mt-4 border-b border-white/5 pb-2">
                <button class="project-page-tab active text-[10px] font-black uppercase tracking-[0.2em] text-blue-500 relative pb-2 group" data-tab="kanban">
                    Fluxo de Trabalho
                    <div class="absolute bottom-0 left-0 w-full h-0.5 bg-blue-500"></div>
                </button>
                <button class="project-page-tab text-[10px] font-black uppercase tracking-[0.2em] text-gray-500 hover:text-white transition-all pb-2 group relative" data-tab="list">
                    Lista de Ativos
                    <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-500 group-hover:w-full transition-all"></div>
                </button>
            </div>
        </div>
        <div class="flex items-center gap-4">
            <div class="glass-card px-4 py-2 border-white/5 flex items-center gap-3">
                <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Em Produção:</span>
                <span class="text-lg font-black text-white">{{length projects}}</span>
            </div>
            <button id="btn-new-project" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-3 rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-lg shadow-blue-500/20 transition-all flex items-center gap-2" data-bs-toggle="modal" data-bs-target="#newProjectModal">
                <span class="material-symbols-outlined text-sm">add_circle</span> Novo Projeto
            </button>
        </div>
    </div>

    <!-- View Containers -->
    <div id="kanban-view" class="flex-1 flex flex-col min-h-0">
        <!-- Kanban Board -->
        <div id="kanban-board" class="flex-1 flex gap-6 overflow-x-auto pb-6 scrollbar-hide select-none px-4">
            {{#each pipelineColumns}}
            <div class="kanban-column w-80 flex-shrink-0 flex flex-col h-full" data-status="{{this.key}}">
                <!-- Column Header -->
                <div class="glass-card mb-4 border-white/10 relative flex-shrink-0 min-h-[90px] flex flex-col justify-center" style="border-top: 4px solid {{this.color}}">
                    <div class="p-4 flex items-center justify-between">
                        <div class="overflow-hidden flex-1">
                            <h3 class="text-xs font-black text-white uppercase tracking-widest flex items-center justify-between gap-2 pr-2 whitespace-normal line-clamp-2 break-words">
                                {{this.title}}
                                <span class="bg-white/5 text-gray-500 px-2 py-0.5 rounded-full text-[8px] flex-shrink-0">{{length (lookup ../projectsKanban this.key)}}</span>
                            </h3>
                        </div>
                    </div>
                </div>

                <!-- Cards Container -->
                <div class="cards-list flex-1 overflow-y-auto space-y-3 px-3 mx-[-0.75rem] scrollbar-hide pb-10 drop-zone" data-status="{{this.key}}">
                    {{#each (lookup ../projectsKanban this.key)}}
                    <div class="kanban-card glass-card p-3 border-white/5 hover:border-blue-500/30 transition-all cursor-grab active:cursor-grabbing group relative hover:z-[999]" 
                         data-id="{{this.id}}" 
                         draggable="true"
                         onclick="openProjectDetails('{{this.id}}')">
                        
                        <!-- Progress Bar -->
                        <div class="absolute top-0 left-0 w-full h-1 bg-white/5">
                            <div class="h-full bg-blue-500 shadow-[0_0_8px_#3b82f6]" style="width: {{#if this.progress}}{{this.progress}}{{else}}10{{/if}}%;"></div>
                        </div>
                        
                        <div class="flex justify-between items-start mb-2 mt-1">
                            <h4 class="text-xs font-black text-white leading-tight pr-2 line-clamp-2 min-h-[28px]">{{this.title}}</h4>
                            <span class="text-[8px] font-black text-blue-500 bg-blue-500/5 px-2 py-0.5 rounded-full uppercase tracking-tighter">{{this.category}}</span>
                        </div>

                        <div class="flex flex-col gap-1 mb-2">
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-gray-600 text-[12px]">person</span>
                                <span class="text-[9px] font-bold text-gray-400 truncate uppercase">{{this.client}}</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-gray-600 text-[12px]">calendar_today</span>
                                <span class="text-[9px] font-bold text-gray-500">{{formatDateShort this.createdAt}}</span>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-2 border-t border-white/5 mt-2">
                            <div class="flex gap-1">
                                <span class="px-1.5 py-0.5 rounded bg-white/5 text-[7px] font-black text-gray-500 uppercase tracking-widest">{{this.renderEngine}}</span>
                                <span class="px-1.5 py-0.5 rounded bg-blue-500/5 text-[7px] font-black text-blue-500 uppercase tracking-widest">{{this.software}}</span>
                            </div>
                            <div class="flex items-center gap-1">
                                <span class="text-[8px] font-black text-gray-600 uppercase tracking-widest">R$ {{formatCurrency this.price}}</span>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                    
                    {{#unless (lookup ../projectsKanban this.key)}}
                    <div class="border-2 border-dashed border-white/5 rounded-3xl p-6 flex flex-col items-center justify-center text-center opacity-30 mt-2">
                        <span class="material-symbols-outlined text-2xl mb-1">move_to_inbox</span>
                        <p class="text-[9px] font-black uppercase tracking-widest">Sem Projetos</p>
                    </div>
                    {{/unless}}
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    <!-- List View -->
    <div id="list-view" class="flex-1 overflow-y-auto hidden pb-20 scrollbar-hide px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {{#each projects}}
            <div class="glass-card p-4 border-white/5 bg-white/2 hover:border-blue-500/30 transition-all group" onclick="openProjectDetails('{{this.id}}')">
                <div class="aspect-video rounded-xl bg-white/5 mb-4 overflow-hidden border border-white/5 relative">
                    {{#if image}}
                    <img src="{{image}}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                    {{else}}
                    <div class="w-full h-full flex items-center justify-center text-gray-800">
                        <span class="material-symbols-outlined text-4xl">image</span>
                    </div>
                    {{/if}}
                    <div class="absolute top-2 right-2 px-2 py-1 bg-black/60 backdrop-blur-md rounded-lg text-[8px] font-black text-white uppercase tracking-widest border border-white/10">
                        {{category}}
                    </div>
                </div>
                <h3 class="text-sm font-black text-white mb-1 truncate">{{title}}</h3>
                <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest mb-4">{{client}}</p>
                <div class="flex items-center justify-between">
                    <span class="text-[10px] font-black text-blue-500">R$ {{formatCurrency price}}</span>
                    <span class="text-[8px] font-black text-gray-600 uppercase">{{formatDateShort createdAt}}</span>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>

<!-- Modal: Project Details -->
<div id="projectDetailModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-sm flex p-4">
    <div class="glass-card w-full max-w-5xl h-[90vh] flex flex-col relative overflow-hidden">
        <button type="button" class="absolute top-6 right-6 text-gray-400 hover:text-white z-20" onclick="closeProjectDetails()">
            <span class="material-symbols-outlined">close</span>
        </button>

        <div class="flex h-full">
            <div class="w-64 border-r border-white/5 p-8 flex flex-col gap-1 flex-shrink-0">
                <div class="mb-8">
                    <h3 id="detailProjectTitle" class="text-xl font-black text-white uppercase tracking-tighter line-clamp-2">Carregando...</h3>
                    <p id="detailProjectClient" class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mt-1">CLIENTE</p>
                </div>
                
                <button class="detail-tab active w-full text-left px-4 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all mb-1 bg-blue-500 text-white" data-tab="specs">Especificações</button>
                <button class="detail-tab w-full text-left px-4 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all mb-1 text-gray-500 hover:bg-white/5 hover:text-white" data-tab="revisions">Revisões</button>
                <button class="detail-tab w-full text-left px-4 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all mb-1 text-gray-500 hover:bg-white/5 hover:text-white" data-tab="delivery">Entregas</button>
                <button class="detail-tab w-full text-left px-4 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all mb-1 text-gray-500 hover:bg-white/5 hover:text-white" data-tab="logs">Timeline / Logs</button>
                
                <div class="mt-auto pt-8">
                    <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
                        <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Status Atual</p>
                        <select id="detailProjectStatus" class="w-full bg-transparent text-[10px] font-black text-blue-500 uppercase outline-none cursor-pointer" onchange="updateProjectStatusDirectly()">
                            {{#each pipelineColumns}}
                            <option value="{{this.key}}" class="bg-dark-950">{{this.title}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
            </div>

            <div class="flex-1 flex flex-col min-w-0 bg-black/20">
                <div id="detail-pane-specs" class="detail-pane active p-8 overflow-y-auto h-full">
                    <h4 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-6">Especificações Técnicas</h4>
                    <div class="grid grid-cols-2 gap-8 mb-8">
                        <div class="space-y-4">
                            <div>
                                <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest block mb-1">Software de Modelagem</label>
                                <p id="detailSoftware" class="text-xs font-bold text-white uppercase">---</p>
                            </div>
                            <div>
                                <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest block mb-1">Motor de Renderização</label>
                                <p id="detailRenderEngine" class="text-xs font-bold text-white uppercase">---</p>
                            </div>
                        </div>
                        <div class="space-y-4">
                            <div>
                                <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest block mb-1">Metragem Aproximada</label>
                                <p id="detailArea" class="text-xs font-bold text-white uppercase">--- m²</p>
                            </div>
                            <div>
                                <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest block mb-1">Valor do Projeto</label>
                                <p id="detailPrice" class="text-xs font-bold text-blue-500 uppercase">R$ 0,00</p>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest block mb-2">Breve Descritivo / Briefing</label>
                        <div class="p-6 rounded-2xl bg-white/5 border border-white/5 text-xs text-gray-300 leading-relaxed italic" id="detailDescription">
                            Nenhuma descrição fornecida.
                        </div>
                    </div>
                </div>

                <div id="detail-pane-revisions" class="detail-pane hidden p-8 overflow-y-auto h-full">
                    <div class="flex items-center justify-between mb-8">
                        <h4 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em]">Fluxo de Revisões</h4>
                        <button class="px-4 py-2 bg-blue-500 text-white text-[9px] font-black uppercase tracking-widest rounded-lg">Nova Solicitação</button>
                    </div>
                    <div class="space-y-4" id="revisionsList">
                        <div class="p-6 rounded-2xl border border-white/5 bg-white/2 flex flex-col items-center justify-center opacity-30 h-48">
                            <span class="material-symbols-outlined text-3xl mb-2">history_edu</span>
                            <p class="text-[9px] font-black uppercase tracking-widest">Nenhuma revisão solicitada ainda</p>
                        </div>
                    </div>
                </div>

                <div id="detail-pane-delivery" class="detail-pane hidden p-8 overflow-y-auto h-full">
                    <h4 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-8">Entregáveis & Assets</h4>
                    <div class="grid grid-cols-2 gap-4" id="deliveryList">
                        <div class="col-span-2 p-12 border-2 border-dashed border-white/5 rounded-3xl flex flex-col items-center justify-center opacity-20">
                            <span class="material-symbols-outlined text-5xl mb-4 text-gray-700">cloud_upload</span>
                            <p class="text-[10px] font-black uppercase tracking-widest">Aguardando Envio de Render Final</p>
                        </div>
                    </div>
                </div>

                <div id="detail-pane-logs" class="detail-pane hidden p-8 overflow-y-auto h-full">
                    <h4 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-8">Timeline de Eventos</h4>
                    <div class="space-y-6 relative before:absolute before:left-3 before:top-2 before:bottom-2 before:w-[1px] before:bg-white/5" id="logsTimeline">
                        <div class="relative pl-10">
                            <div class="absolute left-0 top-1 w-6 h-6 rounded-lg bg-blue-500/20 border border-blue-500/30 flex items-center justify-center">
                                <span class="material-symbols-outlined text-blue-500 text-[10px]">auto_awesome</span>
                            </div>
                            <p class="text-[10px] font-black text-white uppercase tracking-widest mb-1">Projeto Inicializado</p>
                            <p class="text-[9px] text-gray-500 font-bold uppercase">Automated System • Hoje</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Novo Projeto -->
<div class="modal fade" id="newProjectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card p-4 border-white/10 bg-dark-950/95">
            <div class="flex justify-between items-center mb-8 px-4">
                <h3 class="text-xl font-black text-white uppercase tracking-tighter">Initialize <span class="text-blue-500">Project Workspace</span></h3>
                <button type="button" class="text-gray-500 hover:text-white" data-bs-dismiss="modal"><span class="material-symbols-outlined">close</span></button>
            </div>
            <form id="newProjectForm" class="p-4 space-y-8">
                <div class="grid grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Título do Projeto</label>
                        <input type="text" name="title" required class="input-premium" placeholder="Ex: Residência Alpha">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Categoria ArchViz</label>
                        <select name="category" class="input-premium">
                            <option value="interior">Interiores</option>
                            <option value="exterior">Exterior</option>
                            <option value="arquitetonico">Arquitetônico</option>
                            <option value="animacao">Animação</option>
                            <option value="produto">Produto</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-4">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Vincular Cliente</label>
                    <select name="clientId" class="input-premium" required>
                        <option value="">Selecione um cliente...</option>
                        {{#each clients}}
                        <option value="{{this.id}}">{{this.name}} ({{this.company}})</option>
                        {{/each}}
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Software Principal</label>
                        <input type="text" name="software" class="input-premium" placeholder="Ex: 3ds Max">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Motor de Render</label>
                        <input type="text" name="renderEngine" class="input-premium" placeholder="Ex: Corona">
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Briefing</label>
                    <textarea name="description" class="input-premium h-24" placeholder="Descreva os entregáveis..."></textarea>
                </div>

                <button type="submit" class="w-full py-4 rounded-2xl bg-blue-500 text-white font-black uppercase tracking-widest shadow-xl shadow-blue-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all">
                    Iniciar Produção
                </button>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // === PAGE TABS ===
    const pageTabs = document.querySelectorAll('.project-page-tab');
    pageTabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const target = tab.dataset.tab;
            pageTabs.forEach(t => t.classList.remove('active', 'text-blue-500'));
            pageTabs.forEach(t => t.querySelector('div')?.remove());
            
            tab.classList.add('active', 'text-blue-500');
            tab.innerHTML += '<div class="absolute bottom-0 left-0 w-full h-0.5 bg-blue-500"></div>';

            if (target === 'kanban') {
                document.getElementById('kanban-view').classList.remove('hidden');
                document.getElementById('list-view').classList.add('hidden');
            } else {
                document.getElementById('kanban-view').classList.add('hidden');
                document.getElementById('list-view').classList.remove('hidden');
            }
        });
    });

    // === DETAIL MODAL TABS ===
    const detailTabs = document.querySelectorAll('.detail-tab');
    detailTabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const target = tab.dataset.tab;
            detailTabs.forEach(t => {
                t.classList.remove('active', 'bg-blue-500', 'text-white');
                t.classList.add('text-gray-500');
            });
            tab.classList.add('active', 'bg-blue-500', 'text-white');
            tab.classList.remove('text-gray-500');

            document.querySelectorAll('.detail-pane').forEach(p => p.classList.add('hidden'));
            document.getElementById(`detail-pane-${target}`).classList.remove('hidden');
        });
    });

    // === DRAG & DROP ===
    const cards = document.querySelectorAll('.kanban-card');
    const dropZones = document.querySelectorAll('.drop-zone');

    cards.forEach(card => {
        card.addEventListener('dragstart', (event) => {
            card.classList.add('opacity-40');
            event.dataTransfer.setData('projectId', card.dataset.id);
        });
        card.addEventListener('dragend', () => {
            card.classList.remove('opacity-40');
        });
    });

    dropZones.forEach(zone => {
        zone.addEventListener('dragover', e => {
            e.preventDefault();
            zone.classList.add('bg-blue-500/5');
        });
        zone.addEventListener('dragleave', () => {
            zone.classList.remove('bg-blue-500/5');
        });
        zone.addEventListener('drop', async e => {
            e.preventDefault();
            zone.classList.remove('bg-blue-500/5');
            const projectId = e.dataTransfer.getData('projectId');
            const newStatus = zone.dataset.status;
            const card = document.querySelector(`[data-id="${projectId}"]`);
            
            if (card) {
                zone.appendChild(card);
                // Update API
                try {
                    await fetch('/admin/api/projects/move', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ projectId, statusId: newStatus })
                    });
                } catch (err) { window.location.reload(); }
            }
        });
    });
});

let currentProjectId = null;

async function openProjectDetails(id) {
    currentProjectId = id;
    const modal = document.getElementById('projectDetailModal');
    modal.classList.remove('hidden');
    
    try {
        const res = await fetch(`/admin/api/projects/${id}`);
        const project = await res.json();
        
        document.getElementById('detailProjectTitle').innerText = project.title;
        document.getElementById('detailProjectClient').innerText = project.client?.name || 'Cliente Externo';
        document.getElementById('detailSoftware').innerText = project.software || 'N/A';
        document.getElementById('detailRenderEngine').innerText = project.renderEngine || 'N/A';
        document.getElementById('detailArea').innerText = project.area || '---';
        document.getElementById('detailPrice').innerText = 'R$ ' + (project.price ? project.price.toLocaleString() : '0,00');
        document.getElementById('detailDescription').innerText = project.description || 'Nenhuma descrição.';
        document.getElementById('detailProjectStatus').value = project.status;
        
    } catch (err) {
        console.error(err);
    }
}

function closeProjectDetails() {
    document.getElementById('projectDetailModal').classList.add('hidden');
}

async function updateProjectStatusDirectly() {
    const status = document.getElementById('detailProjectStatus').value;
    try {
        await fetch('/admin/api/projects/move', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ projectId: currentProjectId, statusId: status })
        });
        window.location.reload();
    } catch (err) { alert('Erro ao atualizar status.'); }
}
</script>
