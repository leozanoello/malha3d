<div class="projects-wrapper animate-in fade-in duration-700 h-screen flex flex-col overflow-hidden">
    <!-- Header: High-Density Production Intelligence -->
    <div class="mb-8 p-8 glass-card border-none bg-gradient-to-br from-white/10 to-white/[0.02] relative overflow-hidden rounded-[2.5rem] flex-shrink-0 mx-4 mt-4">
        <div class="absolute top-0 right-0 w-96 h-96 bg-orange-500/10 blur-[120px] -mr-48 -mt-48"></div>
        
        <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-6 relative z-10">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-orange-500 flex items-center justify-center shadow-2xl shadow-orange-500/40">
                    <span class="material-symbols-outlined text-white text-2xl">precision_manufacturing</span>
                </div>
                <div>
                    <h1 class="text-3xl font-black text-white tracking-tighter leading-none">
                        Produção <span class="text-gradient">Projetos</span>
                    </h1>
                    <p class="text-gray-400 font-bold text-[9px] uppercase tracking-[0.3em] mt-1">ArchViz Production Pipeline</p>
                </div>
            </div>
            
            <div class="flex items-center gap-4">
                <div class="flex gap-6 px-6 py-3 bg-black/40 rounded-2xl border border-white/5 backdrop-blur-md">
                    <div class="text-center">
                        <p class="text-[7px] font-black text-gray-500 uppercase tracking-widest mb-0.5">Ativos</p>
                        <p class="text-lg font-black text-white">{{length projects}}</p>
                    </div>
                </div>
                <button id="btn-new-project" class="bg-orange-500 hover:bg-orange-600 text-white px-8 py-3.5 rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-2xl shadow-orange-500/30 transition-all flex items-center gap-2" data-bs-toggle="modal" data-bs-target="#newProjectModal">
                    <span class="material-symbols-outlined text-sm">add_circle</span> Novo Projeto
                </button>
            </div>
        </div>

        <!-- Sub-Navigation -->
        <div class="flex items-center gap-2 mt-8 p-1.5 bg-black/30 rounded-2xl w-fit border border-white/5">
            <button class="px-8 py-2.5 text-[9px] font-black uppercase tracking-[0.2em] rounded-xl transition-all flex items-center gap-2 bg-orange-500 text-white shadow-xl shadow-orange-500/20 project-page-tab active" data-tab="kanban">
                <span class="material-symbols-outlined text-sm">view_kanban</span> Pipeline
            </button>
            <button class="px-8 py-2.5 text-[9px] font-black uppercase tracking-[0.2em] rounded-xl text-gray-500 hover:text-white transition-all flex items-center gap-2 project-page-tab" data-tab="list">
                <span class="material-symbols-outlined text-sm">grid_view</span> Galeria
            </button>
        </div>
    </div>

    <!-- View Containers -->
    <div id="kanban-view" class="flex-1 flex flex-col min-h-0">
        <!-- Kanban Board -->
        <div id="kanban-board" class="flex-1 flex gap-6 overflow-x-auto pb-6 scrollbar-hide select-none px-4">
            {{#each pipelineColumns}}
            <div class="kanban-column w-80 flex-shrink-0 flex flex-col h-full" data-status="{{this.key}}">
                <!-- Column Header -->
                <div class="glass-card mb-4 border-white/10 relative flex-shrink-0 min-h-[90px] flex flex-col justify-center" style="border-top: 4px solid {{this.color}}">
                    <div class="p-4 flex items-center justify-between">
                        <div class="overflow-hidden flex-1">
                            <h3 class="text-xs font-black text-white uppercase tracking-widest flex items-center justify-between gap-2 pr-2 whitespace-normal line-clamp-2 break-words">
                                {{this.title}}
                                <span class="bg-white/5 text-gray-500 px-2 py-0.5 rounded-full text-[8px] flex-shrink-0">{{length (lookup ../projectsKanban this.key)}}</span>
                            </h3>
                        </div>
                    </div>
                </div>

                <!-- Cards Container -->
                <div class="cards-list flex-1 overflow-y-auto space-y-4 px-3 mx-[-0.75rem] scrollbar-hide pb-10 drop-zone" data-status="{{this.key}}">
                    {{#each (lookup ../projectsKanban this.key)}}
                    <div class="kanban-card glass-card p-4 border-white/5 hover:border-orange-500/40 transition-all cursor-grab active:cursor-grabbing group relative overflow-hidden bg-white/[0.01]" 
                         data-id="{{this.id}}" 
                         draggable="true"
                         onclick="openProjectDetails('{{this.id}}')">
                        
                        <!-- Progress Glow Bar -->
                        <div class="absolute top-0 left-0 w-full h-1 bg-white/[0.03]">
                            <div class="h-full bg-orange-500 shadow-[0_0_15px_rgba(249,115,22,0.6)] transition-all duration-1000" style="width: {{#if this.progress}}{{this.progress}}{{else}}10{{/if}}%;"></div>
                        </div>
                        
                        <div class="flex justify-between items-start mb-3 mt-1">
                            <h4 class="text-xs font-black text-white leading-tight pr-2 line-clamp-2 min-h-[32px] group-hover:text-orange-500 transition-colors uppercase">{{this.title}}</h4>
                            <span class="text-[7px] font-black text-orange-500 bg-orange-500/10 border border-orange-500/20 px-2.5 py-1 rounded-lg uppercase tracking-widest">{{this.category}}</span>
                        </div>

                        <div class="flex flex-col gap-1 mb-2">
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-gray-600 text-[12px]">person</span>
                                <span class="text-[9px] font-bold text-gray-400 truncate uppercase">{{this.client}}</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-gray-600 text-[12px]">calendar_today</span>
                                <span class="text-[9px] font-bold text-gray-500">{{formatDateShort this.createdAt}}</span>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-3 border-t border-white/5 mt-3">
                            <div class="flex gap-1.5">
                                <span class="px-2 py-0.5 rounded-md bg-white/5 text-[7px] font-black text-gray-500 uppercase tracking-widest border border-white/5">{{this.renderEngine}}</span>
                                <span class="px-2 py-0.5 rounded-md bg-orange-500/5 text-[7px] font-black text-orange-500 uppercase tracking-widest border border-orange-500/10">{{this.software}}</span>
                            </div>
                            {{#if ../isAdmin}}
                            <div class="flex items-center gap-1">
                                <span class="text-[9px] font-black text-white uppercase tracking-tighter">R$ {{formatCurrency this.price}}</span>
                            </div>
                            {{/if}}
                        </div>
                    </div>
                    {{/each}}
                    
                    {{#unless (lookup ../projectsKanban this.key)}}
                    <div class="border-2 border-dashed border-white/5 rounded-3xl p-6 flex flex-col items-center justify-center text-center opacity-30 mt-2">
                        <span class="material-symbols-outlined text-2xl mb-1">move_to_inbox</span>
                        <p class="text-[9px] font-black uppercase tracking-widest">Sem Projetos</p>
                    </div>
                    {{/unless}}
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    <!-- List View -->
    <div id="list-view" class="flex-1 overflow-y-auto hidden pb-20 scrollbar-hide px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {{#each projects}}
            <div class="glass-card p-4 border-white/5 bg-white/2 hover:border-blue-500/30 transition-all group" onclick="openProjectDetails('{{this.id}}')">
                <div class="aspect-video rounded-xl bg-white/5 mb-4 overflow-hidden border border-white/5 relative">
                    {{#if image}}
                    <img src="{{image}}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                    {{else}}
                    <div class="w-full h-full flex items-center justify-center text-gray-800">
                        <span class="material-symbols-outlined text-4xl">image</span>
                    </div>
                    {{/if}}
                    <div class="absolute top-2 right-2 px-2 py-1 bg-black/60 backdrop-blur-md rounded-lg text-[8px] font-black text-white uppercase tracking-widest border border-white/10">
                        {{category}}
                    </div>
                </div>
                <h3 class="text-sm font-black text-white mb-1 truncate">{{title}}</h3>
                <p class="text-[9px] text-gray-500 font-bold uppercase tracking-widest mb-4">{{client}}</p>
                <div class="flex items-center justify-between">
                    {{#if ../isAdmin}}
                    <span class="text-[10px] font-black text-blue-500">R$ {{formatCurrency price}}</span>
                    {{else}}
                    <span></span>
                    {{/if}}
                    <span class="text-[8px] font-black text-gray-600 uppercase">{{formatDateShort createdAt}}</span>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>

<!-- Modal: Project Details -->
<div id="projectDetailModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4">
    <div class="glass-card w-full max-w-5xl h-[90vh] flex flex-col relative overflow-hidden">
        <button type="button" class="absolute top-6 right-6 text-gray-400 hover:text-white z-20" onclick="closeProjectDetails()">
            <span class="material-symbols-outlined">close</span>
        </button>

        <div class="flex h-full">
            <div class="w-72 border-r border-white/5 p-8 flex flex-col gap-1 flex-shrink-0 bg-black/40">
                <div class="mb-10">
                    <p class="text-[8px] font-black text-orange-500 uppercase tracking-[0.3em] mb-2">PRODUÇÃO EM CURSO</p>
                    <h3 id="detailProjectTitle" class="text-2xl font-black text-white uppercase tracking-tighter line-clamp-2 leading-none">Carregando...</h3>
                    <p id="detailProjectClient" class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mt-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-xs">corporate_fare</span>
                        CLIENTE
                    </p>
                </div>
                
                <button class="detail-tab active w-full text-left px-5 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all mb-2 bg-orange-500 text-white shadow-lg shadow-orange-500/20" data-tab="specs">
                    <span class="flex items-center gap-3"><span class="material-symbols-outlined text-sm">precision_manufacturing</span> Especificações</span>
                </button>
                <button class="detail-tab w-full text-left px-5 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all mb-2 text-gray-500 hover:bg-white/5 hover:text-white" data-tab="revisions">
                    <span class="flex items-center gap-3"><span class="material-symbols-outlined text-sm">history_edu</span> Revisões</span>
                </button>
                <button class="detail-tab w-full text-left px-5 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all mb-2 text-gray-500 hover:bg-white/5 hover:text-white" data-tab="delivery">
                    <span class="flex items-center gap-3"><span class="material-symbols-outlined text-sm">cloud_done</span> Entregas</span>
                </button>
                <button class="detail-tab w-full text-left px-5 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all mb-2 text-gray-500 hover:bg-white/5 hover:text-white" data-tab="logs">
                    <span class="flex items-center gap-3"><span class="material-symbols-outlined text-sm">timeline</span> Timeline</span>
                </button>
                {{#if isAdmin}}
                <button class="detail-tab w-full text-left px-5 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all mb-2 text-gray-500 hover:bg-white/5 hover:text-white" data-tab="finance">
                    <span class="flex items-center gap-3"><span class="material-symbols-outlined text-sm">payments</span> Financeiro</span>
                </button>
                {{/if}}
                
                <div class="mt-auto pt-8">
                    <div class="p-5 rounded-[2rem] bg-white/[0.03] border border-white/5 backdrop-blur-md">
                        <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-3">Status do Pipeline</p>
                        <select id="detailProjectStatus" class="w-full bg-transparent text-[11px] font-black text-orange-500 uppercase outline-none cursor-pointer appearance-none" onchange="updateProjectStatusDirectly()">
                            {{#each pipelineColumns}}
                            <option value="{{this.key}}" class="bg-dark-950">{{this.title}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
            </div>

            <div class="flex-1 flex flex-col min-w-0 bg-black/20">
                <div id="detail-pane-specs" class="detail-pane active p-8 overflow-y-auto h-full">
                    <h4 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-6">Especificações Técnicas</h4>
                    <div class="grid grid-cols-2 gap-8 mb-8">
                        <div class="space-y-4">
                            <div>
                                <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest block mb-1">Software de Modelagem</label>
                                <p id="detailSoftware" class="text-xs font-bold text-white uppercase">---</p>
                            </div>
                            <div>
                                <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest block mb-1">Motor de Renderização</label>
                                <p id="detailRenderEngine" class="text-xs font-bold text-white uppercase">---</p>
                            </div>
                            <div>
                                <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest block mb-1">Localização</label>
                                <p id="detailLocation" class="text-xs font-bold text-white uppercase">---</p>
                            </div>
                        </div>
                        <div class="space-y-4">
                            <div>
                                <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest block mb-1">Metragem Aproximada</label>
                                <p id="detailArea" class="text-xs font-bold text-white uppercase">--- m²</p>
                            </div>
                            {{#if isAdmin}}
                            <div>
                                <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest block mb-1">Valor do Projeto</label>
                                <p id="detailPrice" class="text-xs font-bold text-orange-500 uppercase">R$ 0,00</p>
                            </div>
                            {{/if}}
                        </div>
                    </div>
                    <div>
                        <label class="text-[9px] font-black text-gray-600 uppercase tracking-widest block mb-2">Breve Descritivo / Briefing</label>
                        <div class="p-6 rounded-2xl bg-white/5 border border-white/5 text-xs text-gray-300 leading-relaxed italic" id="detailDescription">
                            Nenhuma descrição fornecida.
                        </div>
                    </div>
                </div>

                <div id="detail-pane-revisions" class="detail-pane hidden p-8 overflow-y-auto h-full">
                    <div class="flex items-center justify-between mb-8">
                        <h4 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em]">Fluxo de Revisões</h4>
                        <button class="px-4 py-2 bg-blue-500 text-white text-[9px] font-black uppercase tracking-widest rounded-lg">Nova Solicitação</button>
                    </div>
                    <div class="space-y-4" id="revisionsList">
                        <div class="p-6 rounded-2xl border border-white/5 bg-white/2 flex flex-col items-center justify-center opacity-30 h-48">
                            <span class="material-symbols-outlined text-3xl mb-2">history_edu</span>
                            <p class="text-[9px] font-black uppercase tracking-widest">Nenhuma revisão solicitada ainda</p>
                        </div>
                    </div>
                </div>

                <div id="detail-pane-delivery" class="detail-pane hidden p-8 overflow-y-auto h-full">
                    <h4 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-8">Entregáveis & Assets</h4>
                    <div class="grid grid-cols-2 gap-4" id="deliveryList">
                        <div class="col-span-2 p-12 border-2 border-dashed border-white/5 rounded-3xl flex flex-col items-center justify-center opacity-20">
                            <span class="material-symbols-outlined text-5xl mb-4 text-gray-700">cloud_upload</span>
                            <p class="text-[10px] font-black uppercase tracking-widest">Aguardando Envio de Render Final</p>
                        </div>
                    </div>
                </div>

                <div id="detail-pane-logs" class="detail-pane hidden p-8 overflow-y-auto h-full">
                    <h4 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-8">Timeline de Eventos</h4>
                    <div class="space-y-6 relative before:absolute before:left-3 before:top-2 before:bottom-2 before:w-[1px] before:bg-white/5" id="logsTimeline">
                        <div class="relative pl-10">
                            <div class="absolute left-0 top-1 w-6 h-6 rounded-lg bg-blue-500/20 border border-blue-500/30 flex items-center justify-center">
                                <span class="material-symbols-outlined text-blue-500 text-[10px]">auto_awesome</span>
                            </div>
                            <p class="text-[10px] font-black text-white uppercase tracking-widest mb-1">Projeto Inicializado</p>
                            <p class="text-[9px] text-gray-500 font-bold uppercase">Automated System • Hoje</p>
                        </div>
                    </div>
                </div>

                <div id="detail-pane-finance" class="detail-pane hidden p-8 overflow-y-auto h-full">
                    <div class="flex items-center justify-between mb-8">
                        <h4 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em]">Fluxo Financeiro do Projeto</h4>
                        <div class="flex gap-4">
                            <button class="bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/20 text-emerald-400 px-4 py-2 rounded-xl text-[9px] font-black uppercase tracking-widest transition-all cursor-pointer" id="btn-project-new-receita">Lançar Receita</button>
                            <button class="bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 text-red-400 px-4 py-2 rounded-xl text-[9px] font-black uppercase tracking-widest transition-all cursor-pointer" id="btn-project-new-despesa">Lançar Despesa</button>
                        </div>
                    </div>

                    <!-- KPIs Cards -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                        <div class="glass-card p-6 border-white/5 bg-gradient-to-br from-emerald-500/10 to-transparent rounded-[1.5rem]">
                            <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Total Recebido (Faturado)</p>
                            <h4 class="text-xl font-black text-emerald-400 tracking-tighter" id="project-finance-revenue">R$ 0,00</h4>
                        </div>
                        <div class="glass-card p-6 border-white/5 bg-gradient-to-br from-red-500/10 to-transparent rounded-[1.5rem]">
                            <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Custos do Projeto (Despesas)</p>
                            <h4 class="text-xl font-black text-red-400 tracking-tighter" id="project-finance-expenses">R$ 0,00</h4>
                        </div>
                        <div class="glass-card p-6 border-white/5 bg-gradient-to-br from-indigo-500/10 to-transparent rounded-[1.5rem]">
                            <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-2">Margem Líquida</p>
                            <h4 class="text-xl font-black text-white tracking-tighter" id="project-finance-margin">R$ 0,00 (0%)</h4>
                        </div>
                    </div>

                    <!-- Transactions Table -->
                    <div class="glass-card border-white/5 bg-white/2 rounded-3xl overflow-hidden mb-8">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="border-b border-white/5 bg-black/40 text-[8px] font-black text-gray-500 uppercase tracking-widest">
                                        <th class="p-4">Descrição</th>
                                        <th class="p-4">Tipo</th>
                                        <th class="p-4">Valor</th>
                                        <th class="p-4">Competência</th>
                                        <th class="p-4">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-white/5 text-xs text-gray-300" id="project-finance-list">
                                    <!-- Dynamic List of Transactions -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Novo Projeto -->
<div class="modal fade" id="newProjectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card p-4 border-white/10 bg-dark-950/95">
            <div class="flex justify-between items-center mb-8 px-4">
                <h3 class="text-xl font-black text-white uppercase tracking-tighter">Initialize <span class="text-blue-500">Project Workspace</span></h3>
                <button type="button" class="text-gray-500 hover:text-white" data-bs-dismiss="modal"><span class="material-symbols-outlined">close</span></button>
            </div>
            <form id="newProjectForm" class="p-4 space-y-8">
                <div class="grid grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Título do Projeto</label>
                        <input type="text" name="title" required class="input-premium" placeholder="Ex: Residência Alpha">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Categoria ArchViz</label>
                        <select name="category" class="input-premium">
                            <option value="interior">Interiores</option>
                            <option value="exterior">Exterior</option>
                            <option value="arquitetonico">Arquitetônico</option>
                            <option value="animacao">Animação</option>
                            <option value="produto">Produto</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-4">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Vincular Cliente</label>
                    <select name="clientId" class="input-premium" required>
                        <option value="">Selecione um cliente...</option>
                        {{#each clients}}
                        <option value="{{this.id}}">{{this.name}} ({{this.company}})</option>
                        {{/each}}
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Estado (Localidade)</label>
                        <select name="state" id="project-state" class="input-premium" required style="background-color: rgb(15 23 42 / 0.5)">
                            <option value="">Carregando...</option>
                        </select>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Cidade (Localidade)</label>
                        <select name="city" id="project-city" class="input-premium" required disabled style="background-color: rgb(15 23 42 / 0.5)">
                            <option value="">Selecione o Estado...</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Software Principal</label>
                        <input type="text" name="software" class="input-premium" placeholder="Ex: 3ds Max">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Motor de Render</label>
                        <input type="text" name="renderEngine" class="input-premium" placeholder="Ex: Corona">
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Briefing</label>
                    <textarea name="description" class="input-premium h-24" placeholder="Descreva os entregáveis..."></textarea>
                </div>

                <button type="submit" class="w-full py-4 rounded-2xl bg-blue-500 text-white font-black uppercase tracking-widest shadow-xl shadow-blue-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all">
                    Iniciar Produção
                </button>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // === PAGE TABS ===
    const pageTabs = document.querySelectorAll('.project-page-tab');
    pageTabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const target = tab.dataset.tab;
            pageTabs.forEach(t => t.classList.remove('active', 'text-blue-500'));
            pageTabs.forEach(t => t.querySelector('div')?.remove());
            
            tab.classList.add('active', 'text-blue-500');
            tab.innerHTML += '<div class="absolute bottom-0 left-0 w-full h-0.5 bg-blue-500"></div>';

            if (target === 'kanban') {
                document.getElementById('kanban-view').classList.remove('hidden');
                document.getElementById('list-view').classList.add('hidden');
            } else {
                document.getElementById('kanban-view').classList.add('hidden');
                document.getElementById('list-view').classList.remove('hidden');
            }
        });
    });

    // === DETAIL MODAL TABS ===
    const detailTabs = document.querySelectorAll('.detail-tab');
    detailTabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const target = tab.dataset.tab;
            detailTabs.forEach(t => {
                t.classList.remove('active', 'bg-blue-500', 'text-white');
                t.classList.add('text-gray-500');
            });
            tab.classList.add('active', 'bg-blue-500', 'text-white');
            tab.classList.remove('text-gray-500');

            document.querySelectorAll('.detail-pane').forEach(p => p.classList.add('hidden'));
            document.getElementById(`detail-pane-${target}`).classList.remove('hidden');
        });
    });

    // === DRAG & DROP ===
    const cards = document.querySelectorAll('.kanban-card');
    const dropZones = document.querySelectorAll('.drop-zone');

    cards.forEach(card => {
        card.addEventListener('dragstart', (event) => {
            card.classList.add('opacity-40');
            event.dataTransfer.setData('projectId', card.dataset.id);
        });
        card.addEventListener('dragend', () => {
            card.classList.remove('opacity-40');
        });
    });

    dropZones.forEach(zone => {
        zone.addEventListener('dragover', e => {
            e.preventDefault();
            zone.classList.add('bg-blue-500/5');
        });
        zone.addEventListener('dragleave', () => {
            zone.classList.remove('bg-blue-500/5');
        });
        zone.addEventListener('drop', async e => {
            e.preventDefault();
            zone.classList.remove('bg-blue-500/5');
            const projectId = e.dataTransfer.getData('projectId');
            const newStatus = zone.dataset.status;
            const card = document.querySelector(`[data-id="${projectId}"]`);
            
            if (card) {
                zone.appendChild(card);
                // Update API
                try {
                    await fetch('/admin/api/projects/move', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ projectId, statusId: newStatus })
                    });
                } catch (err) { window.location.reload(); }
            }
        });
    });

    // === NEW TRANSACTION VIA PROJECT REDIRECTS ===
    document.getElementById('btn-project-new-receita')?.addEventListener('click', () => {
        window.location.href = `/admin/financeiro?projectId=${currentProjectId}&type=receita`;
    });
    document.getElementById('btn-project-new-despesa')?.addEventListener('click', () => {
        window.location.href = `/admin/financeiro?projectId=${currentProjectId}&type=despesa`;
    });

    // === INITIALIZE IBGE LOADER FOR NEW PROJECT ===
    if (document.getElementById('newProjectModal')) {
        loadIBGEStates('project-state', 'project-city');
    }

    // === NEW PROJECT FORM SUBMIT ===
    document.getElementById('newProjectForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(this).entries());
        try {
            const res = await fetch('/admin/api/projects', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.success) {
                window.location.reload();
            } else {
                alert('Erro ao criar projeto: ' + result.message);
            }
        } catch (err) {
            console.error('Erro ao enviar formulário:', err);
            alert('Erro de conexão ao criar projeto');
        }
    });
});

let currentProjectId = null;

async function openProjectDetails(id) {
    currentProjectId = id;
    const modal = document.getElementById('projectDetailModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    
    try {
        const res = await fetch(`/admin/api/projects/${id}`);
        const { project } = await res.json();
        
        document.getElementById('detailProjectTitle').innerText = project.title;
        document.getElementById('detailProjectClient').innerText = project.customer?.name || 'Cliente Externo';
        document.getElementById('detailSoftware').innerText = project.software || 'N/A';
        document.getElementById('detailRenderEngine').innerText = project.renderEngine || 'N/A';
        document.getElementById('detailLocation').innerText = (project.city && project.state) ? `${project.city} - ${project.state}` : 'N/A';
        document.getElementById('detailArea').innerText = project.totalArea || '---';
        const detailPriceEl = document.getElementById('detailPrice');
        if (detailPriceEl) {
            detailPriceEl.innerText = 'R$ ' + (project.price ? parseFloat(project.price).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) : '0,00');
        }
        document.getElementById('detailDescription').innerText = project.description || 'Nenhuma descrição.';
        document.getElementById('detailProjectStatus').value = project.status;
        
        // Reset and switch to Specs tab by default
        document.querySelectorAll('.detail-tab').forEach(t => {
            t.classList.remove('active', 'bg-blue-500', 'text-white');
            t.classList.add('text-gray-500');
        });
        const specsTab = document.querySelector('.detail-tab[data-tab="specs"]');
        if (specsTab) {
            specsTab.classList.add('active', 'bg-blue-500', 'text-white');
            specsTab.classList.remove('text-gray-500');
        }
        document.querySelectorAll('.detail-pane').forEach(p => p.classList.add('hidden'));
        document.getElementById('detail-pane-specs')?.classList.remove('hidden');

        // Render Finance tab content
        const financeList = document.getElementById('project-finance-list');
        const revenueEl = document.getElementById('project-finance-revenue');
        const expensesEl = document.getElementById('project-finance-expenses');
        const marginEl = document.getElementById('project-finance-margin');

        let totalRevenue = 0;
        let totalExpenses = 0;
        let listHtml = '';

        if (project.transactions && project.transactions.length > 0) {
            project.transactions.forEach(t => {
                const amt = parseFloat(t.amount) || 0;
                if (t.type === 'receita') {
                    totalRevenue += amt;
                } else if (t.type === 'despesa') {
                    totalExpenses += amt;
                }

                const typeIcon = t.type === 'receita' 
                    ? '<span class="material-symbols-outlined text-emerald-500 text-sm">add_circle</span>' 
                    : '<span class="material-symbols-outlined text-red-500 text-sm">remove_circle</span>';
                
                const typeText = t.type === 'receita' ? 'Receita' : 'Despesa';
                
                const statusClass = t.status === 'pago' || t.status === 'recebido'
                    ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'
                    : 'bg-amber-500/10 text-amber-400 border-amber-500/20';
                
                const statusText = t.status === 'pago' || t.status === 'recebido' ? 'Pago' : 'Pendente';

                const formattedAmount = 'R$ ' + amt.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const compDate = t.competenceDate ? new Date(t.competenceDate).toLocaleDateString('pt-BR') : (t.dueDate ? new Date(t.dueDate).toLocaleDateString('pt-BR') : '---');

                listHtml += `
                    <tr class="hover:bg-white/[0.01]">
                        <td class="p-4 font-bold text-white">${t.description}</td>
                        <td class="p-4"><span class="flex items-center gap-1">${typeIcon} ${typeText}</span></td>
                        <td class="p-4 font-mono font-bold ${t.type === 'receita' ? 'text-emerald-400' : 'text-red-400'}">${formattedAmount}</td>
                        <td class="p-4 text-gray-500 font-medium">${compDate}</td>
                        <td class="p-4">
                            <span class="px-2 py-0.5 rounded-full border text-[8px] font-black uppercase tracking-wider ${statusClass}">
                                ${statusText}
                            </span>
                        </td>
                    </tr>
                `;
            });
        } else {
            listHtml = `
                <tr>
                    <td colspan="5" class="p-8 text-center text-gray-500">
                        <span class="material-symbols-outlined text-2xl mb-1 block">payments</span>
                        Nenhuma transação vinculada a este projeto.
                    </td>
                </tr>
            `;
        }

        if (financeList) financeList.innerHTML = listHtml;
        if (revenueEl) revenueEl.innerText = 'R$ ' + totalRevenue.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        if (expensesEl) expensesEl.innerText = 'R$ ' + totalExpenses.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        
        const margin = totalRevenue - totalExpenses;
        const marginPercent = totalRevenue > 0 ? Math.round((margin / totalRevenue) * 100) : 0;
        if (marginEl) {
            marginEl.innerText = 'R$ ' + margin.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ` (${marginPercent}%)`;
            if (margin >= 0) {
                marginEl.className = "text-xl font-black text-emerald-400 tracking-tighter";
            } else {
                marginEl.className = "text-xl font-black text-red-400 tracking-tighter";
            }
        }
        
    } catch (err) {
        console.error(err);
    }
}

function closeProjectDetails() {
    const modal = document.getElementById('projectDetailModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

async function updateProjectStatusDirectly() {
    const status = document.getElementById('detailProjectStatus').value;
    try {
        await fetch('/admin/api/projects/move', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ projectId: currentProjectId, statusId: status })
        });
        window.location.reload();
    } catch (err) { alert('Erro ao atualizar status.'); }
}
