<!-- Header & Navigation -->
<div class="mb-8 p-8 glass-card border-none bg-gradient-to-br from-white/10 to-white/[0.02] relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/10 blur-[100px] -mr-32 -mt-32"></div>
    
    <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-6 relative z-10">
        <div>
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-blue-500 flex items-center justify-center shadow-lg shadow-blue-500/20">
                    <span class="material-symbols-outlined text-white">architecture</span>
                </div>
                <h1 class="text-3xl font-black text-white tracking-tighter">
                    Pipeline de <span class="text-gradient">Produção</span>
                </h1>
            </div>
            <p class="text-gray-400 font-medium text-sm max-w-xl">
                Monitore o ciclo de vida dos seus projetos de ArchViz, desde a modelagem até a entrega final.
            </p>
        </div>
        
        <div class="flex flex-wrap items-center gap-4">
            <button class="bg-white/5 hover:bg-white/10 text-white font-black py-3 px-8 rounded-2xl border border-white/10 transition-all flex items-center gap-2 text-[10px] uppercase tracking-widest" data-bs-toggle="modal" data-bs-target="#newProjectModal">
                <span class="material-symbols-outlined text-base">add_circle</span>
                Novo Projeto
            </button>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex items-center gap-2 mt-10 p-1.5 bg-black/20 rounded-2xl w-fit border border-white/5">
        <button class="px-8 py-3 text-[10px] font-black uppercase tracking-[0.2em] rounded-xl transition-all flex items-center gap-2 bg-blue-500 text-white shadow-lg shadow-blue-500/10 btn-tab-trigger" data-tab="kanban" id="btn-tab-kanban">
            <span class="material-symbols-outlined text-sm">view_kanban</span> Kanban de Produção
        </button>
        <button class="px-8 py-3 text-[10px] font-black uppercase tracking-[0.2em] rounded-xl text-gray-500 hover:text-white transition-all flex items-center gap-2 btn-tab-trigger" data-tab="list" id="btn-tab-list">
            <span class="material-symbols-outlined text-sm">view_list</span> Lista de Ativos
        </button>
    </div>
</div>

<div id="projects-content">
    <!-- View 1: KANBAN -->
    <div id="tab-kanban" class="tab-pane active">
        <div class="flex gap-8 overflow-x-auto pb-12 min-h-[750px] scrollbar-premium px-4">
            {{#each pipelineColumns}}
            <div class="flex-shrink-0 w-80 flex flex-col gap-6">
                <!-- Header -->
                <div class="flex items-center justify-between px-3">
                    <div class="flex items-center gap-4">
                        <div class="w-1.5 h-7 rounded-full shadow-[0_0_15px_rgba(59,130,246,0.3)]" style="background-color: {{this.color}}"></div>
                        <div>
                            <h4 class="text-[11px] font-black text-white uppercase tracking-[0.2em]">{{this.title}}</h4>
                            <p class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mt-0.5">{{length (lookup ../projectsKanban this.key)}} Projetos</p>
                        </div>
                    </div>
                    <button class="w-8 h-8 rounded-xl bg-white/5 flex items-center justify-center text-gray-500 hover:text-blue-500 transition-all btn-edit-col" data-id="{{this.key}}" data-title="{{this.title}}">
                        <span class="material-symbols-outlined text-sm">settings</span>
                    </button>
                </div>
                
                <!-- Drop Zone -->
                <div class="kanban-drop-zone p-2 rounded-[2rem] border border-transparent hover:border-white/5 hover:bg-white/[0.01] transition-all flex-1 min-h-[600px] flex flex-col gap-4 drop-zone" 
                     id="col-{{this.key}}" 
                     data-status="{{this.key}}">
                    
                    {{#each (lookup ../projectsKanban this.key)}}
                    <div class="glass-card p-5 border-white/10 bg-white/2 rounded-[1.5rem] relative overflow-hidden group hover:border-blue-500/30 transition-all cursor-grab active:cursor-grabbing shadow-xl" 
                         draggable="true" 
                         ondragstart="onProjectDragStart(event, '{{this.id}}')" 
                         data-id="{{this.id}}">
                        <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent pointer-events-none"></div>
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-blue-500/20 flex items-center justify-center text-blue-500 font-bold text-[10px]">{{firstLetter this.title}}</div>
                                <div>
                                    <h5 class="text-[11px] font-black text-white group-hover:text-blue-500 transition-colors uppercase">{{this.title}}</h5>
                                    <p class="text-[8px] text-gray-500 font-bold uppercase tracking-widest">{{this.client}}</p>
                                </div>
                            </div>
                            <button class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-gray-500 hover:text-blue-500 transition-all btn-edit-project" data-id="{{this.id}}">
                                <span class="material-symbols-outlined text-xs">edit</span>
                            </button>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="px-2 py-1 rounded-lg bg-white/5 text-[7px] font-black text-gray-400 uppercase tracking-widest">{{this.category}}</span>
                            <div class="flex -space-x-2">
                                <div class="w-5 h-5 rounded-full border border-[#121212] bg-gray-800 flex items-center justify-center text-[8px] text-white" title="Responsável">+</div>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    <!-- View 2: LIST -->
    <div id="tab-list" class="tab-pane hidden animate-in fade-in zoom-in duration-300">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {{#each projects}}
            <div class="glass-card p-6 border-white/5 bg-white/2 hover:border-blue-500/30 transition-all">
                <div class="aspect-video rounded-2xl bg-white/5 mb-6 overflow-hidden border border-white/5">
                    {{#if image}}
                    <img src="{{image}}" class="w-full h-full object-cover">
                    {{else}}
                    <div class="w-full h-full flex items-center justify-center text-gray-700">
                        <span class="material-symbols-outlined text-4xl">image</span>
                    </div>
                    {{/if}}
                </div>
                <h3 class="text-lg font-black text-white mb-2">{{title}}</h3>
                <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mb-6">{{client}} • {{category}}</p>
                <div class="flex gap-2">
                    <button class="flex-1 py-3 rounded-xl bg-white/5 text-[9px] font-black uppercase tracking-widest text-white hover:bg-white/10 transition-all">Detalhes</button>
                    <button class="px-4 py-3 rounded-xl bg-blue-500/10 text-blue-500 hover:bg-blue-500 hover:text-white transition-all">
                        <span class="material-symbols-outlined text-sm">edit</span>
                    </button>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>

<!-- Modal: Novo Projeto (Liquid Glass + Inline Client) -->
<div class="modal fade" id="newProjectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card p-4 border-white/10 bg-dark-950/95">
            <div class="flex justify-between items-center mb-8 px-4">
                <h3 class="text-xl font-black text-white uppercase tracking-tighter">Initialize <span class="text-blue-500">Project Workspace</span></h3>
                <button type="button" class="text-gray-500 hover:text-white" data-bs-dismiss="modal"><span class="material-symbols-outlined">close</span></button>
            </div>
            <form id="newProjectForm" class="p-4 space-y-8">
                <div class="grid grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Título do Projeto</label>
                        <input type="text" name="title" required class="input-premium" placeholder="Ex: Residência Alpha">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Categoria ArchViz</label>
                        <select name="category" class="input-premium">
                            <option value="render">Renderização Estática</option>
                            <option value="3d">Modelagem 3D / Asset</option>
                            <option value="animation">Animação / Cinematic</option>
                            <option value="vr">Realidade Virtual (UE5)</option>
                        </select>
                    </div>
                </div>

                <!-- Client Selector with Inline Add -->
                <div class="space-y-4">
                    <div class="flex justify-between items-center">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Vincular Cliente</label>
                        <button type="button" id="btn-toggle-new-client" class="text-[10px] font-black text-blue-500 uppercase tracking-widest flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm" id="clientToggleIcon">add</span> 
                            <span id="clientToggleText">Novo Cliente</span>
                        </button>
                    </div>
                    
                    <div id="existingClientSection">
                        <select name="clientId" class="input-premium">
                            <option value="">Selecione um cliente existente...</option>
                            {{#each clients}}
                            <option value="{{id}}">{{name}} ({{company}})</option>
                            {{/each}}
                        </select>
                    </div>

                    <div id="newClientSection" class="hidden animate-in fade-in slide-in-from-top-2 duration-300 p-6 rounded-3xl bg-blue-500/5 border border-blue-500/10 space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <input type="text" name="newClientName" class="input-premium bg-transparent" placeholder="Nome Completo">
                            <input type="text" name="newClientCompany" class="input-premium bg-transparent" placeholder="Empresa / Escritório">
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <input type="email" name="newClientEmail" class="input-premium bg-transparent" placeholder="E-mail">
                            <input type="text" name="newClientPhone" class="input-premium bg-transparent" placeholder="WhatsApp">
                        </div>
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Breve Briefing</label>
                    <textarea name="description" class="input-premium h-24" placeholder="Descreva os entregáveis..."></textarea>
                </div>

                <button type="submit" class="w-full py-4 rounded-2xl bg-blue-500 text-white font-black uppercase tracking-widest shadow-xl shadow-blue-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all">
                    Iniciar Produção
                </button>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // === TABS LOGIC ===
    const tabButtons = document.querySelectorAll('.btn-tab-trigger');
    tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            const tabId = btn.dataset.tab;
            document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            
            tabButtons.forEach(b => {
                b.classList.remove('bg-blue-500', 'text-white', 'shadow-lg', 'shadow-blue-500/10');
                b.classList.add('text-gray-500');
            });
            
            btn.classList.add('bg-blue-500', 'text-white', 'shadow-lg', 'shadow-blue-500/10');
            btn.classList.remove('text-gray-500');
        });
    });

    // === NEW CLIENT TOGGLE ===
    document.getElementById('btn-toggle-new-client')?.addEventListener('click', function() {
        const newSection = document.getElementById('newClientSection');
        const existingSection = document.getElementById('existingClientSection');
        const icon = document.getElementById('clientToggleIcon');
        const text = document.getElementById('clientToggleText');
        
        if (newSection.classList.contains('hidden')) {
            newSection.classList.remove('hidden');
            existingSection.classList.add('opacity-30', 'pointer-events-none');
            icon.innerText = 'close';
            text.innerText = 'Cancelar Novo';
        } else {
            newSection.classList.add('hidden');
            existingSection.classList.remove('opacity-30', 'pointer-events-none');
            icon.innerText = 'add';
            text.innerText = 'Novo Cliente';
        }
    });

    // === EVENT DELEGATION ===
    document.addEventListener('click', function(e) {
        // Edit Column
        const editColBtn = e.target.closest('.btn-edit-col');
        if (editColBtn) {
            const { id, title } = editColBtn.dataset;
            const newTitle = prompt('Editar nome da coluna:', title);
            if (newTitle && newTitle !== title) {
                console.log('Update column', id, newTitle);
            }
            return;
        }

        // Edit Project
        const editProjectBtn = e.target.closest('.btn-edit-project');
        if (editProjectBtn) {
            const id = editProjectBtn.dataset.id;
            console.log('Edit project', id);
            alert('Edição de projeto ID: ' + id);
            return;
        }
    });

    // === DRAG & DROP ===
    document.addEventListener('dragstart', function(e) {
        const card = e.target.closest('[draggable="true"]');
        if (card) {
            e.dataTransfer.setData("projectId", card.dataset.id);
            setTimeout(() => card.classList.add('opacity-40'), 0);
        }
    });

    document.addEventListener('dragend', function(e) {
        const card = e.target.closest('[draggable="true"]');
        if (card) card.classList.remove('opacity-40');
    });

    document.addEventListener('dragover', function(e) {
        const dropZone = e.target.closest('.drop-zone');
        if (dropZone) {
            e.preventDefault();
            dropZone.classList.add('bg-blue-500/[0.05]', 'border-blue-500/20');
        }
    });

    document.addEventListener('dragleave', function(e) {
        const dropZone = e.target.closest('.drop-zone');
        if (dropZone) {
            dropZone.classList.remove('bg-blue-500/[0.05]', 'border-blue-500/20');
        }
    });

    document.addEventListener('drop', async function(e) {
        const dropZone = e.target.closest('.drop-zone');
        if (dropZone) {
            e.preventDefault();
            dropZone.classList.remove('bg-blue-500/[0.05]', 'border-blue-500/20');
            
            const projectId = e.dataTransfer.getData("projectId");
            const statusKey = dropZone.dataset.status;
            const card = document.querySelector(`[data-id="${projectId}"]`);
            
            if (card) {
                dropZone.appendChild(card);
                // Update count label
                const countEl = dropZone.closest('.flex-col').querySelector('p');
                if (countEl) {
                    countEl.innerText = `${dropZone.children.length} Projetos`;
                }
            }
            
            // API Update
            try {
                const response = await fetch(`/admin/api/projects/move`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ projectId, statusId: statusKey })
                });
                if (!response.ok) window.location.reload();
            } catch (err) { window.location.reload(); }
        }
    });

    // === FORM SUBMISSION ===
    document.getElementById('newProjectForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(this).entries());
        
        try {
            const response = await fetch('/admin/api/projects', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            if (result.success) window.location.reload();
            else alert('Erro: ' + result.message);
        } catch (err) { console.error(err); }
    });
});
</script>
