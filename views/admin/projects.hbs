<!-- Header -->
<div class="mb-10 p-8 glass-card border-none bg-gradient-to-br from-white/5 to-white/[0.02]">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h1 class="text-4xl font-black text-white tracking-tight mb-2">
                Galeria de <span class="text-gradient">Projetos</span>
            </h1>
            <p class="text-gray-400 font-medium">
                Gerencie seu portfólio e acompanhe o andamento dos projetos ativos no ecossistema <span class="text-orange-500">Malha3D</span>.
            </p>
        </div>
        <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-8 rounded-2xl shadow-2xl shadow-orange-500/40 transition-all flex items-center gap-3" data-bs-toggle="modal" data-bs-target="#newProjectModal">
            <span class="material-symbols-outlined">add</span>
            Novo Projeto
        </button>
    </div>
</div>

<!-- Filters Bar -->
<div class="glass-card p-6 border-white/5 mb-10 bg-white/[0.01]">
    <form id="filterForm" class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="space-y-2">
            <label class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] ml-1">Categoria</label>
            <select id="categoryFilter" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm font-bold text-white focus:ring-2 focus:ring-orange-500/20 transition-all cursor-pointer">
                <option value="" class="bg-[#0f0f0f]">Todas</option>
                <option value="3d" class="bg-[#0f0f0f]">Modelagem 3D</option>
                <option value="render" class="bg-[#0f0f0f]">Renderização</option>
                <option value="animation" class="bg-[#0f0f0f]">Animação</option>
                <option value="product" class="bg-[#0f0f0f]">Produto</option>
                <option value="architectural" class="bg-[#0f0f0f]">Arquitetônico</option>
            </select>
        </div>
        <div class="space-y-2">
            <label class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] ml-1">Status do Ciclo</label>
            <select id="statusFilter" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm font-bold text-white focus:ring-2 focus:ring-orange-500/20 transition-all cursor-pointer">
                <option value="" class="bg-[#0f0f0f]">Todos</option>
                <option value="active" class="bg-[#0f0f0f]">Ativo</option>
                <option value="inactive" class="bg-[#0f0f0f]">Inativo</option>
                <option value="featured" class="bg-[#0f0f0f]">Destaque</option>
            </select>
        </div>
        <div class="space-y-2">
            <label class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] ml-1">Pesquisa Inteligente</label>
            <div class="relative group">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-lg group-focus-within:text-orange-500 transition-colors">search</span>
                <input type="text" id="searchFilter" placeholder="Título ou cliente..." class="w-full bg-white/5 border border-white/10 rounded-xl py-3 pl-12 pr-6 text-sm font-bold text-white placeholder:text-gray-600 focus:ring-2 focus:ring-orange-500/20 transition-all">
            </div>
        </div>
        <div class="flex items-end gap-3">
            <button type="submit" class="flex-1 bg-white text-black py-3 rounded-xl text-xs font-black uppercase tracking-widest hover:bg-orange-500 hover:text-white transition-all shadow-xl hover:shadow-orange-500/20">Filtrar</button>
            <button type="button" onclick="clearFilters()" class="p-3 bg-white/5 text-gray-500 rounded-xl hover:text-white hover:bg-white/10 transition-all border border-white/5">
                <span class="material-symbols-outlined text-lg">undo</span>
            </button>
        </div>
    </form>
</div>

<!-- Projects Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {{#each projects}}
    <div class="group glass-card border-white/5 overflow-hidden hover:shadow-2xl hover:shadow-orange-500/10 hover:-translate-y-2 transition-all duration-500 relative">
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity z-10 pointer-events-none"></div>
        
        <!-- Project Preview -->
        <div class="aspect-[16/10] relative overflow-hidden bg-white/5">
            {{#if this.image}}
                <img src="{{this.image}}" alt="{{this.title}}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
            {{else}}
                <div class="w-full h-full flex flex-col items-center justify-center gap-3 text-gray-700">
                    <span class="material-symbols-outlined text-5xl">image</span>
                    <span class="text-[10px] font-black uppercase tracking-[0.2em]">Asset Sem Preview</span>
                </div>
            {{/if}}
            
            <!-- Overlay Actions -->
            <div class="absolute inset-0 z-20 opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-center justify-center gap-4">
                <button onclick="viewProject({{this.id}})" class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center text-gray-900 hover:bg-orange-500 hover:text-white hover:rotate-6 transition-all shadow-2xl">
                    <span class="material-symbols-outlined text-xl">visibility</span>
                </button>
                <a href="/admin/projetos/{{this.id}}/editar" class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center text-gray-900 hover:bg-orange-500 hover:text-white hover:-rotate-6 transition-all shadow-2xl">
                    <span class="material-symbols-outlined text-xl">edit</span>
                </a>
                <button onclick="deleteProject({{this.id}})" class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center text-gray-900 hover:bg-red-500 hover:text-white hover:scale-110 transition-all shadow-2xl">
                    <span class="material-symbols-outlined text-xl">delete</span>
                </button>
            </div>

            <!-- Badges -->
            <div class="absolute top-6 left-6 flex flex-col gap-3 z-20">
                {{#if this.isFeatured}}
                    <span class="px-4 py-1.5 bg-orange-500 text-white text-[9px] font-black uppercase tracking-[0.2em] rounded-full flex items-center gap-2 shadow-2xl shadow-orange-500/40 ring-1 ring-white/20">
                        <span class="material-symbols-outlined text-[14px]">star</span>
                        Premium
                    </span>
                {{/if}}
                <span class="px-4 py-1.5 {{#if this.isActive}}bg-emerald-500/20 text-emerald-500 ring-emerald-500/30{{else}}bg-white/10 text-gray-400 ring-white/20{{/if}} text-[9px] font-black uppercase tracking-[0.2em] rounded-full ring-1 shadow-2xl">
                    {{#if this.isActive}}Ativo{{else}}Draft{{/if}}
                </span>
            </div>
        </div>

        <!-- Project Info -->
        <div class="p-8 relative z-20">
            <div class="flex items-center gap-3 mb-4">
                <span class="px-2.5 py-1 bg-orange-500/10 text-orange-500 text-[9px] font-black uppercase tracking-widest rounded-lg ring-1 ring-orange-500/20">{{this.category}}</span>
                {{#if this.year}}
                    <span class="text-[10px] font-black text-gray-600 uppercase tracking-[0.2em]">{{this.year}}</span>
                {{/if}}
            </div>
            <h3 class="text-xl font-black text-white tracking-tight mb-3 group-hover:text-orange-500 transition-colors">{{this.title}}</h3>
            {{#if this.client}}
                <div class="flex items-center gap-2 text-gray-500 mb-6">
                    <span class="material-symbols-outlined text-lg">person</span>
                    <span class="text-xs font-bold tracking-wide">{{this.client}}</span>
                </div>
            {{/if}}

            <div class="pt-6 border-t border-white/5 flex items-center justify-between">
                <div class="flex -space-x-3">
                    {{#each this.tagsArray}}
                        <div class="w-8 h-8 bg-white/5 border-2 border-[#121212] rounded-xl flex items-center justify-center text-[10px] font-black text-gray-400 hover:text-white hover:bg-orange-500 transition-all cursor-help" title="{{this}}">
                            {{#firstLetter this}}{{/firstLetter}}
                        </div>
                    {{/each}}
                </div>
                <span class="text-[9px] font-black text-gray-600 uppercase tracking-[0.2em]">{{dateFormat this.createdAt "DD/MM/YYYY"}}</span>
            </div>
        </div>
    </div>
    {{else}}
    <div class="col-span-full py-32 glass-card border-dashed border-white/10 flex flex-col items-center justify-center text-center opacity-50">
        <div class="w-24 h-24 bg-white/5 rounded-3xl flex items-center justify-center text-gray-600 mb-8 border border-white/10">
            <span class="material-symbols-outlined text-6xl">folder_off</span>
        </div>
        <h3 class="text-2xl font-black text-white mb-3">Vazio Galáctico</h3>
        <p class="text-gray-500 font-medium max-w-sm mx-auto mb-10">Tente ajustar seus filtros ou comece criando seu primeiro projeto agora mesmo para popular seu dashboard.</p>
        <a href="/admin/projetos/criar" class="bg-white text-black px-10 py-4 rounded-2xl font-black uppercase text-xs tracking-widest hover:bg-orange-500 hover:text-white transition-all shadow-2xl">Initialize Workspace</a>
    </div>
    {{/each}}
</div>

<!-- Pagination -->
{{#if pagination.pages}}
<div class="mt-16 flex justify-center pb-12">
    <nav class="flex items-center gap-3 bg-white/5 p-3 rounded-[2rem] border border-white/10 shadow-2xl shadow-black/40">
        {{#if pagination.hasPrev}}
            <a href="?page={{pagination.prevPage}}" class="w-12 h-12 flex items-center justify-center rounded-2xl text-gray-500 hover:bg-orange-500 hover:text-white transition-all shadow-lg hover:rotate-12">
                <span class="material-symbols-outlined">chevron_left</span>
            </a>
        {{/if}}
        
        {{#each pagination.pages}}
            <a href="?page={{this.number}}" class="w-12 h-12 flex items-center justify-center rounded-2xl text-xs font-black uppercase tracking-widest {{#if this.active}}bg-orange-500 text-white shadow-2xl shadow-orange-500/40 ring-2 ring-white/20{{else}}text-gray-500 hover:bg-white/10 hover:text-white{{/if}} transition-all">
                {{this.number}}
            </a>
        {{/each}}
        
        {{#if pagination.hasNext}}
            <a href="?page={{pagination.nextPage}}" class="w-12 h-12 flex items-center justify-center rounded-2xl text-gray-500 hover:bg-orange-500 hover:text-white transition-all shadow-lg hover:-rotate-12">
                <span class="material-symbols-outlined">chevron_right</span>
            </a>
        {{/if}}
    </nav>
</div>
{{/if}}


<!-- New Project Modal -->
<div class="modal fade" id="newProjectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-white/10 bg-[#0f0f0f]/95 backdrop-blur-2xl">
            <div class="modal-header border-white/5 p-6">
                <h5 class="text-lg font-black text-white tracking-tight flex items-center gap-3">
                    <span class="material-symbols-outlined text-orange-500">add_photo_alternate</span>
                    Novo Projeto no Portfólio
                </h5>
                <button type="button" class="btn-close btn-close-white opacity-50 hover:opacity-100 transition-opacity" data-bs-dismiss="modal"></button>
            </div>
            <form id="newProjectForm">
                <div class="modal-body p-6 space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Título do Projeto *</label>
                            <input type="text" name="title" required class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="Ex: Residência Alpha">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Categoria *</label>
                            <select name="category" required class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
                                <option value="render" class="bg-[#0f0f0f]">Renderização</option>
                                <option value="3d" class="bg-[#0f0f0f]">Modelagem 3D</option>
                                <option value="animation" class="bg-[#0f0f0f]">Animação</option>
                                <option value="product" class="bg-[#0f0f0f]">Produto</option>
                                <option value="architectural" class="bg-[#0f0f0f]">Arquitetônico</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Cliente</label>
                            <input type="text" name="client" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="Nome do cliente">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Ano</label>
                            <input type="number" name="year" value="2026" min="2000" max="2030" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Tags</label>
                            <input type="text" name="tags" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="3D, render...">
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Descrição</label>
                        <textarea name="description" rows="3" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all resize-none" placeholder="Detalhes do projeto..."></textarea>
                    </div>

                    <div class="flex items-center gap-6">
                        <label class="flex items-center gap-2 cursor-pointer group">
                            <input type="checkbox" name="isActive" checked class="w-4 h-4 rounded bg-white/5 border-white/20 text-orange-500 focus:ring-orange-500/50">
                            <span class="text-xs font-bold text-gray-400 group-hover:text-white transition-colors">Projeto Ativo</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer group">
                            <input type="checkbox" name="isFeatured" class="w-4 h-4 rounded bg-white/5 border-white/20 text-orange-500 focus:ring-orange-500/50">
                            <span class="text-xs font-bold text-gray-400 group-hover:text-white transition-colors">Destaque</span>
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-white/5 p-6">
                    <button type="button" class="px-6 py-3 text-xs font-black text-gray-500 uppercase tracking-widest hover:text-white transition-all" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white font-black py-3 px-8 rounded-xl shadow-lg shadow-orange-500/20 transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">rocket_launch</span>
                        Criar Projeto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function clearFilters() {
        document.getElementById('filterForm').reset();
        window.location.href = '/admin/projetos';
    }

    async function deleteProject(id) {
        if (!confirm('Tem certeza que deseja excluir este projeto?')) return;
        try {
            const response = await fetch(`/admin/projetos/${id}`, { method: 'DELETE' });
            if (response.ok) location.reload();
            else alert('Erro ao excluir projeto');
        } catch (error) {
            console.error(error);
        }
    }

    document.getElementById('newProjectForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        const data = Object.fromEntries(formData.entries());
        data.isActive = formData.has('isActive');
        data.isFeatured = formData.has('isFeatured');
        
        try {
            const response = await fetch('/admin/projetos/criar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            
            const result = await response.json();
            if (result.success) {
                window.location.reload();
            } else {
                alert('Erro: ' + result.message);
            }
        } catch (error) {
            console.error('Error creating project:', error);
            alert('Erro ao criar projeto');
        }
    });
</script>

