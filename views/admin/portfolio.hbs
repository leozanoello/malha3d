<div class="flex flex-col min-h-screen" style="background:#0a0c10;">
    <style>
        body, html { background: #0a0c10 !important; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }

        /* KCARD design token — same spec as admin widgets */
        .kcard {
            background: #151515;
            border-radius: 5px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.6);
            border: 1px solid rgba(255,255,255,0.06);
        }

        /* Hero glow accents (orange brand) */
        .pf-hero {
            position: relative;
            overflow: hidden;
        }
        .pf-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -10%;
            width: 60%;
            height: 200%;
            background: radial-gradient(circle, rgba(249,115,22,0.18) 0%, transparent 60%);
            pointer-events: none;
            z-index: 0;
        }
        .pf-hero::after {
            content: '';
            position: absolute;
            bottom: -50%;
            right: -10%;
            width: 50%;
            height: 200%;
            background: radial-gradient(circle, rgba(249,115,22,0.10) 0%, transparent 60%);
            pointer-events: none;
            z-index: 0;
        }
        .pf-hero-inner { position: relative; z-index: 1; }

        /* Filter chip */
        .pf-chip {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.10);
            color: rgba(255,255,255,0.65);
            font-size: 10px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            padding: 8px 16px;
            border-radius: 9999px;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .pf-chip:hover {
            background: rgba(255,255,255,0.08);
            color: #fff;
            border-color: rgba(255,255,255,0.20);
        }
        .pf-chip.active {
            background: rgba(249,115,22,0.15);
            color: #fdba74;
            border-color: rgba(249,115,22,0.40);
            box-shadow: 0 0 20px rgba(249,115,22,0.15);
        }

        /* Masonry via CSS columns (3 lg / 2 md / 1 sm) */
        .pf-masonry {
            column-count: 1;
            column-gap: 16px;
        }
        @media (min-width: 768px) { .pf-masonry { column-count: 2; } }
        @media (min-width: 1024px) { .pf-masonry { column-count: 3; } }

        .pf-masonry .pf-item {
            break-inside: avoid;
            margin-bottom: 16px;
            display: block;
        }

        /* Placeholder image (16:9) */
        .pf-img {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            background: #1f2937;
            overflow: hidden;
            border-radius: 5px 5px 0 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .pf-img .material-symbols-outlined {
            font-size: 56px;
            color: rgba(255,255,255,0.25);
        }
        .pf-img::after {
            content: '';
            position: absolute; inset: 0;
            background: linear-gradient(180deg, transparent 50%, rgba(0,0,0,0.55));
        }

        /* Type badge */
        .pf-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            z-index: 2;
            padding: 4px 10px;
            border-radius: 9999px;
            font-size: 9px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            backdrop-filter: blur(8px);
        }
        .pf-badge.render { background: rgba(249,115,22,0.85); color: #fff; }
        .pf-badge.anim   { background: rgba(59,130,246,0.85); color: #fff; }
        .pf-badge.tour   { background: rgba(16,185,129,0.85); color: #fff; }
        .pf-badge.planta { background: rgba(168,85,247,0.85); color: #fff; }

        /* Lightbox modal (pure CSS + JS) */
        .pf-lightbox {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.92);
            backdrop-filter: blur(12px);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .pf-lightbox.show {
            display: flex;
            animation: pfFadeIn 0.25s ease-out;
        }
        @keyframes pfFadeIn { from { opacity: 0; } to { opacity: 1; } }
        .pf-lightbox-content {
            max-width: 1100px;
            width: 100%;
            background: #151515;
            border-radius: 5px;
            border: 1px solid rgba(255,255,255,0.08);
            box-shadow: 0 25px 60px rgba(0,0,0,0.8);
            overflow: hidden;
            position: relative;
            animation: pfSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes pfSlideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .pf-lightbox-close {
            position: absolute;
            top: 12px;
            right: 12px;
            width: 40px;
            height: 40px;
            border-radius: 9999px;
            background: rgba(0,0,0,0.5);
            border: 1px solid rgba(255,255,255,0.15);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 10;
            transition: all 0.2s;
        }
        .pf-lightbox-close:hover {
            background: rgba(249,115,22,0.8);
            border-color: rgba(249,115,22,1);
        }

        /* Custom scrollbar */
        .pf-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
        .pf-scroll::-webkit-scrollbar-thumb { background: rgba(249,115,22,0.3); border-radius: 9999px; }
        .pf-scroll::-webkit-scrollbar-track { background: transparent; }
    </style>

