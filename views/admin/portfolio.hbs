    <div class="lg:col-span-1 space-y-8">
        <div class="glass-card p-6 border-white/5 bg-white/[0.01]">
            <h3 class="text-[10px] font-black text-gray-600 uppercase tracking-[0.3em] mb-6 px-4">Categorias</h3>
            <div class="space-y-2">
                <button class="w-full text-left px-5 py-3 rounded-xl bg-orange-500 text-white font-black text-xs uppercase tracking-widest shadow-2xl shadow-orange-500/20 transition-all">Todos os Trabalhos</button>
                <button class="w-full text-left px-5 py-3 rounded-xl text-gray-500 hover:text-white hover:bg-white/5 font-black text-xs uppercase tracking-widest transition-all">Personagens 3D</button>
                <button class="w-full text-left px-5 py-3 rounded-xl text-gray-500 hover:text-white hover:bg-white/5 font-black text-xs uppercase tracking-widest transition-all">Arquitetura</button>
                <button class="w-full text-left px-5 py-3 rounded-xl text-gray-500 hover:text-white hover:bg-white/5 font-black text-xs uppercase tracking-widest transition-all">Animações</button>
                <button class="w-full text-left px-5 py-3 rounded-xl text-gray-500 hover:text-white hover:bg-white/5 font-black text-xs uppercase tracking-widest transition-all">Modelagem Industrial</button>
            </div>
        </div>

        <div class="glass-card p-8 border-none bg-gradient-to-br from-gray-900 to-black relative overflow-hidden group">
