<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- JS — bottom, no Handlebars tokens inside <script>                -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<script>
(function() {
    'use strict';

    // ─── 1. Try fetching from API first (graceful fallback to server-rendered data) ───
    var grid = document.getElementById('pf-masonry');
    if (!grid) return;

    fetch('/admin/api/portfolio', { headers: { 'Accept': 'application/json' } })
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(data) {
            if (data && data.success && Array.isArray(data.projects) && data.projects.length > 0) {
                // Only overwrite if we got actual API data
                grid.innerHTML = data.projects.map(function(p, i) {
                    return buildItemHTML(p, i);
                }).join('');
                rebindLightbox();
            }
        })
        .catch(function() { /* stay with server-rendered items */ });

    function buildItemHTML(p, idx) {
        var type = String(p.type || 'Renderização');
        var typeSlug = type.toLowerCase()
            .replace('renderização', 'render')
            .replace('animação', 'anim')
            .replace('tour virtual', 'tour')
            .replace('planta humanizada', 'planta')
            .replace(/\s+/g, '-');
        var title = escapeHTML(p.title || 'Projeto sem título');
        var client = escapeHTML(p.client || 'Cliente não informado');
        return '<article class="pf-item kcard" data-type="' + typeSlug + '">' +
            '<div class="pf-img" onclick="window.pfOpenLightbox(' + idx + ')">' +
            '<span class="pf-badge ' + typeSlug + '">' + escapeHTML(type) + '</span>' +
            '<span class="material-symbols-outlined">image</span>' +
            '</div>' +
            '<div class="p-4">' +
            '<h3 class="text-sm font-black text-white truncate mb-1">' + title + '</h3>' +
            '<p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mb-3">' +
            '<span class="material-symbols-outlined text-[12px] align-middle mr-1">person</span>' +
            client + '</p>' +
            '<button class="w-full inline-flex items-center justify-center gap-1.5 py-2 rounded text-[10px] font-black uppercase tracking-widest" ' +
            'style="background:rgba(249,115,22,0.10); color:#fdba74; border:1px solid rgba(249,115,22,0.30);" ' +
            'onclick="window.pfOpenLightbox(' + idx + ')">' +
            '<span class="material-symbols-outlined text-[12px]">visibility</span> Ver Detalhes' +
            '</button>' +
            '</div>' +
            '</article>';
    }

    function escapeHTML(s) {
        if (s == null) return '';
        return String(s).replace(/[&<>"']/g, function(c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    // ─── 2. Lightbox ───────────────────────────────────────────────────
    var lightbox = document.getElementById('pf-lightbox');

    function getItems() {
        return Array.prototype.slice.call(grid.querySelectorAll('.pf-item'));
    }

    function openLightbox(idx) {
        var items = getItems();
        var item = items[idx];
        if (!item || !lightbox) return;
        var title = item.querySelector('h3');
        var client = item.querySelector('p');
        var badge = item.querySelector('.pf-badge');
        document.getElementById('pf-lb-title').textContent = title ? title.textContent : '';
        document.getElementById('pf-lb-client').textContent = client ? client.textContent.replace(/PERSON/g, '').trim() : '';
        var badgeEl = document.getElementById('pf-lb-badge');
        if (badgeEl && badge) {
            badgeEl.textContent = badge.textContent;
            badgeEl.className = 'inline-block px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-widest mb-3 ' + badge.className.replace('pf-badge', '');
        }
        lightbox.classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove('show');
        document.body.style.overflow = '';
    }

    window.pfOpenLightbox = openLightbox;
    window.pfCloseLightbox = closeLightbox;

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeLightbox();
    });

    function rebindLightbox() {
        // (clicks are bound inline, nothing to do — placeholder for future unbinding)
    }

    // ─── 3. Filter chips ───────────────────────────────────────────────
    var chips = document.querySelectorAll('#pf-filters .pf-chip');
    var emptyMsg = document.getElementById('pf-empty');

    chips.forEach(function(chip) {
        chip.addEventListener('click', function() {
            chips.forEach(function(c) { c.classList.remove('active'); });
            chip.classList.add('active');

            var filter = chip.getAttribute('data-filter') || 'all';
            var items = getItems();
            var visibleCount = 0;

            items.forEach(function(it) {
                var type = it.getAttribute('data-type') || '';
                var match = (filter === 'all') || (type === filter);
                it.style.display = match ? '' : 'none';
                if (match) visibleCount++;
            });

            if (emptyMsg) {
                if (visibleCount === 0) emptyMsg.classList.remove('hidden');
                else emptyMsg.classList.add('hidden');
            }
        });
    });

})();
</script>
