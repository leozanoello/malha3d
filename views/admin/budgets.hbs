<div class="p-8">
    <!-- Header -->
    <div class="mb-10 flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
        <div>
            <h1 class="text-4xl font-black text-white tracking-tight mb-2">
                Oportunidades & <span class="text-orange-500">Propostas</span>
            </h1>
            <p class="text-gray-400 font-medium max-w-xl">
                Gestão centralizada de orçamentos. Transforme leads em projetos com o ecossistema <span class="text-orange-500">Zanoello 3D</span>.
            </p>
        </div>
        <div class="flex gap-4">
            <button class="bg-white/5 hover:bg-white/10 text-white font-black py-4 px-6 rounded-2xl border border-white/10 transition-all flex items-center gap-3 text-[10px] uppercase tracking-widest">
                <span class="material-symbols-outlined text-sm">download</span> Exportar Relatório
            </button>
            <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-8 rounded-2xl shadow-2xl shadow-orange-500/40 transition-all flex items-center gap-3 text-[10px] uppercase tracking-widest" data-bs-toggle="modal" data-bs-target="#newProposalModal">
                <span class="material-symbols-outlined">add_circle</span> Nova Proposta
            </button>
        </div>
    </div>

    <!-- Metrics Row -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
        <div class="glass-card p-6 border-white/5 bg-white/2">
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Total em Aberto</p>
            <h3 class="text-2xl font-black text-white">R$ 142.500</h3>
        </div>
        <div class="glass-card p-6 border-white/5 bg-white/2">
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Conversão</p>
            <h3 class="text-2xl font-black text-white">34% <span class="text-[10px] text-green-500 font-bold ml-2">↑ 5%</span></h3>
        </div>
        <div class="glass-card p-6 border-white/5 bg-white/2">
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Ticket Médio</p>
            <h3 class="text-2xl font-black text-white">R$ 8.400</h3>
        </div>
        <div class="glass-card p-6 border-white/5 bg-white/2">
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Tempo de Resposta</p>
            <h3 class="text-2xl font-black text-white">1.2 dias</h3>
        </div>
    </div>

    <!-- Grid Layout for Proposals -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
        {{#each budgets}}
        <div class="glass-card p-8 border-white/5 bg-white/2 hover:border-orange-500/30 transition-all group relative overflow-hidden">
            <div class="absolute top-0 right-0 p-4 opacity-0 group-hover:opacity-100 transition-all flex gap-2">
                <button class="w-10 h-10 rounded-xl bg-orange-500/10 text-orange-500 flex items-center justify-center hover:bg-orange-500 hover:text-white transition-all" onclick="openLeadDetails('{{this.id}}')">
                    <span class="material-symbols-outlined text-base">edit</span>
                </button>
                <button class="w-10 h-10 rounded-xl bg-red-500/10 text-red-500 flex items-center justify-center hover:bg-red-500 hover:text-white transition-all">
                    <span class="material-symbols-outlined text-base">delete</span>
                </button>
            </div>

            <div class="flex items-center gap-4 mb-6">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-white/10 to-white/5 flex items-center justify-center text-xl font-black text-orange-500 border border-white/10">
                    {{firstLetter name}}
                </div>
                <div>
                    <h3 class="text-lg font-black text-white leading-tight mb-1">{{name}}</h3>
                    <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">#ORC-{{substring id 0 6}}</p>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="p-4 rounded-2xl bg-black/20 border border-white/5">
                    <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-1">Valor Estimado</p>
                    <p class="text-sm font-black text-emerald-500">{{formatCurrency estimatedValue}}</p>
                </div>
                <div class="p-4 rounded-2xl bg-black/20 border border-white/5">
                    <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-1">Probabilidade</p>
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-black text-white">{{probability}}%</span>
                        <div class="flex-1 h-1 bg-white/10 rounded-full overflow-hidden">
                            <div class="h-full bg-orange-500" style="width: {{probability}}%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="space-y-4 mb-8">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-gray-500 text-sm">mail</span>
                    <span class="text-[10px] font-bold text-gray-300">{{email}}</span>
                </div>
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-gray-500 text-sm">deployed_code</span>
                    <span class="text-[10px] font-bold text-gray-300 uppercase">{{software}}</span>
                </div>
            </div>

            <div class="flex justify-between items-center pt-6 border-t border-white/5">
                <span class="px-3 py-1.5 rounded-xl bg-orange-500/10 text-orange-500 text-[8px] font-black uppercase tracking-widest">{{status}}</span>
                <p class="text-[8px] font-bold text-gray-500 uppercase tracking-widest">Emitido em: {{formatDate createdAt}}</p>
            </div>
        </div>
        {{else}}
        <div class="col-span-full py-20 text-center opacity-30">
            <span class="material-symbols-outlined text-6xl mb-4">description</span>
            <p class="text-xl font-black uppercase tracking-widest">Nenhuma proposta gerada ainda</p>
        </div>
        {{/each}}
    </div>
</div>

<!-- Modal: Nova Proposta (Liquid Glass) -->
<div class="modal fade" id="newProposalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card p-4 border-white/10 bg-dark-950/95">
            <div class="flex justify-between items-center mb-8 px-4">
                <h3 class="text-xl font-black text-white uppercase tracking-tighter">Nova <span class="text-orange-500">Proposta Comercial</span></h3>
                <button type="button" class="text-gray-500 hover:text-white" data-bs-dismiss="modal"><span class="material-symbols-outlined">close</span></button>
            </div>
            <form id="newProposalForm" class="p-4 grid grid-cols-2 gap-6">
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Nome do Prospect</label>
                    <input type="text" name="name" required class="input-premium" placeholder="Ex: Arq. Ricardo Mendes">
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">E-mail</label>
                    <input type="email" name="email" required class="input-premium" placeholder="contato@empresa.com">
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Valor Estimado (R$)</label>
                    <input type="number" name="estimatedValue" step="0.01" class="input-premium" placeholder="0.00">
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Probabilidade (%)</label>
                    <input type="number" name="probability" value="50" class="input-premium">
                </div>
                <div class="col-span-2 space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Resumo do Escopo</label>
                    <textarea name="notes" class="input-premium h-32" placeholder="Descreva os entregáveis e prazos..."></textarea>
                </div>
                <div class="col-span-2 flex gap-4 pt-4">
                    <button type="submit" class="flex-1 py-4 rounded-2xl bg-orange-500 text-white font-black uppercase tracking-widest shadow-xl shadow-orange-500/20 hover:scale-[1.02] transition-all">
                        Gerar e Enviar Proposta
                    </button>
                    <button type="button" class="px-8 rounded-2xl bg-white/5 text-white font-black uppercase tracking-widest hover:bg-white/10" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function openLeadDetails(id) {
    window.location.href = `/admin/crm?leadId=${id}`;
}

document.getElementById('newProposalForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const data = Object.fromEntries(formData.entries());
    
    data.status = 'novo_lead';
    data.estimatedValue = parseFloat(data.estimatedValue) || 0;

    try {
        const response = await fetch('/admin/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        if (result.success) window.location.reload();
        else alert('Erro: ' + result.message);
    } catch (e) { console.error(e); }
});
</script>
