<div class="p-8">
    <!-- Header -->
    <div class="mb-10 flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
        <div>
            <h1 class="text-4xl font-black text-white tracking-tight mb-2">
                Oportunidades & <span class="text-orange-500">Propostas</span>
            </h1>
            <p class="text-gray-400 font-medium max-w-xl">
                Gestão centralizada de orçamentos. Transforme leads em projetos com o ecossistema <span class="text-orange-500">Malha 3D</span>.
            </p>
        </div>
        <div class="flex gap-4">
            <button class="bg-white/5 hover:bg-white/10 text-white font-black py-4 px-6 rounded-2xl border border-white/10 transition-all flex items-center gap-3 text-[10px] uppercase tracking-widest">
                <span class="material-symbols-outlined text-sm">download</span> Exportar Relatório
            </button>
            <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-8 rounded-2xl shadow-2xl shadow-orange-500/40 transition-all flex items-center gap-3 text-[10px] uppercase tracking-widest" data-bs-toggle="modal" data-bs-target="#newProposalModal">
                <span class="material-symbols-outlined">add_circle</span> Nova Proposta
            </button>
        </div>
    </div>

    <!-- Metrics Row -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
        <div class="glass-card p-6 border-white/5 bg-white/2">
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Total em Aberto</p>
            <h3 class="text-2xl font-black text-white">R$ 142.500</h3>
        </div>
        <div class="glass-card p-6 border-white/5 bg-white/2">
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Conversão</p>
            <h3 class="text-2xl font-black text-white">34% <span class="text-[10px] text-green-500 font-bold ml-2">↑ 5%</span></h3>
        </div>
        <div class="glass-card p-6 border-white/5 bg-white/2">
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Ticket Médio</p>
            <h3 class="text-2xl font-black text-white">R$ 8.400</h3>
        </div>
        <div class="glass-card p-6 border-white/5 bg-white/2">
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Tempo de Resposta</p>
            <h3 class="text-2xl font-black text-white">1.2 dias</h3>
        </div>
    </div>

    <!-- Control Bar (Busca + Alternador de Visualizações) -->
    <div class="mb-6 flex flex-col md:flex-row gap-4 items-center justify-between p-4 glass-card bg-black/20 border-white/5 relative z-10">
        <!-- Search -->
        <div class="relative w-full md:w-96">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-500">
                <span class="material-symbols-outlined text-sm">search</span>
            </span>
            <input type="text" id="unified-search" class="w-full pl-10 pr-4 py-2.5 bg-black/40 border border-white/5 rounded-xl text-xs font-medium text-white focus:outline-none focus:border-orange-500/50 transition-all placeholder-gray-500" placeholder="Buscar por proposta, cliente ou tipo...">
        </div>
        <!-- View Toggle -->
        <div class="flex items-center gap-1.5 bg-black/40 p-1 rounded-xl border border-white/5">
            <button onclick="changeView('grid')" id="btn-view-grid" class="view-toggle-btn px-4 py-2 rounded-lg text-[9px] font-black uppercase tracking-widest text-orange-500 bg-orange-500/10 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">grid_view</span> Quadro
            </button>
            <button onclick="changeView('list')" id="btn-view-list" class="view-toggle-btn px-4 py-2 rounded-lg text-[9px] font-black uppercase tracking-widest text-gray-400 hover:text-white transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">list</span> Lista
            </button>
            <button onclick="changeView('spreadsheet')" id="btn-view-spreadsheet" class="view-toggle-btn px-4 py-2 rounded-lg text-[9px] font-black uppercase tracking-widest text-gray-400 hover:text-white transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">table_chart</span> Planilha
            </button>
        </div>
    </div>

    <!-- Grid Layout for Proposals -->
    <div id="view-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
        {{#each budgets}}
        <div class="glass-card p-6 border-white/5 bg-white/2 hover:border-orange-500/30 hover:scale-[1.01] transition-all cursor-pointer group relative overflow-hidden" 
             onclick="openLeadDetails('{{this.id}}')"
             style="border-left: 3px solid #f97316;">
            <!-- Progress Bar -->
            <div class="absolute top-0 left-0 w-full h-1 bg-white/5">
                <div class="h-full bg-orange-500" style="width: {{this.probability}}%; box-shadow: 0 0 8px #f97316;"></div>
            </div>

            <!-- Discrete Proposal Header Banner -->
            <div class="mb-4 px-2.5 py-1 rounded bg-white/5 border border-white/5 flex items-center justify-between text-[7px] font-black uppercase tracking-widest text-gray-400">
                <span class="flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-orange-500" style="box-shadow: 0 0 4px #f97316;"></span>
                    {{#if this.projectType}}{{this.projectType}}{{else}}Imagens 3D{{/if}}
                </span>
                <span class="font-black text-orange-400">{{this.probability}}% Probabilidade</span>
            </div>

            <div class="flex justify-between items-start mb-4">
                <div>
                    <h3 class="text-sm font-black text-white leading-tight mb-1 card-name">{{this.name}}</h3>
                    <p class="text-[8px] text-gray-500 font-black uppercase tracking-wider flex items-center gap-1.5 flex-wrap">
                        {{#if this.client.company}}{{this.client.company}}{{else}}Sem Empresa{{/if}} • 
                        <span class="font-mono opacity-20 hover:opacity-100 transition-opacity duration-300 text-[8px] cursor-help tracking-tighter select-all">#ORC-{{this.id}}</span>
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    {{#if this.client.phone}}
                    <a href="{{formatWhatsappLink this.client.phone this.client.name 'lead'}}" 
                       target="_blank" 
                       onclick="event.stopPropagation();" 
                       class="w-7 h-7 rounded-xl bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500/20 transition-all flex items-center justify-center">
                        <i class="fab fa-whatsapp text-[10px]"></i>
                    </a>
                    {{/if}}
                    <a href="/admin/orcamento/{{this.id}}" 
                       onclick="event.stopPropagation();" 
                       class="w-7 h-7 rounded-xl bg-white/5 text-gray-400 hover:bg-white/10 hover:text-white transition-all flex items-center justify-center">
                        <span class="material-symbols-outlined text-[14px]">visibility</span>
                    </a>
                </div>
            </div>

            <!-- Technical Specification Badges (CRM Parity) -->
            <div class="flex flex-wrap gap-1.5 mb-4 border-b border-white/5 pb-4">
                {{#if this.imagesCount}}
                <span class="px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-[7px] font-black text-gray-400 uppercase tracking-wide flex items-center gap-1">
                    <span class="material-symbols-outlined text-[10px] text-cyber-500">photo_camera</span>
                    {{this.imagesCount}} Renders
                </span>
                {{/if}}
                {{#if this.animationSeconds}}
                <span class="px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-[7px] font-black text-gray-400 uppercase tracking-wide flex items-center gap-1">
                    <span class="material-symbols-outlined text-[10px] text-orange-500">movie</span>
                    {{this.animationSeconds}}s Animação
                </span>
                {{/if}}
                {{#if this.panoramasCount}}
                <span class="px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-[7px] font-black text-gray-400 uppercase tracking-wide flex items-center gap-1">
                    <span class="material-symbols-outlined text-[10px] text-emerald-500">360</span>
                    {{this.panoramasCount}} Tour VR
                </span>
                {{/if}}
                {{#if this.totalArea}}
                <span class="px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-[7px] font-black text-gray-400 uppercase tracking-wide flex items-center gap-1">
                    <span class="material-symbols-outlined text-[10px] text-purple-500">square_foot</span>
                    {{this.totalArea}} m²
                </span>
                {{/if}}
                {{#if this.productionDays}}
                <span class="px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-[7px] font-black text-gray-400 uppercase tracking-wide flex items-center gap-1">
                    <span class="material-symbols-outlined text-[10px] text-blue-500">schedule</span>
                    {{this.productionDays}}d Prod.
                </span>
                {{/if}}
                {{#if this.lod}}
                <span class="px-2 py-0.5 rounded-md bg-orange-500/10 border border-orange-500/10 text-[7px] font-black text-orange-400 uppercase tracking-wide">
                    {{this.lod}}
                </span>
                {{/if}}
            </div>

            <!-- Commercial values and estimates -->
            <div class="grid grid-cols-2 gap-4">
                <div class="p-3 rounded-xl bg-black/20 border border-white/5">
                    <p class="text-[7px] font-black text-gray-500 uppercase tracking-widest mb-0.5">Valor Estimado</p>
                    <p class="text-xs font-black text-emerald-500">{{formatCurrency this.estimatedValue}}</p>
                </div>
                <div class="p-3 rounded-xl bg-black/20 border border-white/5">
                    <p class="text-[7px] font-black text-gray-500 uppercase tracking-widest mb-0.5">Status Proposta</p>
                    <p class="text-[8px] font-black text-orange-400 uppercase tracking-widest mt-0.5">{{this.status}}</p>
                </div>
            </div>

            <!-- Representative & Expected Revenue Closing Details -->
            <div class="flex items-center justify-between mt-4 pt-4 border-t border-white/5 text-[8px] font-black text-gray-500 uppercase tracking-wider">
                <div class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-[11px] text-gray-600">account_circle</span>
                    <span>Resp: <span class="text-white">{{#if this.assignedUser.name}}{{this.assignedUser.name}}{{else}}Sem Resp.{{/if}}</span></span>
                </div>
                <div class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-[11px] text-gray-600">calendar_month</span>
                    <span>Previsão: <span class="text-white">{{#if this.expectedRevenueDate}}{{formatDate this.expectedRevenueDate 'short'}}{{else}}A definir{{/if}}</span></span>
                </div>
            </div>
        </div>
        {{else}}
        <div class="col-span-full py-20 text-center opacity-30">
            <span class="material-symbols-outlined text-6xl mb-4">description</span>
            <p class="text-xl font-black uppercase tracking-widest">Nenhuma proposta gerada ainda</p>
        </div>
        {{/each}}
    </div>

    <!-- List Layout for Proposals -->
    <div id="view-list" class="space-y-4 hidden">
        {{#each budgets}}
        <div class="glass-card p-4 border-white/5 bg-white/2 hover:border-orange-500/30 transition-all cursor-pointer flex flex-col md:flex-row md:items-center justify-between gap-4 budget-item-row" onclick="openLeadDetails('{{this.id}}')" data-search="{{this.name}} {{this.client.company}} {{this.projectType}} {{this.status}}">
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-xl bg-orange-500/10 flex items-center justify-center text-orange-500">
                    <span class="material-symbols-outlined">request_quote</span>
                </div>
                <div>
                    <h4 class="text-xs font-black text-white card-name">{{this.name}}</h4>
                    <p class="text-[8px] text-gray-500 font-bold uppercase tracking-wider mt-0.5">
                        {{#if this.client.company}}{{this.client.company}}{{else}}Sem Empresa{{/if}} • 
                        <span class="font-mono opacity-20 hover:opacity-100 transition-opacity duration-300 text-[8px] cursor-help tracking-tighter select-all">#ORC-{{this.id}}</span>
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-6">
                <div class="text-right">
                    <span class="px-2 py-0.5 rounded bg-white/5 border border-white/5 text-[8px] font-black text-gray-400 uppercase tracking-wide">
                        {{this.projectType}}
                    </span>
                </div>
                <div class="text-right">
                    <span class="px-2.5 py-0.5 rounded-full bg-orange-500/10 text-orange-500 border border-orange-500/20 text-[8px] font-black uppercase tracking-wider">
                        {{this.status}}
                    </span>
                </div>
                <div class="text-right w-24">
                    <p class="text-[9px] font-black text-emerald-500 font-mono">{{formatCurrency this.estimatedValue}}</p>
                </div>
                <div onclick="event.stopPropagation();">
                    <a href="/admin/orcamento/{{this.id}}" class="w-8 h-8 rounded-xl bg-white/5 text-gray-400 hover:text-white flex items-center justify-center">
                        <span class="material-symbols-outlined text-[14px]">visibility</span>
                    </a>
                </div>
            </div>
        </div>
        {{else}}
        <div class="py-20 text-center opacity-30">
            <span class="material-symbols-outlined text-6xl mb-4">description</span>
            <p class="text-xl font-black uppercase tracking-widest">Nenhuma proposta gerada ainda</p>
        </div>
        {{/each}}
    </div>

    <!-- Spreadsheet Layout for Proposals -->
    <div id="view-spreadsheet" class="glass-card border-white/5 bg-white/2 overflow-hidden hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-white/5 bg-black/40 text-[9px] font-black text-gray-500 uppercase tracking-widest">
                        <th class="p-4">Proposta</th>
                        <th class="p-4">Cliente / Empresa</th>
                        <th class="p-4">Tipo</th>
                        <th class="p-4">Status</th>
                        <th class="p-4">Valor Estimado</th>
                        <th class="p-4">Previsão Fechamento</th>
                        <th class="p-4 text-right">Ações</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    {{#each budgets}}
                    <tr class="hover:bg-white/[0.02] transition-all cursor-pointer budget-item-row" onclick="openLeadDetails('{{this.id}}')" data-search="{{this.name}} {{this.client.company}} {{this.projectType}} {{this.status}}">
                        <td class="p-4">
                            <span class="text-xs font-black text-white block card-name">{{this.name}}</span>
                            <span class="font-mono opacity-20 hover:opacity-100 transition-opacity duration-300 text-[8px] cursor-help tracking-tighter select-all">#ORC-{{this.id}}</span>
                        </td>
                        <td class="p-4 text-xs font-medium text-gray-400">
                            {{#if this.client.company}}{{this.client.company}}{{else}}Sem Empresa{{/if}}
                        </td>
                        <td class="p-4 text-xs font-bold text-gray-400">
                            {{this.projectType}}
                        </td>
                        <td class="p-4">
                            <span class="px-2 py-0.5 rounded-full bg-orange-500/10 text-orange-500 border border-orange-500/20 text-[8px] font-black uppercase tracking-wider">
                                {{this.status}}
                            </span>
                        </td>
                        <td class="p-4 text-xs font-mono font-black text-emerald-500">
                            {{formatCurrency this.estimatedValue}}
                        </td>
                        <td class="p-4 text-xs font-medium text-gray-400">
                            {{#if this.expectedRevenueDate}}{{formatDate this.expectedRevenueDate 'short'}}{{else}}A definir{{/if}}
                        </td>
                        <td class="p-4 text-right" onclick="event.stopPropagation();">
                            <a href="/admin/orcamento/{{this.id}}" class="inline-flex w-8 h-8 rounded-xl bg-white/5 text-gray-400 hover:text-white items-center justify-center">
                                <span class="material-symbols-outlined text-[14px]">visibility</span>
                            </a>
                        </td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="7" class="p-8 text-center text-gray-500 opacity-40">
                            Nenhuma proposta cadastrada no momento.
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Nova Proposta (Liquid Glass) -->
<div class="modal fade" id="newProposalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card p-4 border-white/10 bg-dark-950/95">
            <div class="flex justify-between items-center mb-8 px-4">
                <h3 class="text-xl font-black text-white uppercase tracking-tighter">Nova <span class="text-orange-500">Proposta Comercial</span></h3>
                <button type="button" class="text-gray-500 hover:text-white" data-bs-dismiss="modal"><span class="material-symbols-outlined">close</span></button>
            </div>
            <form id="newProposalForm" class="p-4 grid grid-cols-2 gap-6">
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Nome do Prospect</label>
                    <input type="text" name="name" required class="input-premium" placeholder="Ex: Arq. Ricardo Mendes">
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">E-mail</label>
                    <input type="email" name="email" required class="input-premium" placeholder="contato@empresa.com">
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Valor Estimado (R$)</label>
                    <input type="number" name="estimatedValue" step="0.01" class="input-premium" placeholder="0.00">
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Probabilidade (%)</label>
                    <input type="number" name="probability" value="50" class="input-premium">
                </div>
                <div class="col-span-2 space-y-2">
                    <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Resumo do Escopo</label>
                    <textarea name="notes" class="input-premium h-20" placeholder="Descreva os entregáveis e prazos..."></textarea>
                </div>

                <!-- Sessão Técnica ArchViz -->
                <div class="col-span-2 mt-4 pt-6 border-t border-white/5">
                    <h4 class="text-[11px] font-black text-orange-500 uppercase tracking-[0.2em] mb-6">Especificações Técnicas (ArchViz Standard)</h4>
                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Nível de Detalhe (LOD)</label>
                            <select name="lod" class="input-premium py-2">
                                <option value="lod_100">LOD 100 - Volumétrico</option>
                                <option value="lod_200">LOD 200 - Esquemático</option>
                                <option value="lod_300" selected>LOD 300 - Executivo</option>
                                <option value="lod_400">LOD 400 - Fabricação</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Modelagem 3D</label>
                            <select name="modeling_style" class="input-premium py-2">
                                <option value="poly" selected>Poligonal (3dsMax/SKP)</option>
                                <option value="parametric">Paramétrica (BIM)</option>
                                <option value="organic">Orgânica (Blender)</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Setup de Iluminação</label>
                            <select name="lighting_setup" class="input-premium py-2">
                                <option value="daylight" selected>Daylight / Natural</option>
                                <option value="artificial">Artificial / Studio</option>
                                <option value="mixed">Mista / Crepúsculo</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Resolução</label>
                            <select name="resolution" class="input-premium py-2">
                                <option value="fhd">Full HD (1080p)</option>
                                <option value="4k" selected>4K Ultra HD</option>
                                <option value="8k">8K / Impressão</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Formato de Entrega</label>
                            <select name="format" class="input-premium py-2">
                                <option value="still" selected>Still (Estática)</option>
                                <option value="animation">Animação (Vídeo)</option>
                                <option value="360_vr">360° / VR</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Realismo Materiais</label>
                            <select name="materials_realism" class="input-premium py-2">
                                <option value="standard">PBR Standard</option>
                                <option value="advanced" selected>Advanced Shaders</option>
                                <option value="scanned">Megascans / Photoreal</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Mobiliário</label>
                            <select name="furniture_level" class="input-premium py-2">
                                <option value="library" selected>Standard Library</option>
                                <option value="high_end">High-End Brands</option>
                                <option value="custom">Custom Design</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Entorno / Contexto</label>
                            <select name="context_level" class="input-premium py-2">
                                <option value="generic" selected>3D Genérico</option>
                                <option value="photo_match">Photo Match (Drone)</option>
                                <option value="full_3d">Full 3D Environment</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Pós-Produção</label>
                            <select name="post_production" class="input-premium py-2">
                                <option value="standard" selected>Standard</option>
                                <option value="cinematic">Cinematic Grading</option>
                                <option value="vfx">VFX & Compositing</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Duração (Vídeos)</label>
                            <input type="text" name="animation_duration" class="input-premium py-2" placeholder="Ex: 30s">
                        </div>
                        <div class="space-y-2 flex items-end">
                            <label class="flex items-center gap-3 cursor-pointer p-3 rounded-xl bg-white/5 border border-white/5 hover:border-orange-500/30 transition-all w-full">
                                <input type="checkbox" name="humanization" value="true" checked class="accent-orange-500">
                                <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Humanização 3D</span>
                            </label>
                        </div>
                        <div class="space-y-2 flex items-end">
                            <label class="flex items-center gap-3 cursor-pointer p-3 rounded-xl bg-white/5 border border-white/5 hover:border-orange-500/30 transition-all w-full">
                                <input type="checkbox" name="vegetation" value="true" checked class="accent-orange-500">
                                <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Vegetação High-Poly</span>
                            </label>
                        </div>
                        <div class="space-y-2 flex items-end">
                            <label class="flex items-center gap-3 cursor-pointer p-3 rounded-xl bg-white/5 border border-white/5 hover:border-orange-500/30 transition-all w-full">
                                <input type="checkbox" name="ai_refinement" value="true" class="accent-orange-500">
                                <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Refinamento IA</span>
                            </label>
                        </div>
                        <div class="space-y-2 flex items-end">
                            <label class="flex items-center gap-3 cursor-pointer p-3 rounded-xl bg-white/5 border border-white/5 hover:border-orange-500/30 transition-all w-full">
                                <input type="checkbox" name="vr_support" value="true" class="accent-orange-500">
                                <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Suporte VR/360</span>
                            </label>
                        </div>
                        <div class="space-y-2 flex items-end">
                            <label class="flex items-center gap-3 cursor-pointer p-3 rounded-xl bg-white/5 border border-white/5 hover:border-orange-500/30 transition-all w-full">
                                <input type="checkbox" name="audio_track" value="true" class="accent-orange-500">
                                <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Trilha Sonora</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="col-span-2 flex gap-4 pt-4">
                    <button type="submit" class="flex-1 py-4 rounded-2xl bg-orange-500 text-white font-black uppercase tracking-widest shadow-xl shadow-orange-500/20 hover:scale-[1.02] transition-all">
                        Gerar e Enviar Proposta
                    </button>
                    <button type="button" class="px-8 rounded-2xl bg-white/5 text-white font-black uppercase tracking-widest hover:bg-white/10" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function openLeadDetails(id) {
    window.location.href = `/admin/negociacoes?leadId=${id}`;
}

// Persistent View Toggles & Dynamic Realtime Search
function changeView(mode) {
    localStorage.setItem('budgets_view_mode', mode);
    
    // Hide all views
    document.getElementById('view-grid').classList.add('hidden');
    document.getElementById('view-list').classList.add('hidden');
    document.getElementById('view-spreadsheet').classList.add('hidden');
    
    // Remove active styles on all buttons
    document.querySelectorAll('.view-toggle-btn').forEach(btn => {
        btn.classList.remove('text-orange-500', 'bg-orange-500/10');
        btn.classList.add('text-gray-400');
    });
    
    // Show current view and set active button style
    const targetView = document.getElementById('view-' + mode);
    if (targetView) targetView.classList.remove('hidden');
    
    const targetBtn = document.getElementById('btn-view-' + mode);
    if (targetBtn) {
        targetBtn.classList.remove('text-gray-400');
        targetBtn.classList.add('text-orange-500', 'bg-orange-500/10');
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const savedMode = localStorage.getItem('budgets_view_mode') || 'grid';
    changeView(savedMode);
    
    // Live Search filtering
    const searchInput = document.getElementById('unified-search');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const query = this.value.toLowerCase().trim();
            
            // Filter grid cards
            document.querySelectorAll('#view-grid > div').forEach(card => {
                const nameEl = card.querySelector('.card-name');
                if (!nameEl) return;
                const text = card.textContent.toLowerCase();
                if (text.includes(query)) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
            
            // Filter list rows
            document.querySelectorAll('#view-list .budget-item-row').forEach(row => {
                const text = row.getAttribute('data-search').toLowerCase();
                if (text.includes(query)) {
                    row.classList.remove('hidden');
                } else {
                    row.classList.add('hidden');
                }
            });
            
            // Filter spreadsheet rows
            document.querySelectorAll('#view-spreadsheet tbody tr').forEach(row => {
                const text = row.getAttribute('data-search').toLowerCase();
                if (text.includes(query)) {
                    row.classList.remove('hidden');
                } else {
                    row.classList.add('hidden');
                }
            });
        });
    }
});

document.getElementById('newProposalForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const data = Object.fromEntries(formData.entries());
    
    data.status = 'novo_lead';
    data.estimatedValue = parseFloat(data.estimatedValue) || 0;

    try {
        const response = await fetch('/admin/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        if (result.success) window.location.reload();
        else alert('Erro: ' + result.message);
    } catch (e) { console.error(e); }
});
</script>
