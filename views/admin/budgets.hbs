<!-- Header -->
<div class="mb-6 p-6 glass-card border-none bg-gradient-to-br from-white/5 to-white/[0.02]">
    <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-white tracking-tight mb-1">
                Propostas & <span class="text-gradient">Orçamentos</span>
            </h1>
            <p class="text-gray-400 font-medium text-xs">
                Gerencie, envie e converta propostas em projetos <span class="text-orange-500">Malha3D</span> com inteligência.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <div class="relative group">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-base group-focus-within:text-orange-500 transition-colors">search</span>
                <input type="text" id="searchBudget" placeholder="Buscar propostas..." class="bg-white/5 border border-white/10 rounded-xl py-2 pl-10 pr-4 text-xs font-medium text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500/50 transition-all w-56">
            </div>
            <select class="bg-[#1a1c23] border border-white/10 rounded-xl py-2 px-4 text-xs font-medium text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all cursor-pointer">
                <option value="todos">Todos os Status</option>
                <option value="novo">Novo</option>
                <option value="em_andamento">Em Andamento</option>
                <option value="fechado">Fechado</option>
            </select>
            <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-2 px-4 rounded-xl shadow-lg shadow-orange-500/20 transition-all flex items-center gap-2 text-xs" data-bs-toggle="modal" data-bs-target="#newBudgetModal">
                <span class="material-symbols-outlined text-base">add_circle</span>
                Nova Proposta
            </button>
        </div>
    </div>
</div>

<!-- IA Analysis Alert -->
<div class="mb-6 p-4 glass-card border-l-4 border-l-orange-500 bg-orange-500/5 relative overflow-hidden group rounded-xl">
    <div class="absolute top-0 right-0 w-24 h-24 bg-orange-500/10 rounded-full blur-2xl -mr-12 -mt-12 group-hover:bg-orange-500/20 transition-all"></div>
    <div class="relative z-10 flex items-center gap-4">
        <div class="w-10 h-10 bg-orange-500/10 rounded-xl flex items-center justify-center text-orange-500 border border-orange-500/20">
            <span class="material-symbols-outlined text-xl">auto_awesome</span>
        </div>
        <div>
            <h6 class="text-[10px] font-black text-orange-500 uppercase tracking-widest mb-0.5">Análise Malha3D IA</h6>
            <p class="text-xs text-gray-300">
                Propostas com desconto acima de 10% têm <strong class="text-orange-500">30% mais chance</strong> de fechamento este mês. Considere oferecer um desconto para a proposta pendente do cliente <strong class="text-white">Studio Alpha</strong>.
            </p>
        </div>
    </div>
</div>

<!-- Budgets Table -->
<div class="glass-card border-white/5 overflow-hidden rounded-xl">
    <div class="p-5 border-b border-white/5 flex items-center justify-between bg-white/[0.01]">
        <h3 class="text-base font-black text-white tracking-tight flex items-center gap-2">
            <span class="material-symbols-outlined text-orange-500 text-lg">request_quote</span>
            Lista de Orçamentos
            <span class="text-[10px] font-bold text-gray-500 ml-2">{{pagination.total}} registros</span>
        </h3>
        <div class="flex items-center gap-3">
            <div class="dropdown">
                <button class="bg-white/5 text-gray-400 font-bold py-1.5 px-3 rounded-lg border border-white/10 hover:text-white transition-all flex items-center gap-2 text-[10px] uppercase tracking-widest" type="button" data-bs-toggle="dropdown">
                    <span class="material-symbols-outlined text-xs">settings</span>
                    Ações em Massa
                </button>
                <ul class="dropdown-menu dropdown-menu-dark glass-card border-white/10 p-2 shadow-2xl">
                    <li><a class="dropdown-item rounded-lg py-1.5 text-[10px] font-black uppercase tracking-widest hover:bg-emerald-500/20 hover:text-emerald-500 flex items-center gap-2" href="#" onclick="bulkUpdateStatus('approved')">
                        <span class="material-symbols-outlined text-xs">check_circle</span> Aprovar
                    </a></li>
                    <li><a class="dropdown-item rounded-lg py-1.5 text-[10px] font-black uppercase tracking-widest hover:bg-red-500/20 hover:text-red-500 flex items-center gap-2" href="#" onclick="bulkUpdateStatus('rejected')">
                        <span class="material-symbols-outlined text-xs">cancel</span> Rejeitar
                    </a></li>
                    <li><a class="dropdown-item rounded-lg py-1.5 text-[10px] font-black uppercase tracking-widest hover:bg-blue-500/20 hover:text-blue-500 flex items-center gap-2" href="#" onclick="bulkExport()">
                        <span class="material-symbols-outlined text-xs">download</span> Exportar
                    </a></li>
                    <li><hr class="dropdown-divider border-white/5"></li>
                    <li><a class="dropdown-item rounded-lg py-1.5 text-[10px] font-black uppercase tracking-widest hover:bg-red-600/20 text-red-500 flex items-center gap-2" href="#" onclick="bulkDelete()">
                        <span class="material-symbols-outlined text-xs">delete</span> Excluir
                    </a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="bg-white/[0.02]">
                    <th class="px-5 py-4" width="40">
                        <input type="checkbox" id="selectAll" onchange="toggleAllCheckboxes()" class="w-3 h-3 rounded border-white/10 bg-white/5 text-orange-500 focus:ring-orange-500/50">
                    </th>
                    <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-[0.2em]">Referência</th>
                    <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-[0.2em]">Cliente</th>
                    <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-[0.2em]">Projeto / Tipo</th>
                    <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-[0.2em]">Valor Est.</th>
                    <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-[0.2em]">Prazo</th>
                    <th class="px-4 py-4 text-[9px] font-black text-gray-500 uppercase tracking-[0.2em]">Status</th>
                    <th class="px-5 py-4 text-[9px] font-black text-gray-500 uppercase tracking-[0.2em] text-right">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                {{#each budgets}}
                <tr class="hover:bg-white/[0.03] transition-colors group">
                    <td class="px-5 py-4">
                        <input type="checkbox" class="budget-checkbox w-3 h-3 rounded border-white/10 bg-white/5 text-orange-500 focus:ring-orange-500/50" value="{{this.id}}" onchange="updateBulkActions()">
                    </td>
                    <td class="px-4 py-4">
                        <span class="text-[10px] font-black text-gray-400 group-hover:text-orange-500 transition-colors">#{{this.id}}</span>
                    </td>
                    <td class="px-4 py-4">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-lg bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-500 font-black text-[10px]">
                                {{#firstLetter this.name}}{{/firstLetter}}
                            </div>
                            <div>
                                <p class="text-xs font-black text-white mb-0.5">{{this.name}}</p>
                                <p class="text-[8px] text-gray-500 font-bold uppercase tracking-widest">{{this.email}}</p>
                            </div>
                        </div>
                    </td>
                    <td class="px-4 py-4">
                        <span class="text-[8px] font-black text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded uppercase tracking-widest ring-1 ring-blue-500/30 mb-1 inline-block">
                            {{this.projectType}}
                        </span>
                        <p class="text-[9px] text-gray-500 font-medium line-clamp-1" title="{{this.description}}">
                            {{truncate this.description 40}}
                        </p>
                    </td>
                    <td class="px-4 py-4">
                        {{#if this.estimatedValue}}
                        <span class="text-xs font-black text-emerald-500">R$ {{formatCurrency this.estimatedValue}}</span>
                        {{else}}
                        <span class="text-[9px] font-black text-gray-600 uppercase">Sob Consulta</span>
                        {{/if}}
                    </td>
                    <td class="px-4 py-4">
                        {{#if this.deadline}}
                        <span class="text-[8px] font-black {{#if (isPast this.deadline)}}text-red-500 bg-red-500/10{{else}}text-blue-400 bg-blue-500/10{{/if}} px-2 py-1 rounded-full uppercase tracking-widest ring-1 {{#if (isPast this.deadline)}}ring-red-500/30{{else}}ring-blue-500/30{{/if}}">
                            {{dateFormat this.deadline "DD/MM/YYYY"}}
                        </span>
                        {{else}}
                        <span class="text-[8px] font-black text-gray-600 uppercase">N/D</span>
                        {{/if}}
                    </td>
                    <td class="px-4 py-4">
                        {{#if (eq this.status 'novo')}}
                        <span class="text-[8px] font-black text-orange-500 bg-orange-500/10 px-2 py-1 rounded-full uppercase tracking-widest ring-1 ring-orange-500/30 shadow-[0_0_10px_rgba(249,115,22,0.1)]">Novo</span>
                        {{else if (eq this.status 'em_andamento')}}
                        <span class="text-[8px] font-black text-blue-400 bg-blue-400/10 px-2 py-1 rounded-full uppercase tracking-widest ring-1 ring-blue-400/30">Andamento</span>
                        {{else if (eq this.status 'respondido')}}
                        <span class="text-[8px] font-black text-purple-400 bg-purple-400/10 px-2 py-1 rounded-full uppercase tracking-widest ring-1 ring-purple-400/30">Respondido</span>
                        {{else if (eq this.status 'fechado')}}
                        <span class="text-[8px] font-black text-emerald-500 bg-emerald-500/10 px-2 py-1 rounded-full uppercase tracking-widest ring-1 ring-emerald-500/30 shadow-[0_0_10px_rgba(16,185,129,0.1)]">Fechado</span>
                        {{else if (eq this.status 'perdido')}}
                        <span class="text-[8px] font-black text-red-500 bg-red-500/10 px-2 py-1 rounded-full uppercase tracking-widest ring-1 ring-red-500/30">Perdido</span>
                        {{else}}
                        <span class="text-[8px] font-black text-gray-500 bg-white/5 px-2 py-1 rounded-full uppercase tracking-widest">{{this.status}}</span>
                        {{/if}}
                    </td>
                    <td class="px-5 py-4 text-right">
                        <div class="flex items-center justify-end gap-1 opacity-30 group-hover:opacity-100 transition-opacity">
                            <a href="/admin/orcamentos/{{this.id}}" class="p-1.5 rounded-lg bg-white/5 text-gray-400 hover:text-white transition-all">
                                <span class="material-symbols-outlined text-base">visibility</span>
                            </a>
                            <button onclick="quickStatusUpdate({{this.id}}, 'approved')" class="p-1.5 rounded-lg bg-white/5 text-gray-400 hover:text-emerald-500 hover:bg-emerald-500/10 transition-all">
                                <span class="material-symbols-outlined text-base">check</span>
                            </button>
                            <button onclick="addNote({{this.id}})" class="p-1.5 rounded-lg bg-white/5 text-gray-400 hover:text-orange-500 hover:bg-orange-500/10 transition-all">
                                <span class="material-symbols-outlined text-base">note_add</span>
                            </button>
                        </div>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    <div class="p-5 bg-white/[0.01] border-t border-white/5">
        <nav class="flex justify-center">
            <ul class="flex items-center gap-1.5">
                {{#if pagination.hasPrev}}
                <li>
                    <a href="?page={{pagination.prevPage}}&{{buildQueryString}}" class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/5 text-gray-400 hover:text-white hover:bg-orange-500 transition-all">
                        <span class="material-symbols-outlined text-sm">chevron_left</span>
                    </a>
                </li>
                {{/if}}
                
                {{#each pagination.pages}}
                <li>
                    <a href="?page={{this.number}}&{{buildQueryString}}" class="w-8 h-8 flex items-center justify-center rounded-lg font-black text-[10px] {{#if this.active}}bg-orange-500 text-white shadow-lg shadow-orange-500/30{{else}}bg-white/5 text-gray-500 hover:text-white hover:bg-white/10{{/if}} transition-all">
                        {{this.number}}
                    </a>
                </li>
                {{/each}}
                
                {{#if pagination.hasNext}}
                <li>
                    <a href="?page={{pagination.nextPage}}&{{buildQueryString}}" class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/5 text-gray-400 hover:text-white hover:bg-orange-500 transition-all">
                        <span class="material-symbols-outlined text-sm">chevron_right</span>
                    </a>
                </li>
                {{/if}}
            </ul>
        </nav>
    </div>
</div>

<!-- Modal Nova Proposta -->
<div class="modal fade" id="newBudgetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-white/10">
            <div class="modal-header border-white/5 p-5">
                <h5 class="modal-title text-base font-black text-white flex items-center gap-2">
                    <span class="material-symbols-outlined text-orange-500">add_circle</span>
                    Criar Nova Proposta
                </h5>
                <button type="button" class="btn-close btn-close-white opacity-50 hover:opacity-100" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-6">
                <form id="newBudgetForm">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="mb-4">
                            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Cliente</label>
                            <input type="text" name="name" required class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-2 px-3 text-xs text-white focus:outline-none focus:border-orange-500/50" placeholder="Nome do cliente">
                        </div>
                        <div class="mb-4">
                            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Email</label>
                            <input type="email" name="email" class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-2 px-3 text-xs text-white focus:outline-none focus:border-orange-500/50" placeholder="Email do cliente">
                        </div>
                        <div class="mb-4">
                            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Tipo de Projeto</label>
                            <select name="projectType" class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-2 px-3 text-xs text-white focus:outline-none focus:border-orange-500/50">
                                <option value="Archviz Externo">Archviz Externo</option>
                                <option value="Archviz Interno">Archviz Interno</option>
                                <option value="Produto 3D">Produto 3D</option>
                                <option value="Planta Humanizada">Planta Humanizada</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Valor Estimado (R$)</label>
                            <input type="number" step="0.01" name="estimatedValue" class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-2 px-3 text-xs text-white focus:outline-none focus:border-orange-500/50" placeholder="Ex: 5000.00">
                        </div>
                        <div class="mb-4 md:col-span-2">
                            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Descrição</label>
                            <textarea name="description" class="w-full bg-[#1a1c23] border border-white/10 rounded-xl py-2 px-3 text-xs text-white focus:outline-none focus:border-orange-500/50 h-24" placeholder="Detalhes do projeto..."></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-white/5 p-4 flex justify-end gap-2">
                <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold text-gray-400 hover:text-white transition-colors" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" onclick="submitNewBudget()" class="bg-orange-500 hover:bg-orange-600 text-white font-black py-2 px-6 rounded-xl shadow-lg shadow-orange-500/20 transition-all text-xs" data-bs-dismiss="modal">
                    Salvar Proposta
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script>
function updateBulkActions() {
    const checkedBoxes = document.querySelectorAll('.budget-checkbox:checked');
    const bulkButton = document.querySelector('[data-bs-toggle="dropdown"]');
    
    if (checkedBoxes.length > 0) {
        bulkButton.classList.add('ring-2', 'ring-orange-500/50', 'text-white');
    } else {
        bulkButton.classList.remove('ring-2', 'ring-orange-500/50', 'text-white');
    }
}
function toggleAllCheckboxes() {
    const isChecked = document.getElementById('selectAll').checked;
    document.querySelectorAll('.budget-checkbox').forEach(cb => cb.checked = isChecked);
    updateBulkActions();
}

async function submitNewBudget() {
    const form = document.getElementById('newBudgetForm');
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    try {
        const response = await fetch('/admin/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        
        const result = await response.json();
        if (result.success) {
            window.location.reload();
        } else {
            alert('Erro: ' + result.message);
        }
    } catch (error) {
        console.error('Error creating budget:', error);
        alert('Erro ao criar proposta');
    }
}

async function handleBulkAction(action) {
    const checkedBoxes = Array.from(document.querySelectorAll('.budget-checkbox:checked')).map(cb => cb.value);
    if(checkedBoxes.length === 0) return alert('Selecione pelo menos um orçamento.');

    if(confirm(`Deseja realmente aplicar a ação '${action}' nos orçamentos selecionados?`)) {
        try {
            // Placeholder: Aqui você chamaria um endpoint como /admin/api/budgets/bulk
            console.log('Bulk Action', action, checkedBoxes);
            alert('Ação em massa executada com sucesso (Simulação)');
            window.location.reload();
        } catch (error) {
            console.error('Error on bulk action:', error);
            alert('Erro ao executar ação em massa');
        }
    }
}
</script>
