<div class="min-h-screen bg-[#0a0a0a] flex flex-col lg:flex-row relative overflow-hidden font-['Plus_Jakarta_Sans']">
 <!-- Abstract Background Decor -->
 <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-orange-500/5 via-transparent to-transparent -z-10"></div>
 <div class="absolute -top-48 -right-48 w-[600px] h-[600px] bg-orange-500/10 rounded-full blur-[150px] animate-pulse -z-10"></div>
 <div class="absolute -bottom-48 -left-48 w-[600px] h-[600px] bg-blue-500/5 rounded-full blur-[150px] animate-pulse -z-10"></div>

 <!-- Center Content -->
 <div class="flex-1 flex flex-col justify-center py-12 px-6 lg:px-24 relative z-10 items-center">
 <div class="sm:mx-auto sm:w-full sm:max-w-md lg:max-w-xl w-full text-center">
 
 <div class="flex justify-center mb-10">
 <div class="flex items-center gap-4">
 <div class="w-16 h-16 bg-orange-500 rounded-2xl flex items-center justify-center shadow-[0_0_40px_rgba(249,115,22,0.4)] ring-1 ring-white/20">
 <span class="font-black text-3xl text-white">M</span>
 </div>
 </div>
 </div>

 <div class="mb-10">
 <h2 class="text-3xl font-black text-white tracking-tight">Verificação de E-mail</h2>
 <p class="mt-2 text-sm text-gray-500 font-medium tracking-wide">
 Enviamos um código de 6 dígitos para <strong class="text-white">{{email}}</strong>.<br>
 Insira o código abaixo para ativar sua conta.
 </p>
 </div>

 <div class="glass-card p-8 border border-white/5 bg-white/[0.03] rounded-2xl relative text-left">
 {{#if message}}
 <div class="mb-6 p-4 bg-green-500/10 border border-green-500/20 rounded-2xl flex items-center gap-4">
 <div class="w-10 h-10 rounded-xl bg-green-500/20 flex items-center justify-center flex-shrink-0 text-green-500">
 <span class="material-symbols-outlined">check_circle</span>
 </div>
 <p class="text-xs font-bold text-green-400">{{message}}</p>
 </div>
 {{/if}}
 {{#if error}}
 <div class="mb-6 p-4 bg-red-500/10 border border-red-500/20 rounded-2xl flex items-center gap-4 animate-shake">
 <div class="w-10 h-10 rounded-xl bg-red-500/20 flex items-center justify-center flex-shrink-0 text-red-500">
 <span class="material-symbols-outlined">security</span>
 </div>
 <p class="text-xs font-bold text-red-400">{{error}}</p>
 </div>
 {{/if}}

 <form class="space-y-6" action="/admin/verify" method="POST" id="verifyForm">
 <input type="hidden" name="email" value="{{email}}">
 
 <div class="space-y-3">
 <label for="code" class="text-[10px] font-black text-gray-500 uppercase tracking-[0.3em] ml-1">Código de Verificação</label>
 <div class="relative group">
 <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
 <span class="material-symbols-outlined text-gray-600 group-focus-within:text-orange-500 transition-colors text-lg">pin</span>
 </div>
 <input id="code" name="code" type="text" required maxlength="6" pattern="[0-9]{6}"
 class="input-premium block w-full pl-14 pr-5 py-4 bg-white/[0.03] border border-white/5 text-white text-center text-2xl tracking-[0.5em] font-black rounded-xl focus:ring-4 focus:ring-orange-500/10 focus:border-orange-500/50 focus:bg-white/[0.05] transition-all outline-none"
 placeholder="000000">
 </div>
 <p class="text-[10px] text-gray-500 text-center mt-2">Digite apenas números.</p>
 </div>

 <div class="pt-4">
 <button type="submit" id="submitBtn" class="w-full flex justify-center items-center py-4 px-6 border border-transparent rounded-xl shadow-2xl shadow-orange-500/40 text-sm font-black text-white bg-orange-500 hover:bg-orange-600 focus:outline-none focus:ring-4 focus:ring-orange-500/20 transition-all transform ] group">
 <span id="btnText" class="flex items-center gap-3 tracking-[0.2em] uppercase">
 Validar Conta
 <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">check_circle</span>
 </span>
 </button>
 </div>
 </form>

 <div class="mt-8 pt-6 border-t border-white/5 text-center space-y-4">
 <form action="/admin/resend-verification" method="POST" class="inline">
 <input type="hidden" name="email" value="{{email}}">
 <span class="text-xs text-gray-500 font-medium">Não recebeu o código?</span>
 <button type="submit" class="text-xs font-black text-orange-500 hover:text-orange-400 transition-colors ml-1 uppercase tracking-wide">
 Reenviar Código
 </button>
 </form>
 <div class="pt-2">
 <a href="/admin/login" class="text-[10px] font-black text-gray-600 hover:text-gray-400 transition-colors uppercase tracking-[0.2em]">
 Voltar ao Login
 </a>
 </div>
 </div>
 </div>
 </div>
 </div>
</div>

<style>
 .input-premium:focus {
 box-shadow: 0 0 20px rgba(249, 115, 22, 0.1);
 }
</style>
