<script>
 document.getElementById('btnDeploy').addEventListener('click', async () => {
 if (!confirm('Deseja realizar o push para o GitHub e disparar o deploy em produção?')) return;
 
 const btn = document.getElementById('btnDeploy');
 const originalText = btn.innerHTML;
 
 btn.disabled = true;
 btn.innerHTML = '<span class="material-symbols-outlined animate-spin">refresh</span> Processando...';
 
 try {
 const response = await fetch('/admin/api/deploy', { method: 'POST' });
 const result = await response.json();
 
 if (result.success) {
 alert('Deploy enviado com sucesso! O Hostinger processará a atualização em instantes.');
 window.location.reload();
 } else {
 alert('Erro no pipeline: ' + result.message);
 }
 } catch (err) {
 alert('Falha crítica na comunicação com o servidor.');
 } finally {
 btn.disabled = false;
 btn.innerHTML = originalText;
 }
 });
</script>
