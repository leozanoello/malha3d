<!-- Header -->
<div class="mb-10 p-8 glass-card border-none bg-gradient-to-br from-white/5 to-white/[0.02]">
 <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
 <div>
 <h1 class="text-4xl font-black text-white tracking-tight mb-2">
 Gestão de <span class="text-gradient">Logística</span>
 </h1>
 <p class="text-gray-400 font-medium">
 Monitore o status de envio e confirmação dos pacotes de assets e projetos <span class="text-orange-500">Malha3D</span>.
 </p>
 </div>
 <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-8 rounded-2xl shadow-2xl shadow-orange-500/40 transition-all flex items-center gap-3" data-bs-toggle="modal" data-bs-target="#newDeliveryModal">
 <span class="material-symbols-outlined">local_shipping</span>
 Nova Entrega
 </button>
 </div>
</div>

<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
 <div class="glass-card p-8 border-white/5 flex flex-col items-center text-center group">
 <div class="w-14 h-14 bg-blue-500/10 rounded-2xl flex items-center justify-center text-blue-500 mb-4 border border-blue-500/20 group- transition-transform shadow-lg shadow-blue-500/10">
 <span class="material-symbols-outlined text-2xl">schedule</span>
 </div>
 <p class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-1">Pendentes</p>
 <h2 class="text-3xl font-black text-white tracking-tight">{{stats.pending}}</h2>
 </div>

 <div class="glass-card p-8 border-white/5 flex flex-col items-center text-center group">
 <div class="w-14 h-14 bg-emerald-500/10 rounded-2xl flex items-center justify-center text-emerald-500 mb-4 border border-emerald-500/20 group- transition-transform shadow-lg shadow-emerald-500/10">
 <span class="material-symbols-outlined text-2xl">package_2</span>
 </div>
 <p class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-1">Entregues</p>
 <h2 class="text-3xl font-black text-white tracking-tight">{{stats.delivered}}</h2>
 </div>

 <div class="glass-card p-8 border-white/5 flex flex-col items-center text-center group">
 <div class="w-14 h-14 bg-purple-500/10 rounded-2xl flex items-center justify-center text-purple-500 mb-4 border border-purple-500/20 group- transition-transform shadow-lg shadow-purple-500/10">
 <span class="material-symbols-outlined text-2xl">verified</span>
 </div>
 <p class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-1">Aprovados</p>
 <h2 class="text-3xl font-black text-white tracking-tight">{{stats.approved}}</h2>
 </div>
</div>

<!-- History Table -->
<div class="glass-card border-white/5 overflow-hidden">
 <div class="p-8 border-b border-white/5 flex items-center justify-between bg-white/[0.01]">
 <h3 class="text-lg font-black text-white tracking-tight flex items-center gap-3">
 <span class="material-symbols-outlined text-orange-500">inventory_2</span>
 Histórico de Entregas
 </h3>
 <button class="p-2 bg-white/5 text-gray-400 rounded-xl hover:bg-white/10 transition-all">
 <span class="material-symbols-outlined text-lg">filter_list</span>
 </button>
 </div>
 <div class="overflow-x-auto">
 <table class="w-full text-left">
 <thead>
 <tr class="bg-white/[0.02]">
 <th class="px-8 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Título do Pacote</th>
 <th class="px-6 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Data Prevista</th>
 <th class="px-6 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Status</th>
 <th class="px-8 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Confirmação</th>
 <th class="px-8 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] text-right">Ações</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-white/5">
 {{#if deliveries}}
 {{#each deliveries}}
 <tr class="hover:bg-white/[0.03] transition-colors cursor-pointer group">
 <td class="px-8 py-6">
 <p class="text-sm font-black text-white group-hover:text-orange-500 transition-colors">{{this.title}}</p>
 </td>
 <td class="px-6 py-6">
 <span class="text-xs font-bold text-gray-400 uppercase tracking-widest">{{formatDate this.scheduledDate}}</span>
 </td>
 <td class="px-6 py-6">
 <span class="text-[9px] font-black text-blue-400 bg-blue-500/10 px-3 py-1 rounded-full uppercase tracking-[0.15em] ring-1 ring-blue-500/30">{{this.status}}</span>
 </td>
 <td class="px-8 py-6">
 {{#if this.confirmation}}
 <div class="flex items-center gap-2 text-emerald-500 bg-emerald-500/10 px-3 py-1.5 rounded-xl w-fit ring-1 ring-emerald-500/30">
 <span class="material-symbols-outlined text-base">check_circle</span>
 <span class="text-[10px] font-black uppercase tracking-widest">Confirmado</span>
 </div>
 {{else}}
 <div class="flex items-center gap-2 text-gray-500 bg-white/5 px-3 py-1.5 rounded-xl w-fit">
 <span class="material-symbols-outlined text-base">pending</span>
 <span class="text-[10px] font-black uppercase tracking-widest">Aguardando...</span>
 </div>
 {{/if}}
 </td>
 <td class="px-8 py-6 text-right">
 <div class="flex items-center justify-end gap-2">
 {{#if this.downloadUrl}}
 <a href="{{this.downloadUrl}}" target="_blank" class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500/20 flex items-center justify-center transition-all" title="Download">
 <span class="material-symbols-outlined text-sm">download</span>
 </a>
 {{/if}}
 <button onclick="deleteDelivery('{{this.id}}')" class="w-8 h-8 rounded-lg bg-red-500/10 text-red-500 hover:bg-red-500/20 flex items-center justify-center transition-all" title="Excluir">
 <span class="material-symbols-outlined text-sm">delete</span>
 </button>
 </div>
 </td>
 </tr>
 {{/each}}
 {{else}}
 <tr>
 <td colspan="4" class="px-8 py-20 text-center">
 <div class="flex flex-col items-center gap-4 opacity-30">
 <span class="material-symbols-outlined text-6xl">inventory_2</span>
 <p class="text-sm font-black uppercase tracking-[0.2em]">Nenhuma entrega registrada</p>
 </div>
 </td>
 </tr>
 {{/if}}
 </tbody>
 </table>
 </div>
</div>

<!-- New Delivery Modal -->
<div class="modal fade" id="newDeliveryModal" tabindex="-1" aria-hidden="true">
 <div class="modal-dialog modal-dialog-centered">
 <div class="modal-content glass-card border-white/10 bg-[#0f0f0f]/95 backdrop-blur-2xl">
 <div class="modal-header border-white/5 p-8">
 <h5 class="text-xl font-black text-white tracking-tight flex items-center gap-3">
 <span class="material-symbols-outlined text-orange-500">local_shipping</span>
 Registrar Nova Entrega
 </h5>
 <button type="button" class="btn-close btn-close-white opacity-50 hover:opacity-100 transition-opacity" data-bs-dismiss="modal"></button>
 </div>
 <form id="newDeliveryForm">
 <div class="modal-body p-8 space-y-6">
 <div class="space-y-2">
 <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Título do Pacote</label>
 <input type="text" name="title" required class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="Ex: Assets de Render - Casa de Campo">
 </div>
 
 <div class="space-y-2">
 <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Data Prevista</label>
 <input type="date" name="scheduledDate" required class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
 </div>

 <div class="space-y-2">
 <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Projeto Relacionado</label>
 <select name="projectId" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
 <option value="" class="bg-[#0f0f0f]">Nenhum</option>
 {{#each projects}}
 <option value="{{this.id}}" class="bg-[#0f0f0f]">{{this.title}}</option>
 {{/each}}
 </select>
 </div>

 <div class="space-y-2">
 <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Link de Download (Drive/WeTransfer)</label>
 <input type="url" name="downloadUrl" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="https://drive.google.com/...">
 </div>

 <div class="space-y-2">
 <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Status Inicial</label>
 <select name="status" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
 <option value="pendente" class="bg-[#0f0f0f]">Pendente</option>
 <option value="entregue" class="bg-[#0f0f0f]">Entregue</option>
 </select>
 </div>
 </div>
 <div class="modal-footer border-white/5 p-8">
 <button type="button" class="px-6 py-3 text-xs font-black text-gray-500 uppercase tracking-widest hover:text-white transition-all" data-bs-dismiss="modal">Cancelar</button>
 <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white font-black py-3 px-8 rounded-xl shadow-lg shadow-orange-500/20 transition-all flex items-center gap-2">
 <span class="material-symbols-outlined text-sm">send</span>
 Registrar
 </button>
 </div>
 </form>
 </div>
 </div>
</div>

<script>
document.getElementById('newDeliveryForm')?.addEventListener('submit', async function(e) {
 e.preventDefault();
 const formData = new FormData(this);
 const data = Object.fromEntries(formData.entries());
 
 try {
 const response = await fetch('/admin/api/entregas', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify(data)
 });
 
 const result = await response.json();
 if (result.success) {
 window.location.reload();
 } else {
 alert('Erro: ' + result.message);
 }
 } catch (error) {
 console.error('Error creating delivery:', error);
 alert('Erro ao processar solicitação');
 }
});

async function deleteDelivery(id) {
 if (!confirm('Excluir este registro de entrega?')) return;
 try {
 const response = await fetch(`/admin/api/deliveries/${id}`, { method: 'DELETE' });
 const result = await response.json();
 if (result.success) window.location.reload();
 else alert('Erro ao excluir: ' + result.message);
 } catch (error) {
 console.error(error);
 }
}
</script>
