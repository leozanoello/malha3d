<script>
(function() {
  const STORAGE_KEY = 'malha3d_learning_progress';
  const MODULE = 'financeiro';
  const TOTAL_STEPS = 5;

  function getProgress() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch(e) { return {}; }
  }

  function saveProgress(module, completedSteps) {
    try {
      const progress = getProgress();
      progress[module] = completedSteps;
      localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
    } catch(e) { console.error('Save progress error:', e); }
  }

  function updateUI() {
    const progress = getProgress();
    const completed = (progress[MODULE] || []).length;
    const percentage = Math.round((completed / TOTAL_STEPS) * 100);

    const progressBar = document.getElementById('progressBar');
    const stepCounter = document.getElementById('stepCounter');
    if (progressBar) progressBar.style.width = percentage + '%';
    if (stepCounter) stepCounter.textContent = completed + '/' + TOTAL_STEPS;
  }

  window.markComplete = function(module, step) {
    const progress = getProgress();
    if (!progress[module]) progress[module] = [];
    if (!progress[module].includes(step)) {
      progress[module].push(step);
      saveProgress(module, progress[module]);
      updateUI();
    }
  };

  window.nextStep = function(module) {
    const current = parseInt(document.querySelector('.lesson-step:not(.hidden)')?.getAttribute('data-step') || 0);
    if (current < TOTAL_STEPS) goToStep(module, current + 1);
  };

  window.previousStep = function(module) {
    const current = parseInt(document.querySelector('.lesson-step:not(.hidden)')?.getAttribute('data-step') || 0);
    if (current > 1) goToStep(module, current - 1);
  };

  window.goToStep = function(module, step) {
    document.querySelectorAll('.lesson-step').forEach(s => s.classList.add('hidden'));
    document.querySelector(`.lesson-step[data-step="${step}"]`)?.classList.remove('hidden');
    document.querySelectorAll('[data-step]').forEach(btn => {
      btn.classList.toggle('bg-emerald-500', btn.getAttribute('data-step') == step);
      btn.classList.toggle('bg-white/20', btn.getAttribute('data-step') != step);
    });
  };

  updateUI();
})();
</script>
