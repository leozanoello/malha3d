<!-- Header -->
<div class="mb-10 p-8 glass-card border-none bg-gradient-to-br from-white/5 to-white/[0.02]">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h1 class="text-4xl font-black text-white tracking-tight mb-2">
                Controle de <span class="text-gradient">Revisões</span>
            </h1>
            <p class="text-gray-400 font-medium">
                Gestão de versões e impacto de alterações nos projetos <span class="text-orange-500">Malha3D</span>.
            </p>
        </div>
        <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-8 rounded-2xl shadow-2xl shadow-orange-500/40 transition-all flex items-center gap-3" data-bs-toggle="modal" data-bs-target="#newRevisionModal">
            <span class="material-symbols-outlined">add_circle</span>
            Nova Revisão
        </button>
    </div>
</div>

<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
    <div class="glass-card p-8 border-white/5 relative group overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-red-500/5 rounded-full blur-3xl -mr-16 -mt-16 group-hover:bg-red-500/10 transition-all"></div>
        <div class="relative z-10 flex items-center gap-6">
            <div class="w-16 h-16 rounded-2xl bg-red-500/10 text-red-500 flex items-center justify-center border border-red-500/20 group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-3xl">error</span>
            </div>
            <div>
                <p class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-1">Impacto Financeiro</p>
                <h2 class="text-3xl font-black text-white tracking-tight">{{formatCurrency totalImpact}}</h2>
                <p class="text-[9px] font-black text-red-500 uppercase tracking-widest mt-1">Custo Adicional Acumulado</p>
            </div>
        </div>
    </div>

    <div class="glass-card p-8 border-white/5 relative group overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/5 rounded-full blur-3xl -mr-16 -mt-16 group-hover:bg-blue-500/10 transition-all"></div>
        <div class="relative z-10 flex items-center gap-6">
            <div class="w-16 h-16 rounded-2xl bg-blue-500/10 text-blue-500 flex items-center justify-center border border-blue-500/20 group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-3xl">content_copy</span>
            </div>
            <div>
                <p class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-1">Versões do Ecossistema</p>
                <h2 class="text-3xl font-black text-white tracking-tight">{{totalVersions}}</h2>
                <p class="text-[9px] font-black text-blue-500 uppercase tracking-widest mt-1">Total de Alterações Registradas</p>
            </div>
        </div>
    </div>
</div>

<!-- Revisions Table -->
<div class="glass-card border-white/5 overflow-hidden">
    <div class="p-8 border-b border-white/5 bg-white/[0.01]">
        <h3 class="text-lg font-black text-white tracking-tight flex items-center gap-3">
            <span class="material-symbols-outlined text-orange-500">history_edu</span>
            Solicitações de Alteração
        </h3>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="bg-white/[0.02]">
                    <th class="px-8 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Descrição / Detalhes</th>
                    <th class="px-6 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Versão</th>
                    <th class="px-6 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Custo Extra</th>
                    <th class="px-6 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Atraso</th>
                    <th class="px-8 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                {{#if revisions}}
                    {{#each revisions}}
                    <tr class="hover:bg-white/[0.03] transition-colors cursor-pointer group">
                        <td class="px-8 py-6">
                            <p class="text-sm font-black text-white mb-0.5 group-hover:text-orange-500 transition-colors">{{this.description}}</p>
                            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">{{this.project.name}}</p>
                        </td>
                        <td class="px-6 py-6">
                            <span class="text-xs font-black text-blue-400 bg-blue-500/10 px-2 py-1 rounded-lg">v{{this.version}}</span>
                        </td>
                        <td class="px-6 py-6">
                            <span class="text-sm font-black text-red-500">{{formatCurrency this.financialImpact}}</span>
                        </td>
                        <td class="px-6 py-6">
                            <span class="text-sm font-bold text-gray-400">+{{this.deadlineImpact}} dias</span>
                        </td>
                        <td class="px-8 py-6">
                            <span class="text-[9px] font-black text-orange-500 bg-orange-500/10 px-3 py-1 rounded-full uppercase tracking-[0.15em] ring-1 ring-orange-500/30">{{this.status}}</span>
                        </td>
                    </tr>
                    {{/each}}
                {{else}}
                    <tr>
                        <td colspan="5" class="px-8 py-20 text-center">
                            <div class="flex flex-col items-center gap-4 opacity-30">
                                <span class="material-symbols-outlined text-6xl">history_edu</span>
                                <p class="text-sm font-black uppercase tracking-[0.2em]">Nenhuma revisão registrada</p>
                            </div>
                        </td>
                    </tr>
                {{/if}}
            </tbody>
        </table>
    </div>
</div>

<!-- New Revision Modal -->
<div class="modal fade" id="newRevisionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-white/10 bg-[#0f0f0f]/95 backdrop-blur-2xl">
            <div class="modal-header border-white/5 p-8">
                <h5 class="text-xl font-black text-white tracking-tight flex items-center gap-3">
                    <span class="material-symbols-outlined text-orange-500">history_edu</span>
                    Registrar Nova Revisão
                </h5>
                <button type="button" class="btn-close btn-close-white opacity-50 hover:opacity-100 transition-opacity" data-bs-dismiss="modal"></button>
            </div>
            <form id="newRevisionForm">
                <div class="modal-body p-8 space-y-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Descrição da Alteração *</label>
                        <input type="text" name="description" required class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="Ex: Alteração na fachada principal">
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Projeto *</label>
                            <select name="projectId" required class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
                                <option value="" class="bg-[#0f0f0f]">Selecione...</option>
                                {{#each projects}}
                                    <option value="{{this.id}}" class="bg-[#0f0f0f]">{{this.title}}</option>
                                {{/each}}
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Versão</label>
                            <input type="text" name="version" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="Ex: 2.0">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Impacto Financeiro (R$)</label>
                            <input type="number" name="financialImpact" step="0.01" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="0.00">
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Atraso (dias)</label>
                            <input type="number" name="deadlineImpact" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="0">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-white/5 p-8">
                    <button type="button" class="px-6 py-3 text-xs font-black text-gray-500 uppercase tracking-widest hover:text-white transition-all" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white font-black py-3 px-8 rounded-xl shadow-lg shadow-orange-500/20 transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">save</span>
                        Registrar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.getElementById('newRevisionForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const data = Object.fromEntries(formData.entries());
    
    try {
        const response = await fetch('/admin/api/revisoes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        
        const result = await response.json();
        if (result.success) {
            window.location.reload();
        } else {
            alert('Erro: ' + result.message);
        }
    } catch (error) {
        console.error('Error creating revision:', error);
        alert('Erro ao registrar revisão');
    }
});
</script>

