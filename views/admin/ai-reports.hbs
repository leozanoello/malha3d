    </div>

    <!-- Bottleneck Prediction -->
    <div class="glass-card p-10 border-white/5 bg-white/[0.01]">
        <div class="flex items-center justify-between mb-10">
            <h3 class="text-xl font-black text-white tracking-tight">Previsão de Gargalos</h3>
            <span class="px-4 py-1.5 bg-white/5 text-gray-500 text-[9px] font-black uppercase tracking-[0.2em] rounded-full border border-white/10">Próximos 30 dias</span>
