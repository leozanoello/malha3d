                </div>
                <div class="w-full bg-white/5 h-2.5 rounded-full overflow-hidden">
                    <div class="bg-gradient-to-r from-orange-600 to-orange-400 h-full rounded-full shadow-[0_0_15px_rgba(249,115,22,0.3)]" style="width: 85%"></div>
                </div>
            </div>
            <div>
                <div class="flex justify-between mb-3">
                    <span class="text-xs font-black text-gray-400 uppercase tracking-widest">Pós-Produção</span>
                    <span class="text-xs font-black text-emerald-500">STABLE (42%)</span>
                </div>
                <div class="w-full bg-white/5 h-2.5 rounded-full overflow-hidden">
                    <div class="bg-gradient-to-r from-emerald-600 to-emerald-400 h-full rounded-full shadow-[0_0_15px_rgba(16,185,129,0.3)]" style="width: 42%"></div>
                </div>
            </div>
            <div>
                <div class="flex justify-between mb-3">
                    <span class="text-xs font-black text-gray-400 uppercase tracking-widest">Revisões Externas</span>
                    <span class="text-xs font-black text-blue-500">WARM (60%)</span>
                </div>
                <div class="w-full bg-white/5 h-2.5 rounded-full overflow-hidden">
                    <div class="bg-gradient-to-r from-blue-600 to-blue-400 h-full rounded-full shadow-[0_0_15px_rgba(59,130,246,0.3)]" style="width: 60%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Analytics Dashboard -->
<div class="grid grid-cols-1 xl:grid-cols-3 gap-8 mb-10">
    <!-- Chart 1: Render Engines -->
    <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-white/[0.02] to-transparent flex flex-col justify-between min-h-[400px]">
        <div>
            <h3 class="text-xs font-black text-white uppercase tracking-widest mb-2 flex items-center gap-2">
                <span class="material-symbols-outlined text-sm text-orange-500">brush</span>
                Motores de Render
            </h3>
            <p class="text-[9px] text-gray-500 font-bold uppercase tracking-wider mb-6">Contagem de projetos ativos por engine 3D</p>
        </div>
        <div class="h-64 relative flex items-center justify-center">
            <canvas id="renderEngineChart"></canvas>
        </div>
    </div>
    
    <!-- Chart 2: Ticket Médio por Estilo -->
    <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-white/[0.02] to-transparent flex flex-col justify-between min-h-[400px]">
        <div>
            <h3 class="text-xs font-black text-white uppercase tracking-widest mb-2 flex items-center gap-2">
                <span class="material-symbols-outlined text-sm text-orange-500">architecture</span>
                Preço Médio por m²
            </h3>
            <p class="text-[9px] text-gray-500 font-bold uppercase tracking-wider mb-6">Valores médios cobrados por Estilo Predominante</p>
        </div>
        <div class="h-64 relative">
            <canvas id="stylePriceChart"></canvas>
        </div>
    </div>
    
    <!-- Chart 3: Funil Comercial -->
    <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-white/[0.02] to-transparent flex flex-col justify-between min-h-[400px]">
        <div>
            <h3 class="text-xs font-black text-white uppercase tracking-widest mb-2 flex items-center gap-2">
                <span class="material-symbols-outlined text-sm text-orange-500">filter_alt</span>
                Funil de Vendas
            </h3>
            <p class="text-[9px] text-gray-500 font-bold uppercase tracking-wider mb-6">Taxa de conversão de Leads a Projetos Fechados</p>
        </div>
        <div class="h-64 relative">
            <canvas id="funnelConversionChart"></canvas>
        </div>
    </div>
</div>

<!-- Detailed Reports Table -->
<div class="glass-card border-white/5 overflow-hidden bg-white/[0.01]">
    <div class="p-8 border-b border-white/5 flex items-center justify-between">
        <h3 class="text-xl font-black text-white tracking-tight">Histórico de Relatórios</h3>
        <button class="text-orange-500 text-[10px] font-black uppercase tracking-widest hover:text-orange-400 transition-colors">Ver Tudo</button>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="bg-white/[0.02]">
                    <th class="px-8 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Relatório</th>
                    <th class="px-8 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Tipo</th>
                    <th class="px-8 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Data de Geração</th>
                    <th class="px-8 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Status</th>
                    <th class="px-8 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                <tr class="group hover:bg-white/[0.02] transition-all">
                    <td class="px-8 py-6">
                        <p class="text-sm font-bold text-white group-hover:text-orange-500 transition-colors">Análise de Conversão Mensal</p>
                    </td>
                    <td class="px-8 py-6">
                        <span class="px-3 py-1 bg-blue-500/10 text-blue-500 text-[9px] font-black rounded-lg uppercase tracking-widest ring-1 ring-blue-500/20">Vendas</span>
                    </td>
                    <td class="px-8 py-6">
                        <p class="text-xs font-bold text-gray-500">03 Mai 2026</p>
                    </td>
                    <td class="px-8 py-6">
                        <span class="flex items-center gap-2 text-[9px] font-black text-emerald-500 uppercase tracking-widest">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)] animate-pulse"></span>
                            Finalizado
                        </span>
                    </td>
                    <td class="px-8 py-6">
                        <button class="w-10 h-10 bg-white/5 rounded-xl flex items-center justify-center text-gray-500 hover:text-white hover:bg-orange-500 transition-all shadow-xl">
                            <span class="material-symbols-outlined text-lg">visibility</span>
                        </button>
                    </td>
                </tr>
                <tr class="group hover:bg-white/[0.02] transition-all">
                    <td class="px-8 py-6">
                        <p class="text-sm font-bold text-white group-hover:text-orange-500 transition-colors">Forecast de Produção Q3</p>
                    </td>
                    <td class="px-8 py-6">
                        <span class="px-3 py-1 bg-purple-500/10 text-purple-500 text-[9px] font-black rounded-lg uppercase tracking-widest ring-1 ring-purple-500/20">Operacional</span>
                    </td>
                    <td class="px-8 py-6">
                        <p class="text-xs font-bold text-gray-500">01 Mai 2026</p>
                    </td>
                    <td class="px-8 py-6">
                        <span class="flex items-center gap-2 text-[9px] font-black text-emerald-500 uppercase tracking-widest">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]"></span>
                            Arquivado
                        </span>
                    </td>
                    <td class="px-8 py-6">
                        <button class="w-10 h-10 bg-white/5 rounded-xl flex items-center justify-center text-gray-500 hover:text-white hover:bg-orange-500 transition-all shadow-xl">
                            <span class="material-symbols-outlined text-lg">visibility</span>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const statsData = {{{json stats}}};
    console.log('BI Stats loaded:', statsData);

    // 1. Render Engines Doughnut Chart
    const ctxRender = document.getElementById('renderEngineChart')?.getContext('2d');
    if (ctxRender) {
        new Chart(ctxRender, {
            type: 'doughnut',
            data: {
                labels: Object.keys(statsData.renderEngines),
                datasets: [{
                    data: Object.values(statsData.renderEngines),
                    backgroundColor: ['#f97316', '#a855f7', '#6366f1'],
                    borderWidth: 0,
                    hoverOffset: 15
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: '#9ca3af',
                            font: { family: 'Space Grotesk', weight: 'bold', size: 9 },
                            padding: 15
                        }
                    }
                },
                cutout: '75%'
            }
        });
    }

    // 2. Average price per style Bar Chart
    const ctxStyle = document.getElementById('stylePriceChart')?.getContext('2d');
    if (ctxStyle) {
        new Chart(ctxStyle, {
            type: 'bar',
            data: {
                labels: Object.keys(statsData.stylePrices),
                datasets: [{
                    label: 'Preço Médio / m²',
                    data: Object.values(statsData.stylePrices),
                    backgroundColor: 'rgba(99, 102, 241, 0.2)',
                    borderColor: '#6366f1',
                    borderWidth: 1.5,
                    borderRadius: 12,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(255, 255, 255, 0.05)' },
                        ticks: {
                            color: '#6b7280',
                            font: { family: 'Space Grotesk', size: 9 },
                            callback: function(value) { return 'R$ ' + value; }
                        }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { color: '#6b7280', font: { family: 'Space Grotesk', size: 9 } }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    }

    // 3. Commercial Funnel Horizontal Bar Chart
    const ctxFunnel = document.getElementById('funnelConversionChart')?.getContext('2d');
    if (ctxFunnel) {
        new Chart(ctxFunnel, {
            type: 'bar',
            data: {
                labels: ['Leads', 'Propostas', 'Contratos'],
                datasets: [{
                    data: [statsData.funnel.leads, statsData.funnel.proposals, statsData.funnel.projects],
                    backgroundColor: [
                        'rgba(99, 102, 241, 0.2)', // Leads (Indigo)
                        'rgba(249, 115, 22, 0.2)', // Proposals (Orange)
                        'rgba(16, 185, 129, 0.2)'  // Closed Projects (Emerald)
                    ],
                    borderColor: [
                        '#6366f1',
                        '#f97316',
                        '#10b981'
                    ],
                    borderWidth: 1.5,
                    borderRadius: 12,
                    borderSkipped: false
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: {
                        beginAtZero: true,
                        grid: { color: 'rgba(255, 255, 255, 0.05)' },
                        ticks: { color: '#6b7280', font: { family: 'Space Grotesk', size: 9 } }
                    },
                    y: {
                        grid: { display: false },
                        ticks: { color: '#6b7280', font: { family: 'Space Grotesk', size: 9 } }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    }
});
</script>

