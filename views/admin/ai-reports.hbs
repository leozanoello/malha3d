<!-- Relatórios & BI — Template Padrão (.kcard) | 5 Tabs: Dashboard, Orçamentos, Vendas, Financeiros, Produtividade -->
<div class="p-6 md:p-8 flex flex-col gap-5" style="background:#0a0c10;">

 <!-- Banner Header (.kcard com imagem) -->
 <div class="kcard">
 <div class="kcard-img" style="height:70px;">
 <img src="/assets/d91cfab1-9249-46f6-987b-264eafc85edb_3840w.webp" alt="Relatórios ArchViz" class="w-full h-full object-cover">
 <div class="absolute inset-0 bg-gradient-to-t from-[#151515] via-[#151515]/70 to-transparent"></div>
 </div>
 <div class="kcard-body" style="padding:14px 20px;">
 <div class="flex items-center justify-between">
 <div class="flex items-center gap-2.5">
 <span class="kcard-badge kcard-badge-orange"><span class="material-symbols-outlined text-[8px] align-middle mr-0.5">psychology</span> BI</span>
 <h4 class="kcard-title" style="font-size:1rem; margin-bottom:0;">Relatórios & Insights</h4>
 </div>
 <div class="flex items-center gap-2">
 <button class="py-1.5 px-3 rounded-[4px] text-[8px] font-black uppercase tracking-wider text-gray-400 hover:text-white flex items-center gap-1" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);"><span class="material-symbols-outlined text-[11px]">download</span> PDF</button>
 </div>
 </div>
 </div>
 </div>

 <!-- TABS Navigation -->
 <div class="flex gap-1 p-1 rounded-[5px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
 <button class="rep-tab-btn active" data-tab="dashboard">Dashboard</button>
 <button class="rep-tab-btn" data-tab="orcamentos">Orçamentos</button>
 <button class="rep-tab-btn" data-tab="vendas">Vendas</button>
 <button class="rep-tab-btn" data-tab="financeiros">Financeiros</button>
 <button class="rep-tab-btn" data-tab="produtividade">Produtividade</button>
 </div>

 <!-- ===== TAB: DASHBOARD ===== -->
 <div id="rep-pane-dashboard" class="rep-pane space-y-4">
 <!-- IA Cards -->
 <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
 <div class="kcard">
 <div class="kcard-body" style="padding:18px;">
 <div class="flex items-center gap-2 mb-3">
 <div class="w-7 h-7 rounded-md bg-orange-500/15 border border-orange-500/30 flex items-center justify-center"><span class="material-symbols-outlined text-orange-400 text-sm">auto_awesome</span></div>
 <p class="text-[9px] font-black text-white uppercase tracking-[0.12em]">Resumo Estratégico IA</p>
 </div>
 <p class="text-[10px] text-gray-300 leading-relaxed mb-3">"Detectamos crescimento de <strong class="text-orange-400">24%</strong> em projetos ArchViz. Recomendamos priorizar renders fotorrealistas para o setor imobiliário de alto padrão."</p>
 <div class="grid grid-cols-2 gap-2">
 <div class="p-2 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);"><p class="text-[7px] font-black text-gray-500 uppercase">Confiança</p><p class="text-sm font-black text-orange-400">98.2%</p></div>
 <div class="p-2 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);"><p class="text-[7px] font-black text-gray-500 uppercase">Impacto ROI</p><p class="text-sm font-black text-emerald-400">+R$ 45k</p></div>
 </div>
 </div>
 </div>
 <div class="kcard">
 <div class="kcard-body" style="padding:18px;">
 <div class="flex items-center justify-between mb-3">
 <p class="text-[9px] font-black text-white uppercase tracking-[0.12em]">Previsão de Gargalos</p>
 <span class="kcard-badge">30 dias</span>
 </div>
 <div class="space-y-3">
 <div><div class="flex justify-between mb-1"><span class="text-[8px] font-bold text-gray-400 uppercase">Modelagem 3D</span><span class="text-[8px] font-black text-orange-400">85%</span></div><div class="w-full h-1.5 rounded-full" style="background:rgba(255,255,255,0.05);"><div class="h-full rounded-full bg-orange-500" style="width:85%"></div></div></div>
 <div><div class="flex justify-between mb-1"><span class="text-[8px] font-bold text-gray-400 uppercase">Pós-Produção</span><span class="text-[8px] font-black text-emerald-400">42%</span></div><div class="w-full h-1.5 rounded-full" style="background:rgba(255,255,255,0.05);"><div class="h-full rounded-full bg-emerald-500" style="width:42%"></div></div></div>
 <div><div class="flex justify-between mb-1"><span class="text-[8px] font-bold text-gray-400 uppercase">Revisões</span><span class="text-[8px] font-black text-blue-400">60%</span></div><div class="w-full h-1.5 rounded-full" style="background:rgba(255,255,255,0.05);"><div class="h-full rounded-full bg-blue-500" style="width:60%"></div></div></div>
 </div>
 </div>
 </div>
 </div>
 <!-- Charts -->
 <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><p class="text-[8px] font-black text-white uppercase tracking-widest mb-2">Motores de Render</p><div style="height:180px;"><canvas id="renderEngineChart"></canvas></div></div></div>
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><p class="text-[8px] font-black text-white uppercase tracking-widest mb-2">Preço Médio / m²</p><div style="height:180px;"><canvas id="stylePriceChart"></canvas></div></div></div>
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><p class="text-[8px] font-black text-white uppercase tracking-widest mb-2">Funil de Vendas</p><div style="height:180px;"><canvas id="funnelConversionChart"></canvas></div></div></div>
 </div>
 </div>

 <!-- ===== TAB: ORÇAMENTOS ===== -->
 <div id="rep-pane-orcamentos" class="rep-pane hidden space-y-4">
 <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><span class="text-[8px] font-bold text-blue-400 uppercase tracking-widest">Total</span><p class="text-lg font-black text-white mt-1">{{budgetStats.total}}</p></div></div>
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><span class="text-[8px] font-bold text-orange-400 uppercase tracking-widest">Abertos</span><p class="text-lg font-black text-white mt-1">{{budgetStats.abertos}}</p></div></div>
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><span class="text-[8px] font-bold text-emerald-400 uppercase tracking-widest">Ganhos</span><p class="text-lg font-black text-white mt-1">{{budgetStats.ganhos}}</p></div></div>
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><span class="text-[8px] font-bold text-red-400 uppercase tracking-widest">Perdidos</span><p class="text-lg font-black text-white mt-1">{{budgetStats.perdidos}}</p></div></div>
 </div>
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><span class="text-[8px] font-bold text-gray-500 uppercase tracking-widest">Valor Total em Orçamentos</span><p class="text-2xl font-black text-orange-400 mt-1">{{formatCurrency budgetStats.valorTotal}}</p></div></div>
 <div class="kcard"><div class="kcard-body" style="padding:20px;"><p class="text-[9px] text-gray-500 text-center uppercase tracking-widest">Relatórios detalhados de orçamentos serão adicionados aqui futuramente.</p></div></div>
 </div>

 <!-- ===== TAB: VENDAS ===== -->
 <div id="rep-pane-vendas" class="rep-pane hidden space-y-4">
 <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><span class="text-[8px] font-bold text-emerald-400 uppercase tracking-widest">Vendas Fechadas</span><p class="text-lg font-black text-white mt-1">{{vendasStats.totalFechadas}}</p></div></div>
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><span class="text-[8px] font-bold text-orange-400 uppercase tracking-widest">Faturamento Total</span><p class="text-lg font-black text-emerald-400 mt-1">{{formatCurrency vendasStats.faturamento}}</p></div></div>
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><span class="text-[8px] font-bold text-cyan-400 uppercase tracking-widest">Ticket Médio</span><p class="text-lg font-black text-white mt-1">{{formatCurrency vendasStats.ticketMedio}}</p></div></div>
 </div>
 <div class="kcard"><div class="kcard-body" style="padding:20px;"><p class="text-[9px] text-gray-500 text-center uppercase tracking-widest">Relatórios detalhados de vendas (por vendedor, por período, por modalidade) serão adicionados aqui futuramente.</p></div></div>
 </div>

 <!-- ===== TAB: FINANCEIROS ===== -->
 <div id="rep-pane-financeiros" class="rep-pane hidden space-y-4">
 <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><span class="text-[8px] font-bold text-emerald-400 uppercase tracking-widest">Receitas</span><p class="text-lg font-black text-emerald-400 mt-1">{{formatCurrency financeStats.totalReceitas}}</p></div></div>
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><span class="text-[8px] font-bold text-red-400 uppercase tracking-widest">Despesas</span><p class="text-lg font-black text-red-400 mt-1">{{formatCurrency financeStats.totalDespesas}}</p></div></div>
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><span class="text-[8px] font-bold text-orange-400 uppercase tracking-widest">Saldo</span><p class="text-lg font-black text-white mt-1">{{formatCurrency financeStats.saldo}}</p></div></div>
 <div class="kcard"><div class="kcard-body" style="padding:14px;"><span class="text-[8px] font-bold text-blue-400 uppercase tracking-widest">Transações</span><p class="text-lg font-black text-white mt-1">{{financeStats.transacoes}}</p></div></div>
 </div>
 <div class="kcard"><div class="kcard-body" style="padding:20px;"><p class="text-[9px] text-gray-500 text-center uppercase tracking-widest">Relatórios financeiros detalhados (DRE, fluxo de caixa, custos por projeto) serão adicionados aqui futuramente.</p></div></div>
 </div>

 <!-- ===== TAB: PRODUTIVIDADE ===== -->
 <div id="rep-pane-produtividade" class="rep-pane hidden space-y-4">
 <div class="kcard"><div class="kcard-body" style="padding:20px;"><p class="text-[9px] text-gray-500 text-center uppercase tracking-widest">Relatórios de produtividade (horas por freelancer, tempo médio de produção, eficiência por engine) serão adicionados aqui futuramente.</p></div></div>
 </div>

</div>

<style>
.rep-tab-btn {
 padding: 8px 16px;
 font-size: 9px;
 font-weight: 900;
 text-transform: uppercase;
 letter-spacing: 0.1em;
 color: rgba(255,255,255,0.4);
 background: transparent;
 border: 1px solid transparent;
 border-radius: 4px;
 cursor: pointer;
 transition: all 200ms;
}
.rep-tab-btn:hover { color: #fff; background: rgba(255,255,255,0.03); }
.rep-tab-btn.active { color: #f97316; background: rgba(249,115,22,0.1); border-color: rgba(249,115,22,0.2); }
.rep-pane.hidden { display: none !important; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
 // Tabs
 document.querySelectorAll('.rep-tab-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
   document.querySelectorAll('.rep-tab-btn').forEach(function(b) { b.classList.remove('active'); });
   document.querySelectorAll('.rep-pane').forEach(function(p) { p.classList.add('hidden'); });
   this.classList.add('active');
   document.getElementById('rep-pane-' + this.dataset.tab).classList.remove('hidden');
  });
 });

 // Charts (Dashboard tab)
 var reportStats = {{{json reportStats}}};

 var ctx1 = document.getElementById('renderEngineChart');
 if (ctx1) {
 new Chart(ctx1.getContext('2d'), {
  type: 'doughnut',
  data: { labels: Object.keys(reportStats.renderEngines), datasets: [{ data: Object.values(reportStats.renderEngines), backgroundColor: ['#f97316', '#3b82f6', '#10b981'], borderWidth: 0 }] },
  options: { responsive: true, maintainAspectRatio: false, cutout: '65%', plugins: { legend: { position: 'bottom', labels: { color: '#9ca3af', font: { size: 9 } } } } }
 });
 }

 var ctx2 = document.getElementById('stylePriceChart');
 if (ctx2) {
 new Chart(ctx2.getContext('2d'), {
  type: 'bar',
  data: { labels: Object.keys(reportStats.stylePrices), datasets: [{ data: Object.values(reportStats.stylePrices), backgroundColor: 'rgba(249,115,22,0.6)', borderRadius: 4 }] },
  options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#6b7280', font: { size: 9 }, callback: function(v) { return 'R$' + v; } } }, x: { grid: { display: false }, ticks: { color: '#9ca3af', font: { size: 8 } } } } }
 });
 }

 var ctx3 = document.getElementById('funnelConversionChart');
 if (ctx3) {
 new Chart(ctx3.getContext('2d'), {
  type: 'bar',
  data: { labels: ['Leads', 'Propostas', 'Projetos'], datasets: [{ data: [reportStats.funnel.leads, reportStats.funnel.proposals, reportStats.funnel.projects], backgroundColor: ['rgba(59,130,246,0.6)', 'rgba(249,115,22,0.6)', 'rgba(16,185,129,0.6)'], borderRadius: 4 }] },
  options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#6b7280', font: { size: 9 } } }, x: { grid: { display: false }, ticks: { color: '#9ca3af', font: { size: 9 } } } } }
 });
 }
});
</script>
