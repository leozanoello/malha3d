<!-- Header Section -->
<div class="mb-10 p-8 glass-card border-none bg-gradient-to-br from-white/5 to-white/[0.02]">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h1 class="text-4xl font-black text-white tracking-tight mb-2">
                Ecossistema de <span class="text-gradient">Contatos</span>
            </h1>
            <p class="text-gray-400 font-medium">
                Gestão centralizada de <span class="text-orange-500">Clientes, Leads e Parceiros</span>.
            </p>
        </div>
        <div class="flex items-center gap-4">
            <div class="relative group">
                <span class="absolute inset-y-0 left-4 flex items-center text-gray-500">
                    <span class="material-symbols-outlined text-lg">search</span>
                </span>
                <input type="text" placeholder="Buscar no ecossistema..." class="bg-white/5 border border-white/10 rounded-2xl py-3 pl-12 pr-6 text-sm font-medium text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500/50 transition-all w-64">
            </div>
            <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-8 rounded-2xl shadow-2xl shadow-orange-500/40 transition-all flex items-center gap-3" data-bs-toggle="modal" data-bs-target="#newRegistryModal">
                <span class="material-symbols-outlined">person_add</span>
                Novo Contato
            </button>
        </div>
    </div>
</div>

<!-- Filters & Actions -->
<div class="flex flex-wrap items-center gap-4 mb-8">
    <button class="px-6 py-2 rounded-xl bg-orange-500 text-white text-xs font-black uppercase tracking-widest shadow-lg shadow-orange-500/20">Todos</button>
    <button class="px-6 py-2 rounded-xl bg-white/5 text-gray-400 text-xs font-black uppercase tracking-widest hover:bg-white/10 transition-all">Clientes</button>
    <button class="px-6 py-2 rounded-xl bg-white/5 text-gray-400 text-xs font-black uppercase tracking-widest hover:bg-white/10 transition-all">Leads</button>
    <button class="px-6 py-2 rounded-xl bg-white/5 text-gray-400 text-xs font-black uppercase tracking-widest hover:bg-white/10 transition-all">Parceiros</button>
    <div class="h-6 w-[1px] bg-white/10 mx-2"></div>
    <button class="p-2 rounded-xl bg-white/5 text-gray-400 hover:text-white transition-all">
        <span class="material-symbols-outlined">filter_list</span>
    </button>
</div>

<!-- Contacts Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
    {{#each clients}}
    <div class="glass-card p-6 border-white/5 hover:border-orange-500/30 group transition-all duration-300 relative overflow-hidden">
        <!-- Floating Accent -->
        <div class="absolute top-0 right-0 w-24 h-24 bg-orange-500/5 rounded-full blur-2xl -mr-12 -mt-12 group-hover:bg-orange-500/10 transition-all"></div>
        
        <div class="flex items-start justify-between mb-6 relative z-10">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-orange-500/20 to-orange-600/20 flex items-center justify-center text-orange-500 font-black text-xl border border-orange-500/20 group-hover:scale-110 transition-transform">
                    {{firstLetter this.name}}
                </div>
                <div>
                    <h3 class="text-base font-black text-white leading-tight mb-1">{{this.name}}</h3>
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">{{this.company}}</span>
                        <span class="w-1 h-1 bg-gray-700 rounded-full"></span>
                        <span class="text-[9px] font-black {{#if (eq this.type 'PJ')}}text-blue-400{{else}}text-purple-400{{/if}} uppercase">{{this.type}}</span>
                    </div>
                </div>
            </div>
            <div class="flex flex-col items-end gap-2">
                {{#if (eq this.category 'Lead')}}
                <span class="text-[8px] font-black text-orange-500 bg-orange-500/10 px-2 py-0.5 rounded-full uppercase tracking-tighter ring-1 ring-orange-500/30">Lead</span>
                {{else if (eq this.category 'Cliente')}}
                <span class="text-[8px] font-black text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded-full uppercase tracking-tighter ring-1 ring-emerald-500/30">Cliente</span>
                {{else}}
                <span class="text-[8px] font-black text-sky-400 bg-sky-400/10 px-2 py-0.5 rounded-full uppercase tracking-tighter ring-1 ring-sky-400/30">{{this.category}}</span>
                {{/if}}
            </div>
        </div>

        <div class="space-y-3 mb-6 relative z-10">
            <div class="flex items-center gap-3 text-gray-400 hover:text-white transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-sm opacity-50">mail</span>
                <span class="text-xs font-medium truncate">{{this.email}}</span>
            </div>
            <div class="flex items-center justify-between gap-3 text-gray-400">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-sm opacity-50">call</span>
                    <span class="text-xs font-medium">{{formatPhone this.phone}}</span>
                </div>
                <a href="{{formatWhatsappLink this.phone this.name 'lead'}}" target="_blank" class="p-2 rounded-lg bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500/20 transition-all flex items-center justify-center">
                    <i class="fab fa-whatsapp text-xs"></i>
                </a>
            </div>
            <div class="flex items-center gap-3 text-gray-400">
                <span class="material-symbols-outlined text-sm opacity-50">lan</span>
                <span class="text-xs font-medium">Origem: {{this.source}}</span>
            </div>
        </div>

        <div class="flex items-center gap-2 pt-4 border-t border-white/5 relative z-10">
            <button class="flex-1 bg-white/5 hover:bg-white/10 text-white text-[10px] font-black uppercase tracking-widest py-2 rounded-xl transition-all">Ver Detalhes</button>
            <button class="p-2 rounded-xl bg-white/5 text-gray-500 hover:text-orange-500 transition-all">
                <span class="material-symbols-outlined text-sm">edit</span>
            </button>
            <button class="p-2 rounded-xl bg-white/5 text-gray-500 hover:text-red-500 transition-all">
                <span class="material-symbols-outlined text-sm">delete</span>
            </button>
        </div>
    </div>
    {{else}}
    <div class="col-span-full py-20 flex flex-col items-center justify-center glass-card border-dashed border-white/10">
        <div class="w-20 h-20 rounded-3xl bg-white/5 flex items-center justify-center mb-6">
            <span class="material-symbols-outlined text-4xl text-gray-600">person_off</span>
        </div>
        <h3 class="text-xl font-black text-white mb-2">Nenhum contato encontrado</h3>
        <p class="text-gray-500 font-medium mb-8">Comece adicionando seu primeiro lead ou cliente ao ecossistema.</p>
        <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-3 px-8 rounded-2xl shadow-xl shadow-orange-500/20 transition-all" data-bs-toggle="modal" data-bs-target="#newRegistryModal">
            Adicionar Contato
        </button>
    </div>
    {{/each}}
</div>
