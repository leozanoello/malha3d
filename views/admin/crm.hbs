window.submitNewLead = async function(e) {
 e.preventDefault();
 const form = e.target;
 const submitBtn = form.querySelector('#btnSaveProject') || form.querySelector('button[type="submit"]') || document.getElementById('btnSaveProject');
 const originalText = submitBtn ? submitBtn.innerHTML : '';

 submitBtn.disabled = true;
 submitBtn.innerHTML = '<span class="animate-spin material-symbols-outlined text-sm">sync</span> Processando...';

 const formData = new FormData(form);
 const data = Object.fromEntries(formData.entries());

 try {
 const res = await fetch('/admin/negociacoes/novo', {
 method: 'POST',
 headers: {
 'Content-Type': 'application/json',
 'Accept': 'application/json'
 },
 body: JSON.stringify(data)
 });

 // Debug: log status e resposta
 console.log('[submitNewLead] HTTP Status:', res.status);

 const json = await res.json();
 console.log('[submitNewLead] Response JSON:', json);

 if (json.success && res.ok) {
 if (window.clearFormDraft) window.clearFormDraft(form.id || 'newLeadForm');
 document.getElementById('newLeadModal').classList.add('hidden');
 if (window.showToast) window.showToast('Lead criado com sucesso! Atualizando...', 'success');
 // Aguarda um pouco antes de recarregar para a IA gerar banner
 setTimeout(() => {
   window.location.reload();
 }, 1500);
 } else {
 const errMsg = json.error || json.message || 'Erro desconhecido';
 console.error('[submitNewLead] Erro do servidor:', errMsg);
 if (window.showToast) window.showToast('Erro: ' + errMsg, 'error');
 else alert('Erro ao criar lead: ' + errMsg);
 if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = originalText; }
