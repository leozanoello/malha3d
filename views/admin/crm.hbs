 // === SISTEMA DE PRODUTIVIDADE (Tabela de Produtos ArchViz + Cálculo) ===
const ARCHVIZ_PRODUCTS = [
  { id: 'img_interiores', name: 'Imagens Estáticas de Interiores', unit: 'Unidades + Ambiente', difficulty: 6 },
  { id: 'img_exteriores', name: 'Imagens Estáticas de Exteriores / Fachadas', unit: 'Unidades + Ângulos', difficulty: 7 },
  { id: 'animacao_walkthrough', name: 'Passeios Virtuais / Animações em Vídeo', unit: 'Segundos + Ângulos', difficulty: 9.5 },
  { id: 'panorama_360', name: 'Panoramas 360° / Tours Virtuais Interativos', unit: 'Pontos', difficulty: 5 },
  { id: 'plantas_humanizadas', name: 'Plantas Humanizadas (2D ou 3D)', unit: 'Ambientes + Pavimentos', difficulty: 3 },
  { id: 'masterplan', name: 'Maquetes Eletrônicas (Masterplan)', unit: 'Por Empreendimento Completo', difficulty: 9 }
];

const CLASS_WEIGHTS = { luxo: 10, A: 8.5, B: 7, C: 5 };
// Tempo base em horas por unidade de trabalho × dificuldade (escala 0-10)
function calcHours(productId, quantity) {
  const p = ARCHVIZ_PRODUCTS.find(x => x.id === productId);
  if (!p || !quantity || quantity < 1) return 0;
  // Fórmula: horas = quantidade × (dificuldade/10) × fator base de 2
  return quantity * (p.difficulty / 10) * 2;
}

