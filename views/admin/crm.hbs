 // === EXECUÇÃO REAL DA CONVERSÃO (chamada pelo botão Confirmar) ===
 window.executeConvertLead = async function(leadId, btn) {
  try {
   if (btn) { btn.disabled = true; btn.style.opacity = '0.5'; }
   const res = await fetch(`/admin/api/negociacoes/${leadId}/convert-to-modelagem`, {
    method: 'POST',
    headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
   });
   const data = await res.json();
   const modalEl = document.getElementById('convertConfirmModal');
   if (modalEl) modalEl.remove();

   if (data.success) {
    const card = document.querySelector(`.kanban-card-wrap[data-id="${leadId}"]`);
    if (card) {
     card.style.opacity = '0.45';
     card.style.pointerEvents = 'none';
     const badge = document.createElement('div');
     badge.className = 'absolute top-2 left-2 px-2 py-0.5 bg-indigo-500/20 border border-indigo-500/40 rounded-full text-[8px] font-black text-indigo-300 uppercase tracking-widest z-30';
     badge.textContent = 'Convertido';
     card.appendChild(badge);
    }
    if (confirm('✅ Lead convertido com sucesso!\n\nDeseja ir para a página de Projetos agora?')) {
     window.location.href = data.redirectUrl || '/admin/projetos';
    }
   } else if (res.status === 409) {
    if (confirm('⚠️ ' + data.error + '\n\nDeseja abrir os Projetos agora?')) {
     window.location.href = '/admin/projetos';
    }
   } else {
    alert('Erro: ' + (data.error || 'Falha na conversão'));
   }
  } catch (err) {
   console.error('Convert error:', err);
   alert('Erro de rede ao converter lead');
  }
 };

 window.trashLead = async function(leadId) {
 if (!confirm('Mover este lead para a lixeira?')) return;
 try {
 const res = await fetch(`/admin/negociacoes/${leadId}/update-status`, {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ status: 'lixeira' })
 });
 if (res.ok) {
 const card = document.querySelector(`[data-id="${leadId}"]`);
 if (card) card.remove();
 } else {
 alert('Erro ao mover para lixeira');
 }
 } catch (err) {
 alert('Erro de rede');
 }
 };

