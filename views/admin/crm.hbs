<!-- 
    MALHA 3D - CRM PREMIUM (LEADS & PROSPECTS)
    Design: Liquid Glass / Ultra High Density / ArchViz Focused
-->

<div class="crm-wrapper animate-in fade-in duration-700">
    <!-- Header: Business Intelligence & Quick Actions -->
    <div class="mb-10 p-10 glass-card border-none bg-gradient-to-br from-white/10 to-white/[0.02] relative overflow-hidden rounded-[3rem]">
        <div class="absolute top-0 right-0 w-96 h-96 bg-orange-500/10 blur-[120px] -mr-48 -mt-48 animate-pulse"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-blue-500/5 blur-[100px] -ml-32 -mb-32"></div>
        
        <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-8 relative z-10">
            <div>
                <div class="flex items-center gap-4 mb-3">
                    <div class="w-12 h-12 rounded-2xl bg-orange-500 flex items-center justify-center shadow-2xl shadow-orange-500/40">
                        <span class="material-symbols-outlined text-white text-2xl">hub</span>
                    </div>
                    <div>
                        <h1 class="text-4xl font-black text-white tracking-tighter leading-none">
                            Central de <span class="text-gradient">Leads</span>
                        </h1>
                        <p class="text-gray-400 font-bold text-[10px] uppercase tracking-[0.3em] mt-1">Intelligence CRM & Acquisition</p>
                    </div>
                </div>
            </div>
            
            <div class="flex flex-wrap items-center gap-4">
                <!-- Stats Summary -->
                <div class="flex gap-6 px-8 py-4 bg-black/40 rounded-3xl border border-white/5 backdrop-blur-md">
                    <div class="text-center">
                        <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-1">Total Leads</p>
                        <p class="text-xl font-black text-white">{{length budgets}}</p>
                    </div>
                    <div class="w-px h-8 bg-white/10 self-center"></div>
                    <div class="text-center">
                        <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-1">Conversão</p>
                        <p class="text-xl font-black text-orange-500">24%</p>
                    </div>
                </div>

                <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-10 rounded-2xl shadow-2xl shadow-orange-500/30 transition-all flex items-center gap-3 text-[11px] uppercase tracking-[0.2em] hover:scale-[1.02] active:scale-95" onclick="const m = document.getElementById('newLeadModal'); m.classList.remove('hidden'); m.style.display='flex';">
                    <span class="material-symbols-outlined text-base">person_add</span>
                    Novo Lead
                </button>
            </div>
        </div>

        <!-- Sub-Navigation -->
        <div class="flex items-center gap-3 mt-12 p-2 bg-black/30 rounded-[1.5rem] w-fit border border-white/5">
            <button class="px-10 py-3.5 text-[10px] font-black uppercase tracking-[0.2em] rounded-xl transition-all flex items-center gap-2 bg-orange-500 text-white shadow-xl shadow-orange-500/20 tab-btn-nav active" data-tab="kanban">
                <span class="material-symbols-outlined text-sm">view_kanban</span> Pipeline
            </button>
            <button class="px-10 py-3.5 text-[10px] font-black uppercase tracking-[0.2em] rounded-xl text-gray-500 hover:text-white transition-all flex items-center gap-2 tab-btn-nav" data-tab="forecast">
                <span class="material-symbols-outlined text-sm">query_stats</span> Previsão
            </button>
            <button class="px-10 py-3.5 text-[10px] font-black uppercase tracking-[0.2em] rounded-xl text-gray-500 hover:text-white transition-all flex items-center gap-2 tab-btn-nav" data-tab="templates">
                <span class="material-symbols-outlined text-sm">auto_awesome</span> Biblioteca
            </button>
        </div>
    </div>

    <!-- Main Content Area -->
    <div id="crm-main-content">
        <!-- View 1: KANBAN -->
        <div id="tab-kanban" class="tab-pane active">
            <div class="flex gap-8 overflow-x-auto pb-12 min-h-[800px] scrollbar-premium px-2">
                {{#each columns}}
                <div class="flex-shrink-0 w-[320px] flex flex-col gap-6">
                    <!-- Column Header -->
                    <div class="flex items-center justify-between px-4">
                        <div class="flex items-center gap-4">
                            <div class="w-2 h-8 rounded-full shadow-[0_0_20px_rgba(249,115,22,0.4)]" style="background-color: {{this.color}}"></div>
                            <div>
                                <h4 class="text-[12px] font-black text-white uppercase tracking-[0.2em]">{{this.title}}</h4>
                                <p class="text-[9px] font-bold text-gray-500 uppercase tracking-widest mt-0.5">{{length (lookup ../kanban this.statusKey)}} Leads</p>
                            </div>
                        </div>
                        <div class="dropdown">
                            <button class="w-9 h-9 rounded-xl bg-white/5 flex items-center justify-center text-gray-500 hover:text-white transition-all" data-bs-toggle="dropdown">
                                <span class="material-symbols-outlined text-sm">more_vert</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark glass-card border-white/10 p-2 rounded-2xl shadow-2xl">
                                <li><a class="dropdown-item text-[10px] font-black uppercase tracking-widest py-3 flex items-center gap-3 rounded-xl hover:bg-orange-500 btn-edit-col" href="#" data-id="{{this.id}}" data-title="{{this.title}}" data-color="{{this.color}}">
                                    <span class="material-symbols-outlined text-sm">settings</span> Editar Etapa
                                </a></li>
                                <li><a class="dropdown-item text-[10px] font-black uppercase tracking-widest py-3 flex items-center gap-3 rounded-xl text-red-400 hover:bg-red-500 hover:text-white btn-delete-col" href="#" data-id="{{this.id}}">
                                    <span class="material-symbols-outlined text-sm">delete</span> Excluir
                                </a></li>
                            </ul>
                        </div>
                    </div>
                    
                    <!-- Kanban Drop Zone -->
                    <div class="kanban-drop-zone p-3 rounded-[2.5rem] border border-transparent hover:border-white/5 hover:bg-white/[0.01] transition-all flex-1 flex flex-col gap-5 min-h-[600px]" 
                         id="col-{{this.statusKey}}" 
                         data-status="{{this.statusKey}}">
                        
                        {{#each (lookup ../kanban this.statusKey)}}
                            {{> kanbanCard lead=this}}
                        {{/each}}

                        {{#unless (length (lookup ../kanban this.statusKey))}}
                        <div class="flex-1 border-2 border-dashed border-white/[0.03] rounded-[2rem] flex flex-col items-center justify-center opacity-20 group-hover:opacity-40 transition-opacity">
                            <span class="material-symbols-outlined text-5xl mb-4 text-gray-600">move_item</span>
                            <p class="text-[9px] font-black uppercase tracking-widest text-gray-500">Mover Lead para cá</p>
                        </div>
                        {{/unless}}
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        <!-- View 2: FORECAST (Intelligence) -->
        <div id="tab-forecast" class="tab-pane hidden animate-in slide-in-from-bottom-4 duration-500">
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-10">
                <div class="xl:col-span-2 space-y-10">
                    <div class="glass-card p-10 border-white/5 bg-black/20 rounded-[3rem]">
                        <h3 class="text-xl font-black text-white mb-10 flex items-center gap-3">
                            <span class="material-symbols-outlined text-orange-500">insights</span> Previsão de Receita (IA)
                        </h3>
                        <div class="h-[400px] w-full relative">
                            <!-- Chart Placeholder for Chart.js -->
                            <canvas id="forecastChart"></canvas>
                        </div>
                    </div>
                </div>
                
                <div class="space-y-8">
                    <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-emerald-500/10 to-transparent rounded-[2.5rem]">
                        <p class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] mb-2">VGV Estimado (Total)</p>
                        <h4 class="text-4xl font-black text-emerald-400 tracking-tighter">R$ {{numberFormat totalVgv 2 ',' '.'}}</h4>
                        <p class="text-[9px] text-gray-500 font-bold uppercase mt-4">Calculado com base em {{length budgets}} leads ativos</p>
                    </div>

                    <div class="glass-card p-8 border-white/5 bg-white/5 rounded-[2.5rem] space-y-6">
                        <h5 class="text-[11px] font-black text-white uppercase tracking-[0.2em]">Peso por Etapa</h5>
                        {{#each columns}}
                        <div class="space-y-2">
                            <div class="flex justify-between items-center">
                                <span class="text-[10px] font-bold text-gray-400 uppercase">{{this.title}}</span>
                                <span class="text-[10px] font-black text-white">85%</span>
                            </div>
                            <div class="h-1.5 w-full bg-white/5 rounded-full overflow-hidden">
                                <div class="h-full bg-orange-500 shadow-[0_0_10px_rgba(249,115,22,0.4)]" style="width: 85%"></div>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>
        </div>

        <!-- View 3: TEMPLATES (Library) -->
        <div id="tab-templates" class="tab-pane hidden animate-in zoom-in duration-500">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8" id="template-grid">
                <!-- Loaded via JS -->
            </div>
        </div>
    </div>
</div>



<!-- Modal: Manage Lead (Ultra Advanced) -->
<div id="manageLeadModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-sm" style="display: none;">
    <div class="glass-card w-full max-w-6xl relative rounded-[3rem] bg-[#0c0e12]/95 backdrop-blur-3xl overflow-hidden shadow-2xl">
        <div class="flex h-[85vh]">
                <!-- Sidebar Nav -->
                <div class="w-24 border-r border-white/5 flex flex-col items-center py-10 gap-8 bg-black/20">
                    <button class="modal-tab-btn active w-14 h-14 rounded-2xl flex items-center justify-center transition-all group" data-tab="details">
                        <span class="material-symbols-outlined text-2xl">person</span>
                        <span class="absolute left-24 px-3 py-1 bg-orange-500 text-white text-[8px] font-black uppercase tracking-widest rounded opacity-0 group-hover:opacity-100 transition-all">Perfil</span>
                    </button>
                    <button class="modal-tab-btn w-14 h-14 rounded-2xl flex items-center justify-center transition-all group" data-tab="briefing">
                        <span class="material-symbols-outlined text-2xl">description</span>
                        <span class="absolute left-24 px-3 py-1 bg-orange-500 text-white text-[8px] font-black uppercase tracking-widest rounded opacity-0 group-hover:opacity-100 transition-all">Briefing</span>
                    </button>
                    <button class="modal-tab-btn w-14 h-14 rounded-2xl flex items-center justify-center transition-all group" data-tab="tasks">
                        <span class="material-symbols-outlined text-2xl">task_alt</span>
                        <span class="absolute left-24 px-3 py-1 bg-orange-500 text-white text-[8px] font-black uppercase tracking-widest rounded opacity-0 group-hover:opacity-100 transition-all">Tarefas</span>
                    </button>
                    <button class="modal-tab-btn w-14 h-14 rounded-2xl flex items-center justify-center transition-all group" data-tab="ai">
                        <span class="material-symbols-outlined text-2xl text-orange-500">psychology</span>
                        <span class="absolute left-24 px-3 py-1 bg-orange-500 text-white text-[8px] font-black uppercase tracking-widest rounded opacity-0 group-hover:opacity-100 transition-all">Predict</span>
                    </button>
                </div>

                <!-- Main Content -->
                <div class="flex-1 flex flex-col">
                    <header class="p-10 border-b border-white/5 flex justify-between items-center bg-white/[0.01]">
                        <div class="flex items-center gap-6">
                            <div class="w-16 h-16 rounded-[1.5rem] overflow-hidden border-2 border-orange-500/30 p-1">
                                <img id="modalLeadImgTag" src="" class="w-full h-full object-cover rounded-xl">
                            </div>
                            <div>
                                <h2 id="modalLeadName" class="text-3xl font-black text-white tracking-tighter mb-1">Lead Name</h2>
                                <div class="flex items-center gap-3">
                                    <span id="modalLeadStatus" class="px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-[9px] font-black text-orange-500 uppercase tracking-widest">Status</span>
                                    <span class="text-[9px] font-bold text-gray-500 flex items-center gap-1">
                                        <span class="material-symbols-outlined text-xs">history</span>
                                        Criado há 3 dias
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="flex gap-4 items-center">
                            <button type="button" id="btn-edit-toggle" class="h-12 px-6 rounded-2xl bg-white/5 text-white font-black text-[10px] uppercase tracking-widest border border-white/10 hover:bg-white/10 transition-all flex items-center gap-2">
                                <span class="material-symbols-outlined text-sm">edit</span> Editar Lead
                            </button>
                            <form id="confirmProjectForm" action="" method="POST" class="m-0">
                                <button type="submit" class="h-12 px-6 rounded-2xl bg-emerald-500 text-white font-black text-[10px] uppercase tracking-widest shadow-xl shadow-emerald-500/20 hover:scale-105 transition-all flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm">check_circle</span> Confirmar Lead
                                </button>
                            </form>
                            <button type="button" class="w-12 h-12 rounded-2xl bg-white/5 flex items-center justify-center text-gray-400 hover:text-white transition-all" onclick="document.getElementById('manageLeadModal').classList.add('hidden'); document.getElementById('manageLeadModal').style.display='none';">
                                <span class="material-symbols-outlined">close</span>
                            </button>
                        </div>
                    </header>

                    <div class="flex-1 overflow-y-auto p-12 custom-scrollbar">
                        <!-- Pane: DETAILS (Edit Form) -->
                        <form id="editLeadForm" action="" method="POST" class="modal-pane space-y-8" id="modal-tab-details">
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                                <div class="space-y-4">
                                    <h4 class="text-[10px] font-black text-orange-500 uppercase tracking-widest mb-4 border-b border-white/5 pb-2">Informações de Contato</h4>
                                    <div>
                                        <label class="block text-[10px] text-gray-400 font-bold uppercase mb-2">Nome do Lead/Projeto</label>
                                        <input type="text" id="editName" name="name" required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-orange-500 focus:outline-none transition-all">
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-[10px] text-gray-400 font-bold uppercase mb-2">Email</label>
                                            <input type="email" id="editEmail" name="email" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-orange-500 focus:outline-none transition-all">
                                        </div>
                                        <div>
                                            <label class="block text-[10px] text-gray-400 font-bold uppercase mb-2">Telefone</label>
                                            <input type="text" id="editPhone" name="phone" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-orange-500 focus:outline-none transition-all">
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-[10px] text-gray-400 font-bold uppercase mb-2">Tipologia</label>
                                            <select id="editProjectType" name="projectType" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-orange-500 focus:outline-none transition-all appearance-none">
                                                <option value="Interiores" class="bg-gray-900">Interiores</option>
                                                <option value="Arquitetônico" class="bg-gray-900">Arquitetônico</option>
                                                <option value="Comercial" class="bg-gray-900">Comercial</option>
                                                <option value="Outro" class="bg-gray-900">Outro</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-[10px] text-gray-400 font-bold uppercase mb-2">Cor de Destaque</label>
                                            <div class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-xl px-4 py-2">
                                                <input type="color" id="editColor" name="color" class="w-8 h-8 rounded cursor-pointer bg-transparent border-0">
                                                <span class="text-xs text-gray-400">Card Color</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block text-[10px] text-gray-400 font-bold uppercase mb-2">Link Drive/Moodboard</label>
                                        <input type="url" id="editDriveLink" name="driveLink" placeholder="https://" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-orange-500 focus:outline-none transition-all">
                                    </div>
                                    <div class="pt-4">
                                        <label class="block text-[10px] text-gray-400 font-bold uppercase mb-2">Breve Descrição do Projeto</label>
                                        <textarea id="editDescription" name="description" rows="3" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-orange-500 focus:outline-none transition-all"></textarea>
                                    </div>
                                </div>

                                <div class="space-y-4">
                                    <h4 class="text-[10px] font-black text-emerald-500 uppercase tracking-widest mb-4 border-b border-white/5 pb-2">Escopo Técnico & Valores</h4>
                                    <div>
                                        <label class="block text-[10px] text-gray-400 font-bold uppercase mb-2">Input Fornecido</label>
                                        <input type="text" id="editVisualStyle" name="visualStyle" placeholder="Ex: SketchUp, DWG, PDF" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-orange-500 focus:outline-none transition-all">
                                    </div>
                                    <div>
                                        <label class="block text-[10px] text-gray-400 font-bold uppercase mb-2">Software Alvo</label>
                                        <select id="editTargetSoftware" name="targetSoftware" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-orange-500 focus:outline-none transition-all appearance-none">
                                            <option value="D5 Render" class="bg-gray-900">D5 Render</option>
                                            <option value="Corona" class="bg-gray-900">Corona Renderer</option>
                                            <option value="V-Ray" class="bg-gray-900">V-Ray</option>
                                        </select>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-[10px] text-gray-400 font-bold uppercase mb-2">Valor Estimado (R$)</label>
                                            <input type="number" step="0.01" id="editEstimatedValue" name="estimatedValue" class="w-full bg-emerald-500/10 border border-emerald-500/20 rounded-xl px-4 py-3 text-emerald-400 font-black focus:border-emerald-500 focus:outline-none transition-all">
                                        </div>
                                        <div>
                                            <label class="block text-[10px] text-gray-400 font-bold uppercase mb-2">Metragem (m²)</label>
                                            <input type="number" step="0.01" id="editTotalArea" name="totalArea" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-orange-500 focus:outline-none transition-all">
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-3 gap-4 mt-4">
                                        <div>
                                            <label class="block text-[9px] text-gray-400 font-bold uppercase mb-2 text-center">Imagens</label>
                                            <input type="number" id="editImagesCount" name="imagesCount" min="0" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-center text-white focus:border-orange-500 focus:outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-[9px] text-gray-400 font-bold uppercase mb-2 text-center">Animação (s)</label>
                                            <input type="number" id="editAnimationSeconds" name="animationSeconds" min="0" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-center text-white focus:border-orange-500 focus:outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-[9px] text-gray-400 font-bold uppercase mb-2 text-center">Plantas Hum.</label>
                                            <input type="number" id="editFloorPlansCount" name="floorPlansCount" min="0" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-center text-white focus:border-orange-500 focus:outline-none">
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-[10px] text-gray-400 font-bold uppercase mb-2">Prazo (Dias)</label>
                                            <input type="number" id="editProductionDays" name="productionDays" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-orange-500 focus:outline-none transition-all">
                                        </div>
                                        <div>
                                            <label class="block text-[10px] text-gray-400 font-bold uppercase mb-2">Deadline (Data)</label>
                                            <input type="date" id="editDeadline" name="deadline" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-orange-500 focus:outline-none transition-all">
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block text-[10px] text-gray-400 font-bold uppercase mb-2">Budget do Cliente (R$)</label>
                                        <input type="number" step="0.01" id="editClientBudget" name="clientBudget" class="w-full bg-emerald-500/10 border border-emerald-500/20 rounded-xl px-4 py-3 text-emerald-400 font-black focus:border-emerald-500 focus:outline-none transition-all">
                                    </div>
                                     <div id="edit-actions" class="pt-6 flex gap-4 hidden">
                                         <button type="button" id="btn-cancel-edit" class="flex-1 py-4 rounded-xl bg-white/5 text-white font-black text-[10px] uppercase tracking-widest border border-white/10 hover:bg-white/10 transition-all">
                                             Cancelar
                                         </button>
                                         <button type="submit" class="flex-[2] py-4 rounded-xl bg-orange-500 text-white font-black text-[10px] uppercase tracking-widest shadow-xl shadow-orange-500/20 hover:scale-105 transition-all flex items-center justify-center gap-2">
                                             <span class="material-symbols-outlined text-sm">save</span> Salvar Alterações
                                         </button>
                                     </div>
                                 </div>
                             </div>
                         </form>

                        <!-- Pane: BRIEFING -->
                        <div id="modal-tab-briefing" class="modal-pane hidden animate-in slide-in-from-right-4">
                            <div class="space-y-6">
                                <h4 class="text-xl font-black text-white tracking-tighter">Briefing Completo</h4>
                                <div id="briefingContent" class="p-10 rounded-[3rem] bg-white/[0.02] border border-white/5 min-h-[300px]">
                                    <!-- Dynamic content -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- NOVO LEAD MODAL (FRENTE 2) -->
<div id="newLeadModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-sm flex" style="display: none;">
    <div class="glass-card w-full max-w-2xl p-8 relative">
        <button type="button" class="absolute top-6 right-6 text-gray-400 hover:text-white" onclick="document.getElementById('newLeadModal').classList.add('hidden'); document.getElementById('newLeadModal').style.display='none';">
            <span class="material-symbols-outlined">close</span>
        </button>
        <h3 class="text-xl font-black text-white uppercase tracking-tighter mb-6">Criar Novo Lead (Archviz)</h3>
        
        <form action="/admin/negociacoes/novo" method="POST" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div class="col-span-2">
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Nome do Projeto/Lead</label>
                    <input type="text" name="name" required class="input-premium w-full">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Contato/Cliente</label>
                    <input type="text" name="clientName" class="input-premium w-full">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Tipologia</label>
                    <select name="projectType" required class="input-premium w-full bg-dark-900 text-white">
                        <option value="Interiores">Interiores</option>
                        <option value="Comercial">Comercial</option>
                        <option value="Arquitetônico">Arquitetônico</option>
                        <option value="Outro">Outro</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Metragem (m²)</label>
                    <input type="number" step="0.01" name="totalArea" class="input-premium w-full">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Formato de Entrada</label>
                    <input type="text" name="visualStyle" placeholder="Ex: Revit, SketchUp" class="input-premium w-full">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Software Alvo</label>
                    <select name="targetSoftware" class="input-premium w-full bg-dark-900 text-white">
                        <option value="D5 Render">D5 Render</option>
                        <option value="Corona">Corona</option>
                        <option value="V-Ray">V-Ray</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">VGV Estimado (R$)</label>
                    <input type="number" step="0.01" name="estimatedValue" class="input-premium w-full text-emerald-400 font-bold" placeholder="0.00">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Budget Cliente (R$)</label>
                    <input type="number" step="0.01" name="clientBudget" class="input-premium w-full text-blue-400 font-bold" placeholder="0.00">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Prazo (Dias)</label>
                    <input type="number" name="productionDays" class="input-premium w-full">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Deadline</label>
                    <input type="date" name="deadline" class="input-premium w-full">
                </div>
            </div>
            
            <div class="pt-4 flex justify-end gap-3">
                <button type="button" class="btn bg-white/5 text-white" onclick="document.getElementById('newLeadModal').classList.add('hidden'); document.getElementById('newLeadModal').style.display='none';">Cancelar</button>
                <button type="submit" class="btn bg-orange-500 text-white shadow-lg shadow-orange-500/20 flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">save</span> Salvar Lead
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .text-gradient {
        background: linear-gradient(135deg, #f97316 0%, #fbbf24 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .modal-tab-btn {
        background: transparent;
        color: rgba(255,255,255,0.3);
        border: 1px solid transparent;
        position: relative;
    }
    .modal-tab-btn.active {
        background: rgba(249, 115, 22, 0.1);
        color: #f97316;
        border-color: rgba(249, 115, 22, 0.2);
    }
    .modal-tab-btn:hover:not(.active) {
        color: white;
        background: rgba(255,255,255,0.05);
    }
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.05); border-radius: 10px; }
    .scrollbar-premium::-webkit-scrollbar { height: 6px; }
    .scrollbar-premium::-webkit-scrollbar-track { background: rgba(255,255,255,0.02); border-radius: 10px; }
    .scrollbar-premium::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.05); border-radius: 10px; }
    .scrollbar-premium::-webkit-scrollbar-thumb:hover { background: rgba(249,115,22,0.3); }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // === TAB SWITCHING ===
    function switchTab(tabId, el) {
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
        const targetTab = document.getElementById(`tab-${tabId}`);
        if (targetTab) targetTab.classList.remove('hidden');
        
        document.querySelectorAll('.tab-btn-nav').forEach(btn => {
            btn.classList.remove('bg-orange-500', 'text-white', 'shadow-xl', 'shadow-orange-500/20');
            btn.classList.add('text-gray-500');
        });
        
        el.classList.add('bg-orange-500', 'text-white', 'shadow-xl', 'shadow-orange-500/20');
        el.classList.remove('text-gray-500');

        if (tabId === 'forecast') initForecastChart();
        if (tabId === 'templates') loadTemplates();
    }

    document.querySelectorAll('.tab-btn-nav').forEach(btn => {
        btn.addEventListener('click', function() {
            switchTab(this.dataset.tab, this);
        });
    });

    // === MODAL TAB SWITCHING ===
    function switchModalTab(tabId, el) {
        document.querySelectorAll('.modal-pane').forEach(p => p.classList.add('hidden'));
        const target = document.getElementById(`modal-tab-${tabId}`);
        if (target) target.classList.remove('hidden');
        
        document.querySelectorAll('.modal-tab-btn').forEach(btn => btn.classList.remove('active'));
        el.classList.add('active');
    }

    document.querySelectorAll('.modal-tab-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            switchModalTab(this.dataset.tab, this);
        });
    });

    // === EDIT MODE LOGIC ===
    const editLeadForm = document.getElementById('editLeadForm');
    const btnEditToggle = document.getElementById('btn-edit-toggle');
    const btnCancelEdit = document.getElementById('btn-cancel-edit');
    const editActions = document.getElementById('edit-actions');

    function toggleEditMode(enabled) {
        if (!editLeadForm) return;
        const inputs = editLeadForm.querySelectorAll('input, select, textarea');
        inputs.forEach(input => {
            if (input.name !== 'id') {
                input.disabled = !enabled;
            }
        });
        
        if (enabled) {
            editActions?.classList.remove('hidden');
            btnEditToggle?.classList.add('hidden');
        } else {
            editActions?.classList.add('hidden');
            btnEditToggle?.classList.remove('hidden');
        }
    }

    btnEditToggle?.addEventListener('click', () => toggleEditMode(true));
    btnCancelEdit?.addEventListener('click', () => toggleEditMode(false));

    // === LEAD MANAGEMENT ===
    window.manageLead = function(leadData) {
        const data = typeof leadData === 'string' ? JSON.parse(leadData) : leadData;
        
        document.getElementById('modalLeadName').innerText = data.name;
        document.getElementById('modalLeadStatus').innerText = (data.status || '').replace('_', ' ');
        document.getElementById('modalLeadImgTag').src = `https://api.dicebear.com/7.x/avataaars/svg?seed=${data.name}`;
        
        toggleEditMode(false); // Start disabled

        // Update form action
        const editForm = document.getElementById('editLeadForm');
        if(editForm) editForm.action = `/admin/negociacoes/${data.id}/update`;
        
        const confirmForm = document.getElementById('confirmProjectForm');
        if(confirmForm) confirmForm.action = `/admin/negociacoes/${data.id}/confirm-project`;

        // Populate Form Fields
        if(document.getElementById('editName')) document.getElementById('editName').value = data.name || '';
        if(document.getElementById('editEmail')) document.getElementById('editEmail').value = data.email || '';
        if(document.getElementById('editPhone')) document.getElementById('editPhone').value = data.phone || '';
        if(document.getElementById('editProjectType')) document.getElementById('editProjectType').value = data.projectType || 'Outro';
        if(document.getElementById('editColor')) document.getElementById('editColor').value = data.color || '#f97316';
        if(document.getElementById('editVisualStyle')) document.getElementById('editVisualStyle').value = data.visualStyle || '';
        if(document.getElementById('editTargetSoftware')) document.getElementById('editTargetSoftware').value = data.targetSoftware || 'D5 Render';
        if(document.getElementById('editDriveLink')) document.getElementById('editDriveLink').value = data.driveLink || '';
        if(document.getElementById('editEstimatedValue')) document.getElementById('editEstimatedValue').value = data.estimatedValue || '';
        if(document.getElementById('editTotalArea')) document.getElementById('editTotalArea').value = data.totalArea || '';
        if(document.getElementById('editImagesCount')) document.getElementById('editImagesCount').value = data.imagesCount || 0;
        if(document.getElementById('editAnimationSeconds')) document.getElementById('editAnimationSeconds').value = data.animationSeconds || 0;
        if(document.getElementById('editFloorPlansCount')) document.getElementById('editFloorPlansCount').value = data.floorPlansCount || 0;
        if(document.getElementById('editDescription')) document.getElementById('editDescription').value = data.description || '';
        
        // New Fields
        if(document.getElementById('editProductionDays')) document.getElementById('editProductionDays').value = data.productionDays || '';
        if(document.getElementById('editClientBudget')) document.getElementById('editClientBudget').value = data.clientBudget || '';
        if(document.getElementById('editDeadline')) {
            const date = data.deadline ? new Date(data.deadline).toISOString().split('T')[0] : '';
            document.getElementById('editDeadline').value = date;
        }
        
        const modalEl = document.getElementById('manageLeadModal');
        if (modalEl) {
            modalEl.classList.remove('hidden');
            modalEl.style.display = 'flex';
        }
    };

    // Auto-open lead if leadId is in URL
    const urlParams = new URLSearchParams(window.location.search);
    const leadId = urlParams.get('leadId');
    if (leadId) {
        const leadCard = document.querySelector(`.kanban-card-main[data-id="${leadId}"]`);
        if (leadCard && leadCard.dataset.lead) {
            window.manageLead(leadCard.dataset.lead);
        }
    }

    // === FORECAST CHART ===
    let crmChart = null;
    function initForecastChart() {
        const ctx = document.getElementById('forecastChart');
        if (!ctx) return;
        
        if (crmChart) crmChart.destroy();
        
        crmChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun'],
                datasets: [{
                    label: 'Receita Prevista',
                    data: [12000, 19000, 15000, 25000, 22000, 30000],
                    borderColor: '#f97316',
                    borderWidth: 4,
                    tension: 0.4,
                    fill: true,
                    backgroundColor: 'rgba(249, 115, 22, 0.1)',
                    pointRadius: 6,
                    pointBackgroundColor: '#f97316',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { display: false },
                    x: {
                        grid: { display: false },
                        ticks: { color: 'rgba(255,255,255,0.3)', font: { size: 10, weight: 'bold' } }
                    }
                }
            }
        });
    }

    // === TEMPLATE LIBRARY ===
    function loadTemplates() {
        const grid = document.getElementById('template-grid');
        if (!grid) return;
        grid.innerHTML = '<div class="col-span-4 py-20 text-center"><div class="animate-spin w-10 h-10 border-4 border-orange-500 border-t-transparent rounded-full mx-auto mb-6"></div><p class="text-[10px] text-gray-500 font-black uppercase tracking-[0.3em]">Sincronizando Biblioteca de Ativos...</p></div>';

        fetch('/admin/api/templates')
            .then(res => res.json())
            .then(templates => {
                grid.innerHTML = '';
                templates.forEach(tpl => {
                    const card = document.createElement('div');
                    card.className = 'glass-card p-6 border-white/5 bg-white/5 hover:bg-white/10 transition-all cursor-pointer group relative overflow-hidden rounded-3xl';
                    card.innerHTML = `
                        <div class="relative z-10">
                            <div class="flex items-center justify-between mb-4">
                                <span class="text-[8px] bg-orange-500/10 text-orange-500 px-3 py-1 rounded-lg font-black uppercase tracking-widest border border-orange-500/20">${tpl.category}</span>
                            </div>
                            <h5 class="text-[12px] font-black text-white group-hover:text-orange-500 transition-colors mb-2 uppercase">${tpl.name}</h5>
                            <p class="text-[10px] text-gray-500 line-clamp-3 leading-relaxed">${tpl.content}</p>
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-br from-orange-500/0 to-orange-500/0 group-hover:from-orange-500/5 group-hover:to-transparent transition-all"></div>
                    `;
                    grid.appendChild(card);
                });
            })
            .catch(err => {
                grid.innerHTML = '<p class="text-center text-red-500">Erro ao carregar modelos.</p>';
            });
    }
    
    // === AJAX SUBMISSIONS ===
    window.submitNewLead = async function(e) {
        e.preventDefault();
        const form = e.target;
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="animate-spin material-symbols-outlined text-sm">sync</span> Processando...';

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
            const res = await fetch('/admin/negociacoes/novo', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(data)
            });
            const json = await res.json();
            if (json.success) {
                document.getElementById('newLeadModal').classList.add('hidden');
                window.location.reload();
            } else {
                alert('Erro ao criar lead: ' + (json.error || 'Erro desconhecido'));
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        } catch (err) {
            alert('Erro de rede.');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    };

    window.submitEditLead = async function(e) {
        e.preventDefault();
        const form = e.target;
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="animate-spin material-symbols-outlined text-sm">sync</span> Salvando...';

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
            const res = await fetch(form.action, {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(data)
            });
            const json = await res.json();
            if (json.success) {
                document.getElementById('manageLeadModal').classList.add('hidden');
                window.location.reload();
            } else {
                alert('Erro ao atualizar: ' + (json.error || 'Erro desconhecido'));
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        } catch (err) {
            alert('Erro de rede.');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    };

    // Attach to existing forms
    const newLeadForm = document.querySelector('#newLeadModal form');
    if (newLeadForm) newLeadForm.onsubmit = window.submitNewLead;
    
    const manageLeadForm = document.getElementById('editLeadForm');
    if (manageLeadForm) manageLeadForm.onsubmit = window.submitEditLead;

    // === EVENT DELEGATION FOR DYNAMIC ELEMENTS ===
    document.addEventListener('click', function(e) {
        // Edit Column
        const editColBtn = e.target.closest('.btn-edit-col');
        if (editColBtn) {
            e.preventDefault();
            if (window.editColumn) {
                window.editColumn(editColBtn.dataset.id, editColBtn.dataset.title, editColBtn.dataset.color);
            }
            return;
        }

        // Delete Column
        const deleteColBtn = e.target.closest('.btn-delete-col');
        if (deleteColBtn) {
            e.preventDefault();
            if (window.deleteColumn) {
                window.deleteColumn(deleteColBtn.dataset.id);
            }
            return;
        }

        // Manage Lead (Card Click)
        const leadCard = e.target.closest('.kanban-card-main');
        const editLeadBtn = e.target.closest('.btn-edit-lead');
        
        if (editLeadBtn) {
            e.stopPropagation();
            if (window.manageLead) window.manageLead(editLeadBtn.dataset.lead);
            return;
        }
        
        if (leadCard && !e.target.closest('button')) {
            if (window.manageLead) window.manageLead(leadCard.dataset.lead);
        }
    });

    document.addEventListener('dragstart', function(e) {
        const card = e.target.closest('.kanban-card-main');
        if (card && window.onDragStart) {
            window.onDragStart(e, card.dataset.id);
        }
    });
});
</script>
