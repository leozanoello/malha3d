<!--
 MALHA 3D - CRM PREMIUM (LEADS & PROSPECTS)
 Design: Uiverse / kcard Pattern / ArchViz Focused
-->

<div class="crm-wrapper animate-in fade-in duration-700">
 <!-- Header: Same visual as .kcard (bg #151515, radius 5px, subtle shadow) -->
 <div class="mb-3 p-3" style="background:#151515; border-radius:5px; box-shadow:0 2px 8px rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.06);">

 <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-3">
 <!-- Left Side: Title & Sub-Nav -->
 <div class="flex flex-wrap items-center gap-5">
 <div class="flex items-center gap-2.5">
 <div class="w-7 h-7 rounded-md bg-orange-500/15 border border-orange-500/30 flex items-center justify-center">
 <span class="material-symbols-outlined text-orange-400 text-sm">hub</span>
 </div>
 <div>
 <h1 class="text-sm font-black text-white tracking-tight leading-none">
 Central de <span class="text-orange-400">Leads</span>
 </h1>
 <p class="text-[7px] font-bold text-gray-500 uppercase tracking-[0.2em] mt-0.5">CRM & Acquisition</p>
 </div>
 </div>

 <!-- Sub-Navigation -->
 <div class="flex items-center gap-1 p-0.5 rounded-md" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);">
 <a href="/admin/crm" class="px-3 py-1 text-[8px] font-black uppercase tracking-wider rounded-[3px] transition-all flex items-center gap-1 {{#if (eq activeTab 'kanban')}}bg-orange-500 text-white{{else}}text-gray-500 hover:text-white{{/if}}">
 <span class="material-symbols-outlined text-[10px]">view_kanban</span> Pipeline
 </a>
 <a href="/admin/crm/previsao" class="px-3 py-1 text-[8px] font-black uppercase tracking-wider rounded-[3px] transition-all flex items-center gap-1 {{#if (eq activeTab 'forecast')}}bg-orange-500 text-white{{else}}text-gray-500 hover:text-white{{/if}}">
 <span class="material-symbols-outlined text-[10px]">query_stats</span> Previsão
 </a>
 </div>
 </div>

 <!-- Right Side: Actions -->
 <div class="flex flex-wrap items-center gap-2">
 <div class="relative flex items-center">
 <span class="material-symbols-outlined absolute left-2 text-gray-500 text-[13px] pointer-events-none">search</span>
 <input type="text" id="kanbanSearch" placeholder="Pesquisar..." class="pl-7 pr-3 py-1.5 text-[9px] font-bold text-white placeholder-gray-500 focus:outline-none focus:border-orange-500/40 transition-colors w-36" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:4px;">
 </div>

 <!-- Stats compact -->
 <div class="flex gap-3 px-3 py-1.5 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
 <div class="text-center">
 <p class="text-[7px] font-bold text-gray-500 uppercase tracking-widest">Leads</p>
 <p class="text-[11px] font-black text-white">{{length budgets}}</p>
 </div>
 <div class="w-px bg-white/10 self-stretch"></div>
 <div class="text-center">
 <p class="text-[7px] font-bold text-gray-500 uppercase tracking-widest">Conv.</p>
 <p class="text-[11px] font-black text-orange-400">{{avgConversion}}%</p>
 </div>
 </div>

 <!-- Bulk Edit -->
 <button id="btn-bulk-edit" class="py-1.5 px-3 rounded-[4px] transition-all flex items-center gap-1.5 text-[8px] font-black uppercase tracking-wider text-gray-400 hover:text-white" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" onclick="window.toggleBulkMode()">
 <span class="material-symbols-outlined text-[11px]">edit_note</span> Editar
 </button>
 <div id="bulk-toolbar" class="hidden flex items-center gap-2 px-3 py-1.5 rounded-[4px]" style="background:rgba(249,115,22,0.08); border:1px solid rgba(249,115,22,0.2);">
 <span class="text-[8px] font-black text-orange-400 uppercase"><span id="bulk-count">0</span> sel.</span>
 <button onclick="window.bulkTrashLeads()" class="flex items-center gap-1 px-2 py-1 rounded-[3px] text-amber-400 text-[8px] font-bold hover:bg-amber-500/20 transition-all" style="background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.2);">
 <span class="material-symbols-outlined text-[10px]">delete</span> Lixeira
 </button>
 <button onclick="window.bulkDeleteLeads()" class="flex items-center gap-1 px-2 py-1 rounded-[3px] text-red-400 text-[8px] font-bold hover:bg-red-500/20 transition-all" style="background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.2);">
 <span class="material-symbols-outlined text-[10px]">delete_forever</span> Apagar
 </button>
 <button onclick="window.toggleBulkMode()" class="text-gray-400 text-[8px] font-bold px-2 py-1 rounded-[3px] hover:text-white" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);">Cancelar</button>
 </div>

 <!-- + Nova Coluna -->
 <button onclick="window.openAddColumnModal()" class="py-1.5 px-3 rounded-[4px] transition-all flex items-center gap-1.5 text-[8px] font-black uppercase tracking-wider text-emerald-400 hover:text-white hover:bg-emerald-500/20" style="background:rgba(16,185,129,0.08); border:1px solid rgba(16,185,129,0.2);" title="Adicionar nova coluna ao Kanban">
 <span class="material-symbols-outlined text-[11px]">add</span> Coluna
 </button>

 {{> testDataButtons module="crm"}}

 <!-- Novo Lead -->
 <button class="py-1.5 px-4 rounded-[4px] bg-orange-500 text-white font-black text-[8px] uppercase tracking-wider shadow-sm hover:bg-orange-600 transition-all flex items-center gap-1.5" onclick="if(typeof window.openNewLeadModal === 'function'){ window.openNewLeadModal(); } else { const m = document.getElementById('newLeadModal'); if(m){ m.classList.remove('hidden'); m.style.display='flex'; } }">
 <span class="material-symbols-outlined text-[11px]">person_add</span> Novo Lead
 </button>
 </div>
 </div>
 </div>

 <!-- Main Content Area -->
 <div id="crm-main-content">
 {{#if (eq activeTab 'kanban')}}
 <!-- View 1: KANBAN -->
 <div id="tab-kanban" class="tab-pane active animate-in slide-in-from-right-4 duration-500">
 <div id="kanban-scroll-area" class="flex gap-3 overflow-x-auto overflow-y-hidden pb-4 min-h-[750px] scrollbar-premium px-2 select-none">
 {{#each columns}}
 <div class="flex-shrink-0 w-[270px] flex flex-col gap-2">
 <!-- Column Header -->
 <div class="flex items-center justify-between px-4">
 <div class="flex items-center gap-4">
 <div class="w-2 h-8 rounded-full shadow-[0_0_20px_rgba(249,115,22,0.4)]" style="background-color: {{this.color}}"></div>
 <div>
 <h4 class="text-[12px] font-black text-white uppercase tracking-[0.2em]">{{this.title}}</h4>
 <p class="text-[9px] font-bold text-gray-500 uppercase tracking-widest mt-0.5">{{length (lookup ../kanban this.statusKey)}} Leads</p>
 </div>
 </div>
 <div class="dropdown">
 <button class="w-9 h-9 rounded-xl bg-white/5 flex items-center justify-center text-gray-500 hover:text-white transition-all" data-bs-toggle="dropdown">
 <span class="material-symbols-outlined text-sm">more_vert</span>
 </button>
 <ul class="dropdown-menu dropdown-menu-dark glass-card border-white/10 p-2 rounded-2xl shadow-2xl">
 <li><a class="dropdown-item text-[10px] font-black uppercase tracking-widest py-3 flex items-center gap-3 rounded-xl hover:bg-orange-500 btn-edit-col" href="#" data-id="{{this.id}}" data-title="{{this.title}}" data-color="{{this.color}}">
 <span class="material-symbols-outlined text-sm">settings</span> Editar Etapa
 </a></li>
 <li><a class="dropdown-item text-[10px] font-black uppercase tracking-widest py-3 flex items-center gap-3 rounded-xl text-red-400 hover:bg-red-500 hover:text-white btn-delete-col" href="#" data-id="{{this.id}}">
 <span class="material-symbols-outlined text-sm">delete</span> Excluir
 </a></li>
 </ul>
 </div>
 </div>
 
 <!-- Kanban Drop Zone -->
 <div class="kanban-drop-zone p-3 rounded-2xl border-0 transition-all flex-1 flex flex-col gap-4 min-h-[600px]" 
 style="background-color: {{this.color}}08;" 
 id="col-{{this.statusKey}}" 
 data-status="{{this.statusKey}}">
 
 {{#each (lookup ../kanban this.statusKey)}}
 {{> kanbanCard lead=this}}
 {{/each}}

 {{#unless (length (lookup ../kanban this.statusKey))}}
 <div class="flex-1 border-2 border-dashed border-white/[0.03] rounded-[2rem] flex flex-col items-center justify-center opacity-20 select-none pointer-events-none" style="user-select:none; -webkit-user-drag:none;">
 <span class="material-symbols-outlined text-5xl mb-4 text-gray-600" style="pointer-events:none;">move_item</span>
 <p class="text-[9px] font-black uppercase tracking-widest text-gray-500">Mover Lead para cá</p>
 </div>
 {{/unless}}
 </div>
 </div>
 {{/each}}

 <!-- ZONA DE RECUPERAÇÃO (Coluna fixa — sempre última) -->
 <div class="flex-shrink-0 w-[270px] flex flex-col gap-2">
 <!-- Column Header -->
 <div class="flex items-center justify-between px-4">
 <div class="flex items-center gap-4">
 <div class="w-2 h-8 rounded-full bg-gray-600 shadow-[0_0_10px_rgba(100,100,100,0.3)]"></div>
 <div>
 <h4 class="text-[12px] font-black text-gray-400 uppercase tracking-[0.2em]">Recuperação</h4>
 <p class="text-[9px] font-bold text-gray-600 uppercase tracking-widest mt-0.5">{{length recuperacaoBudgets}} Leads</p>
 </div>
 </div>
 <span class="material-symbols-outlined text-sm text-gray-600" title="Coluna fixa — não pode ser movida ou ultrapassada">lock</span>
 </div>

 <!-- Kanban Drop Zone -->
 <div class="kanban-drop-zone p-3 rounded-2xl border border-dashed border-gray-700/30 transition-all flex-1 flex flex-col gap-3 min-h-[600px]"
 style="background-color: rgba(30, 30, 35, 0.3);"
 id="col-recuperacao"
 data-status="recuperacao">

 {{#each recuperacaoBudgets}}
 {{> kanbanCard lead=this}}
 {{/each}}

 {{#unless recuperacaoBudgets.length}}
 <div class="flex-1 border-2 border-dashed border-white/[0.03] rounded-[2rem] flex flex-col items-center justify-center opacity-20 select-none pointer-events-none">
 <span class="material-symbols-outlined text-5xl mb-4 text-gray-600">recycling</span>
 <p class="text-[9px] font-black uppercase tracking-widest text-gray-500">Mover Lead para Recuperação</p>
 </div>
 {{/unless}}
 </div>
 </div>

 </div>
 </div>
 {{/if}}

 {{#if (eq activeTab 'forecast')}}
 <!-- View 2: PREVISÃO (Compacto, BI-optimized) -->
 <div id="tab-forecast" class="tab-pane active animate-in slide-in-from-bottom-4 duration-500 space-y-3">

 <!-- Banner Compacto -->
 <div class="kcard">
 <div class="kcard-body" style="padding:12px 16px;">
 <div class="flex items-center justify-between">
 <div class="flex items-center gap-2">
 <span class="kcard-badge kcard-badge-orange"><span class="material-symbols-outlined text-[8px] align-middle mr-0.5">auto_awesome</span> IA Antigravity</span>
 <h4 class="kcard-title" style="margin-bottom:0;">Previsão de Vendas</h4>
 </div>
 <div class="flex items-center gap-3 text-[8px]">
 <div><span class="text-[7px] text-[#555] uppercase">Pipeline</span> <span class="font-bold text-emerald-400" id="val-pipeline">--</span></div>
 <div><span class="text-[7px] text-[#555] uppercase">Ponderado</span> <span class="font-bold text-orange-400" id="val-ponderado">--</span></div>
 <div><span class="text-[7px] text-[#555] uppercase">Leads</span> <span class="font-bold text-white/80">{{length budgets}}</span></div>
 <button onclick="location.reload()" class="flex items-center gap-1 px-3 py-1.5 rounded-[4px] bg-orange-500 text-[7px] font-black uppercase text-white hover:bg-orange-600"><span class="material-symbols-outlined text-[10px]">refresh</span> Recalcular</button>
 </div>
 </div>
 </div>
 </div>

 <!-- NOVA LINHA: 3 Cards de BI (Funil + Top Modalidades + Troféus) -->
 <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
 <!-- Card 1: Funil de Contatos -->
 <div class="kcard">
 <div class="kcard-body" style="padding:14px;">
 <p class="text-[8px] font-black text-blue-400 uppercase tracking-widest mb-2 flex items-center gap-1"><span class="material-symbols-outlined text-[10px]">people</span> Funil de Contatos</p>
 <p class="text-[7px] text-[#555] uppercase mb-1">Total ativo: <strong class="text-white" id="bi-total-leads">{{length budgets}}</strong></p>
 <div class="space-y-1 mt-2">
 <div class="flex justify-between"><span class="text-[8px] text-gray-400">Mínimo (fechamentos)</span><span class="text-[8px] font-black text-rose-400" id="bi-close-min">--</span></div>
 <div class="flex justify-between"><span class="text-[8px] text-gray-400">Médio (fechamentos)</span><span class="text-[8px] font-black text-orange-400" id="bi-close-avg">--</span></div>
 <div class="flex justify-between"><span class="text-[8px] text-gray-400">Máximo (fechamentos)</span><span class="text-[8px] font-black text-emerald-400" id="bi-close-max">--</span></div>
 </div>
 </div>
 </div>

 <!-- Card 2: Top 6 Modalidades -->
 <div class="kcard">
 <div class="kcard-body" style="padding:14px;">
 <p class="text-[8px] font-black text-purple-400 uppercase tracking-widest mb-2 flex items-center gap-1"><span class="material-symbols-outlined text-[10px]">leaderboard</span> Top 6 Modalidades</p>
 <div class="space-y-1" id="bi-top-modalidades">
 <p class="text-[8px] text-gray-500">Calculando...</p>
 </div>
 </div>
 </div>

 <!-- Card 3: Troféus e Medalhas -->
 <div class="kcard">
 <div class="kcard-body" style="padding:14px;">
 <p class="text-[8px] font-black text-amber-400 uppercase tracking-widest mb-2 flex items-center gap-1"><span class="material-symbols-outlined text-[10px]">emoji_events</span> Troféus e Medalhas</p>
 <p class="text-[7px] text-[#555] uppercase mb-1">Prob. fechamento: <strong class="text-amber-400" id="bi-trofeu-prob">--</strong></p>
 <div class="space-y-1 mt-2">
 <div class="flex justify-between"><span class="text-[8px] text-gray-400">Unid. Mínima</span><span class="text-[8px] font-black text-rose-400" id="bi-trofeu-min">--</span></div>
 <div class="flex justify-between"><span class="text-[8px] text-gray-400">Unid. Média</span><span class="text-[8px] font-black text-orange-400" id="bi-trofeu-avg">--</span></div>
 <div class="flex justify-between"><span class="text-[8px] text-gray-400">Unid. Máxima</span><span class="text-[8px] font-black text-emerald-400" id="bi-trofeu-max">--</span></div>
 </div>
 </div>
 </div>
 </div>

 <!-- Projeção Mensal + Filtro -->
 <div class="kcard">
 <div class="kcard-body" style="padding:10px 14px;">
 <div class="flex items-center justify-between">
 <div class="flex items-center gap-2">
 <span class="kcard-badge">Forecast</span>
 <p class="text-[9px] font-black text-white uppercase tracking-wide">Projeção Mensal de Faturamento</p>
 </div>
 <select id="forecast-period-filter" class="text-[8px] font-bold text-gray-400 py-1 px-2 rounded-[4px] appearance-none" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);" onchange="window.updateForecastPeriod(this.value)">
 <option value="current">Mês Atual</option>
 <option value="next">Próximo Mês</option>
 <option value="quarter">Trimestre</option>
 <option value="semester">Semestre</option>
 </select>
 </div>
 </div>
 </div>

 <!-- 3 Cenários -->
 <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
 <div class="kcard">
 <div class="kcard-body" style="padding:14px;">
 <div class="flex items-center justify-between mb-2">
 <span class="text-[8px] font-black text-gray-400 uppercase tracking-[0.12em]">Cenário Pessimista</span>
 <span class="material-symbols-outlined text-rose-400 text-sm">trending_down</span>
 </div>
 <p class="text-[9px] font-black text-white mb-0.5">Mínima</p>
 <p class="text-lg font-black text-rose-400 tracking-tight" id="val-min">--</p>
 <p class="text-[7px] font-bold text-gray-600 uppercase tracking-widest mt-1">Prob. > 80%</p>
 </div>
 </div>

 <div class="kcard" style="border-color: rgba(249,115,22,0.3);">
 <div class="kcard-body" style="padding:14px;">
 <div class="flex items-center justify-between mb-2">
 <span class="text-[8px] font-black text-orange-400 uppercase tracking-[0.12em]">Mais Provável</span>
 <span class="material-symbols-outlined text-orange-400 text-sm">arrow_forward</span>
 </div>
 <p class="text-[9px] font-black text-white mb-0.5">Média</p>
 <p class="text-lg font-black text-orange-400 tracking-tight" id="val-avg">--</p>
 <p class="text-[7px] font-bold text-gray-600 uppercase tracking-widest mt-1">Valor x Prob.</p>
 </div>
 </div>

 <div class="kcard">
 <div class="kcard-body" style="padding:14px;">
 <div class="flex items-center justify-between mb-2">
 <span class="text-[8px] font-black text-gray-400 uppercase tracking-[0.12em]">Otimista</span>
 <span class="material-symbols-outlined text-emerald-400 text-sm">trending_up</span>
 </div>
 <p class="text-[9px] font-black text-white mb-0.5">Máxima</p>
 <p class="text-lg font-black text-emerald-400 tracking-tight" id="val-max">--</p>
 <p class="text-[7px] font-bold text-gray-600 uppercase tracking-widest mt-1">100% conv.</p>
 </div>
 </div>
 </div>

 <!-- Gráfico -->
 <div class="kcard">
 <div class="kcard-body" style="padding:14px; height:240px;">
 <canvas id="forecastChart"></canvas>
 </div>
 </div>

 <!-- Sugestões IA (compacto) -->
 <div class="kcard">
 <div class="kcard-body" style="padding:14px;">
 <p class="text-[8px] font-black text-orange-400 uppercase tracking-[0.12em] mb-3 flex items-center gap-1"><span class="material-symbols-outlined text-[10px]">auto_awesome</span> Sugestões IA</p>
 <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
 <div class="p-3 rounded-[4px]" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
 <p class="text-[7px] font-black text-emerald-400 uppercase tracking-widest mb-1"><span class="material-symbols-outlined text-[9px] align-middle">bolt</span> Acelerar</p>
 <p class="text-[8px] text-gray-400 leading-relaxed"><strong class="text-white"><span id="ai-insight-mornos">--</span> cards</strong> mornos (30-70%) — follow-up em 5 dias.</p>
 </div>
 <div class="p-3 rounded-[4px]" style="border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.02);">
 <p class="text-[7px] font-black text-pink-400 uppercase tracking-widest mb-1"><span class="material-symbols-outlined text-[9px] align-middle">favorite</span> Upsell</p>
 <p class="text-[8px] text-gray-400 leading-relaxed">Otimista: <strong class="text-emerald-400">R$ <span id="ai-insight-max">--</span></strong> — ofereça pacotes extras.</p>
 </div>
 </div>
 </div>
 </div>

 <!-- VGV -->
 <div class="kcard">
 <div class="kcard-body" style="padding:12px 16px;">
 <div class="flex items-center justify-between">
 <div class="flex items-center gap-2">
 <span class="kcard-badge kcard-badge-orange">VGV</span>
 <p class="text-[8px] font-bold text-gray-500 uppercase tracking-widest">Total Válido</p>
 </div>
 <p class="text-lg font-black text-emerald-400 tracking-tight">R$ {{numberFormat totalVgv 2 ',' '.'}}</p>
 </div>
 </div>
 </div>

 </div>

 <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
 <script>
 document.addEventListener('DOMContentLoaded', () => {
 const rawBudgets = {{{json budgets}}};
 let minVal = 0, avgVal = 0, maxVal = 0, mornosCount = 0;
 const modalityCounts = {};
 let trofeuCount = 0, trofeuProb = 0, trofeuUnits = 0;

 rawBudgets.forEach(b => {
 const val = parseFloat(b.estimatedValue) || 0;
 const prob = parseFloat(b.probability) || 0;
 const tipo = b.projectType || 'Outro';
 maxVal += val;
 avgVal += (val * (prob / 100));
 if (prob >= 80) minVal += val;
 if (prob >= 30 && prob <= 70) mornosCount++;
 // Modalidades
 if (!modalityCounts[tipo]) modalityCounts[tipo] = { value: 0, prob: 0, count: 0 };
 modalityCounts[tipo].value += val;
 modalityCounts[tipo].prob += prob;
 modalityCounts[tipo].count++;
 // Troféus
 if (tipo.toLowerCase().includes('trof') || tipo.toLowerCase().includes('medal')) {
  trofeuCount++;
  trofeuProb += prob;
  trofeuUnits += (parseInt(b.imagesCount) || 1);
 }
 });

 const fmt = (n) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(n);
 const fmtS = (n) => new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 2 }).format(n);

 // Cenários
 if (document.getElementById('val-min')) document.getElementById('val-min').textContent = fmt(minVal);
 if (document.getElementById('val-avg')) document.getElementById('val-avg').textContent = fmt(avgVal);
 if (document.getElementById('val-max')) document.getElementById('val-max').textContent = fmt(maxVal);
 if (document.getElementById('val-pipeline')) document.getElementById('val-pipeline').textContent = fmtS(maxVal);
 if (document.getElementById('val-ponderado')) document.getElementById('val-ponderado').textContent = fmtS(avgVal);
 if (document.getElementById('ai-insight-mornos')) document.getElementById('ai-insight-mornos').textContent = mornosCount;
 if (document.getElementById('ai-insight-max')) document.getElementById('ai-insight-max').textContent = fmtS(maxVal);

 // BI Card 1: Funil de Contatos
 const totalLeads = rawBudgets.length;
 const convRate = totalLeads > 0 ? rawBudgets.filter(b => (parseFloat(b.probability)||0) >= 80).length / totalLeads : 0.2;
 if (document.getElementById('bi-close-min')) document.getElementById('bi-close-min').textContent = Math.round(totalLeads * convRate * 0.6);
 if (document.getElementById('bi-close-avg')) document.getElementById('bi-close-avg').textContent = Math.round(totalLeads * convRate);
 if (document.getElementById('bi-close-max')) document.getElementById('bi-close-max').textContent = Math.round(totalLeads * convRate * 1.5);

 // BI Card 2: Top 6 Modalidades
 const sorted = Object.entries(modalityCounts).sort((a,b) => b[1].value - a[1].value).slice(0,6);
 const topEl = document.getElementById('bi-top-modalidades');
 if (topEl) {
  topEl.innerHTML = sorted.map(([name, d]) => {
   const avgProb = d.count > 0 ? Math.round(d.prob / d.count) : 0;
   return '<div class="flex justify-between"><span class="text-[8px] text-gray-300 truncate flex-1">' + name + '</span><span class="text-[8px] font-black ' + (avgProb >= 60 ? 'text-emerald-400' : avgProb >= 30 ? 'text-orange-400' : 'text-red-400') + '">' + avgProb + '%</span></div>';
  }).join('') || '<p class="text-[8px] text-gray-500">Sem dados</p>';
 }

 // BI Card 3: Troféus
 const trofAvgProb = trofeuCount > 0 ? Math.round(trofeuProb / trofeuCount) : 0;
 if (document.getElementById('bi-trofeu-prob')) document.getElementById('bi-trofeu-prob').textContent = trofAvgProb + '%';
 if (document.getElementById('bi-trofeu-min')) document.getElementById('bi-trofeu-min').textContent = Math.round(trofeuUnits * 0.6);
 if (document.getElementById('bi-trofeu-avg')) document.getElementById('bi-trofeu-avg').textContent = trofeuUnits;
 if (document.getElementById('bi-trofeu-max')) document.getElementById('bi-trofeu-max').textContent = Math.round(trofeuUnits * 1.4);

 // Chart
 const ctx = document.getElementById('forecastChart');
 if (ctx) {
 const now = new Date();
 const months = [];
 for(let i = -2; i <= 2; i++) {
  const d = new Date(now.getFullYear(), now.getMonth() + i, 1);
  let m = d.toLocaleDateString('pt-BR', { month: 'short' }).toUpperCase().replace('.','');
  if (i === 0) m += ' (ATUAL)';
  months.push(m);
 }
 new Chart(ctx, {
  type: 'bar',
  data: { labels: months, datasets: [
   { label: 'Mín', data: [minVal*0.7, minVal*0.9, minVal, minVal*1.1, minVal*1.3], backgroundColor: 'rgba(244,114,182,0.7)', borderRadius: 3 },
   { label: 'Méd', data: [avgVal*0.75, avgVal*0.85, avgVal, avgVal*1.2, avgVal*1.4], backgroundColor: 'rgba(249,115,22,0.8)', borderRadius: 3 },
   { label: 'Máx', data: [maxVal*0.8, maxVal*0.9, maxVal, maxVal*1.15, maxVal*1.35], backgroundColor: 'rgba(52,211,153,0.7)', borderRadius: 3 }
  ]},
  options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'top', labels: { color: '#9ca3af', font: { size: 8 }, usePointStyle: true, pointStyle: 'rect', padding: 12 } }, tooltip: { callbacks: { label: (c) => fmt(c.raw) } } }, scales: { y: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#6b7280', font: { size: 8 }, callback: (v) => 'R$' + (v/1000).toFixed(0) + 'k' } }, x: { grid: { display: false }, ticks: { color: '#9ca3af', font: { size: 9 } } } } }
 });
 }

 // Period filter (front-end only — adjusts chart labels)
 window.updateForecastPeriod = function(period) {
  // Future: reload with ?period= param. For now visual only.
  if (window.showToast) window.showToast('Filtro: ' + period, 'info');
 };
 });
 </script>
 </div>
 {{/if}}

