 // === LEAD TASK CHECKLIST (Pane: Tarefas) ===
 const PRIORITY_STYLE = {
 alta: 'bg-red-500/10 text-red-400 border-red-500/20',
 media: 'bg-orange-500/10 text-orange-400 border-orange-500/20',
 baixa: 'bg-blue-500/10 text-blue-400 border-blue-500/20'
 };

 function renderTaskList(tasks, suggestions) {
 const listEl = document.getElementById('taskList');
 const counterEl = document.getElementById('tasksCounter');
 const suggestionsEl = document.getElementById('taskSuggestions');
 if (!listEl) return;

 const pending = tasks.filter(t => t.status !== 'concluida');
 if (counterEl) counterEl.textContent = `${pending.length} pendente(s) / ${tasks.length} total`;

 if (tasks.length === 0) {
 listEl.innerHTML = '<p class="text-[10px] text-gray-500 text-center py-4">Nenhuma tarefa ainda. Adicione uma acima.</p>';
 } else {
 const now = new Date();
 listEl.innerHTML = tasks.map(t => {
 const isDone = t.status === 'concluida';
 const isOverdue = !isDone && t.dueDate && new Date(t.dueDate) < now;
 const dueLabel = t.dueDate ? new Date(t.dueDate).toLocaleDateString('pt-BR') : '';
 const prioClass = PRIORITY_STYLE[t.priority] || PRIORITY_STYLE.media;
 return `
 <div class="flex items-center gap-2 p-2 rounded-lg border ${isOverdue ? 'border-red-500/30 bg-red-500/5' : 'border-white/5 bg-white/[0.02]'}">
 <button type="button" onclick="window.toggleTaskStatus('${t.id}', '${isDone ? 'ativa' : 'concluida'}')" class="w-5 h-5 rounded-md border ${isDone ? 'bg-emerald-500 border-emerald-500' : 'border-white/20'} flex items-center justify-center shrink-0 transition-all">
 ${isDone ? '<span class="material-symbols-outlined text-[12px] text-white">check</span>' : ''}
 </button>
 <span class="flex-1 text-[11px] font-bold ${isDone ? 'text-gray-500 line-through' : 'text-white'} truncate">${t.title}</span>
 ${dueLabel ? `<span class="text-[8px] font-black uppercase tracking-wider ${isOverdue ? 'text-red-400' : 'text-gray-500'} shrink-0">${dueLabel}</span>` : ''}
 <span class="text-[7px] font-black uppercase px-1.5 py-0.5 rounded border ${prioClass} shrink-0">${t.priority}</span>
 <button type="button" onclick="window.deleteTask('${t.id}')" class="w-6 h-6 rounded-md text-gray-500 hover:text-red-400 hover:bg-red-500/10 flex items-center justify-center shrink-0 transition-all">
 <span class="material-symbols-outlined text-xs">close</span>
 </button>
 </div>
 `;
 }).join('');
 }

 if (suggestionsEl) {
 suggestionsEl.innerHTML = (suggestions || []).map(s => `
 <button type="button" onclick="window.addSuggestedTask('${s.title.replace(/'/g, "\\'")}', '${s.priority}', '${s.category}')" class="text-[8px] font-black uppercase tracking-wider px-2 py-1 rounded-lg bg-white/5 text-gray-400 border border-white/10 hover:bg-orange-500 hover:text-white hover:border-orange-500 transition-all flex items-center gap-1">
 <span class="material-symbols-outlined text-[10px]">auto_awesome</span> ${s.title}
 </button>
 `).join('');
 }
 }

