<!-- Header -->
<div class="mb-10 p-8 glass-card border-none bg-gradient-to-br from-white/5 to-white/[0.02]">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h1 class="text-4xl font-black text-white tracking-tight mb-2">
                Pipeline de <span class="text-gradient">Vendas</span>
            </h1>
            <p class="text-gray-400 font-medium">
                Gerencie seus leads e oportunidades com inteligência <span class="text-orange-500">Malha3D</span>.
            </p>
        </div>
        <div class="flex items-center gap-4">
            <div class="glass-card px-6 py-3 flex items-center gap-3 border-white/5">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-widest">Valor em Pipeline</span>
                <span class="text-lg font-black text-orange-500">{{formatCurrency stats.pipelineValue}}</span>
            </div>
            <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-8 rounded-2xl shadow-2xl shadow-orange-500/40 transition-all flex items-center gap-3" data-bs-toggle="modal" data-bs-target="#newLeadModal">
                <span class="material-symbols-outlined">add_circle</span>
                Novo Lead
            </button>
        </div>
    </div>
</div>

<!-- Kanban Board -->
<div class="flex gap-6 overflow-x-auto pb-8 snap-x no-scrollbar">
    <!-- Novo Contato -->
    <div class="flex-shrink-0 w-85 snap-start">
        <div class="flex items-center justify-between mb-6 px-4">
            <h3 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] flex items-center gap-3">
                <span class="w-2 h-2 bg-blue-500 rounded-full shadow-[0_0_10px_rgba(59,130,246,0.5)]"></span>
                Novas Oportunidades
                <span class="bg-white/5 px-2 py-0.5 rounded text-[10px]">{{length kanban.novo}}</span>
            </h3>
        </div>
        
        <div class="space-y-4">
            {{#each kanban.novo}}
            <div class="glass-card p-6 border-white/5 hover:bg-white/5 hover:border-orange-500/30 transition-all cursor-pointer group">
                <div class="flex justify-between items-start mb-4">
                    <span class="text-[9px] font-black text-blue-400 bg-blue-500/10 px-2 py-1 rounded uppercase tracking-wider">Prospect</span>
                    <span class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">{{formatDate this.createdAt}}</span>
                </div>
                <h4 class="text-base font-black text-white mb-1 group-hover:text-orange-500 transition-colors">{{this.name}}</h4>
                <p class="text-xs text-gray-400 mb-6 line-clamp-2">{{this.description}}</p>
                
                <div class="flex items-center justify-between pt-4 border-t border-white/5">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-orange-500/10 flex items-center justify-center text-[11px] font-black text-orange-500">
                            {{#firstLetter this.name}}{{/firstLetter}}
                        </div>
                        <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">{{this.projectType}}</span>
                    </div>
                    <span class="text-sm font-black text-white">{{formatCurrency this.estimatedValue}}</span>
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    <!-- Em Negociação -->
    <div class="flex-shrink-0 w-85 snap-start">
        <div class="flex items-center justify-between mb-6 px-4">
            <h3 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] flex items-center gap-3">
                <span class="w-2 h-2 bg-orange-500 rounded-full shadow-[0_0_10px_rgba(249,115,22,0.5)]"></span>
                Em Negociação
                <span class="bg-white/5 px-2 py-0.5 rounded text-[10px]">{{length kanban.em_andamento}}</span>
            </h3>
        </div>
        
        <div class="space-y-4">
            {{#each kanban.em_andamento}}
            <div class="glass-card p-6 border-white/5 hover:bg-white/5 hover:border-orange-500/30 transition-all cursor-pointer group">
                <div class="flex justify-between items-start mb-4">
                    <span class="text-[9px] font-black text-orange-400 bg-orange-500/10 px-2 py-1 rounded uppercase tracking-wider">Negociação</span>
                    <span class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">{{formatDate this.createdAt}}</span>
                </div>
                <h4 class="text-base font-black text-white mb-1 group-hover:text-orange-500 transition-colors">{{this.name}}</h4>
                <p class="text-xs text-gray-400 mb-6 line-clamp-2">{{this.description}}</p>
                
                <div class="flex items-center justify-between pt-4 border-t border-white/5">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-orange-500/10 flex items-center justify-center text-[11px] font-black text-orange-500">
                            {{#firstLetter this.name}}{{/firstLetter}}
                        </div>
                        <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">{{this.projectType}}</span>
                    </div>
                    <span class="text-sm font-black text-white">{{formatCurrency this.estimatedValue}}</span>
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    <!-- Proposta Enviada -->
    <div class="flex-shrink-0 w-85 snap-start">
        <div class="flex items-center justify-between mb-6 px-4">
            <h3 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] flex items-center gap-3">
                <span class="w-2 h-2 bg-purple-500 rounded-full shadow-[0_0_10px_rgba(168,85,247,0.5)]"></span>
                Proposta Enviada
                <span class="bg-white/5 px-2 py-0.5 rounded text-[10px]">{{length kanban.respondido}}</span>
            </h3>
        </div>
        
        <div class="space-y-4">
            {{#each kanban.respondido}}
            <div class="glass-card p-6 border-white/5 hover:bg-white/5 hover:border-orange-500/30 transition-all cursor-pointer group">
                <div class="flex justify-between items-start mb-4">
                    <span class="text-[9px] font-black text-purple-400 bg-purple-500/10 px-2 py-1 rounded uppercase tracking-wider">Closing</span>
                    <span class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">{{formatDate this.createdAt}}</span>
                </div>
                <h4 class="text-base font-black text-white mb-1 group-hover:text-orange-500 transition-colors">{{this.name}}</h4>
                <p class="text-xs text-gray-400 mb-6 line-clamp-2">{{this.description}}</p>
                
                <div class="flex items-center justify-between pt-4 border-t border-white/5">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-orange-500/10 flex items-center justify-center text-[11px] font-black text-orange-500">
                            {{#firstLetter this.name}}{{/firstLetter}}
                        </div>
                        <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">{{this.projectType}}</span>
                    </div>
                    <span class="text-sm font-black text-white">{{formatCurrency this.estimatedValue}}</span>
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    <!-- Fechado -->
    <div class="flex-shrink-0 w-85 snap-start">
        <div class="flex items-center justify-between mb-6 px-4">
            <h3 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] flex items-center gap-3">
                <span class="w-2 h-2 bg-green-500 rounded-full shadow-[0_0_10px_rgba(34,197,94,0.5)]"></span>
                Contrato Fechado
                <span class="bg-white/5 px-2 py-0.5 rounded text-[10px]">{{length kanban.fechado}}</span>
            </h3>
        </div>
        
        <div class="space-y-4">
            {{#each kanban.fechado}}
            <div class="glass-card p-6 border-white/5 hover:bg-white/5 hover:border-green-500/30 transition-all cursor-pointer group">
                <div class="flex justify-between items-start mb-4">
                    <span class="text-[9px] font-black text-green-400 bg-green-500/10 px-2 py-1 rounded uppercase tracking-wider">Ganho</span>
                    <span class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">{{formatDate this.createdAt}}</span>
                </div>
                <h4 class="text-base font-black text-white mb-1 group-hover:text-green-500 transition-colors">{{this.name}}</h4>
                <p class="text-xs text-gray-400 mb-6 line-clamp-2">{{this.description}}</p>
                
                <div class="flex items-center justify-between pt-4 border-t border-white/5">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-green-500/10 flex items-center justify-center text-[11px] font-black text-green-500">
                            {{#firstLetter this.name}}{{/firstLetter}}
                        </div>
                        <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">{{this.projectType}}</span>
                    </div>
                    <span class="text-sm font-black text-white">{{formatCurrency this.estimatedValue}}</span>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>

<!-- New Lead Modal -->
<div class="modal fade" id="newLeadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-white/10 bg-[#0f0f0f]/95 backdrop-blur-2xl">
            <div class="modal-header border-white/5 p-8">
                <h5 class="text-xl font-black text-white tracking-tight flex items-center gap-3">
                    <span class="material-symbols-outlined text-orange-500">person_add</span>
                    Capturar Novo Lead
                </h5>
                <button type="button" class="btn-close btn-close-white opacity-50 hover:opacity-100 transition-opacity" data-bs-dismiss="modal"></button>
            </div>
            <form id="newLeadForm">
                <div class="modal-body p-8 space-y-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Nome Completo</label>
                        <input type="text" name="name" required class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">E-mail</label>
                            <input type="email" name="email" required class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">WhatsApp</label>
                            <input type="text" name="phone" required class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Tipo de Projeto</label>
                        <select name="projectType" required class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all cursor-pointer">
                            <option value="Renderização" class="bg-[#0f0f0f]">Renderização</option>
                            <option value="Modelagem 3D" class="bg-[#0f0f0f]">Modelagem 3D</option>
                            <option value="Animação" class="bg-[#0f0f0f]">Animação</option>
                            <option value="Visita Virtual" class="bg-[#0f0f0f]">Visita Virtual</option>
                        </select>
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Valor Estimado</label>
                        <input type="number" name="estimatedValue" step="0.01" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="0.00">
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Notas Iniciais</label>
                        <textarea name="description" rows="3" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all resize-none"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-white/5 p-8">
                    <button type="button" class="px-6 py-3 text-xs font-black text-gray-500 uppercase tracking-widest hover:text-white transition-all" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white font-black py-3 px-8 rounded-xl shadow-lg shadow-orange-500/20 transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">rocket_launch</span>
                        Criar Lead
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.getElementById('newLeadForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const data = Object.fromEntries(formData.entries());
    
    try {
        const response = await fetch('/admin/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        
        const result = await response.json();
        if (result.success) {
            window.location.reload();
        } else {
            alert('Erro: ' + result.message);
        }
    } catch (error) {
        console.error('Error creating lead:', error);
        alert('Erro ao processar solicitação');
    }
});
</script>

