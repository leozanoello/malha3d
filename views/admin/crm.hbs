window.selectProjectClass = function(classKey, btn) {
  // Atualiza input hidden
  const hidden = document.getElementById('selectedProjectClass');
  if (hidden) hidden.value = classKey;
  // Reseta visual de todos os botões
  const allBtns = document.querySelectorAll('#projectClassSelector .prod-class-btn');
  allBtns.forEach(b => {
   b.classList.remove('border-yellow-500', 'border-emerald-500', 'border-blue-500', 'border-gray-500', 'bg-yellow-500/20', 'bg-emerald-500/20', 'bg-blue-500/20', 'bg-gray-500/20');
  });
  // Aplica visual no botão clicado
  const colorMap = {
   'luxo': { border: 'border-yellow-500', bg: 'bg-yellow-500/20' },
   'A':    { border: 'border-emerald-500', bg: 'bg-emerald-500/20' },
   'B':    { border: 'border-blue-500', bg: 'bg-blue-500/20' },
   'C':    { border: 'border-gray-400', bg: 'bg-gray-400/20' }
  };
  const colors = colorMap[classKey] || colorMap['C'];
  if (btn) {
   btn.classList.add(colors.border, colors.bg);
  }
  // Recalcula
  window.recalcProductivity();
};

window.recalcProductivity = function() {
  // Coletar classe selecionada
  const classInputEl = document.getElementById('selectedProjectClass');
  const classKey = classInputEl ? (classInputEl.value || 'C') : 'C';
  const classWeight = CLASS_WEIGHTS[classKey] || 5;

  let totalHours = 0;
  document.querySelectorAll('#productivityProductsList .productivity-prod-item').forEach(item => {
   const prodId = item.dataset.prodId;
   const qty = parseInt(item.querySelector('.prod-quantity')?.value || 0);
   totalHours += calcHours(prodId, qty);
  });

  // Aplicar peso da classe (escala 0-10 normalizada para 1.0)
  totalHours = totalHours * (classWeight / 10);

  const hourlyRate = parseFloat(document.getElementById('hourlyRateInput')?.value || 0);
  const profitMargin = parseFloat(document.getElementById('profitMarginInput')?.value || 0) / 100;

  const productionCost = totalHours * hourlyRate;
  const suggestedBudget = productionCost * (1 + profitMargin);

  const hours = Math.floor(totalHours);
  const mins = Math.round((totalHours - hours) * 60);
  const days = Math.ceil(totalHours / 8);

  const tt = document.getElementById('totalTimeHours');
  const td = document.getElementById('totalWorkDays');
  const tc = document.getElementById('totalProductionCost');
  const sb = document.getElementById('suggestedBudget');
  if (tt) tt.textContent = hours + 'h ' + mins + 'min';
  if (td) td.textContent = days + ' dias';
  if (tc) tc.textContent = 'R$ ' + productionCost.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
  if (sb) sb.textContent = 'R$ ' + suggestedBudget.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
};

window.applySuggestedBudget = function() {
  const sb = document.getElementById('suggestedBudget')?.textContent || 'R$ 0,00';
  const value = sb.replace(/[^\d,]/g, '').replace(',', '.');
  const ev = document.getElementById('editEstimatedValue');
  if (ev) {
   ev.value = parseFloat(value).toFixed(2);
   ev.classList.add('ring-2', 'ring-emerald-500');
   setTimeout(() => ev.classList.remove('ring-2', 'ring-emerald-500'), 1500);
  }
};

