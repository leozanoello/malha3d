<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
 window._currentUserId = '{{user.id}}';

 // === TAB SWITCHING ===
 function switchTab(tabId, el) {
 document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
 const targetTab = document.getElementById(`tab-${tabId}`);
 if (targetTab) targetTab.classList.remove('hidden');
 
 document.querySelectorAll('.tab-btn-nav').forEach(btn => {
 btn.classList.remove('bg-orange-500', 'text-white', 'shadow-xl', 'shadow-orange-500/20');
 btn.classList.add('text-gray-500');
 });
 
 el.classList.add('bg-orange-500', 'text-white', 'shadow-xl', 'shadow-orange-500/20');
 el.classList.remove('text-gray-500');

 if (tabId === 'forecast') initForecastChart();
 if (tabId === 'templates') loadTemplates();
 }

 document.querySelectorAll('.tab-btn-nav').forEach(btn => {
 btn.addEventListener('click', function() {
 switchTab(this.dataset.tab, this);
 });
 });

 // === MODAL TAB SWITCHING ===
 function switchModalTab(tabId, el) {
 document.querySelectorAll('.modal-pane').forEach(p => p.classList.add('hidden'));
 // Primeiro tenta ID padrão, depois tenta data-pane-id
 let target = document.getElementById(`modal-tab-${tabId}`);
 if (!target) {
 target = document.querySelector(`[data-pane-id="modal-tab-${tabId}"]`);
 }
 if (target) target.classList.remove('hidden');
 
 document.querySelectorAll('.modal-tab-btn').forEach(btn => btn.classList.remove('active'));
 el.classList.add('active');
 }

 document.querySelectorAll('.modal-tab-btn').forEach(btn => {
 btn.addEventListener('click', function() {
 switchModalTab(this.dataset.tab, this);
 });
 });

 // === EDIT MODE LOGIC ===
 const editLeadForm = document.getElementById('editLeadForm');
 const btnEditToggle = document.getElementById('btn-edit-toggle');
 const btnCancelEdit = document.getElementById('btn-cancel-edit');
 const editActions = document.getElementById('edit-actions');

 function toggleEditMode(enabled) {
 if (!editLeadForm) return;
 const inputs = editLeadForm.querySelectorAll('input, select, textarea');
 inputs.forEach(input => {
 if (input.name !== 'id') {
 input.disabled = !enabled;
 }
 });
 
 if (enabled) {
 editActions?.classList.remove('hidden');
 btnEditToggle?.classList.add('hidden');
 } else {
 editActions?.classList.add('hidden');
 btnEditToggle?.classList.remove('hidden');
 }
 }

 btnEditToggle?.addEventListener('click', () => toggleEditMode(true));
 btnCancelEdit?.addEventListener('click', () => toggleEditMode(false));

 // === AI BANNER BACKFILL ===
 window.generateMissingLeadImages = function() {
 const btn = document.getElementById('btn-generate-ai-banners');
 if (!btn) return;
 const originalHtml = btn.innerHTML;
 btn.disabled = true;
 btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> Gerando...';

 fetch('/admin/api/negociacoes/generate-missing-images', { method: 'POST' })
 .then(res => res.json())
 .then(data => {
 if (data.success) {
 if (window.showNotification) window.showNotification(`Imagens geradas: ${data.generated}/${data.total}`, 'success');
 if (data.generated > 0) window.location.reload();
 } else {
 if (window.showNotification) window.showNotification(data.error || 'Erro ao gerar imagens', 'error');
 }
 })
 .catch(err => {
 console.error('Generate images error:', err);
 if (window.showNotification) window.showNotification('Erro de conexão ao gerar imagens', 'error');
 })
 .finally(() => {
 btn.disabled = false;
 btn.innerHTML = originalHtml;
 });
 };

 // === LEAD TRASH & DELETE ===
 window.convertLeadToModelagem = async function(leadId, btn) {
  // Buscar dados do lead para exibir na confirmação
  const card = document.querySelector(`.kanban-card-wrap[data-id="${leadId}"]`);
  const leadDataRaw = card?.dataset?.lead ? JSON.parse(card.dataset.lead) : {};
  const leadName = leadDataRaw.name || 'Lead';

  // Abre modal de confirmação com visualização dos dados
  window.showConvertConfirmModal(leadId, leadName, leadDataRaw, btn);
 };

 // === MODAL DE CONFIRMAÇÃO DE CONVERSÃO ===
 window.showConvertConfirmModal = function(leadId, leadName, leadData, btn) {
  // Remove modal anterior se existir
  const existing = document.getElementById('convertConfirmModal');
  if (existing) existing.remove();

  const fmtCurrency = (v) => {
    const n = parseFloat(v);
    return isNaN(n) ? '---' : 'R$ ' + n.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
  };
  const fmtDate = (v) => {
    if (!v) return '---';
    try { return new Date(v).toLocaleDateString('pt-BR'); } catch (e) { return '---'; }
  };

  const modalHtml = `
   <div id="convertConfirmModal" class="fixed inset-0 z-[200] flex items-center justify-center bg-black/80 backdrop-blur-sm" style="display:flex;">
    <div class="bg-[#0a0c10] border border-white/10 rounded-2xl shadow-2xl w-full max-w-2xl mx-4 overflow-hidden">
     <header class="p-4 border-b border-white/5 flex items-center justify-between bg-gradient-to-r from-indigo-500/10 to-orange-500/10">
      <div class="flex items-center gap-3">
       <div class="w-10 h-10 rounded-xl bg-indigo-500/20 border border-indigo-500/30 flex items-center justify-center">
        <span class="material-symbols-outlined text-indigo-400">view_in_ar</span>
       </div>
       <div>
        <h3 class="text-base font-black text-white tracking-tight">Confirmar Conversão para Projeto 3D</h3>
        <p class="text-[9px] font-bold uppercase tracking-widest text-gray-400">Revise os dados que serão copiados</p>
       </div>
      </div>
      <button type="button" class="w-8 h-8 rounded-lg bg-white/5 hover:bg-white/10 flex items-center justify-center text-gray-400 hover:text-white" onclick="document.getElementById('convertConfirmModal').remove()">
       <span class="material-symbols-outlined">close</span>
      </button>
     </header>

     <div class="p-5 max-h-[60vh] overflow-y-auto custom-scrollbar">
      <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-3 mb-4 flex items-start gap-2">
       <span class="material-symbols-outlined text-amber-400 text-sm mt-0.5">info</span>
       <p class="text-[10px] text-amber-200 leading-relaxed">
        <strong>Atenção:</strong> Será criado um novo card na página <strong>Projetos</strong> com uma cópia dos dados abaixo.
        O lead original do CRM será marcado como <strong>ganho</strong> e manterá um vínculo com o novo card através do histórico.
       </p>
      </div>

      <div class="grid grid-cols-2 gap-3">
       <div class="p-3 rounded-lg bg-white/[0.03] border border-white/10">
        <p class="text-[8px] font-black uppercase tracking-widest text-gray-500 mb-1">Nome do Lead</p>
        <p class="text-xs font-bold text-white truncate">${leadData.name || '---'}</p>
       </div>
       <div class="p-3 rounded-lg bg-white/[0.03] border border-white/10">
        <p class="text-[8px] font-black uppercase tracking-widest text-gray-500 mb-1">Cliente</p>
        <p class="text-xs font-bold text-white truncate">${leadData.clientName || leadData.client?.company || '---'}</p>
       </div>
       <div class="p-3 rounded-lg bg-white/[0.03] border border-white/10">
        <p class="text-[8px] font-black uppercase tracking-widest text-gray-500 mb-1">Email</p>
        <p class="text-xs font-bold text-white truncate">${leadData.email || '---'}</p>
       </div>
       <div class="p-3 rounded-lg bg-white/[0.03] border border-white/10">
        <p class="text-[8px] font-black uppercase tracking-widest text-gray-500 mb-1">Telefone</p>
        <p class="text-xs font-bold text-white truncate">${leadData.phone || '---'}</p>
       </div>
       <div class="p-3 rounded-lg bg-white/[0.03] border border-white/10">
        <p class="text-[8px] font-black uppercase tracking-widest text-gray-500 mb-1">Tipologia</p>
        <p class="text-xs font-bold text-white truncate">${leadData.projectType || '---'}</p>
       </div>
       <div class="p-3 rounded-lg bg-white/[0.03] border border-white/10">
        <p class="text-[8px] font-black uppercase tracking-widest text-gray-500 mb-1">Valor Estimado</p>
        <p class="text-xs font-bold text-orange-400 truncate">${fmtCurrency(leadData.estimatedValue)}</p>
       </div>
       <div class="p-3 rounded-lg bg-white/[0.03] border border-white/10">
        <p class="text-[8px] font-black uppercase tracking-widest text-gray-500 mb-1">Localização</p>
        <p class="text-xs font-bold text-white truncate">${(leadData.city || '---') + (leadData.state ? ' / ' + leadData.state : '')}</p>
       </div>
       <div class="p-3 rounded-lg bg-white/[0.03] border border-white/10">
