  const p = ARCHVIZ_PRODUCTS.find(x => x.id === productId);
  if (!p) return;
  const div = document.createElement('div');
  div.className = 'p-2 rounded-lg bg-black/30 border border-white/5 flex items-center gap-2 productivity-prod-item';
