// === SALVAR BANNER NO CARD (persiste no banco) ===
window.saveLeadBanner = async function() {
  const leadId = window._currentLeadId;
  if (!leadId) { if (window.showToast) window.showToast('Abra um card primeiro', 'error'); return; }
  const bannerEl = document.getElementById('modalLeadBanner');
  if (!bannerEl) return;
  // Pegar o banner pendente (selecionado via cycle ou upload)
  const imageUrl = bannerEl.dataset.pendingBanner || bannerEl.style.backgroundImage.replace(/^url\(['"]?/, '').replace(/['"]?\)$/, '');
  if (!imageUrl) { if (window.showToast) window.showToast('Nenhum banner selecionado', 'error'); return; }
  try {
    const res = await fetch('/admin/api/negociacoes/' + leadId + '/save-banner', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ imageUrl })
    });
    const data = await res.json();
    if (data.success) {
      if (window.showToast) window.showToast('Banner salvo!', 'success');
      // Atualizar o card no Kanban (se visível)
      const cardEl = document.querySelector('[data-id="' + leadId + '"]');
      if (cardEl) {
        const imgEl = cardEl.querySelector('img');
        if (imgEl) imgEl.src = imageUrl;
      }
      delete bannerEl.dataset.pendingBanner;
    } else {
      if (window.showToast) window.showToast(data.error || 'Erro ao salvar', 'error');
    }
  } catch (e) {
    if (window.showToast) window.showToast('Erro de rede', 'error');
  }
};

// === UPLOAD DE BANNER PERSONALIZADO ===
window.uploadLeadBanner = function() {
  const leadId = window._currentLeadId;
  if (!leadId) { if (window.showToast) window.showToast('Abra um card primeiro', 'error'); return; }
  // Criar input file temporário
  const input = document.createElement('input');
  input.type = 'file';
  input.accept = 'image/*';
  input.onchange = async function() {
    const file = this.files[0];
    if (!file) return;
    const formData = new FormData();
    formData.append('banner', file);
    try {
      const res = await fetch('/admin/api/negociacoes/' + leadId + '/upload-banner', {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      if (data.success) {
        const bannerEl = document.getElementById('modalLeadBanner');
        if (bannerEl) {
          bannerEl.style.backgroundImage = "url('" + data.imageUrl + "')";
          bannerEl.dataset.pendingBanner = data.imageUrl;
        }
        if (window.showToast) window.showToast('Banner enviado e salvo!', 'success');
        // Atualizar card no Kanban
        const cardEl = document.querySelector('[data-id="' + leadId + '"]');
        if (cardEl) {
          const imgEl = cardEl.querySelector('img');
          if (imgEl) imgEl.src = data.imageUrl;
        }
      } else {
        if (window.showToast) window.showToast(data.error || 'Erro no upload', 'error');
      }
    } catch (e) {
      if (window.showToast) window.showToast('Erro de rede', 'error');
    }
  };
  input.click();
};

// === PROBABILIDADE DE FECHAMENTO (Exclusivo CRM) ===
// Clicável no card — edição rápida inline
window.editCardProbability = async function(leadId, el) {
  const current = parseInt(el.dataset.probability) || 50;
  const newVal = prompt('Probabilidade de Fechamento (0-100%):', current);
  if (newVal === null) return;
  const prob = Math.min(100, Math.max(0, parseInt(newVal) || 0));

  // Atualizar visual instantaneamente (Optimistic UI)
  el.textContent = prob + '%';
  el.dataset.probability = prob;

  // Cor dinâmica baseada na probabilidade
  el.className = el.className.replace(/text-\w+-\d+/g, '');
  if (prob >= 80) el.classList.add('text-emerald-400');
  else if (prob >= 50) el.classList.add('text-orange-300');
  else if (prob >= 25) el.classList.add('text-amber-400');
  else el.classList.add('text-red-400');

  try {
    const res = await fetch('/admin/api/crm/probability/' + leadId, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ probability: prob })
    });
    const data = await res.json();
    if (data.success) {
      if (window.showToast) window.showToast('Probabilidade: ' + prob + '%', 'success');
    } else {
      // Rollback
      el.textContent = current + '%';
      el.dataset.probability = current;
      if (window.showToast) window.showToast(data.error || 'Erro', 'error');
    }
  } catch (e) {
    el.textContent = current + '%';
    el.dataset.probability = current;
    if (window.showToast) window.showToast('Erro de rede', 'error');
  }
};

// === DATA ESTIMADA DE FECHAMENTO (Exclusivo CRM) ===
window.editCardCloseDate = function(leadId, btn) {
  // Criar input date temporário posicionado sob o botão
  const existing = document.getElementById('kcard-date-picker-' + leadId);
  if (existing) { existing.remove(); return; }

  const currentDate = btn.dataset.date || '';
  const input = document.createElement('input');
  input.type = 'date';
  input.id = 'kcard-date-picker-' + leadId;
  input.value = currentDate;
  input.className = 'absolute z-50 mt-1 bg-[#151515] border border-orange-500/30 rounded-lg px-2 py-1 text-[10px] text-white shadow-xl';
  input.style.right = '0';
  input.style.top = '100%';

  // Posicionar relativo ao botão
  btn.style.position = 'relative';
  btn.appendChild(input);
  input.focus();
  input.showPicker && input.showPicker();

  input.onchange = async function() {
    const newDate = this.value;
    this.remove();

    // Atualizar visual
    const label = btn.querySelector('.kcard-date-label');
    if (label) {
      if (newDate) {
        const parts = newDate.split('-');
        label.textContent = parts[2] + '/' + parts[1];
      } else {
        label.textContent = '—';
      }
    }
    btn.dataset.date = newDate;

    // Salvar no banco
    try {
      await fetch('/admin/api/crm/forecast-inline/' + leadId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ expectedCloseDate: newDate })
      });
      if (window.showToast) window.showToast('Data de fechamento salva', 'success');
    } catch (e) {
      if (window.showToast) window.showToast('Erro ao salvar data', 'error');
    }
  };

  input.onblur = function() {
    setTimeout(function() { input.remove(); }, 200);
  };
};

