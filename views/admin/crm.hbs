window.recalcNewLeadFinance = function() {
  const valEl = document.querySelector('#newLeadForm [name="estimatedValue"]');
  const installEl = document.getElementById('newLeadFinanceInstallments');
  const methodEl = document.getElementById('newLeadFinanceMethod');
  const outVal = document.getElementById('newLeadFinanceValue');
  const outPer = document.getElementById('newLeadFinancePerInstallment');
  const outDisc = document.getElementById('newLeadFinanceDiscount');
  if (!valEl || !installEl) return;
  const total = parseFloat(valEl.value || 0);
  const installments = parseInt(installEl.value || 1);
  const method = methodEl?.value || 'pix';
  const perInstallment = installments > 0 ? total / installments : 0;
  let discount = 0;
  if (method === 'pix') discount = total * 0.05;
  else if (method === 'cartao') discount = 0;
  else if (method === 'boleto') discount = 0;
  if (outVal) outVal.value = 'R$ ' + total.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
  if (outPer) outPer.textContent = 'R$ ' + perInstallment.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
  if (outDisc) outDisc.textContent = '5% (R$ ' + discount.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + ')';
};

