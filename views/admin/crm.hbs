// Exclusão segura: perguntar para onde mover os cards
window.deleteColumnSafe = async function() {
 const colId = window._editingColumnId;
 if (!colId) return;

 // Buscar quantos leads estão nesta coluna
 const colEl = document.querySelector('[data-col-id="' + colId + '"]') ||
               document.querySelector('.btn-edit-col[data-id="' + colId + '"]');
 const statusKey = colEl ? colEl.closest('.flex-shrink-0')?.querySelector('.kanban-drop-zone')?.dataset.status : null;

 // Listar colunas disponíveis para transferência
 const allZones = document.querySelectorAll('.kanban-drop-zone[data-status]');
 const options = [];
 allZones.forEach(function(z) {
  if (z.dataset.status !== statusKey && z.dataset.status !== 'recuperacao') {
   const header = z.closest('.flex-shrink-0')?.querySelector('h4');
   options.push({ status: z.dataset.status, title: header ? header.textContent.trim() : z.dataset.status });
  }
 });

 if (options.length === 0) {
  alert('Não há outras colunas para transferir os cards. Crie outra coluna antes de excluir esta.');
  return;
 }

 // Perguntar destino
 let message = 'EXCLUIR COLUNA\n\nOs leads desta coluna serão transferidos para qual etapa?\n\n';
 options.forEach(function(o, i) { message += (i + 1) + '. ' + o.title + '\n'; });
 message += '\nDigite o número (1-' + options.length + ') ou CANCELAR:';

 const choice = prompt(message);
 if (!choice || choice.toLowerCase() === 'cancelar') return;
 const idx = parseInt(choice) - 1;
 if (isNaN(idx) || idx < 0 || idx >= options.length) { alert('Opção inválida'); return; }

 const targetStatus = options[idx].status;

 // Confirmar
 if (!confirm('Confirma: Excluir coluna e mover leads para "' + options[idx].title + '"?')) return;

 try {
  const res = await fetch('/admin/kanban/columns/' + colId + '/delete-safe', {
   method: 'POST',
   headers: { 'Content-Type': 'application/json' },
   body: JSON.stringify({ transferTo: targetStatus })
  });
  const data = await res.json();
  if (data.success) {
   if (window.showToast) window.showToast('Coluna excluída e leads transferidos!', 'success');
   document.getElementById('editColumnModal').classList.add('hidden');
   document.getElementById('editColumnModal').style.display = 'none';
   setTimeout(function() { location.reload(); }, 500);
  } else {
   alert(data.error || 'Erro ao excluir');
  }
 } catch (e) {
  alert('Erro de rede');
 }
};
</script>
