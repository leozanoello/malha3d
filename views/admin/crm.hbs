 // === NATIVE DRAG & DROP ENGINE (Zero-delay, 60fps) ===
 (function() {
 const _inflight = new Map();
 let _draggedCard = null;
 let _sourceZone = null;
 let _sourceIndex = 0;

 // PROBABILITY AUTO-MAP
 const PROB_MAP = { 'novo_lead': 10, 'em_contato': 25, 'em_negociacao': 50, 'orcamento_enviado': 70, 'aguardando_fechamento': 90 };

 // Bind drag events to all cards
 document.addEventListener('dragstart', function(e) {
  const card = e.target.closest('.kanban-card-main');
  if (!card) return;
  _draggedCard = card;
  _sourceZone = card.closest('.kanban-drop-zone');
  _sourceIndex = Array.from(_sourceZone.children).indexOf(card);
  card.classList.add('dragging');
  e.dataTransfer.effectAllowed = 'move';
  e.dataTransfer.setData('text/plain', card.dataset.id);
  // Minimal ghost (just text)
  const ghost = document.createElement('div');
  ghost.textContent = card.querySelector('.kcard-title')?.textContent || 'Card';
  ghost.style.cssText = 'position:absolute;top:-9999px;left:-9999px;padding:8px 16px;background:#151515;color:#fff;border-radius:4px;font-size:11px;font-weight:900;border:1px solid rgba(249,115,22,0.4);';
  document.body.appendChild(ghost);
  e.dataTransfer.setDragImage(ghost, 60, 15);
  setTimeout(function() { ghost.remove(); }, 0);
  // Highlight all drop zones
  document.querySelectorAll('.kanban-drop-zone').forEach(function(z) { z.classList.add('drag-over'); });
 });

 document.addEventListener('dragend', function(e) {
  if (_draggedCard) _draggedCard.classList.remove('dragging');
  document.querySelectorAll('.kanban-drop-zone').forEach(function(z) { z.classList.remove('drag-over', 'drag-hover'); });
  _draggedCard = null;
  _sourceZone = null;
 });

 // Drop zones
 document.querySelectorAll('.kanban-drop-zone').forEach(function(zone) {
  zone.addEventListener('dragover', function(e) {
   e.preventDefault();
   e.dataTransfer.dropEffect = 'move';
   this.classList.add('drag-hover');
  });

  zone.addEventListener('dragleave', function(e) {
   this.classList.remove('drag-hover');
  });

  zone.addEventListener('drop', function(e) {
   e.preventDefault();
   this.classList.remove('drag-hover');
   if (!_draggedCard) return;

   const newStatus = this.dataset.status;
   const leadId = _draggedCard.dataset.id;
   if (!leadId || !newStatus) return;

   // === OPTIMISTIC UI: Move card instantly ===
   this.appendChild(_draggedCard);

   // === AUTO-PROBABILITY (except recuperacao = FREEZE) ===
   if (newStatus !== 'recuperacao' && PROB_MAP[newStatus] !== undefined) {
    const prob = PROB_MAP[newStatus];
    const probEl = _draggedCard.querySelector('.kcard-probability');
    if (probEl) {
     probEl.textContent = prob + '%';
     probEl.dataset.probability = prob;
     probEl.className = probEl.className.replace(/text-(emerald|orange|amber|red)-\d+/g, '');
     if (prob >= 80) probEl.classList.add('text-emerald-400');
     else if (prob >= 50) probEl.classList.add('text-orange-300');
     else if (prob >= 25) probEl.classList.add('text-amber-400');
     else probEl.classList.add('text-red-400');
    }
    fetch('/admin/api/crm/forecast-inline/' + leadId, {
     method: 'POST', headers: { 'Content-Type': 'application/json' },
     body: JSON.stringify({ probability: prob })
    }).catch(function() {});
   }

   // === PERSIST STATUS (fire-and-forget with rollback) ===
   if (_inflight.has(leadId)) _inflight.get(leadId).abort();
   const ctrl = new AbortController();
   _inflight.set(leadId, ctrl);
   const fromZone = _sourceZone;
   const fromIdx = _sourceIndex;
   const movedCard = _draggedCard;

   fetch('/admin/negociacoes/' + leadId + '/update-status', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ status: newStatus }),
    signal: ctrl.signal
   })
   .then(function(r) { return r.json(); })
   .then(function(d) {
    _inflight.delete(leadId);
    if (!d.success) {
     // Rollback
     if (fromZone && fromZone.children[fromIdx]) fromZone.insertBefore(movedCard, fromZone.children[fromIdx]);
     else if (fromZone) fromZone.appendChild(movedCard);
     if (window.showToast) window.showToast(d.error || 'Erro', 'error');
    }
   })
   .catch(function(err) {
    _inflight.delete(leadId);
    if (err.name === 'AbortError') return;
    if (fromZone && fromZone.children[fromIdx]) fromZone.insertBefore(movedCard, fromZone.children[fromIdx]);
    else if (fromZone) fromZone.appendChild(movedCard);
   });
  });
 });
 })();

 // Auto-open lead if leadId is in URL
 const urlParams = new URLSearchParams(window.location.search);
 const leadId = urlParams.get('leadId');
 if (leadId) {
 const leadCard = document.querySelector(`.kanban-card-main[data-id="${leadId}"]`);
 if (leadCard && leadCard.dataset.lead) {
 window.manageLead(leadCard.dataset.lead);
 }
 }

