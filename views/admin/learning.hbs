<script>
(function() {
  const STORAGE_KEY = 'malha3d_learning_progress';
  const modules = {
    crm: { total: 7, color: 'orange' },
    projetos: { total: 6, color: 'purple' },
    financeiro: { total: 5, color: 'emerald' },
    contatos: { total: 3, color: 'sky' },
    config: { total: 3, color: 'gray' }
  };

  function getProgress() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch(e) { return {}; }
  }

  function renderProgress() {
    const progress = getProgress();
    let totalLessons = 0, completedLessons = 0;
    let badgesUnlocked = 0;

    Object.entries(modules).forEach(function([key, mod]) {
      const completed = (progress[key] || []).length;
      totalLessons += mod.total;
      completedLessons += Math.min(completed, mod.total);
      const pct = Math.round((Math.min(completed, mod.total) / mod.total) * 100);

      var bar = document.getElementById('progress-' + key);
      var label = document.getElementById('progress-' + key + '-label');
      if (bar) bar.style.width = pct + '%';
      if (label) label.textContent = pct + '%';

      // Badge
      var badge = document.getElementById('badge-' + key);
      if (badge && pct >= 100) {
        badge.style.opacity = '1';
        badge.style.border = '2px solid';
        badge.style.boxShadow = '0 0 12px rgba(249,115,22,0.3)';
        badgesUnlocked++;
      }
    });

    var globalPct = totalLessons > 0 ? Math.round((completedLessons / totalLessons) * 100) : 0;
    var globalBar = document.getElementById('globalProgressBar');
    var globalLabel = document.getElementById('globalProgressLabel');
    if (globalBar) globalBar.style.width = globalPct + '%';
    if (globalLabel) globalLabel.textContent = globalPct + '% concluído';

    var badgeLabel = document.getElementById('badgeCountLabel');
    if (badgeLabel) badgeLabel.textContent = badgesUnlocked + ' de 5 desbloqueadas';
  }

  renderProgress();
})();
</script>
