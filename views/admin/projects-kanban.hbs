<!-- 
    ZANOELLO 3D - PIPELINE DE PRODUÇÃO ARCHVIZ 
    Refatoração de Alta Performance e Densidade de Dados
-->

<div class="flex flex-col h-[calc(100vh-100px)] overflow-hidden">
    <!-- Header de Produção -->
    <div class="flex items-center justify-between p-6 bg-dark-950/40 backdrop-blur-md border-b border-white/5">
        <div class="flex items-center gap-4">
            <div class="p-3 bg-indigo-500/10 rounded-2xl border border-indigo-500/20">
                <span class="material-symbols-outlined text-indigo-400 text-2xl">precision_manufacturing</span>
            </div>
            <div>
                <h1 class="text-xl font-black text-white tracking-tighter">Workflow de <span class="text-indigo-400">Produção</span></h1>
                <div class="flex items-center gap-3 mt-1">
                    <span class="text-[9px] font-bold text-gray-500 uppercase tracking-widest">Controle de Ativos Malha3D</span>
                    <div class="w-1 h-1 rounded-full bg-gray-700"></div>
                    <span class="text-[9px] font-black text-indigo-400 uppercase tracking-widest">{{columns.length}} Etapas</span>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-3">
             <div class="flex bg-black/40 p-1 rounded-xl border border-white/5">
                <a href="/admin/projetos/kanban" class="px-5 py-2 text-[9px] font-black text-indigo-400 bg-indigo-400/10 rounded-lg flex items-center gap-2 transition-all uppercase tracking-widest">
                    <span class="material-symbols-outlined text-sm">view_kanban</span> Quadro
                </a>
                <a href="/admin/projetos" class="px-5 py-2 text-[9px] font-black text-gray-500 hover:text-white rounded-lg flex items-center gap-2 transition-all uppercase tracking-widest">
                    <span class="material-symbols-outlined text-sm">list</span> Lista
                </a>
            </div>
            <button class="bg-indigo-500 hover:bg-indigo-600 text-white font-black py-3 px-6 rounded-xl shadow-lg shadow-indigo-500/20 transition-all flex items-center gap-2 text-[9px] uppercase tracking-widest" data-bs-toggle="modal" data-bs-target="#newProjectModal">
                <span class="material-symbols-outlined text-sm">add_circle</span> Novo Projeto
            </button>
        </div>
    </div>

    <!-- Quadro Kanban de Produção -->
    <div id="productionKanban" class="flex-1 overflow-x-auto p-6 scrollbar-premium">
        <div class="flex gap-6 h-full min-w-max">
            {{#each columns}}
            <div class="w-[320px] flex flex-col bg-white/[0.01] rounded-[2rem] border border-white/5 p-4 group/col transition-all">
                <!-- Column Header -->
                <div class="flex items-center justify-between mb-4 px-2">
                    <div class="flex items-center gap-3">
                        <div class="w-1 h-4 rounded-full" style="background-color: {{this.color}}"></div>
                        <h3 class="text-[10px] font-black text-white uppercase tracking-[0.2em]">{{this.name}}</h3>
                        <span class="bg-white/5 text-gray-500 text-[9px] font-black px-2 py-0.5 rounded-full border border-white/5">{{this.projects.length}}</span>
                    </div>
                    <button class="text-gray-600 hover:text-white transition-all opacity-0 group-hover/col:opacity-100"><span class="material-symbols-outlined text-sm">more_vert</span></button>
                </div>

                <!-- Cards Container -->
                <div class="flex-1 space-y-4 kanban-list overflow-y-auto no-scrollbar pb-10" data-status="{{this.statusKey}}">
                    {{#each this.projects}}
                    <div class="glass-card p-5 group cursor-grab active:cursor-grabbing border-l-2 transition-all hover:border-indigo-400/50 hover:bg-white/[0.03] kanban-item" 
                         style="border-left-color: {{../color}}"
                         data-id="{{this.id}}">
                        
                        <div class="flex justify-between items-start mb-3">
                            <div class="flex gap-2">
                                <span class="text-[8px] font-black text-indigo-400 bg-indigo-400/10 px-2 py-0.5 rounded uppercase tracking-tighter">{{this.category}}</span>
                                {{#if this.complexity}}
                                <span class="text-[8px] font-black {{#if (eq this.complexity 'Ultra')}}text-purple-400 bg-purple-400/10{{else if (eq this.complexity 'Alta')}}text-red-400 bg-red-400/10{{else}}text-blue-400 bg-blue-400/10{{/if}} px-2 py-0.5 rounded uppercase tracking-tighter">
                                    {{this.complexity}}
                                </span>
                                {{/if}}
                            </div>
                            <div class="flex gap-1 opacity-0 group-hover:opacity-100 transition-all">
                                {{#if this.customer.phone}}
                                <a href="{{formatWhatsappLink this.customer.phone this.customer.name 'review'}}" target="_blank" class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500/20 flex items-center justify-center transition-all">
                                    <i class="fab fa-whatsapp text-xs"></i>
                                </a>
                                {{/if}}
                                <button onclick="openRevisions('{{this.id}}', '{{this.title}}')" class="w-7 h-7 rounded-lg bg-orange-500/10 text-orange-500 hover:bg-orange-500/20 flex items-center justify-center transition-all" title="Revisões">
                                    <span class="material-symbols-outlined text-sm">history_edu</span>
                                </button>
                                <button onclick="editProject('{{this.id}}')" class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-gray-500 hover:text-white"><span class="material-symbols-outlined text-sm">edit</span></button>
                            </div>
                        </div>

                        <h4 class="text-xs font-black text-white tracking-tight leading-snug mb-1">{{this.title}}</h4>
                        <p class="text-[10px] text-gray-500 font-bold uppercase truncate">{{this.client}}</p>

                        <div class="mt-4 grid grid-cols-2 gap-3">
                             <div class="p-2 rounded-xl bg-white/[0.02] border border-white/5">
                                <div class="flex items-center gap-1.5 mb-1">
                                    <span class="material-symbols-outlined text-[10px] text-gray-600">view_in_ar</span>
                                    <span class="text-[8px] font-black text-gray-600 uppercase">Software</span>
                                </div>
                                <span class="text-[9px] font-bold text-gray-300">{{this.software}}</span>
                            </div>
                            <div class="p-2 rounded-xl bg-white/[0.02] border border-white/5">
                                <div class="flex items-center gap-1.5 mb-1">
                                    <span class="material-symbols-outlined text-[10px] text-gray-600">shutter_speed</span>
                                    <span class="text-[8px] font-black text-gray-600 uppercase">Motor</span>
                                </div>
                                <span class="text-[9px] font-bold text-gray-300">{{this.renderEngine}}</span>
                            </div>
                        </div>

                        <div class="mt-4 pt-4 border-t border-white/5 flex items-center justify-between">
                            <div class="flex -space-x-2">
                                <div class="w-6 h-6 rounded-full border-2 border-dark-950 bg-indigo-500 flex items-center justify-center text-[8px] font-black text-white" title="Responsável: Zanoello">Z</div>
                                {{#if (gt this.priority 'media')}}
                                <div class="w-2.5 h-2.5 rounded-full bg-red-500 absolute -top-1 -right-1 border-2 border-dark-950 animate-ping"></div>
                                {{/if}}
                            </div>
                            <div class="flex items-center gap-2 {{#if (isPast this.deadline)}}text-red-500{{else if (lt (subtract (date this.deadline) (now)) 259200000)}}text-amber-500{{else}}text-gray-500{{/if}} group-hover:text-amber-500 transition-all">
                                <span class="material-symbols-outlined text-xs">calendar_today</span>
                                <span class="text-[9px] font-black">{{formatDateShort this.deadline}}</span>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>

<!-- SortableJS integration -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.kanban-list').forEach(column => {
        new Sortable(column, {
            group: 'production',
            animation: 150,
            ghostClass: 'opacity-20',
            dragClass: 'rotate-2',
            onEnd: async (evt) => {
                const projectId = evt.item.dataset.id;
                const newStatus = evt.to.dataset.status;
                
                try {
                    const response = await fetch('/admin/api/projects/move', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ projectId, status: newStatus })
                    });
                    const result = await response.json();
                    if (!result.success) {
                        alert('Erro ao mover projeto: ' + result.message);
                        window.location.reload();
                    }
                } catch (e) {
                    console.error(e);
                    window.location.reload();
                }
            }
        });
    });
});

<!-- Modal de Revisões -->
<div class="modal fade" id="revisionsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-white/10 shadow-2xl rounded-[2rem] overflow-hidden bg-[#0a0c10]">
            <div class="modal-header border-none p-8 pb-0">
                <div>
                    <h2 class="text-xl font-black text-white tracking-tight" id="revProjectTitle">Projeto</h2>
                    <p class="text-[9px] font-bold text-gray-500 uppercase tracking-widest mt-1">Histórico de Alterações e Feedback</p>
                </div>
                <button type="button" class="btn-close btn-close-white opacity-30" data-bs-dismiss="modal"></button>
            </div>
            
            <div class="modal-body p-8 space-y-6">
                <!-- New Revision Form -->
                <form id="newRevisionForm" class="p-6 bg-white/[0.02] border border-white/5 rounded-2xl space-y-4">
                    <input type="hidden" id="revProjectId" name="projectId">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Descrição do Pedido de Alteração</label>
                        <textarea name="description" required class="w-full bg-black/20 border border-white/10 rounded-xl py-3 px-4 text-xs text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all h-24" placeholder="Descreva o que o cliente pediu para mudar..."></textarea>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Impacto Financeiro (R$)</label>
                            <input type="number" name="financialImpact" value="0" class="w-full bg-black/20 border border-white/10 rounded-xl py-3 px-4 text-xs text-white">
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest px-1">Impacto Prazo (Dias)</label>
                            <input type="number" name="deadlineImpact" value="0" class="w-full bg-black/20 border border-white/10 rounded-xl py-3 px-4 text-xs text-white">
                        </div>
                    </div>
                    <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-black py-3 rounded-xl text-[10px] uppercase tracking-widest transition-all">
                        Registrar Nova Revisão
                    </button>
                </form>

                <!-- Revisions List -->
                <div class="space-y-4 max-h-[400px] overflow-y-auto pr-2 scrollbar-premium" id="revisionsList">
                    <!-- Dynamic Content -->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let currentProjectId = null;

async function openRevisions(id, title) {
    currentProjectId = id;
    document.getElementById('revProjectTitle').textContent = `Revisões: ${title}`;
    document.getElementById('revProjectId').value = id;
    
    const modal = new bootstrap.Modal(document.getElementById('revisionsModal'));
    modal.show();
    
    loadRevisions(id);
}

async function loadRevisions(id) {
    const list = document.getElementById('revisionsList');
    list.innerHTML = '<p class="text-center text-gray-500 py-10 animate-pulse">Carregando histórico...</p>';
    
    try {
        const response = await fetch(`/admin/api/projects/${id}/revisions`);
        const data = await response.json();
        
        if (data.success && data.revisions.length > 0) {
            list.innerHTML = data.revisions.map(rev => `
                <div class="p-5 bg-white/5 border border-white/5 rounded-2xl flex justify-between items-start group">
                    <div>
                        <div class="flex items-center gap-3 mb-2">
                            <span class="text-[8px] font-black px-2 py-0.5 rounded bg-orange-500/10 text-orange-500 uppercase tracking-widest border border-orange-500/20">v${rev.version}</span>
                            <span class="text-[8px] font-black px-2 py-0.5 rounded bg-white/5 text-gray-400 uppercase tracking-widest border border-white/5">${new Date(rev.createdAt).toLocaleDateString()}</span>
                        </div>
                        <p class="text-[11px] text-gray-300 leading-relaxed">${rev.description}</p>
                        <div class="flex gap-4 mt-3">
                            ${rev.financialImpact > 0 ? `<span class="text-[9px] font-bold text-red-400">+ R$ ${rev.financialImpact}</span>` : ''}
                            ${rev.deadlineImpact > 0 ? `<span class="text-[9px] font-bold text-orange-400">+ ${rev.deadlineImpact} dias</span>` : ''}
                        </div>
                    </div>
                    <button onclick="deleteRevision('${rev.id}')" class="opacity-0 group-hover:opacity-100 p-2 text-gray-600 hover:text-red-500 transition-all">
                        <span class="material-symbols-outlined text-sm">delete</span>
                    </button>
                </div>
            `).join('');
        } else {
            list.innerHTML = '<div class="text-center py-10 opacity-30"><span class="material-symbols-outlined text-4xl mb-2">history</span><p class="text-[10px] uppercase font-black">Nenhuma revisão registrada</p></div>';
        }
    } catch (err) {
        list.innerHTML = '<p class="text-red-500 text-center">Erro ao carregar</p>';
    }
}

document.getElementById('newRevisionForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(this).entries());
    
    try {
        const response = await fetch(`/admin/api/projects/${currentProjectId}/revisions`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        if (result.success) {
            this.reset();
            loadRevisions(currentProjectId);
        }
    } catch (err) { console.error(err); }
});

async function deleteRevision(id) {
    if (!confirm('Excluir esta revisão?')) return;
    try {
        const response = await fetch(`/admin/api/revisions/${id}`, { method: 'DELETE' });
        const result = await response.json();
        if (result.success) loadRevisions(currentProjectId);
    } catch (err) { console.error(err); }
}

function editProject(id) {
    window.location.href = `/admin/projetos/${id}/edit`;
}
</script>

<style>
    .scrollbar-premium::-webkit-scrollbar { height: 8px; }
    .scrollbar-premium::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); }
    .scrollbar-premium::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.05); border-radius: 10px; }
    .scrollbar-premium::-webkit-scrollbar-thumb:hover { background: rgba(99, 102, 241, 0.5); }
    .no-scrollbar::-webkit-scrollbar { display: none; }
</style>
