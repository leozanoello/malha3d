    window.generateAIRenderPrompt = function() {
        const title = document.querySelector('#projectForm [name="title"]').value;
        const category = document.querySelector('#projectForm [name="category"]').value;
        const style = document.querySelector('#projectForm [name="desiredAtmosphere"]').value || 'Fotorrealista Premium';
        const elements = document.querySelector('#projectForm [name="specialElements"]').value || '';
        const lighting = Array.from(document.querySelectorAll('#projectForm [name="lightingMood"]:checked')).map(cb => cb.value).join(', ') || 'Iluminação Natural';
        const humanization = document.querySelector('#projectForm [name="humanizationLevel"]').value || 'Médio';

        const outputBox = document.getElementById('ai-output-box');
        const outputContainer = document.getElementById('ai-output-container');
        if (!outputBox || !outputContainer) return;

        outputContainer.classList.remove('hidden');
        outputBox.innerHTML = '';
        
        const prompt = `**PROMPT DE RENDER DE IA GERADO:**\n\n` + 
            `*"Hyper-realistic 3D architectural visualization of ${title || 'Luxury Space'}, ${category} design, designed in an exquisite ${style} aesthetic. ` +
            `The atmosphere is defined by ${lighting} lighting mood. The scene features ${elements || 'premium architectural design and minimal luxury styling'}. ` +
            `Humanized with ${humanization} details, high-end materials, wood, marble, concrete, glass, foliage, cinematic composition, shot on 35mm lens, f/1.8, photorealistic, Unreal Engine 5 render, highly detailed, 8k resolution, octane render, moodboard matched. --ar 16:9 --v 6.0"*`;

        typeWriterEffect(outputBox, prompt);
    };

    window.generateAIRiskAnalysis = function() {
        const title = document.querySelector('#projectForm [name="title"]').value;
        const complexity = document.querySelector('#projectForm [name="complexity"]').value || 'Média';
        const urgency = document.querySelector('#projectForm [name="hasUrgency"]').checked;
        const plannedHours = parseInt(document.querySelector('#projectForm [name="plannedHours"]').value) || 0;
        const executedHours = parseFloat(document.getElementById('tracker-widget-executed').innerText) || 0;
        const deadline = document.querySelector('#projectForm [name="deadline"]').value;

        const outputBox = document.getElementById('ai-output-box');
        const outputContainer = document.getElementById('ai-output-container');
        if (!outputBox || !outputContainer) return;

        outputContainer.classList.remove('hidden');
        outputBox.innerHTML = '';

        let riskLevel = 'BAIXO';
        let riskColor = 'text-emerald-400';
        let recommendations = '';

        if (urgency) {
            riskLevel = 'MUITO ALTO (Urgente)';
            riskColor = 'text-red-500';
            recommendations = '- Recomenda-se alocação imediata de equipe de modelagem extra.\n- Congelar novas revisões com o cliente até a primeira entrega.\n- Utilizar motor de render D5 para otimização de tempo.';
        } else if (executedHours > plannedHours * 0.8) {
            riskLevel = 'ALTO (Estouro de Horas)';
            riskColor = 'text-rose-400';
            recommendations = '- Estouro iminente do orçamento de horas de produção.\n- Limitar reuniões de alinhamento desnecessárias.\n- Otimizar etapas finais de renderização e pós-produção.';
        } else {
            riskLevel = 'BAIXO (Dentro do planejado)';
            riskColor = 'text-emerald-400';
            recommendations = '- Manter o ritmo de produção atual.\n- Registrar feedbacks e logs de progresso diariamente.';
        }

        let deadlineStr = 'Não definido';
        if (deadline) {
            const daysLeft = Math.ceil((new Date(deadline) - new Date()) / (1000 * 60 * 60 * 24));
            deadlineStr = `${new Date(deadline).toLocaleDateString('pt-BR')} (${daysLeft} dias restantes)`;
        }

        const analysis = `**ANÁLISE DE RISO OPERACIONAL INTELIGENTE (AI):**\n\n` +
            `• **Projeto:** ${title || 'Projeto Atual'}\n` +
            `• **Complexidade:** ${complexity}\n` +
            `• **Nível de Risco:** <span class="font-black ${riskColor}">${riskLevel}</span>\n` +
            `• **Cronograma de Horas:** ${executedHours}h executadas de ${plannedHours}h estimadas.\n` +
            `• **Prazo Final:** ${deadlineStr}\n\n` +
            `**RECOMENDAÇÕES ESTRATÉGICAS:**\n${recommendations}`;

        outputBox.innerHTML = analysis; 
    };

    window.copyAIPrompt = function() {
        const text = document.getElementById('ai-output-box').innerText;
        if (!text) return;
        navigator.clipboard.writeText(text).then(() => {
            window.showNotification('Copiado para a área de transferência!', 'success');
        });
    };

    function typeWriterEffect(element, text, speed = 8) {
        let i = 0;
        element.innerHTML = '';
        function type() {
            if (i < text.length) {
                if (text.charAt(i) === '\n') {
                    element.innerHTML += '<br>';
                } else {
                    element.innerHTML += text.charAt(i);
                }
                i++;
                setTimeout(type, speed);
            }
        }
        type();
    }

