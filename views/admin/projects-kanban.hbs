<!-- 
    ZANOELLO 3D - PIPELINE DE PRODUÇÃO ARCHVIZ 
    Refatoração de Alta Performance e Densidade de Dados (Clonagem CRM Parity)
-->

<div class="flex flex-col h-[calc(100vh-100px)] overflow-hidden">
    <!-- Header de Produção -->
    <div class="flex items-center justify-between p-6 bg-dark-950/40 backdrop-blur-md border-b border-white/5">
        <div class="flex items-center gap-4">
            <div class="p-3 bg-indigo-500/10 rounded-2xl border border-indigo-500/20">
                <span class="material-symbols-outlined text-indigo-400 text-2xl">precision_manufacturing</span>
            </div>
            <div>
                <h1 class="text-xl font-black text-white tracking-tighter">Workflow de <span class="text-indigo-400">Produção</span></h1>
                <div class="flex items-center gap-3 mt-1">
                    <span class="text-[9px] font-bold text-gray-500 uppercase tracking-widest">Controle de Ativos Malha3D</span>
                    <div class="w-1 h-1 rounded-full bg-gray-700"></div>
                    <span class="text-[9px] font-black text-indigo-400 uppercase tracking-widest">{{columns.length}} Etapas</span>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-4">
            <!-- Tabs Internas (Visual Only for Parity) -->
            <div class="flex bg-black/40 p-1 rounded-xl border border-white/5 mr-4">
                <button class="crm-page-tab active px-5 py-2 text-[9px] font-black text-indigo-400 bg-indigo-400/10 rounded-lg flex items-center gap-2 transition-all uppercase tracking-widest" data-tab="kanban">
                    <span class="material-symbols-outlined text-sm">view_kanban</span> Kanban
                </button>
                <button class="crm-page-tab px-5 py-2 text-[9px] font-black text-gray-500 hover:text-white rounded-lg flex items-center gap-2 transition-all uppercase tracking-widest" data-tab="analytics">
                    <span class="material-symbols-outlined text-sm">analytics</span> Performance
                </button>
            </div>

            <button class="bg-white/5 hover:bg-white/10 text-white font-black py-3 px-6 rounded-xl border border-white/10 transition-all flex items-center gap-2 text-[9px] uppercase tracking-widest" id="btn-add-column">
                <span class="material-symbols-outlined text-sm">view_column</span> Nova Etapa
            </button>
            <button class="bg-indigo-500 hover:bg-indigo-600 text-white font-black py-3 px-6 rounded-xl shadow-lg shadow-indigo-500/20 transition-all flex items-center gap-2 text-[9px] uppercase tracking-widest" id="btn-new-project">
                <span class="material-symbols-outlined text-sm">add_circle</span> Novo Projeto
            </button>
        </div>
    </div>

    <!-- Analytics Section (Hidden by Default) -->
    <div id="analytics-container" class="hidden flex-1 overflow-y-auto p-8 scrollbar-hide bg-dark-900/50">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="glass-card p-6 border-white/5">
                <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2">Projetos em Produção</p>
                <h3 class="text-3xl font-black text-white tracking-tighter" id="stat-active-projects">--</h3>
            </div>
            <div class="glass-card p-6 border-white/5">
                <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2">Ticket Médio Archviz</p>
                <h3 class="text-3xl font-black text-white tracking-tighter" id="stat-avg-ticket">R$ --</h3>
            </div>
            <div class="glass-card p-6 border-white/5">
                <p class="text-[9px] font-black text-indigo-400 uppercase tracking-widest mb-2">Eficiência de Entrega</p>
                <h3 class="text-3xl font-black text-white tracking-tighter">94%</h3>
            </div>
        </div>
        <!-- Placeholder for Charts -->
        <div class="grid grid-cols-2 gap-6 h-96">
            <div class="glass-card p-6 border-white/5 flex flex-col">
                <h4 class="text-[10px] font-black text-white uppercase tracking-widest mb-6">Volume de Produção (6 Meses)</h4>
                <div class="flex-1 bg-black/20 rounded-2xl flex items-center justify-center border border-white/5">
                    <p class="text-[10px] text-gray-600 font-black uppercase">Gráfico em Sincronização...</p>
                </div>
            </div>
            <div class="glass-card p-6 border-white/5 flex flex-col">
                <h4 class="text-[10px] font-black text-white uppercase tracking-widest mb-6">Distribuição por Categoria</h4>
                <div class="flex-1 bg-black/20 rounded-2xl flex items-center justify-center border border-white/5">
                    <p class="text-[10px] text-gray-600 font-black uppercase">Gráfico em Sincronização...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Kanban Board Container -->
    <div id="kanban-board-container" class="flex-1 flex overflow-hidden">
        <div id="kanban-board" class="flex-1 flex gap-6 overflow-x-auto p-6 scrollbar-hide select-none">
            {{#each columns}}
            <div class="kanban-column w-[320px] flex-shrink-0 flex flex-col h-full group/col" data-id="{{this.id}}" data-status="{{this.statusKey}}">
                <!-- Column Header -->
                <div class="glass-card mb-4 border-white/10 relative overflow-hidden flex-shrink-0 group hover:border-indigo-500/30 transition-all cursor-move" style="border-top: 3px solid {{this.color}}">
                    <div class="p-4 flex items-center justify-between">
                        <div>
                            <h3 class="text-[10px] font-black text-white uppercase tracking-[0.2em] flex items-center gap-2">
                                {{this.name}}
                                <span class="bg-indigo-500/10 text-indigo-400 px-2 py-0.5 rounded-full text-[8px]">{{this.projects.length}}</span>
                            </h3>
                        </div>
                        <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-all">
                            <button class="p-1.5 text-gray-500 hover:text-white btn-edit-column" 
                                    data-id="{{this.id}}" 
                                    data-title="{{this.name}}" 
                                    data-color="{{this.color}}">
                                <span class="material-symbols-outlined text-sm">settings</span>
                            </button>
                            <button class="p-1.5 text-gray-500 hover:text-red-500 btn-delete-column" data-id="{{this.id}}">
                                <span class="material-symbols-outlined text-sm">delete</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Cards Container -->
                <div class="cards-list flex-1 overflow-y-auto space-y-3 pr-2 scrollbar-hide min-h-[100px]" data-status="{{this.statusKey}}">
                    {{#each this.projects}}
                    <div class="kanban-card group p-3.5 bg-white/[0.03] border border-white/10 rounded-[1.5rem] hover:border-indigo-500/40 transition-all cursor-pointer mb-3 relative overflow-hidden backdrop-blur-xl shadow-2xl" 
                         draggable="true" 
                         data-id="{{this.id}}">
                        
                        <!-- Side Bar -->
                        <div class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-12 rounded-r-full" style="background-color: {{../color}}"></div>
                        
                        <!-- Header -->
                        <div class="flex items-center justify-between mb-3 relative z-10">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center group-hover:scale-105 transition-transform">
                                    <span class="material-symbols-outlined text-indigo-400 text-lg">architecture</span>
                                </div>
                                <div class="flex flex-col">
                                    <h5 class="text-[11px] font-black text-white leading-tight uppercase tracking-tight group-hover:text-indigo-400 transition-colors">{{this.title}}</h5>
                                    <span class="text-[8px] text-gray-500 font-bold uppercase tracking-widest mt-0.5">{{this.category}}</span>
                                </div>
                            </div>
                        </div>

                        <!-- Info Grid -->
                        <div class="grid grid-cols-2 gap-3 mb-4 relative z-10">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-[10px] text-gray-600">person</span>
                                <span class="text-[9px] font-bold text-gray-400 truncate">{{this.client}}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-[10px] text-gray-600">payments</span>
                                <span class="text-[9px] font-black text-emerald-400">R$ {{formatCurrency this.price}}</span>
                            </div>
                        </div>

                        <!-- Progress Bar (Based on Complexity or Static for now) -->
                        <div class="space-y-2 relative z-10">
                            <div class="flex justify-between items-center text-[8px] font-black uppercase tracking-widest">
                                <span class="text-gray-500">Status de Produção</span>
                                <span class="text-indigo-400">{{this.complexity}}</span>
                            </div>
                            <div class="h-1.5 w-full bg-white/5 rounded-full overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-indigo-600 to-indigo-400 shadow-[0_0_12px_rgba(99,102,241,0.4)]" style="width: 65%"></div>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="flex items-center justify-between mt-4 pt-3 border-t border-white/5 relative z-10">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-[12px] text-gray-600">event</span>
                                <span class="text-[8px] font-black text-gray-500 uppercase">{{formatDateShort this.deadline}}</span>
                            </div>
                            <div class="flex -space-x-2">
                                <div class="w-6 h-6 rounded-full border-2 border-dark-950 bg-indigo-500 flex items-center justify-center text-[8px] font-black text-white">LZ</div>
                                <div class="w-6 h-6 rounded-full border-2 border-dark-950 bg-gray-800 flex items-center justify-center text-[8px] font-black text-gray-400">+1</div>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                    
                    {{#unless this.projects.length}}
                    <div class="border-2 border-dashed border-white/5 rounded-3xl p-10 flex flex-col items-center justify-center text-center opacity-10">
                        <span class="material-symbols-outlined text-3xl mb-2">inbox</span>
                        <p class="text-[10px] font-black uppercase tracking-widest">Etapa Vazia</p>
                    </div>
                    {{/unless}}
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>

<!-- ==========================================
     MODAL: DETALHES DO PROJETO (Clonado do CRM)
     ========================================== -->
<div class="modal fade" id="projectDetailModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content bg-dark-950 border border-white/10 glass-blur rounded-[2.5rem] overflow-hidden shadow-2xl">
            <div class="modal-header p-8 border-b border-white/5 flex flex-col items-start gap-4">
                <div class="flex items-center justify-between w-full">
                    <div class="flex flex-col">
                        <div class="flex items-center gap-3 mb-1">
                            <span class="bg-indigo-500/10 text-indigo-400 px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest" id="drawer-id-label">#PROJ-0000</span>
                            <span class="bg-white/5 text-gray-500 px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest" id="drawer-status-label">PRODUÇÃO</span>
                        </div>
                        <h2 class="modal-title text-2xl font-black text-white tracking-tight" id="drawer-name">Nome do Projeto</h2>
                    </div>
                    <div class="flex items-center gap-4">
                        <button type="button" id="btn-edit-toggle" class="px-5 py-2.5 bg-white/5 hover:bg-white/10 border border-white/10 text-white rounded-xl font-black text-[9px] uppercase tracking-widest transition-all flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm">edit</span> Editar Projeto
                        </button>
                        <button type="button" id="btn-mark-finished" class="px-6 py-2.5 bg-indigo-500 hover:bg-indigo-600 text-white rounded-xl font-black text-[9px] uppercase tracking-widest transition-all shadow-lg shadow-indigo-500/20 flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm">verified</span> Finalizar & Entregar
                        </button>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                </div>

                <!-- Tab Navigation -->
                <ul class="nav nav-tabs border-0 flex gap-8 w-full mt-2" id="projectTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-gray-500 py-2 px-0 hover:text-white transition-all relative group" id="details-tab" data-bs-toggle="tab" data-bs-target="#details-content" type="button" role="tab">
                            Especificações Técnicas
                            <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-indigo-500 group-hover:w-full transition-all"></div>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-gray-500 py-2 px-0 hover:text-white transition-all relative group" id="revisions-tab" data-bs-toggle="tab" data-bs-target="#revisions-content" type="button" role="tab">
                            Controle de Revisões
                            <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-indigo-500 group-hover:w-full transition-all"></div>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-gray-500 py-2 px-0 hover:text-white transition-all relative group" id="deliveries-tab" data-bs-toggle="tab" data-bs-target="#deliveries-content" type="button" role="tab">
                            Entregas & Arquivos
                            <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-indigo-500 group-hover:w-full transition-all"></div>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-gray-500 py-2 px-0 hover:text-white transition-all relative group" id="timeline-tab" data-bs-toggle="tab" data-bs-target="#timeline-content" type="button" role="tab">
                            Logs de Produção
                            <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-indigo-500 group-hover:w-full transition-all"></div>
                        </button>
                    </li>
                </ul>
            </div>
            
            <div class="modal-body p-8 scrollbar-hide">
                <div class="tab-content h-full" id="projectTabsContent">
                    <!-- TAB 1: ESPECIFICAÇÕES -->
                    <div class="tab-pane fade show active h-full" id="details-content" role="tabpanel">
                        <form id="projectForm" class="space-y-8">
                            <input type="hidden" name="id" id="project-id-input">
                            
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                                <!-- Dados Gerais -->
                                <section class="glass-card p-8 border-white/5 space-y-6">
                                    <h3 class="text-[10px] font-black text-indigo-400 uppercase tracking-widest flex items-center gap-2">
                                        <span class="material-symbols-outlined text-sm">inventory_2</span> Gestão de Produção
                                    </h3>
                                    <div class="grid grid-cols-2 gap-6">
                                        <div class="col-span-2">
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Título do Projeto</label>
                                            <input type="text" name="title" class="input-premium" required disabled>
                                        </div>
                                        <div>
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Preço de Venda (R$)</label>
                                            <input type="number" step="0.01" name="price" class="input-premium" disabled>
                                        </div>
                                        <div>
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Prazo de Entrega</label>
                                            <input type="date" name="deadline" class="input-premium" disabled>
                                        </div>
                                        <div>
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Complexidade</label>
                                            <select name="complexity" class="input-premium" disabled>
                                                <option value="Baixa">Baixa</option>
                                                <option value="Média">Média</option>
                                                <option value="Alta">Alta</option>
                                                <option value="Ultra">Ultra</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Prioridade</label>
                                            <select name="priority" class="input-premium" disabled>
                                                <option value="baixa">Baixa</option>
                                                <option value="media">Média</option>
                                                <option value="alta">Alta</option>
                                                <option value="urgente">Urgente</option>
                                            </select>
                                        </div>
                                    </div>
                                </section>

                                <!-- Archviz Specs -->
                                <section class="glass-card p-8 border-white/5 space-y-6">
                                    <h3 class="text-[10px] font-black text-orange-500 uppercase tracking-widest flex items-center gap-2">
                                        <span class="material-symbols-outlined text-sm">view_in_ar</span> Specs Técnicas
                                    </h3>
                                    <div class="grid grid-cols-2 gap-6">
                                        <div>
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Categoria</label>
                                            <select name="category" class="input-premium" disabled>
                                                <option value="interior">Interior</option>
                                                <option value="arquitetonico">Arquitetônico</option>
                                                <option value="animacao">Animação</option>
                                                <option value="outro">Outro</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Metragem (m²)</label>
                                            <input type="number" name="totalArea" class="input-premium" disabled>
                                        </div>
                                        <div class="col-span-2">
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Software de Modelagem</label>
                                            <input type="text" name="software" class="input-premium" disabled>
                                        </div>
                                        <div>
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Motor de Render</label>
                                            <input type="text" name="renderEngine" class="input-premium" disabled>
                                        </div>
                                        <div>
                                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Dias de Produção</label>
                                            <input type="number" name="productionDays" class="input-premium" disabled>
                                        </div>
                                    </div>
                                </section>
                            </div>

                            <div id="edit-actions" class="hidden pt-6 flex gap-4">
                                <button type="submit" class="flex-1 bg-indigo-500 hover:bg-indigo-600 text-white py-4 rounded-2xl font-black text-[10px] uppercase tracking-[0.3em] transition-all shadow-lg shadow-indigo-500/20">Salvar Alterações</button>
                                <button type="button" id="btn-cancel-edit" class="px-8 bg-white/5 text-white py-4 rounded-2xl font-black text-[10px] uppercase tracking-widest border border-white/10 transition-all">Descartar</button>
                            </div>
                        </form>
                    </div>

                    <!-- TAB 2: REVISÕES -->
                    <div class="tab-pane fade h-full" id="revisions-content" role="tabpanel">
                        <div class="space-y-6">
                            <div class="flex items-center justify-between">
                                <h3 class="text-xs font-black text-white uppercase tracking-widest">Histórico de Revisões</h3>
                                <button class="bg-indigo-500/10 text-indigo-400 px-4 py-2 rounded-xl text-[9px] font-black uppercase tracking-widest transition-all" id="btn-new-revision">Registrar Revisão</button>
                            </div>
                            <div id="project-revisions-list" class="space-y-4">
                                <!-- Dynamic List -->
                            </div>
                        </div>
                    </div>

                    <!-- TAB 3: ENTREGAS -->
                    <div class="tab-pane fade h-full" id="deliveries-content" role="tabpanel">
                        <div class="space-y-6">
                            <div class="flex items-center justify-between">
                                <h3 class="text-xs font-black text-white uppercase tracking-widest">Arquivos de Entrega</h3>
                                <button class="bg-indigo-500/10 text-indigo-400 px-4 py-2 rounded-xl text-[9px] font-black uppercase tracking-widest transition-all" id="btn-new-delivery">Nova Entrega</button>
                            </div>
                            <div id="project-deliveries-list" class="grid grid-cols-2 gap-4">
                                <!-- Dynamic List -->
                            </div>
                        </div>
                    </div>

                    <!-- TAB 4: LOGS -->
                    <div class="tab-pane fade h-full" id="timeline-content" role="tabpanel">
                        <div id="project-logs-timeline" class="space-y-6 overflow-y-auto pr-2 scrollbar-hide">
                            <!-- Dynamic Logs -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     MODAL: GESTÃO DE COLUNAS (Clonado)
     ========================================== -->
<div class="modal fade" id="columnSettingsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-card border-white/10 bg-dark-950 p-8">
            <h3 class="text-2xl font-black text-white mb-8 tracking-tight">Gestão de <span class="text-indigo-400">Etapas de Produção</span></h3>
            
            <form id="columnForm" class="space-y-6">
                <input type="hidden" name="id" id="col-id-input">
                <div class="grid grid-cols-3 gap-6">
                    <div class="col-span-2">
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Título da Etapa</label>
                        <input type="text" name="title" id="col-title-input" class="input-premium" placeholder="Ex: Modelagem 3D" required>
                    </div>
                    <div>
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2 block">Cor de Destaque</label>
                        <div class="flex items-center gap-3">
                            <input type="color" name="color" id="col-color-input" class="w-12 h-12 rounded-xl bg-transparent border-none cursor-pointer p-0" value="#6366f1">
                            <span class="text-[10px] font-bold text-gray-500" id="color-code">#6366F1</span>
                        </div>
                    </div>
                </div>
                <div class="pt-6 border-t border-white/5 flex gap-4">
                    <button type="submit" class="flex-1 bg-indigo-500 text-white py-3 rounded-2xl font-black text-[10px] uppercase tracking-widest transition-all">Salvar Etapa</button>
                    <button type="button" class="flex-1 bg-white/5 text-white py-3 rounded-2xl font-black text-[10px] uppercase tracking-widest border border-white/10 transition-all" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .kanban-card:hover {
        transform: scale(1.03) translateY(-4px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.6), 0 0 25px rgba(99,102,241,0.1);
        z-index: 10;
    }
    .sortable-ghost {
        opacity: 0.2;
        transform: scale(0.9);
    }
    .input-premium {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1rem;
        padding: 0.75rem 1rem;
        color: white;
        font-size: 11px;
        font-weight: 700;
        width: 100%;
        transition: all 0.3s;
    }
    .input-premium:focus {
        border-color: #6366f1;
        background: rgba(0, 0, 0, 0.4);
        outline: none;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }
    .input-premium:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>

<!-- SortableJS -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // === INITIALIZATION ===
    const kanbanLists = document.querySelectorAll('.cards-list');
    const columnModalElement = document.getElementById('columnSettingsModal');
    const projectModalElement = document.getElementById('projectDetailModal');
    
    const columnModal = columnModalElement ? new bootstrap.Modal(columnModalElement) : null;
    const projectDetailModal = projectModalElement ? new bootstrap.Modal(projectModalElement) : null;

    // === KANBAN DRAG & DROP ===
    kanbanLists.forEach(list => {
        new Sortable(list, {
            group: 'production',
            animation: 250,
            ghostClass: 'sortable-ghost',
            onEnd: function(evt) {
                const projectId = evt.item.dataset.id;
                const newStatus = evt.to.dataset.status;
                
                fetch('/admin/api/projects/move', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ projectId, status: newStatus })
                }).then(res => {
                    if (res.ok) window.showNotification('Status da produção atualizado!', 'success');
                    else window.showNotification('Erro ao mover projeto', 'error');
                });
            }
        });
    });

    // === GLOBAL EVENT DELEGATION ===
    document.addEventListener('click', function(e) {
        const card = e.target.closest('.kanban-card');
        if (card) {
            openProjectDetails(card.dataset.id);
            return;
        }

        const btnEditCol = e.target.closest('.btn-edit-column');
        if (btnEditCol) {
            const { id, title, color } = btnEditCol.dataset;
            document.getElementById('col-id-input').value = id;
            document.getElementById('col-title-input').value = title;
            document.getElementById('col-color-input').value = color;
            document.getElementById('color-code').innerText = color.toUpperCase();
            columnModal.show();
            return;
        }

        const btnDeleteCol = e.target.closest('.btn-delete-column');
        if (btnDeleteCol) {
            if (confirm('Excluir esta etapa de produção?')) {
                fetch(`/admin/kanban/columns/${btnDeleteCol.dataset.id}`, { method: 'DELETE' })
                    .then(() => window.location.reload());
            }
            return;
        }
    });

    // === EDIT MODE LOGIC ===
    const btnEditToggle = document.getElementById('btn-edit-toggle');
    const btnCancelEdit = document.getElementById('btn-cancel-edit');
    const editActions = document.getElementById('edit-actions');
    const projectForm = document.getElementById('projectForm');

    function toggleEditMode(enabled) {
        if (!projectForm) return;
        const inputs = projectForm.querySelectorAll('input, select, textarea');
        inputs.forEach(input => { if (input.name !== 'id') input.disabled = !enabled; });
        
        if (enabled) {
            editActions?.classList.remove('hidden');
            btnEditToggle?.classList.add('hidden');
        } else {
            editActions?.classList.add('hidden');
            btnEditToggle?.classList.remove('hidden');
        }
    }

    btnEditToggle?.addEventListener('click', () => toggleEditMode(true));
    btnCancelEdit?.addEventListener('click', () => toggleEditMode(false));

    // === PROJECT DETAILS LOADER ===
    function openProjectDetails(id) {
        fetch(`/admin/api/projects/${id}`)
            .then(res => res.json())
            .then(({ project }) => {
                const form = document.getElementById('projectForm');
                toggleEditMode(false);

                form.querySelector('[name="id"]').value = project.id;
                form.querySelector('[name="title"]').value = project.title || '';
                form.querySelector('[name="price"]').value = project.price || 0;
                form.querySelector('[name="deadline"]').value = project.deadline ? project.deadline.split('T')[0] : '';
                form.querySelector('[name="complexity"]').value = project.complexity || 'Média';
                form.querySelector('[name="priority"]').value = project.priority || 'media';
                form.querySelector('[name="category"]').value = project.category || 'interior';
                form.querySelector('[name="totalArea"]').value = project.totalArea || '';
                form.querySelector('[name="software"]').value = project.software || '';
                form.querySelector('[name="renderEngine"]').value = project.renderEngine || '';
                form.querySelector('[name="productionDays"]').value = project.productionDays || 0;

                // Labels
                document.getElementById('drawer-id-label').innerText = `#PROJ-${String(project.id).padStart(4, '0')}`;
                document.getElementById('drawer-status-label').innerText = project.status.toUpperCase();
                document.getElementById('drawer-name').innerText = project.title;

                projectDetailModal.show();
            });
    }

    // === FORM SUBMISSION ===
    projectForm?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(this).entries());
        
        const response = await fetch(`/admin/api/projects/${data.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (response.ok) {
            window.showNotification('Projeto atualizado!', 'success');
            setTimeout(() => window.location.reload(), 800);
        }
    });

    document.getElementById('btn-add-column')?.addEventListener('click', () => {
        document.getElementById('col-id-input').value = '';
        document.getElementById('col-title-input').value = '';
        columnModal.show();
    });

    document.getElementById('columnForm')?.addEventListener('submit', function(e) {
        e.preventDefault();
        const id = document.getElementById('col-id-input').value;
        const data = Object.fromEntries(new FormData(this).entries());
        const method = id ? 'PUT' : 'POST';
        const url = id ? `/admin/kanban/columns/${id}` : '/admin/kanban/columns';
        
        fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...data, type: 'project' })
        }).then(() => window.location.reload());
    });

    document.getElementById('btn-new-project')?.addEventListener('click', () => {
        window.location.href = '/admin/projetos/criar';
    });
});
</script>
