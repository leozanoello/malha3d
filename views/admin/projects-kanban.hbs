    window.loadProjectChecklist = function(projectId) {
        const listContainer = document.getElementById('project-checklist-list');
        if (!listContainer) return;
        
        let checklist = [];
        try {
            checklist = JSON.parse(localStorage.getItem(`project_checklist_${projectId}`)) || [
                { id: 1, title: 'Modelagem 3D Base', completed: false },
                { id: 2, title: 'Texturização & Materiais', completed: false },
                { id: 3, title: 'Iluminação & Câmeras', completed: false },
                { id: 4, title: 'Pós-produção Finais', completed: false }
            ];
        } catch (e) {
            checklist = [];
        }
        
        if (checklist.length === 0) {
            listContainer.innerHTML = `
                <div class="py-6 text-center text-gray-500 text-[10px] font-bold">
                    Nenhum item no checklist. Adicione acima!
                </div>
            `;
            return;
        }
        
        listContainer.innerHTML = checklist.map(item => `
            <div class="p-3 bg-white/2 border border-white/5 rounded-2xl flex items-center justify-between gap-4 group hover:border-white/10 transition-all">
                <div class="flex items-center gap-3">
                    <input type="checkbox" ${item.completed ? 'checked' : ''} onchange="toggleChecklistItem(${item.id}, this.checked)" class="w-4 h-4 rounded border-white/10 bg-black/40 text-indigo-500 cursor-pointer">
                    <span class="text-[11px] font-medium transition-all ${item.completed ? 'text-gray-500 line-through' : 'text-white'}">${item.title}</span>
                </div>
                <button type="button" onclick="deleteChecklistItem(${item.id})" class="text-gray-600 hover:text-red-400 transition-all opacity-0 group-hover:opacity-100 cursor-pointer">
                    <span class="material-symbols-outlined text-sm">delete</span>
                </button>
            </div>
        `).join('');
    };

    // Adicionar item ao checklist
    document.getElementById('btn-project-add-task')?.addEventListener('click', () => {
        const input = document.getElementById('project-new-task-input');
        if (!input || !input.value.trim()) return;
        
        const title = input.value.trim();
        let checklist = [];
        try {
            checklist = JSON.parse(localStorage.getItem(`project_checklist_${currentProjectId}`)) || [];
        } catch (e) {
            checklist = [];
        }
        
        const newItem = {
            id: Date.now(),
            title,
            completed: false
        };
        
        checklist.push(newItem);
        localStorage.setItem(`project_checklist_${currentProjectId}`, JSON.stringify(checklist));
