                                                <span class="material-symbols-outlined text-xs">delete</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            `;
                        });
                    } else {
                        delHtml = `
                            <div class="p-6 text-center text-gray-500 text-[10px] font-bold col-span-2">
                                Nenhuma entrega registrada ainda.
                            </div>
                        `;
                    }
                    delList.innerHTML = delHtml;
                }
            });
    };

    window.toggleDeliveryConfirmation = function(id, checked) {
        fetch(`/admin/api/deliveries/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ confirmation: checked })
        })
        .then(res => res.json())
        .then(data => {
            window.showNotification('Status de confirmação atualizado!', 'success');
            window.loadProjectDeliveries(currentProjectId);
        });
    };

    window.deleteDelivery = function(id) {
        if (!confirm('Deseja realmente excluir esta entrega?')) return;
        fetch(`/admin/api/deliveries/${id}`, {
            method: 'DELETE'
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                window.showNotification('Entrega excluída!', 'success');
                window.loadProjectDeliveries(currentProjectId);
            } else {
                window.showNotification('Erro ao excluir entrega', 'error');
            }
        });
    };

    // ==========================================
    // SEÇÃO OPERACIONAL E IA: MOTOR DE TAREFAS E PROGRESSO
    // ==========================================
    
    window.updateProjectTaskProgress = function(tasks) {
        if (!tasks || tasks.length === 0) {
            document.getElementById('project-task-progress-text').innerText = '0%';
            document.getElementById('project-task-progress-bar').style.width = '0%';
            return;
        }
        const total = tasks.length;
        const completed = tasks.filter(t => t.isCompleted).length;
        const percent = Math.round((completed / total) * 100);
        document.getElementById('project-task-progress-text').innerText = percent + '%';
        document.getElementById('project-task-progress-bar').style.width = percent + '%';
    };

    let currentViewMode = 'list'; // list, kanban, gantt, calendar
    let projectMilestonesData = []; // Store loaded milestones and tasks

    window.switchTaskView = function(mode) {
        currentViewMode = mode;
        const modes = ['list', 'kanban', 'gantt', 'calendar'];
        modes.forEach(m => {
            const btn = document.getElementById(`btn-view-${m}`);
            const container = document.getElementById(`task-view-container-${m}`);
            if (btn) {
                if (m === mode) {
                    btn.classList.add('bg-indigo-500', 'text-white');
                    btn.classList.remove('text-gray-400');
                } else {
                    btn.classList.remove('bg-indigo-500', 'text-white');
                    btn.classList.add('text-gray-400');
                }
            }
            if (container) {
                if (m === mode) {
                    container.classList.remove('hidden');
                } else {
                    container.classList.add('hidden');
                }
            }
        });
        renderCurrentTaskView();
    };

    function renderCurrentTaskView() {
        if (!projectMilestonesData || projectMilestonesData.length === 0) {
            const emptyHtml = `
                <div class="py-6 text-center text-gray-500 text-[10px] font-bold">
                    Nenhuma tarefa cadastrada nesta fase. Crie um marco e adicione tarefas!
                </div>
            `;
            document.getElementById('project-checklist-list').innerHTML = emptyHtml;
            document.getElementById('task-kanban-board').innerHTML = emptyHtml;
            document.getElementById('task-gantt-chart').innerHTML = emptyHtml;
            const calendarContainer = document.getElementById('task-team-calendar');
            if (calendarContainer) calendarContainer.innerHTML = emptyHtml;
            return;
        }

        // Calculate progress text and bar
        let totalTasks = 0;
        let completedTasks = 0;
        projectMilestonesData.forEach(m => {
            if (m.tasks) {
                m.tasks.forEach(t => {
                    totalTasks++;
                    if (t.status === 'concluido') completedTasks++;
                    if (t.subTasks) {
                        t.subTasks.forEach(st => {
                            totalTasks++;
                            if (st.status === 'concluido') completedTasks++;
                        });
                    }
                });
            }
        });
        const percent = totalTasks > 0 ? Math.round((completedTasks / totalTasks) * 100) : 0;
        document.getElementById('project-task-progress-text').innerText = percent + '%';
        document.getElementById('project-task-progress-bar').style.width = percent + '%';

        if (currentViewMode === 'list') {
            renderListView();
        } else if (currentViewMode === 'kanban') {
            renderKanbanView();
        } else if (currentViewMode === 'gantt') {
            renderGanttView();
        } else if (currentViewMode === 'calendar') {
            renderCalendarView();
        }
    }

    function renderListView() {
        const container = document.getElementById('project-checklist-list');
        if (!container) return;

        let html = '';
        projectMilestonesData.forEach(m => {
            html += `
            <div class="mb-6 p-4 bg-white/[0.01] border border-white/5 rounded-2xl text-left">
                <div class="flex items-center justify-between border-b border-white/5 pb-2 mb-3">
                    <h4 class="text-xs font-black uppercase text-orange-500">${m.title}</h4>
                    <span class="text-[9px] text-gray-500 font-bold">${m.description || ''}</span>
                </div>
                <div class="space-y-3">
            `;
            if (m.tasks && m.tasks.length > 0) {
                m.tasks.forEach(t => {
                    const assigneeName = t.assignee ? t.assignee.name : 'Sem responsável';
                    const pendingDeps = (t.dependencies || []).filter(dep => dep.status !== 'concluido');
                    const isBlocked = pendingDeps.length > 0;
                    const depStr = isBlocked ? `<span class="px-1.5 py-0.5 rounded bg-red-500/10 text-red-500 text-[8px] font-bold inline-flex items-center gap-0.5"><span class="material-symbols-outlined text-[10px]">lock</span> Bloqueada</span>` : '';
                    const revStr = t.revisionRound > 0 ? `<span class="px-1.5 py-0.5 rounded bg-orange-500/10 text-orange-500 text-[8px] font-bold">🔄 Rev ${t.revisionRound}</span>` : '';
                    
                    html += `
                    <div class="p-3 bg-white/2 border border-white/5 rounded-xl hover:border-white/10 transition-all flex flex-col gap-2">
                        <div class="flex items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <input type="checkbox" ${t.status === 'concluido' ? 'checked' : ''} ${isBlocked ? 'disabled title="Esta tarefa está bloqueada por dependências pendentes"' : ''} onchange="window.toggleNewTaskStatus('${t.id}', this.checked)" class="w-4 h-4 rounded border-white/10 bg-black/40 text-orange-500 ${isBlocked ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer'}">
                                <span onclick="window.openTaskDetails('${t.id}')" class="text-xs font-bold transition-all ${t.status === 'concluido' ? 'text-gray-500 line-through' : 'text-white'} cursor-pointer hover:text-indigo-400">
                                    ${t.title} ${depStr} ${revStr}
                                </span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-[9px] text-gray-500 font-bold">${assigneeName}</span>
                                <span class="px-2 py-0.5 rounded bg-white/5 text-[9px] text-gray-400 font-mono">${t.estimatedMinutes || 0}m</span>
                            </div>
                        </div>
                    `;
                    if (t.subTasks && t.subTasks.length > 0) {
                        html += `<div class="pl-6 border-l border-white/5 space-y-2 mt-1">`;
                        t.subTasks.forEach(st => {
                            html += `
                            <div class="flex items-center justify-between text-[11px]">
                                <div class="flex items-center gap-2">
                                    <input type="checkbox" ${st.status === 'concluido' ? 'checked' : ''} onchange="window.toggleNewTaskStatus('${st.id}', this.checked)" class="w-3.5 h-3.5 rounded border-white/10 bg-black/40 text-orange-500 cursor-pointer">
                                    <span onclick="window.openTaskDetails('${st.id}')" class="cursor-pointer ${st.status === 'concluido' ? 'text-gray-600 line-through' : 'text-gray-300'}">${st.title}</span>
                                </div>
                            </div>
                            `;
                        });
                        html += `</div>`;
                    }
                    html += `</div>`;
                });
            } else {
                html += `<p class="text-xs text-gray-500 italic">Nenhuma tarefa neste marco.</p>`;
            }
            html += `</div></div>`;
        });
        container.innerHTML = html;
    }

    function renderKanbanView() {
        const board = document.getElementById('task-kanban-board');
        if (!board) return;

        const columns = [
            { id: 'a_fazer', title: 'A Fazer', color: 'border-blue-500/30 text-blue-400 bg-blue-500/5' },
            { id: 'em_modelagem', title: 'Em Modelagem', color: 'border-yellow-500/30 text-yellow-400 bg-yellow-500/5' },
            { id: 'renderizando', title: 'Renderizando', color: 'border-purple-500/30 text-purple-400 bg-purple-500/5' },
            { id: 'em_revisao', title: 'Em Revisão', color: 'border-orange-500/30 text-orange-400 bg-orange-500/5' },
            { id: 'concluido', title: 'Concluído', color: 'border-emerald-500/30 text-emerald-400 bg-emerald-500/5' }
        ];

        const allTasks = [];
        projectMilestonesData.forEach(m => {
            if (m.tasks) {
                m.tasks.forEach(t => {
                    allTasks.push(t);
                });
            }
        });

        board.innerHTML = columns.map(col => {
            const colTasks = allTasks.filter(t => t.status === col.id);
            const taskCards = colTasks.map(t => {
                const assigneeName = t.assignee ? t.assignee.name : 'Sem responsável';
                const pendingDeps = (t.dependencies || []).filter(dep => dep.status !== 'concluido');
                const isBlocked = pendingDeps.length > 0;
                const depStr = isBlocked ? `<span class="px-1 py-0.5 rounded bg-red-500/10 text-red-500 text-[8px] font-bold inline-flex items-center gap-0.5"><span class="material-symbols-outlined text-[9px]">lock</span> Bloqueada</span>` : '';
                const revStr = t.revisionRound > 0 ? `<span class="px-1.5 py-0.5 rounded bg-orange-500/10 text-orange-500 text-[8px] font-bold">🔄 Rev ${t.revisionRound}</span>` : '';
                const cardStyle = isBlocked ? 'border-red-500/20 bg-red-500/[0.01]' : 'border-white/5 bg-white/2';
                return `
                    <div onclick="window.openTaskDetails('${t.id}')" class="p-3 ${cardStyle} border rounded-xl hover:border-white/10 transition-all cursor-pointer space-y-2 text-left">
                        <p class="text-xs font-bold text-white leading-tight">${t.title} ${depStr} ${revStr}</p>
                        <div class="flex items-center justify-between pt-1">
                            <span class="text-[9px] text-gray-500 font-bold">${assigneeName}</span>
                            <span class="text-[9px] text-gray-400 font-mono">${t.estimatedMinutes || 0}m</span>
                        </div>
                    </div>
                `;
            }).join('');

            return `
                <div class="flex-1 min-w-[200px] max-w-[280px] p-4 bg-white/[0.01] border border-white/5 rounded-2xl flex flex-col gap-4">
                    <div class="flex items-center justify-between border-b border-white/5 pb-2">
                        <h5 class="text-[10px] font-black uppercase tracking-wider ${col.color.split(' ')[1]}">${col.title}</h5>
                        <span class="px-2 py-0.5 bg-white/5 rounded-full text-[9px] text-gray-400 font-bold">${colTasks.length}</span>
                    </div>
                    <div class="space-y-3 flex-1 overflow-y-auto" style="max-height: 35vh;">
                        ${taskCards || `<p class="text-[10px] text-gray-600 italic text-center py-4">Nenhuma tarefa</p>`}
                    </div>
                </div>
            `;
        }).join('');
    }

    function renderGanttView() {
        const gantt = document.getElementById('task-gantt-chart');
        if (!gantt) return;

        const tasks = [];
        projectMilestonesData.forEach(m => {
            if (m.tasks) {
                m.tasks.forEach(t => {
                    tasks.push(t);
                });
            }
        });

        if (tasks.length === 0) {
            gantt.innerHTML = `<p class="text-xs text-gray-500 italic text-center py-4">Nenhuma tarefa cadastrada.</p>`;
            return;
        }

        let html = `
        <div class="space-y-4 text-left">
            <div class="grid grid-cols-12 gap-4 border-b border-white/5 pb-2 text-[9px] font-black text-gray-500 uppercase tracking-widest">
                <div class="col-span-5">Tarefa</div>
                <div class="col-span-3">Status</div>
                <div class="col-span-4 text-right">Progresso Tempo (Gasto / Est)</div>
            </div>
            <div class="space-y-2">
        `;

        tasks.forEach(t => {
            const percent = t.estimatedMinutes > 0 ? Math.min(100, Math.round((t.spentMinutes / t.estimatedMinutes) * 100)) : 0;
            const isOver = t.spentMinutes > t.estimatedMinutes;
            const barColor = isOver ? 'bg-red-500' : 'bg-indigo-500';
            const pendingDeps = (t.dependencies || []).filter(dep => dep.status !== 'concluido');
            const isBlocked = pendingDeps.length > 0;
            const depBadge = isBlocked ? `<span class="ml-1 px-1.5 py-0.5 rounded bg-red-500/10 text-red-500 text-[8px] font-bold inline-flex items-center gap-0.5"><span class="material-symbols-outlined text-[9px]">lock</span> Bloqueada</span>` : '';
            
            html += `
            <div onclick="window.openTaskDetails('${t.id}')" class="grid grid-cols-12 gap-4 items-center p-3 ${isBlocked ? 'bg-red-500/[0.01] border-red-500/20' : 'bg-white/2 border-white/5'} border rounded-xl hover:border-white/10 transition-all cursor-pointer">
                <div class="col-span-5">
                    <p class="text-xs font-bold text-white truncate">${t.title} ${depBadge}</p>
                    <span class="text-[9px] text-gray-500 font-bold">${t.assignee ? t.assignee.name : 'Sem responsável'}</span>
                </div>
                <div class="col-span-3">
                    <span class="px-2 py-0.5 bg-white/5 text-[9px] font-bold text-gray-400 rounded-full uppercase">${t.status.replace('_',' ')}</span>
                </div>
                <div class="col-span-4 space-y-1">
                    <div class="flex justify-between text-[8px] font-bold text-gray-500">
                        <span>${t.spentMinutes || 0}m</span>
                        <span>Estimado: ${t.estimatedMinutes || 0}m</span>
                    </div>
                    <div class="w-full h-1.5 bg-white/5 rounded-full overflow-hidden">
                        <div class="h-full ${barColor}" style="width: ${percent}%;"></div>
                    </div>
                </div>
            </div>
            `;
        });

        html += `</div></div>`;
        gantt.innerHTML = html;
    }

    function renderCalendarView() {
        const cal = document.getElementById('task-team-calendar');
        if (!cal) return;

        const tasks = [];
        projectMilestonesData.forEach(m => {
            if (m.tasks) {
                m.tasks.forEach(t => {
                    tasks.push(t);
                });
            }
        });

        let html = `
        <div class="space-y-4 text-left">
            <h4 class="text-[10px] font-black text-indigo-400 uppercase tracking-widest">Prazos e Entregas da Equipe</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        `;

        const tasksWithDeadline = tasks.filter(t => t.dueDate);
        if (tasksWithDeadline.length === 0) {
            html += `<p class="col-span-3 text-xs text-gray-500 italic text-center py-4">Nenhuma tarefa com prazo definido.</p>`;
        } else {
            tasksWithDeadline.sort((a,b) => new Date(a.dueDate) - new Date(b.dueDate)).forEach(t => {
                const dateStr = new Date(t.dueDate).toLocaleDateString('pt-BR');
                html += `
                <div onclick="window.openTaskDetails('${t.id}')" class="p-4 bg-white/2 border border-white/5 rounded-2xl hover:border-white/10 transition-all cursor-pointer space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="px-2 py-0.5 bg-white/5 rounded text-[9px] font-bold text-gray-400">${dateStr}</span>
                        <span class="px-2 py-0.5 bg-indigo-500/10 text-indigo-400 rounded text-[9px] font-bold uppercase">${t.status.replace('_',' ')}</span>
                    </div>
                    <p class="text-xs font-bold text-white leading-tight">${t.title}</p>
                    <div class="flex justify-between items-center text-[9px] text-gray-500 font-bold pt-1 border-t border-white/5">
                        <span>Responsável: ${t.assignee ? t.assignee.name : 'Sem responsável'}</span>
                        <span>Est: ${t.estimatedMinutes || 0}m</span>
                    </div>
                </div>
                `;
            });
        }

        html += `</div></div>`;
        cal.innerHTML = html;
    }

    window.toggleNewTaskStatus = async function(taskId, isChecked) {
        try {
            const res = await fetch(`/admin/api/tasks/${taskId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: isChecked ? 'concluido' : 'a_fazer' })
            });
            const data = await res.json();
            if (data.success) {
                window.showNotification?.('Status da tarefa atualizado!', 'success');
                window.loadProjectChecklist(currentProjectId);
            } else {
                alert('Erro ao atualizar status: ' + data.error);
            }
        } catch (e) {
            console.error(e);
        }
    };

    window.loadProjectChecklist = async function(projectId) {
        try {
            const res = await fetch(`/admin/api/projects/${projectId}/milestones`);
            const data = await res.json();
            if (data.success) {
                projectMilestonesData = data.milestones || [];
                renderCurrentTaskView();
                window.loadTaskTemplatesList();
            }
        } catch (error) {
            console.error(error);
            document.getElementById('project-checklist-list').innerHTML = `<div class="text-red-500 text-xs">Erro ao carregar planejamento.</div>`;
        }
    };

    window.loadTaskTemplatesList = async function() {
        try {
            const res = await fetch('/admin/api/task-templates');
            const data = await res.json();
            const dropdown = document.getElementById('dropdown-task-templates-list');
            if (dropdown && data.success && data.templates) {
                let html = `
                    <li><a class="dropdown-item rounded-xl text-[10px] font-black uppercase py-2 cursor-pointer shadow-indigo-500/20" onclick="window.applyTaskTemplate('ArchViz')">Preset ArchViz Completo</a></li>
                    <li><a class="dropdown-item rounded-xl text-[10px] font-black uppercase py-2 cursor-pointer shadow-indigo-500/20" onclick="window.applyTaskTemplate('Modelagem')">Preset Modelagem Simples</a></li>
                    <li><hr class="dropdown-divider border-white/5"></li>
                `;
                if (data.templates.length === 0) {
                    html += `<li><span class="dropdown-item text-gray-500 text-[10px] italic">Sem templates salvos</span></li>`;
                } else {
                    data.templates.forEach(t => {
                        html += `<li><a class="dropdown-item rounded-xl text-[10px] font-black uppercase py-2 cursor-pointer" onclick="window.applyTaskTemplateDb('${t.id}')">${t.name}</a></li>`;
                    });
                }
                
                html += `
                    <li><hr class="dropdown-divider border-white/5"></li>
                    <li><a class="dropdown-item rounded-xl text-[10px] font-black text-orange-500 uppercase py-2 cursor-pointer" onclick="window.saveCurrentAsTemplate()">Salvar Atual como Template</a></li>
                `;
                dropdown.innerHTML = html;
            }
        } catch (e) {
            console.error('Erro ao carregar templates:', e);
        }
    };

    window.applyTaskTemplateDb = async function(templateId) {
        if (!currentProjectId) return;
        try {
            const res = await fetch(`/admin/api/projects/${currentProjectId}/apply-template`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ templateId })
            });
            const data = await res.json();
            if (data.success) {
                window.showNotification?.('Template de planejamento aplicado!', 'success');
                window.loadProjectChecklist(currentProjectId);
            } else {
                alert('Erro ao aplicar template: ' + data.error);
            }
        } catch (e) {
            console.error(e);
        }
    };

    window.saveCurrentAsTemplate = async function() {
        if (!currentProjectId) return;
        const name = prompt('Informe o nome para o novo template:');
        if (!name) return;
        
        try {
            const res = await fetch('/admin/api/task-templates', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    name,
                    projectId: currentProjectId
                })
            });
            const data = await res.json();
            if (data.success) {
                window.showNotification?.('Template de planejamento salvo com sucesso!', 'success');
                window.loadTaskTemplatesList();
            } else {
                alert('Erro ao salvar template: ' + data.error);
            }
        } catch (e) {
            console.error(e);
        }
    };

    window.applyTaskTemplate = async function(template) {
        if (!currentProjectId) return;
        try {
            const res = await fetch(`/admin/api/projects/${currentProjectId}/tasks/template`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ template })
            });
            const data = await res.json();
            if (data.success) {
                window.showNotification(`Template ${template} aplicado!`, 'success');
                window.loadProjectChecklist(currentProjectId);
            } else {
                window.showNotification(data.message || 'Erro ao aplicar template Preset', 'error');
            }
        } catch (e) {
            window.showNotification('Erro na requisição Preset', 'error');
        }
    };

    // ==========================================
    // SEÇÃO OPERACIONAL E IA: ANOTAÇÕES INTERNAS
    // ==========================================
    window.loadProjectNotes = function(projectId) {
        const notesTimeline = document.getElementById('project-notes-timeline');
        if (!notesTimeline) return;
        
        let notes = [];
        try {
            notes = JSON.parse(localStorage.getItem(`project_notes_${projectId}`)) || [];
        } catch (e) {
            notes = [];
        }
        
        if (notes.length === 0) {
            notesTimeline.innerHTML = `
                <div class="py-6 text-center text-gray-500 text-[10px] font-bold">
                    Nenhuma nota interna anotada.
                </div>
            `;
            return;
        }
        
        notesTimeline.innerHTML = notes.map((n, idx) => `
            <div class="p-3 bg-white/2 border border-white/5 rounded-xl space-y-1.5 relative group hover:border-white/10 transition-all text-left">
                <div class="flex justify-between items-center text-[8px] font-bold">
                    <span class="text-amber-400">NOTA #${idx + 1}</span>
                    <span class="text-gray-500">${n.date}</span>
                </div>
                <p class="text-[10px] text-gray-300 leading-relaxed font-medium">${n.content}</p>
                <button type="button" onclick="deleteProjectNote(${idx})" class="absolute right-3 top-3 text-gray-600 hover:text-red-400 opacity-0 group-hover:opacity-100 transition-all cursor-pointer">
                    <span class="material-symbols-outlined text-xs">delete</span>
                </button>
            </div>
        `).join('');
    };

    window.saveProjectNote = function() {
        const input = document.getElementById('project-note-input');
        if (!input || !input.value.trim()) return;
        
        const content = input.value.trim();
        let notes = [];
        try {
            notes = JSON.parse(localStorage.getItem(`project_notes_${currentProjectId}`)) || [];
        } catch (e) {
            notes = [];
        }
        
        const newNote = {
            content,
            date: new Date().toLocaleString('pt-BR')
        };
        
        notes.unshift(newNote); // Adiciona no início
        localStorage.setItem(`project_notes_${currentProjectId}`, JSON.stringify(notes));
        input.value = '';
        window.loadProjectNotes(currentProjectId);
        window.showNotification('Nota salva internamente!', 'success');
    };

    window.deleteProjectNote = function(idx) {
        if (!confirm('Deseja realmente excluir esta nota?')) return;
        
        let notes = [];
        try {
            notes = JSON.parse(localStorage.getItem(`project_notes_${currentProjectId}`)) || [];
        } catch (e) {
            notes = [];
        }
        
        notes.splice(idx, 1);
        localStorage.setItem(`project_notes_${currentProjectId}`, JSON.stringify(notes));
        window.loadProjectNotes(currentProjectId);
        window.showNotification('Nota removida!', 'success');
    };

