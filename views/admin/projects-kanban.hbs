    window.saveProjectNote = function() {
        const input = document.getElementById('project-note-input');
        if (!input || !input.value.trim()) return;
        
        const content = input.value.trim();
        let notes = [];
        try {
            notes = JSON.parse(localStorage.getItem(`project_notes_${currentProjectId}`)) || [];
        } catch (e) {
            notes = [];
        }
        
        const newNote = {
            content,
            date: new Date().toLocaleString('pt-BR')
        };
        
        notes.unshift(newNote); // Adiciona no início
        localStorage.setItem(`project_notes_${currentProjectId}`, JSON.stringify(notes));
        input.value = '';
        window.loadProjectNotes(currentProjectId);
        window.showNotification('Nota salva internamente!', 'success');
    };

    window.deleteProjectNote = function(idx) {
        if (!confirm('Deseja realmente excluir esta nota?')) return;
        
        let notes = [];
        try {
            notes = JSON.parse(localStorage.getItem(`project_notes_${currentProjectId}`)) || [];
        } catch (e) {
            notes = [];
        }
        
        notes.splice(idx, 1);
        localStorage.setItem(`project_notes_${currentProjectId}`, JSON.stringify(notes));
        window.loadProjectNotes(currentProjectId);
        window.showNotification('Nota removida!', 'success');
    };

