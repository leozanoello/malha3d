                                   </a>`
                                : '';

                            delHtml += `
                                <div class="p-4 bg-white/2 border border-white/5 rounded-2xl flex flex-col justify-between gap-3 relative group hover:border-white/10 transition-all text-left">
                                    <div class="flex justify-between items-start gap-4">
                                        <div>
                                            <h5 class="text-xs font-bold text-white mb-1.5">${d.title}</h5>
                                            <span class="text-[8px] font-mono text-gray-500 font-bold flex items-center gap-1"><span class="material-symbols-outlined text-[10px]">calendar_today</span> Agendado: ${dateStr}</span>
                                        </div>
                                        <span class="px-2 py-0.5 rounded-full border text-[8px] font-black uppercase tracking-wider ${statusClass}">${d.status.toUpperCase()}</span>
