    window.loadProjectRevisions = function(projectId) {
        fetch(`/admin/api/projects/${projectId}/revisions`)
            .then(res => res.json())
            .then(data => {
                const revList = document.getElementById('project-revisions-list');
                if (revList && data.success) {
                    let revHtml = '';
                    if (data.revisions && data.revisions.length > 0) {
                        data.revisions.forEach(r => {
                            let statusClass = 'bg-amber-500/10 text-amber-400 border-amber-500/20';
                            if (r.status === 'aprovada' || r.status === 'concluida') {
                                statusClass = 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
                            } else if (r.status === 'rejeitada') {
                                statusClass = 'bg-red-500/10 text-red-400 border-red-500/20';
                            }
                            
                            revHtml += `
                                <div class="p-4 bg-white/2 border border-white/5 rounded-2xl flex flex-col gap-2 relative group hover:border-white/10 transition-all text-left">
                                    <div class="flex justify-between items-center">
                                        <span class="text-[8px] font-black text-indigo-400 uppercase tracking-widest">Versão ${r.version}</span>
                                        <span class="px-2 py-0.5 rounded-full border text-[8px] font-black uppercase tracking-wider ${statusClass}">${r.status.toUpperCase()}</span>
                                    </div>
                                    <p class="text-[10px] text-gray-300 leading-relaxed font-medium">${r.description}</p>
                                    <div class="flex items-center gap-4 text-[8px] text-gray-500 pt-2 border-t border-white/5 font-bold">
                                        <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[12px] text-red-400">payments</span> Impacto: R$ ${parseFloat(r.financialImpact).toFixed(2)}</span>
                                        <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[12px] text-orange-400">schedule</span> Prazo: +${r.deadlineImpact} dias</span>
                                    </div>
                                    <button type="button" onclick="deleteRevision('${r.id}')" class="absolute right-4 top-4 text-gray-500 hover:text-red-400 transition-all opacity-0 group-hover:opacity-100 cursor-pointer">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                            `;
                        });
                    } else {
                        revHtml = `
                            <div class="p-6 text-center text-gray-500 text-[10px] font-bold">
                                Nenhuma revisão registrada ainda.
                            </div>
                        `;
                    }
                    revList.innerHTML = revHtml;
                }
            });
    };

    window.deleteRevision = function(id) {
        if (!confirm('Deseja realmente excluir esta revisão?')) return;
        fetch(`/admin/api/revisions/${id}`, {
            method: 'DELETE'
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                window.showNotification('Revisão excluída!', 'success');
                window.loadProjectRevisions(currentProjectId);
            } else {
                window.showNotification('Erro ao excluir revisão', 'error');
            }
        });
    };

    // ==========================================
    // SEÇÃO OPERACIONAL E IA: ARQUIVOS DE ENTREGA
