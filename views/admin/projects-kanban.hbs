    window.toggleChecklistItem = function(id, completed) {
        let checklist = [];
        try {
            checklist = JSON.parse(localStorage.getItem(`project_checklist_${currentProjectId}`)) || [];
        } catch (e) {
            checklist = [];
        }
        
        checklist = checklist.map(item => item.id === id ? { ...item, completed } : item);
        localStorage.setItem(`project_checklist_${currentProjectId}`, JSON.stringify(checklist));
        window.loadProjectChecklist(currentProjectId);
    };

    window.deleteChecklistItem = function(id) {
        let checklist = [];
        try {
            checklist = JSON.parse(localStorage.getItem(`project_checklist_${currentProjectId}`)) || [];
        } catch (e) {
            checklist = [];
        }
        
        checklist = checklist.filter(item => item.id !== id);
        localStorage.setItem(`project_checklist_${currentProjectId}`, JSON.stringify(checklist));
        window.loadProjectChecklist(currentProjectId);
        window.showNotification('Tarefa excluída!', 'success');
    };

