<!-- 
    MALHA 3D - PIPELINE DE PRODUÇÃO ARCHVIZ 
    Refatoração de Alta Performance e Densidade de Dados (Clonagem CRM Parity)
-->

<div class="crm-wrapper animate-in fade-in duration-700">
    <!-- Header: Production Intelligence & Control -->
    <div class="mb-10 p-10 glass-card border-none bg-gradient-to-br from-white/10 to-white/[0.02] relative overflow-hidden rounded-[3rem]">
        <div class="absolute top-0 right-0 w-96 h-96 bg-indigo-500/10 blur-[120px] -mr-48 -mt-48 animate-pulse"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-indigo-500/5 blur-[100px] -ml-32 -mb-32"></div>
        
        <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-8 relative z-10">
            <div>
                <div class="flex items-center gap-4 mb-3">
                    <div class="w-12 h-12 rounded-2xl bg-indigo-500 flex items-center justify-center shadow-2xl shadow-indigo-500/40">
                        <span class="material-symbols-outlined text-white text-2xl">precision_manufacturing</span>
                    </div>
                    <div>
                        <h1 class="text-4xl font-black text-white tracking-tighter leading-none">
                            Fluxo de <span class="text-gradient-indigo">Produção</span>
                        </h1>
                        <p class="text-gray-400 font-bold text-[10px] uppercase tracking-[0.3em] mt-1">Control & Delivery Engine</p>
                    </div>
                </div>
            </div>
            
            <div class="flex flex-wrap items-center gap-4">
                <!-- Stats Summary -->
                <div class="flex gap-6 px-8 py-4 bg-black/40 rounded-3xl border border-white/5 backdrop-blur-md">
                    <div class="text-center">
                        <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-1">Ativos</p>
                        <p class="text-xl font-black text-white" id="stat-active-projects-header">{{columns.0.projects.length}}</p>
                    </div>
                    <div class="w-px h-8 bg-white/10 self-center"></div>
                    <div class="text-center">
                        <p class="text-[8px] font-black text-gray-500 uppercase tracking-widest mb-1">Eficiência</p>
                        <p class="text-xl font-black text-indigo-400">94%</p>
                    </div>
                </div>

                <button class="bg-indigo-500 hover:bg-indigo-600 text-white font-black py-4 px-10 rounded-2xl shadow-2xl shadow-indigo-500/30 transition-all flex items-center gap-3 text-[11px] uppercase tracking-[0.2em] hover:scale-[1.02] active:scale-95" id="btn-new-project">
                    <span class="material-symbols-outlined text-base">add_circle</span>
                    Novo Projeto
                </button>
            </div>
        </div>

        <!-- Sub-Navigation -->
        <div class="flex items-center gap-3 mt-12 p-2 bg-black/30 rounded-[1.5rem] w-fit border border-white/5">
            <button class="px-10 py-3.5 text-[10px] font-black uppercase tracking-[0.2em] rounded-xl transition-all flex items-center gap-2 bg-indigo-500 text-white shadow-xl shadow-indigo-500/20 tab-btn-nav active" data-tab="kanban">
                <span class="material-symbols-outlined text-sm">view_kanban</span> Pipeline
            </button>
            <button class="px-10 py-3.5 text-[10px] font-black uppercase tracking-[0.2em] rounded-xl text-gray-500 hover:text-white transition-all flex items-center gap-2 tab-btn-nav" data-tab="analytics">
                <span class="material-symbols-outlined text-sm">analytics</span> Performance
            </button>
        </div>
    </div>

    <!-- Main Content Area -->
    <div id="projects-main-content">
        <!-- View 1: KANBAN -->
        <div id="tab-kanban" class="tab-pane active flex flex-col min-h-0">
            <!-- Control Bar (Busca + Alternador de Visualizações) -->
            <div class="mb-6 flex flex-col md:flex-row gap-4 items-center justify-between p-4 glass-card bg-black/20 border-white/5 relative z-10" id="projects-control-bar">
                <!-- Search -->
                <div class="relative w-full md:w-96">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-500">
                        <span class="material-symbols-outlined text-sm">search</span>
                    </span>
                    <input type="text" id="unified-search-projects" class="w-full pl-10 pr-4 py-2.5 bg-black/40 border border-white/5 rounded-xl text-xs font-medium text-white focus:outline-none focus:border-indigo-500/50 transition-all placeholder-gray-500" placeholder="Buscar por projeto, cliente ou tipo...">
                </div>
                <!-- View Toggle -->
                <div class="flex items-center gap-1.5 bg-black/40 p-1 rounded-xl border border-white/5">
                    <button onclick="changeProjectsView('kanban')" id="btn-view-projects-kanban" class="view-toggle-btn-proj px-4 py-2 rounded-lg text-[9px] font-black uppercase tracking-widest text-indigo-400 bg-indigo-500/10 transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">view_kanban</span> Quadro
                    </button>
                    <button onclick="changeProjectsView('list')" id="btn-view-projects-list" class="view-toggle-btn-proj px-4 py-2 rounded-lg text-[9px] font-black uppercase tracking-widest text-gray-400 hover:text-white transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">list</span> Lista
                    </button>
                    <button onclick="changeProjectsView('spreadsheet')" id="btn-view-projects-spreadsheet" class="view-toggle-btn-proj px-4 py-2 rounded-lg text-[9px] font-black uppercase tracking-widest text-gray-400 hover:text-white transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">table_chart</span> Planilha
                    </button>
                </div>
            </div>

            <!-- Kanban Board -->
            <div class="flex gap-6 overflow-x-auto pb-12 min-h-[800px] scrollbar-premium px-2" id="projects-kanban-board">
                {{#each columns}}
                <div class="kanban-column w-80 flex-shrink-0 flex flex-col h-full" data-id="{{this.id}}" data-status="{{this.statusKey}}">
                    <!-- Column Header -->
                    <div class="glass-card mb-4 border-white/10 relative flex-shrink-0 min-h-[100px] flex flex-col justify-center overflow-hidden pt-5" style="border-top: 4px solid {{this.color}}">
                        <!-- Column top banner -->
                        <div class="absolute top-0 left-0 w-full h-[18px] flex items-center justify-between px-3" style="background: linear-gradient(90deg, {{this.color}}18 0%, {{this.color}}03 100%); border-bottom: 1px solid {{this.color}}12;">
                            <span class="text-[6.5px] font-black uppercase tracking-[0.25em]" style="color: {{this.color}}">Etapa do Projeto</span>
                            <span class="w-1.5 h-1.5 rounded-full" style="background-color: {{this.color}}; box-shadow: 0 0 6px {{this.color}}"></span>
                        </div>
                        <div class="p-4 flex items-center justify-between">
                            <div class="overflow-hidden flex-1">
                                <h3 class="text-xs font-black text-white uppercase tracking-widest flex items-center justify-between gap-2 pr-2 whitespace-normal line-clamp-2 break-words">
                                    {{this.name}}
                                    <span class="bg-white/5 text-gray-500 px-2 py-0.5 rounded-full text-[8px] flex-shrink-0 column-card-count">{{this.projects.length}}</span>
                                </h3>
                                <p class="text-[9px] font-bold text-gray-500 mt-1 uppercase tracking-tighter">
                                    Total: <span class="text-indigo-400 font-black">{{formatCurrency this.totalValue}}</span>
                                </p>
                            </div>
                            <div class="dropdown">
                                <button class="text-gray-600 hover:text-white transition-all" data-bs-toggle="dropdown">
                                    <span class="material-symbols-outlined">more_vert</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark glass-card border-white/10 bg-dark-950 p-2 shadow-2xl">
                                    <li><a class="dropdown-item rounded-xl text-[10px] font-black uppercase py-2 flex items-center gap-2 btn-edit-column" href="#" data-id="{{this.id}}" data-title="{{this.name}}" data-color="{{this.color}}"><span class="material-symbols-outlined text-sm">edit</span> Editar Etapa</a></li>
                                    <li><hr class="dropdown-divider border-white/5"></li>
                                    <li><a class="dropdown-item rounded-xl text-[10px] font-black uppercase py-2 flex items-center gap-2 text-red-500 btn-delete-column" href="#" data-id="{{this.id}}"><span class="material-symbols-outlined text-sm">delete</span> Excluir Etapa</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Kanban Drop Zone -->
                    <div class="kanban-drop-zone cards-list flex-1 overflow-y-auto space-y-3 px-3 mx-[-0.75rem] scrollbar-hide pb-10 min-h-[600px]" 
                         id="col-{{this.statusKey}}" 
                         data-status="{{this.statusKey}}">
                        
                        {{#each this.projects}}
                        <div class="kanban-card glass-card p-3 border-white/5 hover:border-white/20 transition-all cursor-pointer group relative hover:z-[999] overflow-visible mb-3 kanban-card-main" 
                             draggable="true" 
                             data-id="{{this.id}}"
                             style="border-left: 3px solid {{../color}}">
                            
                            <!-- Progress Bar -->
                            <div class="absolute top-0 left-0 w-full h-1 bg-white/5">
                                <div class="h-full probability-bar bg-gradient-to-r from-indigo-500 to-indigo-300" style="width: {{#if (eq this.complexity 'Alta')}}85%{{else}}{{#if (eq this.complexity 'Ultra')}}100%{{else}}{{#if (eq this.complexity 'Média')}}60%{{else}}35%{{/if}}{{/if}}{{/if}}; box-shadow: 0 0 8px #6366f1;"></div>
                            </div>
                            
                            <!-- Discrete Small Card Banner -->
                            <div class="mb-2 mt-1 px-2 py-0.5 rounded bg-white/5 border border-white/5 flex items-center justify-between text-[7px] font-black uppercase tracking-wider text-gray-400">
                                <span class="flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full" style="background-color: {{../color}}; box-shadow: 0 0 4px {{../color}};"></span>
                                    {{#if this.category}}{{this.category}}{{else}}Imagens 3D{{/if}}
                                </span>
                                <span class="font-black text-indigo-400">{{#if this.complexity}}{{this.complexity}}{{else}}Média{{/if}} Complexidade</span>
                            </div>

                            <div class="flex justify-between items-start mb-2 mt-0">
                                <div class="flex-1 overflow-hidden pr-2">
                                    <h4 class="text-xs font-black text-white leading-tight line-clamp-2 min-h-[28px] uppercase tracking-tight group-hover:text-indigo-400 transition-colors card-name">{{this.title}}</h4>
                                    <p class="text-[8px] text-gray-500 font-bold uppercase tracking-wider mt-0.5">
                                        {{this.client}} • 
                                        <span class="font-mono opacity-0 group-hover:opacity-10 transition-opacity duration-300 text-[8px] cursor-help tracking-tighter select-all">#PROJ-{{this.id}}</span>
                                    </p>
                                </div>
                                <div class="dropdown stop-propagation flex-shrink-0">
                                    <button class="text-gray-600 hover:text-white transition-all p-1 flex items-center justify-center" data-bs-toggle="dropdown" data-bs-boundary="viewport" data-bs-popper-config='{"strategy":"fixed"}'>
                                        <span class="material-symbols-outlined text-[16px]">more_vert</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-dark glass-card border-white/10 bg-dark-950 p-2 shadow-2xl">
                                        <li><a class="dropdown-item rounded-xl text-[10px] font-black uppercase py-2 flex items-center gap-2" href="#" onclick="window.openProjectDetails('{{this.id}}', false)"><span class="material-symbols-outlined text-sm">visibility</span> Ver Detalhes</a></li>
                                        <li><a class="dropdown-item rounded-xl text-[10px] font-black uppercase py-2 flex items-center gap-2" href="#" onclick="window.openProjectDetails('{{this.id}}', true)"><span class="material-symbols-outlined text-sm">edit</span> Editar Detalhes</a></li>
                                        <li><hr class="dropdown-divider border-white/5"></li>
                                        <li><a class="dropdown-item rounded-xl text-[10px] font-black uppercase py-2 flex items-center gap-2 text-red-500" href="#" onclick="window.deleteProject('{{this.id}}')"><span class="material-symbols-outlined text-sm">delete</span> Excluir Projeto</a></li>
                                    </ul>
                                </div>
                            </div>

                            <div class="flex flex-col gap-1 mb-2">
                                <div class="flex items-center justify-between pr-1">
                                    <div class="flex items-center gap-1">
                                        <span class="material-symbols-outlined text-emerald-500 text-[12px]">payments</span>
                                        <span class="text-[9px] font-black text-white" title="Valor Faturado/Contrato">R$ {{formatCurrency this.totalRevenue}} / {{formatCurrency this.price}}</span>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <span class="material-symbols-outlined text-red-500 text-[12px]">payments</span>
                                        <span class="text-[9px] font-black text-white" title="Despesas/Custos Reais">R$ {{formatCurrency this.totalExpenses}}</span>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center pr-1">
                                    <div class="flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-gray-600 text-[12px]">person</span>
                                        <span class="text-[9px] font-bold text-gray-500 uppercase tracking-wide truncate max-w-[120px]">{{this.client}}</span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-gray-600 text-[12px]">calendar_today</span>
                                        <span class="text-[9px] font-bold text-gray-500">{{formatDateShort this.deadline}}</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Technical Specs Sync & Team LZ -->
                            <div class="flex items-center justify-between pt-2 border-t border-white/5 mt-2">
                                <div class="flex flex-wrap gap-1 max-w-[200px]">
                                    {{#each this.softwareStack}}
                                    <span class="px-1.5 py-0.5 rounded bg-white/5 border border-white/10 text-[6.5px] font-black text-gray-400 uppercase tracking-widest">{{this}}</span>
                                    {{/each}}
                                    {{#if this.renderEngine}}
                                    <span class="px-1.5 py-0.5 rounded bg-indigo-500/10 border border-indigo-500/20 text-[6.5px] font-black text-indigo-400 uppercase tracking-widest">{{this.renderEngine}}</span>
                                    {{/if}}
                                </div>
                                <div class="flex -space-x-2 flex-shrink-0">
                                    {{#if this.isTrackingNow}}
                                    <div class="w-5 h-5 rounded-full bg-emerald-500 flex items-center justify-center text-[8px] font-black text-white shadow-lg shadow-emerald-500/20 animate-pulse" title="Produção Ativa Agora!">⏱️</div>
                                    {{else}}
                                    <div class="w-5 h-5 rounded-full border border-dark-950 bg-indigo-500 flex items-center justify-center text-[7px] font-black text-white shadow-lg shadow-indigo-500/20">LZ</div>
                                    {{/if}}
                                </div>
                            </div>
                        </div>
                        {{/each}}

                        {{#unless this.projects.length}}
                        <div class="kanban-empty-state border-2 border-dashed border-white/5 rounded-3xl p-6 flex flex-col items-center justify-center text-center opacity-30 mt-2">
                            <span class="material-symbols-outlined text-2xl mb-1">move_to_inbox</span>
                            <p class="text-[9px] font-black uppercase tracking-widest text-gray-500">Sem Projetos</p>
                        </div>
                        {{/unless}}
                    </div>
                </div>
                {{/each}}

                <!-- Add Column Button -->
                <div class="w-80 flex-shrink-0 text-center">
                    <button id="btn-add-column" class="w-full h-20 border-2 border-dashed border-white/10 rounded-[2rem] flex items-center justify-center gap-3 text-gray-500 hover:text-white hover:border-white/20 transition-all group">
                        <span class="material-symbols-outlined group-hover:scale-125 transition-all">add_circle</span>
                        <span class="text-[10px] font-black uppercase tracking-[0.2em]">Adicionar Etapa</span>
                    </button>
                </div>
            </div>

            <!-- List Layout for Projects -->
            <div id="view-projects-list" class="space-y-4 hidden flex-1 overflow-y-auto pb-20 scrollbar-hide">
                {{#each columns}}
                    {{#each this.projects}}
                    <div class="glass-card p-4 border-white/5 bg-white/2 hover:border-indigo-500/30 transition-all cursor-pointer flex flex-col md:flex-row md:items-center justify-between gap-4 project-item-row" onclick="window.openProjectDetails('{{this.id}}', false)" data-search="{{this.title}} {{this.client}} {{this.category}} {{this.complexity}}">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 flex items-center justify-center text-indigo-400">
                                <span class="material-symbols-outlined">precision_manufacturing</span>
                            </div>
                            <div>
                                <h4 class="text-xs font-black text-white card-name">{{this.title}}</h4>
                                <p class="text-[8px] text-gray-500 font-bold uppercase tracking-wider mt-0.5">
                                    {{this.client}} • 
                                    <span class="font-mono opacity-20 hover:opacity-100 transition-opacity duration-300 text-[8px] cursor-help tracking-tighter select-all">#PROJ-{{this.id}}</span>
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-6">
                            <div class="text-right">
                                <span class="px-2 py-0.5 rounded bg-white/5 border border-white/5 text-[8px] font-black text-gray-400 uppercase tracking-wide">
                                    {{#if this.category}}{{this.category}}{{else}}Imagens 3D{{/if}}
                                </span>
                            </div>
                            <div class="text-right">
                                <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 text-[8px] font-black uppercase tracking-wider">
                                    {{../name}}
                                </span>
                            </div>
                            <div class="text-right w-24">
                                <p class="text-[9px] font-black text-indigo-400 font-mono">{{formatCurrency this.price}}</p>
                            </div>
                            <div onclick="event.stopPropagation();" class="flex gap-2">
                                <button onclick="window.openProjectDetails('{{this.id}}', false)" class="w-8 h-8 rounded-xl bg-white/5 text-gray-400 hover:text-white flex items-center justify-center">
                                    <span class="material-symbols-outlined text-[14px]">visibility</span>
                                </button>
                                <button onclick="window.deleteProject('{{this.id}}')" class="w-8 h-8 rounded-xl bg-red-500/10 text-red-400 hover:bg-red-500/20 flex items-center justify-center">
                                    <span class="material-symbols-outlined text-[14px]">delete</span>
                                </button>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                {{/each}}
            </div>

            <!-- Spreadsheet Layout for Projects -->
            <div id="view-projects-spreadsheet" class="glass-card border-white/5 bg-white/2 overflow-hidden hidden flex-1">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-white/5 bg-black/40 text-[9px] font-black text-gray-500 uppercase tracking-widest">
                                <th class="p-4">Projeto</th>
                                <th class="p-4">Cliente</th>
                                <th class="p-4">Tipo/Categoria</th>
                                <th class="p-4">Etapa</th>
                                <th class="p-4">Preço</th>
                                <th class="p-4">Prazo</th>
                                <th class="p-4 text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            {{#each columns}}
                                {{#each this.projects}}
                                <tr class="hover:bg-white/[0.02] transition-all cursor-pointer project-item-row" onclick="window.openProjectDetails('{{this.id}}', false)" data-search="{{this.title}} {{this.client}} {{this.category}} {{this.complexity}}">
                                    <td class="p-4">
                                        <span class="text-xs font-black text-white block card-name">{{this.title}}</span>
                                        <span class="font-mono opacity-20 hover:opacity-100 transition-opacity duration-300 text-[8px] cursor-help tracking-tighter select-all">#PROJ-{{this.id}}</span>
                                    </td>
                                    <td class="p-4 text-xs font-medium text-gray-400">
                                        {{this.client}}
                                    </td>
                                    <td class="p-4">
                                        <span class="px-2 py-0.5 rounded bg-white/5 border border-white/5 text-[8px] font-black text-gray-400 uppercase tracking-wide">
                                            {{#if this.category}}{{this.category}}{{else}}Imagens 3D{{/if}}
                                        </span>
                                    </td>
                                    <td class="p-4">
                                        <span class="px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 text-[8px] font-black uppercase tracking-wide">
                                            {{../name}}
                                        </span>
                                    </td>
                                    <td class="p-4 text-xs font-bold text-white font-mono">
                                        {{formatCurrency this.price}}
                                    </td>
                                    <td class="p-4 text-xs font-medium text-gray-400">
                                        {{formatDateShort this.deadline}}
                                    </td>
                                    <td class="p-4 text-right" onclick="event.stopPropagation();">
                                        <div class="flex justify-end gap-2">
                                            <button onclick="window.openProjectDetails('{{this.id}}', false)" class="w-7 h-7 rounded-xl bg-white/5 text-gray-400 hover:text-white flex items-center justify-center">
                                                <span class="material-symbols-outlined text-[14px]">visibility</span>
                                            </button>
                                            <button onclick="window.deleteProject('{{this.id}}')" class="w-7 h-7 rounded-xl bg-red-500/10 text-red-400 hover:bg-red-500/20 flex items-center justify-center">
                                                <span class="material-symbols-outlined text-[14px]">delete</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                {{/each}}
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- View 2: PERFORMANCE (Analytics) -->
        <div id="tab-analytics" class="tab-pane hidden animate-in slide-in-from-bottom-4 duration-500 p-8">
            <!-- Analytics Content (Moved from top to tab pane) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <div class="glass-card p-8 border-white/5 bg-gradient-to-br from-indigo-500/10 to-transparent rounded-[2.5rem]">
                    <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2">Projetos Ativos</p>
                    <h3 class="text-3xl font-black text-white tracking-tighter" id="stat-active-projects">--</h3>
                </div>
                <div class="glass-card p-8 border-white/5 bg-white/5 rounded-[2.5rem]">
                    <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-2">Ticket Médio Archviz</p>
                    <h3 class="text-3xl font-black text-white tracking-tighter" id="stat-avg-ticket">R$ --</h3>
                </div>
                <div class="glass-card p-8 border-white/5 bg-white/5 rounded-[2.5rem]">
                    <p class="text-[9px] font-black text-indigo-400 uppercase tracking-widest mb-2">Eficiência de Entrega</p>
                    <h3 class="text-3xl font-black text-white tracking-tighter">94%</h3>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-8 h-[400px]">
                <div class="glass-card p-8 border-white/5 flex flex-col rounded-[2.5rem]">
                    <h4 class="text-[10px] font-black text-white uppercase tracking-widest mb-6">Volume de Produção (6 Meses)</h4>
                    <div class="flex-1 bg-black/20 rounded-3xl flex items-center justify-center border border-white/5">
                        <p class="text-[10px] text-gray-600 font-black uppercase tracking-[0.2em]">Sincronizando Ativos...</p>
                    </div>
                </div>
                <div class="glass-card p-8 border-white/5 flex flex-col rounded-[2.5rem]">
                    <h4 class="text-[10px] font-black text-white uppercase tracking-widest mb-6">Distribuição por Categoria</h4>
                    <div class="flex-1 bg-black/20 rounded-3xl flex items-center justify-center border border-white/5">
                        <p class="text-[10px] text-gray-600 font-black uppercase tracking-[0.2em]">Sincronizando Ativos...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
