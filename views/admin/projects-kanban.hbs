<!-- SortableJS -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // === INITIALIZATION ===
    let currentProjectId = null;
    const kanbanLists = document.querySelectorAll('.cards-list');
    
    // Mover os modais locais para o body antes da inicialização para evitar conflitos de Stacking Context com o .crm-wrapper
    const columnModalElement = document.getElementById('columnSettingsModal');
    const projectModalElement = document.getElementById('projectDetailModal');
    const newRevisionModalElement = document.getElementById('newRevisionModal');
    const newDeliveryModalElement = document.getElementById('newDeliveryModal');
    const projectSummaryModalElement = document.getElementById('projectSummaryModal');
    
    if (columnModalElement) document.body.appendChild(columnModalElement);
    if (projectModalElement) document.body.appendChild(projectModalElement);
    if (newRevisionModalElement) document.body.appendChild(newRevisionModalElement);
    if (newDeliveryModalElement) document.body.appendChild(newDeliveryModalElement);
    if (projectSummaryModalElement) document.body.appendChild(projectSummaryModalElement);

    const columnModal = columnModalElement ? new bootstrap.Modal(columnModalElement) : null;
    const projectDetailModal = projectModalElement ? new bootstrap.Modal(projectModalElement) : null;
    const projectSummaryModal = projectSummaryModalElement ? new bootstrap.Modal(projectSummaryModalElement) : null;

    // Failsafe Modal Backdrop & State Cleanup
    document.querySelectorAll('.modal').forEach(modalEl => {
        modalEl.addEventListener('hidden.bs.modal', () => {
            if (modalEl.id === 'projectDetailModal') {
                window.history.pushState(null, '', window.location.pathname);
            }
            if (!document.querySelector('.modal.show')) {
                document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                document.body.classList.remove('modal-open');
                document.body.style.overflow = '';
                document.body.style.paddingRight = '';
            }
        });
    });

    // === PROJECT SUMMARY MODAL LOGIC ===
    let summaryProjectId = null;
    
    function openProjectSummary(card) {
        summaryProjectId = card.dataset.id;
        
        document.getElementById('summary-project-title').innerText = card.dataset.title || '---';
        
        const statusTitle = card.dataset.statusTitle || '---';
        const statusBadge = document.getElementById('summary-project-status');
        statusBadge.innerText = statusTitle;
        
        // Estilizar o badge com a cor da coluna correspondente
        const colElement = card.closest('.kanban-column');
        if (colElement) {
            const headerElement = colElement.querySelector('.glass-card');
            if (headerElement && headerElement.style.borderTopColor) {
                statusBadge.style.borderColor = headerElement.style.borderTopColor + '40';
                statusBadge.style.color = headerElement.style.borderTopColor;
                statusBadge.style.backgroundColor = headerElement.style.borderTopColor + '15';
            }
        }
        
        document.getElementById('summary-project-client').innerText = card.dataset.client || 'Nenhum cliente associado';
        
        projectSummaryModal.show();
    }

    document.getElementById('btn-summary-go-planning')?.addEventListener('click', () => {
        if (!summaryProjectId) return;
        projectSummaryModal.hide();
        
        // Passagem de ID na URL e History API
        const newUrl = window.location.pathname + '?projectId=' + summaryProjectId;
        window.history.pushState({ projectId: summaryProjectId }, '', newUrl);
        
        // Abre o planejamento completo
        openProjectDetails(summaryProjectId);
    });

    // Roteamento Inicial: se a URL tiver ?projectId=..., abre o planejamento detalhado diretamente
    const urlParams = new URLSearchParams(window.location.search);
    const initialProjectId = urlParams.get('projectId');
    if (initialProjectId) {
        setTimeout(() => {
            openProjectDetails(initialProjectId);
        }, 100);
    }

    // === NEW TRANSACTION VIA INLINE AJAX FORM ===
    const financeFormContainer = document.getElementById('project-inline-finance-form-container');
    const inlineProjectId = document.getElementById('inline-finance-project-id');
    const inlineType = document.getElementById('inline-finance-type');
    const inlineTitleType = document.getElementById('inline-finance-title-type');
    const inlineTitleIcon = document.getElementById('inline-finance-title-icon');
    const inlineStatus = document.getElementById('inline-finance-status');
    const inlineCategory = document.getElementById('inline-finance-category');

    document.getElementById('btn-project-new-receita')?.addEventListener('click', () => {
        if (!currentProjectId) return;
        inlineProjectId.value = currentProjectId;
        inlineType.value = 'receita';
        inlineTitleType.innerText = 'Receita';
        inlineTitleType.className = 'text-emerald-400';
        inlineTitleIcon.innerText = 'add_circle';
        inlineTitleIcon.className = 'material-symbols-outlined text-xl text-emerald-400';
        
        // Setup status and category options
        inlineStatus.innerHTML = `
            <option value="pendente">Pendente</option>
            <option value="recebido" selected>Recebido</option>
        `;
        
        inlineCategory.innerHTML = `
            <option value="Contrato" selected>Contrato (CRM)</option>
            <option value="Comissão">Comissão</option>
            <option value="Outro">Outro</option>
        `;

        const today = new Date().toISOString().split('T')[0];
        document.getElementById('inline-finance-due-date').value = today;
        document.getElementById('inline-finance-competence-date').value = today;

        financeFormContainer.classList.remove('hidden');
        financeFormContainer.scrollIntoView({ behavior: 'smooth' });
    });

    document.getElementById('btn-project-new-despesa')?.addEventListener('click', () => {
        if (!currentProjectId) return;
        inlineProjectId.value = currentProjectId;
        inlineType.value = 'despesa';
        inlineTitleType.innerText = 'Despesa';
        inlineTitleType.className = 'text-red-400';
        inlineTitleIcon.innerText = 'remove_circle';
        inlineTitleIcon.className = 'material-symbols-outlined text-xl text-red-400';
        
        // Setup status and category options
        inlineStatus.innerHTML = `
            <option value="pendente">Pendente</option>
            <option value="pago" selected>Pago</option>
        `;

        inlineCategory.innerHTML = `
            <option value="Freelancer" selected>Freelancer</option>
            <option value="Material">Material/Textura/Assets</option>
            <option value="Infraestrutura">Licença Software/Hardware</option>
            <option value="Comissão">Comissão de Venda</option>
            <option value="Outro">Outro</option>
        `;

        const today = new Date().toISOString().split('T')[0];
        document.getElementById('inline-finance-due-date').value = today;
        document.getElementById('inline-finance-competence-date').value = today;

        financeFormContainer.classList.remove('hidden');
        financeFormContainer.scrollIntoView({ behavior: 'smooth' });
    });

    document.getElementById('btn-project-inline-finance-cancel')?.addEventListener('click', () => {
        financeFormContainer.classList.add('hidden');
    });

    // Handle AJAX submit for the inline finance form
    document.getElementById('projectInlineFinanceForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(this).entries());
        if (data.amount) data.amount = parseFloat(data.amount);
        
        try {
            const res = await fetch('/admin/api/financeiro', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.success) {
                window.showNotification('Lançamento financeiro adicionado com sucesso!', 'success');
                financeFormContainer.classList.add('hidden');
                this.reset();
                openProjectDetails(currentProjectId);
            } else {
                window.showNotification('Erro: ' + (result.message || 'Erro desconhecido'), 'error');
            }
        } catch (err) {
            console.error(err);
            window.showNotification('Erro de rede ao salvar lançamento', 'error');
        }
    });

    // === TIME TRACKER CLICK ACTION ===
    document.getElementById('btn-modal-tracker-action')?.addEventListener('click', async function() {
        if (!currentProjectId) return;
        const isRunning = this.classList.contains('bg-red-500');
        const url = isRunning ? '/admin/api/tracker/stop' : '/admin/api/tracker/start';
        const body = isRunning ? {} : { 
            projectId: currentProjectId, 
            taskType: 'production', 
            description: `Produção 3D no projeto ID #${currentProjectId}` 
        };

        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await res.json();
            if (data.success) {
                window.showNotification(
                    isRunning ? 'Tempo de produção pausado e registrado!' : 'Tempo de produção iniciado!', 
                    'success'
                );
                openProjectDetails(currentProjectId);
            } else {
                window.showNotification('Erro: ' + (data.error || 'Erro desconhecido'), 'error');
            }
        } catch (err) {
            console.error(err);
            window.showNotification('Erro de rede ao processar timer', 'error');
        }
    });

    // === TAB SWITCHING (CRM PARITY) ===
    function switchTab(tabId, el) {
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
        const targetTab = document.getElementById(`tab-${tabId}`);
        if (targetTab) targetTab.classList.remove('hidden');
        
        document.querySelectorAll('.tab-btn-nav').forEach(btn => {
            btn.classList.remove('active', 'text-indigo-400');
            btn.classList.add('text-gray-500');
            const line = btn.querySelector('div');
            if (line) {
                line.classList.remove('w-full');
                line.classList.add('w-0');
            }
        });
        
        el.classList.add('active', 'text-indigo-400');
        el.classList.remove('text-gray-500');
        const line = el.querySelector('div');
        if (line) {
            line.classList.remove('w-0');
            line.classList.add('w-full');
        }

        // Hide/Show projects control bar based on current tab
        const ctrlBar = document.getElementById('projects-control-bar');
        if (ctrlBar) {
            if (tabId === 'kanban') {
                ctrlBar.classList.remove('hidden');
                const savedMode = localStorage.getItem('projects_view_mode') || 'kanban';
                window.changeProjectsView(savedMode);
            } else {
                ctrlBar.classList.add('hidden');
            }
        }
    }

    document.querySelectorAll('.tab-btn-nav').forEach(btn => {
        btn.addEventListener('click', function() {
            switchTab(this.dataset.tab, this);
        });
    });

    // === MODAL TAB SWITCHING ===
    document.querySelectorAll('.modal-tab-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.modal-tab-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
        });
    });

    // === KANBAN DRAG & DROP ===
    kanbanLists.forEach(list => {
        new Sortable(list, {
            group: 'production',
            animation: 250,
            ghostClass: 'sortable-ghost',
            fallbackTolerance: 4, // Ignora pequenos tremores ou cliques rápidos para não cancelar eventos
            onEnd: function(evt) {
                const projectId = evt.item.dataset.id;
                const newStatus = evt.to.dataset.status;
                
                fetch('/admin/api/projects/move', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ projectId, status: newStatus })
                }).then(res => {
                    if (res.ok) window.showNotification('Status da produção atualizado!', 'success');
                    else window.showNotification('Erro ao mover projeto', 'error');
                });
            }
        });
    });

    // === GLOBAL EVENT DELEGATION ===
    document.addEventListener('click', function(e) {
        if (e.target.closest('.stop-propagation') || e.target.closest('[data-bs-toggle="dropdown"]')) {
            return;
        }

        const card = e.target.closest('.kanban-card');
        if (card) {
            openProjectSummary(card);
            return;
        }

        const btnEditCol = e.target.closest('.btn-edit-column');
        if (btnEditCol) {
            const { id, title, color } = btnEditCol.dataset;
            document.getElementById('col-id-input').value = id;
            document.getElementById('col-title-input').value = title;
            document.getElementById('col-color-input').value = color;
            document.getElementById('color-code').innerText = color.toUpperCase();
            columnModal.show();
            return;
        }

        const btnDeleteCol = e.target.closest('.btn-delete-column');
        if (btnDeleteCol) {
            if (confirm('Excluir esta etapa de produção?')) {
                fetch(`/admin/kanban/columns/${btnDeleteCol.dataset.id}`, { method: 'DELETE' })
                    .then(() => window.location.reload());
            }
            return;
        }
    });

    // === EDIT MODE LOGIC ===
    const btnEditToggle = document.getElementById('btn-edit-toggle');
    const btnCancelEdit = document.getElementById('btn-cancel-edit');
    const editActions = document.getElementById('edit-actions');
    const projectForm = document.getElementById('projectForm');

    function toggleEditMode(enabled) {
        if (!projectForm) return;
        const inputs = projectForm.querySelectorAll('input, select, textarea');
        inputs.forEach(input => { if (input.name !== 'id') input.disabled = !enabled; });
        
        if (enabled) {
            editActions?.classList.remove('hidden');
            btnEditToggle?.classList.add('hidden');
        } else {
            editActions?.classList.add('hidden');
            btnEditToggle?.classList.remove('hidden');
        }
    }

    btnEditToggle?.addEventListener('click', () => toggleEditMode(true));
    btnCancelEdit?.addEventListener('click', () => toggleEditMode(false));

    document.getElementById('btn-copy-portal-link')?.addEventListener('click', function() {
        if (!window.currentProjectExternalToken) {
            alert('Nenhum token do portal disponível para este projeto.');
            return;
        }
        const link = `${window.location.origin}/portal/p/${window.currentProjectExternalToken}`;
        navigator.clipboard.writeText(link)
            .then(() => {
                const btn = document.getElementById('btn-copy-portal-link');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<span class="material-symbols-outlined text-sm text-emerald-400">check</span> Copiado!';
                btn.classList.remove('bg-orange-500/10', 'text-orange-400', 'border-orange-500/20');
                btn.classList.add('bg-emerald-500/10', 'text-emerald-400', 'border-emerald-500/20');
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.classList.add('bg-orange-500/10', 'text-orange-400', 'border-orange-500/20');
                    btn.classList.remove('bg-emerald-500/10', 'text-emerald-400', 'border-emerald-500/20');
                }, 2000);
            })
            .catch(err => {
                console.error('Erro ao copiar link:', err);
                alert('Erro ao copiar link do portal.');
            });
    });

    // === PROJECT DETAILS LOADER ===
    function openProjectDetails(id, startInEditMode = false) {
        currentProjectId = id;
        fetch(`/admin/api/projects/${id}`)
            .then(res => res.json())
            .then(({ project, activeTimeLog, currentUserId }) => {
                const form = document.getElementById('projectForm');
                toggleEditMode(startInEditMode);

                form.querySelector('[name="id"]').value = project.id;
                form.querySelector('[name="title"]').value = project.title || '';
                form.querySelector('[name="price"]').value = project.price || 0;
                form.querySelector('[name="deadline"]').value = project.deadline ? project.deadline.split('T')[0] : '';
                form.querySelector('[name="complexity"]').value = project.complexity || 'Média';
                form.querySelector('[name="priority"]').value = project.priority || 'media';
                form.querySelector('[name="category"]').value = project.category || 'interior';
                form.querySelector('[name="totalArea"]').value = project.totalArea || '';
                form.querySelector('[name="software"]').value = project.software || '';
                form.querySelector('[name="renderEngine"]').value = project.renderEngine || '';
                form.querySelector('[name="productionDays"]').value = project.productionDays || 0;
                
                // Planned hours and Co-responsibles mapping
                form.querySelector('[name="plannedHours"]').value = project.plannedHours || 0;
                form.querySelector('[name="extraResponsibles"]').value = project.extraResponsibles || '';

                // Novos campos sincronizados CRM
                form.querySelector('[name="notes"]').value = project.notes || '';
                form.querySelector('[name="installments"]').value = project.installments || 1;
                form.querySelector('[name="revisionsIncluded"]').value = project.revisionsIncluded || '';
                form.querySelector('[name="receivedFormat"]').value = project.receivedFormat || '';
                form.querySelector('[name="fileQuality"]').value = project.fileQuality || 'excelente';
                form.querySelector('[name="driveLink"]').value = project.driveLink || '';
                
                const formatDateLocalProj = (dStr) => {
                    if (!dStr) return '';
                    const d = new Date(dStr);
                    if (isNaN(d.getTime())) return '';
                    return new Date(d.getTime() - (d.getTimezoneOffset() * 60000)).toISOString().substring(0, 16);
                };
                form.querySelector('[name="nextActionDate"]').value = formatDateLocalProj(project.nextActionDate);
                form.querySelector('[name="nextActionNote"]').value = project.nextActionNote || '';

                const hasUrg = project.hasUrgency || false;
                form.querySelector('[name="hasUrgency"]').checked = hasUrg;
                document.getElementById('urgency-fee-container').classList.toggle('hidden', !hasUrg);
                form.querySelector('[name="urgencyFee"]').value = project.urgencyFee || 0;

                // Campos de IA (Aba 5)
                form.querySelector('[name="desiredAtmosphere"]').value = project.desiredAtmosphere || 'Fotorrealista Premium';
                form.querySelector('[name="moodboardUrl"]').value = project.moodboardUrl || '';
                form.querySelector('[name="humanizationLevel"]').value = project.humanizationLevel || 'Médio';
                form.querySelector('[name="specialElements"]').value = project.specialElements || '';

                // Mapeamento de checkboxes de Iluminação (lightingMood)
                const moods = project.lightingMood || [];
                form.querySelectorAll('[name="lightingMood"]').forEach(cb => {
                    cb.checked = moods.includes(cb.value);
                });

                // Chamar carregadores dinâmicos de sub-itens e seções
                loadProjectRevisions(id);
                loadProjectDeliveries(id);
                loadProjectChecklist(id);
                loadProjectNotes(id);

                // Ocultar container de output de IA ao abrir
                document.getElementById('ai-output-container')?.classList.add('hidden');
                document.getElementById('ai-output-box').innerHTML = '';

                // Contact & Co-responsibles Client details
                const cName = document.getElementById('client-widget-name');
                const cEmail = document.getElementById('client-widget-email');
                const cPhone = document.getElementById('client-widget-phone');
                if (project.customer) {
                    cName.innerText = project.customer.name || '---';
                    cEmail.innerText = project.customer.email || '---';
                    cPhone.innerText = project.customer.phone || '---';
                } else if (project.client) {
                    cName.innerText = project.client || '---';
                    cEmail.innerText = '---';
                    cPhone.innerText = '---';
                } else {
                    cName.innerText = 'Nenhum cliente associado';
                    cEmail.innerText = '---';
                    cPhone.innerText = '---';
                }

                // Time execution widget computation
                let totalMinutes = 0;
                if (project.timeLogs && project.timeLogs.length > 0) {
                    project.timeLogs.forEach(log => {
                        if (log.status === 'completed') {
                            totalMinutes += parseInt(log.durationMinutes) || 0;
                        }
                    });
                }
                const totalHours = parseFloat((totalMinutes / 60).toFixed(1));
                const planned = parseInt(project.plannedHours) || 0;
                const remaining = Math.max(0, planned - totalHours);
                
                document.getElementById('tracker-widget-executed').innerText = totalHours;
                document.getElementById('tracker-widget-planned').innerText = planned;
                document.getElementById('tracker-widget-planned-details').innerText = planned + 'h';
                document.getElementById('tracker-widget-executed-details').innerText = totalHours + 'h';
                document.getElementById('tracker-widget-remaining-details').innerText = remaining + 'h';
                
                const percent = planned > 0 ? Math.min(100, Math.round((totalHours / planned) * 100)) : 0;
                document.getElementById('tracker-widget-progressbar').style.width = percent + '%';

                // Timer engine active tracker check
                if (window.activeTrackerTickInterval) {
                    clearInterval(window.activeTrackerTickInterval);
                    window.activeTrackerTickInterval = null;
                }

                const trackerBtn = document.getElementById('btn-modal-tracker-action');
                const trackerTimer = document.getElementById('tracker-widget-timer');
                const trackerPulse = document.getElementById('tracker-widget-pulse');

                if (activeTimeLog) {
                    if (activeTimeLog.projectId === project.id) {
                        trackerBtn.className = "h-10 px-6 rounded-xl text-[9px] font-black uppercase tracking-widest text-white shadow-lg transition-all flex items-center gap-2 bg-red-500 shadow-red-500/20";
                        trackerBtn.innerHTML = `<span class="material-symbols-outlined text-sm animate-spin">sync</span> Parar Rastreio`;
                        trackerPulse.className = "w-2.5 h-2.5 rounded-full bg-red-500 inline-block animate-pulse";
                        
                        const startTime = new Date(activeTimeLog.startTime).getTime();
                        function tick() {
                            const now = new Date().getTime();
                            const diff = now - startTime;
                            const secs = Math.floor((diff / 1000) % 60);
                            const mins = Math.floor((diff / (1000 * 60)) % 60);
                            const hrs = Math.floor((diff / (1000 * 60 * 60)));
                            trackerTimer.innerText = 
                                String(hrs).padStart(2, '0') + ':' + 
                                String(mins).padStart(2, '0') + ':' + 
                                String(secs).padStart(2, '0');
                        }
                        tick();
                        window.activeTrackerTickInterval = setInterval(tick, 1000);
                    } else {
                        trackerBtn.className = "h-10 px-6 rounded-xl text-[9px] font-black uppercase tracking-widest text-white shadow-lg transition-all flex items-center gap-2 bg-gray-600 cursor-not-allowed";
                        trackerBtn.innerHTML = `<span class="material-symbols-outlined text-sm">lock</span> Rastreando outro`;
                        trackerBtn.disabled = true;
                        trackerPulse.className = "w-2.5 h-2.5 rounded-full bg-gray-500 inline-block";
                        trackerTimer.innerText = "Rastreando outro...";
                    }
                } else {
                    trackerBtn.className = "h-10 px-6 rounded-xl text-[9px] font-black uppercase tracking-widest text-white shadow-lg transition-all flex items-center gap-2 bg-indigo-500 shadow-indigo-500/20";
                    trackerBtn.innerHTML = `<span class="material-symbols-outlined text-sm">play_arrow</span> Iniciar Rastreio`;
                    trackerBtn.disabled = false;
                    trackerPulse.className = "w-2.5 h-2.5 rounded-full bg-gray-600 inline-block";
                    trackerTimer.innerText = "00:00:00";
                }

                // Render Logs history tab timeline
                const logsEl = document.getElementById('project-logs-timeline');
                if (logsEl) {
                    let logsHtml = '';
                    if (project.logs && project.logs.length > 0) {
                        project.logs.forEach(log => {
                            const dateStr = new Date(log.createdAt).toLocaleString('pt-BR');
                            let icon = 'info';
                            let iconClass = 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/20';
                            
                            if (log.action === 'STATUS_CHANGE') {
                                icon = 'manufacturing';
                                iconClass = 'bg-amber-500/10 text-amber-400 border border-amber-500/20';
                            } else if (log.action === 'REVISION_ADD') {
                                icon = 'history';
                                iconClass = 'bg-purple-500/10 text-purple-400 border border-purple-500/20';
                            } else if (log.action === 'DELIVERY_ADD') {
                                icon = 'package_2';
                                iconClass = 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
                            } else if (log.action === 'FINANCE_ADD') {
                                icon = 'payments';
                                iconClass = 'bg-teal-500/10 text-teal-400 border border-teal-500/20';
                            } else if (log.action === 'TIME_TRACKING') {
                                icon = 'schedule';
                                iconClass = 'bg-pink-500/10 text-pink-400 border border-pink-500/20';
                            }

                            logsHtml += `
                                <div class="flex gap-4 items-start relative group">
                                    <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 ${iconClass}">
                                        <span class="material-symbols-outlined text-base">${icon}</span>
                                    </div>
                                    <div class="flex-1 bg-white/2 border border-white/5 p-4 rounded-2xl group-hover:border-white/10 transition-all">
                                        <div class="flex justify-between items-center mb-1.5">
                                            <h5 class="text-xs font-bold text-white">${log.userName}</h5>
                                            <span class="text-[9px] font-mono text-gray-500 font-bold">${dateStr}</span>
                                        </div>
                                        <p class="text-[10px] text-gray-400 font-medium leading-relaxed">${log.details}</p>
                                    </div>
                                </div>
                            `;
                        });
                    } else {
                        logsHtml = `
                            <div class="p-8 text-center text-gray-500">
                                <span class="material-symbols-outlined text-2xl mb-1 block">analytics</span>
                                Nenhum log registrado para este projeto ainda.
                            </div>
                        `;
                    }
                    logsEl.innerHTML = logsHtml;
                }

                // Labels
                document.getElementById('drawer-id-label').innerText = `#PROJ-${String(project.id).padStart(4, '0')}`;
                document.getElementById('drawer-status-label').innerText = project.status.toUpperCase();
                document.getElementById('drawer-name').innerText = project.title;

                // Reset to proposal tab when opening modal
                const firstTabBtn = document.getElementById('proposal-tab');
                if (firstTabBtn) {
                    const tabTrigger = new bootstrap.Tab(firstTabBtn);
                    tabTrigger.show();
                }

                // Render Finance tab content
                const financeList = document.getElementById('project-finance-list');
                const revenueEl = document.getElementById('project-finance-revenue');
                const expensesEl = document.getElementById('project-finance-expenses');
                const marginEl = document.getElementById('project-finance-margin');

                let totalRevenue = 0;
                let totalExpenses = 0;
                let listHtml = '';

                if (project.transactions && project.transactions.length > 0) {
                    project.transactions.forEach(t => {
                        const amt = parseFloat(t.amount) || 0;
                        if (t.type === 'receita') {
                            totalRevenue += amt;
                        } else if (t.type === 'despesa') {
                            totalExpenses += amt;
                        }

                        const typeIcon = t.type === 'receita' 
                            ? '<span class="material-symbols-outlined text-emerald-500 text-sm">add_circle</span>' 
                            : '<span class="material-symbols-outlined text-red-500 text-sm">remove_circle</span>';
                        
                        const typeText = t.type === 'receita' ? 'Receita' : 'Despesa';
                        
                        const statusClass = t.status === 'pago' || t.status === 'recebido'
                            ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'
                            : 'bg-amber-500/10 text-amber-400 border-amber-500/20';
                        
                        const statusText = t.status === 'pago' || t.status === 'recebido' ? 'Pago' : 'Pendente';

                        const formattedAmount = 'R$ ' + amt.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        const compDate = t.competenceDate ? new Date(t.competenceDate).toLocaleDateString('pt-BR') : (t.dueDate ? new Date(t.dueDate).toLocaleDateString('pt-BR') : '---');

                        listHtml += `
                            <tr class="hover:bg-white/[0.01]">
                                <td class="p-4 font-bold text-white">${t.description}</td>
                                <td class="p-4"><span class="flex items-center gap-1">${typeIcon} ${typeText}</span></td>
                                <td class="p-4 font-mono font-bold ${t.type === 'receita' ? 'text-emerald-400' : 'text-red-400'}">${formattedAmount}</td>
                                <td class="p-4 text-gray-500 font-medium">${compDate}</td>
                                <td class="p-4">
                                    <span class="px-2 py-0.5 rounded-full border text-[8px] font-black uppercase tracking-wider ${statusClass}">
                                        ${statusText}
                                    </span>
                                </td>
                            </tr>
                        `;
                    });
                } else {
                    listHtml = `
                        <tr>
                            <td colspan="5" class="p-8 text-center text-gray-500">
                                <span class="material-symbols-outlined text-2xl mb-1 block">payments</span>
                                Nenhuma transação vinculada a este projeto.
                            </td>
                        </tr>
                    `;
                }

                if (financeList) financeList.innerHTML = listHtml;
                if (revenueEl) revenueEl.innerText = 'R$ ' + totalRevenue.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                if (expensesEl) expensesEl.innerText = 'R$ ' + totalExpenses.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                
                const margin = totalRevenue - totalExpenses;
                const marginPercent = totalRevenue > 0 ? Math.round((margin / totalRevenue) * 100) : 0;
                if (marginEl) {
                    marginEl.innerText = 'R$ ' + margin.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ` (${marginPercent}%)`;
                    if (margin >= 0) {
                        marginEl.className = "text-xl font-black text-emerald-400 tracking-tighter";
                    } else {
                        marginEl.className = "text-xl font-black text-red-400 tracking-tighter";
                    }
                }

                window.currentProjectExternalToken = project.externalToken;
                projectDetailModal.show();
            });
    }

