    window.generateAIRenderPrompt = function() {
        const title = document.querySelector('#projectForm [name="title"]').value;
        const category = document.querySelector('#projectForm [name="category"]').value;
        const style = document.querySelector('#projectForm [name="desiredAtmosphere"]').value || 'Fotorrealista Premium';
        const elements = document.querySelector('#projectForm [name="specialElements"]').value || '';
        const lighting = Array.from(document.querySelectorAll('#projectForm [name="lightingMood"]:checked')).map(cb => cb.value).join(', ') || 'Iluminação Natural';
        const humanization = document.querySelector('#projectForm [name="humanizationLevel"]').value || 'Médio';

        const outputBox = document.getElementById('ai-output-box');
        const outputContainer = document.getElementById('ai-output-container');
        if (!outputBox || !outputContainer) return;

        outputContainer.classList.remove('hidden');
        outputBox.innerHTML = '';
        
        const prompt = `**PROMPT DE RENDER DE IA GERADO:**\n\n` + 
            `*"Hyper-realistic 3D architectural visualization of ${title || 'Luxury Space'}, ${category} design, designed in an exquisite ${style} aesthetic. ` +
            `The atmosphere is defined by ${lighting} lighting mood. The scene features ${elements || 'premium architectural design and minimal luxury styling'}. ` +
            `Humanized with ${humanization} details, high-end materials, wood, marble, concrete, glass, foliage, cinematic composition, shot on 35mm lens, f/1.8, photorealistic, Unreal Engine 5 render, highly detailed, 8k resolution, octane render, moodboard matched. --ar 16:9 --v 6.0"*`;

        typeWriterEffect(outputBox, prompt);
    };

    window.generateAIRiskAnalysis = function() {
        const title = document.querySelector('#projectForm [name="title"]').value;
        const complexity = document.querySelector('#projectForm [name="complexity"]').value || 'Média';
        const urgency = document.querySelector('#projectForm [name="hasUrgency"]').checked;
        const plannedHours = parseInt(document.querySelector('#projectForm [name="plannedHours"]').value) || 0;
        const executedHours = parseFloat(document.getElementById('tracker-widget-executed').innerText) || 0;
        const deadline = document.querySelector('#projectForm [name="deadline"]').value;

        const outputBox = document.getElementById('ai-output-box');
        const outputContainer = document.getElementById('ai-output-container');
        if (!outputBox || !outputContainer) return;

        outputContainer.classList.remove('hidden');
        outputBox.innerHTML = '';

        let riskLevel = 'BAIXO';
        let riskColor = 'text-emerald-400';
        let recommendations = '';

        if (urgency) {
            riskLevel = 'MUITO ALTO (Urgente)';
            riskColor = 'text-red-500';
            recommendations = '- Recomenda-se alocação imediata de equipe de modelagem extra.\n- Congelar novas revisões com o cliente até a primeira entrega.\n- Utilizar motor de render D5 para otimização de tempo.';
        } else if (executedHours > plannedHours * 0.8) {
            riskLevel = 'ALTO (Estouro de Horas)';
            riskColor = 'text-rose-400';
            recommendations = '- Estouro iminente do orçamento de horas de produção.\n- Limitar reuniões de alinhamento desnecessárias.\n- Otimizar etapas finais de renderização e pós-produção.';
        } else {
            riskLevel = 'BAIXO (Dentro do planejado)';
            riskColor = 'text-emerald-400';
            recommendations = '- Manter o ritmo de produção atual.\n- Registrar feedbacks e logs de progresso diariamente.';
        }

        let deadlineStr = 'Não definido';
        if (deadline) {
            const daysLeft = Math.ceil((new Date(deadline) - new Date()) / (1000 * 60 * 60 * 24));
            deadlineStr = `${new Date(deadline).toLocaleDateString('pt-BR')} (${daysLeft} dias restantes)`;
        }

        const analysis = `**ANÁLISE DE RISO OPERACIONAL INTELIGENTE (AI):**\n\n` +
            `• **Projeto:** ${title || 'Projeto Atual'}\n` +
            `• **Complexidade:** ${complexity}\n` +
            `• **Nível de Risco:** <span class="font-black ${riskColor}">${riskLevel}</span>\n` +
            `• **Cronograma de Horas:** ${executedHours}h executadas de ${plannedHours}h estimadas.\n` +
            `• **Prazo Final:** ${deadlineStr}\n\n` +
            `**RECOMENDAÇÕES ESTRATÉGICAS:**\n${recommendations}`;

        outputBox.innerHTML = analysis; 
    };

    window.copyAIPrompt = function() {
        const text = document.getElementById('ai-output-box').innerText;
        if (!text) return;
        navigator.clipboard.writeText(text).then(() => {
            window.showNotification('Copiado para a área de transferência!', 'success');
        });
    };

    function typeWriterEffect(element, text, speed = 8) {
        let i = 0;
        element.innerHTML = '';
        function type() {
            if (i < text.length) {
                if (text.charAt(i) === '\n') {
                    element.innerHTML += '<br>';
                } else {
                    element.innerHTML += text.charAt(i);
                }
                i++;
                setTimeout(type, speed);
            }
        }
        type();
    }

    // === SUBMIT REVISÃO FORM ===
    const revisionModal = new bootstrap.Modal(document.getElementById('newRevisionModal'));
    const btnNewRev = document.getElementById('btn-new-revision');
    if (btnNewRev) {
        btnNewRev.addEventListener('click', () => {
            document.getElementById('newRevisionForm').reset();
            revisionModal.show();
        });
    }

    document.getElementById('newRevisionForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(this).entries());
        if (data.financialImpact) data.financialImpact = parseFloat(data.financialImpact);
        if (data.deadlineImpact) data.deadlineImpact = parseInt(data.deadlineImpact);
        if (data.version) data.version = parseInt(data.version);

        const res = await fetch(`/admin/api/projects/${currentProjectId}/revisions`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) {
            window.showNotification('Revisão registrada com sucesso!', 'success');
            revisionModal.hide();
            window.loadProjectRevisions(currentProjectId);
        } else {
            window.showNotification('Erro ao registrar revisão', 'error');
        }
    });

    // === SUBMIT ENTREGA FORM ===
    const deliveryModal = new bootstrap.Modal(document.getElementById('newDeliveryModal'));
    const btnNewDel = document.getElementById('btn-new-delivery');
    if (btnNewDel) {
        btnNewDel.addEventListener('click', () => {
            document.getElementById('newDeliveryForm').reset();
            deliveryModal.show();
        });
    }

    document.getElementById('newDeliveryForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(this).entries());

        const res = await fetch(`/admin/api/projects/${currentProjectId}/deliveries`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) {
            window.showNotification('Entrega adicionada com sucesso!', 'success');
            deliveryModal.hide();
            window.loadProjectDeliveries(currentProjectId);
        } else {
            window.showNotification('Erro ao adicionar entrega', 'error');
        }
    });

    // === DELETE PROJECT LOGIC ===
    window.deleteProject = function(id) {
        if (!confirm('Deseja realmente excluir este projeto?')) return;
        
        fetch(`/admin/api/projects/${id}`, {
            method: 'DELETE'
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                window.showNotification('Projeto excluído com sucesso!', 'success');
                // Remove elements dynamically
                document.querySelectorAll(`[data-id="${id}"]`).forEach(el => {
                    el.style.transition = 'all 0.5s ease';
                    el.style.opacity = '0';
                    el.style.transform = 'scale(0.8)';
                    setTimeout(() => el.remove(), 500);
                });
                
                document.querySelectorAll(`[onclick*="${id}"]`).forEach(el => {
                    el.style.transition = 'all 0.5s ease';
                    el.style.opacity = '0';
                    el.style.transform = 'scale(0.8)';
                    setTimeout(() => el.remove(), 500);
                });

                // Update column headers counters
                document.querySelectorAll('.kanban-column').forEach(col => {
                    const countEl = col.querySelector('.column-card-count');
                    if (countEl) {
                        const cards = col.querySelectorAll('.kanban-card');
                        countEl.innerText = cards.length;
                    }
                });

                // Update active stats header
                const statHeader = document.getElementById('stat-active-projects-header');
                if (statHeader) {
                    const current = parseInt(statHeader.innerText) || 0;
                    if (current > 0) statHeader.innerText = current - 1;
                }
            } else {
                window.showNotification('Erro ao excluir projeto: ' + data.error, 'error');
            }
        })
        .catch(err => {
            console.error(err);
            window.showNotification('Erro de rede ao excluir', 'error');
        });
    };

    // === PERSISTENT LAYOUT TOGGLE ===
    window.changeProjectsView = function(mode) {
        localStorage.setItem('projects_view_mode', mode);
        
        const board = document.getElementById('projects-kanban-board');
        const list = document.getElementById('view-projects-list');
        const spreadsheet = document.getElementById('view-projects-spreadsheet');
        
        if (board) board.classList.add('hidden');
        if (list) list.classList.add('hidden');
        if (spreadsheet) spreadsheet.classList.add('hidden');
        
        document.querySelectorAll('.view-toggle-btn-proj').forEach(btn => {
            btn.classList.remove('text-indigo-400', 'bg-indigo-500/10');
            btn.classList.add('text-gray-400');
        });
        
        if (mode === 'kanban' && board) board.classList.remove('hidden');
        if (mode === 'list' && list) list.classList.remove('hidden');
        if (mode === 'spreadsheet' && spreadsheet) spreadsheet.classList.remove('hidden');
        
        const targetBtn = document.getElementById('btn-view-projects-' + mode);
        if (targetBtn) {
            targetBtn.classList.remove('text-gray-400');
            targetBtn.classList.add('text-indigo-400', 'bg-indigo-500/10');
        }
    };

    // Initialize layout mode
    const savedMode = localStorage.getItem('projects_view_mode') || 'kanban';
    window.changeProjectsView(savedMode);

    // === LIVE SEARCH LOGIC ===
    const searchInput = document.getElementById('unified-search-projects');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const query = this.value.toLowerCase().trim();
            
            // Filter Kanban cards
            document.querySelectorAll('#projects-kanban-board .kanban-card').forEach(card => {
                const nameEl = card.querySelector('.card-name');
                if (!nameEl) return;
                const text = card.textContent.toLowerCase();
                if (text.includes(query)) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
            
            // Filter list rows
            document.querySelectorAll('#view-projects-list .project-item-row').forEach(row => {
                const text = row.getAttribute('data-search').toLowerCase();
                if (text.includes(query)) {
                    row.classList.remove('hidden');
                } else {
                    row.classList.add('hidden');
                }
            });
            
            // Filter spreadsheet rows
            document.querySelectorAll('#view-projects-spreadsheet tbody tr').forEach(row => {
                const text = row.getAttribute('data-search').toLowerCase();
                if (text.includes(query)) {
                    row.classList.remove('hidden');
                } else {
                    row.classList.add('hidden');
                }
            });
        });
    }

    // === FORM SUBMISSION ===
    projectForm?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(this).entries());
        
        // Coleta de arrays de checkboxes (como lightingMood)
        data.lightingMood = Array.from(this.querySelectorAll('[name="lightingMood"]:checked')).map(cb => cb.value);
        // Garantir valor booleano para urgência
        data.hasUrgency = this.querySelector('[name="hasUrgency"]').checked;

        const response = await fetch(`/admin/api/projects/${data.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (response.ok) {
            window.showNotification('Projeto atualizado!', 'success');
            setTimeout(() => window.location.reload(), 800);
        } else {
            const res = await response.json();
            window.showNotification('Erro ao atualizar: ' + (res.error || 'Erro desconhecido'), 'error');
        }
    });

    document.getElementById('btn-add-column')?.addEventListener('click', () => {
        document.getElementById('col-id-input').value = '';
        document.getElementById('col-title-input').value = '';
        columnModal.show();
    });

    document.getElementById('columnForm')?.addEventListener('submit', function(e) {
        e.preventDefault();
        const id = document.getElementById('col-id-input').value;
        const data = Object.fromEntries(new FormData(this).entries());
        const method = id ? 'PUT' : 'POST';
        const url = id ? `/admin/kanban/columns/${id}` : '/admin/kanban/columns';
        
        fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...data, type: 'project' })
        }).then(() => window.location.reload());
    });

    document.getElementById('btn-new-project')?.addEventListener('click', () => {
        window.location.href = '/admin/projetos/criar';
    });
});
</script>
