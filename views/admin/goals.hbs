    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
            <div class="flex items-center gap-3 mb-6">
                <span class="w-3 h-3 bg-orange-500 rounded-full animate-ping"></span>
                <span class="text-[10px] font-black text-orange-500 uppercase tracking-[0.3em]">Meta de Faturamento Mensal</span>
            </div>
            <h2 class="text-6xl font-black text-white tracking-tighter mb-4 leading-none">R$ <span class="text-gradient">50.000,00</span></h2>
