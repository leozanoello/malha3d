            <div class="glass-card p-8 border-white/5 bg-white/[0.02] hover:border-blue-500/30 transition-all group/stat">
                <p class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-3">Ticket Médio</p>
                <h4 class="text-3xl font-black text-white tracking-tight group-hover/stat:text-blue-400 transition-colors">R$ 2.450</h4>
