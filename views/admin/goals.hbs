<!-- Header -->
<div class="mb-10 p-8 glass-card border-none bg-gradient-to-br from-white/5 to-white/[0.02]">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h1 class="text-4xl font-black text-white tracking-tight mb-2">
                Metas & <span class="text-gradient">KPIs Estratégicos</span>
            </h1>
            <p class="text-gray-400 font-medium">
                Acompanhe o progresso dos seus objetivos de curto e longo prazo no ecossistema <span class="text-orange-500">Malha3D</span>.
            </p>
        </div>
        <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-8 rounded-2xl shadow-2xl shadow-orange-500/40 transition-all flex items-center gap-3 transform active:scale-95">
