// Print budget
function printBudget() {
    window.print();
}

// Export budget
function exportBudget() {
    window.open(`/admin/orcamentos/{{budget.id}}/exportar`, '_blank');
}

// Delete budget
function deleteBudget() {
    if (confirm('Tem certeza que deseja excluir este orçamento? Esta ação não pode ser desfeita.')) {
        fetch(`/admin/orcamentos/{{budget.id}}`, {
            method: 'DELETE'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showNotification(data.message, 'success');
                setTimeout(() => {
                    window.location.href = '/admin/orcamentos';
                }, 1000);
            } else {
                showNotification(data.message, 'error');
            }
        })
        .catch(error => {
            console.error('Error deleting budget:', error);
            showNotification('Erro ao excluir orçamento', 'error');
        });
    }
}

// Add loading states to all buttons
function addLoadingState(button) {
    const originalText = button.innerHTML;
    button.disabled = true;
    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processando...';
    
    return function() {
        button.disabled = false;
        button.innerHTML = originalText;
    };
}

// Helper functions for Handlebars
window.getNoteTypeColor = function(type) {
    const colors = {
        note: 'primary',
        call: 'info',
        email: 'success',
        meeting: 'warning',
        reminder: 'danger'
    };
    return colors[type] || 'secondary';
};

window.getNoteTypeIcon = function(type) {
    const icons = {
        note: 'fa-sticky-note',
        call: 'fa-phone',
        email: 'fa-envelope',
        meeting: 'fa-users',
        reminder: 'fa-bell'
    };
    return icons[type] || 'fa-circle';
};

window.getStatusColor = function(status) {
    const colors = {
        pending: 'warning',
        approved: 'success',
        rejected: 'danger'
    };
    return colors[status] || 'secondary';
};

window.getStatusLabel = function(status) {
    const labels = {
        pending: 'Pendente',
        approved: 'Aprovado',
        rejected: 'Rejeitado'
    };
    return labels[status] || status;
};
</script>
