<style>
.kcard-panel {
 background: rgba(255, 255, 255, 0.02);
 backdrop-filter: blur(10px);
 border-radius: 16px;
 transition: all 0.3s ease;
}
.hover-border-orange:hover {
 border-color: rgba(249, 115, 22, 0.3) !important;
 background: rgba(255, 255, 255, 0.04);
 transform: translateY(-5px);
}
.shadow-orange {
 box-shadow: 0 10px 40px -10px rgba(249, 115, 22, 0.2);
}
.btn-orange {
 background: #f97316;
 color: white;
 border: none;
}
.btn-orange:hover {
 background: #ea580c;
 color: white;
}
.fw-black { font-weight: 900; }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
 const btnMensal = document.getElementById('btn-mensal');
 const btnAnual = document.getElementById('btn-anual');
 
 if (btnMensal && btnAnual) {
 const priceElements = document.querySelectorAll('[data-monthly]');
 
 btnMensal.addEventListener('click', () => {
 btnMensal.classList.add('active', 'btn-dark');
 btnMensal.classList.remove('btn-transparent', 'text-muted');
 
 btnAnual.classList.remove('active', 'btn-dark');
 btnAnual.classList.add('btn-transparent', 'text-muted');
 
 priceElements.forEach(el => {
 el.textContent = el.getAttribute('data-monthly');
 const subtext = el.nextElementSibling;
 if (subtext && subtext.classList.contains('price-period')) {
 subtext.textContent = '/mês';
 }
 });
 });
 
 btnAnual.addEventListener('click', () => {
 btnAnual.classList.add('active', 'btn-dark');
 btnAnual.classList.remove('btn-transparent', 'text-muted');
 
 btnMensal.classList.remove('active', 'btn-dark');
 btnMensal.classList.add('btn-transparent', 'text-muted');
 
 priceElements.forEach(el => {
 el.textContent = el.getAttribute('data-yearly');
 const subtext = el.nextElementSibling;
 if (subtext && subtext.classList.contains('price-period')) {
 subtext.textContent = '/mês (faturado anualmente)';
 }
 });
 });
 }
});
</script>
