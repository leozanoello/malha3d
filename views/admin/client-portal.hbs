<script>
document.addEventListener('DOMContentLoaded', function() {
 // Beautiful Success Toast Notification System
 function showToast(message, type = 'success') {
 const container = document.getElementById('toast-container');
 if (!container) return;
 
 const toast = document.createElement('div');
 toast.className = `flex items-center gap-3 px-6 py-4 rounded-2xl border shadow-2xl transition-all duration-300 pointer-events-auto transform translate-y-2 opacity-0 ${
 type === 'success' 
 ? 'bg-emerald-950/90 border-emerald-500/30 text-emerald-400' 
 : 'bg-red-950/90 border-red-500/30 text-red-400'
 }`;
 
 const icon = type === 'success' ? 'check_circle' : 'error';
 toast.innerHTML = `
 <span class="material-symbols-outlined text-lg">${icon}</span>
 <span class="text-[11px] font-black uppercase tracking-wider text-white">${message}</span>
 `;
 
 container.appendChild(toast);
 
 // Force reflow and animate
 setTimeout(() => {
 toast.classList.remove('translate-y-2', 'opacity-0');
 }, 10);

 // Auto remove
 setTimeout(() => {
 toast.classList.add('translate-y-2', 'opacity-0');
 setTimeout(() => toast.remove(), 300);
 }, 4000);
 }

 // Modal Instance
 const modalEl = document.getElementById('globalSettingsModal');
 let settingsModal = null;
 if (modalEl && typeof bootstrap !== 'undefined') {
 settingsModal = new bootstrap.Modal(modalEl);
 }

 // Toggle watermark container details dynamically
 const watermarkToggle = document.getElementById('setting-watermark-enabled');
 const watermarkDetails = document.getElementById('watermark-details-container');
 const opacitySlider = document.getElementById('setting-watermark-opacity');
 const opacityVal = document.getElementById('watermark-opacity-val');

 if (watermarkToggle && watermarkDetails) {
 watermarkToggle.addEventListener('change', function() {
 if (this.checked) {
 watermarkDetails.style.opacity = '1';
 watermarkDetails.style.pointerEvents = 'auto';
 } else {
 watermarkDetails.style.opacity = '0.3';
 watermarkDetails.style.pointerEvents = 'none';
 }
 });
 }

 if (opacitySlider && opacityVal) {
 opacitySlider.addEventListener('input', function() {
 opacityVal.innerText = this.value;
 });
 }

 // Load Global Settings from server-side Handlebars values
 function loadGlobalSettings() {
 const domain = "{{cpSettings.cp_domain}}" || 'portal.malha3d.com';
 const expiry = "{{cpSettings.cp_expiry}}" || 'never';
 const watermark = "{{cpSettings.cp_watermark}}" !== 'false'; // default true
 const wmText = "{{cpSettings.cp_wm_text}}" || 'MALHA 3D - PREVIEW';
 const wmOpacity = "{{cpSettings.cp_wm_opacity}}" || '30';
 const wmPos = "{{cpSettings.cp_wm_pos}}" || 'diagonal';
 const sig = "{{cpSettings.cp_require_sig}}" !== 'false'; // default true
 const allow4k = "{{cpSettings.cp_allow_4k}}" !== 'false'; // default true
 const accent = "{{cpSettings.cp_color_accent}}" || '#ff6f00';
 const bg = "{{cpSettings.cp_color_bg}}" || '#030712';

 if (document.getElementById('setting-custom-domain')) document.getElementById('setting-custom-domain').value = domain;
 if (document.getElementById('setting-link-expiry')) document.getElementById('setting-link-expiry').value = expiry;
 if (watermarkToggle) {
 watermarkToggle.checked = watermark;
 watermarkToggle.dispatchEvent(new Event('change'));
 }
 if (document.getElementById('setting-watermark-text')) document.getElementById('setting-watermark-text').value = wmText;
 if (opacitySlider) {
 opacitySlider.value = wmOpacity;
 if (opacityVal) opacityVal.innerText = wmOpacity;
 }
 if (document.getElementById('setting-watermark-pos')) document.getElementById('setting-watermark-pos').value = wmPos;
 if (document.getElementById('setting-require-signature')) document.getElementById('setting-require-signature').checked = sig;
 if (document.getElementById('setting-allow-4k')) document.getElementById('setting-allow-4k').checked = allow4k;
 if (document.getElementById('setting-color-accent')) document.getElementById('setting-color-accent').value = accent;
 if (document.getElementById('setting-color-bg')) document.getElementById('setting-color-bg').value = bg;
 }

 // Save Global Settings to PostgreSQL DB via API
 function saveGlobalSettings() {
 const payload = {
 cp_domain: document.getElementById('setting-custom-domain')?.value || 'portal.malha3d.com',
 cp_expiry: document.getElementById('setting-link-expiry')?.value || 'never',
 cp_watermark: watermarkToggle ? watermarkToggle.checked.toString() : 'false',
 cp_wm_text: document.getElementById('setting-watermark-text')?.value || 'MALHA 3D - PREVIEW',
 cp_wm_opacity: opacitySlider ? opacitySlider.value : '30',
 cp_wm_pos: document.getElementById('setting-watermark-pos')?.value || 'diagonal',
 cp_require_sig: document.getElementById('setting-require-signature')?.checked ? 'true' : 'false',
 cp_allow_4k: document.getElementById('setting-allow-4k')?.checked ? 'true' : 'false',
 cp_color_accent: document.getElementById('setting-color-accent')?.value || '#ff6f00',
 cp_color_bg: document.getElementById('setting-color-bg')?.value || '#030712'
 };

 fetch('/admin/api/portal/settings', {
 method: 'POST',
 headers: {
 'Content-Type': 'application/json'
 },
 body: JSON.stringify(payload)
 })
 .then(response => response.json())
 .then(data => {
 if (data.success) {
 showToast('Configurações Globais do Portal salvas com sucesso!');
 if (settingsModal) settingsModal.hide();
 // Reload window to apply changes in Handlebars layout
 setTimeout(() => window.location.reload(), 1500);
 } else {
 showToast(data.error || 'Erro ao salvar configurações.', 'error');
 }
 })
 .catch(err => {
 console.error('Error saving settings:', err);
 showToast('Erro de comunicação com o servidor.', 'error');
 });
 }

 // Initial Load
 loadGlobalSettings();

 // Trigger Modal
 document.getElementById('btn-global-settings')?.addEventListener('click', () => {
 if (settingsModal) settingsModal.show();
 });

 // Save Action
 document.getElementById('btn-save-global-settings')?.addEventListener('click', () => {
 saveGlobalSettings();
 });

 // Copy Link Clipboard Action
 document.querySelectorAll('.btn-copy-portal-link').forEach(btn => {
 btn.addEventListener('click', function(e) {
 e.preventDefault();
 const id = this.getAttribute('data-id');
 const link = window.location.origin + '/portal/c/' + id;
 navigator.clipboard.writeText(link).then(() => {
 showToast('Link seguro do portal copiado!');
 }).catch(() => {
 showToast('Falha ao copiar link', 'error');
 });
 });
 });

 // Interactive switch states
 const switches = document.querySelectorAll('.form-check-input');
 switches.forEach(sw => {
 sw.addEventListener('change', function() {
 const label = this.closest('div.flex').querySelector('span').innerText;
 const status = this.checked ? 'Ativado' : 'Desativado';
 showToast(`${label}: ${status}`);
 });
 });

 // Dummy alerts for other triggers
 document.getElementById('btn-new-invite')?.addEventListener('click', () => {
 showToast('Novo convite gerado! Link seguro pronto para envio.', 'success');
 });

 document.querySelectorAll('.btn-config-perm').forEach(btn => {
 btn.addEventListener('click', () => {
 showToast('Permissões de entregas sincronizadas com o CRM.', 'success');
 });
 });

 document.querySelectorAll('.btn-toggle-vis').forEach(btn => {
 btn.addEventListener('click', function() {
 const icon = this.querySelector('span');
 if (icon.innerText === 'visibility') {
 icon.innerText = 'visibility_off';
 this.classList.add('text-red-500');
 showToast('Acesso temporariamente bloqueado para o cliente.', 'error');
 } else {
 icon.innerText = 'visibility';
 this.classList.remove('text-red-500');
 showToast('Acesso restabelecido com sucesso!', 'success');
 }
 });
 });

 // Sidebar save visual branding
 const saveBrandingBtn = document.querySelector('.glass-card button.bg-orange-500\\/10');
 if (saveBrandingBtn) {
 saveBrandingBtn.addEventListener('click', () => {
 showToast('Identidade Visual do Portal atualizada com sucesso!');
 });
 }
});
</script>
