<!-- Header -->
<div class="mb-10 p-8 glass-card border-none bg-gradient-to-br from-white/5 to-white/[0.02]">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h1 class="text-4xl font-black text-white tracking-tight mb-2">
                Gestão de <span class="text-gradient">Usuários</span>
            </h1>
            <p class="text-gray-400 font-medium">
                Controle de acessos, permissões e perfis administrativos do ecossistema <span class="text-orange-500">Malha3D</span>.
            </p>
        </div>
        <button onclick="addUser()" class="bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-8 rounded-2xl shadow-2xl shadow-orange-500/40 transition-all flex items-center gap-3">
            <span class="material-symbols-outlined">person_add</span>
            Novo Usuário
        </button>
    </div>
</div>

<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
    <div class="glass-card p-6 border-white/5 group">
        <p class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-2">Total de Membros</p>
        <h3 class="text-3xl font-black text-white group-hover:text-orange-500 transition-colors">{{totalUsers}}</h3>
    </div>
    <div class="glass-card p-6 border-white/5 group">
        <p class="text-[10px] font-black text-emerald-500 uppercase tracking-[0.2em] mb-2">Usuários Ativos</p>
        <h3 class="text-3xl font-black text-white group-hover:text-emerald-500 transition-colors">{{activeUsers}}</h3>
    </div>
    <div class="glass-card p-6 border-white/5 group">
        <p class="text-[10px] font-black text-orange-500 uppercase tracking-[0.2em] mb-2">Acesso Pendente</p>
        <h3 class="text-3xl font-black text-white group-hover:text-orange-500 transition-colors">{{inactiveUsers}}</h3>
    </div>
    <div class="glass-card p-6 border-white/5 group">
        <p class="text-[10px] font-black text-blue-500 uppercase tracking-[0.2em] mb-2">Recém Chegados</p>
        <h3 class="text-3xl font-black text-white group-hover:text-blue-500 transition-colors">{{recentUsers}}</h3>
    </div>
</div>

<!-- Users Table -->
<div class="glass-card border-white/5 overflow-hidden">
    <div class="p-8 border-b border-white/5 flex items-center justify-between bg-white/[0.01]">
        <div class="relative flex-1 max-w-md group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-lg group-focus-within:text-orange-500 transition-colors">search</span>
            <input type="text" placeholder="Buscar por nome ou email..." class="w-full bg-white/5 border border-white/10 rounded-2xl py-3 pl-12 pr-6 text-sm font-medium text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500/50 transition-all">
        </div>
        <div class="flex items-center gap-3">
            <button class="p-3 rounded-xl bg-white/5 text-gray-500 hover:text-white transition-all">
                <span class="material-symbols-outlined">filter_list</span>
            </button>
            <button class="p-3 rounded-xl bg-white/5 text-gray-500 hover:text-white transition-all">
                <span class="material-symbols-outlined">download</span>
            </button>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="bg-white/[0.02]">
                    <th class="px-8 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Usuário</th>
                    <th class="px-6 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Nível de Acesso</th>
                    <th class="px-6 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Status</th>
                    <th class="px-6 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Última Atividade</th>
                    <th class="px-8 py-5 text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] text-right">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                {{#each users}}
                <tr class="hover:bg-white/[0.03] transition-colors group">
                    <td class="px-8 py-6">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-orange-500/20 to-orange-600/20 flex items-center justify-center text-orange-500 font-black text-sm border border-orange-500/20 group-hover:scale-110 transition-transform shadow-lg shadow-orange-500/10">
                                {{#firstLetter this.name}}{{/firstLetter}}
                            </div>
                            <div>
                                <p class="text-sm font-black text-white mb-0.5 group-hover:text-orange-500 transition-colors">{{this.name}}</p>
                                <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">{{this.email}}</p>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-6">
                        <span class="px-3 py-1 bg-blue-500/10 text-blue-400 text-[9px] font-black rounded-lg uppercase tracking-wider ring-1 ring-blue-500/30">
                            {{this.role}}
                        </span>
                    </td>
                    <td class="px-6 py-6">
                        {{#if this.active}}
                        <span class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-500/10 text-emerald-500 text-[9px] font-black rounded-lg uppercase tracking-wider ring-1 ring-emerald-500/30">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]"></span>
                            Ativo
                        </span>
                        {{else}}
                        <span class="inline-flex items-center gap-2 px-3 py-1 bg-white/5 text-gray-500 text-[9px] font-black rounded-lg uppercase tracking-wider">
                            <span class="w-1.5 h-1.5 rounded-full bg-gray-600"></span>
                            Inativo
                        </span>
                        {{/if}}
                    </td>
                    <td class="px-6 py-6">
                        <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">{{this.lastLogin}}</p>
                    </td>
                    <td class="px-8 py-6 text-right">
                        <div class="flex items-center justify-end gap-3 opacity-30 group-hover:opacity-100 transition-opacity">
                            <button class="p-2 rounded-xl bg-white/5 text-gray-500 hover:text-orange-500 hover:bg-orange-500/10 transition-all">
                                <span class="material-symbols-outlined text-lg">edit</span>
                            </button>
                            <button class="p-2 rounded-xl bg-white/5 text-gray-500 hover:text-red-500 hover:bg-red-500/10 transition-all">
                                <span class="material-symbols-outlined text-lg">delete</span>
                            </button>
                        </div>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
