 </div>
 <div class="modal-footer p-5 flex justify-end gap-2" style="border-top:1px solid rgba(255,255,255,0.06);">
 <button type="button" class="px-3 py-1.5 text-[9px] font-bold text-gray-500 hover:text-white" data-bs-dismiss="modal">Cancelar</button>
 <button type="submit" class="flex items-center gap-1.5 px-4 py-2 rounded-md bg-orange-500 text-[8px] font-black uppercase tracking-wider text-white hover:bg-orange-600 transition-colors">
 <span class="material-symbols-outlined text-[11px]">calendar_month</span> Agendar
 </button>
 </div>
 </form>
 </div>
 </div>
</div>

<script>
// === CALENDAR — Event Detail + Edit + Participants + History ===
var _calendarEvents = {{{json events}}};
var _currentEventId = null;
var _currentEvent = null;

function switchEventTab(tab) {
 ['details','tasks','edit','participants','history'].forEach(function(t) {
  var content = document.getElementById('evtContent' + t.charAt(0).toUpperCase() + t.slice(1));
  var tabBtn = document.getElementById('evtTab' + t.charAt(0).toUpperCase() + t.slice(1));
  if (content) content.classList.toggle('hidden', t !== tab);
  if (tabBtn) {
   tabBtn.className = t === tab
    ? 'flex-1 py-2.5 text-[9px] font-black uppercase tracking-widest text-orange-400 border-b-2 border-orange-500'
    : 'flex-1 py-2.5 text-[9px] font-black uppercase tracking-widest text-gray-500 border-b-2 border-transparent hover:text-white';
  }
 });
 if (tab === 'history' && _currentEventId) loadEventHistory(_currentEventId);
 if (tab === 'participants' && _currentEventId) renderParticipantsEdit();
 if (tab === 'tasks' && _currentEventId) loadEventTasks(_currentEventId);
}

function openEventDetail(eventId) {
 _currentEventId = eventId;
 var ev = _calendarEvents.find(function(e) { return String(e.id) === String(eventId); });
 if (!ev) return;
 _currentEvent = ev;

 var modal = document.getElementById('eventDetailModal');
 document.getElementById('eventDetailTitle').textContent = ev.title;
 document.getElementById('eventDetailType').textContent = ev.type || 'evento';

 var start = new Date(ev.startTime);
 var end = ev.endTime ? new Date(ev.endTime) : null;
 var opts = { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' };
 document.getElementById('eventDetailTime').textContent = start.toLocaleString('pt-BR', opts) + (end ? ' → ' + end.toLocaleString('pt-BR', opts) : '');

 if (end) {
  var diff = end - start;
  var days = Math.floor(diff / 86400000);
  var hours = Math.floor((diff % 86400000) / 3600000);
  var durText = '';
  if (days > 0) durText += days + ' dia' + (days > 1 ? 's' : '');
  if (hours > 0) durText += (durText ? ' e ' : '') + hours + 'h';
  if (!durText) durText = 'Menos de 1h';
  document.getElementById('eventDetailDuration').textContent = 'Duração: ' + durText;
 } else {
  document.getElementById('eventDetailDuration').textContent = 'Duração: 1h (padrão)';
 }

 var descWrap = document.getElementById('eventDetailDescWrap');
 if (ev.description) {
  document.getElementById('eventDetailDesc').textContent = ev.description;
  descWrap.classList.remove('hidden');
 } else {
  descWrap.classList.add('hidden');
 }

 // Participantes preview
 var participantsPreview = document.getElementById('eventDetailParticipantsPreview');
 var participantsList = document.getElementById('eventParticipantsList');
 var participants = ev.participants || [];
 if (participants.length > 0) {
  participantsPreview.classList.remove('hidden');
  participantsList.innerHTML = participants.map(function(p) {
   return '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[8px] font-bold text-cyan-400" style="background:rgba(6,182,212,0.1); border:1px solid rgba(6,182,212,0.3);"><span class="material-symbols-outlined text-[9px]">person</span>' + (p.name || 'Sem nome') + '</span>';
  }).join('');
 } else {
  participantsPreview.classList.add('hidden');
 }

 // Preencher campos de edição
 document.getElementById('editEvtTitle').value = ev.title || '';
 document.getElementById('editEvtStart').value = ev.startTime ? new Date(ev.startTime).toISOString().slice(0, 16) : '';
 document.getElementById('editEvtEnd').value = ev.endTime ? new Date(ev.endTime).toISOString().slice(0, 16) : '';
 document.getElementById('editEvtType').value = ev.type || 'reuniao';
 document.getElementById('editEvtDesc').value = ev.description || '';

 // Resetar para aba Detalhes
 switchEventTab('details');

 modal.classList.remove('hidden');
 modal.style.display = 'flex';
}

// === EDIÇÃO DO EVENTO ===
document.getElementById('editEventForm')?.addEventListener('submit', async function(e) {
 e.preventDefault();
 if (!_currentEventId) return;

 var data = {
  title: document.getElementById('editEvtTitle').value,
  startTime: document.getElementById('editEvtStart').value,
  endTime: document.getElementById('editEvtEnd').value || null,
  type: document.getElementById('editEvtType').value,
  description: document.getElementById('editEvtDesc').value
 };

 try {
  var res = await fetch('/admin/api/agenda/' + _currentEventId, {
   method: 'PATCH',
   headers: { 'Content-Type': 'application/json' },
   body: JSON.stringify(data)
  });
  var json = await res.json();
  if (json.success) {
   if (window.showToast) window.showToast('✓ Evento atualizado com sucesso', 'success');
   setTimeout(function() { window.location.reload(); }, 800);
  } else {
   if (window.showToast) window.showToast('Erro: ' + (json.error || 'Desconhecido'), 'error');
  }
 } catch (err) {
  if (window.showToast) window.showToast('Erro de rede', 'error');
 }
});

// === PARTICIPANTES ===
function renderParticipantsEdit() {
 var list = document.getElementById('participantsListEdit');
 if (!list || !_currentEvent) return;
 var participants = _currentEvent.participants || [];
 if (participants.length === 0) {
  list.innerHTML = '<p class="text-[9px] text-gray-500 text-center py-3">Nenhum participante adicionado</p>';
  return;
 }
 list.innerHTML = participants.map(function(p) {
  return '<div class="flex items-center justify-between p-2 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">' +
   '<div class="flex items-center gap-2"><span class="w-6 h-6 rounded-md bg-cyan-500/20 border border-cyan-500/30 flex items-center justify-center text-[8px] font-black text-cyan-400">' + (p.name || '?')[0].toUpperCase() + '</span>' +
   '<span class="text-[9px] font-bold text-white">' + (p.name || 'Participante') + '</span>' +
   '<span class="text-[7px] text-gray-500">' + (p.role === 'freelancer' ? 'Freelancer' : 'Equipe') + '</span></div>' +
   '<button onclick="removeEventParticipant(\'' + p.id + '\')" class="w-5 h-5 rounded flex items-center justify-center text-gray-500 hover:text-red-400" style="background:rgba(255,255,255,0.05);"><span class="material-symbols-outlined text-xs">close</span></button>' +
  '</div>';
 }).join('');
}

async function addEventParticipant() {
 if (!_currentEventId) return;
 var select = document.getElementById('addParticipantSelect');
 var userId = select.value;
 if (!userId) return;
 var opt = select.options[select.selectedIndex];
 var userName = opt.getAttribute('data-name') || opt.text;
 var userRole = opt.getAttribute('data-role') || 'user';

 try {
  var res = await fetch('/admin/api/agenda/' + _currentEventId + '/participants', {
   method: 'POST',
   headers: { 'Content-Type': 'application/json' },
   body: JSON.stringify({ userId: userId, userName: userName, userRole: userRole })
  });
  var json = await res.json();
  if (json.success) {
   _currentEvent.participants = json.participants;
   renderParticipantsEdit();
   select.value = '';
   if (window.showToast) window.showToast('✓ ' + userName + ' adicionado e notificado', 'success');
  } else {
   if (window.showToast) window.showToast('Erro: ' + (json.error || 'Desconhecido'), 'error');
  }
 } catch (err) {
  if (window.showToast) window.showToast('Erro de rede', 'error');
 }
}

async function removeEventParticipant(userId) {
 if (!_currentEventId) return;
 try {
  var res = await fetch('/admin/api/agenda/' + _currentEventId + '/participants/' + userId, { method: 'DELETE' });
  var json = await res.json();
  if (json.success) {
   _currentEvent.participants = json.participants;
   renderParticipantsEdit();
   if (window.showToast) window.showToast('Participante removido', 'info');
  }
 } catch (err) {}
}

// === HISTÓRICO ===
async function loadEventHistory(eventId) {
 var list = document.getElementById('eventHistoryList');
 if (!list) return;
 list.innerHTML = '<p class="text-[9px] text-gray-500 text-center py-4">Carregando...</p>';

 try {
  var res = await fetch('/admin/api/agenda/' + eventId + '/history');
  var json = await res.json();
  if (json.success && json.history && json.history.length > 0) {
   list.innerHTML = json.history.map(function(h) {
    var date = new Date(h.date);
    var dateStr = date.toLocaleString('pt-BR', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' });
    var iconMap = { created: 'add_circle', updated: 'edit', participant_added: 'person_add', participant_removed: 'person_remove', deleted: 'delete' };
    var icon = iconMap[h.action] || 'history';
    var colorMap = { created: 'text-emerald-400', updated: 'text-orange-400', participant_added: 'text-cyan-400', participant_removed: 'text-red-400' };
    var color = colorMap[h.action] || 'text-gray-400';
    return '<div class="flex items-start gap-2 p-2 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.04);">' +
     '<span class="material-symbols-outlined text-[11px] ' + color + ' mt-0.5">' + icon + '</span>' +
     '<div class="flex-1 min-w-0">' +
      '<p class="text-[9px] font-bold text-white">' + (h.description || h.action) + '</p>' +
      '<p class="text-[7px] text-gray-500">' + (h.userName || 'Sistema') + ' • ' + dateStr + '</p>' +
     '</div>' +
    '</div>';
   }).join('');
  } else {
   list.innerHTML = '<p class="text-[9px] text-gray-500 text-center py-4">Nenhuma alteração registrada</p>';
  }
 } catch (err) {
  list.innerHTML = '<p class="text-[9px] text-red-400 text-center py-4">Erro ao carregar histórico</p>';
 }
}

// === DELETE ===
async function deleteCurrentEvent() {
 if (!_currentEventId) return;
 if (!confirm('Excluir este evento?')) return;
 try {
  var res = await fetch('/admin/api/agenda/' + _currentEventId, { method: 'DELETE' });
  var json = await res.json();
  if (json.success) { window.location.reload(); }
  else { alert('Erro: ' + (json.error || json.message)); }
 } catch(e) { alert('Erro de rede'); }
}

function filterCalendarEvents(query) {
 var q = (query || '').toLowerCase().trim();
 document.querySelectorAll('.calendar-event-badge').forEach(function(badge) {
  badge.style.display = (!q || (badge.textContent || '').toLowerCase().includes(q)) ? 'block' : 'none';
 });
}

// === TAREFAS DO EVENTO (Checklist) ===
async function loadEventTasks(eventId) {
 var list = document.getElementById('eventTasksList');
 if (!list) return;
 list.innerHTML = '<p class="text-[9px] text-gray-500 text-center py-3">Carregando...</p>';
 try {
  var res = await fetch('/admin/api/agenda/' + eventId + '/tasks');
  var json = await res.json();
  if (json.success && json.tasks && json.tasks.length > 0) {
   renderEventTasks(json.tasks);
  } else {
   list.innerHTML = '<p class="text-[9px] text-gray-500 text-center py-3">Nenhuma tarefa</p>';
  }
 } catch(e) {
  list.innerHTML = '<p class="text-[9px] text-red-400 text-center py-3">Erro ao carregar</p>';
 }
}

function renderEventTasks(tasks) {
 var list = document.getElementById('eventTasksList');
 if (!list) return;
 list.innerHTML = tasks.map(function(t) {
  var checked = t.completed ? 'checked' : '';
  var lineThrough = t.completed ? 'line-through opacity-50' : '';
  var dateStr = t.dueDate ? new Date(t.dueDate).toLocaleDateString('pt-BR') : '';
  var overdue = !t.completed && t.dueDate && new Date(t.dueDate) < new Date() ? 'text-red-400' : 'text-gray-500';
  return '<div class="flex items-center gap-2 p-2 rounded-[4px] group" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">' +
   '<input type="checkbox" ' + checked + ' onchange="toggleEventTask(\'' + t.id + '\', this.checked)" class="w-3.5 h-3.5 rounded accent-orange-500 cursor-pointer shrink-0">' +
   '<span class="flex-1 text-[9px] font-bold text-white ' + lineThrough + '">' + (t.title || '') + '</span>' +
   (dateStr ? '<span class="text-[7px] font-bold ' + overdue + ' shrink-0">' + dateStr + '</span>' : '') +
   '<button onclick="deleteEventTask(\'' + t.id + '\')" class="w-5 h-5 rounded flex items-center justify-center text-gray-600 hover:text-red-400 opacity-0 group-hover:opacity-100 transition-opacity" style="background:rgba(255,255,255,0.05);"><span class="material-symbols-outlined text-xs">close</span></button>' +
  '</div>';
 }).join('');
}

async function addEventTask() {
 if (!_currentEventId) return;
 var titleInput = document.getElementById('newEventTaskTitle');
 var dateInput = document.getElementById('newEventTaskDate');
 var title = (titleInput.value || '').trim();
 if (!title) { titleInput.focus(); return; }
 try {
  var res = await fetch('/admin/api/agenda/' + _currentEventId + '/tasks', {
   method: 'POST',
   headers: { 'Content-Type': 'application/json' },
   body: JSON.stringify({ title: title, dueDate: dateInput.value || null })
  });
  var json = await res.json();
  if (json.success) {
   titleInput.value = '';
   dateInput.value = '';
   loadEventTasks(_currentEventId);
   if (window.showToast) window.showToast('Tarefa adicionada', 'success');
  } else {
   if (window.showToast) window.showToast('Erro: ' + (json.error || 'Falha'), 'error');
  }
 } catch(e) {
  if (window.showToast) window.showToast('Erro de rede', 'error');
 }
}

async function toggleEventTask(taskId, completed) {
 try {
  await fetch('/admin/api/agenda/tasks/' + taskId, {
   method: 'PATCH',
   headers: { 'Content-Type': 'application/json' },
   body: JSON.stringify({ completed: completed })
  });
  if (_currentEventId) loadEventTasks(_currentEventId);
 } catch(e) {}
}

async function deleteEventTask(taskId) {
 try {
  await fetch('/admin/api/agenda/tasks/' + taskId, { method: 'DELETE' });
  if (_currentEventId) loadEventTasks(_currentEventId);
 } catch(e) {}
}

// Submit new event
document.getElementById('newEventForm')?.addEventListener('submit', async function(e) {
 e.preventDefault();

 // Combinar data + hora nos hidden fields
 var startDate = document.getElementById('newEvtStartDate').value;
 var startTime = document.getElementById('newEvtStartTime').value || '08:00';
 var endDate = document.getElementById('newEvtEndDate').value || startDate;
 var endTime = document.getElementById('newEvtEndTime').value;

 if (!startDate) { alert('Selecione a data de início'); return; }

 document.getElementById('newEvtStartTimeHidden').value = startDate + 'T' + startTime;
 if (endTime) {
  document.getElementById('newEvtEndTimeHidden').value = endDate + 'T' + endTime;
 } else {
  document.getElementById('newEvtEndTimeHidden').value = '';
 }

 var formData = new FormData(this);
 var data = Object.fromEntries(formData.entries());
 // Incluir participantes selecionados
 try { data.participants = JSON.parse(data.participants || '[]'); } catch(e) { data.participants = []; }
 try {
 var response = await fetch('/admin/api/agenda', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
 var result = await response.json();
 if (result.success) { window.location.reload(); }
 else { alert('Erro: ' + (result.message || result.error)); }
 } catch (error) { alert('Erro ao processar'); }
});

// === PARTICIPANTES NO MODAL "NOVO EVENTO" ===
var _newEventParticipants = [];

window.addNewEventParticipant = function() {
 var select = document.getElementById('newEventParticipantSelect');
 if (!select || !select.value) return;
 var opt = select.options[select.selectedIndex];
 var userId = select.value;
 var userName = opt.getAttribute('data-name') || opt.text;
 var userRole = opt.getAttribute('data-role') || 'user';

 // Não duplicar
 if (_newEventParticipants.find(function(p) { return p.id === userId; })) {
  select.value = '';
  return;
 }

 _newEventParticipants.push({ id: userId, name: userName, role: userRole });
 select.value = '';
 renderNewEventParticipants();
 updateNewEventParticipantsHidden();
};

window.removeNewEventParticipant = function(userId) {
 _newEventParticipants = _newEventParticipants.filter(function(p) { return p.id !== userId; });
 renderNewEventParticipants();
 updateNewEventParticipantsHidden();
};

function renderNewEventParticipants() {
 var container = document.getElementById('newEventParticipantsList');
 if (!container) return;
 if (_newEventParticipants.length === 0) {
  container.innerHTML = '';
  return;
 }
 container.innerHTML = _newEventParticipants.map(function(p) {
  return '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[8px] font-bold text-cyan-400" style="background:rgba(6,182,212,0.1); border:1px solid rgba(6,182,212,0.3);">' +
   '<span class="material-symbols-outlined text-[9px]">' + (p.role === 'freelancer' ? 'engineering' : 'person') + '</span>' +
   p.name +
   ' <button type="button" onclick="window.removeNewEventParticipant(\'' + p.id + '\')" class="text-cyan-400 hover:text-red-400 ml-0.5">&times;</button>' +
  '</span>';
 }).join('');
}

function updateNewEventParticipantsHidden() {
 var hidden = document.getElementById('newEventParticipantsHidden');
 if (hidden) hidden.value = JSON.stringify(_newEventParticipants);
}
