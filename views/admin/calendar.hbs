<!-- Agenda — Calendário Dinâmico (Google Calendar Style) -->
<div class="p-4 md:p-5 flex flex-col gap-3" style="background:#0a0c10;">

 <!-- Banner Header -->
 <div class="kcard">
 <div class="kcard-img" style="height:80px;">
 <img src="/assets/76f2442d-8a92-481f-bc04-36aed4707d00_3840w.webp" alt="Agenda ArchViz" class="w-full h-full object-cover">
 <div class="absolute inset-0 bg-gradient-to-t from-[#151515] via-[#151515]/70 to-transparent"></div>
 </div>
 <div class="kcard-body" style="padding:16px 20px;">
 <div class="flex items-center gap-1.5 flex-wrap mb-2">
 <span class="kcard-badge kcard-badge-orange">
 <span class="material-symbols-outlined text-[8px] align-middle mr-0.5">event</span> Agenda
 </span>
 <span class="kcard-badge">Produção</span>
 </div>
 <h4 class="kcard-title" style="font-size:1.1rem; white-space:normal; margin-bottom:4px;">Agenda Inteligente</h4>
 <p class="text-[9px] text-[#777] uppercase tracking-widest">Visão unificada de prazos, entregas e compromissos da equipe Malha3D</p>
 <div class="flex items-center justify-between mt-3">
 <div class="relative flex items-center">
 <span class="material-symbols-outlined absolute left-2 text-gray-500 text-[13px] pointer-events-none">search</span>
 <input type="text" id="eventSearchInput" placeholder="Buscar evento..." class="pl-7 pr-3 py-1.5 text-[9px] font-bold text-white placeholder-gray-500 focus:outline-none focus:border-orange-500/40 transition-colors w-44" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:4px;" oninput="filterCalendarEvents(this.value)">
 </div>
 <button class="flex items-center gap-1.5 px-4 py-2 rounded-md bg-orange-500 text-[8px] font-black uppercase tracking-wider text-white hover:bg-orange-600 transition-colors" data-bs-toggle="modal" data-bs-target="#newEventModal">
 <span class="material-symbols-outlined text-[11px]">add_circle</span> Novo Evento
 </button>
 </div>
 </div>
 </div>

 <!-- Calendário Principal -->
 <div class="kcard">
 <div class="kcard-body" style="padding:20px;">
 <div class="flex justify-between items-center mb-4">
 <div class="flex items-center gap-3">
 <a href="/admin/agenda?month={{prevMonth}}&year={{prevYear}}" class="w-7 h-7 flex items-center justify-center rounded-md text-gray-500 hover:text-orange-400 transition-colors" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
 <span class="material-symbols-outlined text-sm">chevron_left</span>
 </a>
 <h4 class="text-sm font-black text-white tracking-tight">{{monthLabel}} <span class="text-orange-400">{{year}}</span></h4>
 <a href="/admin/agenda?month={{nextMonth}}&year={{nextYear}}" class="w-7 h-7 flex items-center justify-center rounded-md text-gray-500 hover:text-orange-400 transition-colors" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
 <span class="material-symbols-outlined text-sm">chevron_right</span>
 </a>
 </div>
 <a href="/admin/agenda?month={{todayMonth}}&year={{todayYear}}" class="py-1.5 px-3 rounded-[4px] text-[8px] font-black uppercase tracking-wider text-gray-400 hover:text-white transition-colors" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">Hoje</a>
 </div>

 <!-- Grid do Calendário com suporte a multi-dia -->
 <div id="calendarGrid" class="grid grid-cols-7 gap-px overflow-hidden" style="border:1px solid rgba(255,255,255,0.06); border-radius:5px;">
 <!-- Weekdays Header -->
 <div class="py-3 text-center text-[8px] font-black text-gray-600 uppercase tracking-widest" style="background:rgba(255,255,255,0.02);">Dom</div>
 <div class="py-3 text-center text-[8px] font-black text-gray-600 uppercase tracking-widest" style="background:rgba(255,255,255,0.02);">Seg</div>
 <div class="py-3 text-center text-[8px] font-black text-gray-600 uppercase tracking-widest" style="background:rgba(255,255,255,0.02);">Ter</div>
 <div class="py-3 text-center text-[8px] font-black text-gray-600 uppercase tracking-widest" style="background:rgba(255,255,255,0.02);">Qua</div>
 <div class="py-3 text-center text-[8px] font-black text-gray-600 uppercase tracking-widest" style="background:rgba(255,255,255,0.02);">Qui</div>
 <div class="py-3 text-center text-[8px] font-black text-gray-600 uppercase tracking-widest" style="background:rgba(255,255,255,0.02);">Sex</div>
 <div class="py-3 text-center text-[8px] font-black text-gray-600 uppercase tracking-widest" style="background:rgba(255,255,255,0.02);">Sáb</div>

 <!-- Days -->
 {{#each weeks}}
 {{#each this}}
 <div class="relative min-h-[90px] p-1.5 calendar-day-cell {{#unless this.inMonth}}opacity-20{{/unless}}" data-date="{{this.fullDate}}" style="{{#if this.isToday}}background:rgba(249,115,22,0.05); border-left:2px solid rgba(249,115,22,0.4);{{else}}background:transparent; border-left:1px solid rgba(255,255,255,0.04);{{/if}}">
 <span class="text-[9px] font-black {{#if this.isToday}}text-orange-400{{else}}text-gray-500{{/if}}">{{this.day}}</span>
 {{#if (length this.events)}}
 <div class="mt-1 space-y-0.5">
 {{#each this.events}}
 <div class="{{this.badgeClass}} text-[7px] font-black text-white px-1.5 py-0.5 shadow-sm uppercase tracking-wider calendar-event-badge cursor-pointer truncate {{#if (and this.isStart this.isEnd)}}rounded-[3px]{{else if this.isStart}}rounded-l-[3px] -mr-1.5{{else if this.isEnd}}rounded-r-[3px] -ml-1.5{{else}}-mx-1.5{{/if}}" title="{{this.title}}{{#if (gt this.spanDays 1)}} ({{this.spanDays}} dias){{/if}}" onclick="openEventDetail('{{this.id}}')">{{#if this.isStart}}{{this.title}}{{else}}&#8203;{{/if}}</div>
 {{/each}}
 </div>
 {{/if}}
 </div>
 {{/each}}
 {{/each}}
 </div>
 </div>
 </div>

 <!-- 3 Colunas Informativas -->
 <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
 <!-- Col 1: Próximos Eventos -->
 <div class="kcard">
 <div class="kcard-body" style="padding:14px;">
 <p class="text-[8px] font-black text-orange-400 uppercase tracking-widest mb-2 flex items-center gap-1"><span class="material-symbols-outlined text-[10px]">event</span> Próximos Eventos</p>
 <div class="space-y-1.5" id="upcoming-events-list">
 {{#each upcomingEvents}}
 <div class="flex items-center gap-2 p-1.5 rounded-[4px] cursor-pointer hover:border-orange-500/30 transition-colors event-upcoming-item" data-event-id="{{this.id}}" onclick="openEventDetail('{{this.id}}')" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
 <span class="text-[7px] font-bold text-gray-500">{{formatDateShort this.startTime}}</span>
 <span class="text-[8px] font-bold text-white truncate flex-1">{{this.title}}</span>
 <span class="kcard-badge" style="font-size:6px;">{{this.type}}</span>
 </div>
 {{/each}}
 {{#unless upcomingEvents.length}}
 <p class="text-[8px] text-gray-500 text-center py-3">Nenhum evento futuro</p>
 {{/unless}}
 </div>
 </div>
 </div>

 <!-- Col 2: Quantidade por Tipo -->
 <div class="kcard">
 <div class="kcard-body" style="padding:14px;">
 <p class="text-[8px] font-black text-purple-400 uppercase tracking-widest mb-2 flex items-center gap-1"><span class="material-symbols-outlined text-[10px]">category</span> Tipo de Reunião</p>
 <div class="space-y-1.5">
 {{#each eventsByType}}
 <div class="flex items-center justify-between p-1.5 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
 <span class="text-[8px] font-bold text-gray-300 capitalize">{{this.type}}</span>
 <span class="text-[9px] font-black text-white">{{this.count}}</span>
 </div>
 {{/each}}
 {{#unless eventsByType.length}}
 <p class="text-[8px] text-gray-500 text-center py-3">Sem dados</p>
 {{/unless}}
 </div>
 </div>
 </div>

 <!-- Col 3: Frequência -->
 <div class="kcard">
 <div class="kcard-body" style="padding:14px;">
 <p class="text-[8px] font-black text-emerald-400 uppercase tracking-widest mb-2 flex items-center gap-1"><span class="material-symbols-outlined text-[10px]">bar_chart</span> Frequência</p>
 <div class="space-y-2">
 <div class="flex items-center justify-between p-2 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
 <span class="text-[8px] font-bold text-gray-400 uppercase">Esta Semana</span>
 <span class="text-sm font-black text-white">{{eventsThisWeek}}</span>
 </div>
 <div class="flex items-center justify-between p-2 rounded-[4px]" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
 <span class="text-[8px] font-bold text-gray-400 uppercase">Este Mês</span>
 <span class="text-sm font-black text-white">{{eventsThisMonth}}</span>
 </div>
 </div>
 </div>
 </div>
 </div>

</div>

<!-- Event Detail Modal (ao clicar em evento) — Com Edição + Histórico + Participantes -->
<div id="eventDetailModal" class="fixed inset-0 z-[200] hidden items-center justify-center bg-black/80 backdrop-blur-sm" style="display:none;" onclick="if(event.target===this){this.style.display='none';this.classList.add('hidden');}">
 <div class="w-full max-w-lg mx-4 flex flex-col max-h-[85vh]" style="background:#151515; border-radius:5px; box-shadow:0 2px 8px rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.06);">

 <!-- Header -->
 <div class="p-4 flex items-center justify-between shrink-0" style="border-bottom:1px solid rgba(255,255,255,0.06);">
  <div class="flex items-center gap-2">
   <span class="material-symbols-outlined text-orange-400">event</span>
   <h5 id="eventDetailTitle" class="text-sm font-black text-white"></h5>
  </div>
  <div class="flex items-center gap-1">
   <span id="eventDetailType" class="kcard-badge kcard-badge-orange" style="font-size:7px;"></span>
   <button onclick="document.getElementById('eventDetailModal').style.display='none';document.getElementById('eventDetailModal').classList.add('hidden');" class="w-6 h-6 rounded flex items-center justify-center text-gray-500 hover:text-white" style="background:rgba(255,255,255,0.05);">
    <span class="material-symbols-outlined text-sm">close</span>
   </button>
  </div>
 </div>

 <!-- Tabs -->
 <div class="flex shrink-0" style="border-bottom:1px solid rgba(255,255,255,0.06);">
  <button onclick="switchEventTab('details')" id="evtTabDetails" class="flex-1 py-2.5 text-[9px] font-black uppercase tracking-widest text-orange-400 border-b-2 border-orange-500">Detalhes</button>
  <button onclick="switchEventTab('tasks')" id="evtTabTasks" class="flex-1 py-2.5 text-[9px] font-black uppercase tracking-widest text-gray-500 border-b-2 border-transparent hover:text-white">Tarefas</button>
  <button onclick="switchEventTab('edit')" id="evtTabEdit" class="flex-1 py-2.5 text-[9px] font-black uppercase tracking-widest text-gray-500 border-b-2 border-transparent hover:text-white">Editar</button>
  <button onclick="switchEventTab('participants')" id="evtTabParticipants" class="flex-1 py-2.5 text-[9px] font-black uppercase tracking-widest text-gray-500 border-b-2 border-transparent hover:text-white">Participantes</button>
  <button onclick="switchEventTab('history')" id="evtTabHistory" class="flex-1 py-2.5 text-[9px] font-black uppercase tracking-widest text-gray-500 border-b-2 border-transparent hover:text-white">Histórico</button>
 </div>

 <!-- Tab Content -->
 <div class="flex-1 overflow-y-auto custom-scrollbar">

  <!-- TAB: DETALHES -->
  <div id="evtContentDetails" class="p-5 space-y-3">
   <div class="flex items-center gap-2">
    <span class="material-symbols-outlined text-[13px] text-gray-500">schedule</span>
    <span id="eventDetailTime" class="text-[9px] font-bold text-gray-300"></span>
   </div>
   <div class="flex items-center gap-2">
    <span class="material-symbols-outlined text-[13px] text-gray-500">date_range</span>
    <span id="eventDetailDuration" class="text-[9px] font-bold text-gray-300"></span>
   </div>
   <div id="eventDetailDescWrap" class="hidden">
    <p class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1">Descrição</p>
    <p id="eventDetailDesc" class="text-[9px] text-gray-300 p-2 rounded" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);"></p>
   </div>
   <div id="eventDetailParticipantsPreview" class="hidden">
    <p class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1">Participantes</p>
    <div id="eventParticipantsList" class="flex flex-wrap gap-1"></div>
   </div>
  </div>

  <!-- TAB: TAREFAS (Checklist com data) -->
  <div id="evtContentTasks" class="p-5 space-y-3 hidden">
   <p class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-2 flex items-center gap-1">
    <span class="material-symbols-outlined text-[10px]">checklist</span> Tarefas do Evento
   </p>
   <!-- Formulário de nova tarefa -->
   <div class="p-3 rounded-[4px] space-y-2" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
    <div>
     <input type="text" id="newEventTaskTitle" placeholder="Título da tarefa..." class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
    </div>
    <div class="grid grid-cols-3 gap-2">
     <div>
      <label class="text-[7px] font-bold text-gray-500 uppercase mb-0.5 block">Data limite</label>
      <input type="date" id="newEventTaskDate" class="w-full px-2 py-1.5 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); color-scheme:dark;">
     </div>
     <div>
      <label class="text-[7px] font-bold text-gray-500 uppercase mb-0.5 block">Responsável</label>
      <select id="newEventTaskAssignee" class="w-full px-2 py-1.5 text-xs text-white rounded-[4px] appearance-none" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
       <option value="">Sem responsável</option>
       {{#each users}}
       <option value="{{this.id}}" data-name="{{this.name}}">{{this.name}}</option>
       {{/each}}
      </select>
     </div>
     <div>
      <label class="text-[7px] font-bold text-gray-500 uppercase mb-0.5 block">Prioridade</label>
      <select id="newEventTaskPriority" class="w-full px-2 py-1.5 text-xs text-white rounded-[4px] appearance-none" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
       <option value="baixa">Baixa</option>
       <option value="media" selected>Média</option>
       <option value="alta">Alta</option>
      </select>
     </div>
    </div>
    <button type="button" onclick="addEventTask()" class="w-full py-2 rounded-[4px] bg-orange-500 text-white text-[8px] font-black uppercase hover:bg-orange-600 transition-all flex items-center justify-center gap-1">
     <span class="material-symbols-outlined text-xs">add</span> Criar Tarefa
    </button>
   </div>
   <p class="text-[7px] text-gray-500 flex items-center gap-1"><span class="material-symbols-outlined text-[9px]">info</span> Tarefas criadas aqui também aparecem no Dashboard.</p>

   <!-- Lista de tarefas existentes -->
   <div id="eventTasksList" class="space-y-1.5 mt-2">
    <p class="text-[9px] text-gray-500 text-center py-3">Nenhuma tarefa vinculada</p>
   </div>
  </div>

  <!-- TAB: EDITAR -->
  <div id="evtContentEdit" class="p-5 space-y-3 hidden">
   <form id="editEventForm" class="space-y-3">
    <div>
     <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1 block">Título</label>
     <input type="text" id="editEvtTitle" required class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
    </div>
    <div class="grid grid-cols-2 gap-3">
     <div>
      <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1 block">Início</label>
      <input type="datetime-local" id="editEvtStart" required class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); color-scheme:dark;">
     </div>
     <div>
      <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1 block">Término</label>
      <input type="datetime-local" id="editEvtEnd" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); color-scheme:dark;">
     </div>
    </div>
    <div>
     <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1 block">Tipo</label>
     <select id="editEvtType" class="w-full px-3 py-2 text-xs text-white rounded-[4px] appearance-none" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
      <option value="reuniao">Reunião</option>
      <option value="entrega">Entrega de Projeto</option>
      <option value="deadline">Deadline</option>
      <option value="followup">Follow-up</option>
      <option value="interno">Compromisso Interno</option>
      <option value="briefing">Briefing</option>
      <option value="revisao">Revisão</option>
     </select>
    </div>
    <div>
     <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1 block">Descrição</label>
     <textarea id="editEvtDesc" rows="3" class="w-full px-3 py-2 text-xs text-white rounded-[4px] resize-none" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);"></textarea>
    </div>
    <button type="submit" class="w-full flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-md bg-orange-500 text-[8px] font-black uppercase tracking-wider text-white hover:bg-orange-600 transition-colors">
     <span class="material-symbols-outlined text-[11px]">save</span> Salvar Alterações
    </button>
   </form>
  </div>

  <!-- TAB: PARTICIPANTES -->
  <div id="evtContentParticipants" class="p-5 space-y-3 hidden">
   <p class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-2">Adicionar Participante</p>
   <div class="flex gap-2">
    <select id="addParticipantSelect" class="flex-1 px-3 py-2 text-xs text-white rounded-[4px] appearance-none" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
     <option value="">Selecione...</option>
     {{#each users}}
     <option value="{{this.id}}" data-name="{{this.name}}" data-role="{{this.role}}">{{this.name}}{{#if (eq this.role 'freelancer')}} (Freelancer){{/if}}</option>
     {{/each}}
    </select>
    <button type="button" onclick="addEventParticipant()" class="px-3 py-2 rounded-md bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 text-[8px] font-black uppercase hover:bg-cyan-500 hover:text-white transition-all">+ Adicionar</button>
   </div>
   <p class="text-[7px] text-gray-500 mt-1">⚡ Ao adicionar, o participante será notificado e o evento aparecerá na agenda dele.</p>
   <div id="participantsListEdit" class="space-y-1.5 mt-3"></div>
  </div>

  <!-- TAB: HISTÓRICO -->
  <div id="evtContentHistory" class="p-5 space-y-2 hidden">
   <p class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-2">Histórico de Alterações</p>
   <div id="eventHistoryList" class="space-y-1.5">
    <p class="text-[9px] text-gray-500 text-center py-4">Carregando...</p>
   </div>
  </div>
 </div>

 <!-- Footer -->
 <div class="flex justify-between gap-2 p-4 shrink-0" style="border-top:1px solid rgba(255,255,255,0.06);">
  <button onclick="deleteCurrentEvent()" class="px-3 py-1.5 text-[8px] font-black uppercase text-red-400 hover:bg-red-500/10 rounded transition-colors flex items-center gap-1">
   <span class="material-symbols-outlined text-xs">delete</span> Excluir
  </button>
  <button onclick="document.getElementById('eventDetailModal').style.display='none';document.getElementById('eventDetailModal').classList.add('hidden');" class="px-3 py-1.5 text-[8px] font-black uppercase text-gray-400 hover:text-white">Fechar</button>
 </div>
 </div>
</div>

<!-- New Event Modal -->
<div class="modal fade" id="newEventModal" tabindex="-1" aria-hidden="true">
 <div class="modal-dialog modal-dialog-centered">
 <div class="modal-content" style="background:#151515; border-radius:5px; box-shadow:0 2px 8px rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.06);">
 <div class="modal-header p-5" style="border-bottom:1px solid rgba(255,255,255,0.06);">
 <h5 class="text-sm font-black text-white tracking-tight flex items-center gap-2">
 <span class="material-symbols-outlined text-orange-400 text-sm">event_available</span>
 Agendar Compromisso
 </h5>
 <button type="button" class="btn-close btn-close-white opacity-50" data-bs-dismiss="modal"></button>
 </div>
 <form id="newEventForm">
 <div class="modal-body p-5 space-y-4">
 <div>
 <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1 block">Título do Evento</label>
 <input type="text" name="title" required placeholder="Ex: Reunião de Briefing" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
 </div>

 <!-- Data e Hora separados (UX melhorada) -->
 <div class="grid grid-cols-2 gap-3">
 <div>
  <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1 block">Data Início *</label>
  <input type="date" id="newEvtStartDate" required class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); color-scheme:dark;">
 </div>
 <div>
  <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1 block">Data Término</label>
  <input type="date" id="newEvtEndDate" class="w-full px-3 py-2 text-xs text-white rounded-[4px]" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); color-scheme:dark;">
 </div>
 </div>
 <div class="grid grid-cols-2 gap-3">
 <div>
  <label class="text-[8px] font-bold text-gray-500 uppercase tracking-widest mb-1 block">Hora Início</label>
