  </select>
  <button type="button" onclick="window.addNewEventParticipant()" class="px-3 py-2 rounded-[4px] bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 text-[8px] font-black uppercase hover:bg-cyan-500 hover:text-white transition-all shrink-0">+</button>
