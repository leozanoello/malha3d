  <select id="newEventParticipantSelect" class="flex-1 px-3 py-2 text-xs text-white rounded-[4px] appearance-none" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
   <option value="">Selecione um participante...</option>
