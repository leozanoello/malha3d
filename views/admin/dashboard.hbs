<div class="p-6 sm:p-10 space-y-10 min-h-screen">
    
    <!-- Header: Dynamic & Premium -->
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
        <div>
            <div class="flex items-center gap-3 mb-2">
                <span class="px-3 py-1 rounded-full bg-primary-500/10 text-primary-500 text-[10px] font-black uppercase tracking-widest border border-primary-500/20">Live Intelligence</span>
                <span class="w-2 h-2 rounded-full bg-primary-500 animate-pulse"></span>
            </div>
            <h1 class="text-4xl font-black text-white tracking-tighter">Dashboard <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-primary-600 underline decoration-primary-500/30">Analytics</span></h1>
            <p class="text-gray-400 text-sm font-medium mt-2 flex items-center gap-2">
                Controle operacional e financeiro do ecossistema <span class="text-white font-bold">Zanoello 3D</span>
            </p>
        </div>
        
        <div class="flex items-center gap-4">
            <div class="glass-card px-6 py-3 rounded-2xl border-white/5 flex items-center gap-4 shadow-2xl">
                <div class="text-right">
                    <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Data de Hoje</p>
                    <p class="text-sm font-bold text-white">{{formatDate now 'DD [de] MMMM'}}</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 KPI CARDS FINANCEIROS (Módulo Rápido) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="glass-card p-6 rounded-[2rem] border-emerald-500/10 shadow-2xl group hover:border-emerald-500/30 transition-all relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-32 h-32 bg-emerald-500/10 blur-[50px] rounded-full group-hover:bg-emerald-500/20 transition-all"></div>
            <div class="flex justify-between items-start mb-4 relative z-10">
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-400">
                    <span class="material-symbols-outlined text-xl">account_balance_wallet</span>
                </div>
                <span class="px-2 py-1 bg-emerald-500/10 text-emerald-400 text-[8px] font-black uppercase tracking-widest rounded-full">Receitas</span>
            </div>
            <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest relative z-10">Total Receitas</p>
            <h4 class="text-2xl font-black text-white tracking-tighter mt-1 relative z-10">{{formatCurrency kpiFinanceiro.totalReceitas}}</h4>
        </div>

        <div class="glass-card p-6 rounded-[2rem] border-red-500/10 shadow-2xl group hover:border-red-500/30 transition-all relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-32 h-32 bg-red-500/10 blur-[50px] rounded-full group-hover:bg-red-500/20 transition-all"></div>
            <div class="flex justify-between items-start mb-4 relative z-10">
                <div class="w-10 h-10 rounded-xl bg-red-500/10 flex items-center justify-center text-red-400">
                    <span class="material-symbols-outlined text-xl">credit_card</span>
                </div>
                <span class="px-2 py-1 bg-red-500/10 text-red-400 text-[8px] font-black uppercase tracking-widest rounded-full">Despesas</span>
            </div>
            <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest relative z-10">Total Despesas</p>
            <h4 class="text-2xl font-black text-white tracking-tighter mt-1 relative z-10">{{formatCurrency kpiFinanceiro.totalDespesas}}</h4>
        </div>

        <div class="glass-card p-6 rounded-[2rem] border-primary-500/10 shadow-2xl group hover:border-primary-500/30 transition-all relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-32 h-32 bg-primary-500/10 blur-[50px] rounded-full group-hover:bg-primary-500/20 transition-all"></div>
            <div class="flex justify-between items-start mb-4 relative z-10">
                <div class="w-10 h-10 rounded-xl bg-primary-500/10 flex items-center justify-center text-primary-500">
                    <span class="material-symbols-outlined text-xl">payments</span>
                </div>
                <span class="px-2 py-1 bg-primary-500/10 text-primary-500 text-[8px] font-black uppercase tracking-widest rounded-full">Pendentes</span>
            </div>
            <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest relative z-10">Recebíveis Pendentes</p>
            <h4 class="text-2xl font-black text-white tracking-tighter mt-1 relative z-10">{{formatCurrency kpiFinanceiro.receitasPendentes}}</h4>
        </div>

        <div class="glass-card p-6 rounded-[2rem] border-cyber-500/10 shadow-2xl group hover:border-cyber-500/30 transition-all relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-32 h-32 bg-cyber-500/10 blur-[50px] rounded-full group-hover:bg-cyber-500/20 transition-all"></div>
            <div class="flex justify-between items-start mb-4 relative z-10">
                <div class="w-10 h-10 rounded-xl bg-cyber-500/10 flex items-center justify-center text-cyber-500">
                    <span class="material-symbols-outlined text-xl">pie_chart</span>
                </div>
                <span class="px-2 py-1 bg-cyber-500/10 text-cyber-500 text-[8px] font-black uppercase tracking-widest rounded-full">Rentabilidade</span>
            </div>
            <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest relative z-10">Margem Global</p>
            <h4 class="text-2xl font-black text-white tracking-tighter mt-1 relative z-10">{{kpiFinanceiro.margemGlobal}}%</h4>
        </div>
    </div>

    <!-- Grid: High Density Modern Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-12 gap-8">

        <!-- 1. ALERTAS ESTRATÉGICOS DE GESTÃO -->
        <div class="col-span-1 xl:col-span-4 glass-card p-8 rounded-[2.5rem] border-white/10 shadow-2xl flex flex-col justify-between min-h-[320px]">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h3 class="text-lg font-black text-white uppercase tracking-tight">Centro de Alertas</h3>
                    <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">Inteligência Operacional</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-red-500/10 flex items-center justify-center text-red-500 animate-pulse">
                    <span class="material-symbols-outlined">warning_amber</span>
                </div>
            </div>
            
            <div class="space-y-3 flex-1 overflow-y-auto custom-scrollbar pr-2">
                <!-- Alerta 1: Financeiro -->
                <div class="p-3 rounded-xl bg-red-500/5 border border-red-500/10 flex gap-3 items-start">
                    <span class="material-symbols-outlined text-sm text-red-400 mt-0.5">trending_down</span>
                    <div>
                        <p class="text-[11px] font-black text-red-400 uppercase tracking-widest">Atenção ao Fluxo</p>
                        <p class="text-[10px] text-gray-400 mt-1">Despesas projetadas ultrapassam as receitas confirmadas para a próxima quinzena.</p>
                    </div>
                </div>
                <!-- Alerta 2: Prazos -->
                <div class="p-3 rounded-xl bg-orange-500/5 border border-orange-500/10 flex gap-3 items-start">
                    <span class="material-symbols-outlined text-sm text-orange-400 mt-0.5">timer</span>
                    <div>
                        <p class="text-[11px] font-black text-orange-400 uppercase tracking-widest">Risco de Atraso</p>
                        <p class="text-[10px] text-gray-400 mt-1">2 projetos ArchViz ultra-realistas com prazo crítico (< 48h).</p>
                    </div>
                </div>
                <!-- Alerta 3: Comercial -->
                <div class="p-3 rounded-xl bg-yellow-500/5 border border-yellow-500/10 flex gap-3 items-start">
                    <span class="material-symbols-outlined text-sm text-yellow-400 mt-0.5">mail</span>
                    <div>
                        <p class="text-[11px] font-black text-yellow-400 uppercase tracking-widest">Follow-up Necessário</p>
                        <p class="text-[10px] text-gray-400 mt-1">4 propostas de alto valor (>$10k) sem resposta há mais de 7 dias.</p>
                    </div>
                </div>
                <!-- Alerta 4: Produtividade -->
                <div class="p-3 rounded-xl bg-indigo-500/5 border border-indigo-500/10 flex gap-3 items-start">
                    <span class="material-symbols-outlined text-sm text-indigo-400 mt-0.5">group</span>
                    <div>
                        <p class="text-[11px] font-black text-indigo-400 uppercase tracking-widest">Ociosidade de Equipe</p>
                        <p class="text-[10px] text-gray-400 mt-1">Equipe de modelagem 3D com 30% de tempo livre nesta semana.</p>
                    </div>
                </div>
                <!-- Alerta 5: Sucesso -->
                <div class="p-3 rounded-xl bg-emerald-500/5 border border-emerald-500/10 flex gap-3 items-start">
                    <span class="material-symbols-outlined text-sm text-emerald-400 mt-0.5">verified</span>
                    <div>
                        <p class="text-[11px] font-black text-emerald-400 uppercase tracking-widest">Meta de Retenção</p>
                        <p class="text-[10px] text-gray-400 mt-1">Taxa de conversão de clientes recorrentes bateu recorde de 78% este mês.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. SALES FORECAST (Deep Dark High-Tech Card) -->
        <div class="col-span-1 md:col-span-2 xl:col-span-8 bg-black/40 backdrop-blur-3xl border border-white/5 rounded-[2.5rem] p-8 shadow-2xl relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-full h-full bg-gradient-to-br from-primary-500/5 to-transparent opacity-50"></div>
            
            <div class="flex items-center justify-between mb-10 relative z-10">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-white">
                        <span class="material-symbols-outlined">insights</span>
                    </div>
                    <div>
                        <h3 class="text-xl font-black text-white tracking-tight uppercase">Previsão de Vendas</h3>
                        <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">Análise Ponderada do Pipeline CRM</p>
                    </div>
                </div>
                <button class="px-6 py-2 rounded-xl bg-white/5 border border-white/10 text-[10px] font-black text-white uppercase tracking-widest hover:bg-white/10 transition-all">Relatório Detalhado</button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 relative z-10">
                <!-- Forecast Min -->
                <div class="glass-card p-6 rounded-3xl border-white/5 hover:border-emerald-500/30 transition-all group/card">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-2 h-8 rounded-full bg-emerald-500 shadow-[0_0_15px_rgba(16,185,129,0.4)]"></div>
                        <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest leading-tight">Mínima <br>(80%+)</span>
                    </div>
                    <h4 class="text-3xl font-black text-white tracking-tighter">{{formatCurrency forecast.min}}</h4>
                    <div class="mt-4 h-1 w-full bg-white/5 rounded-full overflow-hidden">
                        <div class="h-full bg-emerald-500" style="width: 100%"></div>
                    </div>
                </div>

                <!-- Forecast Med -->
                <div class="glass-card p-6 rounded-3xl border-white/5 hover:border-primary-500/30 transition-all group/card border-primary-500/10">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-2 h-8 rounded-full bg-primary-500 shadow-[0_0_15px_rgba(255,140,0,0.4)]"></div>
                        <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest leading-tight">Média <br>(Ponderada)</span>
                    </div>
                    <h4 class="text-3xl font-black text-primary-500 tracking-tighter">{{formatCurrency forecast.med}}</h4>
                    <div class="mt-4 h-1 w-full bg-white/5 rounded-full overflow-hidden">
                        <div class="h-full bg-primary-500" style="width: 65%"></div>
                    </div>
                </div>

                <!-- Forecast Max -->
                <div class="glass-card p-6 rounded-3xl border-white/5 hover:border-cyber-500/30 transition-all group/card">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-2 h-8 rounded-full bg-cyber-500 shadow-[0_0_15px_rgba(0,242,255,0.4)]"></div>
                        <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest leading-tight">Máxima <br>(100%)</span>
                    </div>
                    <h4 class="text-3xl font-black text-white tracking-tighter">{{formatCurrency forecast.max}}</h4>
                    <div class="mt-4 h-1 w-full bg-white/5 rounded-full overflow-hidden">
                        <div class="h-full bg-cyber-500" style="width: 35%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. AGENDA DE TAREFAS & CALENDÁRIO COMPACTO (ArchViz Focus) -->
        <div class="col-span-1 xl:col-span-4 glass-card rounded-[2.5rem] border-white/10 flex flex-col shadow-2xl overflow-hidden">
            <div class="p-8 border-b border-white/5 bg-white/[0.02]">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-lg font-black text-white uppercase tracking-tight">Cronograma Resumido</h3>
                    <span class="w-2 h-2 rounded-full bg-orange-500 animate-ping"></span>
                </div>
                <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">Prazos e Entregas (Semana Atual)</p>
            </div>

            <!-- Calendário Compacto -->
            <div class="bg-black/30 p-4 border-b border-white/5 flex justify-between gap-2 overflow-x-auto custom-scrollbar">
                {{#each currentWeekDays}}
                <div class="flex flex-col items-center gap-2 p-2 rounded-xl {{#if this.isToday}}bg-primary-500/20 border border-primary-500/30{{else}}bg-white/[0.02] border border-white/5{{/if}} min-w-[50px]">
                    <span class="text-[9px] font-black {{#if this.isToday}}text-primary-400{{else}}text-gray-500{{/if}} uppercase">{{this.dayName}}</span>
                    <span class="text-sm font-black {{#if this.isToday}}text-white{{else}}text-gray-400{{/if}}">{{this.dayNumber}}</span>
                    {{#if this.hasTasks}}
                    <div class="w-1.5 h-1.5 rounded-full bg-orange-500 shadow-[0_0_5px_#f97316]"></div>
                    {{else}}
                    <div class="w-1.5 h-1.5 rounded-full bg-transparent"></div>
                    {{/if}}
                </div>
                {{/each}}
            </div>

            <div class="p-6 flex-1 space-y-4 max-h-[250px] overflow-y-auto custom-scrollbar">
                {{#each tasks}}
                <div class="glass-card p-4 rounded-2xl border-white/5 hover:bg-white/[0.05] transition-all cursor-pointer group/item">
                    <div class="flex gap-4 items-center">
                        <div class="flex-shrink-0 w-12 h-12 bg-white/5 rounded-xl border border-white/10 flex flex-col items-center justify-center group-hover/item:border-primary-500/40 transition-colors">
                            <span class="text-[9px] font-black text-gray-500 uppercase leading-none mb-1">{{formatDate this.dueDate 'MMM'}}</span>
                            <span class="text-lg font-black text-white leading-none">{{formatDate this.dueDate 'DD'}}</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-sm font-black text-white truncate group-hover/item:text-primary-500 transition-colors">{{this.title}}</h4>
                            <div class="flex items-center gap-2 mt-1">
                                <span class="material-symbols-outlined text-[10px] text-gray-500">folder</span>
                                <span class="text-[10px] font-bold text-gray-500 uppercase truncate">{{this.budget.name}}</span>
                            </div>
                        </div>
                    </div>
                </div>
                {{else}}
                <div class="flex flex-col items-center justify-center py-10 text-center opacity-30">
                    <span class="material-symbols-outlined text-4xl mb-4">event_available</span>
                    <p class="text-xs font-black uppercase tracking-widest">Livre de tarefas nesta semana</p>
                </div>
                {{/each}}
            </div>
            
            <a href="/admin/tarefas" class="p-4 text-center bg-white/[0.03] border-t border-white/5 text-[10px] font-black text-gray-400 hover:text-white uppercase tracking-widest transition-all">Visualizar Agenda Completa</a>
        </div>

        <!-- 4. TERMÔMETRO DE PRODUTIVIDADE (Interactive SVG) -->
        <div class="col-span-1 xl:col-span-4 glass-card p-8 rounded-[2.5rem] border-white/10 shadow-2xl flex flex-col items-center justify-center relative group">
            <div class="absolute inset-0 bg-gradient-to-b from-purple-500/5 to-transparent"></div>
            
            <div class="text-center mb-8 relative z-10">
                <h3 class="text-lg font-black text-white uppercase tracking-tight mb-1">Produtividade</h3>
                <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">Carga Horária Mensal</p>
            </div>

            <div class="relative w-48 h-48 flex items-center justify-center z-10">
                <svg class="w-full h-full transform -rotate-90 filter drop-shadow-[0_0_15px_rgba(168,85,247,0.2)]" viewBox="0 0 100 100">
                    <circle cx="50" cy="50" r="42" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="8" />
                    <circle cx="50" cy="50" r="42" fill="none" class="stroke-purple-500 transition-all duration-1000 ease-out" stroke-width="8" stroke-linecap="round" 
                        stroke-dasharray="264" 
                        stroke-dashoffset="264" />
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                    <span class="text-4xl font-black text-white tracking-tighter">{{produtividade.horasLogadas}}h</span>
                    <span class="text-[9px] font-black text-gray-500 uppercase tracking-widest mt-1">Registradas</span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 w-full mt-10 relative z-10">
                <div class="bg-white/5 rounded-2xl p-4 text-center border border-white/5">
                    <span class="block text-[8px] font-black text-gray-500 uppercase tracking-widest mb-1">Meta</span>
                    <span class="text-xl font-black text-white">{{produtividade.metaHoras}}h</span>
                </div>
                <div class="rounded-2xl p-4 text-center border {{produtividade.cor}} flex flex-col items-center justify-center">
                    <span class="material-symbols-outlined text-lg mb-1">{{produtividade.icon}}</span>
                    <span class="text-[9px] font-black uppercase tracking-widest">{{produtividade.status}}</span>
                </div>
            </div>
        </div>

        <!-- 5. AUDITORIA DE FLUXO (Tier 1 Integration) -->
        <div class="col-span-1 md:col-span-2 xl:col-span-8 glass-card p-8 rounded-[2.5rem] border-primary-500/10 shadow-2xl bg-gradient-to-br from-primary-500/5 to-transparent relative overflow-hidden group">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h3 class="text-xl font-black text-white tracking-tight uppercase">Auditoria de Fluxo</h3>
                    <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">Saúde Financeira Global (SaaS Pattern)</p>
                </div>
                <div class="flex items-center gap-2 px-4 py-2 rounded-xl bg-primary-500/10 border border-primary-500/20">
                    <span class="w-2 h-2 rounded-full bg-primary-500 animate-pulse"></span>
                    <span class="text-[10px] font-black text-primary-400 uppercase tracking-widest">Live Sync</span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                <div class="space-y-6">
                    <div class="p-6 rounded-3xl bg-white/[0.02] border border-white/5">
                        <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">Patrimônio Líquido Projetado</p>
                        <h4 class="text-4xl font-black text-white tracking-tighter">{{formatCurrency kpiFinanceiro.saldoProjetadoTotal}}</h4>
                        <p class="text-[9px] text-gray-500 mt-2">Soma de todos os contratos ativos - despesas operacionais.</p>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="p-4 rounded-2xl bg-emerald-500/5 border border-emerald-500/10">
                            <span class="text-[8px] font-black text-emerald-500 uppercase tracking-widest">Margem Global</span>
                            <span class="block text-2xl font-black text-white mt-1">{{kpiFinanceiro.margemGlobal}}%</span>
                        </div>
                        <div class="p-4 rounded-2xl bg-primary-500/5 border border-primary-500/10">
                            <span class="text-[8px] font-black text-primary-500 uppercase tracking-widest">Mensal</span>
                            <span class="block text-2xl font-black text-white mt-1">{{kpiFinanceiro.margemMedia}}%</span>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-6 rounded-3xl border-white/5 bg-black/20 flex flex-col justify-between">
                    <div>
                        <h5 class="text-[10px] font-black text-white uppercase tracking-widest mb-4">Próximos Recebíveis</h5>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between text-[11px]">
                                <span class="text-gray-500 italic">Sinais (50%) Pendentes</span>
                                <span class="font-bold text-white">{{formatCurrency kpiFinanceiro.receitasPendentes}}</span>
                            </div>
                            <div class="h-1.5 w-full bg-white/5 rounded-full overflow-hidden">
                                <div class="h-full bg-primary-500" style="width: 45%"></div>
                            </div>
                            <p class="text-[9px] text-gray-600 mt-1 uppercase font-black">45% da meta mensal atingida</p>
                        </div>
                    </div>
                    <button class="w-full mt-6 py-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-[9px] font-black text-white uppercase tracking-widest transition-all">Exportar Auditoria (PDF)</button>
                </div>
            </div>
        </div>

        <!-- 6. SMART NOTES (Modern Keep Style) -->
        <div class="col-span-1 xl:col-span-4 glass-card rounded-[2.5rem] border-white/10 flex flex-col shadow-2xl h-[450px]">
            <div class="p-8 border-b border-white/5 bg-white/[0.02] flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-black text-white uppercase tracking-tight">Smart Notes</h3>
                    <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest italic">Ideias e Insights</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-yellow-500/10 text-yellow-500 flex items-center justify-center">
                    <span class="material-symbols-outlined">lightbulb</span>
                </div>
            </div>

            <div class="p-6 flex-1 flex flex-col overflow-hidden">
                <form id="smartNoteForm" class="mb-6 relative">
                    <textarea id="noteContent" rows="2" class="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-sm text-white placeholder-gray-500 focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all resize-none" placeholder="O que você está pensando? #tag"></textarea>
                    <div class="flex items-center justify-between mt-3">
                        <div class="flex gap-1.5">
                            <button type="button" class="color-btn w-6 h-6 rounded-lg bg-yellow-400 ring-2 ring-yellow-500/50" data-color="bg-yellow-400/20"></button>
                            <button type="button" class="color-btn w-6 h-6 rounded-lg bg-emerald-400 hover:scale-110 transition-all" data-color="bg-emerald-400/20"></button>
                            <button type="button" class="color-btn w-6 h-6 rounded-lg bg-cyber-400 hover:scale-110 transition-all" data-color="bg-cyber-400/20"></button>
                        </div>
                        <input type="hidden" id="noteColor" value="bg-yellow-400/20">
                        <button type="submit" class="bg-primary-500 text-white px-5 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest shadow-lg shadow-primary-500/20">Fixar Nota</button>
                    </div>
                </form>

                <div class="flex-1 overflow-y-auto pr-2 space-y-4 custom-scrollbar" id="notesList">
                    {{#each notes}}
                    <div class="note-card relative p-5 rounded-2xl border border-white/5 group shadow-lg {{this.color}} backdrop-blur-md" data-id="{{this.id}}">
                        <button class="delete-note absolute top-3 right-3 text-white/20 hover:text-red-500 opacity-0 group-hover:opacity-100 transition-all">
                            <span class="material-symbols-outlined text-sm">delete</span>
                        </button>
                        <p class="text-sm text-white/90 font-medium whitespace-pre-wrap note-text">{{this.content}}</p>
                        <div class="mt-4 flex items-center justify-between">
                            <span class="text-[9px] font-black text-white/40 uppercase">{{formatDate this.createdAt 'short'}}</span>
                            {{#if this.isPinned}}<span class="material-symbols-outlined text-xs text-white/40">push_pin</span>{{/if}}
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }
    
    .hashtag { 
        color: #ff8c00; 
        font-weight: 800; 
        background: rgba(255, 140, 0, 0.1); 
        padding: 1px 6px; 
        border-radius: 6px;
        font-size: 0.9em;
    }

    @keyframes shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. Hashtags
    const processHashtags = (text) => {
        return text.replace(/(#[a-zA-Z0-9_À-ÿ]+)/g, '<span class="hashtag">$1</span>');
    };
    document.querySelectorAll('.note-text').forEach(el => {
        el.innerHTML = processHashtags(el.textContent);
    });

    // 2. Cores das Notas
    const colorBtns = document.querySelectorAll('.color-btn');
    const colorInput = document.getElementById('noteColor');
    colorBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            colorBtns.forEach(b => b.classList.remove('ring-2', 'ring-white/50', 'ring-offset-2', 'ring-offset-black/20'));
            btn.classList.add('ring-2', 'ring-white/50', 'ring-offset-2', 'ring-offset-black/20');
            colorInput.value = btn.dataset.color;
        });
    });

    // 3. Salvar Nota
    const form = document.getElementById('smartNoteForm');
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const content = document.getElementById('noteContent').value;
        const color = document.getElementById('noteColor').value;
        if (!content.trim()) return;
        try {
            const res = await fetch('/admin/api/notes', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content, color })
            });
            if (res.ok) window.location.reload();
        } catch (err) { console.error(err); }
    });

    // 4. Deletar Nota
    document.querySelectorAll('.delete-note').forEach(btn => {
        btn.addEventListener('click', async (e) => {
            const card = e.target.closest('.note-card');
            const id = card.dataset.id;
            if(confirm('Deseja excluir esta nota permanentemente?')) {
                try {
                    const res = await fetch(`/admin/api/notes/${id}`, { method: 'DELETE' });
                    if(res.ok) {
                        card.style.transform = 'scale(0.8)';
                        card.style.opacity = '0';
                        setTimeout(() => card.remove(), 300);
                    }
                } catch (err) { console.error(err); }
            }
        });
    });

    // 5. Gráfico de Produtividade (SVG)
    const svgCircle = document.querySelector('circle.stroke-purple-500');
    if (svgCircle) {
        const horasLogadas = parseFloat('{{produtividade.horasLogadas}}') || 0;
        const metaHoras = parseFloat('{{produtividade.metaHoras}}') || 160;
        const circumference = 2 * Math.PI * 42; // aprox 264
        const ratio = Math.min(horasLogadas / metaHoras, 1);
        const offset = circumference - (ratio * circumference);
        
        svgCircle.style.strokeDasharray = circumference;
        svgCircle.style.strokeDashoffset = circumference;
        
        setTimeout(() => {
            svgCircle.style.strokeDashoffset = offset;
        }, 300);
    }
});
</script>
