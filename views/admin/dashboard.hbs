<style>
/* ====================================================== */
/* DESIGN SYSTEM — Dashboard Cards (Uiverse Pattern)        */
/* ====================================================== */
:root {
 --ds-bg: #151515;
 --ds-bg-soft: #1a1a1c;
 --ds-bg-deep: #0d0d0e;
 --ds-line: rgba(255, 255, 255, 0.06);
 --ds-line-strong: rgba(255, 255, 255, 0.10);
 --ds-orange: #ff9966;
 --ds-text: #ffffff;
 --ds-text-muted: rgba(255, 255, 255, 0.55);
 --ds-radius: 5px;
}

/* === MODO CLARO (theme-light no body) === */
body.theme-light {
 --ds-bg: #ffffff;
 --ds-bg-soft: #f1f5f9;
 --ds-bg-deep: #e2e8f0;
 --ds-line: rgba(0, 0, 0, 0.08);
 --ds-line-strong: rgba(0, 0, 0, 0.14);
 --ds-text: #0f172a;
 --ds-text-muted: #64748b;
}
body.theme-light .ds-card {
 box-shadow: 0px 2px 8px 0px rgba(15, 23, 42, 0.08), 0px 0px 0px 1px rgba(15, 23, 42, 0.04);
}
body.theme-light .ds-card::before {
 background: linear-gradient(135deg, transparent 30%, rgba(249, 115, 22, 0.45) 50%, transparent 70%);
}
body.theme-light .ds-card-header {
 background: rgba(0, 0, 0, 0.015);
}
body.theme-light .ds-list-item {
 background: rgba(0, 0, 0, 0.02);
}
body.theme-light .ds-list-item:hover {
 background: rgba(0, 0, 0, 0.05);
}
body.theme-light .ds-stat-row {
 background: rgba(0, 0, 0, 0.025);
}
body.theme-light .ds-action-btn {
 background: rgba(0, 0, 0, 0.04);
 border-color: rgba(0, 0, 0, 0.10);
}
body.theme-light .ds-msg-bubble {
 background: rgba(0, 0, 0, 0.04);
 border-color: rgba(0, 0, 0, 0.08);
}
body.theme-light .ds-msg-text {
 color: rgba(15, 23, 42, 0.85);
}
body.theme-light .ds-input {
 background: rgba(0, 0, 0, 0.02);
 border-color: rgba(0, 0, 0, 0.10);
 color: #0f172a;
}
body.theme-light .ds-input::placeholder {
 color: #94a3b8;
}
body.theme-light .ds-kpi-card {
 background: rgba(0, 0, 0, 0.02);
 border-color: rgba(0, 0, 0, 0.10);
}

/* === CARD BASE === */
.ds-card {
 position: relative;
 background-color: var(--ds-bg);
 border-radius: var(--ds-radius);
 box-shadow: 0px 0px 10px 1px #000000ee;
 overflow: hidden;
 transition: transform 250ms ease, box-shadow 250ms ease;
 display: flex;
 flex-direction: column;
}

/* Glow da borda (padrão Uiverse — gradient laranja rotacional sutil) */
.ds-card::before {
 content: ' ';
 position: absolute;
 inset: 0;
 padding: 1px;
 border-radius: inherit;
 background: linear-gradient(135deg, transparent 30%, rgba(255, 153, 102, 0.6) 50%, transparent 70%);
 -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
 -webkit-mask-composite: xor;
 mask-composite: exclude;
 opacity: 0.35;
 pointer-events: none;
 transition: opacity 300ms ease;
 z-index: 1;
}
.ds-card:hover::before {
 opacity: 0.7;
}

/* === HEADER PADRÃO (mesmo para TODOS os cards) === */
.ds-card-header {
 padding: 14px 16px;
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 8px;
 min-height: 50px;
 border-bottom: 1px solid var(--ds-line);
 background: rgba(255, 255, 255, 0.015);
 flex-shrink: 0;
 position: relative;
 z-index: 2;
}

.ds-card-title {
 font-size: 11px;
 font-weight: 900;
 text-transform: uppercase;
 letter-spacing: 0.08em;
 color: var(--ds-text);
 display: flex;
 align-items: center;
 gap: 8px;
 line-height: 1;
}

/* === BODY / FOOTER === */
.ds-card-body {
 flex: 1;
 min-height: 0;
 position: relative;
 z-index: 2;
}
.ds-card-footer {
 padding: 12px 16px;
 border-top: 1px solid var(--ds-line);
 flex-shrink: 0;
 position: relative;
 z-index: 2;
}

/* === CARD COMPACTO (header data) === */
.ds-card-compact {
 padding: 10px 16px;
 border: 1px solid var(--ds-line);
}

/* === TIPOGRAFIA === */
.ds-text { color: var(--ds-text); }
.ds-text-muted { color: var(--ds-text-muted); }
.ds-bg-soft { background: var(--ds-bg-soft); }

/* === ACTION BUTTON === */
.ds-action-btn {
 font-size: 9px;
 font-weight: 700;
 text-transform: uppercase;
 letter-spacing: 0.08em;
 padding: 5px 10px;
 border-radius: 4px;
 background: rgba(255, 255, 255, 0.04);
 border: 1px solid rgba(255, 255, 255, 0.08);
 transition: all 200ms ease;
 display: inline-flex;
 align-items: center;
 gap: 4px;
 cursor: pointer;
 text-decoration: none;
}
.ds-action-btn:hover {
 background: rgba(249, 115, 22, 0.15);
 border-color: rgba(249, 115, 22, 0.4);
 color: #fdba74;
}

/* === LIST ITEM === */
.ds-list-item {
 padding: 9px 11px;
 border-radius: 4px;
 background: rgba(255, 255, 255, 0.015);
 border: 1px solid var(--ds-line);
 transition: background 150ms ease;
}
.ds-list-item:hover {
 background: rgba(255, 255, 255, 0.04);
}

/* === BADGES === */
.ds-badge {
 padding: 2px 7px;
 border-radius: 10px;
 font-size: 7px;
 font-weight: 900;
 text-transform: uppercase;
 letter-spacing: 0.05em;
 border: 1px solid transparent;
 display: inline-block;
}
.ds-badge-red { background: rgba(239, 68, 68, 0.12); color: #fca5a5; border-color: rgba(239, 68, 68, 0.25); }
.ds-badge-orange { background: rgba(249, 115, 22, 0.12); color: #fdba74; border-color: rgba(249, 115, 22, 0.25); }
.ds-badge-emerald { background: rgba(16, 185, 129, 0.12); color: #6ee7b7; border-color: rgba(16, 185, 129, 0.25); }
.ds-badge-blue { background: rgba(59, 130, 246, 0.12); color: #93c5fd; border-color: rgba(59, 130, 246, 0.25); }
.ds-badge-indigo { background: rgba(99, 102, 241, 0.12); color: #a5b4fc; border-color: rgba(99, 102, 241, 0.25); }
.ds-badge-cyan { background: rgba(6, 182, 212, 0.12); color: #67e8f9; border-color: rgba(6, 182, 212, 0.25); }
.ds-badge-purple { background: rgba(168, 85, 247, 0.12); color: #d8b4fe; border-color: rgba(168, 85, 247, 0.25); }
.ds-badge-amber { background: rgba(245, 158, 11, 0.12); color: #fcd34d; border-color: rgba(245, 158, 11, 0.25); }

/* === STAT ROW (Previsão de Vendas) === */
.ds-stat-row {
 display: flex;
 align-items: center;
 justify-content: space-between;
 padding: 11px 13px;
 border-radius: 4px;
 background: rgba(255, 255, 255, 0.02);
 border: 1px solid var(--ds-line);
}
.ds-stat-row-highlight {
 background: rgba(249, 115, 22, 0.08);
 border-color: rgba(249, 115, 22, 0.25);
}
.ds-stat-label {
 font-size: 9px;
 font-weight: 700;
 text-transform: uppercase;
 letter-spacing: 0.06em;
 color: var(--ds-text-muted);
}
.ds-stat-value {
 font-size: 14px;
 font-weight: 900;
 color: var(--ds-text);
 font-family: 'JetBrains Mono', monospace;
 letter-spacing: -0.02em;
}

/* === KPI CARD (dentro de Financeiro) === */
.ds-kpi-card {
 padding: 14px 16px;
 border-radius: 4px;
 background: rgba(255, 255, 255, 0.02);
 border: 1px solid var(--ds-line);
 display: flex;
 flex-direction: column;
 justify-content: center;
 gap: 6px;
 min-height: 80px;
}
.ds-kpi-emerald { background: rgba(16, 185, 129, 0.05); border-color: rgba(16, 185, 129, 0.18); }
.ds-kpi-red { background: rgba(239, 68, 68, 0.05); border-color: rgba(239, 68, 68, 0.18); }
.ds-kpi-blue { background: rgba(59, 130, 246, 0.05); border-color: rgba(59, 130, 246, 0.18); }
.ds-kpi-purple { background: rgba(168, 85, 247, 0.05); border-color: rgba(168, 85, 247, 0.18); }

.ds-kpi-label {
 font-size: 10px;
 font-weight: 700;
 text-transform: uppercase;
 letter-spacing: 0.06em;
 color: var(--ds-text-muted);
}
.ds-kpi-emerald .ds-kpi-label { color: rgba(110, 231, 183, 0.9); }
.ds-kpi-red .ds-kpi-label { color: rgba(252, 165, 165, 0.9); }
.ds-kpi-blue .ds-kpi-label { color: rgba(147, 197, 253, 0.9); }
.ds-kpi-purple .ds-kpi-label { color: rgba(216, 180, 254, 0.9); }

.ds-kpi-value {
 font-size: 1.25rem;
 font-weight: 900;
 color: var(--ds-text);
 letter-spacing: -0.02em;
 line-height: 1.1;
 word-break: break-word;
}

/* === CHAT BUBBLES === */
.ds-msg-bubble {
 background: rgba(255, 255, 255, 0.04);
 border: 1px solid var(--ds-line);
 border-radius: 14px;
 border-top-left-radius: 4px;
 padding: 10px 12px;
 max-width: 80%;
}
.ds-msg-bubble-self {
 background: rgba(59, 130, 246, 0.08);
 border-color: rgba(59, 130, 246, 0.2);
 border-top-left-radius: 14px;
 border-top-right-radius: 4px;
}
.ds-msg-author {
 font-size: 10px;
 font-weight: 700;
 margin-bottom: 2px;
}
.ds-msg-text {
 font-size: 10px;
 color: rgba(255, 255, 255, 0.85);
 line-height: 1.4;
}

/* === PRIMARY BUTTON === */
.ds-primary-btn {
 width: 100%;
 display: flex;
 align-items: center;
 justify-content: center;
 gap: 6px;
 padding: 11px 14px;
 border-radius: 4px;
 font-size: 9px;
 font-weight: 900;
 text-transform: uppercase;
 letter-spacing: 0.08em;
 color: white;
 box-shadow: 0 4px 16px rgba(79, 70, 229, 0.25);
 transition: all 200ms ease;
 text-decoration: none;
}
.ds-btn-indigo { background: #4f46e5; }
.ds-btn-indigo:hover { background: #6366f1; box-shadow: 0 6px 20px rgba(79, 70, 229, 0.4); }

/* === INPUT === */
.ds-input {
 width: 100%;
 background: rgba(255, 255, 255, 0.02);
 border: 1px solid var(--ds-line);
 border-radius: 4px;
 padding: 10px 38px 10px 14px;
 font-size: 10px;
 color: white;
 transition: border-color 200ms ease;
}
.ds-input:focus { outline: none; border-color: rgba(59, 130, 246, 0.4); }
.ds-input::placeholder { color: rgba(255, 255, 255, 0.35); }

/* === SCROLLBAR === */
.custom-scrollbar::-webkit-scrollbar { width: 3px; }
.custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
.custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 4px; }
.custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.15); }
</style>

<script>
 function filterNotifications(val) {
 if (!val) {
 document.querySelectorAll('.notif-item').forEach(item => item.style.display = 'block');
 return;
 }
 document.querySelectorAll('.notif-item').forEach(item => {
 if (item.dataset.date === val) {
 item.style.display = 'block';
 } else {
 item.style.display = 'none';
 }
 });
 }

 // === VER TODAS AS NOTIFICAÇÕES (Modal com calendário) ===
 window.openAllNotificationsModal = function() {
  const existing = document.getElementById('allNotifsModal');
  if (existing) existing.remove();
  const allItems = document.querySelectorAll('#notifList .notif-item');
  const itemsHtml = Array.from(allItems).map(i => i.outerHTML).join('');
  const modalHtml = `
   <div id="allNotifsModal" class="fixed inset-0 z-[200] flex items-center justify-center bg-black/80 backdrop-blur-sm" style="display:flex;">
    <div class="bg-[#0a0c10] border border-white/10 rounded-2xl shadow-2xl w-full max-w-3xl mx-4 overflow-hidden flex flex-col max-h-[80vh]">
     <header class="p-3 border-b border-white/5 flex items-center justify-between bg-gradient-to-r from-orange-500/10 to-red-500/10 shrink-0">
      <div class="flex items-center gap-2">
       <span class="material-symbols-outlined text-orange-400">notifications</span>
       <h3 class="text-sm font-black text-white tracking-tight">Todas as Notificações</h3>
      </div>
      <div class="flex items-center gap-2">
       <div class="flex items-center gap-1 bg-black/40 border border-white/10 rounded-lg px-2 py-1">
        <span class="text-[9px] text-gray-400 font-bold">De:</span>
        <input type="date" id="notifModalDateFrom" class="bg-transparent text-white text-[9px] font-bold outline-none w-[100px]" onchange="window.filterModalNotifs()">
       </div>
       <div class="flex items-center gap-1 bg-black/40 border border-white/10 rounded-lg px-2 py-1">
        <span class="text-[9px] text-gray-400 font-bold">Até:</span>
        <input type="date" id="notifModalDateTo" class="bg-transparent text-white text-[9px] font-bold outline-none w-[100px]" onchange="window.filterModalNotifs()">
       </div>
       <button onclick="document.getElementById('allNotifsModal').remove()" class="w-7 h-7 rounded bg-white/5 hover:bg-white/10 text-gray-400 hover:text-white flex items-center justify-center"><span class="material-symbols-outlined text-sm">close</span></button>
      </div>
     </header>
     <div id="allNotifsList" class="p-3 overflow-y-auto custom-scrollbar space-y-1.5 flex-1">
      ${itemsHtml || '<p class="text-center text-[10px] text-gray-500 py-8">Nenhuma notificação</p>'}
     </div>
    </div>
   </div>
  `;
  document.body.insertAdjacentHTML('beforeend', modalHtml);
  const today = new Date();
  const from30 = new Date(today);
  from30.setDate(from30.getDate() - 30);
  document.getElementById('notifModalDateFrom').value = from30.toISOString().split('T')[0];
  document.getElementById('notifModalDateTo').value = today.toISOString().split('T')[0];
 };

 window.filterModalNotifs = function() {
  const from = document.getElementById('notifModalDateFrom')?.value;
  const to = document.getElementById('notifModalDateTo')?.value;
  const items = document.querySelectorAll('#allNotifsList .notif-item');
  items.forEach(item => {
   const date = item.dataset.date;
   if (!from && !to) { item.style.display = 'block'; return; }
   if (from && date < from) { item.style.display = 'none'; return; }
   if (to && date > to) { item.style.display = 'none'; return; }
   item.style.display = 'block';
  });
 };

 // === PRÓXIMAS TAREFAS ===
 const PRIORITY_COLORS = { alta: 'bg-red-500', media: 'bg-amber-500', baixa: 'bg-blue-500', Alta: 'bg-red-500', Media: 'bg-amber-500', Baixa: 'bg-blue-500' };
 const STATUS_LABEL = { a_fazer: 'A Fazer', em_andamento: 'Em Andamento', concluido: 'Concluído', cancelado: 'Cancelado' };
 function formatTaskDate(d) {
  if (!d) return '';
  try { return new Date(d).toLocaleDateString('pt-BR'); } catch (e) { return ''; }
 }

 window.loadUpcomingTasks = async function() {
  const listEl = document.getElementById('upcomingTasksList');
  if (!listEl) return;
  try {
   const res = await fetch('/admin/api/upcoming-tasks?onlyOpen=true&limit=10');
   const data = await res.json();
   if (!data.success || !data.tasks || data.tasks.length === 0) {
    listEl.innerHTML = '<div class="text-center py-4 opacity-50"><p class="text-[9px] ds-text-muted">Nenhuma tarefa pendente</p></div>';
    document.getElementById('upcomingTasksCount').textContent = '0';
    return;
   }
   document.getElementById('upcomingTasksCount').textContent = data.tasks.length;
   listEl.innerHTML = data.tasks.map(t => {
    const isOverdue = t.dueDate && new Date(t.dueDate) < new Date();
    const priorityColor = PRIORITY_COLORS[t.priority] || PRIORITY_COLORS.media;
    return `
     <div class="ds-list-item flex items-center gap-2.5 group" data-task-id="${t.id}">
      <div class="w-2 h-2 rounded-full ${priorityColor} shrink-0"></div>
      <div class="flex-1 min-w-0">
       <h4 class="text-[10px] font-semibold ds-text leading-tight truncate">${(t.title || 'Tarefa').replace(/[<>]/g, '')}</h4>
       <p class="text-[8px] ds-text-muted font-medium">${formatTaskDate(t.dueDate)}${isOverdue ? ' • <span class="text-red-400">Atrasada</span>' : ''}</p>
      </div>
      <div class="flex items-center gap-1 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
       <button onclick="window.completeTask('${t.id}', this)" class="w-5 h-5 rounded bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center hover:bg-emerald-500 hover:text-black transition-all" title="Concluir">
        <span class="material-symbols-outlined text-[10px] text-emerald-400">check</span>
       </button>
       <button onclick="window.cancelTask('${t.id}', this)" class="w-5 h-5 rounded bg-red-500/10 border border-red-500/20 flex items-center justify-center hover:bg-red-500 hover:text-white transition-all" title="Cancelar">
        <span class="material-symbols-outlined text-[10px] text-red-400">close</span>
       </button>
      </div>
     </div>
    `;
   }).join('');
  } catch (err) {
   console.error('Load upcoming tasks error:', err);
   listEl.innerHTML = '<div class="text-center py-4 opacity-50"><p class="text-[9px] ds-text-muted">Erro ao carregar tarefas</p></div>';
  }
 };

 window.showToast = function(message, type = 'success') {
  const container = document.getElementById('toast-container') || (() => {
   const div = document.createElement('div');
   div.id = 'toast-container';
   div.className = 'fixed top-4 right-4 z-[9999] space-y-2 pointer-events-none';
   document.body.appendChild(div);
   return div;
  })();
  const toast = document.createElement('div');
  const bgColor = type === 'success' ? 'bg-emerald-500/90 border-emerald-400' : type === 'error' ? 'bg-red-500/90 border-red-400' : 'bg-cyan-500/90 border-cyan-400';
  toast.className = `pointer-events-auto px-3 py-2 rounded-lg ${bgColor} border text-white text-[10px] font-black uppercase tracking-widest shadow-2xl flex items-center gap-2`;
  toast.innerHTML = `<span class="material-symbols-outlined text-xs">${type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'info'}</span> ${message}`;
  container.appendChild(toast);
  setTimeout(() => { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.3s'; setTimeout(() => toast.remove(), 300); }, 2200);
 };

 window.completeTask = async function(taskId, btn) {
  if (!confirm('Concluir esta tarefa?')) return;
  try {
   btn.disabled = true;
   const res = await fetch(`/admin/api/tasks/${taskId}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: 'concluido' }) });
   const data = await res.json();
   if (data.success) { window.loadUpcomingTasks(); window.showToast('Tarefa concluída!', 'success'); }
   else { window.showToast('Erro ao concluir', 'error'); btn.disabled = false; }
  } catch (err) { console.error(err); window.showToast('Erro de rede', 'error'); btn.disabled = false; }
 };

 window.cancelTask = async function(taskId, btn) {
  if (!confirm('Cancelar esta tarefa?')) return;
  try {
   btn.disabled = true;
   const res = await fetch(`/admin/api/tasks/${taskId}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: 'cancelado' }) });
   const data = await res.json();
   if (data.success) { window.loadUpcomingTasks(); window.showToast('Tarefa cancelada', 'info'); }
   else { window.showToast('Erro ao cancelar', 'error'); btn.disabled = false; }
  } catch (err) { console.error(err); window.showToast('Erro de rede', 'error'); btn.disabled = false; }
 };

 window.openAllTasksModal = async function() {
  const existing = document.getElementById('allTasksModal');
  if (existing) existing.remove();
  const modalHtml = `
   <div id="allTasksModal" class="fixed inset-0 z-[200] flex items-center justify-center bg-black/80 backdrop-blur-sm" style="display:flex;">
    <div class="bg-[#0a0c10] border border-white/10 rounded-2xl shadow-2xl w-full max-w-3xl mx-4 overflow-hidden flex flex-col max-h-[80vh]">
     <header class="p-4 border-b border-white/5 flex items-center justify-between bg-gradient-to-r from-emerald-500/10 to-orange-500/10 shrink-0">
      <div class="flex items-center gap-3">
       <div class="w-9 h-9 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center">
        <span class="material-symbols-outlined text-emerald-400">task_alt</span>
       </div>
       <div>
        <h3 class="text-base font-black text-white tracking-tight">Todas as Tarefas do Sistema</h3>
        <p class="text-[9px] font-bold uppercase tracking-widest text-gray-400">CRM & Modelagem</p>
       </div>
      </div>
      <button type="button" class="w-8 h-8 rounded-lg bg-white/5 hover:bg-white/10 flex items-center justify-center text-gray-400 hover:text-white" onclick="document.getElementById('allTasksModal').remove()">
       <span class="material-symbols-outlined">close</span>
      </button>
     </header>
     <div id="allTasksList" class="p-4 overflow-y-auto custom-scrollbar space-y-2 flex-1">
      <div class="text-center py-8 opacity-50"><p class="text-xs text-gray-400">Carregando...</p></div>
     </div>
    </div>
   </div>
  `;
  document.body.insertAdjacentHTML('beforeend', modalHtml);
  try {
   const res = await fetch('/admin/api/upcoming-tasks');
   const data = await res.json();
   const list = document.getElementById('allTasksList');
   if (!data.success || !data.tasks || data.tasks.length === 0) {
    list.innerHTML = '<div class="text-center py-8 opacity-50"><p class="text-xs text-gray-400">Nenhuma tarefa cadastrada</p></div>';
    return;
   }
   list.innerHTML = data.tasks.map(t => {
    const isOverdue = t.dueDate && new Date(t.dueDate) < new Date() && t.status !== 'concluido' && t.status !== 'cancelado';
    const isDone = t.status === 'concluido';
    const isCancelled = t.status === 'cancelado';
    const priorityColor = PRIORITY_COLORS[t.priority] || PRIORITY_COLORS.media;
    const statusBadge = isDone ? '<span class="px-2 py-0.5 rounded-full bg-emerald-500/20 border border-emerald-500/30 text-[8px] font-black text-emerald-300 uppercase tracking-widest">Concluída</span>' :
                          isCancelled ? '<span class="px-2 py-0.5 rounded-full bg-red-500/20 border border-red-500/30 text-[8px] font-black text-red-300 uppercase tracking-widest">Cancelada</span>' :
                          `<span class="px-2 py-0.5 rounded-full bg-white/10 border border-white/20 text-[8px] font-black text-gray-300 uppercase tracking-widest">${STATUS_LABEL[t.status] || t.status}</span>`;
    return `
     <div class="p-3 rounded-xl bg-white/[0.02] border ${isDone ? 'border-emerald-500/20 opacity-60' : isCancelled ? 'border-red-500/20 opacity-40' : 'border-white/5'} flex items-center gap-3" data-task-id="${t.id}">
      <div class="w-3 h-3 rounded-full ${priorityColor} shrink-0"></div>
      <div class="flex-1 min-w-0">
       <h4 class="text-xs font-bold text-white leading-tight truncate ${isDone ? 'line-through' : ''}">${(t.title || 'Tarefa').replace(/[<>]/g, '')}</h4>
       <div class="flex items-center gap-2 mt-1">
        ${statusBadge}
        <span class="text-[9px] text-gray-400 font-semibold">${formatTaskDate(t.dueDate)}${isOverdue ? ' • <span class="text-red-400">Atrasada</span>' : ''}</span>
       </div>
      </div>
      ${(!isDone && !isCancelled) ? `
       <div class="flex items-center gap-1 shrink-0">
        <button onclick="window.completeTask('${t.id}', this); window.openAllTasksModal();" class="w-7 h-7 rounded-md bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center hover:bg-emerald-500 hover:text-black transition-all" title="Concluir">
         <span class="material-symbols-outlined text-xs text-emerald-400">check</span>
        </button>
        <button onclick="window.cancelTask('${t.id}', this); window.openAllTasksModal();" class="w-7 h-7 rounded-md bg-red-500/10 border border-red-500/30 flex items-center justify-center hover:bg-red-500 hover:text-white transition-all" title="Cancelar">
         <span class="material-symbols-outlined text-xs text-red-400">close</span>
        </button>
       </div>
      ` : ''}
     </div>
    `;
   }).join('');
  } catch (err) { console.error(err); }
 };

 document.addEventListener('DOMContentLoaded', function() {
  if (document.getElementById('upcomingTasksList')) {
   window.loadUpcomingTasks();
   setInterval(window.loadUpcomingTasks, 60000);
  }
 });
</script>