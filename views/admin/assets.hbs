<!-- Header -->
<div class="mb-10 p-8 glass-card border-none bg-gradient-to-br from-white/5 to-white/[0.02]">
 <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
 <div>
 <h1 class="text-4xl font-black text-white tracking-tight mb-2">
 Arsenal <span class="text-gradient">3D</span>
 </h1>
 <p class="text-gray-400 font-medium">
 Biblioteca central de modelos, texturas e assets proprietários da <span class="text-orange-500">Malha3D</span>.
 </p>
 </div>
 <div class="flex flex-col sm:flex-row gap-4">
 <div class="relative group">
 <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-lg group-focus-within:text-orange-500 transition-colors">search</span>
 <input type="text" placeholder="Buscar no arsenal..." class="pl-12 pr-6 py-4 bg-white/5 border border-white/10 rounded-2xl text-sm font-black text-white placeholder:text-gray-600 focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500/50 outline-none w-full sm:w-80 transition-all">
 </div>
 <button class="bg-orange-500 hover:bg-orange-600 text-white font-black py-4 px-8 rounded-2xl shadow-2xl shadow-orange-500/40 transition-all flex items-center justify-center gap-3" data-bs-toggle="modal" data-bs-target="#uploadAssetModal">
 <span class="material-symbols-outlined">upload_file</span>
 Upload de Asset
 </button>
 </div>
 </div>
</div>

<!-- Categories -->
<div class="flex items-center gap-3 mb-10 overflow-x-auto pb-4 no-scrollbar">
 <button class="bg-orange-500 text-white px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest whitespace-nowrap shadow-xl shadow-orange-500/20">Todos Assets</button>
 <button class="bg-white/5 text-gray-500 hover:text-white hover:bg-white/10 border border-white/5 px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest whitespace-nowrap transition-all">Modelos 3D</button>
 <button class="bg-white/5 text-gray-500 hover:text-white hover:bg-white/10 border border-white/5 px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest whitespace-nowrap transition-all">Texturas PBR</button>
 <button class="bg-white/5 text-gray-500 hover:text-white hover:bg-white/10 border border-white/5 px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest whitespace-nowrap transition-all">HDRI</button>
 <button class="bg-white/5 text-gray-500 hover:text-white hover:bg-white/10 border border-white/5 px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest whitespace-nowrap transition-all">Plugins</button>
 <button class="bg-white/5 text-gray-500 hover:text-white hover:bg-white/10 border border-white/5 px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest whitespace-nowrap transition-all">Personagens</button>
</div>

<!-- Assets Grid -->
<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6 mb-12">
 <!-- Asset Item 1 -->
 <div class="group glass-card border-white/5 overflow-hidden hover:shadow-2xl hover:shadow-orange-500/10 transition-all duration-500 cursor-pointer bg-white/[0.01]">
 <div class="aspect-square bg-white/5 relative overflow-hidden">
 <img src="https://images.unsplash.com/photo-1614850523296-d8c1af93d400?w=400&auto=format&fit=crop" class="w-full h-full object-cover group- transition-transform duration-700" alt="">
 <div class="absolute top-3 right-3 flex gap-1 z-20">
 <span class="bg-orange-500 text-white text-[8px] font-black uppercase tracking-widest px-2 py-1 rounded-md shadow-2xl ring-1 ring-white/20">Premium</span>
 </div>
 <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center z-10">
 <span class="material-symbols-outlined text-white text-3xl">download</span>
 </div>
 </div>
 <div class="p-6">
 <h4 class="text-sm font-black text-white truncate group-hover:text-orange-500 transition-colors">Escultura Futurista v1</h4>
 <div class="flex items-center justify-between mt-3">
 <span class="text-[9px] font-black text-gray-600 uppercase tracking-widest">OBJ, FBX, BLEND</span>
 <span class="text-[10px] font-black text-emerald-500 uppercase">Free</span>
 </div>
 </div>
 </div>

 <!-- Asset Item 2 -->
 <div class="group glass-card border-white/5 overflow-hidden hover:shadow-2xl hover:shadow-orange-500/10 transition-all duration-500 cursor-pointer bg-white/[0.01]">
 <div class="aspect-square bg-white/5 relative overflow-hidden">
 <img src="https://images.unsplash.com/photo-1633167606207-d840b5070fc2?w=400&auto=format&fit=crop" class="w-full h-full object-cover group- transition-transform duration-700" alt="">
 <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center z-10">
 <span class="material-symbols-outlined text-white text-3xl">download</span>
 </div>
 </div>
 <div class="p-6">
 <h4 class="text-sm font-black text-white truncate group-hover:text-orange-500 transition-colors">Material Concreto Sci-Fi</h4>
 <div class="flex items-center justify-between mt-3">
 <span class="text-[9px] font-black text-gray-600 uppercase tracking-widest">4K Textures</span>
 <span class="text-[10px] font-black text-emerald-500 uppercase">Free</span>
 </div>
 </div>
 </div>

 <!-- Asset Item 3 -->
 <div class="group glass-card border-white/5 overflow-hidden hover:shadow-2xl hover:shadow-orange-500/10 transition-all duration-500 cursor-pointer bg-white/[0.01]">
 <div class="aspect-square bg-white/5 relative overflow-hidden">
 <img src="https://images.unsplash.com/photo-1550684848-fac1c5b4e853?w=400&auto=format&fit=crop" class="w-full h-full object-cover group- transition-transform duration-700" alt="">
 <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center z-10">
 <span class="material-symbols-outlined text-white text-3xl">download</span>
 </div>
 </div>
 <div class="p-6">
 <h4 class="text-sm font-black text-white truncate group-hover:text-orange-500 transition-colors">Heliporto Cyberpunk</h4>
 <div class="flex items-center justify-between mt-3">
 <span class="text-[9px] font-black text-gray-600 uppercase tracking-widest">Low Poly</span>
 <span class="text-[10px] font-black text-emerald-500 uppercase">Free</span>
 </div>
 </div>
 </div>

 <!-- Add Asset -->
 <div class="group glass-card border-dashed border-white/10 flex flex-col items-center justify-center p-8 hover:bg-white/5 hover:border-orange-500/50 transition-all cursor-pointer opacity-50 hover:opacity-100" data-bs-toggle="modal" data-bs-target="#uploadAssetModal">
 <div class="w-16 h-16 bg-white/5 rounded-2xl flex items-center justify-center text-gray-500 group-hover:text-orange-500 group-hover:bg-orange-500/10 transition-all mb-4 border border-white/10">
 <span class="material-symbols-outlined text-4xl">add_circle</span>
 </div>
 <span class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] group-hover:text-white transition-colors">Novo Asset</span>
 </div>
</div>

<!-- Modal: Upload de Asset -->
<div class="modal fade" id="uploadAssetModal" tabindex="-1" aria-hidden="true">
 <div class="modal-dialog modal-dialog-centered">
 <div class="modal-content glass-card border-white/10 shadow-2xl rounded-[2.5rem] bg-[#0f1115]">
 <div class="modal-header border-white/5 p-8">
 <h2 class="text-xl font-black text-white tracking-tight flex items-center gap-3">
 <span class="material-symbols-outlined text-orange-500">cloud_upload</span>
 Importar Asset para o Arsenal
 </h2>
 <button type="button" class="btn-close btn-close-white opacity-30" data-bs-dismiss="modal"></button>
 </div>
 <form id="uploadAssetForm" enctype="multipart/form-data">
 <div class="modal-body p-8 space-y-6">
 <div class="space-y-2">
 <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Nome do Asset</label>
 <input type="text" name="name" required class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all" placeholder="Ex: Cadeira Moderna v2">
 </div>
 <div class="space-y-2">
 <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Categoria</label>
 <select name="category" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all">
 <option value="model">Modelo 3D</option>
 <option value="texture">Textura PBR</option>
 <option value="hdri">HDRI</option>
 <option value="plugin">Plugin</option>
 </select>
 </div>
 <div class="space-y-2">
 <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Arquivo do Asset</label>
 <div class="border-2 border-dashed border-white/10 rounded-2xl p-8 flex flex-col items-center justify-center gap-3 hover:border-orange-500/30 transition-all cursor-pointer relative">
 <input type="file" name="file" class="absolute inset-0 opacity-0 cursor-pointer">
 <span class="material-symbols-outlined text-3xl text-gray-500">attach_file</span>
 <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Clique para selecionar</span>
 </div>
 </div>
 </div>
 <div class="p-8 bg-black/20 border-t border-white/5 flex justify-end gap-4">
 <button type="button" class="text-[10px] font-black uppercase tracking-widest text-gray-500 hover:text-white" data-bs-dismiss="modal">Cancelar</button>
 <button type="submit" class="bg-orange-500 text-white font-black py-4 px-10 rounded-2xl text-[10px] uppercase tracking-widest shadow-xl shadow-orange-500/20 transition-all">
 Iniciar Upload
 </button>
 </div>
 </form>
 </div>
 </div>
</div>

