<!--
  NEW CARD MODAL — Partial compartilhado (CRM + Projetos)

  Parâmetros:
    - kanbanType: "vendas" (CRM) ou "modelagem" (Projetos)
    - cardTitle: "Criar Novo Lead" ou "Criar Novo Projeto"
    - cardSubtitle: "ArchViz 3D — Aquisição" ou "ArchViz 3D — Produção"
    - helpNote: mensagem opcional abaixo do título
    - columns: array de colunas Kanban (do template)
    - users: array de usuários (do template)
    - kanbanColumns: array de colunas específicas (opcional)
-->
<div id="newLeadModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/80 backdrop-blur-sm" style="display:none;">
 <div class="glass-card w-full max-w-6xl relative rounded-[1.5rem] bg-[#0c0e12]/95 backdrop-blur-3xl shadow-2xl flex flex-col max-h-[90vh]">
 <header class="p-4 border-b border-white/5 flex justify-between items-center bg-white/[0.01] shrink-0">
 <div class="flex items-center gap-3">
 <div class="w-9 h-9 rounded-lg overflow-hidden border border-orange-500/30 flex items-center justify-center bg-orange-500/10">
 <span class="material-symbols-outlined text-orange-500 text-sm">view_in_ar</span>
 </div>
 <div class="min-w-0">
 <h2 class="text-sm font-black text-white tracking-tight mb-0.5">{{cardTitle}}</h2>
 <span class="text-[8px] font-bold text-gray-500 uppercase tracking-widest">{{cardSubtitle}}</span>
 </div>
 </div>
 <button type="button" class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-gray-400 hover:text-white transition-all" onclick="window.closeNewLeadModal();">
 <span class="material-symbols-outlined text-base">close</span>
 </button>
 </header>

 <div class="flex-1 overflow-y-auto p-6 custom-scrollbar" style="max-height: calc(85vh - 70px);">
 <form id="newLeadForm" action="/admin/negociacoes/novo" method="POST" class="space-y-4 text-sm">
 <input type="hidden" name="contacts" id="hiddenContactsJson" value="[]">
 <input type="hidden" name="leadImage" id="hiddenLeadImage" value="/assets/0e36b4cd-1981-46d7-8e91-d4183a39f14a_3840w.webp">
 <input type="hidden" name="kanbanType" id="hiddenKanbanType" value="{{kanbanType}}">

 <!-- TÍTULO GRANDE -->
 <div class="p-3 rounded-xl bg-gradient-to-r from-orange-500/10 to-indigo-500/10 border border-orange-500/20 text-center">
  <h1 class="text-lg font-black text-white uppercase tracking-widest">{{cardTitle}}</h1>
  <p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mt-1">{{#if helpNote}}{{helpNote}}{{else}}Preencha os dados do novo card. Todos os campos são sincronizados automaticamente entre CRM e Projetos.{{/if}}</p>
 </div>

 <!-- BANNER IA ARCHVIZ (GERADO AUTOMATICAMENTE) -->
 <div id="newLeadBannerContainer" class="relative w-full h-28 rounded-xl overflow-hidden shadow-md bg-cover bg-center border border-white/10 flex flex-col justify-between p-3 mb-4" style="background-image: url('/assets/0e36b4cd-1981-46d7-8e91-d4183a39f14a_3840w.webp');">
 <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent pointer-events-none"></div>
 <div class="relative z-10 flex items-center justify-between">
 <span class="text-[9px] font-black uppercase tracking-widest text-orange-400 bg-black/60 px-2 py-1 rounded border border-orange-500/30 backdrop-blur-sm flex items-center gap-1">
 <span class="material-symbols-outlined text-xs">auto_awesome</span> Banner IA
 </span>
 <button type="button" onclick="window.cycleAiBanner()" class="text-[9px] font-black uppercase tracking-widest text-white bg-white/10 hover:bg-orange-500 px-3 py-1 rounded border border-white/20 transition-all flex items-center gap-1">
 <span class="material-symbols-outlined text-xs">refresh</span> Trocar
 </button>
 </div>
 <div class="relative z-10 mt-auto">
 <p class="text-[9px] font-black uppercase tracking-widest text-gray-200">Render 3D ArchViz — Capa automática do Card</p>
 </div>
 </div>

 <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
 <!-- COLUNA 1: DETALHES + CONTATO + ENDEREÇO + EQUIPE -->
 <div class="space-y-4">

 <!-- ═══════════ FLIP CARD: DETALHES DO LEAD ═══════════ -->
 <div class="uv-flip-card uv-flip-card--form">
  <div class="uv-flip-content">
   <div class="uv-flip-back">
    <div class="uv-flip-back-inner">
     <span class="material-symbols-outlined text-2xl">info</span>
     <strong class="text-[9px] uppercase tracking-widest">Detalhes do {{#if (eq kanbanType 'modelagem')}}Projeto{{else}}Lead{{/if}}</strong>
    </div>
   </div>
   <div class="uv-flip-front">
    <div class="uv-flip-img">
     <div class="uv-circle"></div>
     <div class="uv-circle uv-circle-right"></div>
     <div class="uv-circle uv-circle-bottom"></div>
    </div>
    <div class="uv-flip-front-content">
     <small class="uv-flip-badge mb-2">
      <span class="material-symbols-outlined text-[10px] align-middle">info</span> Detalhes do {{#if (eq kanbanType 'modelagem')}}Projeto{{else}}Lead{{/if}}
     </small>
     <div class="space-y-2">
      <div>
       <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Nome {{#if (eq kanbanType 'modelagem')}}do Projeto{{else}}do Lead{{/if}} *</label>
       <input type="text" name="name" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none" placeholder="{{#if (eq kanbanType 'modelagem')}}Ex: Projeto 3D - Prédio Comercial{{else}}Ex: Novo Lead - Construtora Horizonte{{/if}}">
      </div>
      <div>
       <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Metragem (m²)</label>
       <input type="number" step="0.01" name="totalArea" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none" placeholder="350.00">
      </div>
      <div class="grid grid-cols-2 gap-2">
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Data Ganho Oportunidade</label>
        <div class="flex gap-1">
         <input type="date" name="dataGanhoOportunidade" class="flex-1 w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none" style="color-scheme: dark;">
         <button type="button" onclick="const el=this.previousElementSibling; el.focus(); el.showPicker ? el.showPicker() : el.click();" class="w-10 h-10 bg-orange-500/10 border border-orange-500/30 rounded-lg text-orange-400 hover:bg-orange-500/20 transition-all flex items-center justify-center" title="Abrir calendário"><span class="material-symbols-outlined text-xs">calendar_today</span></button>
        </div>
       </div>
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Expectativa de Início</label>
        <div class="flex gap-1">
         <input type="date" name="expectativaInicio" class="flex-1 w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none" style="color-scheme: dark;">
         <button type="button" onclick="const el=this.previousElementSibling; el.focus(); el.showPicker ? el.showPicker() : el.click();" class="w-10 h-10 bg-orange-500/10 border border-orange-500/30 rounded-lg text-orange-400 hover:bg-orange-500/20 transition-all flex items-center justify-center" title="Abrir calendário"><span class="material-symbols-outlined text-xs">calendar_today</span></button>
        </div>
       </div>
      </div>
      <div class="grid grid-cols-2 gap-2">
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Origem do {{#if (eq kanbanType 'modelagem')}}Projeto{{else}}Lead{{/if}}</label>
        <select name="origemProjeto" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none appearance-none">
         <option value="">Selecione a origem...</option>
         <option value="Instagram">Instagram</option>
         <option value="Facebook">Facebook</option>
         <option value="LinkedIn">LinkedIn</option>
         <option value="TikTok">TikTok</option>
         <option value="E-mail">E-mail</option>
         <option value="WhatsApp">WhatsApp</option>
         <option value="Indicação">Indicação</option>
         <option value="Outros">Outros</option>
        </select>
       </div>
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Prazo de Entrega (dias)</label>
        <input type="number" name="prazoDias" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none" placeholder="Ex: 30" min="1">
       </div>
      </div>
      <!-- ETAPA (Kanban) - NOVO LOCAL aqui em Detalhes -->
      {{#if (eq kanbanType 'modelagem')}}
      <div>
       <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Etapa do Projeto</label>
       <select name="status" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none transition-all appearance-none">
        {{#each columns}}
        <option value="{{this.statusKey}}">{{this.title}}</option>
        {{/each}}
       </select>
      </div>
      {{/if}}
      <div>
       <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Observação</label>
       <textarea name="observacao" rows="2" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none" placeholder="Anotações livres..."></textarea>
      </div>
      <div>
       <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Etiquetas (pressione Enter para adicionar)</label>
       <div class="flex flex-wrap gap-1 mb-1" id="newProjectTagsContainer"></div>
       <input type="text" id="newProjectTagInput" placeholder="Digite e pressione Enter..." class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none" onkeydown="if(event.key==='Enter'){event.preventDefault();window.addProjectTag(this.value);this.value='';}">
       <input type="hidden" name="etiquetas" id="newProjectTagsHidden" value="[]">
      </div>
     </div>
    </div>
   </div>
  </div>
 </div>

 <!-- ═══════════ FLIP CARD: CONTATO ═══════════ -->
 <div class="uv-flip-card uv-flip-card--form">
  <div class="uv-flip-content">
   <div class="uv-flip-back">
    <div class="uv-flip-back-inner">
     <span class="material-symbols-outlined text-2xl">contact_page</span>
     <strong class="text-[9px] uppercase tracking-widest">Contato</strong>
    </div>
   </div>
   <div class="uv-flip-front">
    <div class="uv-flip-img">
     <div class="uv-circle"></div>
     <div class="uv-circle uv-circle-right"></div>
     <div class="uv-circle uv-circle-bottom"></div>
    </div>
    <div class="uv-flip-front-content">
     <div class="flex items-center justify-between mb-2">
      <small class="uv-flip-badge">
       <span class="material-symbols-outlined text-[10px] align-middle">contact_page</span> Contato
      </small>
      <div class="flex items-center gap-1">
       <button type="button" onclick="window.openContactQuickModal('{{kanbanType}}', function(c){ window.fillNewLeadContactFromModal(c); })" class="text-[7px] font-black uppercase tracking-wider px-2 py-1 rounded-md bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 hover:bg-cyan-500 hover:text-black transition-all flex items-center gap-1" title="Vincular contato existente ou criar novo">
        <span class="material-symbols-outlined text-[10px]">contacts</span> Menu Contatos
       </button>
      </div>
     </div>
     <div class="space-y-2">
      <div>
       <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Nome do Contato</label>
       <input type="text" name="clientName" id="mainClientName" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none transition-all" placeholder="Nome do Cliente">
      </div>
      <div class="grid grid-cols-2 gap-2">
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Email</label>
        <input type="email" name="email" id="mainClientEmail" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none transition-all" placeholder="email@exemplo.com">
       </div>
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Telefone</label>
        <input type="text" name="phone" id="mainClientPhone" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none transition-all" placeholder="(xx) xxxxx-xxxx">
       </div>
      </div>
      <div class="grid grid-cols-2 gap-2">
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Estado</label>
        <select id="newLeadState" name="state" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none transition-all appearance-none">
         <option value="">Carregando...</option>
        </select>
       </div>
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Cidade</label>
        <select id="newLeadCity" name="city" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none transition-all appearance-none" disabled>
         <option value="">Selecione o Estado...</option>
        </select>
       </div>
      </div>
      <div id="extraContactsContainer" class="space-y-2"></div>
      <button type="button" onclick="window.openAddContactOptions()" class="text-[8px] font-black uppercase tracking-wider px-2.5 py-1 rounded-lg flex items-center gap-1 bg-orange-500/10 text-orange-400 border border-orange-500/30 hover:bg-orange-500/20 transition-all">
       <span class="material-symbols-outlined text-xs">add</span> Adicionar Contato (<span id="contactCountBadge">1</span>/5)
      </button>
     </div>
    </div>
   </div>
  </div>
 </div>

 <!-- ═══════════ FLIP CARD: ENDEREÇO ═══════════ -->
 <div class="uv-flip-card uv-flip-card--form">
  <div class="uv-flip-content">
   <div class="uv-flip-back">
    <div class="uv-flip-back-inner">
     <span class="material-symbols-outlined text-2xl">location_on</span>
     <strong class="text-[9px] uppercase tracking-widest">Endereço</strong>
    </div>
   </div>
   <div class="uv-flip-front">
    <div class="uv-flip-img">
     <div class="uv-circle"></div>
     <div class="uv-circle uv-circle-right"></div>
     <div class="uv-circle uv-circle-bottom"></div>
    </div>
    <div class="uv-flip-front-content">
     <div class="flex items-center justify-between mb-2">
      <small class="uv-flip-badge">
       <span class="material-symbols-outlined text-[10px] align-middle">location_on</span> Endereço
      </small>
      <label class="relative inline-flex items-center cursor-pointer">
       <input type="checkbox" id="toggleAddressBlock" class="sr-only peer" checked onchange="document.getElementById('addressBlockContent').classList.toggle('hidden', !this.checked);">
       <div class="w-8 h-4 bg-gray-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-3 after:w-3 peer-checked:bg-purple-500"></div>
      </label>
     </div>
     <div id="addressBlockContent" class="space-y-2">
      <div class="grid grid-cols-3 gap-2">
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">CEP</label>
        <input type="text" name="cep" id="newProjectCep" maxlength="9" placeholder="00000-000" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-purple-500 focus:outline-none" oninput="var v=this.value.replace(/\D/g,''); if(v.length>5) this.value=v.substring(0,5)+'-'+v.substring(5,8); else this.value=v; window.autoFillCep(this.value, 'newProject');">
       </div>
       <div class="col-span-2">
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Rua</label>
        <input type="text" name="rua" id="newProjectRua" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-purple-500 focus:outline-none" placeholder="Preenchido via CEP ou digite manualmente">
       </div>
      </div>
      <div class="grid grid-cols-3 gap-2">
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Número</label>
        <input type="text" name="numero" id="newProjectNumero" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-purple-500 focus:outline-none" placeholder="Nº">
       </div>
       <div class="col-span-2">
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Complemento</label>
        <input type="text" name="complemento" id="newProjectComplemento" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-purple-500 focus:outline-none" placeholder="Apto, Sala...">
       </div>
      </div>
      <div class="grid grid-cols-3 gap-2">
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Bairro</label>
        <input type="text" name="bairro" id="newProjectBairro" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-purple-500 focus:outline-none" placeholder="Preenchido via CEP ou digite">
       </div>
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Estado (UF)</label>
        <input type="text" name="state" id="newProjectEstado" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-purple-500 focus:outline-none" placeholder="Ex: PR" maxlength="2">
       </div>
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Cidade</label>
        <input type="text" name="city" id="newProjectCidade" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-purple-500 focus:outline-none" placeholder="Ex: Curitiba">
       </div>
      </div>
     </div>
    </div>
   </div>
  </div>
 </div>

 <!-- ═══════════ FLIP CARD: EQUIPE / RESPONSÁVEIS ═══════════ -->
 <div class="uv-flip-card uv-flip-card--form">
  <div class="uv-flip-content">
   <div class="uv-flip-back">
    <div class="uv-flip-back-inner">
     <span class="material-symbols-outlined text-2xl">groups</span>
     <strong class="text-[9px] uppercase tracking-widest">Equipe / Responsáveis</strong>
    </div>
   </div>
   <div class="uv-flip-front">
    <div class="uv-flip-img">
     <div class="uv-circle"></div>
     <div class="uv-circle uv-circle-right"></div>
     <div class="uv-circle uv-circle-bottom"></div>
    </div>
    <div class="uv-flip-front-content">
     <div class="flex items-center justify-between mb-2">
      <small class="uv-flip-badge">
       <span class="material-symbols-outlined text-[10px] align-middle">groups</span> Equipe / Responsáveis
      </small>
      <button type="button" onclick="window.addModelagemResponsavel()" class="w-5 h-5 rounded-md bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center hover:bg-cyan-500 hover:text-black transition-all" title="Adicionar Responsável">
       <span class="material-symbols-outlined text-xs text-cyan-400">add</span>
      </button>
     </div>
     <div class="space-y-2">
      <div id="modelagemResponsaveisList" class="space-y-1.5">
       <div class="flex items-center gap-2 p-2 rounded-lg bg-black/30 border border-white/5 modelagem-resp-item">
        <div class="flex-1">
         <button type="button" class="w-full text-left px-2 py-1.5 rounded bg-white/5 border border-white/10 text-xs text-white hover:border-orange-500 transition-all flex items-center gap-2" onclick="window.toggleResponsavelMenu(this)">
          <span class="material-symbols-outlined text-xs">person</span>
          <span id="respPreview_0" class="flex-1">Selecione um responsável...</span>
          <span class="material-symbols-outlined text-xs">expand_more</span>
         </button>
         <!-- Menu dropdown para Equipe + Freelancers -->
         <div class="hidden absolute mt-1 w-full max-w-[300px] bg-[#151515] border border-white/10 rounded-lg shadow-2xl z-50 max-h-[300px] overflow-y-auto" id="respMenu_0">
          <div class="p-2 space-y-1">
           <!-- SEÇÃO: EQUIPE DA EMPRESA -->
           <div class="px-2 py-1">
            <p class="text-[7px] font-black text-amber-400 uppercase tracking-widest mb-1 flex items-center gap-1">
             <span class="material-symbols-outlined text-xs">corporate_fare</span> Equipe da Empresa
            </p>
            <div class="space-y-0.5">
             {{#each users}}
              {{#unless (eq this.role 'freelancer')}}
              <button type="button" onclick="window.selectResponsavel(0, '{{this.id}}', '{{this.name}}')" class="w-full text-left px-2 py-1.5 rounded text-[9px] text-gray-300 hover:bg-white/10 hover:text-white transition-all">
               <span class="material-symbols-outlined text-[10px] align-middle">person</span> {{this.name}}
              </button>
              {{/unless}}
             {{/each}}
            </div>
           </div>
           <!-- SEÇÃO: FREELANCERS -->
           <div class="border-t border-white/10 px-2 py-1">
            <p class="text-[7px] font-black text-purple-400 uppercase tracking-widest mb-1 flex items-center gap-1">
             <span class="material-symbols-outlined text-xs">engineering</span> Freelancers
            </p>
            <div class="space-y-0.5">
             {{#each users}}
              {{#if (eq this.role 'freelancer')}}
              <button type="button" onclick="window.selectResponsavel(0, '{{this.id}}', '{{this.name}}')" class="w-full text-left px-2 py-1.5 rounded text-[9px] text-gray-300 hover:bg-white/10 hover:text-white transition-all">
               <span class="material-symbols-outlined text-[10px] align-middle">engineering</span> {{this.name}}
              </button>
              {{/if}}
             {{/each}}
            </div>
           </div>
          </div>
         </div>
         <!-- Hidden: Armazenar dados dos usuários para uso em JS -->
         <div style="display:none;" id="usersDataJson">{{#each users}}{{json this}}{{#unless @last}},{{/unless}}{{/each}}</div>
        </div>
       </div>
      </div>
     </div>
    </div>
    <input type="hidden" name="assignedUserId[]" id="respId_0" value="">
        <button type="button" onclick="this.closest('.modelagem-resp-item').remove(); window.reindexModelagemResps();" class="w-6 h-6 rounded-md bg-red-500/10 border border-red-500/30 flex items-center justify-center hover:bg-red-500 hover:text-white transition-all" title="Remover">
         <span class="material-symbols-outlined text-xs text-red-400">close</span>
        </button>
       </div>
      </div>
     </div>
    </div>
   </div>
  </div>
 </div>

 </div>

 <!-- COLUNA 2: ENTREGÁVEIS -->
 <div class="space-y-4">

 <!-- ═══════════ FLIP CARD: INFORMAÇÕES DO CARD ═══════════ -->
 <div class="uv-flip-card uv-flip-card--form">
  <div class="uv-flip-content">
   <div class="uv-flip-back">
    <div class="uv-flip-back-inner">
     <span class="material-symbols-outlined text-2xl">inventory_2</span>
     <strong class="text-[9px] uppercase tracking-widest">Informações do Card</strong>
    </div>
   </div>
   <div class="uv-flip-front">
    <div class="uv-flip-img">
     <div class="uv-circle"></div>
     <div class="uv-circle uv-circle-right"></div>
     <div class="uv-circle uv-circle-bottom"></div>
    </div>
    <div class="uv-flip-front-content">
     <small class="uv-flip-badge mb-2">
      <span class="material-symbols-outlined text-[10px] align-middle">inventory_2</span> Informações do Card
     </small>
     <div class="space-y-2">
      <!-- TIPOLOGIA: 3 BOTÕES FUNDAMENTAIS -->
      <div>
       <label class="block text-[8px] text-gray-400 font-bold uppercase mb-2">Tipologia</label>
       <div class="grid grid-cols-3 gap-2">
        <button type="button" onclick="window.selectProjectType(this, 'Renderização')" class="px-3 py-3 rounded-lg bg-white/5 border-2 border-white/10 text-xs font-bold text-white hover:border-orange-500 hover:bg-orange-500/10 transition-all flex items-center justify-center gap-1.5 project-type-btn" data-type="Renderização">
         <span class="material-symbols-outlined text-sm">photo_camera</span>
         <span>Renderização</span>
        </button>
        <button type="button" onclick="window.selectProjectType(this, 'Modelagem')" class="px-3 py-3 rounded-lg bg-white/5 border-2 border-white/10 text-xs font-bold text-white hover:border-purple-500 hover:bg-purple-500/10 transition-all flex items-center justify-center gap-1.5 project-type-btn" data-type="Modelagem">
         <span class="material-symbols-outlined text-sm">account_tree</span>
         <span>Modelagem</span>
        </button>
        <button type="button" onclick="window.selectProjectType(this, 'Preparo')" class="px-3 py-3 rounded-lg bg-white/5 border-2 border-white/10 text-xs font-bold text-white hover:border-blue-500 hover:bg-blue-500/10 transition-all flex items-center justify-center gap-1.5 project-type-btn" data-type="Preparo">
         <span class="material-symbols-outlined text-sm">engineering</span>
         <span>Preparo</span>
        </button>
       </div>
       <input type="hidden" name="projectType" id="newLeadProjectType" value="">
      </div>

      <!-- VALOR ESTIMADO + PROBABILIDADE -->
      <div class="grid grid-cols-2 gap-2">
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Valor Estimado (R$)</label>
        <input type="number" step="0.01" name="estimatedValue" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none transition-all" placeholder="0.00">
       </div>
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Probabilidade (%)</label>
        <input type="number" min="0" max="100" name="probability" value="50" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none transition-all">
       </div>
      </div>

      <!-- PRIORIDADE -->
      <div>
       <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Prioridade</label>
       <select name="priority" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none transition-all appearance-none">
        <option value="baixa">Baixa</option>
        <option value="media" selected>Média</option>
        <option value="alta">Alta</option>
       </select>
      </div>

      <!-- ENTREGÁVEIS — 5 Produtos × 3 Períodos (Diurna/Noturna/Misto) -->
      <div class="p-3 rounded-[5px] border border-white/10 bg-white/[0.02] space-y-2">
       <h5 class="text-[9px] font-black text-emerald-400 uppercase tracking-widest mb-1 flex items-center gap-1.5">
        <span class="material-symbols-outlined text-xs">inventory_2</span> Entregáveis
       </h5>

       <!-- Cabeçalho -->
       <div class="grid grid-cols-[1fr_48px_48px_48px] gap-1 items-end">
        <span></span>
        <span class="text-[7px] font-black text-amber-400 uppercase text-center">☀️ Dia</span>
        <span class="text-[7px] font-black text-indigo-400 uppercase text-center">🌙 Noite</span>
        <span class="text-[7px] font-black text-cyan-400 uppercase text-center">🔀 Misto</span>
       </div>

       <!-- 1. Imagens -->
       <div class="grid grid-cols-[1fr_48px_48px_48px] gap-1 items-center">
        <label class="text-[8px] text-gray-300 font-bold uppercase flex items-center gap-1"><span class="material-symbols-outlined text-[11px] text-gray-500">image</span> Imagens</label>
        <input type="number" name="imagesCountDiurna" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
        <input type="number" name="imagesCountNoturna" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
        <input type="number" name="imagesCountMisto" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
       </div>

       <!-- 2. Animação (s) -->
       <div class="grid grid-cols-[1fr_48px_48px_48px] gap-1 items-center">
        <label class="text-[8px] text-gray-300 font-bold uppercase flex items-center gap-1"><span class="material-symbols-outlined text-[11px] text-gray-500">movie</span> Animação (s)</label>
        <input type="number" name="animationSecondsDiurna" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
        <input type="number" name="animationSecondsNoturna" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
        <input type="number" name="animationSecondsMisto" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
       </div>

       <!-- 3. Plantas Humanizadas -->
       <div class="grid grid-cols-[1fr_48px_48px_48px] gap-1 items-center">
        <label class="text-[8px] text-gray-300 font-bold uppercase flex items-center gap-1"><span class="material-symbols-outlined text-[11px] text-gray-500">floor</span> Plantas Hum.</label>
        <input type="number" name="floorPlansCountDiurna" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
        <input type="number" name="floorPlansCountNoturna" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
        <input type="number" name="floorPlansCountMisto" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
       </div>

       <!-- 4. Render 360° -->
       <div class="grid grid-cols-[1fr_48px_48px_48px] gap-1 items-center">
        <label class="text-[8px] text-gray-300 font-bold uppercase flex items-center gap-1"><span class="material-symbols-outlined text-[11px] text-gray-500">360</span> Render 360°</label>
        <input type="number" name="panoramas360Diurna" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
        <input type="number" name="panoramas360Noturna" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
        <input type="number" name="panoramas360Misto" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
       </div>

       <!-- 5. Animação IA -->
       <div class="grid grid-cols-[1fr_48px_48px_48px] gap-1 items-center">
        <label class="text-[8px] text-gray-300 font-bold uppercase flex items-center gap-1"><span class="material-symbols-outlined text-[11px] text-gray-500">smart_toy</span> Animação IA</label>
        <input type="number" name="animationAIDiurna" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
        <input type="number" name="animationAINoturna" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
        <input type="number" name="animationAIMisto" min="0" value="0" class="w-full bg-white/5 border border-white/10 rounded px-1 py-1.5 text-[10px] text-center text-white focus:border-orange-500 focus:outline-none">
       </div>

       <!-- Totais (calculados e enviados ao backend) -->
       <input type="hidden" name="imagesCount" id="imagesCountTotal" value="0">
       <input type="hidden" name="animationSeconds" id="animationSecondsTotal" value="0">
       <input type="hidden" name="floorPlansCount" id="floorPlansCountTotal" value="0">
       <input type="hidden" name="panoramas360" id="panoramas360Total" value="0">
       <input type="hidden" name="animationAI" id="animationAITotal" value="0">
      </div>

      <!-- PRAZOS -->
      <div class="grid grid-cols-2 gap-2">
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Prazo (Dias)</label>
        <input type="number" name="productionDays" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none transition-all" placeholder="Ex: 15">
       </div>
       <div>
        <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Deadline (Data)</label>
        <input type="date" name="deadline" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none transition-all">
       </div>
      </div>

      <!-- REVISÕES -->
      <div>
       <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Revisões Inclusas</label>
       <input type="number" name="revisionsIncluded" min="0" max="10" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none transition-all" placeholder="2">
      </div>

      <!-- LINK DRIVE -->
      <div>
       <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Link Drive/Moodboard</label>
       <input type="url" name="driveLink" placeholder="https://" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none transition-all">
      </div>

      <!-- SOFTWARE ALVO -->
      <div>
       <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Software Alvo</label>
       <select name="targetSoftware" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none appearance-none">
        <option value="D5 Render">D5 Render</option>
        <option value="Corona">Corona Renderer</option>
        <option value="V-Ray" selected>V-Ray</option>
        <option value="3ds Max">3ds Max</option>
        <option value="Blender">Blender</option>
        <option value="Unreal Engine 5">Unreal Engine 5</option>
       </select>
      </div>

      <!-- FORMATO DE ARQUIVO -->
      <div>
       <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Formato de Arquivo</label>
       <input type="text" name="visualStyle" placeholder="Ex: SketchUp, DWG, PDF" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none">
      </div>
     </div><!-- /space-y-2 -->
    </div>
   </div>
  </div>
 </div>

 </div><!-- /coluna 2 -->
 </div><!-- /grid -->

 </form>
 </div>

