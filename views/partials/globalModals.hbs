                            <div class="space-y-1.5">
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Briefing Técnico</label>
                                <textarea name="description" rows="2" class="input-premium-compact resize-none py-3" placeholder="Informações cruciais para a produção..."></textarea>
                            </div>
                        </div>

                        <!-- Right Column: Sidebar -->
                        <div class="space-y-4">
                            <div class="bg-white/[0.02] p-5 rounded-2xl border border-white/5 space-y-4">
                                <h4 class="text-[9px] font-black text-emerald-500 uppercase tracking-[0.2em] mb-2">Comercial</h4>
                                <div class="space-y-1.5">
                                    <label class="text-[8px] font-black text-gray-600 uppercase tracking-widest">Valor do Projeto (R$)</label>
                                    <input type="number" name="price" class="input-premium-compact h-10 text-emerald-400 font-black" placeholder="0,00">
                                </div>
                                <div class="space-y-1.5">
                                    <label class="text-[8px] font-black text-gray-600 uppercase tracking-widest">Prazo Final</label>
                                    <input type="date" name="deadline" class="input-premium-compact h-10">
