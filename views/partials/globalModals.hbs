<!-- 2. Modal: Novo Cadastro (Stakeholders / CRM Compact) -->
<div class="modal fade" id="newRegistryModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content glass-card border-white/10 shadow-2xl rounded-[2rem] bg-[#0a0c10]/98 backdrop-blur-3xl overflow-hidden scale-90">
            <div class="modal-header border-white/5 p-6">
                <h2 class="text-lg font-black text-white tracking-tight flex items-center gap-3">
                    <span class="material-symbols-outlined text-orange-500">person_add</span>
                    Identificar Stakeholder
                </h2>
                <button type="button" class="btn-close btn-close-white scale-75 opacity-30" data-bs-dismiss="modal"></button>
            </div>
            <form id="globalRegistryForm" class="p-0">
                <div class="modal-body p-6 space-y-5">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Tipo de Stakeholder</label>
                            <select name="category" class="input-premium-compact h-10" required>
                                <option value="Cliente">Cliente Final</option>
                                <option value="Lead">Lead / Prospect</option>
                                <option value="Parceiro">Parceiro / Freelancer</option>
                                <option value="Fornecedor">Fornecedor / Hardware</option>
                            </select>
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Status Contato</label>
                            <select name="status" class="input-premium-compact h-10">
                                <option value="active">Ativo</option>
                                <option value="prospect">Em Negociação</option>
                                <option value="inactive">Inativo</option>
                            </select>
                        </div>
                    </div>

                    <!-- PF/PJ Toggle -->
                    <div class="space-y-1.5">
                        <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Tipo de Pessoa</label>
                        <div class="flex gap-2 p-1 bg-white/5 rounded-xl border border-white/10">
                            <button type="button" id="reg-toggle-pf" class="flex-1 py-2 px-3 rounded-lg text-[9px] font-black uppercase tracking-widest text-center transition-all bg-orange-500 text-white" onclick="setGlobalRegPersonType('PF')">Pessoa Física (PF)</button>
                            <button type="button" id="reg-toggle-pj" class="flex-1 py-2 px-3 rounded-lg text-[9px] font-black uppercase tracking-widest text-center transition-all text-gray-400 hover:text-white" onclick="setGlobalRegPersonType('PJ')">Pessoa Jurídica (PJ)</button>
                        </div>
                        <input type="hidden" name="type" id="reg-type" value="PF">
                    </div>

                    <div class="space-y-1.5">
                        <label id="reg-label-name" class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Nome Completo</label>
                        <input type="text" name="name" required class="input-premium-compact h-10" placeholder="Ex: Leonardo Zanoello">
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label id="reg-label-document" class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">CPF</label>
                            <input type="text" name="document" id="reg-document" required class="input-premium-compact h-10" placeholder="000.000.000-00">
                        </div>
                        <div class="space-y-1.5" id="reg-group-company">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Empresa / Studio (Opcional)</label>
                            <input type="text" name="company" id="reg-company" class="input-premium-compact h-10" placeholder="Ex: Studio Alpha">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">E-mail</label>
                            <input type="email" name="email" required class="input-premium-compact h-10" placeholder="contato@empresa.com">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">WhatsApp</label>
                            <input type="text" name="phone" id="reg-phone" class="input-premium-compact h-10" placeholder="(00) 00000-0000">
                        </div>
                    </div>

                    <!-- IBGE State and City Selects -->
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Estado</label>
                            <select name="state" id="reg-state" class="input-premium-compact h-10" required>
                                <option value="">Carregando...</option>
                            </select>
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Cidade</label>
                            <select name="city" id="reg-city" class="input-premium-compact h-10" required disabled>
                                <option value="">Selecione o Estado...</option>
                            </select>
                        </div>
                    </div>

                    <!-- Dynamic Payment Methods Checklist -->
                    <div class="space-y-1.5">
                        <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Formas de Pagamento Permitidas</label>
                        <div id="reg-payment-methods" class="grid grid-cols-1 gap-2 p-3 bg-white/5 rounded-xl border border-white/10 max-h-32 overflow-y-auto no-scrollbar text-[9px] font-bold text-gray-300">
                            <!-- Populated by JS -->
                        </div>
                    </div>

                    <!-- Observations -->
                    <div class="space-y-1.5">
                        <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Observações</label>
                        <textarea name="notes" class="input-premium-compact py-2 h-16 no-scrollbar resize-none" placeholder="Observações importantes..."></textarea>
                    </div>

                    <button type="submit" class="w-full bg-white/10 hover:bg-white/20 text-white font-black py-4 rounded-xl transition-all text-[10px] uppercase tracking-widest border border-white/10 mt-4">
                        CONFIRMAR CADASTRO
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 3. Modal: Nova Transação Financeira -->
<div class="modal fade" id="newTransactionModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-white/10 shadow-2xl rounded-[2.5rem] bg-[#0a0c10]/95 backdrop-blur-3xl overflow-hidden">
            <div class="modal-header border-white/5 p-8 flex flex-col items-start gap-4">
                <div class="flex items-center justify-between w-full">
                    <h2 class="text-xl font-black text-white tracking-tighter flex items-center gap-3">
                        <span class="material-symbols-outlined text-orange-500">payments</span>
                        Nova Transação <span class="text-[9px] bg-cyber-500/10 text-cyber-500 px-2 py-0.5 rounded uppercase font-black">Enterprise Finance</span>
                    </h2>
                    <button type="button" class="btn-close btn-close-white scale-75 opacity-30" data-bs-dismiss="modal"></button>
                </div>
                
                <!-- Modal Tabs -->
                <ul class="nav nav-tabs border-0 flex gap-6 w-full" id="transactionModalTabs">
                    <li class="nav-item">
                        <button class="nav-link active border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-cyber-500 py-2 px-0 relative group" data-bs-toggle="tab" data-bs-target="#trans-details">
                            Dados da Transação
                            <div class="absolute bottom-0 left-0 w-full h-0.5 bg-cyber-500"></div>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link border-0 bg-transparent text-[10px] font-black uppercase tracking-widest text-gray-500 py-2 px-0 hover:text-white transition-all relative group" data-bs-toggle="tab" data-bs-target="#trans-concilia">
                            Conciliação & Anexos
                            <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyber-500 group-hover:w-full transition-all"></div>
                        </button>
                    </li>
                </ul>
            </div>
            <form id="globalTransactionForm" class="p-0">
                <div class="modal-body p-8 tab-content">
                    <!-- Tab 1: Basic Info -->
                    <div class="tab-pane fade show active space-y-6" id="trans-details">
                        <div class="grid grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Tipo de Fluxo</label>
                                <select name="type" class="input-premium h-12">
                                    <option value="receita">Receita (+)</option>
                                    <option value="despesa">Despesa (-)</option>
                                </select>
                            </div>
                            <div class="space-y-2">
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Valor Transação (R$)</label>
                                <input type="number" name="amount" required step="0.01" class="input-premium h-12 text-lg font-black" placeholder="0,00">
                            </div>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Descrição do Lançamento</label>
                            <input type="text" name="description" required class="input-premium h-12" placeholder="Ex: Parcela 1/3 - Projeto Alpha Arch">
                        </div>
                        <div class="grid grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Plano de Contas</label>
                                <select name="accountPlan" class="input-premium h-12">
                                    <option value="Serviços 3D">Serviços 3D / Archviz</option>
                                    <option value="Assinaturas">Assinaturas SaaS</option>
                                    <option value="Softwares">Softwares & Plugins</option>
                                    <option value="Marketing">Marketing & Ads</option>
                                    <option value="Infraestrutura">Infra & Hardware</option>
                                    <option value="Pessoal">Pessoal / Pro-labore</option>
                                </select>
                            </div>
                            <div class="space-y-2">
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Centro de Custo</label>
                                <select name="costCenter" class="input-premium h-12">
                                    <option value="Geral">Administrativo Geral</option>
                                    <option value="Produção">Produção 3D</option>
                                    <option value="Vendas">Comercial & Vendas</option>
                                    <option value="P&D">P&D / Inovação</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 2: Conciliation -->
                    <div class="tab-pane fade space-y-6" id="trans-concilia">
                        <div class="grid grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Data de Vencimento</label>
                                <input type="date" name="dueDate" required class="input-premium h-12">
                            </div>
                            <div class="space-y-2">
                                <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Meio de Recebimento/Pagto</label>
                                <select name="paymentMethod" class="input-premium h-12">
                                    <option value="PIX">PIX (Instantâneo)</option>
                                    <option value="Boleto">Boleto Bancário</option>
                                    <option value="Cartão">Cartão de Crédito</option>
                                    <option value="Transferência">TED / DOC</option>
                                </select>
                            </div>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[9px] font-black text-gray-500 uppercase tracking-widest px-1">Status Atual</label>
                            <select name="status" class="input-premium h-12">
                                <option value="pendente">Pendente / Em Aberto</option>
                                <option value="pago">Liquidado / Pago</option>
                                <option value="atrasado">Vencido / Atrasado</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="p-8 border-t border-white/5">
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black py-5 rounded-2xl shadow-xl shadow-emerald-600/20 transition-all text-[10px] uppercase tracking-[0.2em]">
                        Registrar Transação Financeira
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .input-premium-compact {
        width: 100%;
        background-color: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 0.75rem;
        padding: 0.5rem 0.875rem;
        font-size: 0.7rem;
        color: white;
        transition: all 0.2s ease;
        font-weight: 600;
        outline: none;
