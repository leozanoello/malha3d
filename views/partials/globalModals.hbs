                                    <div class="space-y-1.5">
                                        <label class="text-[8px] font-black text-gray-600 uppercase tracking-widest">Nível de Detalhe</label>
                                        <select name="lod" class="input-premium-compact h-9">
                                            <option value="Low">Conceitual</option>
                                            <option value="High">Foto-realismo</option>
                                        </select>
                                    </div>
                                </div>
