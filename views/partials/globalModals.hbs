    let activeTaskId = null;
    let activeProjectDetailsId = null;
    let timerInterval = null;
    let secondsElapsed = 0;

    window.openTaskDetails = async function(taskId) {
        activeTaskId = taskId;
        try {
            const res = await fetch(`/admin/api/tasks/${taskId}`);
            const data = await res.json();
            if (!data.success) {
                alert('Erro ao carregar detalhes da tarefa: ' + data.error);
                return;
            }

            const task = data.task;
            activeProjectDetailsId = task.milestone?.project?.id;
            
            // Text values
            document.getElementById('task-modal-title').innerText = task.title;
            document.getElementById('task-modal-description').innerText = task.description || 'Sem descrição cadastrada.';
            document.getElementById('task-modal-status').innerText = (task.status || 'a_fazer').replace('_', ' ').toUpperCase();
            document.getElementById('task-modal-milestone-title').innerText = task.milestone?.title || 'SEM MARCO';
            document.getElementById('task-modal-round').innerText = `🔄 Rev ${task.revisionRound || 0}`;

            const customer = task.milestone?.project?.customer || task.milestone?.project?.client;
            if (customer) {
                document.getElementById('task-modal-client-name').innerText = `Cliente: ${customer.name}`;
                const whatsapp = customer.phoneWhatsapp || customer.phone || '';
                const cleanPhone = whatsapp.replace(/\D/g, '');
                if (cleanPhone) {
                    document.getElementById('task-modal-whatsapp-link').href = `https://wa.me/${cleanPhone}`;
                    document.getElementById('task-modal-whatsapp-link').classList.remove('hidden');
                } else {
                    document.getElementById('task-modal-whatsapp-link').classList.add('hidden');
                }
            } else {
                document.getElementById('task-modal-client-name').innerText = 'Cliente: Sem Vínculo';
                document.getElementById('task-modal-whatsapp-link').classList.add('hidden');
            }

            // Milestone selector list load
            if (activeProjectDetailsId) {
                try {
                    const mRes = await fetch(`/admin/api/projects/${activeProjectDetailsId}/milestones`);
                    const mData = await mRes.json();
                    const select = document.getElementById('task-modal-milestone-select');
                    if (select && mData.success && mData.milestones) {
                        select.innerHTML = mData.milestones.map(m => `
                            <option value="${m.id}" ${m.id === task.milestoneId ? 'selected' : ''}>${m.title}</option>
                        `).join('');
                    }
                } catch (mErr) {
                     console.error('Erro ao carregar marcos:', mErr);
                }
            }

            // Time Tracking values
            document.getElementById('task-time-estimated').innerText = `${task.estimatedMinutes || 0} min`;
            const spentEl = document.getElementById('task-time-spent');
            spentEl.innerText = `${task.spentMinutes || 0} min`;
            
            // Progress Bar
            const totalEst = task.estimatedMinutes || 1;
            const spent = task.spentMinutes || 0;
            const timeProgress = Math.min(100, Math.round((spent / totalEst) * 100));
            const progressBar = document.getElementById('task-time-progress-bar');
            progressBar.style.width = `${timeProgress}%`;
            
            if (spent > totalEst) {
                progressBar.className = 'h-full bg-gradient-to-r from-red-500 to-rose-600 animate-pulse';
                spentEl.className = 'text-xs font-bold text-red-500 font-mono';
            } else {
                progressBar.className = 'h-full bg-indigo-500 transition-all duration-500';
                spentEl.className = 'text-xs font-bold text-indigo-400 font-mono';
            }

            // Populate UNC Path
            const clientName = (customer?.name || 'CLIENTE').toUpperCase().replace(/[^A-Z0-9\s-_]/g, '').trim();
            const projectTitle = (task.milestone?.project?.title || 'PROJETO').toUpperCase().replace(/[^A-Z0-9\s-_]/g, '').trim();
            const uncPath = `\\\\ZANOELLO-SERVER\\Projetos\\${clientName}\\${projectTitle}`;
            const uncInput = document.getElementById('task-unc-path-display');
            if (uncInput) {
                uncInput.value = uncPath;
            }

            // Dependency Block check
            const pendingDependencies = (task.dependencies || []).filter(dep => dep.status !== 'concluido');
            const timerBtn = document.getElementById('btn-task-timer-toggle');
            const alertBanner = document.getElementById('task-dependency-blocked-banner');
            
            if (pendingDependencies.length > 0) {
                timerBtn.disabled = true;
                timerBtn.classList.add('opacity-50', 'cursor-not-allowed');
                timerBtn.title = 'Esta tarefa está bloqueada por dependências pendentes.';
                
                const blockedNames = pendingDependencies.map(dep => dep.title).join(', ');
                alertBanner.innerHTML = `
                    <div class="p-3 bg-red-500/10 border border-red-500/20 text-red-400 text-xs rounded-xl flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">warning</span>
                        <span>Bloqueado pelas tarefas: <strong>${blockedNames}</strong></span>
                    </div>
                `;
                alertBanner.classList.remove('hidden');
            } else {
                timerBtn.disabled = false;
                timerBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                timerBtn.removeAttribute('title');
                alertBanner.classList.add('hidden');
            }

            // Load QC checklist checkboxes
            const qcState = JSON.parse(localStorage.getItem(`qc_${taskId}`) || '{}');
            document.querySelectorAll('#task-qc-content input[type="checkbox"]').forEach(cb => {
                cb.checked = !!qcState[cb.name];
            });

            // Reset Timer state
            updateTimerDisplay(0);
            secondsElapsed = 0;
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
            }
            updateTimerUI(false);

            // Checklist & Subtasks
            renderSubtasks(task.subTasks || []);

            // Files & Versions
            renderTaskFiles(task.files || []);

            // Comments feed
            renderCommentsFeed(task.comments || []);

            // Open Modal
            taskDetailsModal.show();
        } catch (error) {
            console.error('Erro no openTaskDetails:', error);
            alert('Não foi possível carregar as informações da tarefa.');
        }
    };

    // Milestone Select Change Handler
    document.getElementById('task-modal-milestone-select')?.addEventListener('change', async function(e) {
        if (!activeTaskId) return;
        const milestoneId = e.target.value;
        try {
            const res = await fetch(`/admin/api/tasks/${activeTaskId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ milestoneId })
            });
            const data = await res.json();
            if (data.success) {
                window.showNotification?.('Fase da tarefa atualizada com sucesso!', 'success');
                if (window.loadProjectChecklist) {
                    window.loadProjectChecklist(activeProjectDetailsId);
                }
                document.getElementById('task-modal-milestone-title').innerText = e.target.options[e.target.selectedIndex].text.toUpperCase();
            } else {
                alert('Erro ao transferir fase: ' + data.error);
            }
        } catch (err) {
            console.error('Erro ao salvar alteração de marco:', err);
        }
    });

    // QC Checkbox Change Handler
    document.querySelectorAll('#task-qc-content input[type="checkbox"]').forEach(cb => {
        cb.addEventListener('change', function() {
            if (!activeTaskId) return;
            const qcState = JSON.parse(localStorage.getItem(`qc_${activeTaskId}`) || '{}');
            qcState[this.name] = this.checked;
            localStorage.setItem(`qc_${activeTaskId}`, JSON.stringify(qcState));
        });
    });

    function updateTimerDisplay(totalSeconds) {
        const hrs = Math.floor(totalSeconds / 3600).toString().padStart(2, '0');
        const mins = Math.floor((totalSeconds % 3600) / 60).toString().padStart(2, '0');
        const secs = (totalSeconds % 60).toString().padStart(2, '0');
        document.getElementById('task-timer-display').innerText = `${hrs}:${mins}:${secs}`;
    }

    function updateTimerUI(isRunning) {
        const pulse = document.getElementById('task-timer-pulse');
        const btn = document.getElementById('btn-task-timer-toggle');
        if (!btn) return;
        if (isRunning) {
            pulse?.classList.add('bg-red-500', 'animate-pulse');
            pulse?.classList.remove('bg-gray-600');
            btn.innerHTML = '<span class="material-symbols-outlined text-sm">stop</span> Stop';
            btn.classList.add('bg-red-500', 'hover:bg-red-600', 'shadow-red-500/20');
            btn.classList.remove('bg-indigo-500', 'hover:bg-indigo-600', 'shadow-indigo-500/20');
        } else {
            pulse?.classList.remove('bg-red-500', 'animate-pulse');
            pulse?.classList.add('bg-gray-600');
            btn.innerHTML = '<span class="material-symbols-outlined text-sm">play_arrow</span> Play';
            btn.classList.remove('bg-red-500', 'hover:bg-red-600', 'shadow-red-500/20');
            btn.classList.add('bg-indigo-500', 'hover:bg-indigo-600', 'shadow-indigo-500/20');
        }
    }

    document.getElementById('btn-task-timer-toggle')?.addEventListener('click', async function() {
        if (!activeTaskId) return;

        if (timerInterval) {
            // STOP TIMER - FRONTEND INSTANT UPDATE
            const minutesToAdd = Math.round(secondsElapsed / 60);
            const spentEl = document.getElementById('task-time-spent');
            const currentSpentText = spentEl ? spentEl.innerText : '0 min';
            const currentSpentNum = parseInt(currentSpentText) || 0;
            const newSpentNum = currentSpentNum + minutesToAdd;

            if (spentEl) {
                spentEl.innerText = `${newSpentNum} min`;
            }

            const estimatedText = document.getElementById('task-time-estimated')?.innerText || '0 min';
            const estimatedNum = parseInt(estimatedText) || 1;
            const timeProgress = Math.min(100, Math.round((newSpentNum / estimatedNum) * 100));
            const progressBar = document.getElementById('task-time-progress-bar');
            if (progressBar) {
                progressBar.style.width = `${timeProgress}%`;
                if (newSpentNum > estimatedNum) {
                    progressBar.className = 'h-full bg-gradient-to-r from-red-500 to-rose-600 animate-pulse';
                    if (spentEl) spentEl.className = 'text-xs font-bold text-red-500 font-mono';
                } else {
                    progressBar.className = 'h-full bg-indigo-500 transition-all duration-500';
                    if (spentEl) spentEl.className = 'text-xs font-bold text-indigo-400 font-mono';
                }
            }

            clearInterval(timerInterval);
            timerInterval = null;
            updateTimerDisplay(0);
            const prevSeconds = secondsElapsed;
            secondsElapsed = 0;
            updateTimerUI(false);
            
            try {
                const res = await fetch('/admin/api/tracker/stop', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const result = await res.json();
                if (result.success) {
                    openTaskDetails(activeTaskId);
                } else {
                    alert('Erro ao parar rastreio: ' + result.error);
                }
            } catch (err) {
                console.error(err);
            }
        } else {
            // START TIMER
            try {
                const res = await fetch('/admin/api/tracker/start', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        projectId: activeProjectDetailsId,
                        taskId: activeTaskId,
                        taskType: 'other',
                        description: `Trabalho na tarefa: ${document.getElementById('task-modal-title').innerText}`
                    })
                });
                const result = await res.json();
                if (result.success) {
                    timerInterval = setInterval(() => {
                        secondsElapsed++;
                        updateTimerDisplay(secondsElapsed);
                    }, 1000);
                    updateTimerUI(true);
                } else {
                    alert(result.error || 'Erro ao iniciar o cronômetro.');
                }
            } catch (err) {
                console.error(err);
            }
        }
    });

    // Copy UNC Path Button Listener
    document.getElementById('btn-copy-unc-path')?.addEventListener('click', function() {
        const uncInput = document.getElementById('task-unc-path-display');
        if (!uncInput) return;
        navigator.clipboard.writeText(uncInput.value)
            .then(() => {
                const btn = document.getElementById('btn-copy-unc-path');
                if (!btn) return;
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<span class="material-symbols-outlined text-sm">check</span> Copiado';
                btn.classList.replace('bg-indigo-500', 'bg-emerald-500');
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.classList.replace('bg-emerald-500', 'bg-indigo-500');
                }, 2000);
            })
            .catch(err => {
                console.error('Erro ao copiar UNC:', err);
            });
    });

    // CÓPIA DE CAMINHO DE REDE (UNC Copy)
    window.copyLocalPathToClipboard = function(btn, path) {
        const windowsPath = path.replace(/\//g, '\\');
        navigator.clipboard.writeText(windowsPath)
            .then(() => {
                const originalText = btn.innerHTML;
                btn.innerHTML = '<span class="material-symbols-outlined text-[10px] text-emerald-400">check</span> Copiado!';
                btn.classList.add('border-emerald-500/30', 'text-emerald-400');
                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.classList.remove('border-emerald-500/30', 'text-emerald-400');
                }, 2000);
            })
            .catch(err => {
                console.error('Erro ao copiar:', err);
                alert('Erro ao copiar para a área de transferência.');
            });
    };

    function renderSubtasks(subtasks) {
        const list = document.getElementById('subtasks-list-container');
        if (!list) return;

        if (subtasks.length === 0) {
            list.innerHTML = '<p class="text-xs text-gray-500 italic">Nenhum item no checklist.</p>';
            return;
        }

        list.innerHTML = subtasks.map(item => `
            <div class="p-3 bg-white/2 border border-white/5 rounded-2xl flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <input type="checkbox" ${item.status === 'concluido' ? 'checked' : ''} onchange="window.toggleSubtaskStatus('${item.id}', this.checked)" class="w-4 h-4 rounded border-white/10 bg-black/40 text-orange-500 cursor-pointer">
                    <span class="text-xs ${item.status === 'concluido' ? 'text-gray-500 line-through' : 'text-white'}">${item.title}</span>
                </div>
                <button onclick="window.deleteSubtask('${item.id}')" class="w-6 h-6 rounded-lg bg-white/5 hover:bg-red-500/10 text-gray-500 hover:text-red-500 transition-all border-0 flex items-center justify-center">
                    <span class="material-symbols-outlined text-xs">delete</span>
                </button>
            </div>
        `).join('');
    }

    window.toggleSubtaskStatus = async function(subtaskId, isChecked) {
        try {
            await fetch(`/admin/api/tasks/${subtaskId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: isChecked ? 'concluido' : 'a_fazer' })
            });
            openTaskDetails(activeTaskId);
        } catch (err) {
            console.error(err);
        }
    };

    window.deleteSubtask = async function(subtaskId) {
        if (!confirm('Deseja excluir esta sub-tarefa?')) return;
        try {
            await fetch(`/admin/api/tasks/${subtaskId}`, { method: 'DELETE' });
            openTaskDetails(activeTaskId);
        } catch (err) {
            console.error(err);
        }
    };

    document.getElementById('btn-add-subtask')?.addEventListener('click', async function() {
        const input = document.getElementById('new-subtask-input');
        const title = input.value.trim();
        if (!title) return;

        try {
            const res = await fetch('/admin/api/tasks', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    parentTaskId: activeTaskId,
                    milestoneId: document.getElementById('task-modal-milestone-title').dataset.milestoneId || activeTaskId,
                    title,
                    status: 'a_fazer'
                })
            });
            const data = await res.json();
            if (data.success) {
                input.value = '';
                openTaskDetails(activeTaskId);
            }
        } catch (err) {
            console.error(err);
        }
    });

    function renderTaskFiles(files) {
        const list = document.getElementById('task-files-list-container');
        if (!list) return;

        if (files.length === 0) {
            list.innerHTML = '<p class="text-xs text-gray-500 italic">Nenhum arquivo ou render anexado.</p>';
            return;
        }

        list.innerHTML = files.map(file => {
            const isLocal = file.fileType === 'local';
            return `
                <div class="p-4 bg-white/2 border border-white/5 rounded-2xl flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-gray-400">
                            <span class="material-symbols-outlined">${isLocal ? 'folder' : 'image'}</span>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-white font-mono break-all">${file.filePathOrUrl}</p>
                            <div class="flex items-center gap-2 mt-1">
                                <span class="text-[9px] text-gray-500 font-bold uppercase">Versão V${file.versionNumber}</span>
                                <span class="w-1.5 h-1.5 rounded-full bg-gray-700"></span>
                                <span class="text-[9px] ${file.isApprovedByClient ? 'text-emerald-400' : 'text-amber-500'} font-bold uppercase">
                                    ${file.isApprovedByClient ? 'Aprovado pelo Cliente' : 'Pendente de Aprovação'}
                                </span>
                            </div>
                        </div>
                    </div>
                    <div>
                        ${isLocal ? `
                            <button onclick="window.copyLocalPathToClipboard(this, '${file.filePathOrUrl}')" class="px-4 py-2 bg-white/5 border border-white/10 hover:bg-white/10 rounded-xl text-[9px] font-black uppercase tracking-widest text-white transition-all">
                                <i class="fa-solid fa-copy mr-1"></i> Copiar Caminho
                            </button>
                        ` : `
                            <a href="${file.filePathOrUrl}" target="_blank" class="px-4 py-2 bg-white/5 border border-white/10 hover:bg-white/10 rounded-xl text-[9px] font-black uppercase tracking-widest text-white transition-all inline-block">
                                <i class="fa-solid fa-eye mr-1"></i> Visualizar
                            </a>
                        `}
                    </div>
                </div>
            `;
        }).join('');
    }

    document.getElementById('btn-save-task-file')?.addEventListener('click', async function() {
        const localPathInput = document.getElementById('new-file-local-path');
        const uploadInput = document.getElementById('new-file-upload-input');
        const localPath = localPathInput.value.trim();
        const fileToUpload = uploadInput.files[0];

        if (!localPath && !fileToUpload) {
            alert('Por favor, informe um caminho local ou faça upload de um arquivo.');
            return;
        }

        try {
            const formData = new FormData();
            if (fileToUpload) {
                formData.append('file', fileToUpload);
                formData.append('fileType', 'image');
            } else {
                formData.append('filePathOrUrl', localPath);
                formData.append('fileType', 'local');
            }

            const res = await fetch(`/admin/api/tasks/${activeTaskId}/files`, {
                method: 'POST',
                body: formData
            });

            const data = await res.json();
            if (data.success) {
                localPathInput.value = '';
                uploadInput.value = '';
                openTaskDetails(activeTaskId);
            } else {
                alert('Erro ao salvar arquivo: ' + data.error);
            }
        } catch (err) {
            console.error(err);
        }
    });

    function renderCommentsFeed(comments) {
        const feed = document.getElementById('task-comments-feed');
        if (!feed) return;

        if (comments.length === 0) {
            feed.innerHTML = '<p class="text-xs text-gray-500 italic">Nenhum comentário registrado.</p>';
            return;
        }

        const sorted = comments.sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt));

        feed.innerHTML = sorted.map(c => {
            let typeLabel = 'Comentário da Equipe';
            let bgClass = 'bg-white/[0.02] border-white/5 text-gray-300';
            if (c.type === 'client_feedback') {
                typeLabel = 'Feedback do Cliente';
                bgClass = 'bg-orange-500/10 border-orange-500/20 text-orange-400 shadow-[0_0_15px_rgba(249,115,22,0.05)]';
            } else if (c.type === 'system') {
                typeLabel = 'Sistema';
                bgClass = 'bg-white/[0.01] border-white/5 text-gray-500';
            }

            return `
                <div class="p-4 rounded-2xl border ${bgClass} transition-all">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[10px] font-black uppercase tracking-wider">${typeLabel}</span>
                        <span class="text-[9px] font-mono opacity-60">${new Date(c.createdAt).toLocaleString('pt-BR')}</span>
                    </div>
                    <p class="text-xs leading-relaxed font-medium">${c.content}</p>
                </div>
            `;
        }).join('');
    }

    document.getElementById('btn-save-task-comment')?.addEventListener('click', async function() {
        const input = document.getElementById('task-new-comment-input');
        const content = input.value.trim();
        if (!content) return;

        try {
            const res = await fetch(`/admin/api/tasks/${activeTaskId}/comments`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content, type: 'team_comment' })
            });
            const data = await res.json();
            if (data.success) {
                input.value = '';
                openTaskDetails(activeTaskId);
            }
        } catch (err) {
            console.error(err);
        }
    });

    // Botão de Logout dentro do modal
    document.getElementById('modal-logout-btn')?.addEventListener('click', () => {
        if (confirm('Deseja realmente sair da sua conta?')) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/admin/logout';
            document.body.appendChild(form);
            form.submit();
        }
    });
});
</script>
