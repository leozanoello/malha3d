                            <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-black py-4 rounded-xl shadow-lg shadow-orange-500/20 transition-all flex items-center justify-center gap-2 text-[10px] uppercase tracking-widest">
                                <span class="material-symbols-outlined text-sm">check_circle</span>
                                CRIAR PROJETO
