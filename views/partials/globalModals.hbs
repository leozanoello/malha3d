function renderPaymentMethods(containerId, isPJ) {
    const container = document.getElementById(containerId);
    if (!container) return;
    
    const list = isPJ ? pjPayments : pfPayments;
    container.innerHTML = list.map((p, idx) => `
        <label class="flex items-center gap-2 cursor-pointer p-1.5 hover:bg-white/5 rounded-lg transition-all text-[9px] font-bold text-gray-300">
            <input type="checkbox" name="paymentMethods" value="${p.value}" checked class="rounded border-white/10 text-orange-500 focus:ring-0 bg-transparent">
            <span>${p.label}</span>
        </label>
    `).join('');
}

function applyDocumentMask(inputEl, isPJ) {
    if (!inputEl) return;
    
    inputEl.placeholder = isPJ ? '00.000.000/0000-00' : '000.000.000-00';
    
    const maskHandler = function(e) {
        let v = e.target.value.replace(/\D/g, '');
        if (isPJ) {
            // CNPJ: 00.000.000/0000-00
            if (v.length > 14) v = v.slice(0, 14);
            if (v.length > 12) {
                v = v.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})/, "$1.$2.$3/$4-$5");
            } else if (v.length > 8) {
                v = v.replace(/^(\d{2})(\d{3})(\d{3})(\d{0,4})/, "$1.$2.$3/$4");
            } else if (v.length > 5) {
                v = v.replace(/^(\d{2})(\d{3})(\d{0,3})/, "$1.$2.$3");
            } else if (v.length > 2) {
                v = v.replace(/^(\d{2})(\d{0,3})/, "$1.$2");
            }
        } else {
            // CPF: 000.000.000-00
            if (v.length > 11) v = v.slice(0, 11);
            if (v.length > 9) {
                v = v.replace(/^(\d{3})(\d{3})(\d{3})(\d{2})/, "$1.$2.$3-$4");
            } else if (v.length > 6) {
                v = v.replace(/^(\d{3})(\d{3})(\d{0,3})/, "$1.$2.$3");
            } else if (v.length > 3) {
                v = v.replace(/^(\d{3})(\d{0,3})/, "$1.$2");
            }
        }
        e.target.value = v;
    };
    
    if (inputEl._maskHandler) {
        inputEl.removeEventListener('input', inputEl._maskHandler);
    }
    inputEl._maskHandler = maskHandler;
    inputEl.addEventListener('input', maskHandler);
    
    // trigger once to clear/mask existing
    maskHandler({ target: inputEl });
}

function applyPhoneMask(inputEl) {
    if (!inputEl) return;
    const maskHandler = function(e) {
        let v = e.target.value.replace(/\D/g, '');
        if (v.length > 11) v = v.slice(0, 11);
        if (v.length > 10) {
            v = v.replace(/^(\d{2})(\d{5})(\d{4})/, "($1) $2-$3");
        } else if (v.length > 6) {
            v = v.replace(/^(\d{2})(\d{4})(\d{0,4})/, "($1) $2-$3");
        } else if (v.length > 2) {
            v = v.replace(/^(\d{2})(\d{0,4})/, "($1) $2");
        }
        e.target.value = v;
    };
    inputEl.addEventListener('input', maskHandler);
}

// Global registry person toggle
function setGlobalRegPersonType(type) {
    const isPJ = type === 'PJ';
    document.getElementById('reg-type').value = type;
    
    // Toggle active classes
    const btnPF = document.getElementById('reg-toggle-pf');
    const btnPJ = document.getElementById('reg-toggle-pj');
    
    if (isPJ) {
        btnPJ.classList.add('bg-orange-500', 'text-white');
        btnPJ.classList.remove('text-gray-400');
        btnPF.classList.remove('bg-orange-500', 'text-white');
        btnPF.classList.add('text-gray-400');
        
        document.getElementById('reg-label-name').innerText = 'Razão Social';
        document.getElementById('reg-label-document').innerText = 'CNPJ';
    } else {
        btnPF.classList.add('bg-orange-500', 'text-white');
        btnPF.classList.remove('text-gray-400');
        btnPJ.classList.remove('bg-orange-500', 'text-white');
        btnPJ.classList.add('text-gray-400');
        
        document.getElementById('reg-label-name').innerText = 'Nome Completo';
        document.getElementById('reg-label-document').innerText = 'CPF';
    }
    
    applyDocumentMask(document.getElementById('reg-document'), isPJ);
    renderPaymentMethods('reg-payment-methods', isPJ);
}

document.addEventListener('DOMContentLoaded', () => {
    // Initialize Global Registry elements
    if (document.getElementById('newRegistryModal')) {
        setGlobalRegPersonType('PF');
        loadIBGEStates('reg-state', 'reg-city');
        applyPhoneMask(document.getElementById('reg-phone'));
    }

    if (document.getElementById('globalNewProjectForm')) {
        loadIBGEStates('global-project-state', 'global-project-city');
    }

    // Global Project Form
    document.getElementById('globalNewProjectForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(this).entries());
        data.isFeatured = this.isFeatured?.checked || false;
        
        try {
            const res = await fetch('/admin/api/projects', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if(result.success) window.location.reload();
            else alert('Erro: ' + result.message);
        } catch(err) { console.error(err); }
    });

    // Global Registry Form
    document.getElementById('globalRegistryForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        const data = Object.fromEntries(formData.entries());
        data.paymentMethods = Array.from(this.querySelectorAll('input[name="paymentMethods"]:checked')).map(el => el.value);
        
        try {
            const res = await fetch('/admin/api/contatos', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if(result.success) window.location.reload();
            else alert('Erro: ' + result.message);
        } catch(err) { console.error(err); }
    });

    // Global Transaction Form
    document.getElementById('globalTransactionForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(this).entries());
        data.isRecurring = this.isRecurring?.checked || false;
        
        try {
            const res = await fetch('/admin/api/finance', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if(result.success) window.location.reload();
            else alert('Erro: ' + result.message);
        } catch(err) { console.error(err); }
    });
});
</script>
