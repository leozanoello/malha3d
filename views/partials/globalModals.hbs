        if (value.length > 0 && !e.target.value.startsWith('+')) {
            value = '55' + value; // Prefixo Brasil por padrão se não digitado
        }
        if (value.length <= 11) {
            value = value.replace(/^(\d{2})(\d)/g, '($1) $2');
            value = value.replace(/(\d)(\d{4})$/g, '$1-$2');
        } else {
            value = value.replace(/^(\d{2})(\d{2})(\d)/g, '+$1 ($2) $3');
            value = value.replace(/(\d)(\d{4})$/g, '$1-$2');
        }
