    .input-premium-compact:focus {
        background-color: rgba(255, 255, 255, 0.04);
        border-color: rgba(249, 115, 22, 0.4);
    }
    .input-premium-compact::placeholder { color: rgba(255, 255, 255, 0.15); }
    
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<!-- Modal Perfil do Usuário -->
<div class="modal fade" id="userProfileModal" tabindex="-1" aria-labelledby="userProfileModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content glass-card">
      <div class="modal-header border-bottom border-white/5 p-4 flex justify-between items-center">
        <h5 class="modal-title text-gradient text-xl font-bold flex items-center gap-2" id="userProfileModalLabel">
          <span class="material-symbols-outlined text-orange-500">account_circle</span>
          Perfil do Usuário
        </h5>
        <button type="button" class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-white transition-all border-0" data-bs-dismiss="modal" aria-label="Close">
          <span class="material-symbols-outlined text-sm">close</span>
        </button>
      </div>
      
      <div class="modal-body p-0">
        <!-- Navegação das Abas -->
        <ul class="nav nav-tabs border-bottom border-white/5 px-4 pt-3 flex gap-2" id="profileTab" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active bg-transparent border-0 text-gray-400 hover:text-white px-4 py-2 text-xs font-bold uppercase tracking-wider transition-colors active-orange" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab" aria-controls="general" aria-selected="true">Dados Pessoais</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link bg-transparent border-0 text-gray-400 hover:text-white px-4 py-2 text-xs font-bold uppercase tracking-wider transition-colors" id="professional-tab" data-bs-toggle="tab" data-bs-target="#professional" type="button" role="tab" aria-controls="professional" aria-selected="false">Profissional (Portfólio/Tags)</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link bg-transparent border-0 text-gray-400 hover:text-white px-4 py-2 text-xs font-bold uppercase tracking-wider transition-colors" id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings" type="button" role="tab" aria-controls="settings" aria-selected="false">Segurança (Reset de senha/Logoff)</button>
          </li>
        </ul>
        
        <form id="user-profile-form" class="p-6">
          <div class="tab-content" id="profileTabContent">
            <!-- ABA 1: GERAL -->
            <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
              <!-- Upload Avatar Section -->
              <div class="flex flex-col items-center justify-center mb-6">
