<script>
// IBGE Loader functions (exposed globally)
async function loadIBGEStates(stateSelectId, citySelectId, defaultState = '', defaultCity = '') {
    const stateSel = document.getElementById(stateSelectId);
    const citySel = document.getElementById(citySelectId);
    if (!stateSel) return;
    
    try {
        stateSel.innerHTML = '<option value="">Carregando...</option>';
        const res = await fetch('https://servicodados.ibge.gov.br/api/v1/localidades/estados?orderBy=nome');
        const states = await res.json();
        
        stateSel.innerHTML = '<option value="">Selecione...</option>';
        states.forEach(state => {
            const opt = document.createElement('option');
            opt.value = state.sigla;
            opt.textContent = `${state.nome} (${state.sigla})`;
            if (state.sigla === defaultState) opt.selected = true;
            stateSel.appendChild(opt);
        });
        
        const changeHandler = async function() {
            const uf = this.value;
            if (!uf) {
                citySel.innerHTML = '<option value="">Selecione o Estado...</option>';
                citySel.disabled = true;
                return;
            }
            await loadIBGECities(uf, citySelectId, defaultCity);
        };
        
        stateSel.removeEventListener('change', stateSel._changeHandler || (() => {}));
        stateSel._changeHandler = changeHandler;
        stateSel.addEventListener('change', changeHandler);
        
        if (defaultState) {
            await loadIBGECities(defaultState, citySelectId, defaultCity);
        }
    } catch (err) {
        console.error('Erro ao carregar estados do IBGE:', err);
        stateSel.innerHTML = '<option value="">Erro ao carregar</option>';
    }
}

async function loadIBGECities(uf, citySelectId, defaultCity = '') {
    const citySel = document.getElementById(citySelectId);
    if (!citySel) return;
    
    try {
        citySel.disabled = true;
        citySel.innerHTML = '<option value="">Carregando cidades...</option>';
        
        const res = await fetch(`https://servicodados.ibge.gov.br/api/v1/localidades/estados/${uf}/municipios`);
        const cities = await res.json();
        
        citySel.innerHTML = '<option value="">Selecione...</option>';
        cities.forEach(city => {
            const opt = document.createElement('option');
            opt.value = city.nome;
            opt.textContent = city.nome;
            if (city.nome === defaultCity) opt.selected = true;
            citySel.appendChild(opt);
        });
        
        citySel.disabled = false;
    } catch (err) {
        console.error('Erro ao carregar cidades do IBGE:', err);
        citySel.innerHTML = '<option value="">Erro ao carregar</option>';
    }
}

