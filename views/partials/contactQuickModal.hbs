<!--
  CONTACT QUICK MODAL — Sincronizado com "Criar Contato" do menu Contatos
  Permite:
   1. Criar novo contato (formulário completo CPF/CNPJ/Email/WhatsApp/Estado/Cidade)
   2. Vincular contato existente da tabela de contatos
  Ao criar/vincular, o contato fica automaticamente vinculado ao CRM/Projeto em edição

  Parâmetros (via window):
   - window._contactModalContext: 'crm' | 'projeto' (define contexto)
   - window._contactModalCallback: function(contact) para receber o contato criado/vinculado
-->
<div id="contactQuickModal" class="fixed inset-0 z-[100000] hidden items-center justify-center bg-black/80 backdrop-blur-md" style="display:none;">
 <div class="w-full max-w-2xl bg-[#0c0d10] border border-white/20 rounded-2xl shadow-2xl flex flex-col max-h-[90vh] overflow-hidden">

  <!-- Header -->
  <div class="flex items-center justify-between p-5 border-b border-white/10 bg-gradient-to-r from-cyan-500/10 to-indigo-500/10">
   <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-cyan-500/20 border border-cyan-500/30 flex items-center justify-center">
     <span class="material-symbols-outlined text-cyan-400 text-lg">contacts</span>
    </div>
    <div>
     <h3 class="text-sm font-black text-white tracking-tight uppercase">Menu de Contatos</h3>
     <p class="text-[8px] font-bold text-gray-400 uppercase tracking-widest" id="contactModalContextLabel">Vinculado ao contexto</p>
    </div>
   </div>
   <button type="button" onclick="window.closeContactQuickModal()" class="w-8 h-8 rounded-lg bg-white/5 hover:bg-white/10 flex items-center justify-center text-gray-400 hover:text-white transition-all">
    <span class="material-symbols-outlined text-base">close</span>
   </button>
  </div>

  <!-- Tabs -->
  <div class="flex border-b border-white/5 bg-black/30">
   <button type="button" onclick="window.switchContactTab('existing')" id="contactTabExisting" class="flex-1 py-3 text-[9px] font-black uppercase tracking-widest text-cyan-400 border-b-2 border-cyan-500 transition-all">
    <span class="material-symbols-outlined text-sm align-middle">link</span> Vincular Existente
   </button>
   <button type="button" onclick="window.switchContactTab('new')" id="contactTabNew" class="flex-1 py-3 text-[9px] font-black uppercase tracking-widest text-gray-500 border-b-2 border-transparent hover:text-white transition-all">
    <span class="material-symbols-outlined text-sm align-middle">person_add</span> Criar Novo
   </button>
  </div>

  <!-- ══════════ TAB: VINCULAR EXISTENTE ══════════ -->
  <div id="contactTabContentExisting" class="flex-1 overflow-y-auto p-5 space-y-3">
   <div class="relative">
    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm">search</span>
    <input type="text" id="contactSearchInput" placeholder="Buscar por nome, e-mail, telefone ou empresa..." oninput="window.filterContactList()" class="w-full bg-white/5 border border-white/10 rounded-lg pl-9 pr-3 py-2.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500">
   </div>
   <div id="contactListContainer" class="space-y-1 max-h-[400px] overflow-y-auto custom-scrollbar">
    <!-- Renderizado via JS -->
   </div>
  </div>

  <!-- ══════════ TAB: CRIAR NOVO ══════════ -->
  <div id="contactTabContentNew" class="hidden flex-1 overflow-y-auto p-5 space-y-4">
   <form id="contactQuickNewForm" class="space-y-4">
    <div class="p-3 rounded-xl bg-cyan-500/5 border border-cyan-500/20">
     <p class="text-[9px] font-bold text-cyan-400 uppercase tracking-widest flex items-center gap-1">
      <span class="material-symbols-outlined text-xs">auto_awesome</span> Sincronizado com Menu Contatos
     </p>
     <p class="text-[8px] text-gray-500 mt-1">Este contato será criado no módulo <strong>Contatos</strong> e vinculado automaticamente a este <span id="contactCtxNewLabel">CRM/Projeto</span>.</p>
    </div>

    <div class="grid grid-cols-2 gap-3">
     <div>
      <label class="block text-[8px] font-bold text-gray-400 uppercase mb-1">Tipo *</label>
      <select name="category" id="cq-category" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
       <option value="Cliente">Cliente Final</option>
       <option value="Lead">Lead / Prospect</option>
       <option value="Parceiro">Parceiro / Freelancer</option>
       <option value="Fornecedor">Fornecedor</option>
      </select>
     </div>
     <div>
      <label class="block text-[8px] font-bold text-gray-400 uppercase mb-1">Pessoa *</label>
      <div class="flex gap-1">
       <button type="button" id="cq-toggle-pf" onclick="window.setCqPersonType('PF')" class="flex-1 py-2 text-[9px] font-black uppercase tracking-widest rounded-lg bg-cyan-500 text-white transition-all">PF</button>
       <button type="button" id="cq-toggle-pj" onclick="window.setCqPersonType('PJ')" class="flex-1 py-2 text-[9px] font-black uppercase tracking-widest rounded-lg bg-white/5 text-gray-400 hover:text-white transition-all">PJ</button>
      </div>
      <input type="hidden" name="type" id="cq-type" value="PF">
     </div>
    </div>

    <div>
     <label class="block text-[8px] font-bold text-gray-400 uppercase mb-1" id="cq-name-label">Nome Completo *</label>
     <input type="text" name="name" id="cq-name" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500" placeholder="Ex: Leonardo Zanoello">
    </div>

    <div class="grid grid-cols-2 gap-3">
     <div>
      <label class="block text-[8px] font-bold text-gray-400 uppercase mb-1" id="cq-document-label">CPF *</label>
      <input type="text" name="document" id="cq-document" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500" placeholder="000.000.000-00">
     </div>
     <div>
      <label class="block text-[8px] font-bold text-gray-400 uppercase mb-1">Cargo (Opcional)</label>
      <input type="text" name="jobTitle" id="cq-jobTitle" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500" placeholder="Ex: Arquiteto">
     </div>
    </div>

    <div class="grid grid-cols-2 gap-3">
     <div>
      <label class="block text-[8px] font-bold text-gray-400 uppercase mb-1">E-mail *</label>
      <input type="email" name="email" id="cq-email" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500" placeholder="contato@empresa.com">
     </div>
     <div>
      <label class="block text-[8px] font-bold text-gray-400 uppercase mb-1">WhatsApp</label>
      <input type="text" name="phone" id="cq-phone" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500" placeholder="(00) 00000-0000">
     </div>
    </div>

    <div id="cq-company-field">
     <label class="block text-[8px] font-bold text-gray-400 uppercase mb-1">Empresa (Opcional)</label>
     <input type="text" name="company" id="cq-company" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500" placeholder="Ex: Studio Alpha">
    </div>

    <div class="grid grid-cols-2 gap-3">
     <div>
      <label class="block text-[8px] font-bold text-gray-400 uppercase mb-1">Estado</label>
      <select name="state" id="cq-state" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
       <option value="">Carregando...</option>
      </select>
     </div>
     <div>
      <label class="block text-[8px] font-bold text-gray-400 uppercase mb-1">Cidade</label>
      <select name="city" id="cq-city" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500" disabled>
       <option value="">Selecione o Estado...</option>
      </select>
     </div>
    </div>

    <div>
     <label class="block text-[8px] font-bold text-gray-400 uppercase mb-1">Observações</label>
     <textarea name="notes" id="cq-notes" rows="2" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500" placeholder="Anotações sobre o contato..."></textarea>
    </div>
   </form>
  </div>

  <!-- Footer -->
  <div class="flex gap-2 p-4 border-t border-white/5 bg-white/[0.01]">
   <button type="button" onclick="window.closeContactQuickModal()" class="flex-1 py-2.5 rounded-lg bg-white/5 text-white font-black text-[9px] uppercase tracking-widest border border-white/10 hover:bg-white/10 transition-all">
    Cancelar
   </button>
   <button type="button" id="contactQuickSubmitBtn" onclick="window.submitContactQuickModal()" class="flex-[2] py-2.5 rounded-lg bg-cyan-500 hover:bg-cyan-600 text-white font-black text-[9px] uppercase tracking-widest shadow-lg shadow-cyan-500/20 transition-all flex items-center justify-center gap-1.5">
    <span class="material-symbols-outlined text-xs">check</span> <span id="contactQuickSubmitLabel">Vincular Contato</span>
   </button>
  </div>
 </div>
</div>
