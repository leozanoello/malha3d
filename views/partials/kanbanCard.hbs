<div class="kanban-card group p-5 bg-white/[0.03] border border-white/10 rounded-[1.5rem] hover:border-orange-500/40 transition-all cursor-grab active:cursor-grabbing mb-4 relative overflow-hidden backdrop-blur-xl shadow-2xl kanban-card-main" 
     draggable="true" 
     data-id="{{lead.id}}" 
     data-lead="{{json lead}}">
    
    <!-- Liquid Glass Effect Overlay -->
    <div class="absolute inset-0 bg-gradient-to-br from-white/[0.05] to-transparent pointer-events-none"></div>
    <div class="absolute -top-10 -right-10 w-24 h-24 bg-orange-500/10 blur-3xl rounded-full group-hover:bg-orange-500/20 transition-all"></div>
    
    <!-- Colored Side Bar -->
    <div class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-12 rounded-r-full" style="background-color: {{lead.statusColor}}"></div>
    
    <!-- Header -->
    <div class="flex items-center justify-between mb-4 relative z-10">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl overflow-hidden border border-white/10 shadow-lg group-hover:scale-105 transition-transform">
                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed={{lead.name}}" class="w-full h-full object-cover" alt="">
            </div>
            <div class="flex flex-col">
                <h5 class="text-xs font-black text-white leading-tight group-hover:text-orange-500 transition-colors uppercase tracking-tight">{{lead.name}}</h5>
                <span class="text-[8px] text-gray-500 font-bold uppercase tracking-widest">{{lead.projectType}}</span>
            </div>
        </div>
        <div class="flex items-center gap-1">
            <button class="w-6 h-6 rounded-lg bg-white/5 flex items-center justify-center text-gray-500 hover:text-orange-500 transition-all btn-edit-lead" data-lead="{{json lead}}">
                <span class="material-symbols-outlined text-xs">edit</span>
            </button>
            <button class="w-6 h-6 rounded-lg bg-white/5 flex items-center justify-center text-gray-500 hover:text-white transition-all">
                <span class="material-symbols-outlined text-xs">more_vert</span>
            </button>
        </div>
    </div>

    <!-- Value Badge -->
    <div class="mb-4 relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20">
            <span class="text-[10px] font-black text-emerald-400">R$ {{formatCurrency lead.estimatedValue}}</span>
        </div>
    </div>

    <!-- Probability & Meta -->
    <div class="space-y-3 relative z-10">
        <div class="flex justify-between items-center">
            <div class="flex items-center gap-1.5 text-gray-500">
                <span class="material-symbols-outlined text-[10px]">schedule</span>
                <span class="text-[8px] font-bold uppercase">{{timeAgo lead.createdAt}}</span>
            </div>
            <span class="text-[10px] font-black text-white">{{lead.probability}}%</span>
        </div>
        <div class="h-1.5 w-full bg-white/5 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-orange-600 to-orange-400 shadow-[0_0_12px_rgba(249,115,22,0.4)] transition-all duration-700 ease-out" style="width: {{lead.probability}}%"></div>
        </div>
    </div>

    <!-- AI Tags -->
    <div class="flex items-center justify-between mt-5 pt-4 border-t border-white/5 relative z-10">
        <div class="flex gap-1.5">
            <span class="px-2 py-1 rounded-lg bg-white/5 border border-white/10 text-[7px] font-black text-gray-400 uppercase tracking-widest">URGENTE</span>
            <span class="px-2 py-1 rounded-lg bg-orange-500/10 border border-orange-500/20 text-[7px] font-black text-orange-500 uppercase tracking-widest">ALTA CHANCE</span>
        </div>
        <div class="w-6 h-6 rounded-lg bg-gradient-to-br from-orange-400 to-orange-600 flex items-center justify-center text-white shadow-lg shadow-orange-500/20">
            <span class="material-symbols-outlined text-xs">psychology</span>
        </div>
    </div>
</div>
