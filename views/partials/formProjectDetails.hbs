{{!-- Partial: Detalhes do Projeto (shared entre CRM e Projetos) --}}
<div class="p-3 rounded-xl border border-orange-500/20 bg-orange-500/5">
 <h5 class="text-[9px] font-black text-orange-400 uppercase tracking-widest mb-2 flex items-center gap-1.5">
  <span class="material-symbols-outlined text-xs">info</span> Detalhes do Projeto
 </h5>
 <div class="space-y-2">
  <div>
   <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Nome do Projeto *</label>
   <input type="text" name="name" required class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none" placeholder="Ex: Projeto 3D - Prédio Comercial">
  </div>
  <div class="grid grid-cols-2 gap-2">
   <div>
    <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Valor Ganho (R$)</label>
    <input type="number" step="0.01" name="valorGanho" class="w-full bg-emerald-500/10 border border-emerald-500/20 rounded-lg px-3 py-2 text-xs text-emerald-400 font-black focus:border-emerald-500 focus:outline-none" placeholder="15000.00">
   </div>
   <div>
    <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Metragem (m²)</label>
    <input type="number" step="0.01" name="totalArea" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none" placeholder="350.00">
   </div>
  </div>
  <div class="grid grid-cols-2 gap-2">
   <div>
    <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Data Ganho Oportunidade</label>
    <input type="date" name="dataGanhoOportunidade" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none">
   </div>
   <div>
    <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Expectativa de Início</label>
    <input type="date" name="expectativaInicio" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none">
   </div>
  </div>
  <div>
   <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Origem do Projeto</label>
   <select name="origemProjeto" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none appearance-none">
    <option value="">Selecione a origem...</option>
    <option value="Instagram">Instagram</option>
    <option value="Facebook">Facebook</option>
    <option value="LinkedIn">LinkedIn</option>
    <option value="TikTok">TikTok</option>
    <option value="E-mail">E-mail</option>
    <option value="Indicação">Indicação</option>
    <option value="Outros">Outros</option>
   </select>
  </div>
  <div>
   <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Observação</label>
   <textarea name="observacao" rows="2" class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none" placeholder="Anotações livres..."></textarea>
  </div>
  <div>
   <label class="block text-[8px] text-gray-400 font-bold uppercase mb-1">Etiquetas (pressione Enter)</label>
   <div class="flex flex-wrap gap-1 mb-1" id="{{tagsContainerId}}"></div>
   <input type="text" id="{{tagInputId}}" placeholder="Digite e pressione Enter..." class="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none" onkeydown="if(event.key==='Enter'){event.preventDefault();window.addProjectTag(this.value);this.value='';}">
   <input type="hidden" name="etiquetas" id="{{tagsHiddenId}}" value="[]">
  </div>
 </div>
</div>
