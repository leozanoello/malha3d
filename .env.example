# =============================================================================
# ZANOELLO 3D - LANDING PAGE
# Configurações de Ambiente
# =============================================================================

# =============================================================================
# AMBIENTE DA APLICAÇÃO
# =============================================================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=Zanoello 3D
APP_DESCRIPTION=Serviços de Impressão 3D Profissionais

# =============================================================================
# BANCO DE DADOS - SUPABASE (POSTGRESQL)
# =============================================================================
SUPABASE_DB_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DB_POOL_MIN=0
DB_POOL_MAX=5
DB_ACQUIRE=30000
DB_IDLE=10000

# =============================================================================
# SESSÃO E SEGURANÇA
# =============================================================================
SESSION_SECRET=sua_chave_secreta_super_segura_aqui_minimo_32_caracteres
SESSION_NAME=zanoello_session
SESSION_MAX_AGE=86400000
BCRYPT_ROUNDS=12
JWT_SECRET=sua_chave_jwt_super_segura_aqui

# =============================================================================
# CONFIGURAÇÕES DE E-MAIL (SMTP)
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_de_app_aqui
EMAIL_FROM_NAME=Zanoello 3D
EMAIL_FROM_EMAIL=noreply@zanoello3d.com

# =============================================================================
# UPLOAD DE ARQUIVOS
# =============================================================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,stl,obj,3mf,step,step,iges,zip,rar
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=200

# =============================================================================
# SEGURANÇA E RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:3000
HELMET_ENABLED=true

# =============================================================================
# CACHE E PERFORMANCE
# =============================================================================
CACHE_ENABLED=true
CACHE_TTL=3600
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# INTEGRAÇÕES EXTERNAS
# =============================================================================
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=
HOTJAR_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
GOOGLE_MAPS_API_KEY=

# =============================================================================
# WHATSAPP INTEGRATION
# =============================================================================
WHATSAPP_PHONE=5511999999999
WHATSAPP_MESSAGE=Olá! Gostaria de fazer um orçamento de impressão 3D.
WHATSAPP_ENABLED=true

# URLs e Links
BASE_URL=http://localhost:3000
WHATSAPP_NUMBER=554920181541
INSTAGRAM_URL=https://instagram.com/zanoello.3d
EMAIL_CONTACT=atelie@zanoello.com

# =============================================================================
# CONFIGURAÇÕES DE BACKUP
# =============================================================================
BACKUP_ENABLED=true
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# LOGS E MONITORAMENTO
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# OAUTH - LOGIN SOCIAL
# =============================================================================
# Google OAuth (https://console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (https://developers.facebook.com → App Settings → Basic)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Apple Sign In (https://developer.apple.com → Certificates, Identifiers & Profiles)
# APPLE_SERVICE_ID=com.malha3d.web.login
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=./config/AuthKey_XXXXXXX.p8

LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5